# surface.cyr — window surface lifecycle management
# Ported from mabda/src/surface.rs
#
# SurfaceState manages a window surface's configuration and frame acquisition.
# Requires a windowing system (not used in headless compute).
#
# SurfaceState struct layout (40 bytes):
#   +0:  surface (WGPUSurface handle, 8)
#   +8:  format  (u32 WGPUTextureFormat)
#   +16: width   (i64)
#   +24: height  (i64)
#   +32: present_mode (u32)

# Present mode preferences
var PRESENT_VSYNC     = 0;
var PRESENT_NO_VSYNC  = 1;
var PRESENT_IMMEDIATE = 2;
var PRESENT_MAILBOX   = 3;

# WGPUPresentMode constants
var WGPU_PRESENT_MODE_FIFO        = 2;  # Vsync
var WGPU_PRESENT_MODE_FIFO_RELAXED = 3;
var WGPU_PRESENT_MODE_IMMEDIATE   = 0;
var WGPU_PRESENT_MODE_MAILBOX     = 1;

fn present_mode_to_wgpu(pref) {
    if (pref == PRESENT_VSYNC)     { return WGPU_PRESENT_MODE_FIFO; }
    if (pref == PRESENT_NO_VSYNC)  { return WGPU_PRESENT_MODE_FIFO_RELAXED; }
    if (pref == PRESENT_IMMEDIATE) { return WGPU_PRESENT_MODE_IMMEDIATE; }
    if (pref == PRESENT_MAILBOX)   { return WGPU_PRESENT_MODE_MAILBOX; }
    return WGPU_PRESENT_MODE_FIFO;
}

# Accessors
fn surface_state_handle(ss)  { return load64(ss); }
fn surface_state_format(ss)  { return load32(ss + 8); }
fn surface_state_width(ss)   { return load64(ss + 16); }
fn surface_state_height(ss)  { return load64(ss + 24); }
fn surface_state_present(ss) { return load32(ss + 32); }

# Create a SurfaceState (requires wgpuSurface from windowing system)
fn surface_state_new(surface, format, width, height, present_pref) {
    var ss = alloc(40);
    store64(ss, surface);
    store32(ss + 8, format);
    store64(ss + 16, width);
    store64(ss + 24, height);
    store32(ss + 32, present_mode_to_wgpu(present_pref));
    return ss;
}

# Resize the surface (reconfigure with new dimensions)
fn surface_state_resize(ss, width, height) {
    if (width == 0) { return 0; }
    if (height == 0) { return 0; }
    store64(ss + 16, width);
    store64(ss + 24, height);
    # TODO: call wgpuSurfaceConfigure with updated size
    return 0;
}

# Get current surface texture for rendering
# TODO: wgpuSurfaceGetCurrentTexture → SurfaceTexture
fn surface_state_acquire(ss) {
    # Returns WGPUSurfaceTexture or error
    # Requires wgpuSurfaceGetCurrentTexture in FFI table
    return 0;
}

# Present the current frame
# TODO: wgpuSurfacePresent
fn surface_state_present(ss) {
    return 0;
}

# Get the surface size as (width, height) at a destination pointer
fn surface_state_size(ss, dst) {
    store64(dst, surface_state_width(ss));
    store64(dst + 8, surface_state_height(ss));
    return 0;
}
