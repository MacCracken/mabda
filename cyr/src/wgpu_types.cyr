# wgpu_types.cyr — wgpu-native C API constants
# Maps to webgpu.h v29.0.0.0 enums and flags
#
# Uses plain vars instead of enum to support object mode (.o linking).
# All values set in wgpu_types_init().

# Buffer usage flags
var WGPU_BUFFER_USAGE_NONE = 0;
var WGPU_BUFFER_USAGE_MAP_READ = 0;
var WGPU_BUFFER_USAGE_MAP_WRITE = 0;
var WGPU_BUFFER_USAGE_COPY_SRC = 0;
var WGPU_BUFFER_USAGE_COPY_DST = 0;
var WGPU_BUFFER_USAGE_INDEX = 0;
var WGPU_BUFFER_USAGE_VERTEX = 0;
var WGPU_BUFFER_USAGE_UNIFORM = 0;
var WGPU_BUFFER_USAGE_STORAGE = 0;
var WGPU_BUFFER_USAGE_INDIRECT = 0;
var WGPU_BUFFER_USAGE_QUERY_RESOLVE = 0;

# Map mode
var WGPU_MAP_MODE_NONE = 0;
var WGPU_MAP_MODE_READ = 0;
var WGPU_MAP_MODE_WRITE = 0;

# Power preference
var WGPU_POWER_PREFERENCE_UNDEFINED = 0;
var WGPU_POWER_PREFERENCE_LOW_POWER = 0;
var WGPU_POWER_PREFERENCE_HIGH_PERFORMANCE = 0;

# Callback mode
var WGPU_CALLBACK_MODE_WAIT_ANY_ONLY = 0;
var WGPU_CALLBACK_MODE_ALLOW_PROCESS_EVENTS = 0;
var WGPU_CALLBACK_MODE_ALLOW_SPONTANEOUS = 0;

# Request status
var WGPU_REQUEST_ADAPTER_STATUS_SUCCESS = 0;
var WGPU_REQUEST_DEVICE_STATUS_SUCCESS = 0;

# Buffer map status
var WGPU_BUFFER_MAP_ASYNC_STATUS_SUCCESS = 0;

# Shader source sType
var WGPU_STYPE_SHADER_SOURCE_WGSL = 0;

# Buffer binding type
var WGPU_BUFFER_BINDING_TYPE_UNIFORM = 0;
var WGPU_BUFFER_BINDING_TYPE_STORAGE = 0;
var WGPU_BUFFER_BINDING_TYPE_READ_ONLY_STORAGE = 0;

# Shader stage flags
var WGPU_SHADER_STAGE_VERTEX = 0;
var WGPU_SHADER_STAGE_FRAGMENT = 0;
var WGPU_SHADER_STAGE_COMPUTE = 0;

# WGPU_WHOLE_SIZE
var WGPU_WHOLE_SIZE = 0;

fn wgpu_types_init() {
    WGPU_BUFFER_USAGE_MAP_READ      = 0x0001;
    WGPU_BUFFER_USAGE_MAP_WRITE     = 0x0002;
    WGPU_BUFFER_USAGE_COPY_SRC      = 0x0004;
    WGPU_BUFFER_USAGE_COPY_DST      = 0x0008;
    WGPU_BUFFER_USAGE_INDEX         = 0x0010;
    WGPU_BUFFER_USAGE_VERTEX        = 0x0020;
    WGPU_BUFFER_USAGE_UNIFORM       = 0x0040;
    WGPU_BUFFER_USAGE_STORAGE       = 0x0080;
    WGPU_BUFFER_USAGE_INDIRECT      = 0x0100;
    WGPU_BUFFER_USAGE_QUERY_RESOLVE = 0x0200;

    WGPU_MAP_MODE_READ  = 0x0001;
    WGPU_MAP_MODE_WRITE = 0x0002;

    WGPU_POWER_PREFERENCE_LOW_POWER        = 1;
    WGPU_POWER_PREFERENCE_HIGH_PERFORMANCE = 2;

    WGPU_CALLBACK_MODE_WAIT_ANY_ONLY       = 1;
    WGPU_CALLBACK_MODE_ALLOW_PROCESS_EVENTS = 2;
    WGPU_CALLBACK_MODE_ALLOW_SPONTANEOUS   = 3;

    WGPU_REQUEST_ADAPTER_STATUS_SUCCESS = 1;
    WGPU_REQUEST_DEVICE_STATUS_SUCCESS  = 1;

    WGPU_BUFFER_MAP_ASYNC_STATUS_SUCCESS = 1;

    WGPU_STYPE_SHADER_SOURCE_WGSL = 0x00000007;

    WGPU_BUFFER_BINDING_TYPE_UNIFORM           = 1;
    WGPU_BUFFER_BINDING_TYPE_STORAGE           = 2;
    WGPU_BUFFER_BINDING_TYPE_READ_ONLY_STORAGE = 3;

    WGPU_SHADER_STAGE_VERTEX   = 0x01;
    WGPU_SHADER_STAGE_FRAGMENT = 0x02;
    WGPU_SHADER_STAGE_COMPUTE  = 0x04;

    WGPU_WHOLE_SIZE = 0 - 1;
    return 0;
}
