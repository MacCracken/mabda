# render_target.cyr — offscreen render target with optional MSAA and depth
# Ported from mabda/src/render_target.rs
#
# RenderTarget struct layout (48 bytes):
#   +0:  texture      (WGPUTexture, 8)
#   +8:  view         (WGPUTextureView, 8)
#   +16: format       (u32 WGPUTextureFormat)
#   +24: width        (i64)
#   +32: height       (i64)
#   +40: sample_count (i64)
#   +48: msaa_view    (WGPUTextureView or 0, 8)
#   +56: depth        (DepthTexture ptr or 0, 8)

var RENDER_TARGET_SIZE = 64;

# Accessors
fn render_target_texture(rt)      { return load64(rt); }
fn render_target_view(rt)         { return load64(rt + 8); }
fn render_target_format(rt)       { return load32(rt + 16); }
fn render_target_width(rt)        { return load64(rt + 24); }
fn render_target_height(rt)       { return load64(rt + 32); }
fn render_target_sample_count(rt) { return load64(rt + 40); }
fn render_target_msaa_view(rt)    { return load64(rt + 48); }
fn render_target_depth(rt)        { return load64(rt + 56); }

# Get the view to render into (MSAA view if multisampled, else main view)
fn render_target_render_view(rt) {
    var msaa = render_target_msaa_view(rt);
    if (msaa != 0) { return msaa; }
    return render_target_view(rt);
}

# Get the resolve target (main view if MSAA, else 0)
fn render_target_resolve(rt) {
    var msaa = render_target_msaa_view(rt);
    if (msaa != 0) { return render_target_view(rt); }
    return 0;
}

# Get depth view (or 0)
fn render_target_depth_view(rt) {
    var depth = render_target_depth(rt);
    if (depth == 0) { return 0; }
    return depth_texture_view(depth);
}

# ================================================================
# RenderTargetBuilder
# ================================================================
#
# Builder struct layout (32 bytes):
#   +0:  width (i64)
#   +8:  height (i64)
#   +16: format (u32)
#   +20: sample_count (u32)
#   +24: depth_format (u32, 0 = no depth)

fn rtb_new(width, height) {
    var b = alloc(32);
    memset(b, 0, 32);
    store64(b, width);
    store64(b + 8, height);
    store32(b + 16, WGPU_TEXTURE_FORMAT_RGBA8_UNORM_SRGB);
    store32(b + 20, 1);  # no MSAA by default
    return b;
}

fn rtb_format(b, format) {
    store32(b + 16, format);
    return b;
}

fn rtb_msaa(b, sample_count) {
    store32(b + 20, sample_count);
    return b;
}

fn rtb_depth(b, depth_format) {
    store32(b + 24, depth_format);
    return b;
}

# Build — creates GPU resources
# Returns RenderTarget ptr (GPU texture creation requires FFI extensions)
fn rtb_build(b, device) {
    var rt = alloc(RENDER_TARGET_SIZE);
    memset(rt, 0, RENDER_TARGET_SIZE);
    store32(rt + 16, load32(b + 16));           # format
    store64(rt + 24, load64(b));                 # width
    store64(rt + 32, load64(b + 8));             # height
    store64(rt + 40, load32(b + 20));            # sample_count
    # TODO: create texture, view, MSAA view, depth via wgpu FFI
    # (requires wgpuDeviceCreateTexture in function table)
    return rt;
}
