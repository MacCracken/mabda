# context.cyr — GPU device lifecycle
# Ported from mabda/src/context.rs
#
# GpuContext owns instance, adapter, device, queue — the core GPU handles.
#
# GpuContext struct layout (32 bytes):
#   +0:  instance (WGPUInstance, 8)
#   +8:  adapter  (WGPUAdapter, 8)
#   +16: device   (WGPUDevice, 8)
#   +24: queue    (WGPUQueue, 8)

# ================================================================
# GpuContext accessors
# ================================================================

fn gpu_ctx_instance(ctx) { return load64(ctx); }
fn gpu_ctx_adapter(ctx)  { return load64(ctx + 8); }
fn gpu_ctx_device(ctx)   { return load64(ctx + 16); }
fn gpu_ctx_queue(ctx)    { return load64(ctx + 24); }

# ================================================================
# Create a GpuContext from pre-initialized handles
# ================================================================
# The C launcher pre-initializes the GPU (to avoid TEXTREL/dlopen issues)
# and passes a WgpuPreinit struct pointer to Cyrius.
#
# WgpuPreinit layout (matches C struct, 32 bytes):
#   +0:  instance (8)
#   +8:  adapter  (8)
#   +16: device   (8)
#   +24: queue    (8)

fn gpu_context_from_preinit(preinit_ptr) {
    syscall(1, 2, "preinit_ptr=", 12);
    var dbuf[24];
    var dlen = fmt_int_buf(preinit_ptr, &dbuf);
    syscall(1, 2, &dbuf, dlen);
    syscall(1, 2, "\n", 1);

    if (preinit_ptr == 0) {
        return GpuErr(GPU_ERR_ADAPTER_NOT_FOUND);
    }
    var instance = load64(preinit_ptr);
    var adapter  = load64(preinit_ptr + 8);
    var device   = load64(preinit_ptr + 16);
    var queue    = load64(preinit_ptr + 24);

    syscall(1, 2, "instance=", 9);
    dlen = fmt_int_buf(instance, &dbuf);
    syscall(1, 2, &dbuf, dlen);
    syscall(1, 2, " adapter=", 9);
    dlen = fmt_int_buf(adapter, &dbuf);
    syscall(1, 2, &dbuf, dlen);
    syscall(1, 2, "\n", 1);

    if (instance == 0) { return GpuErr(GPU_ERR_ADAPTER_NOT_FOUND); }
    if (adapter == 0)  { return GpuErr(GPU_ERR_ADAPTER_NOT_FOUND); }
    if (device == 0)   { return GpuErr(GPU_ERR_DEVICE_REQUEST); }

    syscall(1, 2, "alloc ctx...\n", 13);
    var ctx = alloc(32);
    store64(ctx, instance);
    store64(ctx + 8, adapter);
    store64(ctx + 16, device);
    store64(ctx + 24, queue);
    syscall(1, 2, "GpuOk...\n", 9);
    var result = GpuOk(ctx);
    syscall(1, 2, "done\n", 5);
    return result;
}

# ================================================================
# Release a GpuContext
# ================================================================

fn gpu_context_release(ctx) {
    if (ctx == 0) { return 0; }
    wgpu_device_release(gpu_ctx_device(ctx));
    wgpu_adapter_release(gpu_ctx_adapter(ctx));
    wgpu_instance_release(gpu_ctx_instance(ctx));
    return 0;
}
