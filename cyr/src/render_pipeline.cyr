# render_pipeline.cyr — render pipeline creation and draw commands
# Ported from mabda/src/render_pipeline.rs
#
# RenderPipeline struct layout (24 bytes):
#   +0: pipeline          (WGPURenderPipeline, 8)
#   +8: bind_group_layout (ptr to array of WGPUBindGroupLayout handles)
#   +16: layout_count     (i64)

# Accessors
fn render_pipeline_handle(rp) { return load64(rp); }
fn render_pipeline_bgl(rp, idx) {
    var arr = load64(rp + 8);
    return load64(arr + idx * 8);
}
fn render_pipeline_layout_count(rp) { return load64(rp + 16); }

# ================================================================
# DrawCommand — what to draw
# ================================================================
# DrawCommand struct layout (40 bytes):
#   +0: type (i64 — 0=Draw, 1=DrawIndexed, 2=DrawIndirect, 3=DrawIndexedIndirect)
#   +8: vertex_count / index_count (i64)
#   +16: instance_count (i64)
#   +24: first_index / buffer_offset (i64)
#   +32: base_vertex / first_instance (i64)

var DRAW_CMD_DRAW           = 0;
var DRAW_CMD_DRAW_INDEXED   = 1;
var DRAW_CMD_INDIRECT       = 2;
var DRAW_CMD_INDEXED_INDIRECT = 3;

fn draw_cmd_draw(vertex_count, instance_count) {
    var cmd = alloc(40);
    store64(cmd, DRAW_CMD_DRAW);
    store64(cmd + 8, vertex_count);
    store64(cmd + 16, instance_count);
    store64(cmd + 24, 0);
    store64(cmd + 32, 0);
    return cmd;
}

fn draw_cmd_draw_indexed(index_count, instance_count, first_index, base_vertex, first_instance) {
    var cmd = alloc(40);
    store64(cmd, DRAW_CMD_DRAW_INDEXED);
    store64(cmd + 8, index_count);
    store64(cmd + 16, instance_count);
    store64(cmd + 24, first_index);
    store64(cmd + 32, base_vertex);
    return cmd;
}

# ================================================================
# RenderPipelineBuilder
# ================================================================
#
# Builder struct layout (80 bytes):
#   +0:  device (8)
#   +8:  shader_source (Str or cstr ptr, 8)
#   +16: vs_entry (cstr ptr, 8)
#   +24: fs_entry (cstr ptr or 0, 8)
#   +32: color_target_format (u32)
#   +36: color_target_blend (ptr to blend state or 0)
#   +44: depth_format (u32, 0 = no depth)
#   +48: cull_mode (u32 — 0=None, 1=Front, 2=Back)
#   +52: topology (u32 — 0=PointList, 1=LineList, 2=LineStrip, 3=TriangleList, 4=TriangleStrip)
#   +56: sample_count (u32)
#   +60: bind_group_layouts (vec ptr)
#   +68: vertex_layouts (vec ptr)
#   +76: label (cstr ptr)

fn rpb_new(device, shader_source, vs_entry) {
    var b = alloc(80);
    memset(b, 0, 80);
    store64(b, device);
    store64(b + 8, shader_source);
    store64(b + 16, vs_entry);
    store32(b + 32, WGPU_TEXTURE_FORMAT_BGRA8_UNORM_SRGB);
    store32(b + 52, 3);  # TriangleList
    store32(b + 56, 1);  # sample_count = 1
    store64(b + 60, vec_new());
    store64(b + 68, vec_new());
    return b;
}

fn rpb_fragment_entry(b, entry) { store64(b + 24, entry); return b; }
fn rpb_color_target(b, format, blend_ptr) {
    store32(b + 32, format);
    store64(b + 36, blend_ptr);
    return b;
}
fn rpb_depth(b, format) { store32(b + 44, format); return b; }
fn rpb_cull_mode(b, mode) { store32(b + 48, mode); return b; }
fn rpb_topology(b, topo) { store32(b + 52, topo); return b; }
fn rpb_multisample(b, count) { store32(b + 56, count); return b; }
fn rpb_label(b, label) { store64(b + 76, label); return b; }

fn rpb_bind_group(b, bgl) {
    vec_push(load64(b + 60), bgl);
    return b;
}

fn rpb_vertex_layout(b, layout_ptr) {
    vec_push(load64(b + 68), layout_ptr);
    return b;
}

# Build — creates the render pipeline
# TODO: implement with wgpuDeviceCreateRenderPipeline (needs FFI extension)
fn rpb_build(b) {
    var rp = alloc(24);
    store64(rp, 0);     # pipeline handle (populated when FFI available)
    store64(rp + 8, 0); # bind group layouts
    store64(rp + 16, 0);
    return rp;
}

fn render_pipeline_release(rp) {
    # TODO: release pipeline and layouts
    return 0;
}
