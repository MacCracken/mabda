# test_syslib.tcyr — minimal test for syslib dlopen
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/syscalls.cyr"
include "lib/mmap.cyr"
include "lib/fnptr.cyr"
include "lib/assert.cyr"
include "lib/dynlib.cyr"
include "lib/syslib.cyr"

fn main() {
    alloc_init();

    syscall(1, 1, "syslib_init...\n", 15);
    var ok = syslib_init();
    if (ok == 0) {
        syscall(1, 2, "syslib_init failed\n", 19);
        return 1;
    }
    syscall(1, 1, "syslib_init OK\n", 15);

    syscall(1, 1, "syslib_open libm...\n", 20);
    var h = syslib_open("/usr/lib/libm.so.6");
    if (h == 0) {
        syscall(1, 2, "syslib_open failed\n", 19);
        return 1;
    }
    syscall(1, 1, "syslib_open OK\n", 15);

    var floor = syslib_sym(h, "floor");
    if (floor == 0) {
        syscall(1, 2, "floor not found\n", 16);
        return 1;
    }
    syscall(1, 1, "floor found\n", 12);

    return 0;
}
var r = main();
syscall(60, r);
