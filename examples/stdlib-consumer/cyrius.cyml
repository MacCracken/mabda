[package]
name = "mabda-stdlib-consumer"
version = "0.1.0"
description = "Minimal example: use mabda as a Cyrius stdlib dep"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.4.64"

[build]
entry = "src/main.cyr"
output = "build/hello_gpu"

[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "io",
    "args",
    "hashmap",
    "syscalls",
    "tagged",
    "fnptr",
    "mmap",
    "dynlib",
    "sakshi",
]

# Mabda is a first-party trusted dep. `cyrius deps` resolves
# dist/mabda.cyr into the local lib/ tree; downstream `include "lib/mabda.cyr"`
# just works. The dist bundle carries all three backends (wgpu-native,
# native AMD, native NVIDIA) behind one public API; this consumer builds
# the default wgpu path and never changes source across the transition.
[deps.mabda]
git = "https://github.com/MacCracken/mabda.git"
tag = "4.0.7"
modules = ["dist/mabda.cyr"]

# ---------------------------------------------------------------------------
# Optional opt-in deps — this minimal example uses NEITHER. Uncomment the
# matching block only if you build mabda with the corresponding feature flag.
# ---------------------------------------------------------------------------

# PNG / baseline-JPEG decode (`gpu_texture_load_png` / `gpu_texture_load_jpeg`) —
# required under -D MABDA_PNG / -D MABDA_JPEG (one chitra dep serves both).
# chitra's bundle excludes its own stdlib deps, so add `thread` + `sankoch`
# to the [deps].stdlib list above when you enable this.
# [deps.chitra]
# git = "https://github.com/MacCracken/chitra.git"
# tag = "0.3.0"
# modules = ["dist/chitra.cyr"]

# logind master delegation (`gpu_surface_configure_native_logind`) —
# required only under -D MABDA_LOGIND. Consumer programs also link
# samvada/deps/samvada_main.c alongside their launcher.
# [deps.samvada]
# git = "https://github.com/MacCracken/samvada.git"
# tag = "0.4.1"
# modules = ["dist/samvada.cyr"]
