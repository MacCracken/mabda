[package]
name = "mabda-stdlib-consumer"
version = "0.1.0"
description = "Minimal example: use mabda as a Cyrius stdlib dep"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.6.4"

# No [build] section, on purpose. src/main.cyr has no entry point of its own: the C
# launcher's main() calls mabda_main, so the real build is the object-mode compile +
# gcc link in README.md (mabda's `make example-link` runs that recipe). Until 4.1.3
# this manifest declared [build] entry/output = src/main.cyr -> build/hello_gpu, so a
# bare `cyrius build` wrote a standalone ELF that exits 0 without calling mabda_main
# over the linked build/hello_gpu. Without [build], a bare `cyrius build` stops with
# its usage line instead. `cyrius check src/main.cyr` remains the compile-only check.

[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "io",
    "args",
    "hashmap",
    "syscalls",
    "tagged",
    "fnptr",
    "mmap",
    "dynlib",
    "sakshi",
]

# Mabda is a first-party trusted dep. `cyrius deps` resolves
# dist/mabda.cyr into the local lib/ tree; downstream `include "lib/mabda.cyr"`
# just works. The dist bundle carries all three backends (wgpu-native,
# native AMD, native NVIDIA) behind one public API; this consumer builds
# the default wgpu path and never changes source across the transition.
[deps.mabda]
git = "https://github.com/MacCracken/mabda.git"
tag = "4.1.3"
modules = ["dist/mabda.cyr"]

# ---------------------------------------------------------------------------
# Optional opt-in deps — this minimal example uses NEITHER. `cyrius deps`
# already pulls both in transitively through mabda's own cyrius.cyml; uncomment
# a block only to pin its version explicitly for the matching feature flag.
# ---------------------------------------------------------------------------

# PNG / baseline-JPEG decode (`gpu_texture_load_png` / `gpu_texture_load_jpeg`) —
# used under -D MABDA_PNG / -D MABDA_JPEG (one chitra dep serves both).
# chitra's bundle excludes its own stdlib deps; mabda's dist/mabda.deps already
# supplies `thread` + `sankoch`, or declare them in [deps].stdlib above.
# [deps.chitra]
# git = "https://github.com/MacCracken/chitra.git"
# tag = "1.0.3"
# modules = ["dist/chitra.cyr"]

# logind master delegation (`gpu_surface_configure_native_logind`) —
# used only under -D MABDA_LOGIND. samvada 1.0 is a pure-Cyrius dbus client
# (no C shim, no libsystemd): the consumer calls samvada_native_init() before
# configuring the surface; mabda never initializes samvada itself.
# [deps.samvada]
# git = "https://github.com/MacCracken/samvada.git"
# tag = "1.0.1"
# modules = ["dist/samvada.cyr"]
