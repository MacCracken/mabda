# hello_gpu — minimal mabda consumer example
#
# Proves the stdlib-inclusion contract: a consumer project writes no
# FFI code and depends only on mabda's public API. The C launcher
# lives at the edge of the consumer (in deps/), only on the wgpu path.
#
# Backend reality as of v4.0.1: mabda ships three backends behind one
# public API — wgpu-native (the cross-vendor default this example uses),
# native AMD (amdgpu DRM/GFX9, shipped v3.0), and native NVIDIA (nouveau
# DRM/SM75, shipped v4.0). The native paths need no C launcher at all.
# AMD-on-wgpu is deprecated at v4.0.1 (warn+allow by default; build with
# -D MABDA_AMD_WGPU_STRICT to hard-reject it) but the wgpu path itself
# remains the default cross-vendor route. This source compiles unchanged
# regardless of which backend the bundle is built for.
#
# Build (requires Cyrius 6.6.4+). This file has NO top-level entry: it is
# compiled as an OBJECT and linked with the C launcher, whose main() runs
# _cyrius_init + alloc_init and then calls mabda_main below. A plain
# `cyrius build` makes a standalone ELF that never calls mabda_main — it
# exits 0 and prints nothing. The exact recipe (the same object-mode + gcc
# link the mabda Makefile uses for its wgpu programs) is in README.md:
#   printf 'object;\n' | cat - src/main.cyr | cycc > build/hello_gpu.o
#   objcopy -L memcpy -L memset ... build/hello_gpu.o   # full -L list in README
#   gcc deps/wgpu_main.o build/hello_gpu.o \
#       deps/wgpu-native/lib/libwgpu_native.a -lpthread -ldl -lm -o build/hello_gpu

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/io.cyr"
include "lib/args.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/tagged.cyr"
include "lib/fnptr.cyr"
include "lib/mmap.cyr"
include "lib/sakshi.cyr"
include "lib/dynlib.cyr"
# thread_local.cyr defines thread_local_use_foreign_tls(), which the C launcher's
# main() calls before mabda_main (deps/wgpu_main.c). Nothing on the Cyrius side
# references it, so without this include the object still compiles clean and the
# gcc link fails with an undefined reference. It arrives in lib/ through
# dist/mabda.deps; mabda's own src/lib.cyr includes it for the same reason.
include "lib/thread_local.cyr"

# `cyrius deps` resolves [deps.mabda] from cyrius.cyml and copies
# dist/mabda.cyr into lib/mabda.cyr for us.
include "lib/mabda.cyr"

# Entry point called by the C launcher AFTER _cyrius_init + alloc_init (+ foreign-TLS setup);
# it wires the fn table itself via wgpu_ffi_init_table.
fn mabda_main(fn_table_ptr, preinit_ptr) {
    color_init();
    wgpu_ffi_init_table(fn_table_ptr);

    # 1. Acquire the pre-initialized GPU context from the launcher
    var res_tag, res = gpu_context_from_preinit(preinit_ptr);
    if (is_err_result(res_tag) == 1) {
        syscall(1, 2, "no GPU available\n", 17);
        return 1;
    }
    var ctx = res;
    var device = gpu_ctx_device(ctx);
    var queue = gpu_ctx_queue(ctx);
    syscall(1, 1, "hello_gpu: GPU context acquired\n", 32);

    # 2. Create a 4x4 RGBA texture
    var pixels[64];
    var pi = 0;
    while (pi < 64) {
        store8(&pixels + pi,     0x33);
        store8(&pixels + pi + 1, 0xCC);
        store8(&pixels + pi + 2, 0xFF);
        store8(&pixels + pi + 3, 0xFF);
        pi = pi + 4;
    }
    var t = texture_from_rgba(device, queue, &pixels, 4, 4, "hello-tex");
    if (t == 0) {
        syscall(1, 2, "texture creation failed\n", 24);
        return 1;
    }
    syscall(1, 1, "hello_gpu: texture uploaded\n", 28);

    # 3. Build a minimal render pipeline. Cyrius has no adjacent-literal
    # concatenation, so the WGSL is assembled in pieces to stay inside the
    # 120-byte line limit (the same pattern programs/phase0.cyr uses).
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "@vertex fn vs_main(@builtin(vertex_index) i: u32) -> ");
    str_builder_add_cstr(sb, "@builtin(position) vec4<f32> { let x = f32(i32(i) - 1); ");
    str_builder_add_cstr(sb, "let y = f32(i32(i & 1u) * 2 - 1); return vec4<f32>(x, y, 0.0, 1.0); } ");
    str_builder_add_cstr(sb, "@fragment fn fs_main() -> @location(0) vec4<f32> { ");
    str_builder_add_cstr(sb, "return vec4<f32>(1.0, 0.0, 0.0, 1.0); }");
    var wgsl = str_cstr(str_builder_build(sb));
    var src = wgpu_shader_source_wgsl(wgsl);
    var desc = wgpu_shader_module_descriptor("hello", src);
    var module = wgpu_device_create_shader_module(device, desc);
    var rp = render_pipeline_create_simple(device, module, WGPU_TEXTURE_FORMAT_RGBA8_UNORM);
    if (rp == 0) {
        syscall(1, 2, "render pipeline creation failed\n", 32);
        return 1;
    }
    syscall(1, 1, "hello_gpu: render pipeline ready\n", 33);

    # 4. Cleanup
    render_pipeline_release(rp);
    wgpu_shader_module_release(module);
    texture_release(t);

    syscall(1, 1, "hello_gpu: done\n", 16);
    return 0;
}
