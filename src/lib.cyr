# @public — mabda library include chain
# mabda — GPU foundation layer for AGNOS
#
# Provides: device lifecycle, buffer management, compute dispatch,
# texture handling, render pipelines, profiling, capability detection
#
# FFI target: wgpu-native C API (webgpu.h + wgpu.h) via a C launcher
# (deps/wgpu_main.c) that builds a function-pointer table and calls
# `mabda_main(fn_table_ptr, preinit_ptr)` defined by the consumer.
#
# Stdlib includes live ONLY in this file — domain modules are flat,
# which is what makes `cyrius distlib` (strip-include concatenation)
# produce a compile-clean `dist/mabda.cyr`.

# ================================================================
# Standard library
# ================================================================
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/io.cyr"
include "lib/args.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/tagged.cyr"
include "lib/fnptr.cyr"
include "lib/mmap.cyr"
include "lib/dynlib.cyr"
include "lib/sakshi.cyr"

# ================================================================
# Core modules (error, color, caps, profiler, resource)
# ================================================================
include "src/error.cyr"
include "src/color.cyr"
include "src/capabilities.cyr"
include "src/profiler.cyr"
include "src/resource.cyr"

# ================================================================
# wgpu FFI layer (types → descriptors → fn table)
# ================================================================
include "src/wgpu_types.cyr"
include "src/wgpu_descriptors.cyr"
include "src/wgpu_ffi.cyr"

# ================================================================
# Backend abstraction (v3 Phase B5, ADR 006) — @internal interface
# both backends fill. Backend.cyr defines the struct + slot
# accessors; backend_wgpu.cyr fills the slots with wgpu wrappers.
# Both must precede src/context.cyr because the public
# gpu_context_from_preinit allocates a default Backend at the +32
# slot of GpuContext (Step 3a, 2026-04-28).
# ================================================================
include "src/backend.cyr"
include "src/backend_wgpu.cyr"

# ================================================================
# GPU device lifecycle — depends on the backend abstraction above.
# ================================================================
include "src/context.cyr"

# ================================================================
# Native backend (v3 Phase B+, ADR 006) — pure Cyrius DRM path.
# AMD/amdgpu/GFX9 at v3.0; NVIDIA in v4.0; Intel tentative for v5.0.
# Internal-only during v3 dev; selected at build time per
# docs/proposals/v3-backend-interface.md.
# ================================================================
include "src/backend_native.cyr"
include "src/backend_native_kms.cyr"

# ================================================================
# Buffers, compute, caches
# gpu_timestamps depends on wgpu_ffi — stays after the FFI layer.
# ================================================================
include "src/buffer.cyr"
include "src/typed_buffer.cyr"
include "src/gpu_timestamps.cyr"
include "src/compute.cyr"
include "src/shader_cache.cyr"
include "src/pipeline_cache.cyr"
include "src/bind_group_cache.cyr"

# ================================================================
# Graphics — vertex/blend/sampler/depth → bind groups → textures →
# render targets/pipelines/passes → surface → instancing → debug.
# ================================================================
include "src/vertex.cyr"
include "src/blend.cyr"
include "src/sampler.cyr"
include "src/depth.cyr"
include "src/bind_group.cyr"
include "src/texture.cyr"
include "src/render_target.cyr"
include "src/render_pipeline.cyr"
include "src/render_pass.cyr"
include "src/render_graph.cyr"
include "src/surface.cyr"
include "src/instancing.cyr"
include "src/debug.cyr"
