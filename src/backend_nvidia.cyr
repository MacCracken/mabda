# @internal — native NVIDIA backend, Backend-slot integration (Phase N4.7)
# backend_nvidia.cyr — the backend_native.cyr analogue for the v4.0 NVIDIA
# arc. Fills the @internal `Backend` v0 slot block (offsets 0..80) so the
# pure-Cyrius nouveau compute path the N4 arc gate proved
# (programs/nvidia_compute_store.cyr) is reachable through the SAME public
# API (gpu_context_* / gpu_buffer_* / gpu_shader_module_* / gpu_compute_*)
# the wgpu + AMD-native backends use. Public surface does not change.
#
# v0 only (this phase): ctx_create_from_preinit (stub), ctx_release,
# buffer_create/write/read/release, shader_module_create/release,
# compute_dispatch, device_wait_idle, kind=+80. Texture / render / surface
# slots (88..328) land in N6 / N7 / N8. backend_is_complete stays honest:
# it walks 0..80 + the activated higher ranges; this backend fills only v0,
# so it reports incomplete past v0 until those phases — by design.
#
# DRIVES the HW-proven N4 path: a persistent channel + NVIF 0xC5C0 object +
# persistent QMD / pushbuffer / param-bank BOs allocated once at context
# create, reused per dispatch (the AMD cached-IB pattern). compute_dispatch
# writes the bound output buffer's VA into the param bank (c[0x0]+0x160,
# ptxas ABI), builds the QMD + dispatch pushbuffer, EXECs, and waits on an
# ABSOLUTE syncobj deadline (the N4 blocker was a relative deadline — see
# programs/nvidia_compute_store.cyr).
#
# NVIDIA GpuContext field map (reuses the 176-byte GpuContext blob). The
# cross-backend-fixed fields it MUST honor are the Backend* at +32 (read by
# gpu_ctx_backend) and the v3 surface consumer-stash slots at +96
# (wgpu_surface_handle — unused on native) and +104 (native_card_fd — written
# by gpu_surface_configure_native_kiosk BEFORE the configure slot runs). The
# param block was relocated past +104 (N8.5) so configuring a present surface
# can't clobber the persistent c[0x0] bank pointer the compute path reads:
#   +0   fd            (renderD128 render node)
#   +8   chid          (CHANNEL_ALLOC hardware channel id)
#   +16  nvif_handle   (NVIF 0xC5C0 class-object handle)
#   +24  va_cursor     (bump VA allocator: next free 64 KiB-aligned UMD VA)
#   +32  backend       (Backend* — REQUIRED canonical slot)
#   +40  qmd_handle    +48 qmd_va    +56 qmd_addr     (persistent QMD BO)
#   +64  push_handle   +72 push_va   +80 push_addr    (persistent pushbuf BO)
#   +88  param_handle  +112 param_va +120 param_addr  (persistent c[0x0] bank;
#        +96 / +104 deliberately skipped — reserved v3 surface-stash slots)

var NV_CTX_FD           = 0;
var NV_CTX_CHID         = 8;
var NV_CTX_NVIF_HANDLE  = 16;
var NV_CTX_VA_CURSOR    = 24;
var NV_CTX_BACKEND      = 32;
var NV_CTX_QMD_HANDLE   = 40;
var NV_CTX_QMD_VA       = 48;
var NV_CTX_QMD_ADDR     = 56;
var NV_CTX_PUSH_HANDLE  = 64;
var NV_CTX_PUSH_VA      = 72;
var NV_CTX_PUSH_ADDR    = 80;
var NV_CTX_PARAM_HANDLE = 88;
var NV_CTX_PARAM_VA     = 112;
var NV_CTX_PARAM_ADDR   = 120;

# NVIDIA buffer struct (32 bytes, the NativeBuf shape): handle, va, addr,
# size. The BO's mmap addr IS the data (CPU-coherent host BO), so write/read
# collapse to bounds-checked memcpy. `bp` (the dispatch bind pointer) points
# at one of these; the dispatch reads its VA at +8.
var NV_BUF_HANDLE = 0;
var NV_BUF_VA     = 8;
var NV_BUF_ADDR   = 16;
var NV_BUF_SIZE   = 24;
var NV_BUF_STRUCT_SIZE = 32;

# NVIDIA shader-module struct (40 bytes): handle, va (program GPU VA), addr
# (CPU mmap, for release), regcount, size. The QMD's PROGRAM_ADDRESS = va;
# REGISTER_COUNT_V = regcount.
var NV_SHMOD_HANDLE   = 0;
var NV_SHMOD_VA       = 8;
var NV_SHMOD_ADDR     = 16;
var NV_SHMOD_REGCOUNT = 24;
var NV_SHMOD_SIZE     = 32;
var NV_SHMOD_STRUCT_SIZE = 40;

# NVIDIA texture struct (48 bytes, the NativeTexture shape): a v0 NVIDIA
# texture is a host-visible LINEAR RGBA8 image — a 2D-shaped buffer. The BO
# mmap addr IS the pixels (row pitch = width*4, no tiling), so write/read are
# bounds-checked memcpy. GPU sampling (Turing TIC/TSC descriptors + a sampling
# dispatch) is a later N6 bite; these slots are the CPU-side image lifecycle.
var NV_TEX_HANDLE = 0;
var NV_TEX_VA     = 8;
var NV_TEX_ADDR   = 16;
var NV_TEX_SIZE   = 24;   # logical linear bytes = width*height*4 (r/w bound)
var NV_TEX_WIDTH  = 32;
var NV_TEX_HEIGHT = 36;
var NV_TEX_FMT    = 40;   # MABDA_TEXFMT_* (0 = RGBA8)
var NV_TEX_STRUCT_SIZE = 48;

# NVIDIA render-target struct (40 bytes — the AMD NATIVE_RT shape): a v0 RT is
# a host-visible LINEAR RGBA8 color surface, structurally the NV_TEX minus the
# fmt tag (an RT is always RGBA8 in v0). The 3D engine draws into it (the draw
# dispatch is N7.4); this v0 bite lands the CPU-side surface lifecycle (alloc +
# VM_BIND + map + release), the render analogue of the texture create slot.
# NV_RT_SIZE holds the ALLOCATED bytes = 128-aligned row pitch * height —
# the draw engine's stride (== width*height*4 only when width % 32 == 0).
# Readers must row-address at native_nv_rt_pitch_bytes(width), not width*4.
var NV_RT_HANDLE = 0;
var NV_RT_VA     = 8;
var NV_RT_ADDR   = 16;
var NV_RT_SIZE   = 24;   # allocated bytes (pitch * height, see above)
var NV_RT_WIDTH  = 32;
var NV_RT_HEIGHT = 36;
var NV_RT_STRUCT_SIZE = 40;

# Every nouveau BO this backend allocates is VM_BIND'd at a 64 KiB-aligned
# VA with a 64 KiB-multiple span (big-page mapping; QMD's 256-byte alignment
# is implied by 64 KiB). The N4 gate HW-proved the config at exactly 64 KiB;
# the 4.0.7 multi-size path keeps the alignment and sizes the BO + span to
# the object (_nv_align64k of the logical size — the AMD v3.4.3
# `_native_align_up(size, _NATIVE_TEXTURE_VA_ALIGN)` idiom). NV_BO_SIZE is
# the span granularity + the fixed size of the persistent context BOs
# (QMD / pushbuffer / param bank).
var NV_BO_SIZE = 0x10000;

# Per-object BO ceiling (the AMD _NATIVE_TEXTURE_VA_REGION analogue): bounds
# consumer-supplied sizes before use so _nv_align64k cannot overflow and one
# object cannot swallow the UMD VA range. 2 GiB.
var NV_BO_MAX_SIZE = 0x80000000;

# UMD VA allocator base: low, 64 KiB-aligned, well below the kernel-managed
# split (1<<39). The bump cursor starts here; persistent + per-object BOs all
# draw distinct 64 KiB-aligned, size-derived VA spans from it (the native
# no-reclaim model — VAs are not returned to the cursor on release; a context
# is process-lifetime).
var NV_VA_BASE = 0x100000;

# Round `n` up to a 64 KiB multiple (BO + VM_BIND span granularity).
fn _nv_align64k(n): i64 {
    return (n + 0xFFFF) / 0x10000 * 0x10000;
}

# Bump-allocate a distinct, 64 KiB-aligned UMD VA range of >= `size` bytes.
# Returns the VA and advances the cursor, or 0 if the span would reach the
# kernel-managed reservation at 1<<39 — the exhaustion backstop for the
# native no-reclaim model (VAs are not returned to the cursor on release; a
# context is process-lifetime).
fn _nv_ctx_alloc_va(ctx, size): i64 {
    var va = load64(ctx + NV_CTX_VA_CURSOR);
    var span = _nv_align64k(size);
    if (va + span > NOUVEAU_VM_KERNEL_RESERVATION_START) { return 0; }
    store64(ctx + NV_CTX_VA_CURSOR, va + span);
    return va;
}

# Accessors (read the NVIDIA GpuContext field map above).
fn nv_ctx_fd(ctx): i64   { return load64(ctx + NV_CTX_FD); }
fn nv_ctx_chid(ctx): i64 { return load64(ctx + NV_CTX_CHID); }

# Allocate one host BO of >= `size` bytes (rounded up to the 64 KiB span
# granularity), VM_BIND it at a fresh UMD VA, and return its pieces via
# `out` (24 bytes: +0 handle, +8 va, +16 cpu_addr). Returns 0 on success or
# a negative errno; on VA exhaustion or bind failure the BO is released so
# nothing leaks. `dom` is a NOUVEAU_GEM_DOMAIN_* set. The create slots cap
# `size` (NV_BO_MAX_SIZE) with a friendly 0-return before calling; the
# guards here are the defense-in-depth backstop.
fn _nv_ctx_bo_alloc_bind(ctx, dom, size, out): i64 {
    store64(out + 0, 0);
    store64(out + 8, 0);
    store64(out + 16, 0);
    if (size <= 0)             { return 0 - 22; }   # -EINVAL
    if (size > NV_BO_MAX_SIZE) { return 0 - 22; }   # -EINVAL
    var span = _nv_align64k(size);
    var fd = nv_ctx_fd(ctx);
    var bo[16];
    var rc = native_nv_bo_create_dom(fd, span, dom, &bo);
    if (rc != 0) { return rc; }
    var handle = load64(&bo + 0);
    var addr   = load64(&bo + 8);
    var va = _nv_ctx_alloc_va(ctx, span);
    if (va == 0) {
        native_nv_bo_release_host(fd, handle, addr, span);
        return 0 - 12;   # -ENOMEM: UMD VA range exhausted
    }
    rc = native_nv_vm_bind_map(fd, handle, va, span);
    if (rc != 0) {
        native_nv_bo_release_host(fd, handle, addr, span);
        return rc;
    }
    store64(out + 0, handle);
    store64(out + 8, va);
    store64(out + 16, addr);
    return 0;
}

# ================================================================
# Context bring-up (the gpu_context_new_native analogue, NVIDIA)
# ================================================================
# Opens renderD128, VM_INIT, CHANNEL_ALLOC a GR (compute) channel, creates
# the TURING_COMPUTE_A 0xC5C0 class object via NVIF, allocates the three
# persistent BOs (QMD / pushbuffer / param bank), and attaches a
# backend_nvidia_new() at +32. Returns Result<ctx>. Mirrors the N4 gate's
# setup but with the persistent-BO + VA-allocator shape of a real context.
fn gpu_context_new_native_nvidia(): i64 {
    var fd = native_open_render_node();
    if (fd < 0) { return gpu_err_result(_native_neg_rc_to_gpu_err(fd)); }

    var rc = native_nv_vm_init(fd, NOUVEAU_VM_KERNEL_RESERVATION_START,
      NOUVEAU_VM_KERNEL_RESERVATION_SIZE);
    if (rc != 0) {
        var rc_save = rc; sys_close(fd);
        return gpu_err_result(_native_neg_rc_to_gpu_err(rc_save));
    }

    var chan[88];
    rc = native_nv_channel_alloc(fd, &chan);
    if (rc != 0) {
        var rc_save = rc; sys_close(fd);
        return gpu_err_result(_native_neg_rc_to_gpu_err(rc_save));
    }
    var chid = native_nv_channel_id(&chan);

    var nvif_handle = native_nv_object_handle(chid, TURING_COMPUTE_A);
    rc = native_nv_object_new(fd, chid, nvif_handle, TURING_COMPUTE_A);
    if (rc != 0) {
        var rc_save = rc; native_nv_channel_free(fd, chid); sys_close(fd);
        return gpu_err_result(_native_neg_rc_to_gpu_err(rc_save));
    }

    # v2 render (N7.5): also create the Turing 3D class (TURING_A 0xC597) on the
    # same channel so render_pass_draw's SET_OBJECT(0xC597) resolves. Distinct
    # NVIF handle from compute (handle low byte = oclass&0xff: 0xC0 vs 0x97);
    # channel_free reaps both at release, so no separate handle is stored.
    var nvif_3d = native_nv_object_handle(chid, TURING_A);
    rc = native_nv_object_new(fd, chid, nvif_3d, TURING_A);
    if (rc != 0) {
        var rc_save = rc; native_nv_channel_free(fd, chid); sys_close(fd);
        return gpu_err_result(_native_neg_rc_to_gpu_err(rc_save));
    }

    var ctx = alloc(GPU_CONTEXT_SIZE);
    memset(ctx, 0, GPU_CONTEXT_SIZE);
    store64(ctx + NV_CTX_FD, fd);
    store64(ctx + NV_CTX_CHID, chid);
    store64(ctx + NV_CTX_NVIF_HANDLE, nvif_handle);
    store64(ctx + NV_CTX_VA_CURSOR, NV_VA_BASE);

    # Three persistent host BOs, VM_BIND'd once: QMD, pushbuffer, param bank.
    var bo[24];
    rc = _nv_ctx_bo_alloc_bind(ctx, NOUVEAU_GEM_DOMAIN_HOST, NV_BO_SIZE, &bo);
    if (rc != 0) {
        native_nv_channel_free(fd, chid); sys_close(fd);
        return gpu_err_result(_native_neg_rc_to_gpu_err(rc));
    }
    store64(ctx + NV_CTX_QMD_HANDLE, load64(&bo + 0));
    store64(ctx + NV_CTX_QMD_VA,     load64(&bo + 8));
    store64(ctx + NV_CTX_QMD_ADDR,   load64(&bo + 16));

    rc = _nv_ctx_bo_alloc_bind(ctx, NOUVEAU_GEM_DOMAIN_HOST, NV_BO_SIZE, &bo);
    if (rc != 0) {
        native_nv_channel_free(fd, chid); sys_close(fd);
        return gpu_err_result(_native_neg_rc_to_gpu_err(rc));
    }
    store64(ctx + NV_CTX_PUSH_HANDLE, load64(&bo + 0));
    store64(ctx + NV_CTX_PUSH_VA,     load64(&bo + 8));
    store64(ctx + NV_CTX_PUSH_ADDR,   load64(&bo + 16));

    rc = _nv_ctx_bo_alloc_bind(ctx, NOUVEAU_GEM_DOMAIN_HOST, NV_BO_SIZE, &bo);
    if (rc != 0) {
        native_nv_channel_free(fd, chid); sys_close(fd);
        return gpu_err_result(_native_neg_rc_to_gpu_err(rc));
    }
    store64(ctx + NV_CTX_PARAM_HANDLE, load64(&bo + 0));
    store64(ctx + NV_CTX_PARAM_VA,     load64(&bo + 8));
    store64(ctx + NV_CTX_PARAM_ADDR,   load64(&bo + 16));

    store64(ctx + NV_CTX_BACKEND, backend_nvidia_new());
    _sk_info_cstr("mabda: gpu context created (native nvidia)");
    return gpu_ok(ctx);
}

# ================================================================
# v0 slot implementations
# ================================================================

# Native NVIDIA contexts are built via gpu_context_new_native_nvidia(), not
# from a wgpu-shaped preinit struct — stub, matching the AMD slot.
fn _backend_nvidia_ctx_create_from_preinit(preinit_ptr): i64 {
    return 0;
}

# Release: free the NVIF object's channel, close the fd (which auto-releases
# all BOs the channel owns). Null-safe.
fn _backend_nvidia_ctx_release(ctx): i64 {
    if (ctx == 0) { return 0; }
    var fd = nv_ctx_fd(ctx);
    var chid = nv_ctx_chid(ctx);
    if (fd > 0) {
        native_nv_channel_free(fd, chid);
        sys_close(fd);
    }
    return 0;
}

# Create a host-visible buffer of `size` bytes (a host BO of the 64 KiB-
# aligned span VM_BIND'd at a fresh VA; SIZE stays logical — consumers query
# it and write/read bound against it, release re-derives the span). `usage`
# is ignored (a host BO is general-purpose). Returns an NV_BUF struct ptr or
# 0 on bad input / ioctl failure.
fn _backend_nvidia_buffer_create(ctx, size, usage): i64 {
    if (ctx == 0) { return 0; }
    if (size <= 0) { return 0; }
    if (size > NV_BO_MAX_SIZE) { return 0; }   # bound before align (2 GiB)
    var bo[24];
    if (_nv_ctx_bo_alloc_bind(ctx, NOUVEAU_GEM_DOMAIN_HOST, size, &bo) != 0) { return 0; }
    var buf = alloc(NV_BUF_STRUCT_SIZE);
    memset(buf, 0, NV_BUF_STRUCT_SIZE);
    store64(buf + NV_BUF_HANDLE, load64(&bo + 0));
    store64(buf + NV_BUF_VA,     load64(&bo + 8));
    store64(buf + NV_BUF_ADDR,   load64(&bo + 16));
    store64(buf + NV_BUF_SIZE,   size);   # logical
    return buf;
}

# Bounds-checked memcpy into the buffer's coherent mmap. Overflow-safe (off
# checked > size before computing size-off). Returns 0|GPU_ERR_*.
fn _backend_nvidia_buffer_write(ctx, buf, off, ptr, n): i64 {
    if (ctx == 0) { return GPU_ERR_OTHER; }
    if (buf == 0) { return GPU_ERR_OTHER; }
    if (ptr == 0) { return GPU_ERR_BUFFER; }
    if (n <= 0)   { return GPU_ERR_BUFFER; }
    if (off < 0)  { return GPU_ERR_BUFFER; }
    var size = load64(buf + NV_BUF_SIZE);
    var addr = load64(buf + NV_BUF_ADDR);
    if (addr == 0) { return GPU_ERR_BUFFER; }
    if (off > size) { return GPU_ERR_BUFFER; }
    if (n > size - off) { return GPU_ERR_BUFFER; }
    memcpy(addr + off, ptr, n);
    return 0;
}

# Symmetric bounds-checked memcpy out of the buffer. Returns 0|GPU_ERR_*.
fn _backend_nvidia_buffer_read(ctx, buf, off, ptr, n): i64 {
    if (ctx == 0) { return GPU_ERR_OTHER; }
    if (buf == 0) { return GPU_ERR_OTHER; }
    if (ptr == 0) { return GPU_ERR_BUFFER; }
    if (n <= 0)   { return GPU_ERR_BUFFER; }
    if (off < 0)  { return GPU_ERR_BUFFER; }
    var size = load64(buf + NV_BUF_SIZE);
    var addr = load64(buf + NV_BUF_ADDR);
    if (addr == 0) { return GPU_ERR_BUFFER; }
    if (off > size) { return GPU_ERR_BUFFER; }
    if (n > size - off) { return GPU_ERR_BUFFER; }
    memcpy(ptr, addr + off, n);
    return 0;
}

# Release a buffer: VM_UNBIND + BO release, then zero the struct. The fd
# close at ctx_release would also reap it, but explicit release lets a
# program churn buffers without leaking VAs’ BOs. Null-safe.
fn _backend_nvidia_buffer_release(ctx, buf): i64 {
    if (ctx == 0) { return 0; }
    if (buf == 0) { return 0; }
    var fd = nv_ctx_fd(ctx);
    var handle = load64(buf + NV_BUF_HANDLE);
    var va     = load64(buf + NV_BUF_VA);
    var addr   = load64(buf + NV_BUF_ADDR);
    # Re-derive the bind span from the stored logical size, exactly as the
    # create slot sized it (the AMD release idiom).
    var span   = _nv_align64k(load64(buf + NV_BUF_SIZE));
    if (handle != 0) {
        native_nv_vm_unbind(fd, va, span);
        native_nv_bo_release_host(fd, handle, addr, span);
    }
    memset(buf, 0, NV_BUF_STRUCT_SIZE);
    return 0;
}

# Create a shader module from pre-compiled SM75 SASS bytes. `kind` should be
# SHADER_SRC_SASS (the NVIDIA tag); v0 accepts the bytes verbatim into a host
# BO VM_BIND'd at a fresh VA (the QMD's PROGRAM_ADDRESS). REGISTER_COUNT is
# the proof-of-life default (the captured store_deadbeef kernel = 4 GPRs);
# real per-shader regcount metadata arrives with the N9 SPIR-V->SASS compiler.
# Returns an NV_SHMOD struct ptr or 0 on failure.
fn _backend_nvidia_shader_module_create(ctx, bytes_ptr, n, kind): i64 {
    if (ctx == 0) { return 0; }
    if (bytes_ptr == 0) { return 0; }
    if (n <= 0) { return 0; }
    if (n > NV_BO_MAX_SIZE) { return 0; }
    var bo[24];
    if (_nv_ctx_bo_alloc_bind(ctx, NOUVEAU_GEM_DOMAIN_HOST, n, &bo) != 0) { return 0; }
    var addr = load64(&bo + 16);
    memcpy(addr, bytes_ptr, n);   # SASS program bytes -> the program BO
    var shmod = alloc(NV_SHMOD_STRUCT_SIZE);
    memset(shmod, 0, NV_SHMOD_STRUCT_SIZE);
    store64(shmod + NV_SHMOD_HANDLE,   load64(&bo + 0));
    store64(shmod + NV_SHMOD_VA,       load64(&bo + 8));
    store64(shmod + NV_SHMOD_ADDR,     addr);
    store64(shmod + NV_SHMOD_REGCOUNT, NV_SASS_STORE_DEADBEEF_REGCOUNT);
    store64(shmod + NV_SHMOD_SIZE,     n);
    return shmod;
}

# Release a shader module: VM_UNBIND + BO release, zero the struct. Null-safe.
fn _backend_nvidia_shader_module_release(ctx, shmod): i64 {
    if (ctx == 0) { return 0; }
    if (shmod == 0) { return 0; }
    var fd = nv_ctx_fd(ctx);
    var handle = load64(shmod + NV_SHMOD_HANDLE);
    var va     = load64(shmod + NV_SHMOD_VA);
    var addr   = load64(shmod + NV_SHMOD_ADDR);
    var span   = _nv_align64k(load64(shmod + NV_SHMOD_SIZE));
    if (handle != 0) {
        native_nv_vm_unbind(fd, va, span);
        native_nv_bo_release_host(fd, handle, addr, span);
    }
    memset(shmod, 0, NV_SHMOD_STRUCT_SIZE);
    return 0;
}

# Dispatch a compute grid (x,y,z workgroups) of `shmod` with the buffer at
# `bp` bound as c[0x0]+0x160 (the ptxas kernel-param output pointer). Builds
# the QMD + dispatch pushbuffer into the persistent context BOs, EXECs on the
# channel, and waits on an ABSOLUTE syncobj deadline (the N4 blocker fix).
# Returns 0|GPU_ERR_*.
fn _backend_nvidia_compute_dispatch(ctx, shmod, x, y, z, bp): i64 {
    if (ctx == 0)   { return GPU_ERR_OTHER; }
    if (shmod == 0) { return GPU_ERR_OTHER; }
    if (bp == 0)    { return GPU_ERR_OTHER; }
    if (x <= 0) { return GPU_ERR_WORKGROUP_LIMIT; }
    if (y <= 0) { return GPU_ERR_WORKGROUP_LIMIT; }
    if (z <= 0) { return GPU_ERR_WORKGROUP_LIMIT; }
    if (validate_dispatch(x, y, z, MABDA_MAX_DISPATCH_DIM) != 0) {
        return GPU_ERR_WORKGROUP_LIMIT;
    }

    var fd   = nv_ctx_fd(ctx);
    var chid = nv_ctx_chid(ctx);
    var prog_va  = load64(shmod + NV_SHMOD_VA);
    var regcount = load64(shmod + NV_SHMOD_REGCOUNT);
    var out_va   = load64(bp + NV_BUF_VA);
    var qmd_addr   = load64(ctx + NV_CTX_QMD_ADDR);
    var qmd_va     = load64(ctx + NV_CTX_QMD_VA);
    var push_addr  = load64(ctx + NV_CTX_PUSH_ADDR);
    var push_va    = load64(ctx + NV_CTX_PUSH_VA);
    var param_addr = load64(ctx + NV_CTX_PARAM_ADDR);
    var param_va   = load64(ctx + NV_CTX_PARAM_VA);

    # Param bank: output pointer at c[0x0]+0x160 (ptxas sm_70+ kernel-param ABI).
    store64(param_addr + 0x160, out_va);
    # QMD: program / regcount / const0 = the param bank (size 0x200).
    native_nv_qmd_build(qmd_addr, prog_va, regcount, param_va, 0x200);
    # Honor the requested grid (the builder defaults to 1,1,1):
    # CTA_RASTER_WIDTH/HEIGHT/DEPTH at QMD +0x30/+0x34/+0x38.
    store32(qmd_addr + 0x30, x);
    store32(qmd_addr + 0x34, y);
    store32(qmd_addr + 0x38, z);
    # Dispatch pushbuffer: SET_OBJECT + memory windows + SEND_PCAS.
    var push_len = native_nv_push_dispatch(push_addr, qmd_va);

    var so[8];
    memset(&so, 0, 8);
    if (native_syncobj_create(fd, &so) != 0) { return GPU_ERR_OTHER; }
    var sh = load32(&so);
    # ABSOLUTE CLOCK_MONOTONIC deadline (now+1s) — native_syncobj_wait does
    # NOT take a relative timeout. A bare 1e9 (=1s after boot) returns ETIME
    # instantly, before nouveau's async EXEC fence signals. This was THE N4
    # gate blocker.
    var deadline = _time_now_ns() + 1000000000;

    var rc = native_nv_exec_submit(fd, chid, push_va, push_len, sh);
    if (rc != 0) { native_syncobj_destroy(fd, sh); return GPU_ERR_OTHER; }
    rc = native_syncobj_wait(fd, sh, deadline);
    native_syncobj_destroy(fd, sh);
    if (rc != 0) { return GPU_ERR_OTHER; }
    return 0;
}

# Native dispatch is synchronous (waits on the syncobj before returning), so
# device_wait_idle is a no-op — matches the AMD slot.
fn _backend_nvidia_device_wait_idle(ctx): i64 {
    return 0;
}

# ================================================================
# v1 texture slots (88..120) — host-visible linear RGBA8
# ================================================================

# Create a 2D RGBA8 linear texture (a host BO of the 64 KiB-aligned
# width*height*4 span, VM_BIND'd at a fresh VA). Dimensions are capped
# (validate_dimensions, <=8192 per axis) so width*height*4 cannot overflow
# and stays under NV_BO_MAX_SIZE (8192^2*4 = 256 MiB). SIZE stays logical;
# release re-derives the span. Returns an NV_TEX struct ptr or 0 on bad
# input / ioctl failure.
fn _backend_nvidia_texture_create_2d_rgba8(ctx, width, height): i64 {
    if (ctx == 0) { return 0; }
    if (width <= 0)  { return 0; }
    if (height <= 0) { return 0; }
    if (validate_dimensions(width, height, MABDA_MAX_TEXTURE_DIM_2D) != 0) {
        return 0;
    }
    var logical = width * height * 4;
    var bo[24];
    if (_nv_ctx_bo_alloc_bind(ctx, NOUVEAU_GEM_DOMAIN_HOST, logical, &bo) != 0) { return 0; }
    var tex = alloc(NV_TEX_STRUCT_SIZE);
    memset(tex, 0, NV_TEX_STRUCT_SIZE);
    store64(tex + NV_TEX_HANDLE, load64(&bo + 0));
    store64(tex + NV_TEX_VA,     load64(&bo + 8));
    store64(tex + NV_TEX_ADDR,   load64(&bo + 16));
    store64(tex + NV_TEX_SIZE,   logical);
    store32(tex + NV_TEX_WIDTH,  width);
    store32(tex + NV_TEX_HEIGHT, height);
    store32(tex + NV_TEX_FMT,    MABDA_TEXFMT_RGBA8);
    return tex;
}

# Write `n` bytes of RGBA8 pixels from `src` into the texture (whole-image,
# from offset 0). Bounds-checked memcpy on the coherent mapping. 0|GPU_ERR_*.
fn _backend_nvidia_texture_write(ctx, tex, src, n): i64 {
    if (ctx == 0) { return GPU_ERR_OTHER; }
    if (tex == 0) { return GPU_ERR_OTHER; }
    if (src == 0) { return GPU_ERR_TEXTURE; }
    if (n <= 0)   { return GPU_ERR_TEXTURE; }
    var size = load64(tex + NV_TEX_SIZE);
    var addr = load64(tex + NV_TEX_ADDR);
    if (addr == 0) { return GPU_ERR_TEXTURE; }
    if (n > size)  { return GPU_ERR_TEXTURE; }
    memcpy(addr, src, n);
    return 0;
}

# Read `n` bytes of RGBA8 pixels from the texture into `dst`. Symmetric
# bounds-checked memcpy. 0|GPU_ERR_*.
fn _backend_nvidia_texture_read(ctx, tex, dst, n): i64 {
    if (ctx == 0) { return GPU_ERR_OTHER; }
    if (tex == 0) { return GPU_ERR_OTHER; }
    if (dst == 0) { return GPU_ERR_TEXTURE; }
    if (n <= 0)   { return GPU_ERR_TEXTURE; }
    var size = load64(tex + NV_TEX_SIZE);
    var addr = load64(tex + NV_TEX_ADDR);
    if (addr == 0) { return GPU_ERR_TEXTURE; }
    if (n > size)  { return GPU_ERR_TEXTURE; }
    memcpy(dst, addr, n);
    return 0;
}

# Release a texture: VM_UNBIND + BO release, zero the struct. Null-safe.
fn _backend_nvidia_texture_release(ctx, tex): i64 {
    if (ctx == 0) { return 0; }
    if (tex == 0) { return 0; }
    var fd = nv_ctx_fd(ctx);
    var handle = load64(tex + NV_TEX_HANDLE);
    var va     = load64(tex + NV_TEX_VA);
    var addr   = load64(tex + NV_TEX_ADDR);
    var span   = _nv_align64k(load64(tex + NV_TEX_SIZE));
    if (handle != 0) {
        native_nv_vm_unbind(fd, va, span);
        native_nv_bo_release_host(fd, handle, addr, span);
    }
    memset(tex, 0, NV_TEX_STRUCT_SIZE);
    return 0;
}

# ================================================================
# v2 render slots (120..176) — N7.1: render-target lifecycle
# ================================================================

# Create a 2D RGBA8 render target (a host BO VM_BIND'd at a fresh VA via
# the per-context bump allocator, so multiple live RTs get distinct VAs).
# SIZED FROM THE DRAW ENGINE'S STRIDE, not the packed pixels: the 3D engine
# stores rows at the 128-aligned byte pitch (native_nv_rt_pitch_bytes — the
# LAYOUT_PITCH contract native_nv_push_draw programs), so the BO must hold
# pitch * height bytes or a width % 32 != 0 target rasters past the VM_BIND
# span (unmapped-VA MMU fault / silent neighbor corruption — 4.0.7 review
# find; the class predates the multi-size allocator). Dimensions are capped
# (validate_dimensions, <=8192 per axis) so pitch * height cannot overflow
# and stays under NV_BO_MAX_SIZE (32768 * 8192 = 256 MiB). NV_RT_SIZE holds
# the padded size; release re-derives the span from it. Returns an NV_RT
# struct ptr or 0 on bad input / ioctl failure.
fn _backend_nvidia_render_target_create_2d_rgba8(ctx, width, height): i64 {
    if (ctx == 0) { return 0; }
    if (width <= 0)  { return 0; }
    if (height <= 0) { return 0; }
    if (validate_dimensions(width, height, MABDA_MAX_TEXTURE_DIM_2D) != 0) {
        return 0;
    }
    var padded = native_nv_rt_pitch_bytes(width) * height;
    var bo[24];
    if (_nv_ctx_bo_alloc_bind(ctx, NOUVEAU_GEM_DOMAIN_HOST, padded, &bo) != 0) { return 0; }
    var rt = alloc(NV_RT_STRUCT_SIZE);
    memset(rt, 0, NV_RT_STRUCT_SIZE);
    store64(rt + NV_RT_HANDLE, load64(&bo + 0));
    store64(rt + NV_RT_VA,     load64(&bo + 8));
    store64(rt + NV_RT_ADDR,   load64(&bo + 16));
    store64(rt + NV_RT_SIZE,   padded);
    store32(rt + NV_RT_WIDTH,  width);
    store32(rt + NV_RT_HEIGHT, height);
    return rt;
}

# Release a render target: VM_UNBIND + BO release, zero the struct. Null-safe.
fn _backend_nvidia_render_target_release(ctx, rt): i64 {
    if (ctx == 0) { return 0; }
    if (rt == 0)  { return 0; }
    var fd = nv_ctx_fd(ctx);
    var handle = load64(rt + NV_RT_HANDLE);
    var va     = load64(rt + NV_RT_VA);
    var addr   = load64(rt + NV_RT_ADDR);
    var span   = _nv_align64k(load64(rt + NV_RT_SIZE));
    if (handle != 0) {
        native_nv_vm_unbind(fd, va, span);
        native_nv_bo_release_host(fd, handle, addr, span);
    }
    memset(rt, 0, NV_RT_STRUCT_SIZE);
    return 0;
}

# ================================================================
# v2 render slots (136..168) — N7.5: pipeline / pass / draw
# ================================================================
# The public-API path to the HW-proven render mechanism (N7.4). Routes the
# gpu_render_pipeline_* / gpu_render_pass_* calls through native_nv_push_draw.

# NVIDIA render-pipeline struct (32 bytes): the VS/FS program VAs (each points
# at its 128-byte SPH) + regcounts, pulled from the shader modules.
var NV_PIPE_VS_VA       = 0;
var NV_PIPE_FS_VA       = 8;
var NV_PIPE_VS_REGCOUNT = 16;
var NV_PIPE_FS_REGCOUNT = 24;
var NV_PIPE_STRUCT_SIZE = 32;

# NVIDIA render-pass struct (24 bytes): ctx + the bound RT + the clear color
# (stored for ABI parity; v2 skips the clear — a fullscreen triangle covers
# every pixel — so clear_color is advisory).
var NV_PASS_CTX         = 0;
var NV_PASS_RT          = 8;
var NV_PASS_CLEAR_COLOR = 16;
var NV_PASS_STRUCT_SIZE = 24;

# Create a render pipeline from a VS + FS shader module (the shmod convention:
# program VA @ +8 points at the SPH, regcount @ +24). color_fmt is accepted for
# slot ABI parity but ignored (v2 = RGBA8 linear). Returns an NV_PIPE ptr or 0.
fn _backend_nvidia_render_pipeline_create(ctx, vs_mod, fs_mod, color_fmt): i64 {
    if (ctx == 0)    { return 0; }
    if (vs_mod == 0) { return 0; }
    if (fs_mod == 0) { return 0; }
    var pipe = alloc(NV_PIPE_STRUCT_SIZE);
    memset(pipe, 0, NV_PIPE_STRUCT_SIZE);
    store64(pipe + NV_PIPE_VS_VA,       load64(vs_mod + NV_SHMOD_VA));
    store64(pipe + NV_PIPE_FS_VA,       load64(fs_mod + NV_SHMOD_VA));
    store64(pipe + NV_PIPE_VS_REGCOUNT, load64(vs_mod + NV_SHMOD_REGCOUNT));
    store64(pipe + NV_PIPE_FS_REGCOUNT, load64(fs_mod + NV_SHMOD_REGCOUNT));
    return pipe;
}

# Release a render pipeline: zero the struct. Null-safe.
fn _backend_nvidia_render_pipeline_release(ctx, pipe): i64 {
    if (ctx == 0)  { return 0; }
    if (pipe == 0) { return 0; }
    memset(pipe, 0, NV_PIPE_STRUCT_SIZE);
    return 0;
}

# Begin a render pass on `rt` with a clear color. Returns an NV_PASS ptr or 0.
fn _backend_nvidia_render_pass_begin(ctx, rt, clear_color_ptr): i64 {
    if (ctx == 0) { return 0; }
    if (rt == 0)  { return 0; }
    if (clear_color_ptr == 0) { return 0; }
    var p = alloc(NV_PASS_STRUCT_SIZE);
    memset(p, 0, NV_PASS_STRUCT_SIZE);
    store64(p + NV_PASS_CTX,         ctx);
    store64(p + NV_PASS_RT,          rt);
    store64(p + NV_PASS_CLEAR_COLOR, clear_color_ptr);
    return p;
}

# Draw `vc` vertices (instance count must be 1) of `pipe`'s VS/FS into the
# pass's RT: assemble the draw params, build the clc597 draw pushbuffer into the
# context's persistent push BO, EXEC on the channel, and wait on an absolute
# syncobj deadline (mirrors compute_dispatch). v2: single draw per pass, no
# clear (the fullscreen triangle covers the RT). Returns 0|GPU_ERR_*.
fn _backend_nvidia_render_pass_draw(ctx, pass, pipe, vc, ic): i64 {
    if (ctx == 0)  { return GPU_ERR_OTHER; }
    if (pass == 0) { return GPU_ERR_OTHER; }
    if (pipe == 0) { return GPU_ERR_OTHER; }
    if (vc <= 0)   { return GPU_ERR_OTHER; }
    if (ic != 1)   { return GPU_ERR_OTHER; }   # v2: single-instance only
    var rt = load64(pass + NV_PASS_RT);
    if (rt == 0) { return GPU_ERR_OTHER; }
    var rt_va  = load64(rt + NV_RT_VA);
    var width  = load32(rt + NV_RT_WIDTH);
    var height = load32(rt + NV_RT_HEIGHT);
    if (rt_va == 0)  { return GPU_ERR_OTHER; }
    if (width <= 0)  { return GPU_ERR_OTHER; }
    if (height <= 0) { return GPU_ERR_OTHER; }
    var vs_va = load64(pipe + NV_PIPE_VS_VA);
    var fs_va = load64(pipe + NV_PIPE_FS_VA);
    if (vs_va == 0) { return GPU_ERR_OTHER; }
    if (fs_va == 0) { return GPU_ERR_OTHER; }

    var fd   = nv_ctx_fd(ctx);
    var chid = nv_ctx_chid(ctx);
    var push_addr = load64(ctx + NV_CTX_PUSH_ADDR);
    var push_va   = load64(ctx + NV_CTX_PUSH_VA);

    var dp[56];
    memset(&dp, 0, 56);
    store64(&dp + NV_DRAW_RT_VA,       rt_va);
    store64(&dp + NV_DRAW_RT_WIDTH,    width);
    store64(&dp + NV_DRAW_RT_HEIGHT,   height);
    store64(&dp + NV_DRAW_VS_VA,       vs_va);
    store64(&dp + NV_DRAW_FS_VA,       fs_va);
    store64(&dp + NV_DRAW_VS_REGCOUNT, load64(pipe + NV_PIPE_VS_REGCOUNT));
    store64(&dp + NV_DRAW_FS_REGCOUNT, load64(pipe + NV_PIPE_FS_REGCOUNT));
    var push_len = native_nv_push_draw(push_addr, &dp, vc);

    var so[8];
    memset(&so, 0, 8);
    if (native_syncobj_create(fd, &so) != 0) { return GPU_ERR_OTHER; }
    var sh = load32(&so);
    var deadline = _time_now_ns() + 1000000000;
    var rc = native_nv_exec_submit(fd, chid, push_va, push_len, sh);
    if (rc != 0) { native_syncobj_destroy(fd, sh); return GPU_ERR_OTHER; }
    rc = native_syncobj_wait(fd, sh, deadline);
    native_syncobj_destroy(fd, sh);
    if (rc != 0) { return GPU_ERR_OTHER; }
    return 0;
}

# End a render pass: zero the struct. Null-safe.
fn _backend_nvidia_render_pass_end(ctx, pass): i64 {
    if (ctx == 0)  { return 0; }
    if (pass == 0) { return 0; }
    memset(pass, 0, NV_PASS_STRUCT_SIZE);
    return 0;
}

# ================================================================
# v3 surface slots (176..208) — nouveau double-buffered KMS present
# ================================================================
# The nouveau analogue of backend_native.cyr's NativeSurface. The consumer
# pre-opens /dev/dri/cardN + SET_MASTER and passes it through
# gpu_surface_configure_native_kiosk, which stashes it at gpu_ctx +104;
# configure reads it back, runs KMS discovery on the first CONNECTED connector,
# saves the console CRTC (GETCRTC) for a clean restore, allocates two VRAM
# scanout FBs (BO -> PRIME -> ADDFB2), and SETCRTCs FB0. acquire returns the
# back FB (the one NOT scanning out); the consumer CPU-fills its mapped bytes.
# present PAGE_FLIPs the back FB, blocks on the flip-complete vblank, and
# toggles. release restores the console CRTC (or disables it), frees both FBs,
# and releases the KMS state. Only the scanout BO (native_nv_bo_create_dom,
# VRAM) is nouveau-specific — discovery / PRIME / ADDFB2 / SETCRTC / PAGE_FLIP
# are the driver-agnostic backend_native_kms.cyr helpers (the same ones the AMD
# slots call; only the BO allocator differs, which is why these slots don't
# reuse native_kms_modeset_first_connected / native_kms_alloc_fb — those bake
# in the AMDGPU native_bo_create_gtt allocator).
#
# NvSurface (232 bytes):
#   +0   card_fd      i32   consumer-owned DRM master card node (kiosk)
#   +4   render_fd    i32   render node (copied from nv_ctx_fd at configure)
#   +8   state        u64   KmsState* (native_kms_init)
#   +16  conn_id      u32   the connected connector
#   +20  crtc_id      u32   the CRTC driving it
#   +24  front        u32   which FB is on-screen (0 -> fb0, 1 -> fb1)
#   +28  have_saved   u32   1 if saved[] holds a restorable console CRTC config
#   +32  width        u32   actual mode width
#   +36  height       u32   actual mode height
#   +40  pitch        u32   256-aligned bytes per row
#   +44  (pad)        u32
#   +48  fb0          40B   scanout FB 0 (NV_SFB_* shape)
#   +88  fb1          40B   scanout FB 1
#   +128 saved        104B  DRM_MODE_CRTC blob (GETCRTC) -> restore on release
var NV_SURFACE_CARD_FD     = 0;
var NV_SURFACE_RENDER_FD   = 4;
var NV_SURFACE_STATE       = 8;
var NV_SURFACE_CONN_ID     = 16;
var NV_SURFACE_CRTC_ID     = 20;
var NV_SURFACE_FRONT       = 24;
var NV_SURFACE_HAVE_SAVED  = 28;
var NV_SURFACE_WIDTH       = 32;
var NV_SURFACE_HEIGHT      = 36;
var NV_SURFACE_PITCH       = 40;
var NV_SURFACE_FB0         = 48;
var NV_SURFACE_FB1         = 88;
var NV_SURFACE_SAVED       = 128;
var NV_SURFACE_STRUCT_SIZE = 232;

# FB sub-struct (40 bytes), one per scanout buffer. acquire hands the consumer
# a pointer to one of these; the CPU write target is NV_SFB_MAPPED.
var NV_SFB_RENDER_HANDLE = 0;
var NV_SFB_CARD_HANDLE   = 8;
var NV_SFB_FB_ID         = 16;
var NV_SFB_MAPPED        = 24;
var NV_SFB_BO_SIZE       = 32;
var NV_SFB_STRUCT_SIZE   = 40;

# Allocate one nouveau VRAM scanout FB: VRAM BO (render node) -> PRIME import to
# the card node -> ADDFB2. Fills `out` (NV_SFB_* shape). Returns 0 on success,
# or a negative stage code (-1 BO, -2 PRIME, -3 ADDFB2); each failure unwinds
# the prior stage so nothing leaks.
fn _nv_surface_alloc_fb(card_fd, render_fd, bo_size, width, height, pitch, out): i64 {
    memset(out, 0, NV_SFB_STRUCT_SIZE);
    var bo[24];
    if (native_nv_bo_create_dom(render_fd, bo_size, NOUVEAU_GEM_DOMAIN_VRAM, &bo) != 0) {
        return 0 - 1;
    }
    var render_handle = load64(&bo + 0);
    var mapped        = load64(&bo + 8);
    var card_handle = native_kms_import_bo(card_fd, render_fd, render_handle);
    if (card_handle == 0) {
        native_nv_bo_release_host(render_fd, render_handle, mapped, bo_size);
        return 0 - 2;
    }
    var fb_id = native_kms_add_fb_xrgb8888(card_fd, card_handle, width, height, pitch);
    if (fb_id == 0) {
        native_gem_close(card_fd, card_handle);
        native_nv_bo_release_host(render_fd, render_handle, mapped, bo_size);
        return 0 - 3;
    }
    store64(out + NV_SFB_RENDER_HANDLE, render_handle);
    store64(out + NV_SFB_CARD_HANDLE,   card_handle);
    store64(out + NV_SFB_FB_ID,         fb_id);
    store64(out + NV_SFB_MAPPED,        mapped);
    store64(out + NV_SFB_BO_SIZE,       bo_size);
    return 0;
}

# Tear down one scanout FB: RMFB -> GEM close (card handle) -> BO release (render
# handle + unmap). Null-safe per field (a partially-built FB releases cleanly).
fn _nv_surface_free_fb(card_fd, render_fd, fb): i64 {
    var fb_id = load64(fb + NV_SFB_FB_ID);
    if (fb_id != 0) { native_kms_rm_fb(card_fd, fb_id); }
    var card_handle = load64(fb + NV_SFB_CARD_HANDLE);
    if (card_handle != 0) { native_gem_close(card_fd, card_handle); }
    var render_handle = load64(fb + NV_SFB_RENDER_HANDLE);
    if (render_handle != 0) {
        native_nv_bo_release_host(render_fd, render_handle,
          load64(fb + NV_SFB_MAPPED), load64(fb + NV_SFB_BO_SIZE));
    }
    return 0;
}

# BACKEND_SLOT_SURFACE_CONFIGURE (176): (ctx, width, height) -> NvSurface* | 0.
# width/height are hints; the actual surface adopts the connector's preferred
# mode. Needs DRM master (the consumer acquired it before stashing card_fd).
fn _backend_nvidia_surface_configure(ctx, width, height): i64 {
    if (ctx == 0) { return 0; }
    var card_fd = gpu_ctx_native_card_fd(ctx);
    if (card_fd <= 0) { return 0; }
    var render_fd = nv_ctx_fd(ctx);
    if (render_fd <= 0) { return 0; }

    var state = native_kms_init(card_fd);
    if (state == 0) { return 0; }

    # discovery: first CONNECTED connector -> encoder -> CRTC -> preferred mode
    var conn_count = kms_state_count_conn(state);
    var conn_ids   = kms_state_conn_ids(state);
    var crtc_count = kms_state_count_crtcs(state);
    var crtc_ids   = kms_state_crtc_ids(state);
    var conn_id    = 0;
    var encoder_id = 0;
    var meta[80];
    var i = 0;
    while (i < conn_count) {
        var cid = load32(conn_ids + i * 4);
        memset(&meta, 0, DRM_MODE_GET_CONNECTOR_SIZE);
        store32(&meta + DRM_MODE_GET_CONNECTOR_CONN_ID, cid);
        if (native_drm_mode_get_connector(card_fd, &meta) == 0) {
            if (load32(&meta + DRM_MODE_GET_CONNECTOR_CONNECTION) == DRM_MODE_CONNECTED) {
                conn_id = cid;
                encoder_id = load32(&meta + DRM_MODE_GET_CONNECTOR_ENCODER_ID);
                i = conn_count;
            }
        }
        i = i + 1;
    }
    if (conn_id == 0) { native_kms_release(state); return 0; }

    # encoder_id == 0 when the connector is currently UNBOUND (e.g. after a prior
    # teardown disabled the CRTC with no compositor to re-bind). Default to the
    # first CRTC: SETCRTC re-binds an encoder, and every encoder on this GPU
    # accepts any CRTC (possible_crtcs = 0x0F). Mirrors the N8.3 modeset fallback.
    var crtc_idx = 0;
    if (encoder_id != 0) {
        var enc[20];
        memset(&enc, 0, DRM_MODE_GET_ENCODER_SIZE);
        store32(&enc + DRM_MODE_GET_ENCODER_ID, encoder_id);
        if (native_drm_mode_get_encoder(card_fd, &enc) != 0) {
            native_kms_release(state); return 0;
        }
        crtc_idx = native_kms_lowest_set_bit(load32(&enc + DRM_MODE_GET_ENCODER_POSS_CRTCS));
    }
    if (crtc_idx < 0) { native_kms_release(state); return 0; }
    if (crtc_idx >= crtc_count) { native_kms_release(state); return 0; }
    var crtc_id = load32(crtc_ids + crtc_idx * 4);

    var mc[4];
    store32(&mc, 0);
    var modes = native_kms_get_connector_modes(card_fd, conn_id, &mc);
    var n_modes = load32(&mc);
    if (modes == 0) { native_kms_release(state); return 0; }
    if (n_modes == 0) { native_kms_release(state); return 0; }
    var mode_idx = native_kms_pick_preferred_mode(modes, n_modes);
    var fb_w = native_kms_mode_hdisplay(modes, mode_idx);
    var fb_h = native_kms_mode_vdisplay(modes, mode_idx);
    var pitch = (fb_w * 4 + 255) / 256 * 256;
    var bo_size = pitch * fb_h;

    var ns = alloc(NV_SURFACE_STRUCT_SIZE);
    memset(ns, 0, NV_SURFACE_STRUCT_SIZE);
    store32(ns + NV_SURFACE_CARD_FD,   card_fd);
    store32(ns + NV_SURFACE_RENDER_FD, render_fd);
    store64(ns + NV_SURFACE_STATE,     state);
    store32(ns + NV_SURFACE_CONN_ID,   conn_id);
    store32(ns + NV_SURFACE_CRTC_ID,   crtc_id);
    store32(ns + NV_SURFACE_FRONT,     0);
    store32(ns + NV_SURFACE_WIDTH,     fb_w);
    store32(ns + NV_SURFACE_HEIGHT,    fb_h);
    store32(ns + NV_SURFACE_PITCH,     pitch);

    # save the console CRTC config so release can restore it (no black screen)
    if (native_kms_get_crtc(card_fd, crtc_id, ns + NV_SURFACE_SAVED) == 0) {
        if (load32(ns + NV_SURFACE_SAVED + DRM_MODE_CRTC_FB_ID) != 0) {
            store32(ns + NV_SURFACE_HAVE_SAVED, 1);
        }
    }

    # two VRAM scanout FBs (front + back); on failure unwind everything built
    if (_nv_surface_alloc_fb(card_fd, render_fd, bo_size, fb_w, fb_h, pitch, ns + NV_SURFACE_FB0) != 0) {
        native_kms_release(state); return 0;
    }
    if (_nv_surface_alloc_fb(card_fd, render_fd, bo_size, fb_w, fb_h, pitch, ns + NV_SURFACE_FB1) != 0) {
        _nv_surface_free_fb(card_fd, render_fd, ns + NV_SURFACE_FB0);
        native_kms_release(state); return 0;
    }

    # initial modeset on FB0 (needs DRM master)
    var conn_list[4];
    store32(&conn_list, conn_id);
    var mode_ptr = modes + mode_idx * DRM_MODE_MODEINFO_SIZE;
    var fb0_id = load64(ns + NV_SURFACE_FB0 + NV_SFB_FB_ID);
    if (native_kms_set_crtc(card_fd, crtc_id, fb0_id, &conn_list, 1, mode_ptr) != 0) {
        _nv_surface_free_fb(card_fd, render_fd, ns + NV_SURFACE_FB1);
        _nv_surface_free_fb(card_fd, render_fd, ns + NV_SURFACE_FB0);
        native_kms_release(state); return 0;
    }
    return ns;
}

# BACKEND_SLOT_SURFACE_ACQUIRE (184): (ctx, surface) -> back-FB ptr | 0. The
# consumer reads NV_SFB_MAPPED off the returned FB and CPU-fills the pixels.
fn _backend_nvidia_surface_acquire(ctx, surface): i64 {
    if (surface == 0) { return 0; }
    # return the FB that is NOT currently scanning out
    if (load32(surface + NV_SURFACE_FRONT) == 0) { return surface + NV_SURFACE_FB1; }
    return surface + NV_SURFACE_FB0;
}

# BACKEND_SLOT_SURFACE_PRESENT (192): (ctx, surface) -> 0 | GPU_ERR_*. PAGE_FLIP
# the back FB, block on the flip-complete vblank, then toggle which FB is front.
fn _backend_nvidia_surface_present(ctx, surface): i64 {
    if (surface == 0) { return GPU_ERR_OTHER; }
    var card_fd = load32(surface + NV_SURFACE_CARD_FD);
    var crtc_id = load32(surface + NV_SURFACE_CRTC_ID);
    var front   = load32(surface + NV_SURFACE_FRONT);
    var back_fb = 0;
    if (front == 0) { back_fb = load64(surface + NV_SURFACE_FB1 + NV_SFB_FB_ID); }
    if (front == 1) { back_fb = load64(surface + NV_SURFACE_FB0 + NV_SFB_FB_ID); }
    var rc = native_kms_page_flip(card_fd, crtc_id, back_fb, DRM_MODE_PAGE_FLIP_EVENT, 0);
    if (rc != 0) { return _native_neg_rc_to_gpu_err(rc); }
    var ev[64];
    native_drm_read_event(card_fd, &ev, 64);
    store32(surface + NV_SURFACE_FRONT, 1 - front);
    return 0;
}

# BACKEND_SLOT_SURFACE_RELEASE (200): (ctx, surface) -> 0. Restore the saved
# console CRTC (re-bind original FB + mode) BEFORE freeing our FBs, then free
# both FBs + the KMS state. Kiosk path: the consumer owns card_fd, so we don't
# close it (the logind variant, which does, is future work).
fn _backend_nvidia_surface_release(ctx, surface): i64 {
    if (surface == 0) { return 0; }
    var card_fd   = load32(surface + NV_SURFACE_CARD_FD);
    var render_fd = load32(surface + NV_SURFACE_RENDER_FD);
    var crtc_id   = load32(surface + NV_SURFACE_CRTC_ID);
    var state     = load64(surface + NV_SURFACE_STATE);
    if (load32(surface + NV_SURFACE_HAVE_SAVED) == 1) {
        var conn_list[4];
        store32(&conn_list, load32(surface + NV_SURFACE_CONN_ID));
        native_kms_set_crtc(card_fd, crtc_id,
          load32(surface + NV_SURFACE_SAVED + DRM_MODE_CRTC_FB_ID),
          &conn_list, 1, surface + NV_SURFACE_SAVED + DRM_MODE_CRTC_MODE);
    }
    if (load32(surface + NV_SURFACE_HAVE_SAVED) == 0) {
        native_kms_disable_crtc(card_fd, crtc_id);
    }
    _nv_surface_free_fb(card_fd, render_fd, surface + NV_SURFACE_FB1);
    _nv_surface_free_fb(card_fd, render_fd, surface + NV_SURFACE_FB0);
    if (state != 0) { native_kms_release(state); }
    memset(surface, 0, NV_SURFACE_STRUCT_SIZE);
    return 0;
}

# ================================================================
# Backend construction — v0 slot block + kind
# ================================================================
# Fills offsets 0..80 + kind. Higher ranges (texture/render/surface) are
# left zero until N6/N7/N8; backend_is_complete reports incomplete past v0
# for this backend by design (the slots are genuinely not implemented yet).
fn backend_nvidia_new(): i64 {
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_CTX_CREATE_FROM_PREINIT,
      &_backend_nvidia_ctx_create_from_preinit);
    backend_set_slot(b, BACKEND_SLOT_CTX_RELEASE,
      &_backend_nvidia_ctx_release);
    backend_set_slot(b, BACKEND_SLOT_BUFFER_CREATE,
      &_backend_nvidia_buffer_create);
    backend_set_slot(b, BACKEND_SLOT_BUFFER_WRITE,
      &_backend_nvidia_buffer_write);
    backend_set_slot(b, BACKEND_SLOT_BUFFER_READ,
      &_backend_nvidia_buffer_read);
    backend_set_slot(b, BACKEND_SLOT_BUFFER_RELEASE,
      &_backend_nvidia_buffer_release);
    backend_set_slot(b, BACKEND_SLOT_SHADER_MODULE_CREATE,
      &_backend_nvidia_shader_module_create);
    backend_set_slot(b, BACKEND_SLOT_SHADER_MODULE_RELEASE,
      &_backend_nvidia_shader_module_release);
    backend_set_slot(b, BACKEND_SLOT_COMPUTE_DISPATCH,
      &_backend_nvidia_compute_dispatch);
    backend_set_slot(b, BACKEND_SLOT_DEVICE_WAIT_IDLE,
      &_backend_nvidia_device_wait_idle);
    # v1 texture slots (88..120) — host-visible linear RGBA8.
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_CREATE_2D_RGBA8,
      &_backend_nvidia_texture_create_2d_rgba8);
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_WRITE,
      &_backend_nvidia_texture_write);
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_READ,
      &_backend_nvidia_texture_read);
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_RELEASE,
      &_backend_nvidia_texture_release);
    # v2 render slots (120..176) — N7.1: render-target create/release (the
    # CPU-side color-surface lifecycle). The pipeline/pass/draw slots
    # (136..168) land in N7.2/N7.3/N7.4; backend_is_complete stays honestly
    # incomplete past the RT slots until then.
    backend_set_slot(b, BACKEND_SLOT_RENDER_TARGET_CREATE_2D_RGBA8,
      &_backend_nvidia_render_target_create_2d_rgba8);
    backend_set_slot(b, BACKEND_SLOT_RENDER_TARGET_RELEASE,
      &_backend_nvidia_render_target_release);
    # v2 render pipeline / pass / draw (136..168) — N7.5: the public-API path
    # to the HW-proven render mechanism. This completes the v2 render range, so
    # backend_is_complete now reports the NVIDIA backend complete through v2.
    backend_set_slot(b, BACKEND_SLOT_RENDER_PIPELINE_CREATE,
      &_backend_nvidia_render_pipeline_create);
    backend_set_slot(b, BACKEND_SLOT_RENDER_PIPELINE_RELEASE,
      &_backend_nvidia_render_pipeline_release);
    backend_set_slot(b, BACKEND_SLOT_RENDER_PASS_BEGIN,
      &_backend_nvidia_render_pass_begin);
    backend_set_slot(b, BACKEND_SLOT_RENDER_PASS_DRAW,
      &_backend_nvidia_render_pass_draw);
    backend_set_slot(b, BACKEND_SLOT_RENDER_PASS_END,
      &_backend_nvidia_render_pass_end);
    # v3 surface slots (176..208) — N8.5: nouveau double-buffered KMS present
    # via the public gpu_surface_* API (configure/acquire/present/release). The
    # kiosk public fn stashes the consumer's DRM-master card_fd at gpu_ctx +104.
    # This fills the v3 surface range; backend_is_complete stays honestly 0
    # because the mipmap / queue / texfmt / copy / sampleable ranges past v3
    # surface are still unfilled on this backend.
    backend_set_slot(b, BACKEND_SLOT_SURFACE_CONFIGURE,
      &_backend_nvidia_surface_configure);
    backend_set_slot(b, BACKEND_SLOT_SURFACE_ACQUIRE,
      &_backend_nvidia_surface_acquire);
    backend_set_slot(b, BACKEND_SLOT_SURFACE_PRESENT,
      &_backend_nvidia_surface_present);
    backend_set_slot(b, BACKEND_SLOT_SURFACE_RELEASE,
      &_backend_nvidia_surface_release);
    backend_set_kind(b, BACKEND_KIND_NVIDIA);
    return b;
}
