# pipeline_cache.cyr — hash-based pipeline deduplication
# Ported from mabda/src/pipeline_cache.rs
#
# Caches compute and render pipeline handles keyed by u64 hash.
# Prevents recreating identical pipelines.

fn pipeline_cache_new() {
    return map_new();
}

fn pipeline_cache_get(cache, key) {
    var ibuf[24];
    var klen = fmt_int_buf(key, &ibuf);
    store8(&ibuf + klen, 0);
    return map_get(cache, &ibuf);
}

fn pipeline_cache_set(cache, key, pipeline) {
    var ibuf[24];
    var klen = fmt_int_buf(key, &ibuf);
    store8(&ibuf + klen, 0);
    map_set(cache, &ibuf, pipeline);
    return 0;
}

fn pipeline_cache_has(cache, key) {
    if (pipeline_cache_get(cache, key) != 0) { return 1; }
    return 0;
}
