fn wgpu_request_adapter_callback_info(callback, userdata): i64 {
    var info = alloc(40);
    memset(info, 0, 40);
    store32(info + 8, WGPU_CALLBACK_MODE_ALLOW_SPONTANEOUS);
    store64(info + 16, callback);
    store64(info + 24, userdata);
    return info;
}

# ================================================================
# WGPURequestDeviceCallbackInfo (40 bytes)
# ================================================================

fn wgpu_request_device_callback_info(callback, userdata): i64 {
    var info = alloc(40);
    memset(info, 0, 40);
    store32(info + 8, WGPU_CALLBACK_MODE_WAIT_ANY_ONLY);
    store64(info + 16, callback);
    store64(info + 24, userdata);
    return info;
}

# ================================================================
# WGPUAdapterInfo (96 bytes) — v29 webgpu.h. Offsets verified via a
# deps/wgpu-native offsetof() probe (x86-64 LP64: ptr/size_t = 8, enum = 4):
#   +0:  nextInChain (WGPUChainedStruct*)
#   +8:  vendor       (WGPUStringView, 16)
#   +24: architecture (WGPUStringView, 16)
#   +40: device       (WGPUStringView, 16)
#   +56: description  (WGPUStringView, 16)
#   +72: backendType  (WGPUBackendType enum, u32)
#   +76: adapterType  (WGPUAdapterType enum, u32)
#   +80: vendorID     (u32)   <- read by the v4.0.1 AMD-wgpu guard
#   +84: deviceID (u32), +88: subgroupMinSize (u32), +92: subgroupMaxSize (u32)
# ================================================================
var WGPU_ADAPTER_INFO_SIZE             = 96;
var WGPU_ADAPTER_INFO_VENDOR_ID_OFFSET = 80;

# PCI vendor id of AMD/ATI (WGPUAdapterInfo.vendorID). The AMD wgpu route
# retired at v4.0.1: gpu_context_from_preinit rejects this vendor on the wgpu
# path so AMD consumers run on the BACKEND_KIND_AMD native backend. NVIDIA
# (0x10DE) and Intel (0x8086) keep their wgpu route until v5.0 / v5.1.
var PCI_VENDOR_AMD = 0x1002;

# Read the u32 vendorID out of a filled WGPUAdapterInfo struct. Null-safe:
# returns 0 (not a real PCI vendor), so the guard treats a null info as
# "not AMD" and defers to wgpu-native's own null-adapter handling.
fn wgpu_adapter_info_vendor_id(info): i64 {
    if (info == 0) { return 0; }
    return load32(info + WGPU_ADAPTER_INFO_VENDOR_ID_OFFSET);
}

# The v4.0.1 wgpu-retirement decision, factored out so it is unit-testable
# without a live adapter (the guard's live vendorID read is HW-gated).
# Returns 1 if `vendor_id` names a PCI vendor whose wgpu route is retired.
# v4.0.1: AMD (0x1002) only — NVIDIA (0x10DE) / Intel (0x8086) retire later
# (v5.0 / v5.1). gpu_context_from_preinit calls this on the wgpu fallthrough.
fn _wgpu_vendor_retired(vendor_id): i64 {
    if (vendor_id == PCI_VENDOR_AMD) { return 1; }
    return 0;
}
