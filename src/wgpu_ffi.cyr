# wgpu_ffi.cyr — FFI bindings to wgpu-native v29
#
# Function pointers are received from C launcher via wgpu_ffi_init_table(ptr).
# The C main() builds a function table and passes it to the Cyrius entry point.
# All wgpu handles are opaque i64 pointers.
#
# Function table layout (matches deps/wgpu_main.c):
#   [0]  wgpuCreateInstance
#   [1]  wgpu_shim_instance_request_adapter (by-pointer callbackInfo)
#   [2]  wgpu_shim_adapter_request_device (by-pointer callbackInfo)
#   [3]  wgpuDeviceGetQueue
#   [4]  wgpuInstanceProcessEvents
#   [5]  wgpuInstanceRelease
#   [6]  wgpuAdapterRelease
#   [7]  wgpuDeviceRelease
#   [8]  wgpuDeviceCreateBuffer
#   [9]  wgpuQueueWriteBuffer
#   [10] wgpu_shim_buffer_map_async (by-pointer callbackInfo)
#   [11] wgpuBufferGetConstMappedRange
#   [12] wgpuBufferUnmap
#   [13] wgpuBufferGetSize
#   [14] wgpuBufferDestroy
#   [15] wgpuBufferRelease
#   [16] wgpuDeviceCreateShaderModule
#   [17] wgpuDeviceCreateComputePipeline
#   [18] wgpuDeviceCreateBindGroupLayout
#   [19] wgpuDeviceCreatePipelineLayout
#   [20] wgpuDeviceCreateBindGroup
#   [21] wgpuShaderModuleRelease
#   [22] wgpuComputePipelineRelease
#   [23] wgpuBindGroupRelease
#   [24] wgpuBindGroupLayoutRelease
#   [25] wgpuPipelineLayoutRelease
#   [26] wgpuDeviceCreateCommandEncoder
#   [27] wgpuCommandEncoderBeginComputePass
#   [28] wgpuCommandEncoderCopyBufferToBuffer
#   [29] wgpuCommandEncoderFinish
#   [30] wgpuComputePassEncoderSetPipeline
#   [31] wgpuComputePassEncoderSetBindGroup
#   [32] wgpuComputePassEncoderDispatchWorkgroups
#   [33] wgpuComputePassEncoderEnd
#   [34] wgpuCommandEncoderRelease
#   [35] wgpuQueueSubmit
#   [36] wgpuAdapterGetInfo
#   [37] wgpuAdapterGetLimits
#   [38] wgpuAdapterHasFeature
#   [39] wgpu_shim_device_poll

var _fn_table = 0;

fn _fp(idx) { return load64(_fn_table + idx * 8); }

fn wgpu_ffi_init_table(table_ptr) {
    _fn_table = table_ptr;
    return 0;
}

# ================================================================
# Instance
# ================================================================

fn wgpu_create_instance(desc) { return fncall1(_fp(0), desc); }
fn wgpu_instance_process_events(inst) { fncall1(_fp(4), inst); return 0; }
fn wgpu_instance_release(inst) { fncall1(_fp(5), inst); return 0; }

# ================================================================
# Adapter request (sync)
# ================================================================

# Request adapter: simplified shim handles all callback setup in C
# Args: (instance, power_preference, result_ptr)
fn wgpu_request_adapter_sync(instance, power_pref) {
    var result_ptr = alloc(8);
    store64(result_ptr, 0);
    fncall3(_fp(1), instance, power_pref, result_ptr);
    return load64(result_ptr);
}

# ================================================================
# Device request (sync)
# ================================================================

# Request device: simplified shim handles callback in C
# Args: (adapter, result_ptr)
fn wgpu_request_device_sync(adapter) {
    var result_ptr = alloc(8);
    store64(result_ptr, 0);
    fncall2(_fp(2), adapter, result_ptr);
    return load64(result_ptr);
}

# ================================================================
# Queue
# ================================================================
fn wgpu_device_get_queue(device) { return fncall1(_fp(3), device); }
# NOTE: slot 35 is a C shim that submits a single command buffer.
# Args: (queue, cmd_buffer_handle). The count/array is handled in C.
fn wgpu_queue_submit_one(queue, cmd_buf) { fncall2(_fp(35), queue, cmd_buf); return 0; }
fn wgpu_queue_write_buffer(queue, buf, offset, data, size) { fncall5(_fp(9), queue, buf, offset, data, size); return 0; }

# ================================================================
# Buffer
# ================================================================
fn wgpu_device_create_buffer(device, desc) { return fncall2(_fp(8), device, desc); }
fn wgpu_buffer_get_size(buf) { return fncall1(_fp(13), buf); }
fn wgpu_buffer_destroy(buf) { fncall1(_fp(14), buf); return 0; }
fn wgpu_buffer_unmap(buf) { fncall1(_fp(12), buf); return 0; }
fn wgpu_buffer_release(buf) { fncall1(_fp(15), buf); return 0; }
fn wgpu_buffer_get_const_mapped_range(buf, offset, size) { return fncall3(_fp(11), buf, offset, size); }

# Buffer map sync: simplified shim handles callback + poll in C. The args
# are packed into a struct so Cyrius calls via fncall2 instead of fncall6.
# WgpuMapArgs layout (32 bytes):
#   +0:  buffer (8)
#   +8:  mode (4) + padding (4)
#   +16: offset (8)
#   +24: size (8)
#   +32: status_ptr (8) — total 40 bytes
fn wgpu_buffer_map_sync(device, buffer, mode, offset, size) {
    var status_ptr = alloc(8);
    store64(status_ptr, 0);
    var args = alloc(40);
    store64(args + 0,  buffer);
    store32(args + 8,  mode);
    store64(args + 16, offset);
    store64(args + 24, size);
    store64(args + 32, status_ptr);
    fncall2(_fp(10), device, args);
    return load64(status_ptr);
}

# ================================================================
# Shader / Pipeline
# ================================================================
fn wgpu_device_create_shader_module(device, desc) { return fncall2(_fp(16), device, desc); }
fn wgpu_device_create_compute_pipeline(device, desc) { return fncall2(_fp(17), device, desc); }
fn wgpu_device_create_bind_group_layout(device, desc) { return fncall2(_fp(18), device, desc); }
fn wgpu_device_create_pipeline_layout(device, desc) { return fncall2(_fp(19), device, desc); }
fn wgpu_device_create_bind_group(device, desc) { return fncall2(_fp(20), device, desc); }
fn wgpu_shader_module_release(m) { fncall1(_fp(21), m); return 0; }
fn wgpu_compute_pipeline_release(p) { fncall1(_fp(22), p); return 0; }
fn wgpu_bind_group_release(bg) { fncall1(_fp(23), bg); return 0; }
fn wgpu_bind_group_layout_release(bgl) { fncall1(_fp(24), bgl); return 0; }
fn wgpu_pipeline_layout_release(pl) { fncall1(_fp(25), pl); return 0; }

# ================================================================
# Command Encoding
# ================================================================
# NOTE: slot 26 is a C shim that takes (device, label_cstr). The `desc` arg
# is interpreted as a null-terminated label pointer. Pass 0 for no label.
fn wgpu_device_create_command_encoder(device, label) { return fncall2(_fp(26), device, label); }
fn wgpu_command_encoder_begin_compute_pass(enc, desc) { return fncall2(_fp(27), enc, desc); }
fn wgpu_command_encoder_copy_buffer_to_buffer(enc, src, soff, dst, doff, sz) {
    # Pack args into WgpuCopyArgs struct (40 bytes: src, soff, dst, doff, size)
    var args = alloc(40);
    store64(args + 0,  src);
    store64(args + 8,  soff);
    store64(args + 16, dst);
    store64(args + 24, doff);
    store64(args + 32, sz);
    fncall2(_fp(28), enc, args);
    return 0;
}
# NOTE: slot 29 is a C shim that takes (encoder, label_cstr). Pass 0 for no label.
fn wgpu_command_encoder_finish(enc, label) { return fncall2(_fp(29), enc, label); }
fn wgpu_command_encoder_release(enc) { fncall1(_fp(34), enc); return 0; }
fn wgpu_compute_pass_set_pipeline(pass, pip) { fncall2(_fp(30), pass, pip); return 0; }
fn wgpu_compute_pass_set_bind_group(pass, gi, bg, dc, do_ptr) { fncall5(_fp(31), pass, gi, bg, dc, do_ptr); return 0; }
fn wgpu_compute_pass_dispatch(pass, x, y, z) { fncall4(_fp(32), pass, x, y, z); return 0; }
fn wgpu_compute_pass_end(pass) { fncall1(_fp(33), pass); return 0; }

# ================================================================
# Adapter / Device
# ================================================================
fn wgpu_adapter_get_info(adapter, info) { fncall2(_fp(36), adapter, info); return 0; }
fn wgpu_adapter_get_limits(adapter, lim) { return fncall2(_fp(37), adapter, lim); }
fn wgpu_adapter_release(a) { fncall1(_fp(6), a); return 0; }
fn wgpu_device_release(d) { fncall1(_fp(7), d); return 0; }
fn wgpu_device_poll(device, wait) { return fncall2(_fp(39), device, wait); }
