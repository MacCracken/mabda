# @internal — N9.3: register allocation for the SPIR-V → SASS (SM75) compiler.
# sm75_regalloc.cyr — maps the MIR <id>s in sm75_isel's records to physical GPRs. One file
# (R0..R254; R255 is RZ, which operand <id> 0 already means), linear scan in record order.
# docs/proposals/n9-spirv-to-sass.md §4.
#
# The rules gfx9_regalloc learned, applied here from the start:
#   - an operand flagged MIR_FLAG_{A,B,C}_IMM is a value, not a register use;
#   - a DEAD load keeps its register to the end of the program: a load writes its register
#     whenever memory returns, so a register freed at the def could be claimed by the next
#     value and then overwritten (the 4.4.0 phi-swap finding on GFX9).
#   - (N9.5) a value whose last use falls INSIDE a loop stays live to the loop's back-edge,
#     because the next iteration reads it again (the v4.1.0 GFX9 rule, to a fixed point over
#     nested loops);
#   - (N9.5) each value is allocated ONCE: a phi is defined by a copy on every incoming edge,
#     and all of them must land in the same register;
#   - (4.4.0) an f64 value takes an even-aligned PAIR (Rn, Rn+1, n even), as SM75's 64-bit
#     operands require; a 32-bit op on one half names the pair and a half flag (SM75I_HI_*).
#
# The per-<id> table reuses gfx9_regalloc's record (RA_REC: +0 physical register, +8 last
# use) and its _ra_claim free-at scan.

var SM75_ERR_REG_OVERFLOW = 135;   # more simultaneously live values than R0..R254
var SM75_ERR_ALLOC_SHORT  = 136;   # alloc[] shorter than the module's cap_ids records
var SM75_GPR_CAP = 255;            # R0..R254 allocatable; R255 = RZ

# Volta+ burns two GPRs per thread for the program counter (NAK sm70.rs hw_reserved_gprs,
# citing the Volta whitepaper), and the QMD's REGISTER_COUNT must include them, with a floor
# of 4: count = max(4, used + 2). Matches ptxas for the captured store_deadbeef (R0..R1 used,
# REGISTER_COUNT 4).
fn sm75_register_count(used): i64 {
    var c = used + 2;
    if (c < 4) { c = 4; }
    return c;
}

# 1 if record op `op` writes a GPR result (its dst <id>).
fn _s75_writes_gpr(op): i64 {
    if (op == SM75I_LABEL) { return 0; }
    if (op == SM75I_BRA) { return 0; }
    if (op == SM75I_ISETP) { return 0; }
    if (op == SM75I_STG) { return 0; }
    if (op == SM75I_ULDC) { return 0; }
    if (op == SM75I_EXIT) { return 0; }
    if (op == SM75I_BCLEAR) { return 0; }
    if (op == SM75I_BSSY) { return 0; }
    if (op == SM75I_BSYNC) { return 0; }
    if (op == SM75I_DSETP) { return 0; }
    if (op == SM75I_STG64) { return 0; }
    return 1;
}

fn _s75_use(m, alloc, id, i): i64 {
    if (id <= 0) { return 0; }
    if (id >= load64(m + 64)) { return 0; }
    if (i > load64(alloc + id * RA_REC + 8)) { store64(alloc + id * RA_REC + 8, i); }
    return 0;
}

# Allocate a GPR to every result in `isel` (n records). `alloc` (`alloc_len` bytes) must hold
# the module's cap_ids RA_REC records; `hw` gets the GPR high-water at +0 (registers used).
# Returns 0 or a NEGATIVE error.
fn sm75_regalloc(m, isel, n, alloc, alloc_len, hw): i64 {
    var cap_ids = load64(m + 64);
    if (cap_ids <= 0) { return 0 - SM75_ERR_ALLOC_SHORT; }
    if (cap_ids > alloc_len / RA_REC) { return 0 - SM75_ERR_ALLOC_SHORT; }
    memset(alloc, 0xFF, cap_ids * RA_REC);
    # Pass 1: intervals. A result is live from its record to its last use.
    var i = 0;
    while (i < n) {
        var d = sm75i_dst(isel, i);
        if (d > 0) {
            if (d >= cap_ids) { return 0 - SM75_ERR_BAD_OPERAND; }
            if (i > load64(alloc + d * RA_REC + 8)) { store64(alloc + d * RA_REC + 8, i); }
        }
        var fl = sm75i_flags(isel, i);
        if ((fl & MIR_FLAG_A_IMM) == 0) { _s75_use(m, alloc, sm75i_a(isel, i), i); }
        if ((fl & MIR_FLAG_B_IMM) == 0) { _s75_use(m, alloc, sm75i_b(isel, i), i); }
        if ((fl & MIR_FLAG_C_IMM) == 0) { _s75_use(m, alloc, sm75i_c(isel, i), i); }
        i = i + 1;
    }
    # Pass 1b: a dead load (no use after its def) keeps its register to the end.
    i = 0;
    while (i < n) {
        if (sm75i_op(isel, i) == SM75I_LDG) {
            var ld = sm75i_dst(isel, i);
            if (ld > 0) { if (load64(alloc + ld * RA_REC + 8) <= i) { store64(alloc + ld * RA_REC + 8, n); } }
        }
        i = i + 1;
    }
    # Pass 1c: loops. A BRA to a label earlier in the list is a back-edge; a value whose last
    # use lies in [label, back-edge) is read again on the next iteration, so it stays live to
    # the back-edge. Repeat until nothing moves (an extension can land inside an outer loop).
    var rounds = 0;
    while (rounds <= n) {
        var changed = 0;
        var bi = 0;
        while (bi < n) {
            if (sm75i_op(isel, bi) == SM75I_BRA) {
                var tgt = sm75i_a(isel, bi);
                var ti = 0 - 1;
                var li = 0;
                while (li < bi) {
                    if (sm75i_op(isel, li) == SM75I_LABEL) { if (sm75i_a(isel, li) == tgt) { ti = li; } }
                    li = li + 1;
                }
                if (ti >= 0) {
                    var vi = 1;
                    while (vi < cap_ids) {
                        var lu = load64(alloc + vi * RA_REC + 8);
                        if (lu >= ti) {
                            if (lu < bi) { store64(alloc + vi * RA_REC + 8, bi); changed = 1; }
                        }
                        vi = vi + 1;
                    }
                }
            }
            bi = bi + 1;
        }
        if (changed == 0) { rounds = n + 1; }
        rounds = rounds + 1;
    }
    # Pass 2: claim the lowest register free at each definition.
    var freeat[2048];   # SM75_GPR_CAP (255) + 1 i64
    memset(&freeat, 0, 2048);
    var high = 0;
    i = 0;
    while (i < n) {
        var op2 = sm75i_op(isel, i);
        var d2 = sm75i_dst(isel, i);
        if (d2 > 0) {
            if (_s75_writes_gpr(op2) == 1) {
                if (load64(alloc + d2 * RA_REC + 0) == 0 - 1) {
                    # an f64 value takes an even-aligned pair (4.4.0)
                    var w = 1;
                    if (mir_type_base(mir_val_type(m, d2)) == MIR_T_F64) { w = 2; }
                    var r = 0 - 1;
                    if (w == 2) {
                        r = _ra_claim_pair(&freeat, 0, SM75_GPR_CAP, i, load64(alloc + d2 * RA_REC + 8) + 1);
                    } else {
                        r = _ra_claim(&freeat, 0, SM75_GPR_CAP, i, load64(alloc + d2 * RA_REC + 8) + 1);
                    }
                    if (r < 0) { return 0 - SM75_ERR_REG_OVERFLOW; }
                    store64(alloc + d2 * RA_REC + 0, r);
                    if (r + w > high) { high = r + w; }
                }
            }
        }
        i = i + 1;
    }
    store64(hw, high);
    return 0;
}

# The physical register of operand `id` after sm75_regalloc: RZ for <id> 0.
fn sm75_reg(alloc, id): i64 {
    if (id <= 0) { return SM75_RZ; }
    return load64(alloc + id * RA_REC + 0);
}
