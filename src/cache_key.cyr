# cache_key.cyr — shared helper for hashmap-backed caches.
#
# All cache modules (shader_cache, pipeline_cache, bind_group_cache,
# texture_cache) store hash keys as null-terminated decimal strings.
# hashmap.cyr::map_set stores the key pointer WITHOUT copying, so the key
# buffer must live on the heap — stack buffers dangle as soon as the caller
# returns.
#
# Prior to this helper, each cache module had its own stack-buffer
# implementation, which silently lost entries whenever two keys were
# inserted back-to-back (the second call reused the same stack slot).
# The test suite catches the regression.

fn _hash_to_heap_key(key) {
    var tmp[24];
    var len = fmt_int_buf(key, &tmp);
    var dst = alloc(len + 1);
    var i = 0;
    while (i < len) {
        store8(dst + i, load8(&tmp + i));
        i = i + 1;
    }
    store8(dst + len, 0);
    return dst;
}
