# bind_group_cache.cyr — hash-based bind group caching
# Ported from mabda/src/bind_group_cache.rs
#
# Caches bind group handles keyed by u64 hash.

fn bind_group_cache_new() {
    return map_new();
}

fn bind_group_cache_get(cache, key) {
    var ibuf[24];
    var klen = fmt_int_buf(key, &ibuf);
    store8(&ibuf + klen, 0);
    return map_get(cache, &ibuf);
}

fn bind_group_cache_set(cache, key, bind_group) {
    var ibuf[24];
    var klen = fmt_int_buf(key, &ibuf);
    store8(&ibuf + klen, 0);
    map_set(cache, &ibuf, bind_group);
    return 0;
}

fn bind_group_cache_has(cache, key) {
    if (bind_group_cache_get(cache, key) != 0) { return 1; }
    return 0;
}

# Invalidate entries matching a predicate
# pred_fn(key, value) → 1 to remove, 0 to keep
# Note: hashmap.cyr doesn't support iteration with removal,
# so this is a simplified version that clears the entire cache.
fn bind_group_cache_clear(cache) {
    # Replace with a fresh map (old one gets GC'd by bump allocator reset)
    return map_new();
}
