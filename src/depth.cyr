# depth.cyr — depth/stencil texture management
# Ported from mabda/src/depth.rs
#
# DepthTexture struct layout (40 bytes):
#   +0:  texture (WGPUTexture handle, 8)
#   +8:  view    (WGPUTextureView handle, 8)
#   +16: format  (u32 WGPUTextureFormat)
#   +24: width   (i64)
#   +32: height  (i64)

# Depth format constants
var DEPTH_FORMAT_DEPTH32_FLOAT         = 39;  # wgpu::TextureFormat::Depth32Float
var DEPTH_FORMAT_DEPTH24_PLUS_STENCIL8 = 41;  # wgpu::TextureFormat::Depth24PlusStencil8
var DEPTH_DEFAULT_FORMAT = 39;

# WGPUTextureDescriptor layout (72 bytes):
#   +0:  nextInChain (8)
#   +8:  label (StringView = 16)
#   +24: usage (u64 flags)
#   +32: dimension (u32)
#   +40: size (Extent3D = 12: width u32, height u32, depthOrArrayLayers u32)
#   +52: format (u32)
#   +56: mipLevelCount (u32)
#   +60: sampleCount (u32)
#   +64: viewFormatCount (u64)
#   +72: viewFormats (ptr)

fn _depth_texture_descriptor(label, width, height, format) {
    var desc = alloc(80);
    memset(desc, 0, 80);
    if (label != 0) { wgpu_string_view(desc + 8, label); }
    # usage = RENDER_ATTACHMENT | TEXTURE_BINDING
    store64(desc + 24, 0x10 | 0x04);
    # dimension = 2D (1)
    store32(desc + 32, 1);
    # size: width, height, depth=1
    if (width < 1) { width = 1; }
    if (height < 1) { height = 1; }
    store32(desc + 40, width);
    store32(desc + 44, height);
    store32(desc + 48, 1);
    # format
    store32(desc + 52, format);
    # mipLevelCount = 1
    store32(desc + 56, 1);
    # sampleCount = 1
    store32(desc + 60, 1);
    return desc;
}

# Create a depth texture
# Returns DepthTexture struct pointer
fn depth_texture_new(device, width, height, format) {
    var desc = _depth_texture_descriptor("depth_texture", width, height, format);
    var texture = wgpu_device_create_buffer(device, desc);  # TODO: use create_texture
    # NOTE: actual GPU creation requires wgpuDeviceCreateTexture + wgpuTextureCreateView
    # which need to be added to wgpu_ffi.cyr. For now, store the descriptor info.
    var dt = alloc(40);
    store64(dt, 0);       # texture handle (populated when FFI available)
    store64(dt + 8, 0);   # view handle
    store32(dt + 16, format);
    store64(dt + 24, width);
    store64(dt + 32, height);
    return dt;
}

# Create with default format (Depth32Float)
fn depth_texture_new_default(device, width, height) {
    return depth_texture_new(device, width, height, DEPTH_DEFAULT_FORMAT);
}

# Accessors
fn depth_texture_handle(dt) { return load64(dt); }
fn depth_texture_view(dt)   { return load64(dt + 8); }
fn depth_texture_format(dt) { return load32(dt + 16); }
fn depth_texture_width(dt)  { return load64(dt + 24); }
fn depth_texture_height(dt) { return load64(dt + 32); }

# WGPUCompareFunction constants
var WGPU_COMPARE_LESS = 2;

# Build a depth/stencil state (for render pipeline integration)
# WGPUDepthStencilState layout (68 bytes):
#   +0:  nextInChain (8)
#   +8:  format (u32)
#   +12: depthWriteEnabled (u32 OptionalBool)
#   +16: depthCompare (u32)
#   +20: stencilFront (StencilFaceState = 16)
#   +36: stencilBack (StencilFaceState = 16)
#   +52: stencilReadMask (u32)
#   +56: stencilWriteMask (u32)
#   +60: depthBias (i32)
#   +64: depthBiasSlopeScale (f32)
#   +68: depthBiasClamp (f32)
fn depth_stencil_state(dst, format) {
    memset(dst, 0, 72);
    store32(dst + 8, format);
    store32(dst + 12, 2);          # depthWriteEnabled = true (OptionalBool_True = 2)
    store32(dst + 16, WGPU_COMPARE_LESS);
    store32(dst + 52, 0xFFFFFFFF); # stencilReadMask
    store32(dst + 56, 0xFFFFFFFF); # stencilWriteMask
    return 0;
}
