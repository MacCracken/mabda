# @internal — N9.2: instruction selection for the SPIR-V → SASS (SM75) compiler.
# sm75_isel.cyr — MIR → SM75 instruction records; the gfx9_isel.cyr analogue for NVIDIA
# (docs/proposals/n9-spirv-to-sass.md §3). Reads the same MIR the AMD path does (lowering
# and the uniformity sweep are shared) and writes 48-byte records in the GISEL layout
# [op, dst, a, b, c, flags] with SM75I_* op tags. Registers are still MIR <id>s here
# (sm75_regalloc maps them to R0..R254); id 0 in an operand slot is RZ.
#
# OPERANDS. A slot holds a register <id>, or — when its MIR_FLAG_{A,B,C}_IMM bit is set — a
# raw 32-bit immediate (an int, or f32 bits). A MIR constant becomes an immediate here, so
# nothing downstream reads MIR value kinds. SM75 takes any 32-bit immediate in the src1
# slot (b) and, when src1 is a register, in src2 (c); src0 (a) is always a register. A
# constant that lands in src0 is swapped out (commutative ops), flips its compare, or is
# copied into a fresh synth register with MOV.
#
# FLAGS, bits 8+: the per-op modifiers the encoder needs (see each SM75I_* below).
#
# CONDITIONS (predicate allocation, 4.4.0). Only ISETP writes a predicate. Each MIR compare's
# ISETP gets one of P0..P6 (PT, 7, is the constant true), and selection keeps a table of which
# compare each predicate holds: a SEL or a branch on a compare still held reads its predicate
# directly; only a compare no longer held is re-selected (the 4.4.0 freshness rule), into a free
# predicate or the least recently used one. CNDMASK (lowering's udiv macro) means AMD's "VCC
# from the last compare": it reads the predicate of the last MIR compare selected, which is
# never evicted. A predicate's contents depend on the path into a label, so a label empties
# the table (and forgets the last compare). v1 (N9.2–N9.6) used P0 alone and re-selected a
# compare whenever another had overwritten it.
#
# CONTROL FLOW (N9.5). An SM75 thread keeps its own program counter (Volta independent thread
# scheduling), so a divergent branch is just a predicated BRA: no EXEC mask to save, narrow or
# restore, and none of gfx9_isel's region stack. A conditional branch is its compare's predicate
# (re-selected when not held) + `@!Pk BRA <false>` + `BRA <true>` unless the true block comes next.
# Back-edge phi copies (MIR_CB_MOVES_*) go between the two branches, so only the edge that takes
# them runs them (FALSE-edge copies flip it: `@Pk BRA <true>`, copies, `BRA <false>`). OpReturn
# is EXIT anywhere — it retires only the threads that execute it, so an early return inside a
# divergent if or loop is legal here, unlike on AMD.
#
# RECONVERGENCE (4.4.0). Diverged threads run each path separately and, without help, may stay
# apart for the rest of the program, each group running the shared code after the merge on its
# own. A closed divergent region gets `BMOV.32.CLEAR RZ, Bd; BSSY Bd, <after its BSYNC>` at its
# head and `BSYNC Bd` at its merge, which waits for every thread the BSSY recorded to arrive or
# exit (NAK nak_nir_lower_cf.c: "exited lanes never block a bsync"; the clear first, as NAK and
# ptxas do, because BSSY accumulates into the barrier). The regions:
#   - a divergent if (forward COND_BRANCH, THEN next): head = the branch, merge = the FALSE label,
#     or for an if/else the label the THEN block's last branch jumps over the ELSE to;
#   - a loop (a label some later branch jumps back to) with a divergent condition inside and ONE
#     exit label after it: head = just before the header label (so the back-edges skip it),
#     merge = the exit.
# A BSYNC hangs if a thread the BSSY recorded never reaches it, so a region gets one only when it
# is CLOSED: no branch inside it targets a label outside it but its merge, and no branch outside
# it targets a label inside it or its merge. Anything else (a break out of an if inside a loop,
# say) runs without reconvergence there, as v1 did everywhere — correct, just not reconverged.
# Regions nest: barrier d = nesting depth (B0..B15); one deeper gets none.
#
# NOT YET (docs/proposals/n9-spirv-to-sass.md §7): f64; the GFX9-shaped division macros
# (F32_DIV_*, F64_*); the bfi OpSelect mask (MIR_OP_SELECT). Each fails with
# SM75_ERR_UNSUPPORTED_OP rather than compiling.

var SM75I_IADD3   = 1;    # d = a + b + c          bit 8: negate b
var SM75I_IMAD    = 2;    # d = a * b + c (low)    bit 8: signed
var SM75I_IMAD_HI = 3;    # d = hi(a * b) + c      unsigned
var SM75I_LOP3    = 4;    # d = lut(a, b, c)       bits 8-15: lut
var SM75I_SHF     = 5;    # funnel shift           bits 8-9: type (2 S32, 3 U32), bit 10 right, bit 11 high
var SM75I_ISETP   = 6;    # Pk = a <cmp> b         bits 8-10: cmp, bit 11: signed, bits 12-14: k (dst 0)
var SM75I_SEL     = 7;    # d = Pk ? a : b         bit 8: Pk negated, bits 9-11: k
var SM75I_MOV     = 8;    # d = b
var SM75I_FADD    = 9;    # d = a + b              bit 8: negate b
var SM75I_FMUL    = 10;   # d = a * b
var SM75I_FFMA    = 11;   # d = a * b + c
var SM75I_FMNMX   = 12;   # d = min / max(a, b)    bit 8: max
var SM75I_FRND    = 13;   # d = round(b)           bits 8-9: rounding
var SM75I_F2I     = 14;   # d = (int)b             bits 8-9: rounding, bit 10: signed
var SM75I_I2F     = 15;   # d = (float)b           bit 10: signed
var SM75I_MUFU    = 16;   # d = fn(b)              bits 8-13: function
var SM75I_S2R     = 17;   # d = special reg        bits 8-15: SR index
var SM75I_ULDC    = 18;   # UR<a> = c[0][b] (64)   a, b immediate               (dst 0)
var SM75I_LDG     = 19;   # d = [a.U32 + UR + b]   bits 8-13: UR, b immediate
var SM75I_STG     = 20;   # [a.U32 + UR + c] = b   bits 8-13: UR, c immediate    (dst 0)
var SM75I_EXIT    = 21;
var SM75I_LABEL   = 22;   # a = label <id> (immediate); 0 bytes — the emitter records its offset
var SM75I_BRA     = 23;   # a = target label (immediate); bit 8: guarded, bit 9: @!Pk, bits 10-12: k
var SM75I_BCLEAR  = 24;   # BMOV.32.CLEAR RZ, B<a>                            a immediate
var SM75I_BSSY    = 25;   # BSSY B<a> -> after the c-th BSYNC at label b     a, b, c immediate
var SM75I_BSYNC   = 26;   # BSYNC B<a>                                        a immediate

var SM75I_REC = 48;   # the GISEL record shape (gfx9_isel.cyr)

# Error codes — the SM75 band, 130-139 (gpu_shader_error_name in compute.cyr).
var SM75_ERR_UNSUPPORTED_OP   = 130;  # a MIR op / type SM75 selection does not handle yet
var SM75_ERR_CAP_EXCEEDED     = 131;  # the selected list outgrew its buffer
var SM75_ERR_CONTROL_FLOW     = 132;  # a branch shape SM75 selection cannot place (copies on both edges)
var SM75_ERR_BAD_OPERAND      = 133;  # an operand of a kind the op cannot take (a pointer, a builtin)
var SM75_ERR_TOO_MANY_BINDINGS = 134; # a binding index at or past NV_MAX_BINDINGS (16)

# The uniform registers the binding pointers live in: binding b -> UR(4 + 2b), loaded once
# from c[0x0][0x160 + 8b] (the NVIDIA dispatch's binding array; backend_nvidia.cyr).
var SM75_UR_BASE   = 4;
var SM75_CB_PARAMS = 0x160;
var SM75_MAX_BIND  = 16;

# ================================================================
# Records
# ================================================================
fn sm75i_op(out, i): i64 { return load64(out + i * SM75I_REC + 0); }
fn sm75i_dst(out, i): i64 { return load64(out + i * SM75I_REC + 8); }
fn sm75i_a(out, i): i64 { return load64(out + i * SM75I_REC + 16); }
fn sm75i_b(out, i): i64 { return load64(out + i * SM75I_REC + 24); }
fn sm75i_c(out, i): i64 { return load64(out + i * SM75I_REC + 32); }
fn sm75i_flags(out, i): i64 { return load64(out + i * SM75I_REC + 40); }

# Selection state (SM75_ST_SIZE bytes): st+0 = k (records so far), st+8 = cap, st+16 = the
# predicate holding the last MIR compare (-1: none since the last label), st+24 = a use clock,
# then SM75_NPRED (7) pairs from st+32: [compare <id> held (0: none), last use]; st+144 = the
# open reconvergence regions, st+152 = the label-position table (`lpos`, cap_ids i64: the MIR
# index of each LABEL, -1 none), st+160 = its entries; from st+168, SM75_NBAR (16) regions of
# [merge label, barrier, the BSSY record's index, BSYNCs already emitted at the merge].
var SM75_NPRED = 7;            # P0..P6; P7 is PT
var SM75_ST_SIZE = 680;        # 168 + 16 * 32
var _S75_RREC = 32;

fn _s75_put(out, st, op, dst, a, b, c, flags): i64 {
    var k = load64(st);
    if (k >= load64(st + 8)) { return 0 - SM75_ERR_CAP_EXCEEDED; }
    _gisel_emit(out, k, op, dst, a, b, c, flags);
    store64(st, k + 1);
    return 0;
}

# The immediate value of an operand, or -1 when it is a register (or absent: RZ). A raw
# immediate (flagged) or a MIR constant is an immediate; the constant's 32 payload bits are
# its value whatever its type (SM75 immediates are raw bits).
fn _s75_imm(m, field, is_imm): i64 {
    if (is_imm != 0) { return field & 0xFFFFFFFF; }
    if (field == 0) { return 0 - 1; }
    if (field >= load64(m + 64)) { return 0 - 1; }
    if (mir_val_kind(m, field) == MIR_VK_CONST) { return mir_val_payload(m, field) & 0xFFFFFFFF; }
    return 0 - 1;
}

# A register operand for `field`: its <id>, RZ (0) for an absent operand or the constant 0,
# or a fresh synth register MOV'd from the immediate. Returns the <id> (>= 0) or an error.
fn _s75_reg(m, out, st, field, is_imm, type): i64 {
    var v = _s75_imm(m, field, is_imm);
    if (v < 0) {
        if (field == 0) { return 0; }
        if (field >= load64(m + 64)) { return 0 - SM75_ERR_BAD_OPERAND; }
        var kind = mir_val_kind(m, field);
        if (kind != MIR_VK_SSA) { return 0 - SM75_ERR_BAD_OPERAND; }
        return field;
    }
    if (v == 0) { return 0; }
    var sid = mir_alloc_synth_id(m);
    if (sid < 0) { return 0 - MIR_ERR_ID_OOR; }
    var sr = _mir_set_val(m, sid, MIR_VK_SSA, type, MIR_DIVERGENT, 0 - 1, 0);
    if (sr < 0) { return sr; }
    var pr = _s75_put(out, st, SM75I_MOV, sid, 0, v, 0, MIR_FLAG_B_IMM);
    if (pr < 0) { return pr; }
    return sid;
}

# A src1 / src2 operand: an immediate (value, flag set) or a register <id>. Writes the value
# to `slot` and returns the IMM flag bit to OR in (0 for a register), or an error.
fn _s75_src(m, field, is_imm, slot, imm_bit): i64 {
    var v = _s75_imm(m, field, is_imm);
    if (v >= 0) {
        store64(slot, v);
        return imm_bit;
    }
    if (field != 0) {
        if (field >= load64(m + 64)) { return 0 - SM75_ERR_BAD_OPERAND; }
        if (mir_val_kind(m, field) != MIR_VK_SSA) { return 0 - SM75_ERR_BAD_OPERAND; }
    }
    store64(slot, field);
    return 0;
}

# ================================================================
# Per-op selection
# ================================================================
# A two-source op d = a OP b. `comm` = 1 for a commutative op: a constant `a` swaps into src1.
fn _s75_bin(m, out, st, op, dst, a, b, fl, mods, comm, type): i64 {
    var aimm = fl & MIR_FLAG_A_IMM;
    var bimm = fl & MIR_FLAG_B_IMM;
    if (comm == 1) {
        if (_s75_imm(m, a, aimm) >= 0) {
            if (_s75_imm(m, b, bimm) < 0) {
                var t = a;  a = b;  b = t;
                var ti = aimm;  aimm = bimm;  bimm = ti;
            }
        }
    }
    var ra = _s75_reg(m, out, st, a, aimm, type);
    if (ra < 0) { return ra; }
    var slot[8];
    var bf = _s75_src(m, b, bimm, &slot, MIR_FLAG_B_IMM);
    if (bf < 0) { return bf; }
    return _s75_put(out, st, op, dst, ra, load64(&slot), 0, bf | mods);
}

# ICMP_* -> ISETP P0. A constant in src0 swaps sides and flips the predicate.
fn _s75_cmp_code(op): i64 {
    if (op == MIR_OP_ICMP_EQ) { return SM75_CMP_EQ; }
    if (op == MIR_OP_ICMP_NE) { return SM75_CMP_NE; }
    if (op == MIR_OP_ICMP_ULT) { return SM75_CMP_LT; }
    if (op == MIR_OP_ICMP_SLT) { return SM75_CMP_LT; }
    if (op == MIR_OP_ICMP_UGT) { return SM75_CMP_GT; }
    if (op == MIR_OP_ICMP_SGT) { return SM75_CMP_GT; }
    if (op == MIR_OP_ICMP_ULE) { return SM75_CMP_LE; }
    if (op == MIR_OP_ICMP_SLE) { return SM75_CMP_LE; }
    if (op == MIR_OP_ICMP_UGE) { return SM75_CMP_GE; }
    if (op == MIR_OP_ICMP_SGE) { return SM75_CMP_GE; }
    return 0 - 1;
}

fn _s75_cmp_flip(cmp): i64 {
    if (cmp == SM75_CMP_LT) { return SM75_CMP_GT; }
    if (cmp == SM75_CMP_GT) { return SM75_CMP_LT; }
    if (cmp == SM75_CMP_LE) { return SM75_CMP_GE; }
    if (cmp == SM75_CMP_GE) { return SM75_CMP_LE; }
    return cmp;
}

fn _s75_pheld(st, k): i64 { return load64(st + 32 + k * 16); }

# Forget every predicate (a label: the contents depend on the path in).
fn _s75_preset(st): i64 {
    store64(st + 16, 0 - 1);
    var k = 0;
    while (k < SM75_NPRED) { store64(st + 32 + k * 16, 0); store64(st + 40 + k * 16, 0); k = k + 1; }
    return 0;
}

fn _s75_ptouch(st, k): i64 {
    var c = load64(st + 24) + 1;
    store64(st + 24, c);
    store64(st + 40 + k * 16, c);
    return 0;
}

# The predicate holding compare `cond`, or -1.
fn _s75_pfind(st, cond): i64 {
    if (cond <= 0) { return 0 - 1; }
    var k = 0;
    while (k < SM75_NPRED) {
        if (_s75_pheld(st, k) == cond) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}

# A predicate for compare `cond`: the one already holding it, else a free one, else the least
# recently used — never the last MIR compare's, which a CNDMASK may still read.
fn _s75_palloc(st, cond): i64 {
    var k = _s75_pfind(st, cond);
    if (k >= 0) { return k; }
    k = 0;
    while (k < SM75_NPRED) {
        if (_s75_pheld(st, k) == 0) { return k; }
        k = k + 1;
    }
    var best = 0 - 1;
    k = 0;
    while (k < SM75_NPRED) {
        if (k != load64(st + 16)) {
            if (best < 0) { best = k; }
            if (load64(st + 40 + k * 16) < load64(st + 40 + best * 16)) { best = k; }
        }
        k = k + 1;
    }
    return best;
}

# Select compare `res` (MIR op `op`, operands a / b) into a predicate. `last` = 1 for the MIR
# compare itself (it becomes the last compare), 0 for a re-selection. Returns the predicate.
fn _s75_icmp(m, out, st, op, res, a, b, fl, last): i64 {
    var cmp = _s75_cmp_code(op);
    if (cmp < 0) { return 0 - SM75_ERR_UNSUPPORTED_OP; }
    var signed = 0;
    if (op >= MIR_OP_ICMP_SLT) { if (op <= MIR_OP_ICMP_SGE) { signed = 1; } }
    var aimm = fl & MIR_FLAG_A_IMM;
    var bimm = fl & MIR_FLAG_B_IMM;
    if (_s75_imm(m, a, aimm) >= 0) {
        if (_s75_imm(m, b, bimm) < 0) {
            var t = a;  a = b;  b = t;
            var ti = aimm;  aimm = bimm;  bimm = ti;
            cmp = _s75_cmp_flip(cmp);
        }
    }
    var ra = _s75_reg(m, out, st, a, aimm, MIR_T_U32);
    if (ra < 0) { return ra; }
    var slot[8];
    var bf = _s75_src(m, b, bimm, &slot, MIR_FLAG_B_IMM);
    if (bf < 0) { return bf; }
    var pk = _s75_palloc(st, res);
    var pr = _s75_put(out, st, SM75I_ISETP, 0, ra, load64(&slot), 0,
      bf | (cmp << 8) | (signed << 11) | (pk << 12));
    if (pr < 0) { return pr; }
    store64(st + 32 + pk * 16, res);
    _s75_ptouch(st, pk);
    if (last == 1) { store64(st + 16, pk); }
    return pk;
}

# The predicate holding condition `cond`: the one it is in, else its compare re-selected.
# Returns the predicate (0..6) or a negative error.
fn _s75_cond(m, out, st, cond): i64 {
    var held = _s75_pfind(st, cond);
    if (held >= 0) { _s75_ptouch(st, held); return held; }
    if (cond <= 0) { return 0 - SM75_ERR_BAD_OPERAND; }
    if (cond >= load64(m + 64)) { return 0 - SM75_ERR_BAD_OPERAND; }
    var cdef = mir_val_def(m, cond);
    if (cdef < 0) { return 0 - SM75_ERR_BAD_OPERAND; }
    if (cdef >= mir_n_instrs(m)) { return 0 - SM75_ERR_BAD_OPERAND; }
    var op = mir_instr_op(m, cdef);
    if (mir_op_is_icmp(op) == 0) { return 0 - SM75_ERR_BAD_OPERAND; }
    return _s75_icmp(m, out, st, op, cond, mir_instr_a(m, cdef), mir_instr_b(m, cdef),
      mir_instr_flags(m, cdef), 0);
}

# SEL d, t, f, Pp (t / f = the TRUE / FALSE values). A constant TRUE value with a register
# FALSE one swaps them and negates Pp; src0 is otherwise materialized.
fn _s75_sel(m, out, st, dst, t, tflag, f, fflag, type, p): i64 {
    var neg = 0;
    if (_s75_imm(m, t, tflag) >= 0) {
        if (_s75_imm(m, f, fflag) < 0) {
            var tt = t;  t = f;  f = tt;
            var tf = tflag;  tflag = fflag;  fflag = tf;
            neg = 1;
        }
    }
    var ra = _s75_reg(m, out, st, t, tflag, type);
    if (ra < 0) { return ra; }
    var slot[8];
    var bf = _s75_src(m, f, fflag, &slot, MIR_FLAG_B_IMM);
    if (bf < 0) { return bf; }
    return _s75_put(out, st, SM75I_SEL, dst, ra, load64(&slot), 0, bf | (neg << 8) | (p << 9));
}

# A single-source op (conversions, MUFU, MOV): the source rides in the src1 slot (b).
fn _s75_un(m, out, st, op, dst, a, fl, mods): i64 {
    var slot[8];
    var bf = _s75_src(m, a, fl & MIR_FLAG_A_IMM, &slot, MIR_FLAG_B_IMM);
    if (bf < 0) { return bf; }
    return _s75_put(out, st, op, dst, 0, load64(&slot), 0, bf | mods);
}

# The UR a binding's pointer lives in.
fn _s75_ur(m, pidx): i64 {
    var bnd = mir_ptr_binding(m, pidx);
    if (bnd < 0) { return 0 - SM75_ERR_BAD_OPERAND; }
    if (bnd >= SM75_MAX_BIND) { return 0 - SM75_ERR_TOO_MANY_BINDINGS; }
    return SM75_UR_BASE + 2 * bnd;
}

# LOAD d, [off] / STORE [off], v. The byte offset is a register, or a constant that fits
# the 24-bit immediate field (then RZ + imm); the value stored is a register.
fn _s75_mem(m, out, st, op, dst, a, b, c, fl): i64 {
    if (mir_type_base(mir_val_type(m, dst)) == MIR_T_F64) { return 0 - SM75_ERR_UNSUPPORTED_OP; }
    var ur = _s75_ur(m, b);
    if (ur < 0) { return ur; }
    var aimm = fl & MIR_FLAG_A_IMM;
    var roff = a;
    var imm = 0;
    var cv = _s75_imm(m, a, aimm);
    if (cv >= 0) {
        if (cv < 0x800000) { roff = 0; imm = cv; }
        else {
            roff = _s75_reg(m, out, st, a, aimm, MIR_T_U32);
            if (roff < 0) { return roff; }
        }
    } else {
        roff = _s75_reg(m, out, st, a, aimm, MIR_T_U32);
        if (roff < 0) { return roff; }
    }
    if (op == MIR_OP_LOAD) {
        return _s75_put(out, st, SM75I_LDG, dst, roff, imm, 0, MIR_FLAG_B_IMM | (ur << 8));
    }
    if (mir_type_base(mir_val_type(m, c)) == MIR_T_F64) { return 0 - SM75_ERR_UNSUPPORTED_OP; }
    var data = _s75_reg(m, out, st, c, fl & MIR_FLAG_C_IMM, MIR_T_U32);
    if (data < 0) { return data; }
    return _s75_put(out, st, SM75I_STG, 0, roff, data, imm, MIR_FLAG_C_IMM | (ur << 8));
}

# EXTRACT of a builtin component -> S2R. GlobalInvocationId never reaches here: lowering
# expands it to WorkgroupId * LocalSize + LocalInvocationId (_spirv_expand_gid).
fn _s75_extract(m, out, st, dst, a, c): i64 {
    if (a <= 0) { return 0 - SM75_ERR_BAD_OPERAND; }
    if (a >= load64(m + 64)) { return 0 - SM75_ERR_BAD_OPERAND; }
    if (mir_val_kind(m, a) != MIR_VK_BUILTIN) { return 0 - SM75_ERR_UNSUPPORTED_OP; }
    if (c < 0) { return 0 - SM75_ERR_BAD_OPERAND; }
    if (c > 2) { return 0 - SM75_ERR_BAD_OPERAND; }
    var bi = mir_val_payload(m, a);
    var sr = 0;
    if (bi == MIR_BI_LOCAL_INVOC_ID) { sr = SM75_SR_TID_X + c; }
    if (bi == MIR_BI_WORKGROUP_ID) { sr = SM75_SR_CTAID_X + c; }
    if (sr == 0) { return 0 - SM75_ERR_UNSUPPORTED_OP; }
    return _s75_put(out, st, SM75I_S2R, dst, 0, 0, 0, sr << 8);
}

# One MIR instruction.
fn _s75_one(m, out, st, i): i64 {
    var op = mir_instr_op(m, i);
    var dst = mir_instr_result(m, i);
    var a = mir_instr_a(m, i);
    var b = mir_instr_b(m, i);
    var c = mir_instr_c(m, i);
    var fl = mir_instr_flags(m, i);
    if (dst != 0) {
        if (mir_type_base(mir_val_type(m, dst)) == MIR_T_F64) { return 0 - SM75_ERR_UNSUPPORTED_OP; }
    }
    var u = MIR_T_U32;
    var f = MIR_T_F32;
    if (op == MIR_OP_RET) { return _s75_put(out, st, SM75I_EXIT, 0, 0, 0, 0, 0); }
    if (op == MIR_OP_LABEL) {
        # A loop header: open its region first, so the back-edges skip the BSSY. Not when an
        # open region merges here too (its BSYNC must come after the label).
        var n1 = mir_n_instrs(m);
        var lx = _s75_loop_region(m, st, n1, a, i);
        if (lx > 0) {
            var clash = 0;
            var d1 = 0;
            while (d1 < _s75_rdepth(st)) {
                if (_s75_rmerge(st, d1) == a) { clash = 1; }
                d1 = d1 + 1;
            }
            if (clash == 0) {
                var ro = _s75_ropen(out, st, lx, _s75_lpos(st, lx));
                if (ro < 0) { return ro; }
            }
        }
        _s75_preset(st);   # predicates depend on the path in
        var pl = _s75_put(out, st, SM75I_LABEL, 0, a, 0, 0, MIR_FLAG_A_IMM);
        if (pl < 0) { return pl; }
        return _s75_rclose(out, st, a);
    }
    if (op == MIR_OP_BRANCH) {
        # a branch to the label right after it falls through: nothing to emit
        if (_s75_is_label(m, mir_n_instrs(m), i + 1, a) == 1) { return 0; }
        return _s75_put(out, st, SM75I_BRA, 0, a, 0, 0, MIR_FLAG_A_IMM);
    }
    # COND_BRANCH needs the copies that follow it: the driver selects it (_s75_cond_branch).
    if (op == MIR_OP_IADD) { return _s75_bin(m, out, st, SM75I_IADD3, dst, a, b, fl, 0, 1, u); }
    if (op == MIR_OP_ISUB) {
        # a - b: a constant b folds into the immediate (two's complement); a register b
        # takes IADD3's negate bit.
        var bv = _s75_imm(m, b, fl & MIR_FLAG_B_IMM);
        if (bv >= 0) {
            var ra = _s75_reg(m, out, st, a, fl & MIR_FLAG_A_IMM, u);
            if (ra < 0) { return ra; }
            return _s75_put(out, st, SM75I_IADD3, dst, ra, (0 - bv) & 0xFFFFFFFF, 0, MIR_FLAG_B_IMM);
        }
        return _s75_bin(m, out, st, SM75I_IADD3, dst, a, b, fl, 1 << 8, 0, u);
    }
    if (op == MIR_OP_IMUL) { return _s75_bin(m, out, st, SM75I_IMAD, dst, a, b, fl, 1 << 8, 1, u); }
    if (op == MIR_OP_MUL_HI) { return _s75_bin(m, out, st, SM75I_IMAD_HI, dst, a, b, fl, 0, 1, u); }
    if (op == MIR_OP_AND) { return _s75_bin(m, out, st, SM75I_LOP3, dst, a, b, fl, 0xC0 << 8, 1, u); }
    if (op == MIR_OP_OR) { return _s75_bin(m, out, st, SM75I_LOP3, dst, a, b, fl, 0xFC << 8, 1, u); }
    if (op == MIR_OP_XOR) { return _s75_bin(m, out, st, SM75I_LOP3, dst, a, b, fl, 0x3C << 8, 1, u); }
    if (op == MIR_OP_SHL) {
        # SHF.L.U32 d, a, s, RZ
        return _s75_bin(m, out, st, SM75I_SHF, dst, a, b, fl, 3 << 8, 0, u);
    }
    if (op == MIR_OP_SHR) {
        # SHF.R.U32.HI d, RZ, s, a — the value rides in src2 (c), so it must be a register.
        var vr = _s75_reg(m, out, st, a, fl & MIR_FLAG_A_IMM, u);
        if (vr < 0) { return vr; }
        var ss[8];
        var sf = _s75_src(m, b, fl & MIR_FLAG_B_IMM, &ss, MIR_FLAG_B_IMM);
        if (sf < 0) { return sf; }
        return _s75_put(out, st, SM75I_SHF, dst, 0, load64(&ss), vr, sf | (3 << 8) | (1 << 10) | (1 << 11));
    }
    if (op == MIR_OP_ASHR) {
        var vs = _s75_reg(m, out, st, a, fl & MIR_FLAG_A_IMM, u);
        if (vs < 0) { return vs; }
        var s2[8];
        var sf2 = _s75_src(m, b, fl & MIR_FLAG_B_IMM, &s2, MIR_FLAG_B_IMM);
        if (sf2 < 0) { return sf2; }
        return _s75_put(out, st, SM75I_SHF, dst, 0, load64(&s2), vs, sf2 | (2 << 8) | (1 << 10) | (1 << 11));
    }
    if (mir_op_is_icmp(op) == 1) {
        var ir = _s75_icmp(m, out, st, op, dst, a, b, fl, 1);
        if (ir < 0) { return ir; }
        return 0;
    }
    if (op == MIR_OP_FADD) { return _s75_bin(m, out, st, SM75I_FADD, dst, a, b, fl, 0, 1, f); }
    if (op == MIR_OP_FSUB) {
        var fv = _s75_imm(m, b, fl & MIR_FLAG_B_IMM);
        if (fv >= 0) {
            var fa = _s75_reg(m, out, st, a, fl & MIR_FLAG_A_IMM, f);
            if (fa < 0) { return fa; }
            return _s75_put(out, st, SM75I_FADD, dst, fa, fv ^ 0x80000000, 0, MIR_FLAG_B_IMM);
        }
        return _s75_bin(m, out, st, SM75I_FADD, dst, a, b, fl, 1 << 8, 0, f);
    }
    if (op == MIR_OP_FMUL) { return _s75_bin(m, out, st, SM75I_FMUL, dst, a, b, fl, 0, 1, f); }
    if (op == MIR_OP_FMIN) { return _s75_bin(m, out, st, SM75I_FMNMX, dst, a, b, fl, 0, 1, f); }
    if (op == MIR_OP_FMAX) { return _s75_bin(m, out, st, SM75I_FMNMX, dst, a, b, fl, 1 << 8, 1, f); }
    if (op == MIR_OP_FMA) {
        # a * b + c: src0 a register, at most one of b / c an immediate.
        var ma = _s75_reg(m, out, st, a, fl & MIR_FLAG_A_IMM, f);
        if (ma < 0) { return ma; }
        var mb[8];
        var mbf = _s75_src(m, b, fl & MIR_FLAG_B_IMM, &mb, MIR_FLAG_B_IMM);
        if (mbf < 0) { return mbf; }
        var mc = 0;
        var mcf = 0;
        if (mbf != 0) {
            mc = _s75_reg(m, out, st, c, fl & MIR_FLAG_C_IMM, f);
            if (mc < 0) { return mc; }
        } else {
            var mcs[8];
            mcf = _s75_src(m, c, fl & MIR_FLAG_C_IMM, &mcs, MIR_FLAG_C_IMM);
            if (mcf < 0) { return mcf; }
            mc = load64(&mcs);
        }
        return _s75_put(out, st, SM75I_FFMA, dst, ma, load64(&mb), mc, mbf | mcf);
    }
    if (op == MIR_OP_FABS) {
        # |x| = x & 0x7FFFFFFF (as the GFX9 path does)
        var xa = _s75_reg(m, out, st, a, fl & MIR_FLAG_A_IMM, f);
        if (xa < 0) { return xa; }
        return _s75_put(out, st, SM75I_LOP3, dst, xa, 0x7FFFFFFF, 0, MIR_FLAG_B_IMM | (0xC0 << 8));
    }
    if (op == MIR_OP_FCLAMP) {
        # clamp(x, lo, hi) = min(max(x, lo), hi): the max into a synth, then the min.
        var tmp = mir_alloc_synth_id(m);
        if (tmp < 0) { return 0 - MIR_ERR_ID_OOR; }
        var tr = _mir_set_val(m, tmp, MIR_VK_SSA, f, MIR_DIVERGENT, 0 - 1, 0);
        if (tr < 0) { return tr; }
        var r1 = _s75_bin(m, out, st, SM75I_FMNMX, tmp, a, b, fl & (MIR_FLAG_A_IMM | MIR_FLAG_B_IMM), 1 << 8, 1, f);
        if (r1 < 0) { return r1; }
        var cfl = 0;
        if ((fl & MIR_FLAG_C_IMM) != 0) { cfl = MIR_FLAG_B_IMM; }
        return _s75_bin(m, out, st, SM75I_FMNMX, dst, tmp, c, cfl, 0, 1, f);
    }
    if (op == MIR_OP_FFLOOR) { return _s75_un(m, out, st, SM75I_FRND, dst, a, fl, SM75_RND_RM << 8); }
    if (op == MIR_OP_FSQRT) { return _s75_un(m, out, st, SM75I_MUFU, dst, a, fl, 8 << 8); }
    if (op == MIR_OP_RCP_IFLAG) { return _s75_un(m, out, st, SM75I_MUFU, dst, a, fl, SM75_MUFU_RCP << 8); }
    if (op == MIR_OP_CVT_F32) { return _s75_un(m, out, st, SM75I_I2F, dst, a, fl, 1 << 10); }
    if (op == MIR_OP_CVT_F32_U) { return _s75_un(m, out, st, SM75I_I2F, dst, a, fl, 0); }
    if (op == MIR_OP_CVT_I32) {
        return _s75_un(m, out, st, SM75I_F2I, dst, a, fl, (SM75_RND_RZ << 8) | (1 << 10));
    }
    if (op == MIR_OP_CVT_U_F32) { return _s75_un(m, out, st, SM75I_F2I, dst, a, fl, SM75_RND_RZ << 8); }
    if (op == MIR_OP_VMOV) { return _s75_un(m, out, st, SM75I_MOV, dst, a, fl, 0); }
    if (op == MIR_OP_CNDMASK) {
        # dst = <last compare> ? b : a — the last MIR compare's predicate (see the header).
        var lp = load64(st + 16);
        if (lp < 0) { return 0 - SM75_ERR_BAD_OPERAND; }
        _s75_ptouch(st, lp);
        return _s75_sel(m, out, st, dst, b, fl & MIR_FLAG_B_IMM, a, fl & MIR_FLAG_A_IMM, u, lp);
    }
    if (op == MIR_OP_ISELECT) {
        var cr = _s75_cond(m, out, st, a);
        if (cr < 0) { return cr; }
        var ty = mir_type_base(mir_val_type(m, dst));
        return _s75_sel(m, out, st, dst, b, fl & MIR_FLAG_B_IMM, c, fl & MIR_FLAG_C_IMM, ty, cr);
    }
    if (op == MIR_OP_EXTRACT) { return _s75_extract(m, out, st, dst, a, c); }
    if (op == MIR_OP_LOAD) { return _s75_mem(m, out, st, op, dst, a, b, c, fl); }
    if (op == MIR_OP_STORE) { return _s75_mem(m, out, st, op, dst, a, b, c, fl); }
    return 0 - SM75_ERR_UNSUPPORTED_OP;
}

# 1 if MIR instruction i is LABEL `l`.
fn _s75_is_label(m, n, i, l): i64 {
    if (i >= n) { return 0; }
    if (mir_instr_op(m, i) != MIR_OP_LABEL) { return 0; }
    if (mir_instr_a(m, i) != l) { return 0; }
    return 1;
}

# ---- reconvergence regions (see the header) ----
fn _s75_lpos(st, l): i64 {
    if (l <= 0) { return 0 - 1; }
    if (l >= load64(st + 160)) { return 0 - 1; }
    return load64(load64(st + 152) + l * 8);
}

fn _s75_rdepth(st): i64 { return load64(st + 144); }
fn _s75_rmerge(st, d): i64 { return load64(st + 168 + d * _S75_RREC); }

# The targets of MIR branch j into t2 (2 i64); returns how many (0 if j is not a branch).
fn _s75_targets(m, j, t2): i64 {
    var op = mir_instr_op(m, j);
    if (op == MIR_OP_BRANCH) { store64(t2, mir_instr_a(m, j)); return 1; }
    if (op == MIR_OP_COND_BRANCH) {
        store64(t2, mir_instr_b(m, j));
        store64(t2 + 8, mir_instr_c(m, j));
        return 2;
    }
    return 0;
}

# Is the region of MIR indices (lo, hi] closed? Every branch strictly inside (lo, hi) targets a
# label at a position in (lo, hi]; no branch at j < lo or j > hi targets one. The branch AT lo
# (an if's head, a loop's preheader) is the caller's to check.
fn _s75_closed(m, st, n, lo, hi): i64 {
    var t2[16];
    var j = 0;
    while (j < n) {
        if (j != lo) {
            var nt = _s75_targets(m, j, &t2);
            var q = 0;
            while (q < nt) {
                var tp = _s75_lpos(st, load64(&t2 + q * 8));
                if (tp < 0) { return 0; }
                var in_t = 0;
                if (tp > lo) { if (tp <= hi) { in_t = 1; } }
                var in_j = 0;
                if (j > lo) { if (j < hi) { in_j = 1; } }
                if (in_j != in_t) { return 0; }
                q = q + 1;
            }
        }
        j = j + 1;
    }
    return 1;
}

# Open a region ending at label `merge` (at MIR position mpos): BCLEAR + BSSY on the next
# barrier, unless it would not nest inside the innermost open one or all 16 are open.
# Returns 1 if opened, 0 if not, or a negative error.
fn _s75_ropen(out, st, merge, mpos): i64 {
    var d = _s75_rdepth(st);
    if (d >= SM75_NBAR) { return 0; }
    if (d > 0) { if (mpos > _s75_lpos(st, _s75_rmerge(st, d - 1))) { return 0; } }
    var r1 = _s75_put(out, st, SM75I_BCLEAR, 0, d, 0, 0, MIR_FLAG_A_IMM);
    if (r1 < 0) { return r1; }
    var bi = load64(st);
    var r2 = _s75_put(out, st, SM75I_BSSY, 0, d, merge, 0, MIR_FLAG_A_IMM | MIR_FLAG_B_IMM | MIR_FLAG_C_IMM);
    if (r2 < 0) { return r2; }
    var r = st + 168 + d * _S75_RREC;
    store64(r, merge);
    store64(r + 8, d);
    store64(r + 16, bi);
    store64(st + 144, d + 1);
    return 1;
}

# At label l: close every innermost region that merges there, innermost first — BSYNC each, and
# point its BSSY after that BSYNC (the c-th at l).
fn _s75_rclose(out, st, l): i64 {
    var c = 0;
    while (_s75_rdepth(st) > 0) {
        var d = _s75_rdepth(st) - 1;
        if (_s75_rmerge(st, d) != l) { return 0; }
        var r = st + 168 + d * _S75_RREC;
        var pr = _s75_put(out, st, SM75I_BSYNC, 0, load64(r + 8), 0, 0, MIR_FLAG_A_IMM);
        if (pr < 0) { return pr; }
        store64(out + load64(r + 16) * SM75I_REC + 32, c);    # the BSSY record's c
        c = c + 1;
        store64(st + 144, d);
    }
    return 0;
}

# Would a BSYNC at merge position mpos be wasted? Yes when, from the merge on, only labels,
# moves and branches onward come before the program's end or an open region's merge (that
# region syncs anyway) — NAK's parent_scope_will_sync. ranga's bounds guard is the common case:
# its merge is the RET.
fn _s75_merge_trivial(m, st, n, mpos): i64 {
    var j = mpos + 1;
    var steps = 0;
    while (j < n) {
        if (steps > n) { return 0; }
        steps = steps + 1;
        var op = mir_instr_op(m, j);
        if (op == MIR_OP_RET) { return 1; }
        if (op == MIR_OP_LABEL) {
            var l = mir_instr_a(m, j);
            var d = 0;
            while (d < _s75_rdepth(st)) {
                if (_s75_rmerge(st, d) == l) { return 1; }
                d = d + 1;
            }
            j = j + 1;
            continue;
        }
        if (op == MIR_OP_VMOV) { j = j + 1; continue; }
        if (op == MIR_OP_BRANCH) {
            var tp = _s75_lpos(st, mir_instr_a(m, j));
            if (tp <= j) { return 0; }
            j = tp;
            continue;
        }
        return 0;
    }
    return 1;
}

fn _s75_divergent(m, v): i64 {
    if (v <= 0) { return 0; }
    if (v >= load64(m + 64)) { return 0; }
    if (mir_val_unif(m, v) == MIR_DIVERGENT) { return 1; }
    return 0;
}

# The loop whose header is label L at MIR position p: its exit label if it is a closed loop with
# a divergent condition and a plain way in (fall-through, or BRANCH L just before), else 0.
fn _s75_loop_region(m, st, n, l, p): i64 {
    var t2[16];
    var e = 0 - 1;
    var j = p + 1;
    while (j < n) {
        var nt = _s75_targets(m, j, &t2);
        var q = 0;
        while (q < nt) {
            if (load64(&t2 + q * 8) == l) { e = j; }
            q = q + 1;
        }
        j = j + 1;
    }
    if (e < 0) { return 0; }
    # the one exit: every target of a branch in [p, e] outside [p, e] is the same label, after e
    var x = 0;
    j = p;
    while (j <= e) {
        var nt2 = _s75_targets(m, j, &t2);
        var q2 = 0;
        while (q2 < nt2) {
            var tl = load64(&t2 + q2 * 8);
            var tp = _s75_lpos(st, tl);
            if (tp < 0) { return 0; }
            if (tp < p) { return 0; }
            if (tp > e) {
                if (x == 0) { x = tl; }
                if (tl != x) { return 0; }
            }
            q2 = q2 + 1;
        }
        j = j + 1;
    }
    if (x == 0) { return 0; }
    var xp = _s75_lpos(st, x);
    if (p > 0) {
        var pop = mir_instr_op(m, p - 1);
        if (pop == MIR_OP_COND_BRANCH) { return 0; }
        if (pop == MIR_OP_BRANCH) { if (mir_instr_a(m, p - 1) != l) { return 0; } }
    }
    if (_s75_closed(m, st, n, p - 1, xp) == 0) { return 0; }
    var div = 0;
    j = p;
    while (j < xp) {
        if (mir_instr_op(m, j) == MIR_OP_COND_BRANCH) { div = div | _s75_divergent(m, mir_instr_a(m, j)); }
        j = j + 1;
    }
    if (div == 0) { return 0; }
    if (_s75_merge_trivial(m, st, n, xp) == 1) { return 0; }
    return x;
}

# COND_BRANCH at MIR index i (a = cond, b = TRUE label, c = FALSE label), with the back-edge
# phi copies that follow it. Returns how many MIR instructions it consumed (1 + copies).
fn _s75_cond_branch(m, out, st, i, n): i64 {
    var cond = mir_instr_a(m, i);
    var bt = mir_instr_b(m, i);
    var ct = mir_instr_c(m, i);
    var fl = mir_instr_flags(m, i);
    var nmv = (fl >> MIR_CB_MOVES_SHIFT) & 0xFF;
    var mv_c = 0;
    if (nmv > 0) {
        if ((fl & MIR_CB_MOVES_ON_TRUE) != 0) { if ((fl & MIR_CB_MOVES_ON_FALSE) != 0) {
                return 0 - SM75_ERR_CONTROL_FLOW;
            } }
        if ((fl & MIR_CB_MOVES_ON_FALSE) != 0) { mv_c = 1; }
        if (i + nmv >= n) { return 0 - SM75_ERR_CONTROL_FLOW; }
    }
    if (bt == ct) {
        # both targets the same: an unconditional branch (its copies, if any, first)
        var j0 = 1;
        while (j0 <= nmv) {
            var r0 = _s75_one(m, out, st, i + j0);
            if (r0 < 0) { return r0; }
            j0 = j0 + 1;
        }
        if (_s75_is_label(m, n, i + 1 + nmv, bt) == 0) {
            var pb = _s75_put(out, st, SM75I_BRA, 0, bt, 0, 0, MIR_FLAG_A_IMM);
            if (pb < 0) { return pb; }
        }
        return 1 + nmv;
    }
    var cr = _s75_cond(m, out, st, cond);
    if (cr < 0) { return cr; }
    # A divergent if (no copies, THEN next): open its reconvergence region at the merge.
    if (nmv == 0) {
        if (_s75_is_label(m, n, i + 1, bt) == 1) {
            if (_s75_divergent(m, cond) == 1) {
                var mg = ct;
                var cp = _s75_lpos(st, ct);
                if (cp > i + 1) {
                    if (mir_instr_op(m, cp - 1) == MIR_OP_BRANCH) {
                        var bx = mir_instr_a(m, cp - 1);
                        if (_s75_lpos(st, bx) > cp) { mg = bx; }
                    }
                    var mp = _s75_lpos(st, mg);
                    if (_s75_closed(m, st, n, i, mp) == 1) {
                        if (_s75_merge_trivial(m, st, n, mp) == 0) {
                            var ro2 = _s75_ropen(out, st, mg, mp);
                            if (ro2 < 0) { return ro2; }
                        }
                    }
                }
            }
        }
    }
    # the guarded branch skips the edge that takes the copies
    var first = ct;
    var other = bt;
    var guard = (1 << 8) | (1 << 9) | (cr << 10);       # @!Pk BRA <false>
    if (mv_c == 1) { first = bt; other = ct; guard = (1 << 8) | (cr << 10); }   # @Pk BRA <true>
    var p1 = _s75_put(out, st, SM75I_BRA, 0, first, 0, 0, MIR_FLAG_A_IMM | guard);
    if (p1 < 0) { return p1; }
    var j = 1;
    while (j <= nmv) {
        var mop = mir_instr_op(m, i + j);
        if (mop != MIR_OP_VMOV) { return 0 - SM75_ERR_UNSUPPORTED_OP; }
        var rj = _s75_one(m, out, st, i + j);
        if (rj < 0) { return rj; }
        j = j + 1;
    }
    if (nmv > 0) {
        var p2 = _s75_put(out, st, SM75I_BRA, 0, other, 0, 0, MIR_FLAG_A_IMM);
        if (p2 < 0) { return p2; }
    } else {
        if (_s75_is_label(m, n, i + 1, other) == 0) {
            var p3 = _s75_put(out, st, SM75I_BRA, 0, other, 0, 0, MIR_FLAG_A_IMM);
            if (p3 < 0) { return p3; }
        }
    }
    return 1 + nmv;
}

# ================================================================
# Driver
# ================================================================
# The module's binding count (NV_SHMOD_NBIND, which the dispatch's binding array must
# match): one past the highest binding the kernel DECLARES, whether or not it reads it,
# the rule gfx9_abi_assign uses. The same SPIR-V must ask for the same binding array on
# every backend: ranga's 1-buffer kernels declare three bindings and invert reads two.
# Counting only the bindings read made its NVIDIA module want 2 where AMD's wants 3, so
# ranga's 3-entry array was refused on NVIDIA alone. Also covers a binding read through an
# access chain whose variable is not a BUFVAR value. 0 when it declares none.
fn sm75_binding_count(m): i64 {
    var nb = 0;
    var cap_ids = load64(m + 64);
    var v = 1;
    while (v < cap_ids) {
        if (mir_val_kind(m, v) == MIR_VK_BUFVAR) {
            var vb = mir_val_payload(m, v);
            if (vb + 1 > nb) { nb = vb + 1; }
        }
        v = v + 1;
    }
    var i = 0;
    while (i < mir_n_ptrs(m)) {
        var bnd = mir_ptr_binding(m, i);
        if (bnd + 1 > nb) { nb = bnd + 1; }
        i = i + 1;
    }
    return nb;
}

# 1 if a LOAD / STORE reaches binding `b` (its pointer needs loading into a UR).
fn _s75_binding_read(m, b): i64 {
    var i = 0;
    while (i < mir_n_ptrs(m)) {
        if (mir_ptr_binding(m, i) == b) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Select the whole MIR list into `out` (`out_len` BYTES — the scratch-buffer contract).
# A prologue loads each binding's pointer once (ULDC.64 UR(4+2b), c[0x0][0x160+8b]); a
# declared binding nothing reads is counted but not loaded.
# Returns the record count or a NEGATIVE error.
fn sm75_isel(m, out, out_len): i64 {
    var st[680];         # SM75_ST_SIZE
    store64(&st, 0);
    store64(&st + 8, out_len / SM75I_REC);
    store64(&st + 24, 0);
    _s75_preset(&st);
    # label positions, for the reconvergence regions
    var lpos[2048];      # 256 label <id>s (cap_ids <= 256)
    var cap_ids = load64(m + 64);
    if (cap_ids > 256) { cap_ids = 256; }
    memset(&lpos, 0xFF, 2048);
    var li = 0;
    while (li < mir_n_instrs(m)) {
        if (mir_instr_op(m, li) == MIR_OP_LABEL) {
            var lid = mir_instr_a(m, li);
            if (lid > 0) { if (lid < cap_ids) { store64(&lpos + lid * 8, li); } }
        }
        li = li + 1;
    }
    store64(&st + 144, 0);
    store64(&st + 152, &lpos);
    store64(&st + 160, cap_ids);
    var nb = sm75_binding_count(m);
    if (nb > SM75_MAX_BIND) { return 0 - SM75_ERR_TOO_MANY_BINDINGS; }
    var b = 0;
    while (b < nb) {
        if (_s75_binding_read(m, b) == 1) {
            var pr = _s75_put(out, &st, SM75I_ULDC, 0, SM75_UR_BASE + 2 * b, SM75_CB_PARAMS + 8 * b, 0,
              MIR_FLAG_A_IMM | MIR_FLAG_B_IMM);
            if (pr < 0) { return pr; }
        }
        b = b + 1;
    }
    var n = mir_n_instrs(m);
    var i = 0;
    while (i < n) {
        if (mir_instr_op(m, i) == MIR_OP_COND_BRANCH) {
            var used = _s75_cond_branch(m, out, &st, i, n);
            if (used < 0) { return used; }
            i = i + used;
            continue;
        }
        var rc = _s75_one(m, out, &st, i);
        if (rc < 0) { return rc; }
        i = i + 1;
    }
    return load64(&st);
}
