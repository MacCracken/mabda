# @internal — N9.3: SM75 emission, scheduling and the compile driver.
# sm75_compile.cyr — the gfx9_compile.cyr analogue for NVIDIA: SPIR-V -> SASS through the
# shared front end, sm75_isel, sm75_regalloc and the encoders in sm75_encode.cyr.
# docs/proposals/n9-spirv-to-sass.md §2, §5.
#
# SCHEDULING (§5) is deliberately conservative in v1, because a wrong control word fails
# silently (garbage or a hang) rather than with an error:
#   - every instruction stalls 15 cycles, longer than any SM75 fixed latency (yield clear:
#     stall 15 with yield set is not a valid encoding — nvdisasm rejects 0x1F);
#   - a variable-latency op (NAK's "decoupled" class: S2R, LDG, MUFU, I2F, F2I, FRND) sets
#     write scoreboard 0, and the NEXT instruction waits on it;
#   - STG reads its sources late: it sets read scoreboard 1 and the next instruction waits.
# That serializes the program. Tightening it from NAK's SM75 latency tables is named in §7.
#
# LAYOUT. One instruction per record, then — as ptxas lays out every kernel, and as the
# captured ones in backend_nvidia_sass.cyr show — a BRA to itself after the last EXIT (a
# trap for anything that falls through) and NOPs to a 128-byte boundary (the instruction
# fetch reads ahead).

var SM75_ERR_SASS_OVERFLOW = 137;  # the program would not fit the caller's sass_len
var SM75_ERR_UNRESOLVED_LABEL = 138; # a branch to a label the program does not contain

# Compile output descriptor (caller buffer, SM75_DESC_SIZE bytes).
var SM75_DESC_LEN   = 0;    # SASS byte length (a multiple of 128)
var SM75_DESC_REGS  = 8;    # the QMD REGISTER_COUNT (sm75_register_count)
var SM75_DESC_NBIND = 16;   # binding pointers the kernel reads (NV_SHMOD_NBIND)
var SM75_DESC_SIZE  = 24;

# 1 for a variable-latency ("decoupled") op: its result is tracked by a scoreboard.
fn _s75_decoupled(op): i64 {
    if (op == SM75I_S2R) { return 1; }
    if (op == SM75I_LDG) { return 1; }
    if (op == SM75I_MUFU) { return 1; }
    if (op == SM75I_I2F) { return 1; }
    if (op == SM75I_F2I) { return 1; }
    if (op == SM75I_FRND) { return 1; }
    return 0;
}

# The operand kind of record slot a / b / c: an immediate when its flag is set.
fn _s75_k(fl, bit): i64 {
    if ((fl & bit) != 0) { return SM75_K_IMM; }
    return SM75_K_REG;
}

# A register-or-immediate operand's encoded value.
fn _s75_v(alloc, fl, bit, field): i64 {
    if ((fl & bit) != 0) { return field & 0xFFFFFFFF; }
    return sm75_reg(alloc, field);
}

# Encode record i into `ins` with physical registers. Returns 0 or a negative error.
fn _s75_encode(isel, i, alloc, ins): i64 {
    var op = sm75i_op(isel, i);
    var fl = sm75i_flags(isel, i);
    var d = sm75_reg(alloc, sm75i_dst(isel, i));
    var a = sm75_reg(alloc, sm75i_a(isel, i));
    var bk = _s75_k(fl, MIR_FLAG_B_IMM);
    var b = _s75_v(alloc, fl, MIR_FLAG_B_IMM, sm75i_b(isel, i));
    var ck = _s75_k(fl, MIR_FLAG_C_IMM);
    var c = _s75_v(alloc, fl, MIR_FLAG_C_IMM, sm75i_c(isel, i));
    var mods = fl >> 8;
    if (op == SM75I_IADD3) { return sm75_enc_iadd3(ins, d, a, b, bk, c, ck, mods & 1); }
    if (op == SM75I_IMAD) { return sm75_enc_imad(ins, SM75_OP_IMAD, d, a, b, bk, c, ck, mods & 1); }
    if (op == SM75I_IMAD_HI) { return sm75_enc_imad(ins, SM75_OP_IMADHI, d, a, b, bk, c, ck, 0); }
    if (op == SM75I_LOP3) { return sm75_enc_lop3(ins, d, a, b, bk, c, ck, mods & 0xFF); }
    if (op == SM75I_SHF) {
        return sm75_enc_shf(ins, d, a, b, bk, c, mods & 3, (mods >> 2) & 1, (mods >> 3) & 1);
    }
    if (op == SM75I_ISETP) { return sm75_enc_isetp(ins, 0, a, b, bk, mods & 7, (mods >> 3) & 1); }
    if (op == SM75I_SEL) { return sm75_enc_sel(ins, d, a, b, bk, 0, mods & 1); }
    if (op == SM75I_MOV) { return sm75_enc_mov(ins, d, b, bk); }
    if (op == SM75I_FADD) { return sm75_enc_fadd(ins, d, a, b, bk, mods & 1); }
    if (op == SM75I_FMUL) { return sm75_enc_fmul(ins, d, a, b, bk); }
    if (op == SM75I_FFMA) { return sm75_enc_ffma(ins, d, a, b, bk, c, ck); }
    if (op == SM75I_FMNMX) { return sm75_enc_fmnmx(ins, d, a, b, bk, mods & 1); }
    if (op == SM75I_FRND) { return sm75_enc_frnd(ins, d, b, bk, mods & 3); }
    if (op == SM75I_F2I) { return sm75_enc_f2i(ins, d, b, bk, (mods >> 2) & 1, mods & 3); }
    if (op == SM75I_I2F) { return sm75_enc_i2f(ins, d, b, bk, (mods >> 2) & 1); }
    if (op == SM75I_MUFU) { return sm75_enc_mufu(ins, d, b, bk, mods & 0x3F); }
    if (op == SM75I_S2R) { return sm75_enc_s2r(ins, d, mods & 0xFF); }
    if (op == SM75I_ULDC) { return sm75_enc_uldc64(ins, sm75i_a(isel, i), 0, sm75i_b(isel, i)); }
    if (op == SM75I_LDG) { return sm75_enc_ldg32(ins, d, a, mods & 0x3F, sm75i_b(isel, i)); }
    if (op == SM75I_STG) {
        # sm75_enc_stg32(ins, offset, UR, data, imm) — the nvdisasm round trip caught these
        # two swapped (`[R1.U32+UR2], R6` for `[R1.U32+UR6], R2`)
        return sm75_enc_stg32(ins, a, mods & 0x3F, sm75_reg(alloc, sm75i_b(isel, i)), sm75i_c(isel, i));
    }
    if (op == SM75I_EXIT) { return sm75_enc_exit(ins); }
    return 0 - SM75_ERR_UNSUPPORTED_OP;
}

# 1 if record op `op` emits no instruction (a label is a position, not an instruction).
fn _s75_zero_size(op): i64 {
    if (op == SM75I_LABEL) { return 1; }
    return 0;
}

# Encode `n` records into `sass` (`sass_len` bytes) with the v1 schedule, then the tail.
# Returns the byte length (a multiple of 128) or a negative error.
fn sm75_emit(isel, n, alloc, sass, sass_len): i64 {
    # Pass 1: instruction count, and each label's byte offset (labels emit nothing).
    var laboff[2048];   # 256 label <id>s (ids < cap_ids <= 256)
    memset(&laboff, 0xFF, 2048);
    var nins = 0;
    var i = 0;
    while (i < n) {
        if (_s75_zero_size(sm75i_op(isel, i)) == 1) {
            var lid = sm75i_a(isel, i);
            if (lid <= 0) { return 0 - SM75_ERR_UNRESOLVED_LABEL; }
            if (lid >= 256) { return 0 - SM75_ERR_UNRESOLVED_LABEL; }
            store64(&laboff + lid * 8, nins * SM75_INS);
        } else {
            nins = nins + 1;
        }
        i = i + 1;
    }
    # the instructions + BRA + up to 7 NOPs of padding
    var total = nins + 1;
    if ((total % 8) != 0) { total = total + (8 - total % 8); }
    if (total * SM75_INS > sass_len) { return 0 - SM75_ERR_SASS_OVERFLOW; }
    var wait = 0;
    var pc = 0;
    i = 0;
    while (i < n) {
        var op = sm75i_op(isel, i);
        if (_s75_zero_size(op) == 1) { i = i + 1; continue; }
        var ins = sass + pc;
        var rc = 0;
        if (op == SM75I_BRA) {
            var t = sm75i_a(isel, i);
            if (t <= 0) { return 0 - SM75_ERR_UNRESOLVED_LABEL; }
            if (t >= 256) { return 0 - SM75_ERR_UNRESOLVED_LABEL; }
            var toff = load64(&laboff + t * 8);
            if (toff < 0) { return 0 - SM75_ERR_UNRESOLVED_LABEL; }
            # offset in 32-bit words from the NEXT instruction
            rc = sm75_enc_bra(ins, (toff - (pc + SM75_INS)) / 4);
            var bfl = sm75i_flags(isel, i) >> 8;
            if ((bfl & 1) != 0) { sm75_set_guard(ins, 0, (bfl >> 1) & 1); }
        } else {
            rc = _s75_encode(isel, i, alloc, ins);
        }
        if (rc < 0) { return rc; }
        var wr = 7;
        var rd = 7;
        var next = 0;
        if (_s75_decoupled(op) == 1) { wr = 0; next = next | 1; }
        if (op == SM75I_STG) { rd = 1; next = next | 2; }
        sm75_set_ctrl(ins, 15, 0, wr, rd, wait, 0);
        wait = next;
        pc = pc + SM75_INS;
        i = i + 1;
    }
    # BRA to itself (-4 words from the next instruction), then NOP padding.
    var tb = sass + nins * SM75_INS;
    sm75_enc_bra(tb, 0 - 4);
    sm75_set_ctrl(tb, 15, 0, 7, 7, wait, 0);
    var j = nins + 1;
    while (j < total) {
        var np = sass + j * SM75_INS;
        sm75_enc_nop(np);
        sm75_set_ctrl(np, 15, 0, 7, 7, 0, 0);
        j = j + 1;
    }
    return total * SM75_INS;
}

# ================================================================
# Driver: SPIR-V -> SASS + descriptor
# ================================================================
# Uses the gfx9_compile context (CC_*): the type / const / decoration tables, CC_OUTBI, an
# initialized MirMod at CC_M, CC_ISEL for the SM75 records, CC_ALLOC for the register map and
# CC_HW (>= 8 bytes) for the high-water. Every buffer carries its length (the scratch-buffer
# contract). Writes the SASS into `sass` (`sass_len` bytes) and [length, register count,
# binding count] into `desc` (SM75_DESC_SIZE bytes). Returns 0 or a NEGATIVE stage code.
fn sm75_compile(ctx, spirv, n, sass, sass_len, desc): i64 {
    if (spirv_validate_stream(spirv, n) != 0) { return 0 - CMP_ERR_VALIDATE; }
    var types = load64(ctx + CC_TYPES);
    var consts = load64(ctx + CC_CONSTS);
    var deco = load64(ctx + CC_DECO);
    if (spirv_build_type_table(spirv, n, types, load64(ctx + CC_TYPES_LEN)) < 0) { return 0 - CMP_ERR_TABLE; }
    if (spirv_build_const_table(spirv, n, consts, load64(ctx + CC_CONSTS_LEN)) < 0) { return 0 - CMP_ERR_TABLE; }
    if (spirv_build_decoration_table(spirv, n, deco, load64(ctx + CC_DECO_LEN)) < 0) { return 0 - CMP_ERR_TABLE; }
    var m = load64(ctx + CC_M);
    var lr = spirv_lower_module(spirv, n, types, consts, deco, m, load64(ctx + CC_OUTBI),
      load64(ctx + CC_OUTBI_LEN));
    if (lr < 0) { return lr; }
    var isel = load64(ctx + CC_ISEL);
    var k = sm75_isel(m, isel, load64(ctx + CC_ISEL_LEN));
    if (k < 0) { return k; }
    var alloc = load64(ctx + CC_ALLOC);
    var hw = load64(ctx + CC_HW);
    var rr = sm75_regalloc(m, isel, k, alloc, load64(ctx + CC_ALLOC_LEN), hw);
    if (rr < 0) { return rr; }
    var len = sm75_emit(isel, k, alloc, sass, sass_len);
    if (len < 0) { return len; }
    store64(desc + SM75_DESC_LEN, len);
    store64(desc + SM75_DESC_REGS, sm75_register_count(load64(hw)));
    store64(desc + SM75_DESC_NBIND, sm75_binding_count(m));
    return 0;
}

# The compile frame: SPIR-V -> SASS with all scratch on this stack, sized for 256 ids (the
# NATIVE_SHADER_CAP_IDS ceiling the AMD path uses). Pure CPU — no context, no ioctl — so the
# CPU suite drives it, and the NVIDIA backend's SPIR-V module create (N9.4) calls it. Like
# _native_compile_spirv_isa, it screens the module first so a bad module reports
# CMP_ERR_VALIDATE / CMP_ERR_TABLE rather than mir_mod_init's code. Every length is the literal
# beside its `var` (scripts/check-compiler-buffer-sizing.py).
fn sm75_compile_spirv(words, n, sass, sass_len, desc): i64 {
    if (words == 0) { return 0 - CMP_ERR_VALIDATE; }
    if (n < 20) { return 0 - CMP_ERR_VALIDATE; }
    if (spirv_validate_stream(words, n) != 0) { return 0 - CMP_ERR_VALIDATE; }
    var idb = spirv_hdr_id_bound(words);
    if (idb > 256) { return 0 - CMP_ERR_TABLE; }
    var types[6144];     # 256 * SPIRV_TYPE_REC(24)
    var consts[4096];    # 256 * SPIRV_CONST_REC(16)
    var deco[4096];      # 256 * SPIRV_DECO_REC(16)
    var outbi[2048];     # 256 * 8
    var m[80];
    var vals[10240];     # 256 * MIR_VAL_REC(40)
    var instrs[16384];   # 512 * MIR_INSTR_REC(32)
    var ptrs[4096];      # 128 * MIR_PTR_REC(32)
    var blocks[32];
    var mr = mir_mod_init(&m, &vals, 10240, &instrs, 16384, &ptrs, 4096, &blocks, 32, idb);
    if (mr < 0) { return mr; }
    var isel[24576];     # 512 * SM75I_REC(48)
    var alloc[4096];     # 256 * RA_REC(16)
    var hw[16];
    var cc[136];         # CC_SIZE
    gfx9_cc_buf(&cc, CC_TYPES, &types, 6144);
    gfx9_cc_buf(&cc, CC_CONSTS, &consts, 4096);
    gfx9_cc_buf(&cc, CC_DECO, &deco, 4096);
    gfx9_cc_buf(&cc, CC_OUTBI, &outbi, 2048);
    gfx9_cc_buf(&cc, CC_ISEL, &isel, 24576);
    gfx9_cc_buf(&cc, CC_ALLOC, &alloc, 4096);
    store64(&cc + CC_M, &m);
    store64(&cc + CC_HW, &hw);
    return sm75_compile(&cc, words, n, sass, sass_len, desc);
}
