# tagged_obj.cyr — tagged unions for object mode
# Like tagged.cyr but with runtime-initialized constants
# (avoids top-level enum init code that doesn't run in linked .o mode)

var NONE = 0;
var SOME = 0;
var OK = 0;
var ERR = 0;

fn tagged_obj_init() {
    NONE = 0;
    SOME = 1;
    OK = 0;
    ERR = 1;
    return 0;
}

fn tagged_new(tag_val, value) {
    var t = alloc(16);
    store64(t, tag_val);
    store64(t + 8, value);
    return t;
}

fn tag(t) { return load64(t); }
fn payload(t) { return load64(t + 8); }
fn is_tag(t, expected) { if (load64(t) == expected) { return 1; } return 0; }

fn None() { return tagged_new(NONE, 0); }
fn Some(value) { return tagged_new(SOME, value); }
fn is_none(opt) { return is_tag(opt, NONE); }
fn is_some(opt) { return is_tag(opt, SOME); }
fn unwrap(opt) {
    if (is_none(opt) == 1) { syscall(1, 2, "unwrap on None\n", 15); syscall(60, 1); }
    return payload(opt);
}
fn unwrap_or(opt, fallback) {
    if (is_none(opt) == 1) { return fallback; }
    return payload(opt);
}

fn Ok(value) { return tagged_new(OK, value); }
fn Err(code) { return tagged_new(ERR, code); }
fn is_ok(res) { return is_tag(res, OK); }
fn is_err_result(res) { return is_tag(res, ERR); }
fn result_unwrap(res) {
    if (is_err_result(res) == 1) { syscall(1, 2, "result_unwrap on Err\n", 21); syscall(60, 1); }
    return payload(res);
}
fn result_unwrap_or(res, fallback) {
    if (is_err_result(res) == 1) { return fallback; }
    return payload(res);
}
fn err_code_of(res) {
    if (is_ok(res) == 1) { return 0; }
    return payload(res);
}
