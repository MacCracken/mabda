# @public — v3 surface API (Step 7.7)
# surface_v3.cyr — public dispatchers for the v3 surface
# abstraction. Sits ABOVE the v2 `src/surface.cyr` lifecycle (which
# stays in tree as the wgpu-side mechanism the wgpu wrappers
# delegate to) and BELOW the consumer's window/master-fd code.
#
# Six public fns total:
#   - 3 backend-specific configure entries:
#       gpu_surface_configure_wgpu          (wgpu, full)
#       gpu_surface_configure_native_kiosk  (native, full)
#       gpu_surface_configure_native_logind (native, samvada 1.1.2, -D MABDA_LOGIND)
#   - 3 generic per-frame ops:
#       gpu_surface_acquire
#       gpu_surface_present
#       gpu_surface_release
#
# Configure entries stash backend-specific resources (WGPUSurface
# handle or DRM master card_fd) on the GpuContext via
# `gpu_ctx_set_*` accessors, then dispatch through
# `ctx->backend->surface_configure` slot. The slot impl reads the
# stash back from ctx and runs backend-appropriate setup.
#
# Per-frame ops are backend-agnostic — they route directly through
# the slot table without any backend-specific input.
#
# Design + tradeoffs are documented in
# `docs/archive/proposals/v3-surface-api-design.md`.

# ================================================================
# Backend-specific configure entries
# ================================================================

# Wgpu: caller pre-creates a WGPUSurface from their window using
# wgpu_instance_create_surface (or whatever windowing-library
# binding they're using). mabda doesn't touch windows; it just
# wraps the resulting surface handle with format / size / present
# config and returns an opaque surface ptr.
#
# Returns the surface_ptr on success, 0 on failure (typically:
# null ctx, zero dimensions, no backend, surface_state_new
# returning null).
fn gpu_surface_configure_wgpu(ctx, wgpu_surface, width, height): i64 {
    if (ctx == 0)          { return 0; }
    if (wgpu_surface == 0) { return 0; }
    if (width <= 0)        { return 0; }
    if (height <= 0)       { return 0; }
    var b = gpu_ctx_backend(ctx);
    if (b == 0) { return 0; }
    var slot = backend_get_slot(b, BACKEND_SLOT_SURFACE_CONFIGURE);
    if (slot == 0) { return 0; }
    gpu_ctx_set_wgpu_surface_handle(ctx, wgpu_surface);
    return fncall3(slot, ctx, width, height);
}

# Native (TTY/kiosk): caller has already opened /dev/dri/cardN and
# called DRM_IOCTL_SET_MASTER on it. This entry stashes the fd on
# ctx and runs the full modeset through the backend slot, which
# does discovery → mode-pick → BO alloc → PRIME bridge → AddFB2
# → SETCRTC → second-FB alloc.
#
# Returns the surface_ptr on success, 0 on failure. The card_fd
# remains the caller's responsibility — release_scanout / rm_fb /
# gem_close run on `release`, but the master fd close + drop_master
# stay with the caller.
fn gpu_surface_configure_native_kiosk(ctx, card_fd, width, height): i64 {
    if (ctx == 0)     { return 0; }
    if (card_fd <= 0) { return 0; }
    if (width <= 0)   { return 0; }
    if (height <= 0)  { return 0; }
    var b = gpu_ctx_backend(ctx);
    if (b == 0) { return 0; }
    var slot = backend_get_slot(b, BACKEND_SLOT_SURFACE_CONFIGURE);
    if (slot == 0) { return 0; }
    gpu_ctx_set_native_card_fd(ctx, card_fd);
    return fncall3(slot, ctx, width, height);
}

# Native (logind): asks systemd-logind via dbus TakeDevice() to
# delegate DRM master from the caller's session. The `samvada`
# package (`[deps.samvada]` tag 1.1.2) provides the dbus client;
# this dispatcher composes:
#   1. samvada_session_take_device(major, minor) on each candidate
#      card (minors 0..1 — most systems have AMD on card0 or card1;
#      multi-GPU disambiguation is a v3.x extension).
#   2. First card that returns a positive fd → stash via
#      gpu_ctx_set_native_card_fd + dispatch through the slot.
#
# Compiled only under `-D MABDA_LOGIND` (off by default). Without
# the flag this returns 0 ("logind path unavailable") and samvada
# is never called.
#
# Pre-condition: the consumer must initialize samvada first —
# normally `samvada_native_init()` (pure-Cyrius dbus: no C shim,
# no libsystemd); mabda never initializes it. If samvada isn't
# initialized, take_device returns -22 (EINVAL) and this
# dispatcher falls through to "logind path unavailable"
# (returns 0 — consumer can fall back to _native_kiosk).
#
# DRM major is 226 on Linux (drivers/gpu/drm/drm_drv.c); minors
# 0..15 cover card0..card15 (primary nodes). Render nodes start
# at minor 128 and aren't relevant here — TakeDevice operates on
# the master/primary node.
var _DRM_MAJOR = 226;

fn gpu_surface_configure_native_logind(ctx, width, height): i64 {
    if (ctx == 0)    { return 0; }
    if (width <= 0)  { return 0; }
    if (height <= 0) { return 0; }
    #ifdef MABDA_LOGIND

    # Try minors 0 + 1 — covers the typical AMD-on-card0 and
    # AMD-on-card1 setups (split-GPU machines often have integrated
    # on card0 and discrete on card1, or vice versa). Multi-card
    # disambiguation is v3.x scope.
    var minor = 0;
    var fd = samvada_session_take_device(_DRM_MAJOR, 0);
    if (fd < 0) {
        minor = 1;
        fd = samvada_session_take_device(_DRM_MAJOR, 1);
    }
    if (fd < 0) { return 0; }   # samvada uninit'd OR no card available

    # Audit HIGH-2 (2026-04-30): every failure path between here and
    # the slot dispatch must release the fd back to logind + close.
    # Otherwise the consumer's fallback "try logind, then kiosk" loop
    # accumulates leaked master fds (RLIMIT_NOFILE pressure + DRM
    # master held until process exit).
    var b = gpu_ctx_backend(ctx);
    if (b == 0) {
        samvada_session_release_device(_DRM_MAJOR, minor);
        sys_close(fd);
        return 0;
    }
    var slot = backend_get_slot(b, BACKEND_SLOT_SURFACE_CONFIGURE);
    if (slot == 0) {
        samvada_session_release_device(_DRM_MAJOR, minor);
        sys_close(fd);
        return 0;
    }
    gpu_ctx_set_native_card_fd(ctx, fd);
    var surf = fncall3(slot, ctx, width, height);
    if (surf == 0) {
        # Slot's own failure path (discovery / modeset / FB alloc).
        # Return master to logind, close the fd, scrub the ctx stash.
        samvada_session_release_device(_DRM_MAJOR, minor);
        sys_close(fd);
        gpu_ctx_set_native_card_fd(ctx, 0);
    }
    # Audit 2026-06-14 [HIGH-2 NEW]: on success mabda still OWNS this
    # logind-acquired master fd — the consumer never sees it (it lives
    # only in the surface). Record provenance so gpu_surface_release gives
    # master back to logind + closes the fd; without this the fd and DRM
    # master leak for the process lifetime. Native-only: marking writes
    # into the NativeSurface tail, so guard on the backend kind (this path
    # is always native in practice, but never corrupt a wgpu surface_state).
    if (surf != 0) {
        if (backend_kind(b) == BACKEND_KIND_AMD) {
            native_surface_mark_master_owned(surf, minor);
        }
        # 4.4.0: NVIDIA too (NvSurface +288); before, its release kept the device and the fd.
        if (backend_kind(b) == BACKEND_KIND_NVIDIA) {
            native_nv_surface_mark_master_owned(surf, minor);
        }
    }
    return surf;
    #else
    # v6.3.2 (cyrius undef-hard-error fold): the logind / DRM-master path is
    # opt-in — build mabda with `-D MABDA_LOGIND` plus the `[deps.samvada]` dep
    # to enable it. Without the flag the samvada_session_* calls are not
    # compiled, so a fold/consumer that doesn't pull samvada has no
    # undefined-fn reference. Behaves exactly as "no card available" (the fd<0
    # path above): returns 0, so the consumer can fall back to _native_kiosk.
    return 0;
    #endif
}

# ================================================================
# Generic per-frame ops (backend-agnostic)
# ================================================================

# Returns a backend-specific buffer pointer the caller renders
# into. wgpu: a WGPUTexture handle. native: a NativeKmsFb pointer
# (consumer reads `mapped_addr` field for CPU-direct access).
# Returns 0 on failure (typically: null inputs, slot rejected,
# stale surface).
# wgpu (4.4.0): the texture stays the surface's. Present, resize and release free it, so
# don't release it yourself and don't use it after the present. A second acquire before
# the present returns the same texture.
fn gpu_surface_acquire(ctx, surface): i64 {
    if (ctx == 0)     { return 0; }
    if (surface == 0) { return 0; }
    var b = gpu_ctx_backend(ctx);
    if (b == 0) { return 0; }
    var slot = backend_get_slot(b, BACKEND_SLOT_SURFACE_ACQUIRE);
    if (slot == 0) { return 0; }
    return fncall2(slot, ctx, surface);
}

# Submit the back-buffer for display. wgpu: queue submit + the
# library's swapchain present semantics. native: page-flip the
# CRTC, block on vblank event, swap front/back. Returns 0 on
# success, GPU_ERR_* on failure.
fn gpu_surface_present(ctx, surface): i64 {
    if (ctx == 0)     { return GPU_ERR_OTHER; }
    if (surface == 0) { return GPU_ERR_OTHER; }
    var b = gpu_ctx_backend(ctx);
    if (b == 0) { return GPU_ERR_OTHER; }
    var slot = backend_get_slot(b, BACKEND_SLOT_SURFACE_PRESENT);
    if (slot == 0) { return GPU_ERR_OTHER; }
    return fncall2(slot, ctx, surface);
}

# Release the surface and any backend-owned resources (FBs, CRTC
# disable, BO close). Does NOT close consumer-supplied fds (master
# card_fd, wgpu surface handle); those stay with the caller.
fn gpu_surface_release(ctx, surface): i64 {
    if (ctx == 0)     { return 0; }
    if (surface == 0) { return 0; }
    var b = gpu_ctx_backend(ctx);
    if (b == 0) { return 0; }
    var slot = backend_get_slot(b, BACKEND_SLOT_SURFACE_RELEASE);
    if (slot == 0) { return 0; }
    var rc = fncall2(slot, ctx, surface);
    # Audit LOW-6 (2026-04-30): zero the ctx stash so a subsequent
    # configure that fails before stashing doesn't see stale fd / handle.
    gpu_ctx_set_wgpu_surface_handle(ctx, 0);
    gpu_ctx_set_native_card_fd(ctx, 0);
    return rc;
}

# ================================================================
# v4.3.1 — a window surface from Wayland on wgpu (the render tier's MB5)
# ================================================================
# The application owns the window (soorat 2.0 owns none): it connects to the
# compositor and makes a wl_surface (an xdg_toplevel for a window), then hands
# mabda the wl_display and wl_surface:
#
#   gpu_surface_create_wayland(ctx, wl_display, wl_surface);
#   var caps = gpu_surface_caps_new();
#   gpu_surface_capabilities(ctx, caps);            # formats, present modes
#   var s = gpu_surface_configure(ctx, w, h, MABDA_TEXFMT_BGRA8_SRGB, GPU_PRESENT_AUTO_VSYNC);
#   per frame:
#     var frame = gpu_surface_acquire_target(ctx, s);   # a texture object
#     ... gpu_pass_desc_color(pd, frame, ...) / a resolve target ...
#     gpu_surface_present(ctx, s);                      # presents and drops the frame
#   on a window resize (or GPU_ERR_SURFACE_OUTDATED): gpu_surface_resize(ctx, s, w, h);
#   gpu_surface_release(ctx, s);
#
# Backends: wgpu (launcher slots 78-79). Native KMS surfaces keep
# gpu_surface_configure_native_*; these calls are GPU_ERR_NOT_IMPLEMENTED there.  #skip-lint

# Present modes (WebGPU's numbers) and mabda's two automatic choices.
var GPU_PRESENT_FIFO          = 1;    # vsync: always available
var GPU_PRESENT_FIFO_RELAXED  = 2;    # vsync, tears when late
var GPU_PRESENT_IMMEDIATE     = 3;    # no vsync, tears
var GPU_PRESENT_MAILBOX       = 4;    # no vsync, no tearing
var GPU_PRESENT_AUTO_VSYNC    = 16;   # FifoRelaxed when the surface has it, else Fifo
var GPU_PRESENT_AUTO_NO_VSYNC = 17;   # Immediate, else Mailbox, else Fifo

# Surface capabilities (GPU_SURFACE_CAPS_SIZE = 168 bytes; the launcher's
# WgpuSurfaceCapsOut, deps/wgpu_main.c): status +0, usages +8, format count +16,
# 16 x u32 WGPUTextureFormat +24, present mode count +88, 8 x u32 present mode
# +96, alpha mode count +128, 8 x u32 alpha mode +136. Counts are the surface's
# true counts; at most 16 / 8 / 8 entries are kept.
var GPU_SURFACE_CAPS_SIZE = 168;

fn gpu_surface_caps_new(): i64 {
    var c = alloc(GPU_SURFACE_CAPS_SIZE);
    if (c == 0) { return 0; }
    memset(c, 0, GPU_SURFACE_CAPS_SIZE);
    return c;
}

fn _gpu_caps_count(c, off, cap): i64 {
    if (c == 0) { return 0; }
    var n = load64(c + off);
    if (n < 0) { return 0; }
    if (n > cap) { return cap; }
    return n;
}

fn gpu_surface_caps_format_count(c): i64 { return _gpu_caps_count(c, 16, 16); }
fn gpu_surface_caps_present_mode_count(c): i64 { return _gpu_caps_count(c, 88, 8); }

# Format `i` as a MABDA_TEXFMT_* id, or -1 for a format mabda has no id for.
fn gpu_surface_caps_format(c, i): i64 {
    if (i < 0) { return 0 - 1; }
    if (i >= gpu_surface_caps_format_count(c)) { return 0 - 1; }
    return mabda_texfmt_from_wgpu(load32(c + 24 + i * 4));
}

# Present mode `i` (GPU_PRESENT_FIFO .. _MAILBOX), or -1.
fn gpu_surface_caps_present_mode(c, i): i64 {
    if (i < 0) { return 0 - 1; }
    if (i >= gpu_surface_caps_present_mode_count(c)) { return 0 - 1; }
    return load32(c + 96 + i * 4);
}

fn gpu_surface_caps_has_format(c, fmt): i64 {
    var n = gpu_surface_caps_format_count(c);
    for (var i = 0; i < n; i = i + 1) {
        if (gpu_surface_caps_format(c, i) == fmt) { return 1; }
    }
    return 0;
}

fn gpu_surface_caps_has_present_mode(c, mode): i64 {
    var n = gpu_surface_caps_present_mode_count(c);
    for (var i = 0; i < n; i = i + 1) {
        if (gpu_surface_caps_present_mode(c, i) == mode) { return 1; }
    }
    return 0;
}

# The present mode `mode` resolves to on a surface with capabilities `c`: an
# explicit mode the surface has is itself; the AUTO modes pick as documented
# above. -1 when the surface has none that fits (an explicit mode it lacks).
fn gpu_surface_resolve_present_mode(c, mode): i64 {
    if (mode == GPU_PRESENT_AUTO_VSYNC) {
        if (gpu_surface_caps_has_present_mode(c, GPU_PRESENT_FIFO_RELAXED) == 1) { return GPU_PRESENT_FIFO_RELAXED; }
        return GPU_PRESENT_FIFO;
    }
    if (mode == GPU_PRESENT_AUTO_NO_VSYNC) {
        if (gpu_surface_caps_has_present_mode(c, GPU_PRESENT_IMMEDIATE) == 1) { return GPU_PRESENT_IMMEDIATE; }
        if (gpu_surface_caps_has_present_mode(c, GPU_PRESENT_MAILBOX) == 1) { return GPU_PRESENT_MAILBOX; }
        return GPU_PRESENT_FIFO;
    }
    if (mode < GPU_PRESENT_FIFO) { return 0 - 1; }
    if (mode > GPU_PRESENT_MAILBOX) { return 0 - 1; }
    if (gpu_surface_caps_has_present_mode(c, mode) == 1) { return mode; }
    return 0 - 1;
}

fn _gpu_surfx_slot(ctx, off): i64 {
    if (ctx == 0) { return 0; }
    var b = gpu_ctx_backend(ctx);
    if (b == 0) { return 0; }
    return backend_get_slot(b, off);
}

fn _gpu_surfx_missing(): i64 {
    _gpu_err_record(GPU_ERR_NOT_IMPLEMENTED,   #skip-lint
      "surface: this backend has no Wayland surfaces (wgpu only)", 1);
    return GPU_ERR_NOT_IMPLEMENTED;   #skip-lint
}

# Make the context's window surface from a Wayland client's wl_display* and
# wl_surface* (they stay the caller's; the surface must outlive mabda's use).
# Returns 0 or a GPU_ERR_* (the reason recorded).
fn gpu_surface_create_wayland(ctx, wl_display, wl_surface): i64 {
    if (ctx == 0) { return GPU_ERR_OTHER; }
    if (wl_display == 0) {
        _gpu_err_record(GPU_ERR_SURFACE_CONFIG, "surface: null wl_display", 1);
        return GPU_ERR_SURFACE_CONFIG;
    }
    if (wl_surface == 0) {
        _gpu_err_record(GPU_ERR_SURFACE_CONFIG, "surface: null wl_surface", 1);
        return GPU_ERR_SURFACE_CONFIG;
    }
    var slot = _gpu_surfx_slot(ctx, BACKEND_SLOT_SURFACE_CREATE_WAYLAND);
    if (slot == 0) { return _gpu_surfx_missing(); }
    return fncall3(slot, ctx, wl_display, wl_surface);
}

# Fill `caps` (from gpu_surface_caps_new) for the context's surface. 0 or a GPU_ERR_*.
fn gpu_surface_capabilities(ctx, caps): i64 {
    if (ctx == 0) { return GPU_ERR_OTHER; }
    if (caps == 0) { return GPU_ERR_OTHER; }
    var slot = _gpu_surfx_slot(ctx, BACKEND_SLOT_SURFACE_CAPABILITIES);
    if (slot == 0) { return _gpu_surfx_missing(); }
    return fncall2(slot, ctx, caps);
}

# Configure the context's surface: `width` x `height`, `fmt` a MABDA_TEXFMT_* the
# surface lists (BGRA8 / BGRA8_SRGB on most Wayland compositors), `present_mode`
# a GPU_PRESENT_*. Returns the surface, or 0 (reason recorded).
fn gpu_surface_configure(ctx, width, height, fmt, present_mode): i64 {
    if (ctx == 0) { return 0; }
    if (width <= 0) { _gpu_err_record(GPU_ERR_SURFACE_CONFIG, "surface: width must be positive", 1); return 0; }
    if (height <= 0) { _gpu_err_record(GPU_ERR_SURFACE_CONFIG, "surface: height must be positive", 1); return 0; }
    if (validate_dimensions(width, height, MABDA_MAX_TEXTURE_DIM_2D) != 0) {
        _gpu_err_record(GPU_ERR_SURFACE_CONFIG, "surface: a dimension is past 8192", 1);
        return 0;
    }
    if (mabda_texfmt_is_color_target(fmt) == 0) {
        _gpu_err_record(GPU_ERR_FORMAT_UNSUPPORTED, "surface: not a colour render format", 1);
        return 0;
    }
    var slot = _gpu_surfx_slot(ctx, BACKEND_SLOT_SURFACE_CONFIGURE_EX);
    if (slot == 0) { _gpu_surfx_missing(); return 0; }
    return fncall5(slot, ctx, width, height, fmt, present_mode);
}

# This frame's surface texture as a texture object (attach it, or resolve into
# it), or 0 with GPU_ERR_SURFACE_TIMEOUT / _OUTDATED (resize, then acquire again) /
# _LOST recorded. Calling it again before gpu_surface_present returns the same frame.
fn gpu_surface_acquire_target(ctx, surface): i64 {
    if (ctx == 0) { return 0; }
    if (surface == 0) { return 0; }
    var slot = _gpu_surfx_slot(ctx, BACKEND_SLOT_SURFACE_ACQUIRE_TARGET);
    if (slot == 0) { _gpu_surfx_missing(); return 0; }
    return fncall2(slot, ctx, surface);
}

# Reconfigure `surface` at a new size (an unpresented frame is dropped first).
fn gpu_surface_resize(ctx, surface, width, height): i64 {
    if (ctx == 0) { return GPU_ERR_OTHER; }
    if (surface == 0) { return GPU_ERR_OTHER; }
    if (width <= 0) { return GPU_ERR_SURFACE_CONFIG; }
    if (height <= 0) { return GPU_ERR_SURFACE_CONFIG; }
    if (validate_dimensions(width, height, MABDA_MAX_TEXTURE_DIM_2D) != 0) { return GPU_ERR_SURFACE_CONFIG; }
    var slot = _gpu_surfx_slot(ctx, BACKEND_SLOT_SURFACE_RESIZE);
    if (slot == 0) { return _gpu_surfx_missing(); }
    return fncall4(slot, ctx, surface, width, height);
}
