# @public — stable API surface (survives the v3.0 backend swap)
# capabilities.cyr — GPU capability reporting
# Ported from mabda/src/capabilities.rs
#
# GpuCapabilities struct layout (128 bytes):
#   +0:  adapter_name     (str ptr)
#   +8:  backend          (str ptr)
#   +16: timestamp_query  (i64 bool)
#   +24: compute_shaders  (i64 bool)
#   +32: max_texture_dimension_2d  (i64)
#   +40: max_uniform_buffer_size   (i64)
#   +48: max_storage_buffer_size   (i64)
#   +56: max_buffer_size           (i64)
#   +64: max_bind_groups           (i64)
#   +72: max_vertex_buffers        (i64)
#   +80: max_compute_wg_x          (i64)
#   +88: max_compute_wg_y          (i64)
#   +96: max_compute_wg_z          (i64)
#   +104: max_compute_wgs_per_dim  (i64)
#   +112: multi_draw_indirect      (i64 bool)

fn gpu_caps_new() {
    var c = alloc(120);
    memset(c, 0, 120);
    store64(c + 24, 1);   # compute_shaders = true (always for wgpu)
    return c;
}

# Accessors
fn gpu_caps_adapter_name(c)           { return load64(c); }
fn gpu_caps_backend(c)                { return load64(c + 8); }
fn gpu_caps_timestamp_query(c)        { return load64(c + 16); }
fn gpu_caps_compute_shaders(c)        { return load64(c + 24); }
fn gpu_caps_max_texture_2d(c)         { return load64(c + 32); }
fn gpu_caps_max_uniform_buffer(c)     { return load64(c + 40); }
fn gpu_caps_max_storage_buffer(c)     { return load64(c + 48); }
fn gpu_caps_max_buffer_size(c)        { return load64(c + 56); }
fn gpu_caps_max_bind_groups(c)        { return load64(c + 64); }
fn gpu_caps_max_vertex_buffers(c)     { return load64(c + 72); }
fn gpu_caps_max_compute_wg_x(c)      { return load64(c + 80); }
fn gpu_caps_max_compute_wg_y(c)      { return load64(c + 88); }
fn gpu_caps_max_compute_wg_z(c)      { return load64(c + 96); }
fn gpu_caps_max_compute_wgs_dim(c)   { return load64(c + 104); }
fn gpu_caps_multi_draw_indirect(c)   { return load64(c + 112); }

# Setters (used by from_context to populate)
fn gpu_caps_set_adapter_name(c, v)    { store64(c, v); return 0; }
fn gpu_caps_set_backend(c, v)         { store64(c + 8, v); return 0; }
fn gpu_caps_set_timestamp_query(c, v) { store64(c + 16, v); return 0; }
fn gpu_caps_set_max_texture_2d(c, v)  { store64(c + 32, v); return 0; }
fn gpu_caps_set_max_uniform(c, v)     { store64(c + 40, v); return 0; }
fn gpu_caps_set_max_storage(c, v)     { store64(c + 48, v); return 0; }
fn gpu_caps_set_max_buffer(c, v)      { store64(c + 56, v); return 0; }
fn gpu_caps_set_max_bind_groups(c, v) { store64(c + 64, v); return 0; }
fn gpu_caps_set_max_vertex_buf(c, v)  { store64(c + 72, v); return 0; }
fn gpu_caps_set_compute_wg(c, x, y, z) {
    store64(c + 80, x);
    store64(c + 88, y);
    store64(c + 96, z);
    return 0;
}
fn gpu_caps_set_compute_wgs_dim(c, v) { store64(c + 104, v); return 0; }
fn gpu_caps_set_multi_draw(c, v)      { store64(c + 112, v); return 0; }

# Validation helpers
fn gpu_caps_uniform_fits(c, size) {
    if (size <= gpu_caps_max_uniform_buffer(c)) { return 1; }
    return 0;
}

fn gpu_caps_storage_fits(c, size) {
    if (size <= gpu_caps_max_storage_buffer(c)) { return 1; }
    return 0;
}

# WebGPU compatibility constants
var WEBGPU_MAX_UNIFORM_BUFFER = 65536;
var WEBGPU_MAX_STORAGE_BUFFER = 134217728;
var WEBGPU_MAX_BIND_GROUPS = 4;
var WEBGPU_MAX_TEXTURE_2D = 8192;

fn webgpu_uniform_fits(size) {
    if (size <= WEBGPU_MAX_UNIFORM_BUFFER) { return 1; }
    return 0;
}
