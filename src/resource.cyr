# @public — stable API surface (survives the v3.0 backend swap)
# resource.cyr — frame resource tracking
# Ported from mabda/src/resource.rs
#
# FrameResources tracks transient GPU resources (buffers, textures)
# created during a frame, so they can be cleaned up at frame end.
#
# FrameResources struct layout (16 bytes):
#   +0: buffers  (vec ptr — vec of WGPUBuffer handles)
#   +8: textures (vec ptr — vec of WGPUTexture handles)

fn frame_resources_new() {
    var fr = alloc(16);
    store64(fr, vec_new());
    store64(fr + 8, vec_new());
    return fr;
}

fn frame_resources_track_buffer(fr, buffer) {
    vec_push(load64(fr), buffer);
    return 0;
}

fn frame_resources_track_texture(fr, texture) {
    vec_push(load64(fr + 8), texture);
    return 0;
}

fn frame_resources_buffer_count(fr) {
    return vec_len(load64(fr));
}

fn frame_resources_texture_count(fr) {
    return vec_len(load64(fr + 8));
}

fn frame_resources_clear(fr) {
    var bufs = load64(fr);
    while (vec_len(bufs) > 0) { vec_pop(bufs); }
    var texs = load64(fr + 8);
    while (vec_len(texs) > 0) { vec_pop(texs); }
    return 0;
}
