# @internal — native NVIDIA backend, pre-compiled SM75 SASS programs
# backend_nvidia_sass.cyr — the backend_native_shaders.cyr analogue for
# the v4.0 NVIDIA arc (Phase N5). Holds captured/verified Turing (SM75)
# machine code, embedded as raw dwords, plus the launch-ABI metadata the
# N4.2 QMD must mirror.
#
# Provenance (ADR 007, Fork 3 — ptxas-capture doctrine): compiled offline
# with CUDA 13.3 `nvcc -arch=sm_75 -cubin store_deadbeef.cu`, the
# .text.store_deadbeef section extracted (128 bytes, 8 instructions), and
# verified to round-trip via `nvdisasm -b SM75` (scripts/disasm-sass.sh).
# libdevice non-contamination confirmed (ADR 007 hygiene, 2026-06-27):
# exactly one function, zero __nv_/Attachment-A device code — GPL-3.0 clean.
#
# CUDA tooling is BUILD-TIME ONLY; these are inert dwords loaded into a
# program BO and launched via raw ioctl — the runtime stays pure-Cyrius.
#
# Turing instruction layout: each instruction is 128 bits = two
# little-endian u64 in memory order [opcode_word, control_word]. The
# control word carries the mandatory software-scoreboard fields (stall /
# yield / read+write barrier indices / wait mask) that ptxas already
# computed — the hard part, baked in by capture.
#
# store_deadbeef SASS (kernel: out[0] = 0xDEADBEEF):
#   MOV     R1, c[0x0][0x28]        ; stack pointer
#   MOV     R0, 0xdeadbeef          ; the constant
#   ULDC.64 UR4, c[0x0][0x160]      ; output ptr from constant bank (param @0x160)
#   STG.E.STRONG.GPU [UR4], R0      ; GPU-scope store (compiled via st.global.cg);
#                                   ; NOT .SYS — a system-scope store to a GART BO
#                                   ; HANGS (waits for a CPU<->GPU coherency ack
#                                   ; that never comes; HW-observed). NVK is GPU-scope too.
#   EXIT
#   BRA     0x50                    ; self-branch trap
#   NOP ; NOP                       ; pad to 128 bytes

var NV_SASS_STORE_DEADBEEF_BYTES  = 128;   # 8 instructions x 16 bytes
var NV_SASS_STORE_DEADBEEF_DWORDS = 16;    # 8 instructions x 2 u64

# Launch ABI (cuobjdump --dump-resource-usage) — the N4.2 QMD must reflect
# these exactly or the SASS reads garbage:
var NV_SASS_STORE_DEADBEEF_REGCOUNT   = 4;      # REGISTER_COUNT
var NV_SASS_STORE_DEADBEEF_SHMEM      = 0;      # SHARED_MEMORY_SIZE
var NV_SASS_STORE_DEADBEEF_PARAM_OFF  = 0x160;  # output ptr at c[0x0][0x160]
var NV_SASS_STORE_DEADBEEF_PARAM_SIZE = 8;      # one u64 pointer

# Write the store_deadbeef SM75 program into `dst` (caller-owned, must be
# >= NV_SASS_STORE_DEADBEEF_BYTES). Dwords are stored little-endian in
# memory order — byte-identical to the cubin .text.store_deadbeef section.
# Returns the byte count written (128).
fn native_nv_sass_store_deadbeef(dst): i64 {
    # MOV R1, c[0x0][0x28]
    store64(dst + 0,   0x00000a0000017a02);  store64(dst + 8,   0x000fe40000000f00);
    # MOV R0, 0xdeadbeef
    store64(dst + 16,  0xdeadbeef00007802);  store64(dst + 24,  0x000fe20000000f00);
    # ULDC.64 UR4, c[0x0][0x160]
    store64(dst + 32,  0x0000580000047ab9);  store64(dst + 40,  0x000fce0000000a00);
    # STG.E.STRONG.GPU [UR4], R0  (GPU scope; .SYS hangs on GART — see header)
    store64(dst + 48,  0x00000000ff007986);  store64(dst + 56,  0x000fe2000c114904);
    # EXIT
    store64(dst + 64,  0x000000000000794d);  store64(dst + 72,  0x000fea0003800000);
    # BRA 0x50
    store64(dst + 80,  0xfffffff000007947);  store64(dst + 88,  0x000fc0000383ffff);
    # NOP
    store64(dst + 96,  0x0000000000007918);  store64(dst + 104, 0x000fc00000000000);
    # NOP
    store64(dst + 112, 0x0000000000007918);  store64(dst + 120, 0x000fc00000000000);
    return NV_SASS_STORE_DEADBEEF_BYTES;
}

# ================================================================
# N6.2c — bound-texture sampling kernel (SM75)
# ================================================================
# sample_tex SASS (kernel: out[0] = packed_rgba8(tex2D(tex, texel 0,0))):
#   IMAD.MOV.U32 R1, RZ, RZ, c[0x0][0x28]   ; stack ptr
#   IMAD.MOV.U32 R2, RZ, RZ, -0x3e000000    ; coord (clamps to texel 0 on a 1x1)
#   CS2R R6, SRZ                            ; coord.y = 0
#   TEX.SCR.LL R4, R2, R6, R2, 0x0, 0x58, 2D ; BOUND sample: TIC index 0, TSC index 0x58
#   ULDC.64 UR4, c[0x0][0x168]              ; output ptr (ptxas param @ +0x168)
#   PRMT R3/R4 ...                          ; pack the 4 sampled bytes into one u32
#   STG.E.STRONG.GPU [UR4], R4              ; GPU-scope store (PATCHED from the
#                                           ; captured .SYS — .SYS hangs on a GART
#                                           ; output BO, exactly like store_deadbeef)
#   EXIT / BRA / NOP pad to 256 bytes
#
# Provenance: CUDA 13.3 `nvcc -arch=sm_75 -cubin store_tex.cu`, .text.sample_tex
# (256 B / 16 instrs) extracted; instruction 8's control word patched
# 0x..c10e904 (.SYS) -> 0x..c114904 (.STRONG.GPU); round-trips through
# `nvdisasm -b SM75` to STG.E.STRONG.GPU. The BOUND TEX names the TIC/TSC pool
# indices as immediates (the N6.2a finding) — so the sampling dispatch (N6.2c)
# writes mabda's TIC at pool index 0 and TSC at pool index 0x58.
var NV_SASS_SAMPLE_TEX_BYTES     = 256;   # 16 instructions x 16 bytes
var NV_SASS_SAMPLE_TEX_REGCOUNT  = 10;    # REGISTER_COUNT (cuobjdump)
var NV_SASS_SAMPLE_TEX_PARAM_OFF = 0x168; # output ptr at c[0x0][0x168]
var NV_SASS_SAMPLE_TEX_TIC_INDEX = 0x0;   # TEX immediate: texture-header index
var NV_SASS_SAMPLE_TEX_TSC_INDEX = 0x58;  # TEX immediate: sampler index

# Write the sample_tex SM75 program (STG patched to GPU scope) into `dst`
# (caller-owned, >= NV_SASS_SAMPLE_TEX_BYTES). Returns 256.
fn native_nv_sass_sample_tex(dst): i64 {
    # IMAD.MOV.U32 R1, RZ, RZ, c[0x0][0x28]
    store64(dst + 0,   0x00000a00ff017624);  store64(dst + 8,   0x000fe400078e00ff);
    # IMAD.MOV.U32 R2, RZ, RZ, -0x3e000000
    store64(dst + 16,  0xc2000000ff027424);  store64(dst + 24,  0x000fe200078e00ff);
    # CS2R R6, SRZ
    store64(dst + 32,  0x0000000000067805);  store64(dst + 40,  0x000fcc000001ff00);
    # TEX.SCR.LL R4, R2, R6, R2, 0x0, 0x58, 2D  (bound: TIC 0, TSC 0x58)
    store64(dst + 48,  0x3000580206027b60);  store64(dst + 56,  0x000f4200019e0f04);
    # ULDC.64 UR4, c[0x0][0x168]
    store64(dst + 64,  0x00005a0000047ab9);  store64(dst + 72,  0x000fe20000000a00);
    # PRMT R3, R2, 0x40, R3
    store64(dst + 80,  0x0000004002037816);  store64(dst + 88,  0x020fc80000000003);
    # PRMT R4, R3, 0x410, R4
    store64(dst + 96,  0x0000041003047816);  store64(dst + 104, 0x000fc80000000004);
    # PRMT R4, R4, 0x4210, R5
    store64(dst + 112, 0x0000421004047816);  store64(dst + 120, 0x000fd00000000005);
    # STG.E.STRONG.GPU [UR4], R4   (control word PATCHED from .SYS to .STRONG.GPU)
    store64(dst + 128, 0x00000004ff007986);  store64(dst + 136, 0x000fe2000c114904);
    # EXIT
    store64(dst + 144, 0x000000000000794d);  store64(dst + 152, 0x000fea0003800000);
    # BRA 0xa0
    store64(dst + 160, 0xfffffff000007947);  store64(dst + 168, 0x000fc0000383ffff);
    # NOP x5
    store64(dst + 176, 0x0000000000007918);  store64(dst + 184, 0x000fc00000000000);
    store64(dst + 192, 0x0000000000007918);  store64(dst + 200, 0x000fc00000000000);
    store64(dst + 208, 0x0000000000007918);  store64(dst + 216, 0x000fc00000000000);
    store64(dst + 224, 0x0000000000007918);  store64(dst + 232, 0x000fc00000000000);
    store64(dst + 240, 0x0000000000007918);  store64(dst + 248, 0x000fc00000000000);
    return NV_SASS_SAMPLE_TEX_BYTES;
}
