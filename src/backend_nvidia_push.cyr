# @internal — native NVIDIA backend, pushbuffer / method-stream builders
# backend_nvidia_push.cyr — the backend_native_pm4.cyr analogue for the
# v4.0 NVIDIA arc (Phase N4.1). Builds the Turing method/pushbuffer stream
# that EXEC submits: method headers + the compute dispatch (SET_OBJECT →
# SEND_PCAS).
#
# Turing dma-pusher method header (GF100+ form, verified against the NVK
# capture, N0.7c):
#   header = (op<<29) | (count<<16) | (subc<<13) | (mthd>>2)
#     op:    bits 31:29  (1=INCR, 3=NON_INCR, 4=INLINE/IMMD, 5=INCR_ONCE)
#     count: bits 28:16  (dword arg count; for INLINE this slot holds a
#                         13-bit immediate instead)
#     subc:  bits 15:13  (subchannel; NVK binds compute on subc 1)
#     mthd:  bits 12:0    (method byte-offset >> 2)
# Shifts are written as mul/div (the toolchain-safe idiom; see
# native_ioc_encode). All bring-up methods are < 0x1700 so mthd>>2 fits.

var NV_OP_INCR      = 1;
var NV_OP_NONINCR   = 3;
var NV_OP_INLINE    = 4;
var NV_OP_INCR_ONCE = 5;

# Compute class + the subchannel NVK binds it on (capture: subc 1).
var TURING_COMPUTE_A = 0xC5C0;
var NV_COMPUTE_SUBC  = 1;

# clc5c0 (TURING_COMPUTE_A) method byte-offsets. SET_OBJECT is the
# universal method 0; the SEND_PCAS pair was read directly from the NVK
# dispatch pushbuffer (N0.7c) and is the QMD-by-address launch (Open Q5:
# SEND_PCAS model, not inline-QMD).
var NVC5C0_SET_OBJECT            = 0x0000;
var NVC5C0_SEND_PCAS_A           = 0x02B4;   # arg = qmd_va >> 8
var NVC5C0_SEND_SIGNALING_PCAS_B = 0x02BC;   # INLINE imm = INVALIDATE|SCHEDULE
var NVC5C0_PCAS_INVALIDATE       = 0x1;
var NVC5C0_PCAS_SCHEDULE         = 0x2;

# Compute preamble: the shared/local-memory WINDOW bases for generic
# (STG.E) addressing, captured verbatim from NVK's channel init (the 0xC5C0
# subchannel ran exactly SET_OBJECT + these two before any dispatch). Each
# is a 2-dword method [0, base]. The window bases (0xfe000000 shared,
# 0xff000000 local) carve the generic address space: a generic address in
# [base, base+size) resolves to shared/local, everything else to GLOBAL.
# **These MUST be the captured non-zero bases** — setting them to 0 makes
# low global VAs collide with the local/shared apertures and STG.E faults
# "Invalid Address Space" (Xid 13), the bug that blocked the N4 gate.
var NVC5C0_SET_SHADER_SHARED_MEMORY_WINDOW = 0x02A0;   # [0, 0xfe000000]
var NVC5C0_SET_SHADER_LOCAL_MEMORY_WINDOW  = 0x07B0;   # [0, 0xff000000]
var NV_SHARED_MEMORY_WINDOW = 0xFE000000;
var NV_LOCAL_MEMORY_WINDOW  = 0xFF000000;

# Texture/sampler descriptor-pool binding (N6.2c sampling). Each is a
# 3-dword INCR run on the compute subchannel: A=ADDRESS_UPPER (pool VA bits
# 47:32), B=ADDRESS_LOWER (bits 31:0), C=MAXIMUM_INDEX (highest valid pool
# index; each entry is 32 bytes). The TEX instruction names the TIC/TSC pool
# index as an immediate (bound-texture model — N6.2a), so the pools must be
# bound before SEND_PCAS for a sampling dispatch. Offsets verified against
# the clc5c0 method map + the NVK queue-init capture (N6.2a).
var NVC5C0_SET_TEX_HEADER_POOL_A  = 0x1574;   # +0x1578 B (lower), +0x157C C (max)
var NVC5C0_SET_TEX_SAMPLER_POOL_A = 0x155C;   # +0x1560 B (lower), +0x1564 C (max)
# Pool max index = (64 KiB BO / 32-byte entry) - 1 = 2047. Covers TIC index 0
# and TSC index 0x58 (the SASS's TEX immediates); the SM only reads the named
# indices, so a whole-BO bound is harmless. Fits both the TIC MAXIMUM_INDEX
# field (22 bits) and the narrower TSC one (20 bits). MAXIMUM_INDEX = count-1.
var NV_TEX_POOL_MAX_INDEX = 0x7FF;

# Cache-invalidate methods (NO_WFI, INLINE imm 0 = LINES_ALL). NVK emits the
# texture-header / sampler invalidates right after binding each pool, and the
# SKED (compute-scheduler) invalidate at every compute cmdbuf begin. On a cold
# channel they are not strictly required, but they cannot hang and a warm
# cache line would otherwise yield a silent STALE texel — so the sampling
# dispatch emits all three (clc5c0; verified vs nvk_queue.c / nvk_cmd_dispatch.c).
var NVC5C0_INVALIDATE_TEXTURE_HEADER_CACHE_NO_WFI = 0x0244;
var NVC5C0_INVALIDATE_SAMPLER_CACHE_NO_WFI        = 0x1424;
var NVC5C0_INVALIDATE_SKED_CACHES                 = 0x0298;

# Shader-cache invalidate (NO_WFI, INLINE imm = a cache-select BITFIELD, not
# LINES_ALL): bit 0 = instruction, bit 4 = global data, bit 12 = CONSTANT.
# NVK emits { .constant = TRUE } whenever cbuf contents change under a live
# channel (nvk_cmd_dispatch.c); the cla0c0.h lineage and envytools' FLUSH
# @0x1698 (UCACHE=0x1000) agree on the encoding. mabda rewrites the c[0x0]
# param bank (the output pointer at +0x160) through the CPU mapping before
# EVERY dispatch, so without this the SM's constant cache can serve the
# PREVIOUS dispatch's output pointer — the 4.0.7 bigbo gate caught exactly
# that: a second dispatch with a new output VA silently stored through the
# stale pointer (no fault, wrong buffer). HW-proven fix on the TU116.
var NVC5C0_INVALIDATE_SHADER_CACHES_NO_WFI = 0x1698;
var NVC5C0_ISC_NO_WFI_CONSTANT             = 0x1000;

# Build a method header for an incrementing/non-incrementing/incr-once
# method run carrying `count` dword args. `mthd` is the method byte offset.
fn native_nv_method_header(op, subc, mthd, count): i64 {
    return (op * 0x20000000) | ((count & 0x1FFF) * 0x10000)
    | ((subc & 7) * 0x2000) | ((mthd / 4) & 0x1FFF);
}

# Build an INLINE (IMMD) method header: a single 13-bit immediate packed
# into the count slot (bits 28:16) — no separate arg dword follows. (Bit 12
# is load-bearing: CT_WRITE_RGBA = 0x1111 and the constant-cache invalidate
# select 0x1000 both use it.)
fn native_nv_method_inline(subc, mthd, imm): i64 {
    return (NV_OP_INLINE * 0x20000000) | ((imm & 0x1FFF) * 0x10000)
    | ((subc & 7) * 0x2000) | ((mthd / 4) & 0x1FFF);
}

# Stage the minimal compute-dispatch pushbuffer into `dst` (caller-owned).
# Sequence (matches the NVK capture shape; the per-channel shader-memory
# preamble that N4.3 distills from the captured init stream is prepended
# by the integration layer when required):
#   SET_OBJECT(0xC5C0)            on the compute subchannel
#   INVALIDATE_SHADER_CACHES_NO_WFI(CONSTANT)   (cbuf rewritten per dispatch)
#   SEND_PCAS_A(qmd_va >> 8)
#   SEND_SIGNALING_PCAS_B(INVALIDATE|SCHEDULE)
# Returns the byte count written (the EXEC push va_len).
fn native_nv_push_dispatch(dst, qmd_va): i64 {
    var n = 0;
    # SET_OBJECT = compute class
    store32(dst + n, native_nv_method_header(NV_OP_INCR, NV_COMPUTE_SUBC, NVC5C0_SET_OBJECT, 1));
    n = n + 4;
    store32(dst + n, TURING_COMPUTE_A);
    n = n + 4;
    # Generic-addressing windows (captured from NVK init): shared then local
    # memory window bases. Required, and MUST be the captured non-zero values
    # or global STG.E stores fault "Invalid Address Space".
    store32(dst + n, native_nv_method_header(NV_OP_INCR, NV_COMPUTE_SUBC, NVC5C0_SET_SHADER_SHARED_MEMORY_WINDOW, 2));
    n = n + 4;
    store32(dst + n, 0);
    n = n + 4;
    store32(dst + n, NV_SHARED_MEMORY_WINDOW);
    n = n + 4;
    store32(dst + n, native_nv_method_header(NV_OP_INCR, NV_COMPUTE_SUBC, NVC5C0_SET_SHADER_LOCAL_MEMORY_WINDOW, 2));
    n = n + 4;
    store32(dst + n, 0);
    n = n + 4;
    store32(dst + n, NV_LOCAL_MEMORY_WINDOW);
    n = n + 4;
    # Constant-cache invalidate: the c[0x0] param bank is rewritten through
    # the CPU mapping before every dispatch; a warm SM constant cache would
    # otherwise serve the previous dispatch's output pointer (silent store
    # through a stale VA — caught by the 4.0.7 bigbo deep-STG probe).
    store32(dst + n, native_nv_method_inline(NV_COMPUTE_SUBC,
    NVC5C0_INVALIDATE_SHADER_CACHES_NO_WFI, NVC5C0_ISC_NO_WFI_CONSTANT));
    n = n + 4;
    # SEND_PCAS_A = qmd_va >> 8 (QMD is 256-byte aligned)
    store32(dst + n, native_nv_method_header(NV_OP_INCR, NV_COMPUTE_SUBC, NVC5C0_SEND_PCAS_A, 1));
    n = n + 4;
    store32(dst + n, qmd_va / 0x100);
    n = n + 4;
    # SEND_SIGNALING_PCAS_B = INVALIDATE | SCHEDULE (INLINE immediate)
    store32(dst + n, native_nv_method_inline(NV_COMPUTE_SUBC, NVC5C0_SEND_SIGNALING_PCAS_B,
    NVC5C0_PCAS_INVALIDATE | NVC5C0_PCAS_SCHEDULE));
    n = n + 4;
    return n;
}

# Stage a texture-SAMPLING compute-dispatch pushbuffer into `dst`
# (caller-owned). Identical to native_nv_push_dispatch but binds the TIC/TSC
# descriptor pools (and invalidates their caches) before SEND_PCAS, so a
# bound-texture TEX shader can fetch from them. Emit order mirrors NVK
# (bind pool -> invalidate that cache; SKED invalidate before dispatch):
#   SET_OBJECT(0xC5C0)
#   SET_SHADER_SHARED/LOCAL_MEMORY_WINDOW            (generic addressing)
#   SET_TEX_HEADER_POOL  A/B/C (tic_pool_va, max)    -> INVALIDATE_TEX_HEADER
#   SET_TEX_SAMPLER_POOL A/B/C (tsc_pool_va, max)    -> INVALIDATE_SAMPLER
#   INVALIDATE_SKED_CACHES
#   SEND_PCAS_A(qmd_va >> 8) ; SEND_SIGNALING_PCAS_B(INVALIDATE|SCHEDULE)
# Pool VAs are written UNSHIFTED (A = va>>32, B = va low-32 via store32
# truncation). Returns the byte count written (the EXEC push va_len).
fn native_nv_push_dispatch_sample(dst, qmd_va, tic_pool_va, tsc_pool_va): i64 {
    var n = 0;
    # SET_OBJECT = compute class.
    store32(dst + n, native_nv_method_header(NV_OP_INCR, NV_COMPUTE_SUBC, NVC5C0_SET_OBJECT, 1));
    n = n + 4;
    store32(dst + n, TURING_COMPUTE_A);
    n = n + 4;
    # Generic-addressing windows (captured from NVK init) — required non-zero
    # bases or global STG.E faults "Invalid Address Space".
    store32(dst + n, native_nv_method_header(NV_OP_INCR, NV_COMPUTE_SUBC, NVC5C0_SET_SHADER_SHARED_MEMORY_WINDOW, 2));
    n = n + 4;
    store32(dst + n, 0);
    n = n + 4;
    store32(dst + n, NV_SHARED_MEMORY_WINDOW);
    n = n + 4;
    store32(dst + n, native_nv_method_header(NV_OP_INCR, NV_COMPUTE_SUBC, NVC5C0_SET_SHADER_LOCAL_MEMORY_WINDOW, 2));
    n = n + 4;
    store32(dst + n, 0);
    n = n + 4;
    store32(dst + n, NV_LOCAL_MEMORY_WINDOW);
    n = n + 4;
    # SET_TEX_HEADER_POOL A/B/C: pool VA (upper, lower) + MAXIMUM_INDEX.
    store32(dst + n, native_nv_method_header(NV_OP_INCR, NV_COMPUTE_SUBC, NVC5C0_SET_TEX_HEADER_POOL_A, 3));
    n = n + 4;
    store32(dst + n, (tic_pool_va / 0x100000000) & 0x1FFFF);   # A = ADDRESS_UPPER (47:32)
    n = n + 4;
    store32(dst + n, tic_pool_va);                             # B = ADDRESS_LOWER (31:0)
    n = n + 4;
    store32(dst + n, NV_TEX_POOL_MAX_INDEX);                   # C = MAXIMUM_INDEX
    n = n + 4;
    # Invalidate the texture-header cache (NO_WFI, LINES_ALL).
    store32(dst + n, native_nv_method_inline(NV_COMPUTE_SUBC, NVC5C0_INVALIDATE_TEXTURE_HEADER_CACHE_NO_WFI, 0));
    n = n + 4;
    # SET_TEX_SAMPLER_POOL A/B/C.
    store32(dst + n, native_nv_method_header(NV_OP_INCR, NV_COMPUTE_SUBC, NVC5C0_SET_TEX_SAMPLER_POOL_A, 3));
    n = n + 4;
    store32(dst + n, (tsc_pool_va / 0x100000000) & 0x1FFFF);
    n = n + 4;
    store32(dst + n, tsc_pool_va);
    n = n + 4;
    store32(dst + n, NV_TEX_POOL_MAX_INDEX);
    n = n + 4;
    # Invalidate the sampler cache (NO_WFI, LINES_ALL).
    store32(dst + n, native_nv_method_inline(NV_COMPUTE_SUBC, NVC5C0_INVALIDATE_SAMPLER_CACHE_NO_WFI, 0));
    n = n + 4;
    # Invalidate the SKED (compute-scheduler) caches — NVK does this at every
    # compute cmdbuf begin (Maxwell-B+; Turing qualifies).
    store32(dst + n, native_nv_method_inline(NV_COMPUTE_SUBC, NVC5C0_INVALIDATE_SKED_CACHES, 0));
    n = n + 4;
    # Constant-cache invalidate — same rationale as native_nv_push_dispatch
    # (the sampling param bank is CPU-rewritten per dispatch too).
    store32(dst + n, native_nv_method_inline(NV_COMPUTE_SUBC,
    NVC5C0_INVALIDATE_SHADER_CACHES_NO_WFI, NVC5C0_ISC_NO_WFI_CONSTANT));
    n = n + 4;
    # SEND_PCAS_A = qmd_va >> 8 (QMD is 256-byte aligned).
    store32(dst + n, native_nv_method_header(NV_OP_INCR, NV_COMPUTE_SUBC, NVC5C0_SEND_PCAS_A, 1));
    n = n + 4;
    store32(dst + n, qmd_va / 0x100);
    n = n + 4;
    # SEND_SIGNALING_PCAS_B = INVALIDATE | SCHEDULE (INLINE immediate).
    store32(dst + n, native_nv_method_inline(NV_COMPUTE_SUBC, NVC5C0_SEND_SIGNALING_PCAS_B,
    NVC5C0_PCAS_INVALIDATE | NVC5C0_PCAS_SCHEDULE));
    n = n + 4;
    return n;
}

# ================================================================
# N7.2 — clc597 (TURING_A 3D) draw-pushbuffer builder
# ================================================================
# The render analogue of native_nv_push_dispatch: builds the full Turing 3D
# method stream for a solid-color triangle into a LINEAR RGBA8 color target.
# Every offset/value is the verified design from the N7.2a capture decode —
# see docs/development/nvidia-n7-capture-notes.md (4-group adversarially
# verified vs clc597.h / NVK / nvc0 gallium / envytools). NVK issues the draw
# + clear through on-GPU MME macros mabda cannot use; this builder emits their
# DIRECT clc597 method equivalents.
#
# The 3D class binds on subchannel 0 (the NVK capture; compute is subc 1).
var TURING_A         = 0xC597;
var NV_GRAPHICS_SUBC = 0;

# clc597 method byte-offsets (mthd>>2 fits the 13-bit header field; all < 0x8000).
var NVC597_SET_SURFACE_CLIP_HORIZONTAL     = 0x0FF4;   # INCR2: H(X|W<<16), V(Y|H<<16)
var NVC597_SET_COLOR_TARGET_A              = 0x0800;   # INCR9 block (slot 0)
var NVC597_SET_COLOR_COMPRESSION           = 0x19E0;   # slot0 (IMMD)
var NVC597_SET_CT_SELECT                   = 0x121C;
var NVC597_SET_CT_WRITE                    = 0x1A00;   # slot0 RGBA write mask
var NVC597_SET_ZT_SELECT                   = 0x1538;
var NVC597_SET_VIEWPORT_SCALE_X            = 0x0A00;   # INCR6: scale xyz, offset xyz
var NVC597_SET_VIEWPORT_COORDINATE_SWIZZLE = 0x0A18;
var NVC597_SET_VIEWPORT_CLIP_HORIZONTAL    = 0x0C00;   # INCR4: H, V, MIN_Z, MAX_Z
var NVC597_SET_SCISSOR_ENABLE              = 0x0E00;   # INCR3: enable, H, V
var NVC597_SET_RASTER_ENABLE               = 0x037C;
var NVC597_OGL_SET_CULL                    = 0x1918;
var NVC597_OGL_SET_FRONT_FACE              = 0x191C;
var NVC597_SET_DEPTH_TEST                  = 0x12CC;
var NVC597_SET_DEPTH_WRITE                 = 0x12E8;
var NVC597_SET_STENCIL_TEST                = 0x1380;
var NVC597_SET_BLEND                       = 0x1360;   # slot0
var NVC597_SET_ANTI_ALIAS                  = 0x15D0;
var NVC597_SET_PIPELINE_SHADER             = 0x2000;   # +stage*0x40 (IMMD enable|type<<4)
var NVC597_SET_PIPELINE_REGISTER_COUNT     = 0x200C;   # +stage*0x40 (INCR2: count, binding)
var NVC597_SET_PIPELINE_PROGRAM_ADDRESS_A  = 0x2014;   # +stage*0x40 (INCR2: upper, lower)
var NVC597_SET_PRIMITIVE_TOPOLOGY_CONTROL  = 0x1948;
var NVC597_SET_PRIMITIVE_TOPOLOGY          = 0x1970;
var NVC597_SET_DA_PRIMITIVE_RESTART        = 0x1644;
var NVC597_SET_DRAW_CONTROL_A              = 0x0260;   # INCR2 with _B (instance_count)
var NVC597_DRAW_VERTEX_ARRAY_BEGIN_END_A   = 0x0270;   # INCR2 with _B (count) -> fires draw

# Field values.
var NVC597_PIPELINE_STAGE_STRIDE     = 0x40;
var NVC597_STAGE_VERTEX              = 1;   # SET_PIPELINE_SHADER index/type for VS
var NVC597_STAGE_PIXEL              = 5;    # ... and FS
var NVC597_SHADER_ENABLE            = 1;    # bit0
var NVC597_FORMAT_A8B8G8R8          = 0xD5; # RGBA8 (R at byte0)
var NVC597_COLOR_TARGET_MEMORY_PITCH = 0x1000;  # MEMORY LAYOUT_PITCH (bit12) — linear
var NVC597_TOPOLOGY_TRIANGLELIST    = 4;
var NVC597_TOPOLOGY_USE_SEPARATE    = 1;   # SET_PRIMITIVE_TOPOLOGY_CONTROL.OVERRIDE
var NVC597_CT_WRITE_RGBA            = 0x1111;   # R|G|B|A enable (bits 0/4/8/12)
var NVC597_DRAW_CONTROL_A_DEFAULT   = 0x200;    # INSTANCE_ITERATE_ENABLE (bit9)
var NVC597_FRONT_FACE_CCW           = 0x901;

# 128-aligned byte row pitch of a LAYOUT_PITCH RGBA8 color target `width`
# pixels wide — THE row stride the 3D engine stores at (SET_COLOR_TARGET
# WIDTH under LAYOUT_PITCH takes the byte pitch, which must be 128-aligned).
# Single source of truth: the RT create slot sizes the BO/VM_BIND span from
# this same value (pitch * height), so the raster can never store past the
# bound span — sizing from packed width*height*4 under-allocated every RT
# whose width % 32 != 0 (caught by the 4.0.7 adversarial review; the class
# predates 4.0.7 — a 1x8192 RT overran its 64 KiB BO by ~1 MiB of stride).
fn native_nv_rt_pitch_bytes(width): i64 {
    return (width * 4 + 127) / 128 * 128;
}

# NVIDIA draw-params struct (56 bytes) the builder reads. rt_va is the color
# target GPU VA; width/height are pixels (the byte row pitch is
# native_nv_rt_pitch_bytes — the same value the RT create slot sized the BO
# from); vs_va/fs_va point AT the 128-byte SPH of each program; vs/fs
# regcount = the SASS num_gprs.
var NV_DRAW_RT_VA       = 0;
var NV_DRAW_RT_WIDTH    = 8;
var NV_DRAW_RT_HEIGHT   = 16;
var NV_DRAW_VS_VA       = 24;
var NV_DRAW_FS_VA       = 32;
var NV_DRAW_VS_REGCOUNT = 40;
var NV_DRAW_FS_REGCOUNT = 48;
var NV_DRAW_PARAMS_SIZE = 56;

# Emit helpers (return the advanced byte offset) — keep the long draw builder
# readable. All on the 3D subchannel.
fn _nv_g_incr(dst, n, mthd, count): i64 {
    store32(dst + n, native_nv_method_header(NV_OP_INCR, NV_GRAPHICS_SUBC, mthd, count));
    return n + 4;
}
fn _nv_g_imm(dst, n, mthd, imm): i64 {
    store32(dst + n, native_nv_method_inline(NV_GRAPHICS_SUBC, mthd, imm));
    return n + 4;
}
fn _nv_g_arg(dst, n, val): i64 {
    store32(dst + n, val);
    return n + 4;
}

# Stage-relative pipeline method offset (SHADER / REGISTER_COUNT / PROGRAM_ADDRESS
# blocks all stride 0x40 per stage).
fn _nv_pipe_mthd(base, stage): i64 {
    return base + stage * NVC597_PIPELINE_STAGE_STRIDE;
}

# Build the full draw pushbuffer into `dst` (caller-owned, >= ~300 bytes) from
# the draw-params struct `dp` for a `vertex_count`-vertex non-indexed draw.
# Returns the byte length (the EXEC push va_len). Sequence: SET_OBJECT(0xC597)
# -> framebuffer (surface clip + linear color target + CT select/write) ->
# viewport/scissor -> raster/cull + disables -> VS/FS bind -> topology -> the
# fused Turing draw (vertex_count verts, instance 1). No clear (a fullscreen
# triangle covers every pixel); completion is the nouveau EXEC syncobj.
fn native_nv_push_draw(dst, dp, vertex_count): i64 {
    var rt_va  = load64(dp + NV_DRAW_RT_VA);
    var width  = load64(dp + NV_DRAW_RT_WIDTH);
    var height = load64(dp + NV_DRAW_RT_HEIGHT);
    var vs_va  = load64(dp + NV_DRAW_VS_VA);
    var fs_va  = load64(dp + NV_DRAW_FS_VA);
    var vs_rc  = load64(dp + NV_DRAW_VS_REGCOUNT);
    var fs_rc  = load64(dp + NV_DRAW_FS_REGCOUNT);

    var pitch    = native_nv_rt_pitch_bytes(width);   # row pitch in bytes (128-aligned)
    var clip_h   = width * 0x10000;                 # X=0 | WIDTH<<16
    var clip_v   = height * 0x10000;                # Y=0 | HEIGHT<<16
    var scale_x  = native_int_to_f32_bits(width / 2);
    var scale_y  = native_int_to_f32_bits(height / 2);
    var one_f32  = native_int_to_f32_bits(1);       # 1.0f (scale_z, max_z)

    var n = 0;
    # SET_OBJECT = 3D class on subc 0.
    n = _nv_g_incr(dst, n, NVC5C0_SET_OBJECT, 1);
    n = _nv_g_arg(dst, n, TURING_A);

    # --- framebuffer: surface clip + LINEAR color target + select/write ---
    n = _nv_g_incr(dst, n, NVC597_SET_SURFACE_CLIP_HORIZONTAL, 2);
    n = _nv_g_arg(dst, n, clip_h);
    n = _nv_g_arg(dst, n, clip_v);
    n = _nv_g_incr(dst, n, NVC597_SET_COLOR_TARGET_A, 9);
    n = _nv_g_arg(dst, n, (rt_va / 0x100000000) & 0xFF);     # ADDRESS_UPPER (VA 39:32)
    n = _nv_g_arg(dst, n, rt_va);                            # ADDRESS_LOWER (VA 31:0)
    n = _nv_g_arg(dst, n, pitch);                            # WIDTH = byte pitch (LAYOUT_PITCH)
    n = _nv_g_arg(dst, n, height);                           # HEIGHT = rows
    n = _nv_g_arg(dst, n, NVC597_FORMAT_A8B8G8R8);           # FORMAT
    n = _nv_g_arg(dst, n, NVC597_COLOR_TARGET_MEMORY_PITCH); # MEMORY = LAYOUT_PITCH
    n = _nv_g_arg(dst, n, 1);                                # THIRD_DIMENSION
    n = _nv_g_arg(dst, n, 0);                                # ARRAY_PITCH (0 for linear)
    n = _nv_g_arg(dst, n, 0);                                # LAYER
    n = _nv_g_imm(dst, n, NVC597_SET_COLOR_COMPRESSION, 0);  # off (required for linear)
    n = _nv_g_imm(dst, n, NVC597_SET_CT_SELECT, 1);          # 1 active RT, slot0
    n = _nv_g_imm(dst, n, NVC597_SET_CT_WRITE, NVC597_CT_WRITE_RGBA);  # RGBA write mask
    n = _nv_g_imm(dst, n, NVC597_SET_ZT_SELECT, 0);          # no depth target

    # --- viewport + scissor ---
    n = _nv_g_incr(dst, n, NVC597_SET_VIEWPORT_SCALE_X, 6);
    n = _nv_g_arg(dst, n, scale_x);   # SCALE_X = width/2
    n = _nv_g_arg(dst, n, scale_y);   # SCALE_Y = height/2
    n = _nv_g_arg(dst, n, one_f32);   # SCALE_Z = 1.0
    n = _nv_g_arg(dst, n, scale_x);   # OFFSET_X = width/2
    n = _nv_g_arg(dst, n, scale_y);   # OFFSET_Y = height/2
    n = _nv_g_arg(dst, n, 0);         # OFFSET_Z = 0
    n = _nv_g_incr(dst, n, NVC597_SET_VIEWPORT_COORDINATE_SWIZZLE, 1);
    n = _nv_g_arg(dst, n, 0x6420);    # identity swizzle (X,Y,Z,W)
    n = _nv_g_incr(dst, n, NVC597_SET_VIEWPORT_CLIP_HORIZONTAL, 4);
    n = _nv_g_arg(dst, n, clip_h);    # H = X|W<<16
    n = _nv_g_arg(dst, n, clip_v);    # V = Y|H<<16
    n = _nv_g_arg(dst, n, 0);         # MIN_Z = 0.0
    n = _nv_g_arg(dst, n, one_f32);   # MAX_Z = 1.0
    n = _nv_g_incr(dst, n, NVC597_SET_SCISSOR_ENABLE, 3);
    n = _nv_g_arg(dst, n, 1);         # enable
    n = _nv_g_arg(dst, n, clip_h);    # H = XMIN|XMAX<<16
    n = _nv_g_arg(dst, n, clip_v);    # V = YMIN|YMAX<<16

    # --- raster gate + cull + state disables (insurance on a bare channel) ---
    n = _nv_g_imm(dst, n, NVC597_SET_RASTER_ENABLE, 1);      # THE fragment gate
    n = _nv_g_imm(dst, n, NVC597_OGL_SET_CULL, 0);           # no back-face cull
    n = _nv_g_incr(dst, n, NVC597_OGL_SET_FRONT_FACE, 1);
    n = _nv_g_arg(dst, n, NVC597_FRONT_FACE_CCW);
    n = _nv_g_imm(dst, n, NVC597_SET_DEPTH_TEST, 0);
    n = _nv_g_imm(dst, n, NVC597_SET_DEPTH_WRITE, 0);
    n = _nv_g_imm(dst, n, NVC597_SET_STENCIL_TEST, 0);
    n = _nv_g_imm(dst, n, NVC597_SET_BLEND, 0);
    n = _nv_g_imm(dst, n, NVC597_SET_ANTI_ALIAS, 0);

    # --- VS (stage 1) + FS (stage 5) bind; program addr points AT the SPH ---
    n = _nv_g_imm(dst, n, _nv_pipe_mthd(NVC597_SET_PIPELINE_SHADER, NVC597_STAGE_VERTEX),
    NVC597_SHADER_ENABLE | NVC597_STAGE_VERTEX * 0x10);
    n = _nv_g_incr(dst, n, _nv_pipe_mthd(NVC597_SET_PIPELINE_PROGRAM_ADDRESS_A, NVC597_STAGE_VERTEX), 2);
    n = _nv_g_arg(dst, n, (vs_va / 0x100000000) & 0xFF);
    n = _nv_g_arg(dst, n, vs_va);
    n = _nv_g_incr(dst, n, _nv_pipe_mthd(NVC597_SET_PIPELINE_REGISTER_COUNT, NVC597_STAGE_VERTEX), 2);
    n = _nv_g_arg(dst, n, vs_rc);
    n = _nv_g_arg(dst, n, 0);         # BINDING group = VERTEX(0)
    # disable the in-between stages (TCS/TES/GS) for a reused channel.
    n = _nv_g_imm(dst, n, _nv_pipe_mthd(NVC597_SET_PIPELINE_SHADER, 2), 2 * 0x10);
    n = _nv_g_imm(dst, n, _nv_pipe_mthd(NVC597_SET_PIPELINE_SHADER, 3), 3 * 0x10);
    n = _nv_g_imm(dst, n, _nv_pipe_mthd(NVC597_SET_PIPELINE_SHADER, 4), 4 * 0x10);
    n = _nv_g_imm(dst, n, _nv_pipe_mthd(NVC597_SET_PIPELINE_SHADER, NVC597_STAGE_PIXEL),
    NVC597_SHADER_ENABLE | NVC597_STAGE_PIXEL * 0x10);
    n = _nv_g_incr(dst, n, _nv_pipe_mthd(NVC597_SET_PIPELINE_PROGRAM_ADDRESS_A, NVC597_STAGE_PIXEL), 2);
    n = _nv_g_arg(dst, n, (fs_va / 0x100000000) & 0xFF);
    n = _nv_g_arg(dst, n, fs_va);
    n = _nv_g_incr(dst, n, _nv_pipe_mthd(NVC597_SET_PIPELINE_REGISTER_COUNT, NVC597_STAGE_PIXEL), 2);
    n = _nv_g_arg(dst, n, fs_rc);
    n = _nv_g_arg(dst, n, 4);         # BINDING group = FRAGMENT(4)

    # --- topology + the fused Turing draw (replaces NVK's MME draw macro) ---
    # SET_PRIMITIVE_TOPOLOGY_CONTROL=SEPARATE is MUST-EMIT: NVK pins it at
    # channel init, it is NOT in the capture, and the fresh-context default is
    # undefined — without it 0x1970 is ignored and topology falls back to POINTS.
    n = _nv_g_imm(dst, n, NVC597_SET_PRIMITIVE_TOPOLOGY_CONTROL, NVC597_TOPOLOGY_USE_SEPARATE);
    n = _nv_g_imm(dst, n, NVC597_SET_PRIMITIVE_TOPOLOGY, NVC597_TOPOLOGY_TRIANGLELIST);
    n = _nv_g_imm(dst, n, NVC597_SET_DA_PRIMITIVE_RESTART, 0);
    n = _nv_g_incr(dst, n, NVC597_SET_DRAW_CONTROL_A, 2);
    n = _nv_g_arg(dst, n, NVC597_DRAW_CONTROL_A_DEFAULT);   # DRAW_CONTROL_A
    n = _nv_g_arg(dst, n, 1);                               # DRAW_CONTROL_B = instance_count
    n = _nv_g_incr(dst, n, NVC597_DRAW_VERTEX_ARRAY_BEGIN_END_A, 2);
    n = _nv_g_arg(dst, n, 0);                               # BEGIN_END_A = first_vertex
    n = _nv_g_arg(dst, n, vertex_count);                    # BEGIN_END_B = vertex_count -> fires the draw
    return n;
}
