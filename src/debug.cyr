# @public — stable API surface (survives the v3.0 backend swap)
# debug.cyr — GPU debug labels and marker groups
# Ported from mabda/src/debug.rs
#
# Explicit push/pop instead of RAII DebugScope. Each call takes a raw wgpu
# encoder handle (WGPUCommandEncoder / WGPURenderPassEncoder /
# WGPUComputePassEncoder) and a NUL-terminated label, and routes through launcher
# slot 80 (wgpu_shim_debug_op, v4.3.0). Before 4.3.0 they were no-op stubs: the
# wgpu*DebugGroup entry points take the label as a WGPUStringView BY VALUE, which
# needs a shim, and adding one waited on a coordinated launcher revision.
#
# Returns 0; GPU_ERR_FFI_SYMBOL with a pre-4.3.0 launcher (nothing is called,
# so a consumer that has not rebuilt its launcher keeps running); GPU_ERR_OTHER
# for a null encoder. render_graph.cyr's rg_execute wraps every node in one of
# these groups, so GPU profilers (RenderDoc / RGP / PIX) show the graph's nodes.

# Command encoder
fn debug_push(encoder, label): i64 {
    return wgpu_debug_op(WGPU_DEBUG_TARGET_ENCODER, encoder, WGPU_DEBUG_OP_PUSH, label);
}

fn debug_pop(encoder): i64 {
    return wgpu_debug_op(WGPU_DEBUG_TARGET_ENCODER, encoder, WGPU_DEBUG_OP_POP, 0);
}

fn debug_marker(encoder, label): i64 {
    return wgpu_debug_op(WGPU_DEBUG_TARGET_ENCODER, encoder, WGPU_DEBUG_OP_MARKER, label);
}

# Render pass
fn debug_render_push(pass, label): i64 {
    return wgpu_debug_op(WGPU_DEBUG_TARGET_RENDER, pass, WGPU_DEBUG_OP_PUSH, label);
}

fn debug_render_pop(pass): i64 {
    return wgpu_debug_op(WGPU_DEBUG_TARGET_RENDER, pass, WGPU_DEBUG_OP_POP, 0);
}

fn debug_render_marker(pass, label): i64 {
    return wgpu_debug_op(WGPU_DEBUG_TARGET_RENDER, pass, WGPU_DEBUG_OP_MARKER, label);
}

# Compute pass
fn debug_compute_push(pass, label): i64 {
    return wgpu_debug_op(WGPU_DEBUG_TARGET_COMPUTE, pass, WGPU_DEBUG_OP_PUSH, label);
}

fn debug_compute_pop(pass): i64 {
    return wgpu_debug_op(WGPU_DEBUG_TARGET_COMPUTE, pass, WGPU_DEBUG_OP_POP, 0);
}

fn debug_compute_marker(pass, label): i64 {
    return wgpu_debug_op(WGPU_DEBUG_TARGET_COMPUTE, pass, WGPU_DEBUG_OP_MARKER, label);
}
