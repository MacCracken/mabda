# @public — stable API surface (survives the v3.0 backend swap)
# debug.cyr — GPU debug labels and marker groups
# Ported from mabda/src/debug.rs
#
# Explicit push/pop instead of RAII DebugScope.
# All functions are FFI wrappers — require wgpu function table.

# Debug group push/pop for command encoder
# wgpuCommandEncoderPushDebugGroup(encoder, label) — not yet in fn table
