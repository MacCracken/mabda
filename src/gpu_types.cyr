# @public — the render tier's constant names (v4.3.0, MB1)
# gpu_types.cyr — public names for every constant a gpu_* call takes
#
# Before 4.3.0 the public tier took constants defined only in @internal files:
# gpu_buffer_create's usage was WGPU_BUFFER_USAGE_*, gpu_sampler_create took
# NATIVE_SAMP_*, and nothing named a topology, a vertex format or a bind type
# (soorat's probe P6). These are the names consumers use.
#
# Values are the WebGPU numbers (webgpu.h v29, deps/wgpu-native) wherever WebGPU
# defines the concept: a bit set (usage, stage, write mask) or an enum (vertex
# format, topology, compare, ...). The wgpu backend passes them through
# unchanged; the native backends map the ones they support. mabda-defined values
# (binding kinds, blend presets, the gpu_sampler_create aliases) are marked so.
# tests/tcyr/render_tier.tcyr pins every value.

# ================================================================
# Buffer usage — bits for gpu_buffer_create(ctx, size, usage)
# ================================================================
const GPU_BUFFER_USAGE_MAP_READ    = 0x0001;
const GPU_BUFFER_USAGE_MAP_WRITE   = 0x0002;
const GPU_BUFFER_USAGE_COPY_SRC    = 0x0004;
const GPU_BUFFER_USAGE_COPY_DST    = 0x0008;
const GPU_BUFFER_USAGE_INDEX       = 0x0010;
const GPU_BUFFER_USAGE_VERTEX      = 0x0020;
const GPU_BUFFER_USAGE_UNIFORM     = 0x0040;
const GPU_BUFFER_USAGE_STORAGE     = 0x0080;
const GPU_BUFFER_USAGE_INDIRECT    = 0x0100;

# ================================================================
# Shader stages — visibility bits for bind group layout entries
# ================================================================
const GPU_STAGE_VERTEX = 0x1;
const GPU_STAGE_FRAGMENT = 0x2;
const GPU_STAGE_COMPUTE  = 0x4;

# ================================================================
# Index formats — gpu_render_pass_set_index_buffer
# ================================================================
const GPU_INDEX_UINT16 = 1;
const GPU_INDEX_UINT32 = 2;

# ================================================================
# Vertex attribute formats — gpu_pipeline_desc_vertex_attribute
# ================================================================
const GPU_VERTEX_UINT8X2 = 0x02;
const GPU_VERTEX_UINT8X4 = 0x03;
const GPU_VERTEX_SINT8X2 = 0x05;
const GPU_VERTEX_SINT8X4 = 0x06;
const GPU_VERTEX_UNORM8X2  = 0x08;
const GPU_VERTEX_UNORM8X4  = 0x09;
const GPU_VERTEX_SNORM8X2  = 0x0B;
const GPU_VERTEX_SNORM8X4  = 0x0C;
const GPU_VERTEX_UINT16X2  = 0x0E;
const GPU_VERTEX_UINT16X4  = 0x0F;
const GPU_VERTEX_SINT16X2  = 0x11;
const GPU_VERTEX_SINT16X4  = 0x12;
const GPU_VERTEX_UNORM16X2 = 0x14;
const GPU_VERTEX_UNORM16X4 = 0x15;
const GPU_VERTEX_SNORM16X2 = 0x17;
const GPU_VERTEX_SNORM16X4 = 0x18;
const GPU_VERTEX_FLOAT16X2 = 0x1A;
const GPU_VERTEX_FLOAT16X4 = 0x1B;
const GPU_VERTEX_FLOAT32 = 0x1C;
const GPU_VERTEX_FLOAT32X2 = 0x1D;
const GPU_VERTEX_FLOAT32X3 = 0x1E;
const GPU_VERTEX_FLOAT32X4 = 0x1F;
const GPU_VERTEX_UINT32  = 0x20;
const GPU_VERTEX_UINT32X2  = 0x21;
const GPU_VERTEX_UINT32X3  = 0x22;
const GPU_VERTEX_UINT32X4  = 0x23;
const GPU_VERTEX_SINT32  = 0x24;
const GPU_VERTEX_SINT32X2  = 0x25;
const GPU_VERTEX_SINT32X3  = 0x26;
const GPU_VERTEX_SINT32X4  = 0x27;

# Byte size of one attribute of `fmt`; 0 for an unknown format.
fn gpu_vertex_format_size(fmt): i64 {
    if (fmt == GPU_VERTEX_FLOAT32)   { return 4; }
    if (fmt == GPU_VERTEX_UINT32)    { return 4; }
    if (fmt == GPU_VERTEX_SINT32)    { return 4; }
    if (fmt == GPU_VERTEX_FLOAT32X2) { return 8; }
    if (fmt == GPU_VERTEX_UINT32X2)  { return 8; }
    if (fmt == GPU_VERTEX_SINT32X2)  { return 8; }
    if (fmt == GPU_VERTEX_FLOAT32X3) { return 12; }
    if (fmt == GPU_VERTEX_UINT32X3)  { return 12; }
    if (fmt == GPU_VERTEX_SINT32X3)  { return 12; }
    if (fmt == GPU_VERTEX_FLOAT32X4) { return 16; }
    if (fmt == GPU_VERTEX_UINT32X4)  { return 16; }
    if (fmt == GPU_VERTEX_SINT32X4)  { return 16; }
    if (fmt == GPU_VERTEX_UINT8X2)   { return 2; }
    if (fmt == GPU_VERTEX_SINT8X2)   { return 2; }
    if (fmt == GPU_VERTEX_UNORM8X2)  { return 2; }
    if (fmt == GPU_VERTEX_SNORM8X2)  { return 2; }
    if (fmt == GPU_VERTEX_UINT8X4)   { return 4; }
    if (fmt == GPU_VERTEX_SINT8X4)   { return 4; }
    if (fmt == GPU_VERTEX_UNORM8X4)  { return 4; }
    if (fmt == GPU_VERTEX_SNORM8X4)  { return 4; }
    if (fmt == GPU_VERTEX_UINT16X2)  { return 4; }
    if (fmt == GPU_VERTEX_SINT16X2)  { return 4; }
    if (fmt == GPU_VERTEX_UNORM16X2) { return 4; }
    if (fmt == GPU_VERTEX_SNORM16X2) { return 4; }
    if (fmt == GPU_VERTEX_FLOAT16X2) { return 4; }
    if (fmt == GPU_VERTEX_UINT16X4)  { return 8; }
    if (fmt == GPU_VERTEX_SINT16X4)  { return 8; }
    if (fmt == GPU_VERTEX_UNORM16X4) { return 8; }
    if (fmt == GPU_VERTEX_SNORM16X4) { return 8; }
    if (fmt == GPU_VERTEX_FLOAT16X4) { return 8; }
    return 0;
}

# Vertex buffer step mode.
const GPU_STEP_VERTEX = 1;
const GPU_STEP_INSTANCE = 2;

# Vertex layout presets (mabda-defined) for gpu_pipeline_desc_vertex_preset — the
# fixed vertex types (ADR 003), field for field Rust mabda 1.0's vertex.rs:
#   2D          32 B: position f32x2 @0 (loc 0), tex_coords f32x2 @8 (1), color f32x4 @16 (2)
#   3D          48 B: position f32x3 @0 (0), normal f32x3 @12 (1), tex_coords f32x2 @24 (2),
#                     color f32x4 @32 (3)
#   SKINNED_3D  96 B: the 3D fields, then tangent f32x4 @48 (4), joints u32x4 @64 (5),
#                     weights f32x4 @80 (6)
#   LINE        28 B: position f32x3 @0 (0), color f32x4 @12 (1)
const GPU_VERTEX_LAYOUT_2D       = 1;
const GPU_VERTEX_LAYOUT_3D       = 2;
const GPU_VERTEX_LAYOUT_SKINNED_3D = 3;
const GPU_VERTEX_LAYOUT_LINE     = 4;

# ================================================================
# Primitive state
# ================================================================
const GPU_TOPOLOGY_POINT_LIST   = 1;
const GPU_TOPOLOGY_LINE_LIST    = 2;
const GPU_TOPOLOGY_LINE_STRIP   = 3;
const GPU_TOPOLOGY_TRIANGLE_LIST  = 4;
const GPU_TOPOLOGY_TRIANGLE_STRIP = 5;

const GPU_CULL_NONE  = 1;
const GPU_CULL_FRONT = 2;
const GPU_CULL_BACK  = 3;

const GPU_FRONT_CCW = 1;
const GPU_FRONT_CW  = 2;

# ================================================================
# Blending — per colour target
# ================================================================
const GPU_BLEND_FACTOR_ZERO              = 0x01;
const GPU_BLEND_FACTOR_ONE               = 0x02;
const GPU_BLEND_FACTOR_SRC               = 0x03;
const GPU_BLEND_FACTOR_ONE_MINUS_SRC     = 0x04;
const GPU_BLEND_FACTOR_SRC_ALPHA         = 0x05;
const GPU_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA = 0x06;
const GPU_BLEND_FACTOR_DST               = 0x07;
const GPU_BLEND_FACTOR_ONE_MINUS_DST     = 0x08;
const GPU_BLEND_FACTOR_DST_ALPHA         = 0x09;
const GPU_BLEND_FACTOR_ONE_MINUS_DST_ALPHA = 0x0A;
const GPU_BLEND_FACTOR_SRC_ALPHA_SATURATED = 0x0B;
const GPU_BLEND_FACTOR_CONSTANT          = 0x0C;
const GPU_BLEND_FACTOR_ONE_MINUS_CONSTANT  = 0x0D;

const GPU_BLEND_OP_ADD            = 1;
const GPU_BLEND_OP_SUBTRACT       = 2;
const GPU_BLEND_OP_REVERSE_SUBTRACT = 3;
const GPU_BLEND_OP_MIN            = 4;
const GPU_BLEND_OP_MAX            = 5;

# Blend presets (mabda-defined) for gpu_pipeline_desc_target_blend:
#   NONE          — no blending (the source replaces the target)
#   ALPHA         — colour: src*srcA + dst*(1-srcA); alpha: src + dst*(1-srcA)
#   PREMULTIPLIED — colour and alpha: src + dst*(1-srcA)
#   ADDITIVE      — colour and alpha: src + dst
const GPU_BLEND_NONE        = 0;
const GPU_BLEND_ALPHA       = 1;
const GPU_BLEND_PREMULTIPLIED = 2;
const GPU_BLEND_ADDITIVE    = 3;

const GPU_WRITE_RED = 0x1;
const GPU_WRITE_GREEN = 0x2;
const GPU_WRITE_BLUE  = 0x4;
const GPU_WRITE_ALPHA = 0x8;
const GPU_WRITE_ALL = 0xF;

# ================================================================
# Compare functions — comparison samplers (and MB2's depth test)
# ================================================================
const GPU_COMPARE_NONE        = 0;   # not a comparison sampler
const GPU_COMPARE_NEVER       = 1;
const GPU_COMPARE_LESS        = 2;
const GPU_COMPARE_EQUAL       = 3;
const GPU_COMPARE_LESS_EQUAL  = 4;
const GPU_COMPARE_GREATER     = 5;
const GPU_COMPARE_NOT_EQUAL   = 6;
const GPU_COMPARE_GREATER_EQUAL = 7;
const GPU_COMPARE_ALWAYS      = 8;

# ================================================================
# Sampler objects — gpu_sampler_object_create
# ================================================================
const GPU_FILTER_NEAREST = 1;
const GPU_FILTER_LINEAR  = 2;

const GPU_ADDRESS_CLAMP  = 1;   # clamp to edge
const GPU_ADDRESS_REPEAT = 2;
const GPU_ADDRESS_MIRROR = 3;   # mirror repeat

# gpu_sampler_create(ctx, filter, addr) — the older sampler-intent call
# (mabda-defined values; the same numbers as its native NATIVE_SAMP_* inputs).
const GPU_SAMPLER_FILTER_POINT  = 0;
const GPU_SAMPLER_FILTER_BILINEAR = 1;
const GPU_SAMPLER_ADDR_CLAMP    = 0;
const GPU_SAMPLER_ADDR_WRAP     = 1;

# ================================================================
# Bind group layout entries — gpu_bgl_* (src/gpu_bind.cyr)
# ================================================================
# Binding kinds (mabda-defined).
const GPU_BINDING_UNIFORM         = 1;
const GPU_BINDING_STORAGE         = 2;   # read-write storage buffer
const GPU_BINDING_STORAGE_READ_ONLY = 3;
const GPU_BINDING_TEXTURE         = 4;
const GPU_BINDING_SAMPLER         = 5;

# Texture sample types (what the shader's texture_* declaration samples as).
const GPU_SAMPLE_FLOAT            = 2;   # texture_2d<f32>, filterable
const GPU_SAMPLE_UNFILTERABLE_FLOAT = 3;
const GPU_SAMPLE_DEPTH            = 4;   # texture_depth_2d
const GPU_SAMPLE_SINT             = 5;
const GPU_SAMPLE_UINT             = 6;

# Texture view dimensions.
const GPU_VIEW_2D       = 2;
const GPU_VIEW_2D_ARRAY = 3;
const GPU_VIEW_CUBE     = 4;
const GPU_VIEW_CUBE_ARRAY = 5;
const GPU_VIEW_3D       = 6;

# Sampler binding types.
const GPU_SAMPLER_FILTERING   = 2;   # sampler (with a filterable texture)
const GPU_SAMPLER_NON_FILTERING = 3;
const GPU_SAMPLER_COMPARISON  = 4;   # sampler_comparison
