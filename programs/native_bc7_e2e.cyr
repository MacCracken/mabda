# programs/native_bc7_e2e.cyr — 4.5.0: BC7 decode and encode checked against the Cezanne's
# texture unit.
#
# BC7 decoding is exact integer math by the spec (unlike BC1's interpolation), so the hardware
# sampler is an independent BC7 decoder. A 64x64 BC7 texture (256 blocks) is sampled with
# point filtering through the image_sample fragment shader into an RGBA8 render target, and
# EVERY texel is compared with mabda's CPU decode (_bc7_decode_block).
#   A. random blocks: 32 of each mode 0..7, every field random. One mismatch means a wrong
#      table entry or a misread field.
#   B. the CPU encoder (mabda_bc7_encode) on a 64x64 image of four quadrants: a gradient,
#      RGB noise, an alpha gradient and 3-pixel colour cells. The hardware must decode the
#      encoder's blocks to exactly what the CPU decode gives, across the modes the encoder
#      chose (it prints them, with the squared error against the source).
#
# Exit codes: 0 pass; 1 ctx; 2 vs; 3 fs; 4 tex create; 5 upload; 6 rt; 7 sampler / pipeline;
#   8 pass begin; 9 bind; 10 draw; 11 a texel differs.
include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}
fn print_hex32(v): i64 {
    var digits = "0123456789ABCDEF";
    var buf[10];
    store8(&buf + 0, 48);
    store8(&buf + 1, 120);
    var i = 0;
    while (i < 8) {
        store8(&buf + 2 + i, load8(digits + ((v >> ((7 - i) * 4)) & 0xF)));
        i = i + 1;
    }
    syscall(1, 1, &buf, 10);
    return 0;
}

var g_rng = 0x9E3779B97F4A7C15;
fn rng_byte(): i64 {
    g_rng = (g_rng * 6364136223846793005 + 1442695040888963407) & 0xFFFFFFFFFFFFFFFF;
    return (g_rng >> 33) & 0xFF;
}

# 256 random blocks; block k is mode k % 8 (m zero bits, a one, then random bits).
fn fill_random(blocks): i64 {
    var k = 0;
    while (k < 256) {
        var blk = blocks + k * 16;
        var i = 0;
        while (i < 16) { store8(blk + i, rng_byte()); i = i + 1; }
        var m = k % 8;
        var b0 = load8(blk) & 0xFF;
        # clear bits 0..m, then set bit m
        var keep = 0xFF - ((1 << (m + 1)) - 1);
        store8(blk, (b0 & keep) | (1 << m));
        k = k + 1;
    }
    return 0;
}

# The phase B image: four 32x32 quadrants.
fn fill_image(img): i64 {
    var y = 0;
    while (y < 64) {
        var x = 0;
        while (x < 64) {
            var r = 0;
            var g = 0;
            var b = 0;
            var a = 255;
            if (x < 32) {
                if (y < 32) { r = x * 8; g = y * 8; b = (x + y) * 4; }
                if (y >= 32) { r = x * 8; g = 128; b = (y - 32) * 8; a = (x + y - 32) * 4; }
            }
            if (x >= 32) {
                if (y < 32) { r = rng_byte(); g = rng_byte(); b = rng_byte(); }
                if (y >= 32) {
                    var cell = (x / 3) * 7 + (y / 3) * 13;
                    r = cell * 37;
                    g = cell * 91;
                    b = cell * 53 + 40;
                }
            }
            store32(img + (y * 64 + x) * 4, (r & 0xFF) | ((g & 0xFF) << 8) | ((b & 0xFF) << 16) | ((a & 0xFF) << 24));
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

# Sample the 64x64 BC7 `blocks` on the GPU and compare every texel with the CPU decode.
# Mismatches are counted per mode into `per_mode` (8 i64) and in total into *bad_out.
# Returns 0, or an exit code.
fn sample_compare(ctx, rt, samp, pipe, blocks, per_mode, label, bad_out): i64 {
    var tex = gpu_texture_create_2d_sampleable(ctx, 64, 64, MABDA_TEXFMT_BC7);
    if (tex == 0) { print_cstr("FAIL: tex create\n"); return 4; }
    if (gpu_texture_write(ctx, tex, blocks, 256 * 16) != 0) {
        print_cstr("FAIL: upload\n"); gpu_texture_release(ctx, tex); return 5; }
    var rt_addr = load64(rt + NATIVE_RT_FIELD_ADDR);
    memset(rt_addr, 0x55, 64 * 64 * 4);
    var clear = color_new(F64_0, F64_0, F64_0, F64_1);
    var pass = gpu_render_pass_begin(ctx, rt, clear);
    if (pass == 0) { print_cstr("FAIL: pass begin\n"); gpu_texture_release(ctx, tex); return 8; }
    if (gpu_render_pass_bind_texture(ctx, pass, tex, samp) != 0) {
        print_cstr("FAIL: bind\n");
        gpu_render_pass_end(ctx, pass);
        gpu_texture_release(ctx, tex);
        return 9;
    }
    var rc = gpu_render_pass_draw(ctx, pass, pipe, 3, 1);
    gpu_render_pass_end(ctx, pass);
    gpu_texture_release(ctx, tex);
    if (rc != 0) { print_cstr("FAIL: draw\n"); return 10; }
    memset(per_mode, 0, 64);
    var dec[64];
    var shown = 0;
    var bad = 0;
    var k = 0;
    while (k < 256) {
        var m = _bc7_decode_block(blocks + k * 16, &dec);
        var bx = k % 16;
        var by = k / 16;
        var t = 0;
        while (t < 16) {
            var x = bx * 4 + (t % 4);
            var y = by * 4 + (t / 4);
            var got = load32(rt_addr + (y * 64 + x) * 4);
            var want = load32(&dec + t * 4);
            if (got != want) {
                bad = bad + 1;
                if (m < 8) { store64(per_mode + m * 8, load64(per_mode + m * 8) + 1); }
                if (shown < 6) {
                    print_cstr("  "); print_cstr(label); print_cstr(" mode "); print_i64(m);
                    print_cstr(" block "); print_i64(k); print_cstr(" texel "); print_i64(t);
                    print_cstr(": hw "); print_hex32(got); print_cstr(" cpu "); print_hex32(want);
                    print_cstr("\n");
                    shown = shown + 1;
                }
            }
            t = t + 1;
        }
        k = k + 1;
    }
    store64(bad_out, bad);
    return 0;
}

fn main(): i64 {
    alloc_init();
    color_init();
    _bc7_init();
    print_cstr("mabda BC7 decode vs the Cezanne's texture unit (4.5.0)\n");
    print_cstr("------------------------------------------------------\n");
    NATIVE_TEXCOMP_SUPPORTED = MABDA_TEXCOMP_BC;
    var ct, cv = gpu_context_new_native();
    if (is_err_result(ct) == 1) { print_cstr("FAIL: ctx\n"); return 1; }
    var ctx = cv;
    var fd = native_ctx_fd(ctx);
    var vs_bo[16];
    if (native_bo_create_gtt(fd, 4096, &vs_bo) != 0) { print_cstr("FAIL: vs bo\n"); return 2; }
    var vs_handle = load64(&vs_bo + 0);
    var vs_addr = load64(&vs_bo + 8);
    memset(vs_addr, 0, 4096);
    native_gfx9_shader_fullscreen_triangle_vs(vs_addr, 0);
    var vs_va = 0xFFFF800100000000;
    if (native_gem_va_map(fd, vs_handle, vs_va, 4096, _NATIVE_PERM_SHADER) != 0) {
        print_cstr("FAIL: vs va\n");
        return 2;
    }
    var vs_mod[16];
    native_buf_pair_write(&vs_mod, vs_handle, vs_va);
    var fs_bo[16];
    if (native_bo_create_gtt(fd, 4096, &fs_bo) != 0) { print_cstr("FAIL: fs bo\n"); return 3; }
    var fs_handle = load64(&fs_bo + 0);
    var fs_addr = load64(&fs_bo + 8);
    memset(fs_addr, 0, 4096);
    native_gfx9_shader_textured_sample_fs(fs_addr, 0);
    var fs_va = 0xFFFF800100001000;
    if (native_gem_va_map(fd, fs_handle, fs_va, 4096, _NATIVE_PERM_SHADER) != 0) {
        print_cstr("FAIL: fs va\n");
        return 3;
    }
    var fs_mod[16];
    native_buf_pair_write(&fs_mod, fs_handle, fs_va);
    var rt = gpu_render_target_create_2d_rgba8(ctx, 64, 64);
    if (rt == 0) { print_cstr("FAIL: rt\n"); return 6; }
    var samp = gpu_sampler_create(ctx, NATIVE_SAMP_FILTER_POINT, NATIVE_SAMP_ADDR_CLAMP);
    var pipe = gpu_render_pipeline_create(ctx, &vs_mod, &fs_mod, 0);
    if (samp == 0) { print_cstr("FAIL: sampler\n"); return 7; }
    if (pipe == 0) { print_cstr("FAIL: pipeline\n"); return 7; }

    var blocks = alloc(256 * 16);
    var per_mode[64];
    fill_random(blocks);
    var badc[8];
    var sr = sample_compare(ctx, rt, samp, pipe, blocks, &per_mode, "A", &badc);
    if (sr != 0) { return sr; }
    var bad = load64(&badc);
    print_cstr("A. random blocks, 32 per mode, 4096 texels: mismatches per mode 0..7 =");
    var m = 0;
    while (m < 8) { print_cstr(" "); print_i64(load64(&per_mode + m * 8)); m = m + 1; }
    print_cstr("\n");
    var rc = 0;
    if (bad != 0) { print_cstr("FAIL: A: the CPU decode differs from the hardware\n"); rc = 11; }
    if (bad == 0) { print_cstr("PASS: A: every texel of every mode matches the hardware\n"); }

    # B. the encoder's blocks
    var img = alloc(64 * 64 * 4);
    fill_image(img);
    var n = mabda_bc7_encode(img, 64, 64, 256, blocks, 256 * 16);
    if (n != 256 * 16) { print_cstr("FAIL: B: encode returned "); print_i64(n); print_cstr("\n"); return 11; }
    var br = sample_compare(ctx, rt, samp, pipe, blocks, &per_mode, "B", &badc);
    if (br != 0) { return br; }
    var bad_b = load64(&badc);
    var used[64];
    memset(&used, 0, 64);
    var dec[64];
    var se = 0;
    var k = 0;
    while (k < 256) {
        var m = _bc7_decode_block(blocks + k * 16, &dec);
        if (m < 8) { store64(&used + m * 8, load64(&used + m * 8) + 1); }
        var t = 0;
        while (t < 16) {
            var v = load32(&dec + t * 4);
            var sv = load32(img + (((k / 16) * 4 + t / 4) * 64 + (k % 16) * 4 + t % 4) * 4);
            var c = 0;
            while (c < 4) {
                var d = ((v >> (c * 8)) & 0xFF) - ((sv >> (c * 8)) & 0xFF);
                se = se + d * d;
                c = c + 1;
            }
            t = t + 1;
        }
        k = k + 1;
    }
    print_cstr("B. encoded image: blocks per mode 0..7 =");
    var m2 = 0;
    while (m2 < 8) { print_cstr(" "); print_i64(load64(&used + m2 * 8)); m2 = m2 + 1; }
    print_cstr("; squared RGBA error vs the source "); print_i64(se); print_cstr("\n");
    if (bad_b != 0) { print_cstr("FAIL: B: the hardware decodes the encoder's blocks differently\n"); rc = 11; }
    if (bad_b == 0) { print_cstr("PASS: B: the hardware decodes every encoded texel as the CPU does\n"); }

    gpu_render_pipeline_release(ctx, pipe);
    gpu_render_target_release(ctx, rt);
    native_gem_va_unmap(fd, fs_handle, fs_va, 4096);
    native_bo_release_gtt(fd, fs_handle, fs_addr, 4096);
    native_gem_va_unmap(fd, vs_handle, vs_va, 4096);
    native_bo_release_gtt(fd, vs_handle, vs_addr, 4096);
    gpu_context_release(ctx);
    if (rc == 0) { print_cstr("OK — BC7 matches the Cezanne's texture unit\n"); }
    return rc;
}

var exit_code = main();
syscall(60, exit_code);
