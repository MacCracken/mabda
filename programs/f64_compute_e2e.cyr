# programs/f64_compute_e2e.cyr — v3.2 Phase F.8: wgpu f64 via WGPUNativeFeature_ShaderF64.
#
# Proves the wgpu HALF of Phase F's f64 story that CAN be proven on any wgpu adapter with f64:
#   (1) the device advertises f64 — WGPUNativeFeature_ShaderF64 (0x0003001D) is enabled (the
#       F.8b launcher edit, gated by the adapter's Vulkan shaderFloat64), and
#   (2) an f64 SPIR-V compute module (OpCapability Float64 + OpTypeFloat 64 + an f64 OpFMul)
#       CREATES through the ORDINARY gpu_shader_module_create_spirv path — naga's SPIR-V
#       frontend accepts f64 once ShaderF64 is on. NO passthrough is needed: F.8b corrected the
#       F.2/proposal premise that "passthrough is the only f64 route" (it isn't). Passthrough
#       (F.8a) was a separate general raw-SPIR-V escape hatch; step (3) exercises it only where
#       gpu_wgpu_spirv_passthrough_supported says it exists. On the pinned wgpu-native v29.0.1.1
#       it never does: the SpirvShaderPassthrough device feature was deleted upstream (see
#       src/backend_wgpu.cyr), so step (3) reports the skip on every adapter.
#
# It also proves the HONEST capability posture: gpu_caps_wgpu_shader_f64(device) == 0. wgpu
# compute DISPATCH is a v3.0 stub (_backend_wgpu_compute_dispatch returns GPU_ERR_OTHER), so
# f64 — like any compute — cannot run END-TO-END on wgpu yet. Per the Phase F contract a
# consumer (attn11) must hard-fail rather than silently fall back to f32, so the cap reports 0
# even though the module creates (the M.6b mipmap-generate posture). When wgpu compute lands,
# flip MABDA_WGPU_COMPUTE and the cap becomes the ShaderF64 device bit.
#
# HW-verified on RADV (Cezanne) and NVK; nothing below is adapter-specific.
# Linked with deps/wgpu_main.c via `make test-f64-compute-e2e` (needs wgpu-native + a GPU).
# Exit: 0 = ShaderF64 enabled + f64 module created + caps honest (or SKIP: no GPU); 2 = ShaderF64
#       missing / module-create failed; 3 = caps not honest (reported f64 on a stubbed path).

include "src/lib.cyr"

var _gpu_preinit = 0;
var _gpu_ctx = 0;

# Write tag + msg + "\n" to fd as ONE write; the byte count comes from strlen, never a
# hand-counted literal (4.1.3 verification found miscounted lengths in the sibling programs).
fn _e2e_line(fd, tag, msg): i64 {
    var line[256];
    var tl = strlen(tag);
    var ml = strlen(msg);
    if (tl > 64) { tl = 64; }
    if (tl + ml > 255) { ml = 255 - tl; }
    memcpy(&line, tag, tl);
    memcpy(&line + tl, msg, ml);
    store8(&line + tl + ml, 10);
    syscall(1, fd, &line, tl + ml + 1);
    return 0;
}
fn _fail(msg, code): i64 { _e2e_line(2, "FAIL: ", msg); return code; }
fn _pass(msg): i64 { _e2e_line(1, "PASS: ", msg); return 0; }

fn mabda_main(fn_table_ptr, preinit_ptr): i64 {
    color_init();
    wgpu_ffi_init_table(fn_table_ptr);
    _gpu_preinit = preinit_ptr;
    var res_tag, res = gpu_context_from_preinit(_gpu_preinit);
    if (is_err_result(res_tag) == 1) { _e2e_line(2, "SKIP: ", "no GPU available"); return 0; }
    _gpu_ctx = res;
    var device = gpu_ctx_device(_gpu_ctx);
    _pass("GPU context created");

    # (1) the device must advertise f64 — the authoritative WGPUNativeFeature_ShaderF64 bit
    #     (requested by the F.8b launcher edit, gated by the adapter's Vulkan shaderFloat64).
    if (gpu_wgpu_shader_f64_supported(device) == 0) {
        return _fail("ShaderF64 not enabled (adapter lacks f64, or launcher missing F.8b?)", 2);
    }
    _pass("WGPUNativeFeature_ShaderF64 enabled (device supports f64)");

    # (2) the milestone: an f64 SPIR-V compute module (OpCapability Float64) CREATES through the
    #     ordinary gpu_shader_module_create_spirv path — naga's SPIR-V frontend accepts f64 once
    #     ShaderF64 is on. No passthrough needed (that was the corrected F.2/proposal premise).
    var buf[224];
    var n = _wgpu_f64_probe_spirv(&buf);
    var smod = gpu_shader_module_create_spirv(_gpu_ctx, &buf, n);
    if (smod == 0) {
        return _fail("f64 SPIR-V module create (standard naga path) returned 0", 2);
    }
    _pass("f64 SPIR-V module created via standard naga path (OpCapability Float64)");

    # (3) the raw-SPIR-V passthrough escape hatch (F.8a) — orthogonal to f64. Only attempted when
    #     the gate reports it (calling the passthrough creator without the feature faults loudly in
    #     wgpu). The pinned wgpu-native v29.0.1.1 has no passthrough device feature at all, so the
    #     gate is 0 by construction there — the INFO says exactly that, not "this adapter lacks it".
    if (gpu_wgpu_spirv_passthrough_supported(device) != 0) {
        var pm = wgpu_device_create_shader_module_spirv_passthrough(device, &buf, n / 4);
        if (pm == 0) { return _fail("passthrough create returned 0 despite support", 2); }
        wgpu_shader_module_release(pm);
        _pass("raw-SPIR-V passthrough escape hatch also created the module");
    } else {
        _e2e_line(1, "INFO: ",
          "raw-SPIR-V passthrough skipped: wgpu-native v29.0.1.1 has no passthrough device feature");
    }

    # (4) honest capability: 0 because wgpu compute dispatch is a v3.0 stub (M.6b) — no f64
    #     end-to-end on wgpu yet, so no silent f32 fallback path for a consumer to trip over.
    if (gpu_caps_wgpu_shader_f64(device) != 0) {
        return _fail("gpu_caps_wgpu_shader_f64 must be 0 while wgpu compute is stubbed", 3);
    }
    _pass("gpu_caps_wgpu_shader_f64 == 0 (honest: dispatch stubbed, no silent f32 fallback)");

    _e2e_line(1, "OK - ",
      "wgpu f64 (ShaderF64 + naga SPIR-V) module-create verified on this adapter; caps honest (M.6b)");
    return 0;
}
