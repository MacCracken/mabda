# programs/native_spirv_f64_layernorm_e2e.cyr — v3.2 Phase F.9: the attn11 f64 smoke through the
# PUBLIC API on Cezanne. After the F.7 flip (MABDA_NATIVE_F64=1) opened the public f64 SPIR-V path.
#
# A real attn11-style kernel — out[i] = (x[i] - mean[i]) / sqrt(var[i] + eps), eps=1e-5 — exercising
# FSub + FAdd + an f64 OpConstant + OpExtInst Sqrt + OpFDiv, compiled + dispatched ENTIRELY through
# the public API (gpu_shader_module_create_spirv -> gpu_compute_dispatch), exactly as a consumer
# (attn11) would. Proves the f64 toolkit works end-to-end via the public surface, not just internal
# gfx9_compile. Result BIT-EXACT vs the step-by-step in-process f64 reference (math.sqrt).
# Linked native via `make test-native-spirv-f64-layernorm-e2e`. Exit: 0 pass; 2 create; 9 dispatch; 11 mismatch.

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 { var b[32]; memset(&b, 0, 32); var l = fmt_int_buf(n, &b); syscall(1, 1, &b, l); return 0; }
fn print_hex64(v): i64 {
    var digits = "0123456789ABCDEF"; var b[18]; store8(&b + 0, 48); store8(&b + 1, 120);
    var i = 0; while (i < 16) { store8(&b + 2 + i, load8(digits + ((v >> ((15 - i) * 4)) & 0xF))); i = i + 1; }
    syscall(1, 1, &b, 18); return 0;
}

var N_LANES = 8;

fn fill_x(x): i64 {
    store64(x + 0 , 0x3FF0000000000000);
    store64(x + 8 , 0x4014000000000000);
    store64(x + 16, 0xC000000000000000);
    store64(x + 24, 0x4024000000000000);
    store64(x + 32, 0x3FE0000000000000);
    store64(x + 40, 0x4008000000000000);
    store64(x + 48, 0xC01C000000000000);
    store64(x + 56, 0x4059000000000000);
    return 0;
}
fn fill_mean(mean): i64 {
    store64(mean + 0 , 0x4000000000000000);
    store64(mean + 8 , 0x4008000000000000);
    store64(mean + 16, 0x0000000000000000);
    store64(mean + 24, 0x4024000000000000);
    store64(mean + 32, 0x3FF8000000000000);
    store64(mean + 40, 0x4000000000000000);
    store64(mean + 48, 0xC014000000000000);
    store64(mean + 56, 0x4049000000000000);
    return 0;
}
fn fill_var(var0): i64 {
    store64(var0 +0 , 0x3FF0000000000000);
    store64(var0 +8 , 0x4010000000000000);
    store64(var0 +16, 0x3FD0000000000000);
    store64(var0 +24, 0x4000000000000000);
    store64(var0 +32, 0x3F847AE147AE147B);
    store64(var0 +40, 0x4022000000000000);
    store64(var0 +48, 0x3FF8000000000000);
    store64(var0 +56, 0x40A3880000000000);
    return 0;
}
fn fill_wants(want): i64 {
    store64(want + 0 , 0xBFEFFFF583AA62F6);   # (1-2)/sqrt(1+eps)=-0.999995
    store64(want + 8 , 0x3FEFFFFD60E9A15A);   # (5-3)/sqrt(4+eps)=0.999999
    store64(want + 16, 0xC00FFFD60EE76424);   # (-2-0)/sqrt(0.25+eps)=-3.99992
    store64(want + 24, 0x0000000000000000);   # (10-10)/sqrt(2+eps)=0
    store64(want + 32, 0xC023FD7121907982);   # (0.5-1.5)/sqrt(0.01+eps)=-9.995
    store64(want + 40, 0x3FD555548E7E0F45);   # (3-2)/sqrt(9+eps)=0.333333
    store64(want + 48, 0xBFFA20B7BAE09754);   # (-7--5)/sqrt(1.5+eps)=-1.63299
    store64(want + 56, 0x3FEFFFFFFEED1F41);   # (100-50)/sqrt(2500+eps)=1
    return 0;
}

