fn main(): i64 {
    alloc_init();
    print_cstr("mabda f64 LAYERNORM smoke via the PUBLIC API (F.9) — post F.7 flip, on Cezanne\n");
    print_cstr("kernel: out[i] = (x[i] - mean[i]) / sqrt(var[i] + 1e-5)\n\n");
    var spv[900]; var n = build_kernel(&spv);
    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) { print_cstr("FAIL: ctx\n"); return 3; }
    var ctx = payload(ctx_res); var fd = native_ctx_fd(ctx);
    # PUBLIC API: compile f64 SPIR-V -> shader module (the F.7 gate is now open).
    var shmod = gpu_shader_module_create_spirv(ctx, &spv, n);
    if (shmod == 0) { print_cstr("FAIL: gpu_shader_module_create_spirv returned 0 (f64 gate?)\n"); return 2; }
    print_cstr("shader module created (bindings="); print_i64(load64(shmod + NATIVE_SHMOD_NBIND)); print_cstr(")\n\n");
    var xv[64]; var mv[64]; var vv[64]; var wv[64];
    fill_x(&xv); fill_mean(&mv); fill_var(&vv); fill_wants(&wv);
    var xb[16]; var mb[16]; var vb[16]; var ob[16];
    if (native_bo_create_gtt(fd, 4096, &xb) != 0) { return 5; }
    if (native_bo_create_gtt(fd, 4096, &mb) != 0) { return 5; }
    if (native_bo_create_gtt(fd, 4096, &vb) != 0) { return 5; }
    if (native_bo_create_gtt(fd, 4096, &ob) != 0) { return 5; }
    var xh = load64(&xb + 0); var xm = load64(&xb + 8);
    var mh = load64(&mb + 0); var mm = load64(&mb + 8);
    var vh = load64(&vb + 0); var vm = load64(&vb + 8);
    var oh = load64(&ob + 0); var om = load64(&ob + 8);
    var i = 0;
    while (i < N_LANES) {
        store64(xm + i*8, load64(&xv + i*8));
        store64(mm + i*8, load64(&mv + i*8));
        store64(vm + i*8, load64(&vv + i*8));
        store64(om + i*8, 0);
        i = i + 1;
    }
    var xva = 0xFFFF800100400000; var mva = 0xFFFF800100800000;
    var vva = 0xFFFF800100C00000; var ova = 0xFFFF800101000000;
    if (native_gem_va_map(fd, xh, xva, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }
    if (native_gem_va_map(fd, mh, mva, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }
    if (native_gem_va_map(fd, vh, vva, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }
    if (native_gem_va_map(fd, oh, ova, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }
    # Public binding array: [count, (handle, va) per binding].
    var bp[72];
    store64(&bp + 0, 4);
    store64(&bp + 8, xh);  store64(&bp + 16, xva);
    store64(&bp + 24, mh); store64(&bp + 32, mva);
    store64(&bp + 40, vh); store64(&bp + 48, vva);
    store64(&bp + 56, oh); store64(&bp + 64, ova);
    # PUBLIC API: dispatch (grid 1x1x1; LocalSize 8 from the module).
    var rc = gpu_compute_dispatch(ctx, shmod, 1, 1, 1, &bp);
    if (rc != 0) { print_cstr("FAIL: gpu_compute_dispatch rc="); print_i64(rc); print_cstr("\n"); return 9; }
    print_cstr("  lane :      got (hex)        |  want = (x-mean)/sqrt(var+eps)\n");
    var ok = 1; i = 0;
    while (i < N_LANES) {
        var got = load64(om + i*8); var ref = load64(&wv + i*8);
        print_cstr("  ["); print_i64(i); print_cstr("]  : "); print_hex64(got); print_cstr("  |  "); print_hex64(ref);
        if (got != ref) { print_cstr("   <-- MISMATCH"); ok = 0; }
        print_cstr("\n"); i = i + 1;
    }
    gpu_shader_module_release(ctx, shmod);
    gpu_context_release(ctx);
    if (ok == 0) { print_cstr("\nFAIL: f64 layernorm not bit-exact via the public API\n"); return 11; }
    print_cstr("\nOK — f64 layernorm BIT-EXACT via the PUBLIC API on Cezanne (F.9; the F.7 flip works)\n");
    return 0;
}
