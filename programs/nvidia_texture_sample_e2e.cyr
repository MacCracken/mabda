# programs/nvidia_texture_sample_e2e.cyr — v4.0 Phase N6.2c-ii
#
# Pure-Cyrius NVIDIA native GPU texture *sampling* on nouveau: bind a
# TIC/TSC descriptor pool, run a Turing bound-texture TEX compute dispatch
# that samples a 1x1 RGBA8 texel (NEAREST/CLAMP) and stores the packed RGBA8
# to a buffer, read it back on the CPU. The sampled-texel half of N6.4 — the
# native analogue of a shader `texture()` fetch, proven end-to-end without
# libdrm/GFX/CUDA. Masterless on /dev/dri/renderD128.
#
# This is the dispatch counterpart to the N6.2c-i sampling SASS
# (native_nv_sass_sample_tex). It differs from the N4 store dispatch
# (programs/nvidia_compute_store.cyr) only by:
#   - a TIC pool BO (the texture header at index 0, pointing at the texel BO)
#   - a TSC pool BO (the NEAREST/CLAMP sampler at index 0x58 — the SASS names
#     these two pool indices as TEX immediates: the bound-texture model)
#   - SET_TEX_HEADER_POOL / SET_TEX_SAMPLER_POOL in the dispatch pushbuffer
#     (native_nv_push_dispatch_sample) to bind those pools
#   - the QMD program = the sampling SASS, regcount 10, cbuf0 out ptr @ +0x168
#   - a UINT TIC (native_nv_tic_build_2d_rgba8_uint): the SASS reads raw
#     integer texels (TEX -> PRMT, no float denormalize), so the texture
#     header must be UINT, not the UNORM used by NVK's normalized-float probe.
#
# The texel (0x11,0x22,0x33,0x44) = u32 LE 0x44332211 is R=0x11,G=0x22,
# B=0x33,A=0x44 under the A8B8G8R8 layout; tex2D<uchar4> packs x|y<<8|z<<16|
# w<<24 with the X=R/Y=G/Z=B/W=A swizzle -> readback 0x44332211. The SASS
# coord (-32.0f, normalized) clamps to texel 0 on the 1x1, so the sampled
# value is exactly the stored texel.
#
# Two samples prove the result genuinely TRACKS the texture (not a constant):
# the same dispatch samples texel A (0x44332211) then texel B (0x8899AABB)
# from a second texture VA (a fresh VA, so no texture-data-cache staleness —
# only the TIC at pool index 0 is repointed and the header cache re-invalidated
# by the pushbuffer). Both readbacks must match the stored texel.
#
# Not in CI (hardware-dependent). Run via `make test-nvidia-texture-sample-e2e`.
#
# Exit codes:
#   0 success    1 open    2 VM_INIT    3 CHANNEL_ALLOC    4 NVIF create
#   5 BO create/bind    6 syncobj    7 EXEC    8 wait/timeout
#   9 readback A != 0x44332211    10 readback B != 0x8899AABB

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}

# One sampling dispatch on an already-built channel/QMD/pushbuffer/pools: clear
# the output, EXEC, wait on an ABSOLUTE deadline (now+1s — the N4 blocker was a
# relative timeout), return the readback word. Exits(6/7/8) on syncobj/EXEC/wait
# failure.
fn sample_once(fd, chid, va_push, push_len, out_cpu): i64 {
    store32(out_cpu, 0);
    var so[8];
    memset(&so, 0, 8);
    if (native_syncobj_create(fd, &so) != 0) { print_cstr("FAIL: syncobj_create\n"); syscall(60, 6); }
    var sh = load32(&so);
    var deadline = _time_now_ns() + 1000000000;
    var rc = native_nv_exec_submit(fd, chid, va_push, push_len, sh);
    if (rc != 0) {
        print_cstr("FAIL: EXEC (errno "); print_i64(0 - rc); print_cstr(")\n");
        native_syncobj_destroy(fd, sh); syscall(60, 7);
    }
    rc = native_syncobj_wait(fd, sh, deadline);
    native_syncobj_destroy(fd, sh);
    var got = load32(out_cpu);
    print_cstr("  wait rc="); print_i64(rc);
    print_cstr(" readback="); print_i64(got); print_cstr("\n");
    if (rc != 0) { print_cstr("FAIL: wait/timeout\n"); syscall(60, 8); }
    return got;
}

# Create a 64 KiB BO in `dom` and VM_BIND it at `va` (64 KiB range — the
# big-page mapping the N4 gate HW-proved). Returns the GEM handle; writes the
# CPU mapping to *cpu_out. Exits(5) on failure.
fn mk_bo(fd, va, dom, cpu_out): i64 {
    var bo[16];
    var rc = native_nv_bo_create_dom(fd, 0x10000, dom, &bo);
    if (rc != 0) {
        print_cstr("FAIL: GEM_NEW (errno "); print_i64(0 - rc); print_cstr(")\n");
        syscall(60, 5);
    }
    var handle = load64(&bo + 0);
    store64(cpu_out, load64(&bo + 8));
    rc = native_nv_vm_bind_map(fd, handle, va, 0x10000);
    if (rc != 0) {
        print_cstr("FAIL: VM_BIND (errno "); print_i64(0 - rc); print_cstr(")\n");
        syscall(60, 5);
    }
    return handle;
}

fn main(): i64 {
    alloc_init();
    print_cstr("mabda NVIDIA texture SAMPLE e2e (v4.0 Phase N6.2c-ii)\n");
    print_cstr("----------------------------------------------------\n");

    var fd = native_open_render_node();
    if (fd < 0) { print_cstr("FAIL: open\n"); return 1; }

    if (native_nv_vm_init(fd, NOUVEAU_VM_KERNEL_RESERVATION_START,
        NOUVEAU_VM_KERNEL_RESERVATION_SIZE) != 0) {
        print_cstr("FAIL: VM_INIT\n"); sys_close(fd); return 2;
    }

    var chan[88];
    if (native_nv_channel_alloc(fd, &chan) != 0) { print_cstr("FAIL: CHANNEL_ALLOC\n"); sys_close(fd); return 3; }
    var chid = native_nv_channel_id(&chan);
    print_cstr("chid="); print_i64(chid); print_cstr("\n");

    var obj_handle = native_nv_object_handle(chid, TURING_COMPUTE_A);
    var rc = native_nv_object_new(fd, chid, obj_handle, TURING_COMPUTE_A);
    if (rc != 0) {
        print_cstr("FAIL: NVIF create 0xC5C0 (errno "); print_i64(0 - rc); print_cstr(")\n");
        sys_close(fd); return 4;
    }
    print_cstr("NVIF compute object 0xC5C0 created\n");

    # GPU VAs — low, 64 KiB-aligned, distinct, all below the shared/local
    # windows (0xfe000000/0xff000000) so generic STG resolves to GLOBAL.
    var va_prog     = 0x100000;
    var va_qmd      = 0x200000;
    var va_param    = 0x300000;
    var va_out      = 0x400000;
    var va_push     = 0x500000;
    var va_tex_a    = 0x600000;   # 1x1 texel A (first sample)
    var va_tic_pool = 0x700000;   # TIC pool (header at index 0)
    var va_tsc_pool = 0x800000;   # TSC pool (sampler at index 0x58)
    var va_tex_b    = 0x900000;   # 1x1 texel B (second sample, fresh VA)

    var prog_cpu     = 0;
    var qmd_cpu      = 0;
    var param_cpu    = 0;
    var out_cpu      = 0;
    var push_cpu     = 0;
    var tex_a_cpu    = 0;
    var tic_pool_cpu = 0;
    var tsc_pool_cpu = 0;
    var tex_b_cpu    = 0;
    mk_bo(fd, va_prog,     NOUVEAU_GEM_DOMAIN_HOST, &prog_cpu);
    mk_bo(fd, va_qmd,      NOUVEAU_GEM_DOMAIN_HOST, &qmd_cpu);
    mk_bo(fd, va_param,    NOUVEAU_GEM_DOMAIN_HOST, &param_cpu);
    # Output BO: pure GART (SM-written), matching NVK + the N4 store kernel.
    mk_bo(fd, va_out,      NOUVEAU_GEM_DOMAIN_GART, &out_cpu);
    mk_bo(fd, va_push,     NOUVEAU_GEM_DOMAIN_HOST, &push_cpu);
    mk_bo(fd, va_tex_a,    NOUVEAU_GEM_DOMAIN_HOST, &tex_a_cpu);
    mk_bo(fd, va_tic_pool, NOUVEAU_GEM_DOMAIN_HOST, &tic_pool_cpu);
    mk_bo(fd, va_tsc_pool, NOUVEAU_GEM_DOMAIN_HOST, &tsc_pool_cpu);
    mk_bo(fd, va_tex_b,    NOUVEAU_GEM_DOMAIN_HOST, &tex_b_cpu);
    print_cstr("9 BOs created + VM_BIND'd\n");

    # Texels: bytes R,G,B,A as u32 LE. A=0x44332211, B=0x8899AABB (all bytes
    # distinct between the two, so a wrong/constant fetch can't pass both).
    store32(tex_a_cpu, 0x44332211);
    store32(tex_b_cpu, 0x8899AABB);

    # TIC pool: a UINT RGBA8 1x1 header at index 0, pointing at texel A's BO.
    native_nv_tic_build_2d_rgba8_uint(tic_pool_cpu, va_tex_a, 1, 1);
    # TSC pool: a NEAREST/CLAMP sampler at index 0x58 (the SASS's TSC immediate).
    native_nv_tsc_build_nearest_clamp(tsc_pool_cpu + 0x58 * 32);

    # Program BO <- captured SM75 sampling SASS.
    native_nv_sass_sample_tex(prog_cpu);
    # Param bank: output pointer at c[0x0]+0x168 (sample_tex ptxas param ABI).
    store64(param_cpu + NV_SASS_SAMPLE_TEX_PARAM_OFF, va_out);
    # QMD: program addr, regcount=10, cbuf0 = param bank (size 0x200).
    native_nv_qmd_build(qmd_cpu, va_prog, NV_SASS_SAMPLE_TEX_REGCOUNT, va_param, 0x200);
    # Sampling pushbuffer: SET_OBJECT + memory windows + SET_TEX_HEADER_POOL +
    # SET_TEX_SAMPLER_POOL + cache invalidates + SEND_PCAS(qmd_va).
    var push_len = native_nv_push_dispatch_sample(push_cpu, va_qmd, va_tic_pool, va_tsc_pool);

    # Sample 1: texel A.
    var got_a = sample_once(fd, chid, va_push, push_len, out_cpu);
    print_cstr("sample A = "); print_i64(got_a);
    if (got_a == 0x44332211) { print_cstr("  (0x44332211 OK)\n"); }
    else { print_cstr("  FAIL (expected 1144201745 = 0x44332211)\n"); sys_close(fd); return 9; }

    # Sample 2: repoint TIC index 0 at texel B's (fresh) VA — the readback must
    # now TRACK to B, proving the fetch genuinely reads the bound texture. The
    # pushbuffer re-invalidates the texture-header cache, so the rewritten TIC
    # is re-read; va_tex_b is a fresh VA so its data is cold (no data-cache flush
    # needed).
    native_nv_tic_build_2d_rgba8_uint(tic_pool_cpu, va_tex_b, 1, 1);
    var got_b = sample_once(fd, chid, va_push, push_len, out_cpu);
    print_cstr("sample B = "); print_i64(got_b);
    if (got_b == 0x8899AABB) { print_cstr("  (0x8899AABB OK)\n"); }
    else { print_cstr("  FAIL (expected 2291772091 = 0x8899AABB)\n"); sys_close(fd); return 10; }

    native_nv_channel_free(fd, chid);
    sys_close(fd);
    print_cstr("OK: GPU sampled two distinct 1x1 RGBA8 texels via a pure-Cyrius TEX dispatch\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
