# programs/native_spirv_fclamp_e2e.cyr — N.8b-4: a GLSL.std.450 FClamp compiled
# in-tree and dispatched on Cezanne, proving clamp via v_med3_f32 (median-of-3).
#
# Kernel: `out[gid.x] = clamp(float(gid.x), 1.0, 4.0);`. LocalSize 8, one workgroup.
# FClamp(x, lo, hi) = median(x, lo, hi) when lo<=hi → a single v_med3_f32 (VOP3 3-src).
# 1.0/4.0 are inline floats (242/246). clamp(i,1,4) is exact, so the f32 bits check.
#
# Seed out[0..7] = 0xBAADF00D. Verify out[i] = f32(clamp(i,1,4)) = {1,1,2,3,4,4,4,4}.0.
# Exit: 0 = correct; 2 = compile; 3/5 = setup; 9 = dispatch; 11 = mismatch.

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}
fn print_hex(n): i64 {
    var buf[16];
    var d = 0;
    while (d < 8) {
        var nib = (n >> ((7 - d) * 4)) & 0xF;
        var ch = 48 + nib;
        if (nib > 9) { ch = 87 + nib; }
        store8(&buf + d, ch);
        d = d + 1;
    }
    syscall(1, 1, &buf, 8);
    return 0;
}

# SPIR-V (id-bound 24, 532 bytes). %1 = GLSL.std.450; %15 GlobalInvocationId; %16 out;
# %13 = const float 1.0, %14 = const float 4.0.
fn build_fclamp_kernel(buf): i64 {
    store32(buf + 0, 0x07230203);
    store32(buf + 4, 0x00010300);
    store32(buf + 8, 0);
    store32(buf + 12, 24);
    store32(buf + 16, 0);
    store32(buf + 20, (2 << 16) | 17);   # OpCapability Shader
    store32(buf + 24, 1);
    store32(buf + 28, (6 << 16) | 11);   # OpExtInstImport %1 "GLSL.std.450"
    store32(buf + 32, 1);
    store32(buf + 36, 0x4C534C47);
    store32(buf + 40, 0x6474732E);
    store32(buf + 44, 0x3035342E);
    store32(buf + 48, 0);
    store32(buf + 52, (3 << 16) | 14);   # OpMemoryModel Logical GLSL450
    store32(buf + 56, 0);
    store32(buf + 60, 1);
    store32(buf + 64, (6 << 16) | 15);   # OpEntryPoint GLCompute %17 "main" %15
    store32(buf + 68, 5);
    store32(buf + 72, 17);
    store32(buf + 76, 0x6E69616D);
    store32(buf + 80, 0);
    store32(buf + 84, 15);
    store32(buf + 88, (6 << 16) | 16);   # OpExecutionMode %17 LocalSize 8 1 1
    store32(buf + 92, 17);
    store32(buf + 96, 17);
    store32(buf + 100, 8);
    store32(buf + 104, 1);
    store32(buf + 108, 1);
    store32(buf + 112, (4 << 16) | 71);  # OpDecorate %15 BuiltIn GlobalInvocationId
    store32(buf + 116, 15);
    store32(buf + 120, 11);
    store32(buf + 124, 28);
    store32(buf + 128, (4 << 16) | 71);  # OpDecorate %16 Binding 0
    store32(buf + 132, 16);
    store32(buf + 136, 33);
    store32(buf + 140, 0);
    store32(buf + 144, (4 << 16) | 71);  # OpDecorate %16 DescriptorSet 0
    store32(buf + 148, 16);
    store32(buf + 152, 34);
    store32(buf + 156, 0);
    store32(buf + 160, (2 << 16) | 19);  # %2 void
    store32(buf + 164, 2);
    store32(buf + 168, (3 << 16) | 33);  # %3 fn
    store32(buf + 172, 3);
    store32(buf + 176, 2);
    store32(buf + 180, (4 << 16) | 21);  # %4 uint
    store32(buf + 184, 4);
    store32(buf + 188, 32);
    store32(buf + 192, 0);
    store32(buf + 196, (4 << 16) | 23);  # %5 v3uint
    store32(buf + 200, 5);
    store32(buf + 204, 4);
    store32(buf + 208, 3);
    store32(buf + 212, (4 << 16) | 32);  # %6 ptr Input v3uint
    store32(buf + 216, 6);
    store32(buf + 220, 1);
    store32(buf + 224, 5);
    store32(buf + 228, (3 << 16) | 22);  # %7 float
    store32(buf + 232, 7);
    store32(buf + 236, 32);
    store32(buf + 240, (3 << 16) | 29);  # %8 runtime array float
    store32(buf + 244, 8);
    store32(buf + 248, 7);
    store32(buf + 252, (3 << 16) | 30);  # %9 struct { %8 }
    store32(buf + 256, 9);
    store32(buf + 260, 8);
    store32(buf + 264, (4 << 16) | 32);  # %10 ptr StorageBuffer struct
    store32(buf + 268, 10);
    store32(buf + 272, 12);
    store32(buf + 276, 9);
    store32(buf + 280, (4 << 16) | 32);  # %11 ptr StorageBuffer float
    store32(buf + 284, 11);
    store32(buf + 288, 12);
    store32(buf + 292, 7);
    store32(buf + 296, (4 << 16) | 43);  # %12 const uint 0
    store32(buf + 300, 4);
    store32(buf + 304, 12);
    store32(buf + 308, 0);
    store32(buf + 312, (4 << 16) | 43);  # %13 const float 1.0
    store32(buf + 316, 7);
    store32(buf + 320, 13);
    store32(buf + 324, 0x3F800000);
    store32(buf + 328, (4 << 16) | 43);  # %14 const float 4.0
    store32(buf + 332, 7);
    store32(buf + 336, 14);
    store32(buf + 340, 0x40800000);
    store32(buf + 344, (4 << 16) | 59);  # %15 gid var (Input)
    store32(buf + 348, 6);
    store32(buf + 352, 15);
    store32(buf + 356, 1);
    store32(buf + 360, (4 << 16) | 59);  # %16 out var (StorageBuffer)
    store32(buf + 364, 10);
    store32(buf + 368, 16);
    store32(buf + 372, 12);
    store32(buf + 376, (5 << 16) | 54);  # OpFunction %17
    store32(buf + 380, 2);
    store32(buf + 384, 17);
    store32(buf + 388, 0);
    store32(buf + 392, 3);
    store32(buf + 396, (2 << 16) | 248); # OpLabel %18
    store32(buf + 400, 18);
    store32(buf + 404, (4 << 16) | 61);  # OpLoad %19 = gid
    store32(buf + 408, 5);
    store32(buf + 412, 19);
    store32(buf + 416, 15);
    store32(buf + 420, (5 << 16) | 81);  # OpCompositeExtract %20 = gid.x
    store32(buf + 424, 4);
    store32(buf + 428, 20);
    store32(buf + 432, 19);
    store32(buf + 436, 0);
    store32(buf + 440, (4 << 16) | 112); # OpConvertUToF %21 = float(gid.x)
    store32(buf + 444, 7);
    store32(buf + 448, 21);
    store32(buf + 452, 20);
    store32(buf + 456, (8 << 16) | 12);  # OpExtInst %22 = FClamp(%21, 1.0, 4.0)
    store32(buf + 460, 7);
    store32(buf + 464, 22);
    store32(buf + 468, 1);                # ext set = %1
    store32(buf + 472, 43);               # FClamp
    store32(buf + 476, 21);
    store32(buf + 480, 13);
    store32(buf + 484, 14);
    store32(buf + 488, (6 << 16) | 65);  # OpAccessChain %23 = &out[gid.x]
    store32(buf + 492, 11);
    store32(buf + 496, 23);
    store32(buf + 500, 16);
    store32(buf + 504, 12);
    store32(buf + 508, 20);
    store32(buf + 512, (3 << 16) | 62);  # OpStore %23 %22
    store32(buf + 516, 23);
    store32(buf + 520, 22);
    store32(buf + 524, (1 << 16) | 253); # OpReturn
    store32(buf + 528, (1 << 16) | 56);  # OpFunctionEnd
    return 532;
}

fn main(): i64 {
    alloc_init();
    print_cstr("mabda native SPIR-V GLSL FClamp e2e (N.8b-4) on Cezanne\n");
    print_cstr("-------------------------------------------------------\n");

    var spv[768];
    var n = build_fclamp_kernel(&spv);

    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) { return 3; }
    var ctx = payload(ctx_res);
    var fd = native_ctx_fd(ctx);

    var shmod = gpu_shader_module_create_spirv(ctx, &spv, n);
    if (shmod == 0) { print_cstr("FAIL: shader_module_create_spirv -> 0\n"); return 2; }

    var ob[16];
    if (native_bo_create_gtt(fd, 4096, &ob) != 0) { return 5; }
    var out_handle = load64(&ob + 0);
    var out_map = load64(&ob + 8);
    var k = 0;
    while (k < 8) { store32(out_map + k * 4, 0xBAADF00D); k = k + 1; }
    var out_va = 0xFFFF800100400000;
    if (native_gem_va_map(fd, out_handle, out_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }

    var bp[24];
    store64(&bp + 0, 1);
    store64(&bp + 8, out_handle);
    store64(&bp + 16, out_va);

    var rc = gpu_compute_dispatch(ctx, shmod, 1, 1, 1, &bp);
    if (rc != 0) { print_cstr("FAIL: gpu_compute_dispatch rc="); print_i64(rc); print_cstr("\n"); return 9; }

    # f32 bits of clamp(i,1,4) for i in 0..7 = {1,1,2,3,4,4,4,4}.0.
    var exp[32];
    store32(&exp + 0, 0x3F800000);
    store32(&exp + 4, 0x3F800000);
    store32(&exp + 8, 0x40000000);
    store32(&exp + 12, 0x40400000);
    store32(&exp + 16, 0x40800000);
    store32(&exp + 20, 0x40800000);
    store32(&exp + 24, 0x40800000);
    store32(&exp + 28, 0x40800000);

    var ok = 1;
    var i = 0;
    while (i < 8) {
        var got = load32(out_map + i * 4);
        var want = load32(&exp + i * 4);
        print_cstr("out["); print_i64(i); print_cstr("] = 0x"); print_hex(got);
        if (got != want) { print_cstr("  MISMATCH want=0x"); print_hex(want); ok = 0; }
        print_cstr("\n");
        i = i + 1;
    }

    gpu_shader_module_release(ctx, shmod);
    native_gem_va_unmap(fd, out_handle, out_va, 4096);
    native_bo_release_gtt(fd, out_handle, out_map, 4096);
    gpu_context_release(ctx);

    if (ok == 0) { print_cstr("FAIL: fclamp dispatch mismatch\n"); return 11; }
    print_cstr("OK — GLSL.std.450 clamp(float(gid.x), 1.0, 4.0) via v_med3_f32 correct on Cezanne\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
