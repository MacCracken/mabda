# programs/native_spirv_store_const_e2e.cyr — N.8b-5: storing a CONSTANT value compiled
# in-tree and dispatched on Cezanne, proving store-constant VGPR materialization.
#
# Kernel: `out[gid.x] = 0xCAFE;`. LocalSize 8, one workgroup. A FLAT global store's data
# operand must be a VGPR, so the constant 0xCAFE is first materialized into the scratch
# VGPR with v_mov_b32, then stored. (Before N.8b-5 this failed CMP_ERR_FLAT_NONVGPR.)
#
# Seed out[0..7] = 0xBAADF00D. Verify out[i] = 0xCAFE for all i.
# Exit: 0 = correct; 2 = compile; 3/5 = setup; 9 = dispatch; 11 = mismatch.

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}
fn print_hex(n): i64 {
    var buf[16];
    var d = 0;
    while (d < 8) {
        var nib = (n >> ((7 - d) * 4)) & 0xF;
        var ch = 48 + nib;
        if (nib > 9) { ch = 87 + nib; }
        store8(&buf + d, ch);
        d = d + 1;
    }
    syscall(1, 1, &buf, 8);
    return 0;
}

# SPIR-V (id-bound 19, 432 bytes). %12 GlobalInvocationId; %13 out; %11 = const 0xCAFE.
fn build_store_const_kernel(buf): i64 {
    store32(buf + 0, 0x07230203);
    store32(buf + 4, 0x00010300);
    store32(buf + 8, 0);
    store32(buf + 12, 19);
    store32(buf + 16, 0);
    store32(buf + 20, (2 << 16) | 17);   # OpCapability Shader
    store32(buf + 24, 1);
    store32(buf + 28, (3 << 16) | 14);   # OpMemoryModel Logical GLSL450
    store32(buf + 32, 0);
    store32(buf + 36, 1);
    store32(buf + 40, (6 << 16) | 15);   # OpEntryPoint GLCompute %14 "main" %12
    store32(buf + 44, 5);
    store32(buf + 48, 14);
    store32(buf + 52, 0x6E69616D);
    store32(buf + 56, 0);
    store32(buf + 60, 12);
    store32(buf + 64, (6 << 16) | 16);   # OpExecutionMode %14 LocalSize 8 1 1
    store32(buf + 68, 14);
    store32(buf + 72, 17);
    store32(buf + 76, 8);
    store32(buf + 80, 1);
    store32(buf + 84, 1);
    store32(buf + 88, (4 << 16) | 71);   # OpDecorate %12 BuiltIn GlobalInvocationId
    store32(buf + 92, 12);
    store32(buf + 96, 11);
    store32(buf + 100, 28);
    store32(buf + 104, (4 << 16) | 71);  # OpDecorate %13 Binding 0
    store32(buf + 108, 13);
    store32(buf + 112, 33);
    store32(buf + 116, 0);
    store32(buf + 120, (4 << 16) | 71);  # OpDecorate %13 DescriptorSet 0
    store32(buf + 124, 13);
    store32(buf + 128, 34);
    store32(buf + 132, 0);
    store32(buf + 136, (2 << 16) | 19);  # %1 void
    store32(buf + 140, 1);
    store32(buf + 144, (3 << 16) | 33);  # %2 fn
    store32(buf + 148, 2);
    store32(buf + 152, 1);
    store32(buf + 156, (4 << 16) | 21);  # %3 uint
    store32(buf + 160, 3);
    store32(buf + 164, 32);
    store32(buf + 168, 0);
    store32(buf + 172, (4 << 16) | 23);  # %4 v3uint
    store32(buf + 176, 4);
    store32(buf + 180, 3);
    store32(buf + 184, 3);
    store32(buf + 188, (4 << 16) | 32);  # %5 ptr Input v3uint
    store32(buf + 192, 5);
    store32(buf + 196, 1);
    store32(buf + 200, 4);
    store32(buf + 204, (3 << 16) | 29);  # %6 runtime array uint
    store32(buf + 208, 6);
    store32(buf + 212, 3);
    store32(buf + 216, (3 << 16) | 30);  # %7 struct { %6 }
    store32(buf + 220, 7);
    store32(buf + 224, 6);
    store32(buf + 228, (4 << 16) | 32);  # %8 ptr StorageBuffer struct
    store32(buf + 232, 8);
    store32(buf + 236, 12);
    store32(buf + 240, 7);
    store32(buf + 244, (4 << 16) | 32);  # %9 ptr StorageBuffer uint
    store32(buf + 248, 9);
    store32(buf + 252, 12);
    store32(buf + 256, 3);
    store32(buf + 260, (4 << 16) | 43);  # %10 const 0
    store32(buf + 264, 3);
    store32(buf + 268, 10);
    store32(buf + 272, 0);
    store32(buf + 276, (4 << 16) | 43);  # %11 const 0xCAFE
    store32(buf + 280, 3);
    store32(buf + 284, 11);
    store32(buf + 288, 0xCAFE);
    store32(buf + 292, (4 << 16) | 59);  # %12 gid var (Input)
    store32(buf + 296, 5);
    store32(buf + 300, 12);
    store32(buf + 304, 1);
    store32(buf + 308, (4 << 16) | 59);  # %13 out var (StorageBuffer)
    store32(buf + 312, 8);
    store32(buf + 316, 13);
    store32(buf + 320, 12);
    store32(buf + 324, (5 << 16) | 54);  # OpFunction %14
    store32(buf + 328, 1);
    store32(buf + 332, 14);
    store32(buf + 336, 0);
    store32(buf + 340, 2);
    store32(buf + 344, (2 << 16) | 248); # OpLabel %15
    store32(buf + 348, 15);
    store32(buf + 352, (4 << 16) | 61);  # OpLoad %16 = gid
    store32(buf + 356, 4);
    store32(buf + 360, 16);
    store32(buf + 364, 12);
    store32(buf + 368, (5 << 16) | 81);  # OpCompositeExtract %17 = gid.x
    store32(buf + 372, 3);
    store32(buf + 376, 17);
    store32(buf + 380, 16);
    store32(buf + 384, 0);
    store32(buf + 388, (6 << 16) | 65);  # OpAccessChain %18 = &out[gid.x]
    store32(buf + 392, 9);
    store32(buf + 396, 18);
    store32(buf + 400, 13);
    store32(buf + 404, 10);
    store32(buf + 408, 17);
    store32(buf + 412, (3 << 16) | 62);  # OpStore %18 %11 (= 0xCAFE)
    store32(buf + 416, 18);
    store32(buf + 420, 11);
    store32(buf + 424, (1 << 16) | 253); # OpReturn
    store32(buf + 428, (1 << 16) | 56);  # OpFunctionEnd
    return 432;
}

fn main(): i64 {
    alloc_init();
    print_cstr("mabda native SPIR-V store-constant e2e (N.8b-5) on Cezanne\n");
    print_cstr("----------------------------------------------------------\n");

    var spv[768];
    var n = build_store_const_kernel(&spv);

    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) { return 3; }
    var ctx = payload(ctx_res);
    var fd = native_ctx_fd(ctx);

    var shmod = gpu_shader_module_create_spirv(ctx, &spv, n);
    if (shmod == 0) { print_cstr("FAIL: shader_module_create_spirv -> 0\n"); return 2; }

    var ob[16];
    if (native_bo_create_gtt(fd, 4096, &ob) != 0) { return 5; }
    var out_handle = load64(&ob + 0);
    var out_map = load64(&ob + 8);
    var k = 0;
    while (k < 8) { store32(out_map + k * 4, 0xBAADF00D); k = k + 1; }
    var out_va = 0xFFFF800100400000;
    if (native_gem_va_map(fd, out_handle, out_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }

    var bp[24];
    store64(&bp + 0, 1);
    store64(&bp + 8, out_handle);
    store64(&bp + 16, out_va);

    var rc = gpu_compute_dispatch(ctx, shmod, 1, 1, 1, &bp);
    if (rc != 0) { print_cstr("FAIL: gpu_compute_dispatch rc="); print_i64(rc); print_cstr("\n"); return 9; }

    var ok = 1;
    var i = 0;
    while (i < 8) {
        var got = load32(out_map + i * 4);
        print_cstr("out["); print_i64(i); print_cstr("] = 0x"); print_hex(got);
        if (got != 0xCAFE) { print_cstr("  MISMATCH"); ok = 0; }
        print_cstr("\n");
        i = i + 1;
    }

    gpu_shader_module_release(ctx, shmod);
    native_gem_va_unmap(fd, out_handle, out_va, 4096);
    native_bo_release_gtt(fd, out_handle, out_map, 4096);
    gpu_context_release(ctx);

    if (ok == 0) { print_cstr("FAIL: store-const dispatch mismatch\n"); return 11; }
    print_cstr("OK — out[gid.x] = 0xCAFE (constant materialized to VGPR) correct on Cezanne\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
