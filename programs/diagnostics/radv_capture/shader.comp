#version 450

// store_deadbeef equivalent — single-thread compute that writes
// the magic value 0xDEADBEEF to slot[0] of a storage buffer.
// Mirrors mabda's `native_pm4_build_compute_store_deadbeef` shape:
// 1x1x1 dispatch, single wave, single SSBO target.

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Out {
    uint data[];
} out_buf;

void main() {
    out_buf.data[0] = 0xDEADBEEFu;
}
