# programs/diagnostics/state_poison/dump_streams.cyr — CPU-only dump of the three
# native render PM4 streams (no DRM device, no submit) for the owned-state audit
# (audit/audit_table.py). Writes into <outdir>:
#   clear_triangle.bin    native_pm4_build_render_clear_triangle (256x256 RT)
#   pass_untextured.bin   native_render_pass_pm4_compose, textured = 0 (64x64)
#   pass_textured.bin     native_render_pass_pm4_compose, textured = 1 (64x64)
# The pipeline is packed with the Cezanne CU pair (native_gfx9_vs_cu_cezanne);
# on other GPUs the draw path derives it from DRM_AMDGPU_INFO instead.
#
# usage: dump_streams <outdir>     exit: 0 ok; 2 usage; 3 compose; 4 write

include "src/lib.cyr"

fn _ds_print(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }

fn _ds_write(dir, name, buf, len): i64 {
    var path[512];
    memset(&path, 0, 512);
    var dl = strlen(dir);
    var nl = strlen(name);
    if (dl + nl + 2 > 512) { return 0 - 1; }
    memcpy(&path, dir, dl);
    store8(&path + dl, 47);
    memcpy(&path + dl + 1, name, nl);
    var fd = syscall(2, &path, 577, 420);
    if (fd < 0) { return 0 - 1; }
    var n = syscall(1, fd, buf, len);
    syscall(3, fd);
    if (n != len) { return 0 - 1; }
    return 0;
}

fn main(): i64 {
    alloc_init();
    color_init();
    args_init();
    if (argc() != 2) { _ds_print("usage: dump_streams <outdir>\n"); return 2; }
    var dir = argv(1);
    var vs_va = 0xFFFF800100000000;
    var fs_va = 0xFFFF800100001000;
    var rt_va = 0xFFFF800101000000;

    var buf[2048];
    memset(&buf, 0, 2048);
    var n = native_pm4_build_render_clear_triangle(&buf, vs_va, fs_va, rt_va, 256, 256);
    if (n != native_pm4_render_clear_triangle_bytes()) { return 3; }
    if (_ds_write(dir, "clear_triangle.bin", &buf, n) != 0) { return 4; }

    var pipe = alloc(NATIVE_PIPE_STRUCT_SIZE);
    if (native_render_pipeline_pack(pipe, 1, vs_va, 2, fs_va, native_gfx9_vs_cu_cezanne()) != 0) {
        return 3;
    }
    memset(&buf, 0, 2048);
    n = native_render_pass_pm4_compose(&buf, 2048, pipe, rt_va, 64, 64, 0, 0, 3);
    if (n <= 0) { return 3; }
    if (_ds_write(dir, "pass_untextured.bin", &buf, n) != 0) { return 4; }
    memset(&buf, 0, 2048);
    n = native_render_pass_pm4_compose(&buf, 2048, pipe, rt_va, 64, 64, 1, 0xFFFF800100404000, 3);
    if (n <= 0) { return 3; }
    if (_ds_write(dir, "pass_textured.bin", &buf, n) != 0) { return 4; }
    _ds_print("wrote clear_triangle.bin pass_untextured.bin pass_textured.bin\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
