# programs/nvidia_render_tier_e2e.cyr — v4.3.0: the render tier's native NVIDIA subset
#
# nvidia_render_api's triangle (SPH+SASS VS from VertexID, solid-colour FS) through
# the 4.3.0 public calls: gpu_render_pipeline_create_desc + set_pipeline +
# draw_vertices. Reads back 0xFF996633 like nvidia_render_api; then an
# outside-the-subset descriptor and an indexed draw answer GPU_ERR_NOT_IMPLEMENTED.  #skip-lint
#
# Not in CI (hardware-dependent). Run via `make test-nvidia-render-tier-e2e`.
include "src/lib.cyr"

var _passes = 0;
fn out(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn pass(s): i64 { out("PASS: "); out(s); out("\n"); _passes = _passes + 1; return 0; }
fn fail(s): i64 { out("FAIL: "); out(s); out("\n"); return 1; }

fn main(): i64 {
    alloc_init();
    var ctx_res_tag, ctx_res = gpu_context_new_native_nvidia();
    if (is_err_result(ctx_res_tag) == 1) { out("SKIP: no NVIDIA context\n"); return 0; }
    var ctx = ctx_res;
    pass("NVIDIA native context");
    var rt = gpu_render_target_create_2d_rgba8(ctx, 64, 64);
    if (rt == 0) { return fail("render target"); }
    var vs_bytes[352];
    native_nv_sass_render_vs(&vs_bytes);
    var vs_mod = gpu_shader_module_create(ctx, &vs_bytes, NV_SASS_RENDER_VS_BYTES);
    var fs_bytes[272];
    native_nv_sass_render_fs(&fs_bytes);
    var fs_mod = gpu_shader_module_create(ctx, &fs_bytes, NV_SASS_RENDER_FS_BYTES);
    if (vs_mod == 0) { return fail("VS module"); }
    if (fs_mod == 0) { return fail("FS module"); }
    store64(vs_mod + NV_SHMOD_REGCOUNT, NV_SASS_RENDER_VS_REGCOUNT);
    store64(fs_mod + NV_SHMOD_REGCOUNT, NV_SASS_RENDER_FS_REGCOUNT);

    var d = gpu_pipeline_desc_new(vs_mod, "vs_main");
    gpu_pipeline_desc_fragment(d, fs_mod, "fs_main");
    gpu_pipeline_desc_target(d, MABDA_TEXFMT_RGBA8, GPU_BLEND_NONE, GPU_WRITE_ALL);
    var pipe = gpu_render_pipeline_create_desc(ctx, d);
    if (pipe == 0) { out("  "); out(gpu_last_error_message()); out("\n"); return fail("subset pipeline"); }
    pass("gpu_render_pipeline_create_desc: the native subset pipeline");

    var rt_addr = load64(rt + NV_RT_ADDR);
    memset(rt_addr, 0, 64 * 256);
    var clear[32];
    memset(&clear, 0, 32);
    var p = gpu_render_pass_begin(ctx, rt, &clear);
    if (p == 0) { return fail("pass begin"); }
    if (gpu_render_pass_set_pipeline(ctx, p, pipe) != 0) { return fail("set_pipeline"); }
    if (gpu_render_pass_draw_vertices(ctx, p, 3, 1, 0, 1) != GPU_ERR_NOT_IMPLEMENTED) {   #skip-lint
        return fail("first_instance 1 was not refused");
    }
    if (gpu_render_pass_draw_vertices(ctx, p, 3, 1, 0, 0) != 0) { return fail("draw_vertices"); }
    gpu_render_pass_end(ctx, p);
    var got = load32(rt_addr + 8320);   # (32,32) at row pitch 256
    if (got != 0xFF996633) { return fail("the centre pixel is not 0xFF996633"); }
    pass("set_pipeline + draw_vertices(3, 1, 0, 0): pixel (32,32) = 0xFF996633; first_instance 1 refused");

    gpu_error_clear();
    var v = gpu_pipeline_desc_new(vs_mod, "vs_main");
    gpu_pipeline_desc_fragment(v, fs_mod, "fs_main");
    gpu_pipeline_desc_target(v, MABDA_TEXFMT_RGBA8, GPU_BLEND_ALPHA, GPU_WRITE_ALL);
    if (gpu_render_pipeline_create_desc(ctx, v) != 0) { return fail("a blended pipeline was created"); }
    if (gpu_last_error() != GPU_ERR_NOT_IMPLEMENTED) { return fail("not NOT_IMPLEMENTED"); }   #skip-lint
    out("    ");
    out(gpu_last_error_message());
    out("\n");
    var p2 = gpu_render_pass_begin(ctx, rt, &clear);
    if (gpu_render_pass_draw_indexed(ctx, p2, 3, 1, 0, 0, 0) != GPU_ERR_NOT_IMPLEMENTED) {   #skip-lint
        return fail("an indexed draw was not refused");
    }
    gpu_render_pass_end(ctx, p2);
    pass("outside the subset: blending, indexed draws -> GPU_ERR_NOT_IMPLEMENTED + reason");  #skip-lint

    # 4.3.1 — the target block's native subset: gpu_render_target_create (RGBA8,
    # one sample), a one-attachment descriptor pass, gpu_render_target_read (the
    # 128-byte row pitch un-padded).
    var rt2 = gpu_render_target_create(ctx, 50, 40, MABDA_TEXFMT_RGBA8, 1);
    if (rt2 == 0) { return fail("gpu_render_target_create RGBA8 x1"); }
    var pd = gpu_pass_desc_new();
    gpu_pass_desc_color(pd, rt2, GPU_LOAD_CLEAR, &clear);
    var p3 = gpu_render_pass_begin_desc(ctx, pd);
    if (p3 == 0) { return fail("descriptor pass"); }
    if (gpu_render_pass_set_pipeline(ctx, p3, pipe) != 0) { return fail("set_pipeline (descriptor pass)"); }
    if (gpu_render_pass_draw_vertices(ctx, p3, 3, 1, 0, 0) != 0) { return fail("draw (descriptor pass)"); }
    gpu_render_pass_end(ctx, p3);
    var rb = alloc(50 * 40 * 4);
    if (gpu_render_target_read(ctx, rt2, rb, 50 * 40 * 4) != 0) { return fail("gpu_render_target_read"); }
    if (load32(rb + (20 * 50 + 25) * 4) != 0xFF996633) { return fail("readback (25,20) is not 0xFF996633"); }
    pass("4.3.1: render_target_create + begin_desc + render_target_read (50 x 40, pitch un-padded)");
    gpu_error_clear();
    if (gpu_render_target_create(ctx, 64, 64, MABDA_TEXFMT_RGBA16F, 1) != 0) { return fail("a native RGBA16F target"); }
    if (gpu_last_error() != GPU_ERR_NOT_IMPLEMENTED) { return fail("RGBA16F: not NOT_IMPLEMENTED"); }   #skip-lint
    if (gpu_texture_view_create(ctx, rt2, GPU_VIEW_2D, 0, 1, 0, 1) != 0) { return fail("a native view was made"); }
    pass("4.3.1 outside the native subset: other formats, views -> named refusals");
    gpu_render_target_release(ctx, rt2);

    gpu_render_pipeline_release(ctx, pipe);
    gpu_shader_module_release(ctx, vs_mod);
    gpu_shader_module_release(ctx, fs_mod);
    gpu_render_target_release(ctx, rt);
    gpu_context_release(ctx);
    out("\n");
    var nb[32];
    memset(&nb, 0, 32);
    syscall(1, 1, &nb, fmt_int_buf(_passes, &nb));
    out(" passed, 0 failed\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
