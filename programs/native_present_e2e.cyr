# programs/native_present_e2e.cyr — v3 Step 7.7 e2e
#
# 120-frame double-buffered animated present using the v3 public
# surface API. Closes Phase D end-to-end on real hardware.
#
# Flow:
#   1. Open card_fd + render_fd, take DRM master
#   2. gpu_context_new_native()
#   3. gpu_surface_configure_native_kiosk(ctx, card_fd, w, h)
#   4. for frame in 0..120:
#        fb = gpu_surface_acquire(ctx, surface)
#        # Fill fb's mapped_addr with frame-dependent gradient
#        gpu_surface_present(ctx, surface)
#   5. gpu_surface_release + drop_master + close fds
#
# **Run from a tty.** Same master-acquisition gate as
# native_kms_modeset_smoke; see project memory
# `project_phase_d_master_logind_blocker` for the workarounds
# (vkms / no-compositor / stop display-manager). This program uses
# the kiosk path; the in-session alternative is
# gpu_surface_configure_native_logind (`-D MABDA_LOGIND` plus an
# initialized samvada).
#
# Two phases (4.4.0; the same picture NVIDIA's surface present gate shows):
#   1. 120 frames of a vertically-scrolling blue-to-red gradient (~2 s at 60 Hz). Each frame's
#      offset is `frame * 4` rows, so the pattern wraps every (h/4) frames.
#   2. 180 frames of the TEST CARD: a 32-px grey checkerboard, a 4-px green border, a 1-px white
#      diagonal and a red bar sweeping right. A broken flip shows here: jagged or torn edges, a
#      bar that jumps back, or a frozen picture.
# Then gpu_surface_release puts the console back (4.4.0: it used to switch the display off).
# Each phase prints its frame time.
#
# Exit codes:
#   0   — 120 frames presented, clean teardown
#   1   — open /dev/dri/cardN failed
#   2   — open /dev/dri/renderD128 failed
#   3   — DRM_IOCTL_SET_MASTER failed (logind holds master)
#   4   — gpu_context_new_native failed
#   5   — gpu_surface_configure_native_kiosk failed (most likely
#         no connected connector, or modeset rejected)
#   6   — gpu_surface_acquire returned 0 mid-loop
#   7   — gpu_surface_present returned non-zero mid-loop

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}

# Card-node scan — same shape as native_kms_summary's helper.
fn _try_open_card(path_buf): i64 {
    var i = 0;
    while (i < 10) {
        store8(path_buf + 13, 48 + i);
        var fd = syscall(2, path_buf, 0x2, 0);
        if (fd >= 0) { return fd; }
        i = i + 1;
    }
    return -2;
}

# Fill the back-buffer with a vertically-scrolling gradient. Each
# row's color depends on (y + offset) mod height — wraps cleanly.
# Top half blends blue→red; bottom half stays mostly red. XRGB8888
# LE memory is [B, G, R, X] per pixel; pack as 0x00RRGGBB.
fn _fill_gradient(addr, w, h, pitch, frame_offset): i64 {
    var y = 0;
    while (y < h) {
        var virt_y = (y + frame_offset) % h;
        # virt_y goes 0..h-1; map to red intensity 0..255 across full height.
        var r = (virt_y * 255) / h;
        var b = 255 - r;
        var pixel = (r << 16) | b;   # G stays 0
        var row = addr + y * pitch;
        var x = 0;
        while (x < w) {
            store32(row + x * 4, pixel);
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

# The test card into an XRGB8888 buffer (`pitch` bytes per row): a 32-px checkerboard, a 4-px
# green border, a 1-px white diagonal (moving 4 px a frame) and a 16-px red bar sweeping right
# 8 px a frame. The same card as programs/nvidia_surface_present_e2e.cyr.
fn _fill_card(addr, w, h, pitch, frame): i64 {
    var bar = (frame * 8) % w;
    var y = 0;
    while (y < h) {
        var row = addr + y * pitch;
        var x = 0;
        while (x < w) {
            var px = 0x303030;
            if ((((x / 32) + (y / 32)) % 2) == 1) { px = 0x606060; }
            if (x >= bar) { if (x < bar + 16) { px = 0xFF0000; } }
            if (((x + 4096 - y - frame * 4) % 256) == 0) { px = 0xFFFFFF; }
            if (x < 4) { px = 0x00FF00; }
            if (y < 4) { px = 0x00FF00; }
            if (x >= w - 4) { px = 0x00FF00; }
            if (y >= h - 4) { px = 0x00FF00; }
            store32(row + x * 4, px);
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

# Present `frames` frames: the gradient (card 0) or the test card (card 1). Returns 0, or 6
# (acquire returned 0) / 7 (present failed).
fn present_frames(ctx, surface, w, h, pitch, frames, card, label): i64 {
    var t0 = _time_now_ns();
    var frame = 0;
    while (frame < frames) {
        var fb = gpu_surface_acquire(ctx, surface);
        if (fb == 0) {
            print_cstr("FAIL: acquire returned 0 at frame "); print_i64(frame); print_cstr("\n");
            return 6;
        }
        # fb is a NativeKmsFb-shaped pointer (fb_b) or the NativeKmsScanout (fb_a): the mapped
        # address sits at a different offset in each.
        var addr = 0;
        if (fb == surface + NATIVE_SURFACE_FB_B) {
            addr = load64(fb + NATIVE_KMS_FB_MAPPED_ADDR);
        }
        if (fb == surface + NATIVE_SURFACE_SCANOUT) {
            addr = load64(fb + NATIVE_KMS_SCANOUT_MAPPED_ADDR);
        }
        if (card == 1) { _fill_card(addr, w, h, pitch, frame); } else { _fill_gradient(addr, w, h, pitch, frame * 4); }
        var rc = gpu_surface_present(ctx, surface);
        if (rc != 0) {
            print_cstr("FAIL: present returned "); print_i64(rc);
            print_cstr(" at frame "); print_i64(frame); print_cstr("\n");
            return 7;
        }
        frame = frame + 1;
    }
    var t1 = _time_now_ns();
    print_cstr("PASS: "); print_cstr(label); print_cstr(": "); print_i64(frames);
    print_cstr(" frames, "); print_i64((t1 - t0) / frames / 1000); print_cstr(" us per frame\n");
    return 0;
}

fn main(): i64 {
    alloc_init();

    print_cstr("mabda native present e2e (v3 Step 7.7)\n");
    print_cstr("--------------------------------------\n");
    print_cstr("expect: ~2 s of a scrolling blue-red gradient, then the test card (checkerboard, green\n");
    print_cstr("        border, white diagonal, red bar sweeping right), then the console comes back\n\n");

    # Open card master fd.
    var path[16];
    memset(&path, 0, 16);
    store8(&path + 0,  47);   store8(&path + 1,  100);  store8(&path + 2,  101);
    store8(&path + 3,  118);  store8(&path + 4,  47);   store8(&path + 5,  100);
    store8(&path + 6,  114);  store8(&path + 7,  105);  store8(&path + 8,  47);
    store8(&path + 9,  99);   store8(&path + 10, 97);   store8(&path + 11, 114);
    store8(&path + 12, 100);
    var card_fd = _try_open_card(&path);
    if (card_fd < 0) {
        print_cstr("FAIL: open /dev/dri/cardN errno=");
        print_i64(0 - card_fd); print_cstr("\n");
        return 1;
    }
    print_cstr("opened card_fd="); print_i64(card_fd); print_cstr("\n");

    # Take DRM master explicitly so the slot path's SETCRTC works.
    var rc = native_drm_set_master(card_fd);
    if (rc != 0) {
        print_cstr("FAIL: SET_MASTER errno="); print_i64(0 - rc);
        print_cstr(" (logind holds master? run from a tty + stop compositor)\n");
        sys_close(card_fd);
        return 3;
    }

    # Bring up native ctx (opens render fd internally).
    var ctx_res_tag, ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res_tag) == 1) {
        print_cstr("FAIL: gpu_context_new_native\n");
        native_drm_drop_master(card_fd);
        sys_close(card_fd);
        return 4;
    }
    var ctx = ctx_res;

    # Configure surface at the connector's preferred mode: the AMD slot refuses any other size
    # (audit HIGH-1, no silent substitution). 4.4.0: this asked for a fixed 1920x1080 and failed
    # on the 2560x1440 monitor; native_kms_first_connected_mode reads the mode without master.
    var wh[16];
    if (native_kms_first_connected_mode(card_fd, &wh) != 0) {
        print_cstr("FAIL: no connected connector with a mode\n");
        gpu_context_release(ctx);
        native_drm_drop_master(card_fd);
        sys_close(card_fd);
        return 5;
    }
    var W = load64(&wh);
    var H = load64(&wh + 8);
    print_cstr("connector mode "); print_i64(W); print_cstr("x"); print_i64(H); print_cstr("\n");
    var surface = gpu_surface_configure_native_kiosk(ctx, card_fd, W, H);
    if (surface == 0) {
        print_cstr("FAIL: gpu_surface_configure_native_kiosk: ");
        print_cstr(gpu_last_error_message()); print_cstr("\n");
        gpu_context_release(ctx);
        native_drm_drop_master(card_fd);
        sys_close(card_fd);
        return 5;
    }
    var actual_w = load32(surface + NATIVE_SURFACE_WIDTH);
    var actual_h = load32(surface + NATIVE_SURFACE_HEIGHT);
    var pitch    = load32(surface + NATIVE_SURFACE_PITCH);
    print_cstr("PASS: surface configured "); print_i64(actual_w);
    print_cstr("x"); print_i64(actual_h); print_cstr(" pitch=");
    print_i64(pitch); print_cstr("\n");

    rc = present_frames(ctx, surface, actual_w, actual_h, pitch, 120, 0, "the gradient");
    if (rc == 0) { rc = present_frames(ctx, surface, actual_w, actual_h, pitch, 180, 1, "the test card"); }
    if (rc != 0) {
        gpu_surface_release(ctx, surface);
        gpu_context_release(ctx);
        native_drm_drop_master(card_fd);
        sys_close(card_fd);
        return rc;
    }

    gpu_surface_release(ctx, surface);
    gpu_context_release(ctx);
    native_drm_drop_master(card_fd);
    sys_close(card_fd);
    print_cstr("teardown complete (the console should be back)\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
