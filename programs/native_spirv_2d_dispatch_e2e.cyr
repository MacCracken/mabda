# programs/native_spirv_2d_dispatch_e2e.cyr — N.6: a 2-D / TGID compiled dispatch,
# end-to-end through the PUBLIC gpu_* API on Cezanne.
#
# Kernel: `out[gid.y*4 + gid.x] = gid.x*16 + gid.y`, using gl_GlobalInvocationId,
# LocalSize 2x2x1, dispatched over a 2x2x1 WORKGROUP grid → a 4x4 global domain.
# This is the full 2-D path: NUM_THREAD_X/Y from the compiled LocalSize, grid x/y
# workgroup counts, WorkgroupId.x/.y (TGID), and the GlobalInvocationId.x/.y
# expansion (gid = wgid*local + lid) for BOTH components. 1 storage binding.
#
# Seed out with a sentinel; verify out[gy*4+gx] == gx*100 + gy for all 16 texels.
# Exit: 0 = all 16 correct; 2 = compile; 3/5 = setup; 9 = dispatch; 11 = mismatch.

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}

# SPIR-V (id-bound 25, 548 bytes). Binding: %14 out (binding 0). GID builtin %13.
fn build_2d_kernel(buf): i64 {
    store32(buf + 0, 0x07230203);
    store32(buf + 4, 0x00010300);
    store32(buf + 8, 0);
    store32(buf + 12, 25);
    store32(buf + 16, 0);
    store32(buf + 20, (2 << 16) | 17);   # OpCapability Shader
    store32(buf + 24, 1);
    store32(buf + 28, (3 << 16) | 14);   # OpMemoryModel Logical GLSL450
    store32(buf + 32, 0);
    store32(buf + 36, 1);
    store32(buf + 40, (6 << 16) | 15);   # OpEntryPoint GLCompute %15 "main" %13
    store32(buf + 44, 5);
    store32(buf + 48, 15);
    store32(buf + 52, 0x6E69616D);
    store32(buf + 56, 0);
    store32(buf + 60, 13);
    store32(buf + 64, (6 << 16) | 16);   # OpExecutionMode %15 LocalSize 2 2 1
    store32(buf + 68, 15);
    store32(buf + 72, 17);
    store32(buf + 76, 2);
    store32(buf + 80, 2);
    store32(buf + 84, 1);
    store32(buf + 88, (4 << 16) | 71);   # OpDecorate %13 BuiltIn GlobalInvocationId
    store32(buf + 92, 13);
    store32(buf + 96, 11);
    store32(buf + 100, 28);
    store32(buf + 104, (4 << 16) | 71);  # OpDecorate %14 Binding 0
    store32(buf + 108, 14);
    store32(buf + 112, 33);
    store32(buf + 116, 0);
    store32(buf + 120, (4 << 16) | 71);  # OpDecorate %14 DescriptorSet 0
    store32(buf + 124, 14);
    store32(buf + 128, 34);
    store32(buf + 132, 0);
    store32(buf + 136, (2 << 16) | 19);  # OpTypeVoid %1
    store32(buf + 140, 1);
    store32(buf + 144, (3 << 16) | 33);  # OpTypeFunction %2 %1
    store32(buf + 148, 2);
    store32(buf + 152, 1);
    store32(buf + 156, (4 << 16) | 21);  # OpTypeInt %3 32 0
    store32(buf + 160, 3);
    store32(buf + 164, 32);
    store32(buf + 168, 0);
    store32(buf + 172, (4 << 16) | 23);  # OpTypeVector %4 %3 3
    store32(buf + 176, 4);
    store32(buf + 180, 3);
    store32(buf + 184, 3);
    store32(buf + 188, (4 << 16) | 32);  # OpTypePointer %5 Input %4
    store32(buf + 192, 5);
    store32(buf + 196, 1);
    store32(buf + 200, 4);
    store32(buf + 204, (3 << 16) | 29);  # OpTypeRuntimeArray %6 %3
    store32(buf + 208, 6);
    store32(buf + 212, 3);
    store32(buf + 216, (3 << 16) | 30);  # OpTypeStruct %7 %6
    store32(buf + 220, 7);
    store32(buf + 224, 6);
    store32(buf + 228, (4 << 16) | 32);  # OpTypePointer %8 StorageBuffer %7
    store32(buf + 232, 8);
    store32(buf + 236, 12);
    store32(buf + 240, 7);
    store32(buf + 244, (4 << 16) | 32);  # OpTypePointer %9 StorageBuffer %3
    store32(buf + 248, 9);
    store32(buf + 252, 12);
    store32(buf + 256, 3);
    store32(buf + 260, (4 << 16) | 43);  # OpConstant %3 %10 4
    store32(buf + 264, 3);
    store32(buf + 268, 10);
    store32(buf + 272, 4);
    store32(buf + 276, (4 << 16) | 43);  # OpConstant %3 %11 16 (inline; >64 needs VOP3 literal — N.8)
    store32(buf + 280, 3);
    store32(buf + 284, 11);
    store32(buf + 288, 16);
    store32(buf + 292, (4 << 16) | 43);  # OpConstant %3 %12 0
    store32(buf + 296, 3);
    store32(buf + 300, 12);
    store32(buf + 304, 0);
    store32(buf + 308, (4 << 16) | 59);  # OpVariable %5 %13 Input
    store32(buf + 312, 5);
    store32(buf + 316, 13);
    store32(buf + 320, 1);
    store32(buf + 324, (4 << 16) | 59);  # OpVariable %8 %14 StorageBuffer
    store32(buf + 328, 8);
    store32(buf + 332, 14);
    store32(buf + 336, 12);
    store32(buf + 340, (5 << 16) | 54);  # OpFunction %1 %15 None %2
    store32(buf + 344, 1);
    store32(buf + 348, 15);
    store32(buf + 352, 0);
    store32(buf + 356, 2);
    store32(buf + 360, (2 << 16) | 248); # OpLabel %16
    store32(buf + 364, 16);
    store32(buf + 368, (4 << 16) | 61);  # OpLoad %4 %17 %13  (gid)
    store32(buf + 372, 4);
    store32(buf + 376, 17);
    store32(buf + 380, 13);
    store32(buf + 384, (5 << 16) | 81);  # OpCompositeExtract %3 %18 %17 0  (gid.x)
    store32(buf + 388, 3);
    store32(buf + 392, 18);
    store32(buf + 396, 17);
    store32(buf + 400, 0);
    store32(buf + 404, (5 << 16) | 81);  # OpCompositeExtract %3 %19 %17 1  (gid.y)
    store32(buf + 408, 3);
    store32(buf + 412, 19);
    store32(buf + 416, 17);
    store32(buf + 420, 1);
    store32(buf + 424, (5 << 16) | 132); # OpIMul %3 %20 %19 %10  (gid.y*4)
    store32(buf + 428, 3);
    store32(buf + 432, 20);
    store32(buf + 436, 19);
    store32(buf + 440, 10);
    store32(buf + 444, (5 << 16) | 128); # OpIAdd %3 %21 %20 %18  (idx = gid.y*4 + gid.x)
    store32(buf + 448, 3);
    store32(buf + 452, 21);
    store32(buf + 456, 20);
    store32(buf + 460, 18);
    store32(buf + 464, (5 << 16) | 132); # OpIMul %3 %22 %18 %11  (gid.x*16)
    store32(buf + 468, 3);
    store32(buf + 472, 22);
    store32(buf + 476, 18);
    store32(buf + 480, 11);
    store32(buf + 484, (5 << 16) | 128); # OpIAdd %3 %23 %22 %19  (val = gid.x*100 + gid.y)
    store32(buf + 488, 3);
    store32(buf + 492, 23);
    store32(buf + 496, 22);
    store32(buf + 500, 19);
    store32(buf + 504, (6 << 16) | 65);  # OpAccessChain %9 %24 %14 %12 %21  (&out[idx])
    store32(buf + 508, 9);
    store32(buf + 512, 24);
    store32(buf + 516, 14);
    store32(buf + 520, 12);
    store32(buf + 524, 21);
    store32(buf + 528, (3 << 16) | 62);  # OpStore %24 %23
    store32(buf + 532, 24);
    store32(buf + 536, 23);
    store32(buf + 540, (1 << 16) | 253); # OpReturn
    store32(buf + 544, (1 << 16) | 56);  # OpFunctionEnd
    return 548;
}

fn main(): i64 {
    alloc_init();
    print_cstr("mabda native SPIR-V 2-D/TGID dispatch e2e (N.6) on Cezanne\n");
    print_cstr("----------------------------------------------------------\n");

    var spv[640];
    var n = build_2d_kernel(&spv);

    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) { return 3; }
    var ctx = payload(ctx_res);
    var fd = native_ctx_fd(ctx);

    var shmod = gpu_shader_module_create_spirv(ctx, &spv, n);
    if (shmod == 0) { print_cstr("FAIL: shader_module_create_spirv -> 0\n"); return 2; }
    print_cstr("compiled: bindings="); print_i64(load64(shmod + NATIVE_SHMOD_NBIND));
    print_cstr(" local=("); print_i64(load64(shmod + NATIVE_SHMOD_LOCALX));
    print_cstr(","); print_i64(load64(shmod + NATIVE_SHMOD_LOCALY));
    print_cstr(","); print_i64(load64(shmod + NATIVE_SHMOD_LOCALZ)); print_cstr(")\n");

    # out BO (binding 0): 16 uints, seeded with a sentinel.
    var ob[16];
    if (native_bo_create_gtt(fd, 4096, &ob) != 0) { return 5; }
    var out_handle = load64(&ob + 0);
    var out_map = load64(&ob + 8);
    var k = 0;
    while (k < 16) { store32(out_map + k * 4, 0xBAADF00D); k = k + 1; }
    var out_va = 0xFFFF800100400000;
    if (native_gem_va_map(fd, out_handle, out_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }

    var bp[24];
    store64(&bp + 0, 1);
    store64(&bp + 8, out_handle);
    store64(&bp + 16, out_va);

    # PUBLIC API: 2x2x1 workgroup grid. LocalSize (2,2,1) comes from the module.
    var rc = gpu_compute_dispatch(ctx, shmod, 2, 2, 1, &bp);
    if (rc != 0) { print_cstr("FAIL: gpu_compute_dispatch rc="); print_i64(rc); print_cstr("\n"); return 9; }

    var ok = 1;
    var i = 0;
    while (i < 16) {
        var gx = i & 3;
        var gy = i >> 2;
        var want = gx * 16 + gy;
        var got = load32(out_map + i * 4);
        print_cstr("out["); print_i64(i); print_cstr("] (gx="); print_i64(gx);
        print_cstr(",gy="); print_i64(gy); print_cstr(") = "); print_i64(got);
        print_cstr(" (want "); print_i64(want); print_cstr(")");
        if (got != want) { print_cstr("  MISMATCH"); ok = 0; }
        print_cstr("\n");
        i = i + 1;
    }

    gpu_shader_module_release(ctx, shmod);
    native_gem_va_unmap(fd, out_handle, out_va, 4096);
    native_bo_release_gtt(fd, out_handle, out_map, 4096);
    gpu_context_release(ctx);

    if (ok == 0) { print_cstr("FAIL: 2-D dispatch mismatch\n"); return 11; }
    print_cstr("OK — 2-D/TGID compiled dispatch correct on Cezanne (16/16)\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
