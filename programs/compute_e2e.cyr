# programs/compute_e2e.cyr — Compute dispatch end-to-end GPU test
#
# Exercises the v1.0 criterion: "Compute dispatch end-to-end test".
# Upload → dispatch → readback → verify. A minimal WGSL shader doubles
# each u32 element of a storage buffer; we copy the result into a
# MAP_READ buffer and assert every element matches 2*input.
#
# Linked with deps/wgpu_main.c via the Makefile target `test-compute-e2e`.

# Full library via src/lib.cyr (canonical chain; the former selective
# include list rotted as native deps grew — v3.2 T.8).
include "src/lib.cyr"

var _gpu_preinit = 0;
var _gpu_ctx = 0;

# Output helpers. Every line's byte count comes from strlen, never a hand-counted literal:
# miscounts wrote the NUL terminator into the log or dropped the newline and glued two PASS
# lines (4.1.3 verification). The summary counts the PASS lines actually printed, so it cannot
# disagree with them; every FAIL returns non-zero at once, so "0 failed" holds by construction.
var _e2e_passes = 0;

# Write tag + msg + "\n" to fd as ONE write (a line never interleaves with wgpu's own stderr).
fn _e2e_line(fd, tag, msg): i64 {
    var line[256];
    var tl = strlen(tag);
    var ml = strlen(msg);
    if (tl > 64) { tl = 64; }
    if (tl + ml > 255) { ml = 255 - tl; }
    memcpy(&line, tag, tl);
    memcpy(&line + tl, msg, ml);
    store8(&line + tl + ml, 10);
    syscall(1, fd, &line, tl + ml + 1);
    return 0;
}
fn _pass(msg): i64 { _e2e_line(1, "PASS: ", msg); _e2e_passes = _e2e_passes + 1; return 0; }
fn _fail(msg): i64 { _e2e_line(2, "FAIL: ", msg); return 1; }

# "\n<N> passed, 0 failed\n" with N = the PASS lines printed above.
fn _e2e_summary(): i64 {
    var nb[32];
    memset(&nb, 0, 32);
    store8(&nb, 10);
    fmt_int_buf(_e2e_passes, &nb + 1);
    _e2e_line(1, &nb, " passed, 0 failed");
    return 0;
}

# Build the compute shader source — @workgroup_size(8), doubles each u32
fn _build_shader(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "@group(0) @binding(0) var<storage, read_write> ");
    str_builder_add_cstr(sb, "data: array<u32>; ");
    str_builder_add_cstr(sb, "@compute @workgroup_size(8) fn main(");
    str_builder_add_cstr(sb, "@builtin(global_invocation_id) gid: vec3<u32>) { ");
    str_builder_add_cstr(sb, "data[gid.x] = data[gid.x] * 2u; }");
    return str_cstr(str_builder_build(sb));
}

fn mabda_main(fn_table_ptr, preinit_ptr): i64 {
    color_init();
    wgpu_ffi_init_table(fn_table_ptr);
    _gpu_preinit = preinit_ptr;

    var res_tag, res = gpu_context_from_preinit(_gpu_preinit);
    if (is_err_result(res_tag) == 1) {
        _e2e_line(2, "SKIP: ", "no GPU available");
        return 0;
    }
    _gpu_ctx = res;
    var device = gpu_ctx_device(_gpu_ctx);
    var queue = gpu_ctx_queue(_gpu_ctx);
    _pass("GPU context created");

    # --- 1. Build compute pipeline (1 read-write storage binding) ---
    var wgsl = _build_shader();
    var cp = compute_pipeline_new(device, wgsl, "main", 1);
    if (cp == 0) { return _fail("compute_pipeline_new"); }
    _pass("compute pipeline created");

    # --- 2. Create storage buffer with initial [1..8] u32 values ---
    var storage_usage = WGPU_BUFFER_USAGE_STORAGE
    | WGPU_BUFFER_USAGE_COPY_DST
    | WGPU_BUFFER_USAGE_COPY_SRC;
    var storage_desc = wgpu_buffer_descriptor("compute-storage", storage_usage, 32, 0);
    var storage_buf = wgpu_device_create_buffer(device, storage_desc);
    if (storage_buf == 0) { return _fail("storage buffer create"); }

    # Initial data: [1, 2, 3, 4, 5, 6, 7, 8] as u32 — 32 bytes packed
    var input[32];
    var i = 0;
    while (i < 8) {
        store32(&input + i * 4, i + 1);
        i = i + 1;
    }
    wgpu_queue_write_buffer(queue, storage_buf, 0, &input, 32);
    _pass("storage buffer populated");

    # --- 3. Build a bind group wrapping the storage buffer ---
    var bge[56];
    wgpu_bind_group_entry_buffer(&bge, 0, storage_buf, 0, 32);
    var bg_desc = wgpu_bind_group_descriptor("compute-bg", compute_pipeline_bgl(cp), &bge, 1);
    var bg = wgpu_device_create_bind_group(device, bg_desc);
    if (bg == 0) { return _fail("bind group create"); }
    _pass("bind group created");

    # --- 4. Dispatch (1,1,1) — workgroup_size(8) covers all 8 elements ---
    var dims[12];
    store32(&dims, 1);
    store32(&dims + 4, 1);
    store32(&dims + 8, 1);
    compute_dispatch(device, queue, cp, bg, &dims);
    _pass("compute dispatch submitted");

    # --- 5. Copy storage_buf → readback_buf and map for verification ---
    var read_usage = WGPU_BUFFER_USAGE_MAP_READ | WGPU_BUFFER_USAGE_COPY_DST;
    var read_desc = wgpu_buffer_descriptor("compute-read", read_usage, 32, 0);
    var read_buf = wgpu_device_create_buffer(device, read_desc);
    if (read_buf == 0) { return _fail("readback buffer create"); }

    var enc = wgpu_device_create_command_encoder(device, "compute-copy-enc");
    if (enc == 0) { return _fail("encoder"); }
    wgpu_command_encoder_copy_buffer_to_buffer(enc, storage_buf, 0, read_buf, 0, 32);
    var cmd = wgpu_command_encoder_finish(enc, "compute-copy-cmd");
    if (cmd == 0) { return _fail("cmd buffer finish"); }
    wgpu_queue_submit_one(queue, cmd);

    var status = wgpu_buffer_map_sync(device, read_buf, WGPU_MAP_MODE_READ, 0, 32);
    if (status != WGPU_BUFFER_MAP_ASYNC_STATUS_SUCCESS) {
        return _fail("map readback");
    }
    var mapped = wgpu_buffer_get_const_mapped_range(read_buf, 0, 32);
    if (mapped == 0) { return _fail("get mapped range"); }

    # --- 6. Verify: each element should be doubled ---
    var j = 0;
    while (j < 8) {
        var got = load32(mapped + j * 4);
        var expected = (j + 1) * 2;
        if (got != expected) {
            wgpu_buffer_unmap(read_buf);
            return _fail("element mismatch (compute shader didn't run?)");
        }
        j = j + 1;
    }
    wgpu_buffer_unmap(read_buf);
    _pass("compute shader doubled every element (8/8)");

    # --- 7. Cleanup ---
    wgpu_command_encoder_release(enc);
    wgpu_bind_group_release(bg);
    wgpu_buffer_release(read_buf);
    wgpu_buffer_release(storage_buf);
    compute_pipeline_release(cp);

    _e2e_summary();
    return 0;
}
