# programs/native_multiqueue_e2e.cyr — v3.1 Q.6 headline multi-queue demo
#
# The 3.1.1 multi-queue MVP end-to-end across all three native rings,
# timeline-ordered through the public queue API + the Q.4/Q.5 primitives:
#
#   Leg 1 (COMPUTE ring):  gpu_compute_dispatch on the COMPUTE queue
#                          writes 0xDEADBEEF to buf_a, signalling the
#                          queue's timeline (point 1).
#   Leg 2 (GFX ring):      gpu_queue_barrier(COMPUTE -> GRAPHICS) records
#                          a cross-ring dependency; the next dispatch on
#                          the GRAPHICS queue carries it as an in-CS
#                          TIMELINE_WAIT, so the GFX ring runs ordered
#                          after compute -> buf_b = 0xDEADBEEF.
#   Leg 3 (DMA ring):      an SDMA COPY_LINEAR submitted on the DMA ring,
#                          waiting in-CS on the compute timeline point,
#                          CONSUMES compute's output: copies buf_a -> buf_c.
#                          (Previews the 3.1.2 public transfer-copy API;
#                          built here from the Q.4 + Q.5 primitives.)
#
# Distinct HW rings (COMPUTE=1, GFX=0, DMA=2), timeline-ordered, every
# result CPU-verified. wgpu serialized-equivalent: on wgpu all three
# logical queues alias the one WGPUQueue and run in submit order (no
# overlap) — same observable result, no real concurrency.
#
# Exit codes:
#   0  — all three legs wrote 0xDEADBEEF; cross-ring timeline ordering held
#   1  — gpu_context_new_native failed
#   2  — shader BO setup failed
#   3  — buffer setup failed
#   5  — gpu_queue_get failed
#   9  — compute leg failed
#   10 — graphics leg failed
#   11 — SDMA consume leg failed
#   12 — a readback mismatch

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}
fn print_hex32(v): i64 {
    var digits = "0123456789ABCDEF";
    var buf[10];
    store8(&buf + 0, 48);
    store8(&buf + 1, 120);
    var i = 0;
    while (i < 8) {
        var nibble = (v / (1 << ((7 - i) * 4))) & 0xF;
        store8(&buf + 2 + i, load8(digits + nibble));
        i = i + 1;
    }
    syscall(1, 1, &buf, 10);
    return 0;
}
fn mono_ns(): i64 {
    var ts[16];
    syscall(228, 1, &ts);
    return load64(&ts + 0) * 1000000000 + load64(&ts + 8);
}

fn setup_out_bo(fd, va, sentinel, out_pair): i64 {
    var bo[16];
    var rc = native_bo_create_gtt(fd, 4096, &bo);
    if (rc != 0) { return rc; }
    var handle = load64(&bo + 0);
    var map    = load64(&bo + 8);
    var si = 0;
    while (si < 1024) { store32(map + si * 4, sentinel); si = si + 1; }
    rc = native_gem_va_map(fd, handle, va, 4096, _NATIVE_PERM_DATA);
    if (rc != 0) { return rc; }
    store64(out_pair + 0, handle);
    store64(out_pair + 8, map);
    return 0;
}

fn main(): i64 {
    alloc_init();
    print_cstr("mabda native MULTI-QUEUE e2e (v3.1 Q.6)\n");
    print_cstr("---------------------------------------\n");

    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) { print_cstr("FAIL: ctx\n"); return 1; }
    var ctx = payload(ctx_res);
    var fd = native_ctx_fd(ctx);

    # Shader (deadbeef store).
    var shader_bo[16];
    var rc = native_bo_create_gtt(fd, 4096, &shader_bo);
    if (rc != 0) { print_cstr("FAIL: shader bo\n"); gpu_context_release(ctx); return 2; }
    var shader_handle = load64(&shader_bo + 0);
    var shader_map    = load64(&shader_bo + 8);
    memset(shader_map, 0, 4096);
    native_gfx9_shader_store_deadbeef(shader_map, 0);
    var shader_va = 0xFFFF800100000000;
    rc = native_gem_va_map(fd, shader_handle, shader_va, 4096, _NATIVE_PERM_SHADER);
    if (rc != 0) { print_cstr("FAIL: shader va\n"); return 2; }
    var shmod[16];
    native_buf_pair_write(&shmod, shader_handle, shader_va);

    # Three output buffers: buf_a (compute), buf_b (graphics), buf_c (SDMA dst).
    var pa[16];
    if (setup_out_bo(fd, 0xFFFF800100400000, 0xBAADF00D, &pa) != 0) {
        print_cstr("FAIL: buf_a\n"); return 3; }
    var pb[16];
    if (setup_out_bo(fd, 0xFFFF800100440000, 0xBAADF00D, &pb) != 0) {
        print_cstr("FAIL: buf_b\n"); return 3; }
    var pc[16];
    if (setup_out_bo(fd, 0xFFFF800100480000, 0xBAADF00D, &pc) != 0) {
        print_cstr("FAIL: buf_c\n"); return 3; }
    var buf_a_map = load64(&pa + 8);
    var buf_b_map = load64(&pb + 8);
    var buf_c_map = load64(&pc + 8);
    var bp_a[16];
    native_buf_pair_write(&bp_a, load64(&pa + 0), 0xFFFF800100400000);
    var bp_b[16];
    native_buf_pair_write(&bp_b, load64(&pb + 0), 0xFFFF800100440000);

    var qc = gpu_queue_get(ctx, QUEUE_KIND_COMPUTE);
    var qg = gpu_queue_get(ctx, QUEUE_KIND_GRAPHICS);
    if (qc == 0) { print_cstr("FAIL: COMPUTE queue\n"); return 5; }
    if (qg == 0) { print_cstr("FAIL: GRAPHICS queue\n"); return 5; }
    print_cstr("rings: compute="); print_i64(queue_ring(qc));
    print_cstr(" graphics="); print_i64(queue_ring(qg));
    print_cstr(" dma="); print_i64(AMDGPU_HW_IP_DMA); print_cstr("\n");

    # ---- Leg 1: compute on the COMPUTE ring ----
    gpu_ctx_set_current_queue(ctx, qc);
    rc = gpu_compute_dispatch(ctx, &shmod, 1, 1, 1, &bp_a);
    if (rc != 0) { print_cstr("FAIL: compute rc="); print_i64(rc); print_cstr("\n");
        gpu_context_release(ctx); return 9; }
    rc = gpu_queue_wait_idle(ctx, qc);
    if (rc != 0) { print_cstr("FAIL: compute wait\n"); gpu_context_release(ctx); return 9; }
    if (load32(buf_a_map + 0) != 0xDEADBEEF) { print_cstr("FAIL: buf_a\n");
        gpu_context_release(ctx); return 12; }
    print_cstr("leg 1 COMPUTE: buf_a = 0xDEADBEEF, point ");
    print_i64(queue_point(qc)); print_cstr("\n");

    # ---- Leg 2: barrier -> graphics on the GFX ring ----
    rc = gpu_queue_barrier(ctx, qc, qg);
    if (rc != 0) { print_cstr("FAIL: barrier\n"); gpu_context_release(ctx); return 10; }
    gpu_ctx_set_current_queue(ctx, qg);
    rc = gpu_compute_dispatch(ctx, &shmod, 1, 1, 1, &bp_b);
    if (rc != 0) { print_cstr("FAIL: graphics rc="); print_i64(rc); print_cstr("\n");
        gpu_context_release(ctx); return 10; }
    rc = gpu_queue_wait_idle(ctx, qg);
    if (rc != 0) { print_cstr("FAIL: graphics wait\n"); gpu_context_release(ctx); return 10; }
    if (load32(buf_b_map + 0) != 0xDEADBEEF) { print_cstr("FAIL: buf_b\n");
        gpu_context_release(ctx); return 12; }
    print_cstr("leg 2 GRAPHICS (barrier-ordered): buf_b = 0xDEADBEEF, point ");
    print_i64(queue_point(qg)); print_cstr("\n");

    # ---- Leg 3: SDMA on the DMA ring CONSUMES compute's output ----
    # Build an SDMA COPY_LINEAR buf_a -> buf_c into the (now-free) cached
    # IB, and submit on HW_IP_DMA with an in-CS TIMELINE_WAIT on the
    # compute queue's point — the DMA ring reads buf_a only after compute
    # signalled it. Previews the 3.1.2 public transfer-copy path.
    var ib_addr = native_ctx_ib_addr(ctx);
    var ib_va   = native_ctx_ib_va(ctx);
    memset(ib_addr, 0, 4096);
    var sdma_bytes = native_sdma_build_copy_linear(ib_addr,
    0xFFFF800100400000, 0xFFFF800100480000, 4096);
    var entries[32];
    store32(&entries +  0, native_ctx_fence_handle(ctx)); store32(&entries +  4, 1);
    store32(&entries +  8, native_ctx_ib_handle(ctx));    store32(&entries + 12, 10);
    store32(&entries + 16, load64(&pa + 0));              store32(&entries + 20, 3);
    store32(&entries + 24, load64(&pc + 0));              store32(&entries + 28, 3);
    var bo_list_in[24];
    store32(&bo_list_in +  0, 0xFFFFFFFF);
    store32(&bo_list_in +  4, 0xFFFFFFFF);
    store32(&bo_list_in +  8, 4);
    store32(&bo_list_in + 12, 8);
    store64(&bo_list_in + 16, &entries);
    var tbuf[8];
    if (native_syncobj_create(fd, &tbuf) != 0) { print_cstr("FAIL: transfer syncobj\n");
        gpu_context_release(ctx); return 11; }
    var transfer_so = load64(&tbuf);
    rc = native_cs_submit_timeline(fd, native_ctx_id(ctx), &bo_list_in, ib_va, sdma_bytes,
    AMDGPU_HW_IP_DMA, transfer_so, 1, queue_syncobj(qc), queue_point(qc),
    native_ctx_fence_handle(ctx), 32, 0);
    if (rc != 0) { print_cstr("FAIL: SDMA submit rc="); print_i64(rc); print_cstr("\n");
        native_syncobj_destroy(fd, transfer_so); gpu_context_release(ctx); return 11; }
    rc = native_syncobj_timeline_wait(fd, transfer_so, 1, mono_ns() + 15000000000);
    native_syncobj_destroy(fd, transfer_so);
    if (rc != 0) { print_cstr("FAIL: SDMA wait rc="); print_i64(rc); print_cstr("\n");
        gpu_context_release(ctx); return 11; }
    var vc = load32(buf_c_map + 0);
    print_cstr("leg 3 DMA (consumes buf_a): buf_c = "); print_hex32(vc); print_cstr("\n");
    if (vc != 0xDEADBEEF) { print_cstr("FAIL: buf_c (SDMA did not consume buf_a)\n");
        gpu_context_release(ctx); return 12; }

    gpu_context_release(ctx);
    print_cstr("OK — compute -> barrier -> graphics + SDMA consume, 3 rings timeline-ordered\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
