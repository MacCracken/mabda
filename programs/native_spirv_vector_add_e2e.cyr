# programs/native_spirv_vector_add_e2e.cyr — N.10: SPIR-V vec3 arithmetic compiled in-tree
# and dispatched on Cezanne, verified bit-exact (f32) vs a CPU reference.
#
# Kernel (single workgroup, LocalSize 1,1,1, CONSTANT array indices — no GlobalInvocationId):
#   vec3 va = vec3(a[0], a[1], a[2]);   // OpCompositeConstruct (80)
#   vec3 vb = vec3(b[0], b[1], b[2]);
#   vec3 vc = va + vb;                   // component-wise OpFAdd  (129) on vec3
#   vec3 vd = va * vb;                   // component-wise OpFMul  (133) on vec3
#   out[0..2] = vc.x,vc.y,vc.z;          // OpCompositeExtract (81) + OpStore (62)
#   out[3..5] = vd.x,vd.y,vd.z;
# Three StorageBuffers of runtime-array<float>: A (binding 0), B (binding 1), Out (binding 2).
# Exercises the N.10 path: OpCompositeConstruct, vec3 component-wise FAdd/FMul, OpCompositeExtract.
#
# SPIR-V is the byte-exact output of `spirv-as --target-env spv1.3` (validated with spirv-val);
# header word 2 = 0x00010300 (1.3), id-bound = 49 (< 128 compiler cap). 298 words / 1192 bytes.
#
# Inputs a=[1,2,3], b=[4,5,6] → vc=[5,7,9], vd=[4,10,18] (all exact in f32).
# Exit: 0 = correct; 2 = compile; 3/5 = setup; 9 = dispatch; 11 = mismatch.

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}
fn print_hex(n): i64 {
    var buf[16];
    var d = 0;
    while (d < 8) {
        var nib = (n >> ((7 - d) * 4)) & 0xF;
        var ch = 48 + nib;
        if (nib > 9) { ch = 87 + nib; }
        store8(&buf + d, ch);
        d = d + 1;
    }
    syscall(1, 1, &buf, 8);
    return 0;
}

# SPIR-V (1.3, id-bound 49, 1192 bytes). Byte-exact from spirv-as; round-trip verified.
