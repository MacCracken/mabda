    store32(buf + 668, 0x00000009);
    store32(buf + 672, 0x0000001C);
    store32(buf + 676, 0x0000001B);
    store32(buf + 680, 0x00060041);
    store32(buf + 684, 0x0000000C);
    store32(buf + 688, 0x0000001D);
    store32(buf + 692, 0x00000005);
    store32(buf + 696, 0x0000000E);
    store32(buf + 700, 0x0000000F);
    store32(buf + 704, 0x0004003D);
    store32(buf + 708, 0x00000009);
    store32(buf + 712, 0x0000001E);
    store32(buf + 716, 0x0000001D);
    store32(buf + 720, 0x00060041);
    store32(buf + 724, 0x0000000C);
    store32(buf + 728, 0x0000001F);
    store32(buf + 732, 0x00000005);
    store32(buf + 736, 0x0000000E);
    store32(buf + 740, 0x00000010);
    store32(buf + 744, 0x0004003D);
    store32(buf + 748, 0x00000009);
    store32(buf + 752, 0x00000020);
    store32(buf + 756, 0x0000001F);
    store32(buf + 760, 0x00060050); # OpCompositeConstruct %v3f %21 = (%a0,%a1,%a2)
    store32(buf + 764, 0x0000000A);
    store32(buf + 768, 0x00000021);
    store32(buf + 772, 0x00000016);
    store32(buf + 776, 0x00000018);
    store32(buf + 780, 0x0000001A);
    store32(buf + 784, 0x00060050); # OpCompositeConstruct %v3f %22 = (%b0,%b1,%b2)
    store32(buf + 788, 0x0000000A);
    store32(buf + 792, 0x00000022);
    store32(buf + 796, 0x0000001C);
    store32(buf + 800, 0x0000001E);
    store32(buf + 804, 0x00000020);
    store32(buf + 808, 0x00050081); # OpFAdd %v3f %23 = %21 + %22 (component-wise)
    store32(buf + 812, 0x0000000A);
    store32(buf + 816, 0x00000023);
    store32(buf + 820, 0x00000021);
    store32(buf + 824, 0x00000022);
    store32(buf + 828, 0x00050085); # OpFMul %v3f %24 = %21 * %22 (component-wise)
    store32(buf + 832, 0x0000000A);
    store32(buf + 836, 0x00000024);
    store32(buf + 840, 0x00000021);
    store32(buf + 844, 0x00000022);
    store32(buf + 848, 0x00050051); # OpCompositeExtract %f32 %25 = %23[0]
    store32(buf + 852, 0x00000009);
    store32(buf + 856, 0x00000025);
    store32(buf + 860, 0x00000023);
    store32(buf + 864, 0x00000000);
    store32(buf + 868, 0x00050051); # OpCompositeExtract %f32 %26 = %23[1]
    store32(buf + 872, 0x00000009);
    store32(buf + 876, 0x00000026);
    store32(buf + 880, 0x00000023);
    store32(buf + 884, 0x00000001);
    store32(buf + 888, 0x00050051); # OpCompositeExtract %f32 %27 = %23[2]
    store32(buf + 892, 0x00000009);
    store32(buf + 896, 0x00000027);
    store32(buf + 900, 0x00000023);
    store32(buf + 904, 0x00000002);
    store32(buf + 908, 0x00050051); # OpCompositeExtract %f32 %28 = %24[0]
    store32(buf + 912, 0x00000009);
    store32(buf + 916, 0x00000028);
    store32(buf + 920, 0x00000024);
    store32(buf + 924, 0x00000000);
    store32(buf + 928, 0x00050051); # OpCompositeExtract %f32 %29 = %24[1]
    store32(buf + 932, 0x00000009);
    store32(buf + 936, 0x00000029);
    store32(buf + 940, 0x00000024);
    store32(buf + 944, 0x00000001);
    store32(buf + 948, 0x00050051); # OpCompositeExtract %f32 %2A = %24[2]
    store32(buf + 952, 0x00000009);
    store32(buf + 956, 0x0000002A);
    store32(buf + 960, 0x00000024);
    store32(buf + 964, 0x00000002);
    store32(buf + 968, 0x00060041);
    store32(buf + 972, 0x0000000C);
    store32(buf + 976, 0x0000002B);
    store32(buf + 980, 0x00000006);
    store32(buf + 984, 0x0000000E);
    store32(buf + 988, 0x0000000E);
    store32(buf + 992, 0x0003003E); # OpStore out[0] = vc.x
    store32(buf + 996, 0x0000002B);
    store32(buf + 1000, 0x00000025);
    store32(buf + 1004, 0x00060041);
    store32(buf + 1008, 0x0000000C);
    store32(buf + 1012, 0x0000002C);
    store32(buf + 1016, 0x00000006);
    store32(buf + 1020, 0x0000000E);
    store32(buf + 1024, 0x0000000F);
    store32(buf + 1028, 0x0003003E); # OpStore out[1] = vc.y
    store32(buf + 1032, 0x0000002C);
    store32(buf + 1036, 0x00000026);
    store32(buf + 1040, 0x00060041);
    store32(buf + 1044, 0x0000000C);
    store32(buf + 1048, 0x0000002D);
    store32(buf + 1052, 0x00000006);
    store32(buf + 1056, 0x0000000E);
    store32(buf + 1060, 0x00000010);
    store32(buf + 1064, 0x0003003E); # OpStore out[2] = vc.z
    store32(buf + 1068, 0x0000002D);
    store32(buf + 1072, 0x00000027);
    store32(buf + 1076, 0x00060041);
    store32(buf + 1080, 0x0000000C);
    store32(buf + 1084, 0x0000002E);
    store32(buf + 1088, 0x00000006);
    store32(buf + 1092, 0x0000000E);
    store32(buf + 1096, 0x00000011);
    store32(buf + 1100, 0x0003003E); # OpStore out[3] = vd.x
    store32(buf + 1104, 0x0000002E);
    store32(buf + 1108, 0x00000028);
    store32(buf + 1112, 0x00060041);
    store32(buf + 1116, 0x0000000C);
    store32(buf + 1120, 0x0000002F);
    store32(buf + 1124, 0x00000006);
    store32(buf + 1128, 0x0000000E);
    store32(buf + 1132, 0x00000012);
    store32(buf + 1136, 0x0003003E); # OpStore out[4] = vd.y
    store32(buf + 1140, 0x0000002F);
    store32(buf + 1144, 0x00000029);
    store32(buf + 1148, 0x00060041);
    store32(buf + 1152, 0x0000000C);
    store32(buf + 1156, 0x00000030);
    store32(buf + 1160, 0x00000006);
    store32(buf + 1164, 0x0000000E);
    store32(buf + 1168, 0x00000013);
    store32(buf + 1172, 0x0003003E); # OpStore out[5] = vd.z
    store32(buf + 1176, 0x00000030);
    store32(buf + 1180, 0x0000002A);
    store32(buf + 1184, 0x000100FD); # OpReturn
    store32(buf + 1188, 0x00010038); # OpFunctionEnd
    return 1192;
}

fn main(): i64 {
    alloc_init();
    print_cstr("mabda native SPIR-V vec3 arithmetic e2e (N.10) on Cezanne\n");
    print_cstr("---------------------------------------------------------\n");

    var spv[2048];
    var n = build_vector_add_kernel(&spv);

    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) { return 3; }
    var ctx = payload(ctx_res);
    var fd = native_ctx_fd(ctx);

    var shmod = gpu_shader_module_create_spirv(ctx, &spv, n);
    if (shmod == 0) { print_cstr("FAIL: shader_module_create_spirv -> 0\n"); return 2; }

    # Inputs (exact small integers → exact in f32): a=[1,2,3], b=[4,5,6].
    var av[16];
    var bv[16];
    store32(&av + 0, int_ratio_to_f32(1, 1));
    store32(&av + 4, int_ratio_to_f32(2, 1));
    store32(&av + 8, int_ratio_to_f32(3, 1));
    store32(&bv + 0, int_ratio_to_f32(4, 1));
    store32(&bv + 4, int_ratio_to_f32(5, 1));
    store32(&bv + 8, int_ratio_to_f32(6, 1));

    # CPU reference (f32 bit patterns): out[0..2] = a+b = [5,7,9]; out[3..5] = a*b = [4,10,18].
    var want[32];
    store32(&want + 0,  int_ratio_to_f32(5, 1));
    store32(&want + 4,  int_ratio_to_f32(7, 1));
    store32(&want + 8,  int_ratio_to_f32(9, 1));
    store32(&want + 12, int_ratio_to_f32(4, 1));
    store32(&want + 16, int_ratio_to_f32(10, 1));
    store32(&want + 20, int_ratio_to_f32(18, 1));

    var ab[16];
    var bb[16];
    var ob[16];
    if (native_bo_create_gtt(fd, 4096, &ab) != 0) { return 5; }
    if (native_bo_create_gtt(fd, 4096, &bb) != 0) { return 5; }
    if (native_bo_create_gtt(fd, 4096, &ob) != 0) { return 5; }
    var a_handle = load64(&ab + 0); var a_map = load64(&ab + 8);
    var b_handle = load64(&bb + 0); var b_map = load64(&bb + 8);
    var o_handle = load64(&ob + 0); var o_map = load64(&ob + 8);
    var i = 0;
    while (i < 3) {
        store32(a_map + i * 4, load32(&av + i * 4));
        store32(b_map + i * 4, load32(&bv + i * 4));
        i = i + 1;
    }
    i = 0;
    while (i < 6) {
        store32(o_map + i * 4, 0xBAADF00D);
        i = i + 1;
    }
    var a_va = 0xFFFF800100400000;
    var b_va = 0xFFFF800100401000;
    var o_va = 0xFFFF800100402000;
    if (native_gem_va_map(fd, a_handle, a_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }
    if (native_gem_va_map(fd, b_handle, b_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }
    if (native_gem_va_map(fd, o_handle, o_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }

    var bp[56];
    store64(&bp + 0, 3);
    store64(&bp + 8, a_handle);  store64(&bp + 16, a_va);
    store64(&bp + 24, b_handle); store64(&bp + 32, b_va);
    store64(&bp + 40, o_handle); store64(&bp + 48, o_va);

    var rc = gpu_compute_dispatch(ctx, shmod, 1, 1, 1, &bp);
    if (rc != 0) { print_cstr("FAIL: gpu_compute_dispatch rc="); print_i64(rc); print_cstr("\n"); return 9; }

    var ok = 1;
    print_cstr("  vc = va + vb (lanes 0..2), vd = va * vb (lanes 3..5):\n");
    i = 0;
    while (i < 6) {
        var got = load32(o_map + i * 4);
        var w = load32(&want + i * 4);
        print_cstr("  out["); print_i64(i); print_cstr("] = 0x"); print_hex(got);
        if (got != w) { print_cstr("  MISMATCH want=0x"); print_hex(w); ok = 0; }
        print_cstr("\n");
        i = i + 1;
    }

    gpu_shader_module_release(ctx, shmod);
    native_gem_va_unmap(fd, a_handle, a_va, 4096);
    native_gem_va_unmap(fd, b_handle, b_va, 4096);
    native_gem_va_unmap(fd, o_handle, o_va, 4096);
    native_bo_release_gtt(fd, a_handle, a_map, 4096);
    native_bo_release_gtt(fd, b_handle, b_map, 4096);
    native_bo_release_gtt(fd, o_handle, o_map, 4096);
    gpu_context_release(ctx);

    if (ok == 0) { print_cstr("FAIL: vec3 add/mul dispatch mismatch\n"); return 11; }
    print_cstr("OK — vec3 component-wise add+mul correct on Cezanne\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
