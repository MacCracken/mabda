var N = 4096;      # elements per buffer: 64 workgroups of 64
var NB = 16384;    # bytes per buffer

# A count-prefixed 2-binding array (a = binding 0, o = binding 1) from two NativeBufs.
fn bind2(bp, a, o): i64 {
    store64(bp + 0, 2);
    store64(bp + 8, load64(a + NATIVE_BUF_FIELD_HANDLE));
    store64(bp + 16, load64(a + NATIVE_BUF_FIELD_VA));
    store64(bp + 24, load64(o + NATIVE_BUF_FIELD_HANDLE));
    store64(bp + 32, load64(o + NATIVE_BUF_FIELD_VA));
    return 0;
}

fn view_addr(g, id): i64 { return load64(rg_transient_handle(g, id) + NATIVE_BUF_FIELD_ADDR); }
fn view_va(g, id): i64 { return load64(rg_transient_handle(g, id) + NATIVE_BUF_FIELD_VA); }

# The words of `p` (n of them) that differ from base + i * step + add. Prints the first few.
fn count_bad(p, n, step, add, label): i64 {
    var bad = 0;
    for (var i = 0; i < n; i = i + 1) {
        var want = (i * step + add) & 0xFFFFFFFF;
        var got = load32(p + i * 4);
        if (got != want) {
            if (bad < 4) {
                print_cstr("  "); print_cstr(label); print_cstr("["); print_i64(i);
                print_cstr("] = "); print_i64(got); print_cstr(", want "); print_i64(want); print_cstr("\n");
            }
            bad = bad + 1;
        }
    }
    return bad;
}

fn phase_a(ctx, add): i64 {
    var g = rg_new();
    rg_aliasing(g, 1);
    var b0 = rg_add_transient_buffer(g, NB, 0, "b0");
    var b1 = rg_add_transient_buffer(g, NB, 0, "b1");
    var b2 = rg_add_transient_buffer(g, NB, 0, "b2");
    var b3 = rg_add_transient_buffer(g, NB, 0, "b3");
    var dims[12];
    store32(&dims, 64); store32(&dims + 4, 1); store32(&dims + 8, 1);
    var bp0[40];
    var bp1[40];
    var bp2[40];
    var n0 = rg_add_compute(g, add, &bp0, &dims, "n0");
    rg_node_reads(g, n0, b0);
    rg_node_writes(g, n0, b1);
    var n1 = rg_add_compute(g, add, &bp1, &dims, "n1");
    rg_node_queue(g, n1, QUEUE_KIND_GRAPHICS);
    rg_node_reads(g, n1, b1);
    rg_node_writes(g, n1, b2);
    var n2 = rg_add_compute(g, add, &bp2, &dims, "n2");
    rg_node_reads(g, n2, b2);
    rg_node_writes(g, n2, b3);
    var rc = rg_build_ctx(g, ctx);
    if (rc != 0) { print_cstr("FAIL: A build rc="); print_i64(rc); print_cstr("\n"); return 3; }
    var stats[24];
    rg_plan_aliasing_stats(g, &stats);
    print_cstr("A. chain COMPUTE -> GRAPHICS -> COMPUTE: backing "); print_i64(rg_backing_bytes(g));
    print_cstr(" bytes for "); print_i64(load64(&stats + 8)); print_cstr(" of transients\n");
    if (rg_transient_alias_of(g, b2) != b0) { print_cstr("FAIL: A: b2 does not reuse b0\n"); return 4; }
    if (rg_transient_alias_of(g, b3) != b1) { print_cstr("FAIL: A: b3 does not reuse b1\n"); return 4; }
    if (view_va(g, b2) != view_va(g, b0)) { print_cstr("FAIL: A: b2 and b0 differ in VA\n"); return 4; }
    if (rg_backing_bytes(g) != 2 * NB) { print_cstr("FAIL: A: backing is not 2 buffers\n"); return 4; }
    var v0 = rg_transient_handle(g, b0);
    var v1 = rg_transient_handle(g, b1);
    var v2 = rg_transient_handle(g, b2);
    var v3 = rg_transient_handle(g, b3);
    bind2(&bp0, v0, v1);
    bind2(&bp1, v1, v2);
    bind2(&bp2, v2, v3);
    var inp = view_addr(g, b0);
    for (var i = 0; i < N; i = i + 1) { store32(inp + i * 4, i * 7); }
    rc = rg_execute_mq(g, ctx);
    if (rc != 0) { print_cstr("FAIL: A execute rc="); print_i64(rc); print_cstr("\n"); return 5; }
    var bad = count_bad(view_addr(g, b3), N, 7, 3, "b3");
    print_cstr("  b3 = b0 + 3: "); print_i64(N - bad); print_cstr(" of "); print_i64(N); print_cstr(" right\n");
    rg_release(g);
    if (bad != 0) { print_cstr("FAIL: A\n"); return 6; }
    print_cstr("PASS: A\n");
    return 0;
}

fn phase_b(ctx, add, slow): i64 {
    var r = gpu_buffer_create(ctx, NB, 0);
    var in2 = gpu_buffer_create(ctx, NB, 0);
    if (r == 0) { print_cstr("FAIL: B buffers\n"); return 10; }
    if (in2 == 0) { print_cstr("FAIL: B buffers\n"); return 10; }
    var ra = load64(r + NATIVE_BUF_FIELD_ADDR);
    var ia = load64(in2 + NATIVE_BUF_FIELD_ADDR);
    for (var i = 0; i < N; i = i + 1) {
        store32(ra + i * 4, 0x55555555);
        store32(ia + i * 4, 1000000 + i);
    }
    var g = rg_new();
    rg_aliasing(g, 1);
    var x = rg_add_transient_buffer(g, NB, 0, "x");
    var y = rg_add_transient_buffer(g, NB, 0, "y");
    var dims[12];
    store32(&dims, 64); store32(&dims + 4, 1); store32(&dims + 8, 1);
    var bp0[40];
    var bp1[40];
    var n0 = rg_add_compute(g, slow, &bp0, &dims, "slow reader");
    rg_node_queue(g, n0, QUEUE_KIND_GRAPHICS);
    rg_node_reads(g, n0, x);
    var n1 = rg_add_compute(g, add, &bp1, &dims, "writer");
    rg_node_writes(g, n1, y);
    var rc = rg_build_ctx(g, ctx);
    if (rc != 0) { print_cstr("FAIL: B build rc="); print_i64(rc); print_cstr("\n"); return 3; }
    print_cstr("B. independent GRAPHICS reader / COMPUTE writer sharing bytes: backing ");
    print_i64(rg_backing_bytes(g)); print_cstr(" bytes\n");
    if (rg_transient_alias_of(g, y) != x) { print_cstr("FAIL: B: y does not reuse x\n"); return 4; }
    if (view_va(g, y) != view_va(g, x)) { print_cstr("FAIL: B: x and y differ in VA\n"); return 4; }
    var vx = rg_transient_handle(g, x);
    var vy = rg_transient_handle(g, y);
    bind2(&bp0, vx, r);
    bind2(&bp1, in2, vy);
    var xa = view_addr(g, x);
    for (var j = 0; j < N; j = j + 1) { store32(xa + j * 4, j * 5); }
    rc = rg_execute_mq(g, ctx);
    if (rc != 0) { print_cstr("FAIL: B execute rc="); print_i64(rc); print_cstr("\n"); return 5; }
    var bad_r = count_bad(ra, N, 5, 1, "R");
    var bad_y = count_bad(view_addr(g, y), N, 1, 1000001, "y");
    print_cstr("  R = x + 1 (read before y overwrote it): "); print_i64(N - bad_r); print_cstr(" of ");
    print_i64(N); print_cstr(" right; y: "); print_i64(N - bad_y); print_cstr(" right\n");
    rg_release(g);
    gpu_buffer_release(ctx, r);
    gpu_buffer_release(ctx, in2);
    if (bad_r != 0) { print_cstr("FAIL: B: the writer overwrote x before the reader read it\n"); return 7; }
    if (bad_y != 0) { print_cstr("FAIL: B: y is wrong\n"); return 7; }
    print_cstr("PASS: B\n");
    return 0;
}

fn phase_c(ctx): i64 {
    var fd = native_ctx_fd(ctx);
    var vs_bo[16];
    if (native_bo_create_gtt(fd, 4096, &vs_bo) != 0) { print_cstr("FAIL: vs bo\n"); return 8; }
    var vs_handle = load64(&vs_bo + 0);
    var vs_addr = load64(&vs_bo + 8);
    memset(vs_addr, 0, 4096);
    native_gfx9_shader_fullscreen_triangle_vs(vs_addr, 0);
    var vs_va = 0xFFFF800100000000;
    if (native_gem_va_map(fd, vs_handle, vs_va, 4096, _NATIVE_PERM_SHADER) != 0) {
        print_cstr("FAIL: vs va\n");
        return 8;
    }
    var vs_mod[16];
    native_buf_pair_write(&vs_mod, vs_handle, vs_va);
    var fs_bo[16];
    if (native_bo_create_gtt(fd, 4096, &fs_bo) != 0) { print_cstr("FAIL: fs bo\n"); return 8; }
    var fs_handle = load64(&fs_bo + 0);
    var fs_addr = load64(&fs_bo + 8);
    memset(fs_addr, 0, 4096);
    native_gfx9_shader_textured_sample_fs(fs_addr, 0);
    var fs_va = 0xFFFF800100001000;
    if (native_gem_va_map(fd, fs_handle, fs_va, 4096, _NATIVE_PERM_SHADER) != 0) {
        print_cstr("FAIL: fs va\n");
        return 8;
    }
    var fs_mod[16];
    native_buf_pair_write(&fs_mod, fs_handle, fs_va);
    var samp = gpu_sampler_create(ctx, NATIVE_SAMP_FILTER_POINT, NATIVE_SAMP_ADDR_CLAMP);
    var pipe = gpu_render_pipeline_create(ctx, &vs_mod, &fs_mod, 0);
    if (samp == 0) { print_cstr("FAIL: sampler\n"); return 8; }
    if (pipe == 0) { print_cstr("FAIL: pipeline\n"); return 8; }
    var both = WGPU_TEXTURE_USAGE_RENDER_ATTACHMENT | WGPU_TEXTURE_USAGE_TEXTURE_BINDING;
    var g = rg_new();
    rg_aliasing(g, 1);
    var t0 = rg_add_transient_texture(g, 64, 64, WGPU_TEXTURE_FORMAT_RGBA8_UNORM,
      WGPU_TEXTURE_USAGE_TEXTURE_BINDING, "t0");
    var t1 = rg_add_transient_texture(g, 64, 64, WGPU_TEXTURE_FORMAT_RGBA8_UNORM, both, "t1");
    var t2 = rg_add_transient_texture(g, 64, 64, WGPU_TEXTURE_FORMAT_RGBA8_UNORM, both, "t2");
    var n0 = rg_add_render(g, 0, pipe, 3, "t0 -> t1");
    rg_node_reads(g, n0, t0);
    rg_node_writes(g, n0, t1);
    var n1 = rg_add_render(g, 0, pipe, 3, "t1 -> t2");
    rg_node_reads(g, n1, t1);
    rg_node_writes(g, n1, t2);
    var rc = rg_build_ctx(g, ctx);
    if (rc != 0) { print_cstr("FAIL: C build rc="); print_i64(rc); print_cstr("\n"); return 3; }
    print_cstr("C. render-to-texture chain on GRAPHICS: backing "); print_i64(rg_backing_bytes(g));
    print_cstr(" bytes for 3 textures of 16384\n");
    if (rg_transient_alias_of(g, t2) != t0) { print_cstr("FAIL: C: t2 does not reuse t0\n"); return 4; }
    var clear = color_new(F64_0, F64_0, F64_0, F64_1);
    var rt1 = rg_transient_target(g, t1);
    var rt2 = rg_transient_target(g, t2);
    var tex0 = rg_transient_handle(g, t0);
    var tex1 = rg_transient_handle(g, t1);
    var p0 = gpu_render_pass_begin(ctx, rt1, clear);
    var p1 = gpu_render_pass_begin(ctx, rt2, clear);
    if (p0 == 0) { print_cstr("FAIL: C pass\n"); return 8; }
    if (p1 == 0) { print_cstr("FAIL: C pass\n"); return 8; }
    if (gpu_render_pass_bind_texture(ctx, p0, tex0, samp) != 0) { print_cstr("FAIL: bind\n"); return 8; }
    if (gpu_render_pass_bind_texture(ctx, p1, tex1, samp) != 0) { print_cstr("FAIL: bind\n"); return 8; }
    rg_node_set_pass(g, n0, p0);
    rg_node_set_pass(g, n1, p1);
    var pat = alloc(16384);
    for (var i = 0; i < 4096; i = i + 1) {
        var px = (i * 2654435761) & 0xFFFFFFFF;
        store32(pat + i * 4, px);
    }
    if (gpu_texture_write(ctx, tex0, pat, 16384) != 0) { print_cstr("FAIL: C upload\n"); return 8; }
    rc = rg_execute_mq(g, ctx);
    if (rc != 0) { print_cstr("FAIL: C execute rc="); print_i64(rc); print_cstr("\n"); return 5; }
    var out = load64(rt2 + NATIVE_RT_FIELD_ADDR);
    var bad = 0;
    for (var k = 0; k < 4096; k = k + 1) {
        if (load32(out + k * 4) != load32(pat + k * 4)) { bad = bad + 1; }
    }
    print_cstr("  t2 = t0's pattern: "); print_i64(4096 - bad); print_cstr(" of 4096 texels\n");
    rg_release(g);
    gpu_render_pipeline_release(ctx, pipe);
    native_gem_va_unmap(fd, fs_handle, fs_va, 4096);
    native_bo_release_gtt(fd, fs_handle, fs_addr, 4096);
    native_gem_va_unmap(fd, vs_handle, vs_va, 4096);
    native_bo_release_gtt(fd, vs_handle, vs_addr, 4096);
    if (bad != 0) { print_cstr("FAIL: C\n"); return 9; }
    print_cstr("PASS: C\n");
    return 0;
}

fn phase_d(ctx, add): i64 {
    var g = rg_new();
    rg_aliasing(g, 1);
    var ids = alloc(21 * 8);
    for (var i = 0; i < 21; i = i + 1) { store64(ids + i * 8, rg_add_transient_buffer(g, NB, 0, "b")); }
    var dims[12];
    store32(&dims, 64); store32(&dims + 4, 1); store32(&dims + 8, 1);
    var bps = alloc(20 * 40);
    for (var j = 0; j < 20; j = j + 1) {
        var n = rg_add_compute(g, add, bps + j * 40, &dims, "step");
        rg_node_reads(g, n, load64(ids + j * 8));
        rg_node_writes(g, n, load64(ids + j * 8 + 8));
    }
    var rc = rg_build_ctx(g, ctx);
    if (rc != 0) { print_cstr("FAIL: D build rc="); print_i64(rc); print_cstr("\n"); return 3; }
    print_cstr("D. a 20-node chain on COMPUTE over 21 buffers: backing "); print_i64(rg_backing_bytes(g));
    print_cstr(" bytes (21 would be "); print_i64(21 * NB); print_cstr(")\n");
    if (rg_backing_bytes(g) >= 21 * NB) { print_cstr("FAIL: D: no reuse\n"); return 4; }
    for (var k = 0; k < 20; k = k + 1) {
        var va = rg_transient_handle(g, load64(ids + k * 8));
        var vb = rg_transient_handle(g, load64(ids + k * 8 + 8));
        bind2(bps + k * 40, va, vb);
    }
    var inp = view_addr(g, load64(ids + 0));
    for (var e = 0; e < N; e = e + 1) { store32(inp + e * 4, e * 11); }
    rc = rg_execute_mq(g, ctx);
    if (rc != 0) { print_cstr("FAIL: D execute rc="); print_i64(rc); print_cstr("\n"); return 5; }
    var bad = count_bad(view_addr(g, load64(ids + 160)), N, 11, 20, "b20");
    print_cstr("  b20 = b0 + 20: "); print_i64(N - bad); print_cstr(" of "); print_i64(N); print_cstr(" right\n");
    rg_release(g);
    if (bad != 0) { print_cstr("FAIL: D\n"); return 11; }
    print_cstr("PASS: D\n");
    return 0;
}

fn main(): i64 {
    alloc_init();
    color_init();
    print_cstr("mabda render-graph backing reuse on the Cezanne (4.5.0)\n");
    print_cstr("-------------------------------------------------------\n");
    var ct, cv = gpu_context_new_native();
    if (is_err_result(ct) == 1) { print_cstr("FAIL: ctx\n"); return 1; }
    var ctx = cv;
    var spv = alloc(4096);
    var n = build_add_kernel(spv);
    var add = gpu_shader_module_create_spirv(ctx, spv, n);
    var n2 = build_slow_kernel(spv);
    var slow = gpu_shader_module_create_spirv(ctx, spv, n2);
    if (add == 0) { print_cstr("FAIL: add kernel\n"); return 2; }
    if (slow == 0) { print_cstr("FAIL: slow kernel\n"); return 2; }
    var rc = phase_a(ctx, add);
    if (rc == 0) { rc = phase_b(ctx, add, slow); }
    if (rc == 0) { rc = phase_c(ctx); }
    if (rc == 0) { rc = phase_d(ctx, add); }
    gpu_context_release(ctx);
    if (rc == 0) { print_cstr("OK — transients share one backing; every reuse waited\n"); }
    return rc;
}

var exit_code = main();
syscall(60, exit_code);
