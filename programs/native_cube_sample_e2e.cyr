# programs/native_cube_sample_e2e.cyr — v3.4 AA.5b (native cubemap sampling)
#
# The load-bearing Cezanne HW risk of the v3.4 arc: a brand-new cube image_sample
# FS (DA=1, a 3-float DIRECTION in v[4:6]) lets the TA do the cube face-selection
# + per-face u/v. This proves it works on real silicon.
#   1. native ctx + VS (fullscreen triangle).
#   2. gpu_texture_create_cube(64, RGBA8, 1); each face k filled with a distinct
#      solid color (R = 0x40 + k*0x18). Faces: +X,-X,+Y,-Y,+Z,-Z = 0..5.
#   3. For a direction d, build the cube FS with d baked in (inline-float v_movs),
#      render a fullscreen quad, and verify the RT is the major-axis face's color:
#        dir (0,0,1) -> +Z = face 4 (R 0xA0); dir (1,0,0) -> +X = face 0 (R 0x40).
#      Two directions -> two different faces proves the face-selection on HW.
#
# If this fails (TA cube sampling unreliable on gfx90c), AA.5b is gated to
# cube-storage-only (AA.5a) and gpu_caps_native_texture_cube stays 0 — flagged.
#
# Exit codes: 0 pass; 1 ctx; 2 vs; 3 create; 4 write; 5 rt/sampler; 6 fs/pipeline;
#   8 draw; 9 mismatch.

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}
fn print_hex32(v): i64 {
    var digits = "0123456789ABCDEF";
    var buf[10];
    store8(&buf + 0, 48);
    store8(&buf + 1, 120);
    var i = 0;
    while (i < 8) {
        var nibble = (v / (1 << ((7 - i) * 4))) & 0xF;
        store8(&buf + 2 + i, load8(digits + nibble));
        i = i + 1;
    }
    syscall(1, 1, &buf, 10);
    return 0;
}

# face k solid color: R = 0x40 + k*0x18, distinct per face.
fn _face_color(k): i64 {
    return ((0x40 + k * 0x18) & 0xFF) | (0x80 << 8) | (0xC0 << 16) | (0xFF << 24);
}

# Build the cube FS for direction (sx,sy,sz) (inline-float src codes), make a
# pipeline, render + read back, verify RT == face[expected_face]'s color.
# Returns 0 ok, 6 fs/pipe, 8 draw, 9 mismatch.
fn _cube_test_dir(ctx, vs_mod, fs_handle, fs_addr, fs_va, tex, sx, sy, sz, expected_face): i64 {
    var W = 64;
    var H = 64;
    memset(fs_addr, 0, 4096);
    native_gfx9_shader_cube_sample_fs(fs_addr, 0, sx, sy, sz);
    var fs_mod[16];
    native_buf_pair_write(&fs_mod, fs_handle, fs_va);
    var pipe = gpu_render_pipeline_create(ctx, vs_mod, &fs_mod, 0);
    if (pipe == 0) { return 6; }
    var rt = gpu_render_target_create_2d_rgba8(ctx, W, H);
    if (rt == 0) { return 6; }
    var rt_addr = load64(rt + NATIVE_RT_FIELD_ADDR);
    memset(rt_addr, 0x55, W * H * 4);
    var clear = color_new(F64_0, F64_0, F64_0, F64_1);
    var pass = gpu_render_pass_begin(ctx, rt, clear);
    if (pass == 0) { return 6; }
    # Bind with sampler 0 so the bind keeps the cube's create-baked S# (unnorm=0);
    # a valid sampler would rebuild it unnorm=1 and break the cube projection.
    # (Consumer-facing cube bind that auto-selects unnorm=0 is tracked, AA.5b.)
    if (gpu_render_pass_bind_texture(ctx, pass, tex, 0) != 0) {
        gpu_render_pass_end(ctx, pass); return 7;
    }
    var rc = gpu_render_pass_draw(ctx, pass, pipe, 3, 1);
    gpu_render_pass_end(ctx, pass);
    if (rc != 0) { return 8; }
    var want = _face_color(expected_face);
    var got = load32(rt_addr + (20 * W + 30) * 4);   # a mid-quad probe
    gpu_render_pipeline_release(ctx, pipe);
    gpu_render_target_release(ctx, rt);
    if (got != want) {
        print_cstr("MISMATCH face="); print_i64(expected_face);
        print_cstr(" got="); print_hex32(got); print_cstr(" want="); print_hex32(want);
        print_cstr("\n");
        return 9;
    }
    return 0;
}

fn main(): i64 {
    alloc_init();
    color_init();
    print_cstr("mabda native cubemap sample e2e (v3.4 AA.5b)\n");
    print_cstr("--------------------------------------------\n");

    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) { print_cstr("FAIL: ctx\n"); return 1; }
    var ctx = payload(ctx_res);
    var fd = native_ctx_fd(ctx);

    var vs_bo[16];
    if (native_bo_create_gtt(fd, 4096, &vs_bo) != 0) { print_cstr("FAIL: vs bo\n"); return 2; }
    var vs_handle = load64(&vs_bo + 0);
    var vs_addr   = load64(&vs_bo + 8);
    memset(vs_addr, 0, 4096);
    native_gfx9_shader_fullscreen_triangle_vs(vs_addr, 0);
    var vs_va = 0xFFFF800100000000;
    if (native_gem_va_map(fd, vs_handle, vs_va, 4096, _NATIVE_PERM_SHADER) != 0) {
        print_cstr("FAIL: vs va\n"); return 2; }
    var vs_mod[16];
    native_buf_pair_write(&vs_mod, vs_handle, vs_va);

    var fs_bo[16];
    if (native_bo_create_gtt(fd, 4096, &fs_bo) != 0) { print_cstr("FAIL: fs bo\n"); return 2; }
    var fs_handle = load64(&fs_bo + 0);
    var fs_addr   = load64(&fs_bo + 8);
    var fs_va = 0xFFFF800100001000;
    if (native_gem_va_map(fd, fs_handle, fs_va, 4096, _NATIVE_PERM_SHADER) != 0) {
        print_cstr("FAIL: fs va\n"); return 2; }
    print_cstr("PASS: VS + cube FS BOs\n");

    var S = 64;
    var FACES = 6;
    var per_face = S * S * 4;
    var tex = gpu_texture_create_cube(ctx, S, MABDA_TEXFMT_RGBA8, 1);
    if (tex == 0) { print_cstr("FAIL: create_cube\n"); return 3; }
    var src = alloc(per_face);
    var k = 0;
    while (k < FACES) {
        var c = _face_color(k);
        var i = 0;
        while (i < S * S) { store32(src + i * 4, c); i = i + 1; }
        if (gpu_texture_write_layer_level(ctx, tex, k, 0, src, per_face) != 0) {
            print_cstr("FAIL: write face\n"); return 4;
        }
        k = k + 1;
    }
    print_cstr("PASS: 6-face cube uploaded (distinct R per face)\n");

    # (s, t, faceid) = (0, 0, 4) -> face 4 (+Z). s/t any (solid face); faceid selects.
    var r4 = _cube_test_dir(ctx, &vs_mod, fs_handle, fs_addr, fs_va, tex,
    GFX9_INLINE_F32_0_0, GFX9_INLINE_F32_0_0, GFX9_INLINE_F32_4_0, 4);
    if (r4 != 0) { print_cstr("FAIL: face 4 sample\n"); return r4; }
    # (s, t, faceid) = (0, 0, 0) -> face 0 (+X).
    var r0 = _cube_test_dir(ctx, &vs_mod, fs_handle, fs_addr, fs_va, tex,
    GFX9_INLINE_F32_0_0, GFX9_INLINE_F32_0_0, GFX9_INLINE_F32_0_0, 0);
    if (r0 != 0) { print_cstr("FAIL: face 0 sample\n"); return r0; }
    print_cstr("PASS: RT == face color for faceid 4 (+Z) and faceid 0 (+X)\n");

    gpu_texture_release(ctx, tex);
    native_gem_va_unmap(fd, fs_handle, fs_va, 4096);
    native_bo_release_gtt(fd, fs_handle, fs_addr, 4096);
    native_gem_va_unmap(fd, vs_handle, vs_va, 4096);
    native_bo_release_gtt(fd, vs_handle, vs_addr, 4096);
    gpu_context_release(ctx);
    print_cstr("OK — native cubemap sampling live on Cezanne\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
