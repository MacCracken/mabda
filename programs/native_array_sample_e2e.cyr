# programs/native_array_sample_e2e.cyr — v3.4 AA.2b (native 2D-array sampling)
#
# First HW run of the native 2D-ARRAY image_load path on Cezanne: the TA reads
# the 2D_ARRAY T# (DA=1) + a 3rd VADDR (the slice) and reproduces a CHOSEN array
# layer through the public render API.
#   1. native ctx + VS (fullscreen triangle) + the 2D-array image_load FS.
#   2. gpu_texture_create_2d_array(64x64, RGBA8, 4 layers); each layer k filled
#      with pixel (x,y) = (x, y, 0xC0, 0x40+k) — distinct per layer in alpha.
#   3. For each probed layer K: gpu_render_pass_bind_texture_layer(K) + draw, then
#      verify RT[x,y] == (x, y, 0xC0, 0x40+K). Two layers (0 and 2) prove the
#      slice coordinate actually SELECTS (a wrong slice would show layer 0's alpha).
#
# Exit codes: 0 pass; 1 ctx; 2 vs bo; 3 fs bo; 4 create; 5 write; 6 rt/sampler/
#   pipeline; 7 bind; 8 draw (TDR?); 9 mismatch.

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}
fn print_hex32(v): i64 {
    var digits = "0123456789ABCDEF";
    var buf[10];
    store8(&buf + 0, 48);
    store8(&buf + 1, 120);
    var i = 0;
    while (i < 8) {
        var nibble = (v / (1 << ((7 - i) * 4))) & 0xF;
        store8(&buf + 2 + i, load8(digits + nibble));
        i = i + 1;
    }
    syscall(1, 1, &buf, 10);
    return 0;
}
fn mono_ns(): i64 {
    var ts[16];
    syscall(228, 1, &ts);
    return load64(&ts + 0) * 1000000000 + load64(&ts + 8);
}

# Expected RGBA for texel (x,y) of layer k: (x, y, 0xC0, 0x40+k), R in byte 0.
fn _texel_layer(k, x, y): i64 {
    return (x & 0xFF) | ((y & 0xFF) << 8) | (0xC0 << 16) | (((0x40 + k) & 0xFF) << 24);
}

# Render layer K + verify RT == layer K. Returns 0 ok, 8 draw fail, 9 mismatch.
fn _sample_and_verify(ctx, rt, pipe, samp, tex, k, w, h): i64 {
    var rt_addr = load64(rt + NATIVE_RT_FIELD_ADDR);
    memset(rt_addr, 0x55, w * h * 4);   # sentinel
    var clear = color_new(F64_0, F64_0, F64_0, F64_1);
    var pass = gpu_render_pass_begin(ctx, rt, clear);
    if (pass == 0) { return 8; }
    if (gpu_render_pass_bind_texture_layer(ctx, pass, tex, samp, k) != 0) {
        gpu_render_pass_end(ctx, pass); return 7;
    }
    var rc = gpu_render_pass_draw(ctx, pass, pipe, 3, 1);
    gpu_render_pass_end(ctx, pass);
    if (rc != 0) { return 8; }
    # probe corners + middle.
    var px[20];
    var py[20];
    store64(&px + 0, 0);  store64(&py + 0, 0);
    store64(&px + 8, 1);  store64(&py + 8, 0);
    store64(&px + 16, 10); store64(&py + 16, 20);
    store64(&px + 24, 63); store64(&py + 24, 63);
    var i = 0;
    while (i < 4) {
        var x = load64(&px + i * 8);
        var y = load64(&py + i * 8);
        var got = load32(rt_addr + (y * w + x) * 4);
        var want = _texel_layer(k, x, y);
        if (got != want) {
            print_cstr("MISMATCH layer="); print_i64(k);
            print_cstr(" x="); print_i64(x); print_cstr(" y="); print_i64(y);
            print_cstr(" got="); print_hex32(got); print_cstr(" want="); print_hex32(want);
            print_cstr("\n");
            return 9;
        }
        i = i + 1;
    }
    return 0;
}

fn main(): i64 {
    alloc_init();
    color_init();
    print_cstr("mabda native 2D-array sample e2e (v3.4 AA.2b)\n");
    print_cstr("---------------------------------------------\n");

    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) { print_cstr("FAIL: ctx\n"); return 1; }
    var ctx = payload(ctx_res);
    var fd = native_ctx_fd(ctx);

    # VS.
    var vs_bo[16];
    if (native_bo_create_gtt(fd, 4096, &vs_bo) != 0) { print_cstr("FAIL: vs bo\n"); return 2; }
    var vs_handle = load64(&vs_bo + 0);
    var vs_addr   = load64(&vs_bo + 8);
    memset(vs_addr, 0, 4096);
    native_gfx9_shader_fullscreen_triangle_vs(vs_addr, 0);
    var vs_va = 0xFFFF800100000000;
    if (native_gem_va_map(fd, vs_handle, vs_va, 4096, _NATIVE_PERM_SHADER) != 0) {
        print_cstr("FAIL: vs va\n"); return 2; }
    var vs_mod[16];
    native_buf_pair_write(&vs_mod, vs_handle, vs_va);

    # Array image_load FS.
    var fs_bo[16];
    if (native_bo_create_gtt(fd, 4096, &fs_bo) != 0) { print_cstr("FAIL: fs bo\n"); return 3; }
    var fs_handle = load64(&fs_bo + 0);
    var fs_addr   = load64(&fs_bo + 8);
    memset(fs_addr, 0, 4096);
    native_gfx9_shader_textured_load_array_fs(fs_addr, 0);
    var fs_va = 0xFFFF800100001000;
    if (native_gem_va_map(fd, fs_handle, fs_va, 4096, _NATIVE_PERM_SHADER) != 0) {
        print_cstr("FAIL: fs va\n"); return 3; }
    var fs_mod[16];
    native_buf_pair_write(&fs_mod, fs_handle, fs_va);
    print_cstr("PASS: VS + 2D-array image_load FS\n");

    # Array texture + per-layer distinct pattern.
    var W = 64;
    var H = 64;
    var LAYERS = 4;
    var per_slice = W * H * 4;
    var tex = gpu_texture_create_2d_array(ctx, W, H, MABDA_TEXFMT_RGBA8, LAYERS);
    if (tex == 0) { print_cstr("FAIL: create_2d_array\n"); return 4; }
    var src = alloc(per_slice);
    var k = 0;
    while (k < LAYERS) {
        var y = 0;
        while (y < H) {
            var x = 0;
            while (x < W) {
                store32(src + (y * W + x) * 4, _texel_layer(k, x, y));
                x = x + 1;
            }
            y = y + 1;
        }
        if (gpu_texture_write_layer_level(ctx, tex, k, 0, src, per_slice) != 0) {
            print_cstr("FAIL: write layer\n"); return 5;
        }
        k = k + 1;
    }
    print_cstr("PASS: 4-layer array uploaded (distinct per-layer alpha)\n");

    # RT + sampler + pipeline.
    var rt = gpu_render_target_create_2d_rgba8(ctx, W, H);
    if (rt == 0) { print_cstr("FAIL: rt\n"); return 6; }
    var samp = gpu_sampler_create(ctx, NATIVE_SAMP_FILTER_POINT, NATIVE_SAMP_ADDR_CLAMP);
    if (samp == 0) { print_cstr("FAIL: sampler\n"); return 6; }
    var pipe = gpu_render_pipeline_create(ctx, &vs_mod, &fs_mod, 0);
    if (pipe == 0) { print_cstr("FAIL: pipeline\n"); return 6; }
    print_cstr("PASS: RT + sampler + array pipeline\n");

    # Sample layer 0 then layer 2 — distinct alpha proves the slice selects.
    var t0 = mono_ns();
    var r0 = _sample_and_verify(ctx, rt, pipe, samp, tex, 0, W, H);
    if (r0 != 0) { print_cstr("FAIL: layer 0\n"); return r0; }
    var r2 = _sample_and_verify(ctx, rt, pipe, samp, tex, 2, W, H);
    if (r2 != 0) { print_cstr("FAIL: layer 2\n"); return r2; }
    var ms = (mono_ns() - t0) / 1000000;
    print_cstr("draws: "); print_i64(ms); print_cstr(" ms\n");
    print_cstr("PASS: RT[x,y] == array[layer,x,y] for layers 0 and 2\n");

    gpu_texture_release(ctx, tex);
    gpu_render_pipeline_release(ctx, pipe);
    gpu_render_target_release(ctx, rt);
    native_gem_va_unmap(fd, fs_handle, fs_va, 4096);
    native_bo_release_gtt(fd, fs_handle, fs_addr, 4096);
    native_gem_va_unmap(fd, vs_handle, vs_va, 4096);
    native_bo_release_gtt(fd, vs_handle, vs_addr, 4096);
    gpu_context_release(ctx);
    print_cstr("OK — native 2D-array sampling live on Cezanne\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
