# programs/native_spirv_f64_ldexp_e2e.cyr — v3.2 Phase F.7f.10: f64 Ldexp on Cezanne.
#
# out[lid.x] = ldexp(a[lid.x], 3) = a * 2^3 = a*8  (OpExtInst GLSL.std.450 Ldexp, f64-valid). Exercises
# the OpExtInst Ldexp wiring (-> MIR_OP_F64_LDEXP / v_ldexp_f64). The 2^k primitive a consumer needs to
# reconstruct a hand-rolled exp. Result is BIT-EXACT (ldexp is exact: just an exponent add).
# Linked native via `make test-native-spirv-f64-ldexp-e2e`. Exit: 0 pass; 2 compile; 9 dispatch; 11 mismatch.

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 { var b[32]; memset(&b, 0, 32); var l = fmt_int_buf(n, &b); syscall(1, 1, &b, l); return 0; }
fn print_hex64(v): i64 {
    var digits = "0123456789ABCDEF"; var b[18]; store8(&b + 0, 48); store8(&b + 1, 120);
    var i = 0; while (i < 16) { store8(&b + 2 + i, load8(digits + ((v >> ((15 - i) * 4)) & 0xF))); i = i + 1; }
    syscall(1, 1, &b, 18); return 0;
}
fn mono_ns(): i64 { var ts[16]; syscall(228, 1, &ts); return load64(&ts + 0) * 1000000000 + load64(&ts + 8); }

var N_LANES = 8;

fn fill_inputs(a): i64 {
    store64(a + 0 , 0x3FF0000000000000);   # 1 -> ldexp(.,3)=8
    store64(a + 8 , 0x4008000000000000);   # 3 -> ldexp(.,3)=24
    store64(a + 16, 0xC004000000000000);   # -2.5 -> ldexp(.,3)=-20
    store64(a + 24, 0x3FE0000000000000);   # 0.5 -> ldexp(.,3)=4
    store64(a + 32, 0x3FF4000000000000);   # 1.25 -> ldexp(.,3)=10
    store64(a + 40, 0xC01C000000000000);   # -7 -> ldexp(.,3)=-56
    store64(a + 48, 0x3FB999999999999A);   # 0.1 -> ldexp(.,3)=0.8
    store64(a + 56, 0x4059000000000000);   # 100 -> ldexp(.,3)=800
    return 0;
}
fn fill_wants(want): i64 {
    store64(want + 0 , 0x4020000000000000);   # ldexp(1,3) = 8
    store64(want + 8 , 0x4038000000000000);   # ldexp(3,3) = 24
    store64(want + 16, 0xC034000000000000);   # ldexp(-2.5,3) = -20
    store64(want + 24, 0x4010000000000000);   # ldexp(0.5,3) = 4
    store64(want + 32, 0x4024000000000000);   # ldexp(1.25,3) = 10
    store64(want + 40, 0xC04C000000000000);   # ldexp(-7,3) = -56
    store64(want + 48, 0x3FE999999999999A);   # ldexp(0.1,3) = 0.8
    store64(want + 56, 0x4089000000000000);   # ldexp(100,3) = 800
    return 0;
}

