fn main(): i64 {
    alloc_init();
    print_cstr("mabda native f64 Ldexp e2e (F.7f.10) — OpExtInst Ldexp on Cezanne\n");
    print_cstr("kernel: out[i] = ldexp(a[i], 3) = a*8\n\n");
    var spv[800]; var n = build_kernel(&spv);
    var types[1024]; var consts[768]; var deco[768]; var outbi[384]; var m[80];
    var vals[2048]; var instrs[1536]; var ptrs[512]; var blocks[32];
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 48, 16, 28, 48);
    var isel[1024]; var isel2[12288]; var alloc[768]; var hw[16]; var abi[64]; var cc[88];
    store64(&cc + CC_TYPES, &types); store64(&cc + CC_CONSTS, &consts); store64(&cc + CC_DECO, &deco);
    store64(&cc + CC_M, &m); store64(&cc + CC_OUTBI, &outbi); store64(&cc + CC_ISEL, &isel);
    store64(&cc + CC_ISEL2, &isel2); store64(&cc + CC_ALLOC, &alloc); store64(&cc + CC_HW, &hw);
    store64(&cc + CC_ABI, &abi); store64(&cc + CC_CAP_IDS, 32);
    var isa[1024]; memset(&isa, 0, 1024); var desc[64];
    var crc = gfx9_compile(&cc, &spv, n, &isa, &desc);
    if (crc != 0) { print_cstr("FAIL: gfx9_compile rc="); print_i64(crc); print_cstr("\n"); return 2; }
    var isa_len = load64(&desc + DESC_ISA_LEN);
    var rsrc1 = load64(&desc + DESC_RSRC1); var rsrc2 = load64(&desc + DESC_RSRC2);
    print_cstr("compiled: isa_len="); print_i64(isa_len); print_cstr("\n\n");
    var av[64]; var wv[64]; fill_inputs(&av); fill_wants(&wv);
    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) { print_cstr("FAIL: ctx\n"); return 3; }
    var ctx = payload(ctx_res); var fd = native_ctx_fd(ctx);
    var sbo[16]; if (native_bo_create_gtt(fd, 4096, &sbo) != 0) { return 5; }
    var sh = load64(&sbo + 0); var sm = load64(&sbo + 8); memset(sm, 0, 4096);
    var w = 0; while (w < isa_len) { store32(sm + w, load32(&isa + w)); w = w + 4; }
    var sva = 0xFFFF800100000000;
    if (native_gem_va_map(fd, sh, sva, 4096, _NATIVE_PERM_SHADER) != 0) { return 5; }
    var abo[16]; var obo[16];
    if (native_bo_create_gtt(fd, 4096, &abo) != 0) { return 5; }
    if (native_bo_create_gtt(fd, 4096, &obo) != 0) { return 5; }
    var ah = load64(&abo + 0); var am = load64(&abo + 8); var oh = load64(&obo + 0); var om = load64(&obo + 8);
    var i = 0; while (i < N_LANES) { store64(am + i*8, load64(&av + i*8)); store64(om + i*8, 0); i = i + 1; }
    var ava = 0xFFFF800100400000; var ova = 0xFFFF800100402000;
    if (native_gem_va_map(fd, ah, ava, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }
    if (native_gem_va_map(fd, oh, ova, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }
    var bv[32]; store64(&bv + 0, ava); store64(&bv + 8, ova);
    var bh[32]; store64(&bh + 0, ah); store64(&bh + 8, oh);
    var pm4 = native_ctx_pm4_scratch(ctx); if (pm4 == 0) { return 7; }
    memset(pm4, 0, 256);
    var pb = native_pm4_build_compute_dispatch(pm4, sva, rsrc1, rsrc2, &bv, 2, N_LANES, 1, 1, 1, 1, 1);
    var rc = native_compute_dispatch_cached_n(ctx, pm4, pb, sh, &bh, 2, mono_ns() + 15000000000);
    if (rc != 0) { print_cstr("FAIL: dispatch rc="); print_i64(rc); print_cstr("\n"); return 9; }
    print_cstr("  lane :      got (hex)        |  want = a*8 (hex)\n");
    var ok = 1; i = 0;
    while (i < N_LANES) {
        var got = load64(om + i*8); var ref = load64(&wv + i*8);
        print_cstr("  ["); print_i64(i); print_cstr("]  : "); print_hex64(got); print_cstr("  |  "); print_hex64(ref);
        if (got != ref) { print_cstr("   <-- MISMATCH"); ok = 0; }
        print_cstr("\n"); i = i + 1;
    }
    gpu_context_release(ctx);
    if (ok == 0) { print_cstr("\nFAIL: ldexp not bit-exact\n"); return 11; }
    print_cstr("\nOK — f64 Ldexp correct on Cezanne (F.7f.10)\n");
    return 0;
}
