# programs/native_gem_roundtrip.cyr — v3 Phase B.2 hardware integration
#
# Pure-Cyrius round-trip through an AMDGPU GEM buffer object. No
# libdrm, no libvulkan, no Mesa. Sequence:
#
#   open(/dev/dri/renderD128)
#   DRM_IOCTL_AMDGPU_GEM_CREATE  — allocate 4 KiB GTT BO
#   DRM_IOCTL_AMDGPU_GEM_MMAP    — get mmap offset
#   mmap(..., fd, offset)        — project BO into process address space
#   CPU write                     — deterministic byte pattern
#   CPU read                      — verify byte-identical
#   munmap / gem_close / close
#
# Not in CI (hardware-dependent). Run via `make test-native-gem-roundtrip`.
#
# Exit codes:
#   0 — success (pattern round-tripped byte-identical)
#   1 — open failed
#   2 — gem_create failed
#   3 — gem_mmap (offset query) failed
#   4 — mmap failed
#   5 — readback mismatch

include "src/lib.cyr"

fn print_cstr(s) { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n) {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}

fn main() {
    alloc_init();

    print_cstr("mabda native GEM round-trip (v3 Phase B.2)\n");
    print_cstr("------------------------------------------\n");

    var fd = native_open_render_node();
    if (fd < 0) {
        print_cstr("FAIL: open "); print_cstr(DRM_RENDER_NODE_PATH);
        print_cstr(" (errno "); print_i64(0 - fd); print_cstr(")\n");
        return 1;
    }
    print_cstr("opened fd="); print_i64(fd); print_cstr("\n");

    var size = 4096;

    # Create + mmap the BO.
    var bo[16];
    var rc = native_bo_create_gtt(fd, size, &bo);
    if (rc != 0) {
        var stage = "gem_create";
        var code = 2;
        if (load64(&bo + 0) != 0) { stage = "mmap"; code = 4; }
        print_cstr("FAIL: "); print_cstr(stage);
        print_cstr(" (errno "); print_i64(0 - rc); print_cstr(")\n");
        # If gem_create succeeded but mmap failed, we still own the handle.
        if (load64(&bo + 0) != 0) { native_gem_close(fd, load64(&bo + 0)); }
        sys_close(fd);
        return code;
    }
    var handle = load64(&bo + 0);
    var mapped = load64(&bo + 8);
    print_cstr("gem_create handle="); print_i64(handle); print_cstr("\n");
    print_cstr("mmap addr=");
    print_i64(mapped);
    print_cstr("\n");

    # Deterministic byte pattern — simple so a failure is obvious.
    # Write 4 KiB = 512 i64 slots, each slot = its index.
    var i = 0;
    while (i < size / 8) {
        store64(mapped + i * 8, i * 0x1000003);  # small mixer
        i = i + 1;
    }

    # Read back, verify every slot.
    var mismatches = 0;
    i = 0;
    while (i < size / 8) {
        if (load64(mapped + i * 8) != i * 0x1000003) {
            mismatches = mismatches + 1;
        }
        i = i + 1;
    }

    if (mismatches != 0) {
        print_cstr("FAIL: "); print_i64(mismatches);
        print_cstr(" mismatched slots of ");
        print_i64(size / 8);
        print_cstr("\n");
        native_bo_release_gtt(fd, handle, mapped, size);
        sys_close(fd);
        return 5;
    }

    print_cstr("round-trip ok: "); print_i64(size);
    print_cstr(" bytes byte-identical\n");

    native_bo_release_gtt(fd, handle, mapped, size);
    sys_close(fd);
    print_cstr("OK\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
