# programs/native_spirv_udiv_e2e.cyr — N.9b-2: u32 OpUDiv compiled in-tree (the float-
# reciprocal macro) and dispatched on Cezanne, verified over an edge matrix incl. b=0.
#
# Kernel: `out[gid.x] = a[gid.x] / b[gid.x];` (u32). LocalSize 8, one workgroup. GFX9 has
# no integer divide, so OpUDiv expands to LLVM's 19-op float-reciprocal vector macro.
# 8 curated (a,b) lanes cover: a=0, a<b, a=b, b=1 (float trap), max/2, b=0 (saturate),
# b=sign-bit. Verified against a CPU reference; b=0 pins the 0xFFFFFFFF saturate.
#
# Exit: 0 = correct; 2 = compile; 3/5 = setup; 9 = dispatch; 11 = mismatch.

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}
fn print_hex(n): i64 {
    var buf[16];
    var d = 0;
    while (d < 8) {
        var nib = (n >> ((7 - d) * 4)) & 0xF;
        var ch = 48 + nib;
        if (nib > 9) { ch = 87 + nib; }
        store8(&buf + d, ch);
        d = d + 1;
    }
    syscall(1, 1, &buf, 8);
    return 0;
}

# SPIR-V (id-bound 25, 612 bytes). %11 GlobalInvocationId; %12/%13/%14 = a/b/out at
# bindings 0/1/2; %23 = OpUDiv.
fn build_udiv_kernel(buf): i64 {
    store32(buf + 0, 0x07230203);
    store32(buf + 4, 0x00010300);
    store32(buf + 8, 0);
    store32(buf + 12, 25);
    store32(buf + 16, 0);
    store32(buf + 20, (2 << 16) | 17);   # OpCapability Shader
    store32(buf + 24, 1);
    store32(buf + 28, (3 << 16) | 14);   # OpMemoryModel Logical GLSL450
    store32(buf + 32, 0);
    store32(buf + 36, 1);
    store32(buf + 40, (6 << 16) | 15);   # OpEntryPoint GLCompute %15 "main" %11
    store32(buf + 44, 5);
    store32(buf + 48, 15);
    store32(buf + 52, 0x6E69616D);
    store32(buf + 56, 0);
    store32(buf + 60, 11);
    store32(buf + 64, (6 << 16) | 16);   # OpExecutionMode %15 LocalSize 8 1 1
    store32(buf + 68, 15);
    store32(buf + 72, 17);
    store32(buf + 76, 8);
    store32(buf + 80, 1);
    store32(buf + 84, 1);
    store32(buf + 88, (4 << 16) | 71);   # OpDecorate %11 BuiltIn GlobalInvocationId
    store32(buf + 92, 11);
    store32(buf + 96, 11);
    store32(buf + 100, 28);
    store32(buf + 104, (4 << 16) | 71);  # OpDecorate %12 Binding 0
    store32(buf + 108, 12);
    store32(buf + 112, 33);
    store32(buf + 116, 0);
    store32(buf + 120, (4 << 16) | 71);  # OpDecorate %12 DescriptorSet 0
    store32(buf + 124, 12);
    store32(buf + 128, 34);
    store32(buf + 132, 0);
    store32(buf + 136, (4 << 16) | 71);  # OpDecorate %13 Binding 1
    store32(buf + 140, 13);
    store32(buf + 144, 33);
    store32(buf + 148, 1);
    store32(buf + 152, (4 << 16) | 71);  # OpDecorate %13 DescriptorSet 0
    store32(buf + 156, 13);
    store32(buf + 160, 34);
    store32(buf + 164, 0);
    store32(buf + 168, (4 << 16) | 71);  # OpDecorate %14 Binding 2
    store32(buf + 172, 14);
    store32(buf + 176, 33);
    store32(buf + 180, 2);
    store32(buf + 184, (4 << 16) | 71);  # OpDecorate %14 DescriptorSet 0
    store32(buf + 188, 14);
    store32(buf + 192, 34);
    store32(buf + 196, 0);
    store32(buf + 200, (2 << 16) | 19);  # %1 void
    store32(buf + 204, 1);
    store32(buf + 208, (3 << 16) | 33);  # %2 fn
    store32(buf + 212, 2);
    store32(buf + 216, 1);
    store32(buf + 220, (4 << 16) | 21);  # %3 uint
    store32(buf + 224, 3);
    store32(buf + 228, 32);
    store32(buf + 232, 0);
    store32(buf + 236, (4 << 16) | 23);  # %4 v3uint
    store32(buf + 240, 4);
    store32(buf + 244, 3);
    store32(buf + 248, 3);
    store32(buf + 252, (4 << 16) | 32);  # %5 ptr Input v3uint
    store32(buf + 256, 5);
    store32(buf + 260, 1);
    store32(buf + 264, 4);
    store32(buf + 268, (3 << 16) | 29);  # %6 runtime array uint
    store32(buf + 272, 6);
    store32(buf + 276, 3);
    store32(buf + 280, (3 << 16) | 30);  # %7 struct { %6 }
    store32(buf + 284, 7);
    store32(buf + 288, 6);
    store32(buf + 292, (4 << 16) | 32);  # %8 ptr StorageBuffer struct
    store32(buf + 296, 8);
    store32(buf + 300, 12);
    store32(buf + 304, 7);
    store32(buf + 308, (4 << 16) | 32);  # %9 ptr StorageBuffer uint
    store32(buf + 312, 9);
    store32(buf + 316, 12);
    store32(buf + 320, 3);
    store32(buf + 324, (4 << 16) | 43);  # %10 const 0
    store32(buf + 328, 3);
    store32(buf + 332, 10);
    store32(buf + 336, 0);
    store32(buf + 340, (4 << 16) | 59);  # %11 gid var (Input)
    store32(buf + 344, 5);
    store32(buf + 348, 11);
    store32(buf + 352, 1);
    store32(buf + 356, (4 << 16) | 59);  # %12 a var (StorageBuffer, binding 0)
    store32(buf + 360, 8);
    store32(buf + 364, 12);
    store32(buf + 368, 12);
    store32(buf + 372, (4 << 16) | 59);  # %13 b var (StorageBuffer, binding 1)
    store32(buf + 376, 8);
    store32(buf + 380, 13);
    store32(buf + 384, 12);
    store32(buf + 388, (4 << 16) | 59);  # %14 out var (StorageBuffer, binding 2)
    store32(buf + 392, 8);
    store32(buf + 396, 14);
    store32(buf + 400, 12);
    store32(buf + 404, (5 << 16) | 54);  # OpFunction %15
    store32(buf + 408, 1);
    store32(buf + 412, 15);
    store32(buf + 416, 0);
    store32(buf + 420, 2);
    store32(buf + 424, (2 << 16) | 248); # OpLabel %16
    store32(buf + 428, 16);
    store32(buf + 432, (4 << 16) | 61);  # OpLoad %17 = gid
    store32(buf + 436, 4);
    store32(buf + 440, 17);
    store32(buf + 444, 11);
    store32(buf + 448, (5 << 16) | 81);  # OpCompositeExtract %18 = gid.x
    store32(buf + 452, 3);
    store32(buf + 456, 18);
    store32(buf + 460, 17);
    store32(buf + 464, 0);
    store32(buf + 468, (6 << 16) | 65);  # OpAccessChain %19 = &a[gid.x]
    store32(buf + 472, 9);
    store32(buf + 476, 19);
    store32(buf + 480, 12);
    store32(buf + 484, 10);
    store32(buf + 488, 18);
    store32(buf + 492, (4 << 16) | 61);  # OpLoad %20 = a[gid.x]
    store32(buf + 496, 3);
    store32(buf + 500, 20);
    store32(buf + 504, 19);
    store32(buf + 508, (6 << 16) | 65);  # OpAccessChain %21 = &b[gid.x]
    store32(buf + 512, 9);
    store32(buf + 516, 21);
    store32(buf + 520, 13);
    store32(buf + 524, 10);
    store32(buf + 528, 18);
    store32(buf + 532, (4 << 16) | 61);  # OpLoad %22 = b[gid.x]
    store32(buf + 536, 3);
    store32(buf + 540, 22);
    store32(buf + 544, 21);
    store32(buf + 548, (5 << 16) | 134); # OpUDiv %23 = a / b
    store32(buf + 552, 3);
    store32(buf + 556, 23);
    store32(buf + 560, 20);
    store32(buf + 564, 22);
    store32(buf + 568, (6 << 16) | 65);  # OpAccessChain %24 = &out[gid.x]
    store32(buf + 572, 9);
    store32(buf + 576, 24);
    store32(buf + 580, 14);
    store32(buf + 584, 10);
    store32(buf + 588, 18);
    store32(buf + 592, (3 << 16) | 62);  # OpStore %24 %23
    store32(buf + 596, 24);
    store32(buf + 600, 23);
    store32(buf + 604, (1 << 16) | 253); # OpReturn
    store32(buf + 608, (1 << 16) | 56);  # OpFunctionEnd
    return 612;
}

fn main(): i64 {
    alloc_init();
    print_cstr("mabda native SPIR-V u32 OpUDiv e2e (N.9b-2) on Cezanne\n");
    print_cstr("------------------------------------------------------\n");

    var spv[1024];
    var n = build_udiv_kernel(&spv);

    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) { return 3; }
    var ctx = payload(ctx_res);
    var fd = native_ctx_fd(ctx);

    var shmod = gpu_shader_module_create_spirv(ctx, &spv, n);
    if (shmod == 0) { print_cstr("FAIL: shader_module_create_spirv -> 0\n"); return 2; }

    # curated edge matrix (8 lanes): a, b.
    var av[32];
    var bv[32];
    store32(&av + 0, 0);          store32(&bv + 0, 5);            # 0/5 = 0
    store32(&av + 4, 10);         store32(&bv + 4, 2);            # 10/2 = 5
    store32(&av + 8, 7);          store32(&bv + 8, 7);            # 7/7 = 1
    store32(&av + 12, 5);         store32(&bv + 12, 10);          # 5/10 = 0 (a<b)
    store32(&av + 16, 0xFFFFFFFF); store32(&bv + 16, 1);          # max/1 = max (float trap)
    store32(&av + 20, 0xFFFFFFFF); store32(&bv + 20, 2);          # max/2 = 0x7FFFFFFF
    store32(&av + 24, 100);       store32(&bv + 24, 0);           # 100/0 = 0xFFFFFFFF (sat)
    store32(&av + 28, 0xFFFFFFFF); store32(&bv + 28, 0x80000000); # max/sign = 1

    var ab[16];
    var bb[16];
    var ob[16];
    if (native_bo_create_gtt(fd, 4096, &ab) != 0) { return 5; }
    if (native_bo_create_gtt(fd, 4096, &bb) != 0) { return 5; }
    if (native_bo_create_gtt(fd, 4096, &ob) != 0) { return 5; }
    var a_handle = load64(&ab + 0); var a_map = load64(&ab + 8);
    var b_handle = load64(&bb + 0); var b_map = load64(&bb + 8);
    var o_handle = load64(&ob + 0); var o_map = load64(&ob + 8);
    var i = 0;
    while (i < 8) {
        store32(a_map + i * 4, load32(&av + i * 4));
        store32(b_map + i * 4, load32(&bv + i * 4));
        store32(o_map + i * 4, 0xBAADF00D);
        i = i + 1;
    }
    var a_va = 0xFFFF800100400000;
    var b_va = 0xFFFF800100401000;
    var o_va = 0xFFFF800100402000;
    if (native_gem_va_map(fd, a_handle, a_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }
    if (native_gem_va_map(fd, b_handle, b_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }
    if (native_gem_va_map(fd, o_handle, o_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }

    var bp[56];
    store64(&bp + 0, 3);
    store64(&bp + 8, a_handle);  store64(&bp + 16, a_va);
    store64(&bp + 24, b_handle); store64(&bp + 32, b_va);
    store64(&bp + 40, o_handle); store64(&bp + 48, o_va);

    var rc = gpu_compute_dispatch(ctx, shmod, 1, 1, 1, &bp);
    if (rc != 0) { print_cstr("FAIL: gpu_compute_dispatch rc="); print_i64(rc); print_cstr("\n"); return 9; }

    var ok = 1;
    i = 0;
    while (i < 8) {
        var a = load32(&av + i * 4);
        var b = load32(&bv + i * 4);
        var got = load32(o_map + i * 4);
        var want = 0xFFFFFFFF;                 # b=0 → saturate (pinned)
        if (b != 0) { want = a / b; }
        print_cstr("  "); print_i64(a); print_cstr(" / "); print_i64(b);
        print_cstr(" = 0x"); print_hex(got);
        if (got != want) { print_cstr("  MISMATCH want=0x"); print_hex(want); ok = 0; }
        print_cstr("\n");
        i = i + 1;
    }

    gpu_shader_module_release(ctx, shmod);
    native_gem_va_unmap(fd, a_handle, a_va, 4096);
    native_gem_va_unmap(fd, b_handle, b_va, 4096);
    native_gem_va_unmap(fd, o_handle, o_va, 4096);
    native_bo_release_gtt(fd, a_handle, a_map, 4096);
    native_bo_release_gtt(fd, b_handle, b_map, 4096);
    native_bo_release_gtt(fd, o_handle, o_map, 4096);
    gpu_context_release(ctx);

    if (ok == 0) { print_cstr("FAIL: udiv dispatch mismatch\n"); return 11; }
    print_cstr("OK — u32 a/b (float-reciprocal macro) correct on Cezanne over the edge matrix\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
