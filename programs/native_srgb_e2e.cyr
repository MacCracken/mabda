# programs/native_srgb_e2e.cyr — 4.5.0: the sRGB decode of every sRGB id native AMD samples,
# checked on the Cezanne's texture unit.
#
# An sRGB id holds the same bytes as its UNORM twin; sampling it decodes R, G and B from sRGB
# to linear and leaves A alone (native_gfx9_texfmt_to_img_format gives it NUM_FORMAT_SRGB).
# Each phase uploads one 64x64 texture's bytes twice, as the UNORM id and as the sRGB id,
# samples both with point filtering through the image_sample fragment shader into an RGBA8
# render target, and checks every texel: sRGB.rgb = LUT[UNORM.rgb] and sRGB.a = UNORM.a,
# where LUT[v] = round(255 * linear(v / 255)) by the sRGB transfer function (IEC 61966-2-1).
# Ten LUT entries lie within 0.02 of a rounding tie, so a channel may differ by 1; raw
# sampling (no decode) fails this by up to 74 (byte 128 decodes to 55).
#   A. RGBA8 sRGB: every byte value 16 times per channel. The UNORM result must also equal
#      the uploaded bytes.
#   B. BC1 sRGB and C. BC3 sRGB: random blocks (any 8 / 16 bytes is a valid block).
#   D. BC7 sRGB: 32 random blocks of each mode. The UNORM result must also equal mabda's
#      CPU decode (_bc7_decode_block), so the sRGB result is checked against the CPU decode too.
#
# Exit codes: 0 pass; 1 ctx; 2 vs; 3 fs; 4 tex create; 5 upload; 6 rt; 7 sampler / pipeline;
#   8 pass begin; 9 bind; 10 draw; 11 a UNORM texel differs from its reference; 12 the sRGB
#   decode differs.
include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}
fn print_hex32(v): i64 {
    var digits = "0123456789ABCDEF";
    var buf[10];
    store8(&buf + 0, 48);
    store8(&buf + 1, 120);
    var i = 0;
    while (i < 8) {
        store8(&buf + 2 + i, load8(digits + ((v >> ((7 - i) * 4)) & 0xF)));
        i = i + 1;
    }
    syscall(1, 1, &buf, 10);
    return 0;
}

# LUT[v] = round(255 * linear(v / 255)), from IEC 61966-2-1 in f64 (scratch Python, 2026-11-17).
# 8 rows of 32 bytes.
var _SRGB_LUT_0 = "0000000000000001010101010101010101010202020202020202030303030303";
var _SRGB_LUT_1 = "04040404040505050506060606070707080808080909090a0a0a0b0b0c0c0c0d";
var _SRGB_LUT_2 = "0d0d0e0e0f0f10101111111212131314141516161717181819191a1b1b1c1d1d";
var _SRGB_LUT_3 = "1e1e1f20202122232324252526272829292a2b2c2d2d2e2f3031323333343536";
var _SRGB_LUT_4 = "3738393a3b3c3d3e3f404142434445464748494a4c4d4e4f5051525455565758";
var _SRGB_LUT_5 = "5a5b5c5d5f60616364656768696b6c6d6f707273747677797a7c7d7f80828385";
var _SRGB_LUT_6 = "86888a8b8d8e9092939597989a9c9d9fa1a3a4a6a8aaabadafb1b3b5b7b8babc";
var _SRGB_LUT_7 = "bec0c2c4c6c8caccced0d2d4d6d8dadcdee0e2e5e7e9ebedeff2f4f6f8fafdff";
var g_lut = 0;
fn _hexval(c): i64 {
    if (c >= 97) { return c - 87; }   # a..f
    return c - 48;
}
fn _lut_row(i): i64 {
    if (i == 0) { return _SRGB_LUT_0; }
    if (i == 1) { return _SRGB_LUT_1; }
    if (i == 2) { return _SRGB_LUT_2; }
    if (i == 3) { return _SRGB_LUT_3; }
    if (i == 4) { return _SRGB_LUT_4; }
    if (i == 5) { return _SRGB_LUT_5; }
    if (i == 6) { return _SRGB_LUT_6; }
    return _SRGB_LUT_7;
}
fn lut_init(): i64 {
    g_lut = alloc(256);
    var i = 0;
    while (i < 256) {
        var row = _lut_row(i / 32);
        var j = (i % 32) * 2;
        var hi = _hexval(load8(row + j));
        var lo = _hexval(load8(row + j + 1));
        store8(g_lut + i, hi * 16 + lo);
        i = i + 1;
    }
    return 0;
}

var g_rng = 0x9E3779B97F4A7C15;
fn rng_byte(): i64 {
    g_rng = (g_rng * 6364136223846793005 + 1442695040888963407) & 0xFFFFFFFFFFFFFFFF;
    return (g_rng >> 33) & 0xFF;
}

# Sample a 64x64 texture of `fmt` holding `data` (`n` bytes) into the render target and copy
# the result to `out` (64*64*4 bytes). Returns 0 or an exit code.
fn render(ctx, rt, samp, pipe, fmt, data, n, out): i64 {
    var tex = gpu_texture_create_2d_sampleable(ctx, 64, 64, fmt);
    if (tex == 0) { print_cstr("FAIL: tex create, fmt "); print_i64(fmt); print_cstr("\n"); return 4; }
    if (gpu_texture_write(ctx, tex, data, n) != 0) {
        print_cstr("FAIL: upload\n"); gpu_texture_release(ctx, tex); return 5; }
    var rt_addr = load64(rt + NATIVE_RT_FIELD_ADDR);
    memset(rt_addr, 0x55, 64 * 64 * 4);
    var clear = color_new(F64_0, F64_0, F64_0, F64_1);
    var pass = gpu_render_pass_begin(ctx, rt, clear);
    if (pass == 0) { print_cstr("FAIL: pass begin\n"); gpu_texture_release(ctx, tex); return 8; }
    if (gpu_render_pass_bind_texture(ctx, pass, tex, samp) != 0) {
        print_cstr("FAIL: bind\n");
        gpu_render_pass_end(ctx, pass);
        gpu_texture_release(ctx, tex);
        return 9;
    }
    var rc = gpu_render_pass_draw(ctx, pass, pipe, 3, 1);
    gpu_render_pass_end(ctx, pass);
    gpu_texture_release(ctx, tex);
    if (rc != 0) { print_cstr("FAIL: draw\n"); return 10; }
    memcpy(out, rt_addr, 64 * 64 * 4);
    return 0;
}

# Every texel of `srgb` against LUT applied to `ref` (RGB within 1, A exact). Prints the
# counts and the first mismatches; returns the number of failing texels.
fn check_decode(ref, srgb, label): i64 {
    var exact = 0;
    var off1 = 0;
    var bad = 0;
    var decoded = 0;
    var i = 0;
    while (i < 4096) {
        var r = load32(ref + i * 4);
        var s = load32(srgb + i * 4);
        var worst = 0;
        var c = 0;
        while (c < 3) {
            var v = (r >> (c * 8)) & 0xFF;
            var want = load8(g_lut + v) & 0xFF;
            var got = (s >> (c * 8)) & 0xFF;
            var d = got - want;
            if (d < 0) { d = 0 - d; }
            if (d > worst) { worst = d; }
            if (got != v) { decoded = decoded + 1; }
            c = c + 1;
        }
        var alpha_ok = 0;
        if (((r >> 24) & 0xFF) == ((s >> 24) & 0xFF)) { alpha_ok = 1; }
        if (worst == 0) { if (alpha_ok == 1) { exact = exact + 1; } }
        if (worst == 1) { if (alpha_ok == 1) { off1 = off1 + 1; } }
        var fail = 0;
        if (worst > 1) { fail = 1; }
        if (alpha_ok == 0) { fail = 1; }
        if (fail == 1) {
            if (bad < 6) {
                print_cstr("  "); print_cstr(label); print_cstr(" texel "); print_i64(i);
                print_cstr(": unorm "); print_hex32(r); print_cstr(" srgb "); print_hex32(s);
                print_cstr("\n");
            }
            bad = bad + 1;
        }
        i = i + 1;
    }
    print_cstr("  "); print_cstr(label); print_cstr(": 4096 texels, "); print_i64(exact);
    print_cstr(" exact, "); print_i64(off1); print_cstr(" off by 1, "); print_i64(bad);
    print_cstr(" failing; "); print_i64(decoded); print_cstr(" of 12288 colour channels changed by the decode\n");
    if (decoded == 0) { print_cstr("  "); print_cstr(label); print_cstr(": nothing was decoded\n"); return 4096; }
    return bad;
}

# The byte values whose decode was off by 1 in phase A (each value appears in all channels).
fn report_off1(ref, srgb): i64 {
    var seen = alloc(256);
    memset(seen, 0, 256);
    var i = 0;
    while (i < 4096) {
        var r = load32(ref + i * 4);
        var s = load32(srgb + i * 4);
        var c = 0;
        while (c < 3) {
            var v = (r >> (c * 8)) & 0xFF;
            if (((s >> (c * 8)) & 0xFF) != (load8(g_lut + v) & 0xFF)) { store8(seen + v, 1); }
            c = c + 1;
        }
        i = i + 1;
    }
    print_cstr("  byte values decoded 1 away from the LUT:");
    var n = 0;
    var v2 = 0;
    while (v2 < 256) {
        if (load8(seen + v2) == 1) { print_cstr(" "); print_i64(v2); n = n + 1; }
        v2 = v2 + 1;
    }
    if (n == 0) { print_cstr(" none"); }
    print_cstr("\n");
    return n;
}

fn main(): i64 {
    alloc_init();
    color_init();
    _bc7_init();
    lut_init();
    print_cstr("mabda sRGB decode vs the Cezanne's texture unit (4.5.0)\n");
    print_cstr("-------------------------------------------------------\n");
    NATIVE_TEXCOMP_SUPPORTED = MABDA_TEXCOMP_BC;
    var ct, cv = gpu_context_new_native();
    if (is_err_result(ct) == 1) { print_cstr("FAIL: ctx\n"); return 1; }
    var ctx = cv;
    var fd = native_ctx_fd(ctx);
    var vs_bo[16];
    if (native_bo_create_gtt(fd, 4096, &vs_bo) != 0) { print_cstr("FAIL: vs bo\n"); return 2; }
    var vs_handle = load64(&vs_bo + 0);
    var vs_addr = load64(&vs_bo + 8);
    memset(vs_addr, 0, 4096);
    native_gfx9_shader_fullscreen_triangle_vs(vs_addr, 0);
    var vs_va = 0xFFFF800100000000;
    if (native_gem_va_map(fd, vs_handle, vs_va, 4096, _NATIVE_PERM_SHADER) != 0) {
        print_cstr("FAIL: vs va\n");
        return 2;
    }
    var vs_mod[16];
    native_buf_pair_write(&vs_mod, vs_handle, vs_va);
    var fs_bo[16];
    if (native_bo_create_gtt(fd, 4096, &fs_bo) != 0) { print_cstr("FAIL: fs bo\n"); return 3; }
    var fs_handle = load64(&fs_bo + 0);
    var fs_addr = load64(&fs_bo + 8);
    memset(fs_addr, 0, 4096);
    native_gfx9_shader_textured_sample_fs(fs_addr, 0);
    var fs_va = 0xFFFF800100001000;
    if (native_gem_va_map(fd, fs_handle, fs_va, 4096, _NATIVE_PERM_SHADER) != 0) {
        print_cstr("FAIL: fs va\n");
        return 3;
    }
    var fs_mod[16];
    native_buf_pair_write(&fs_mod, fs_handle, fs_va);
    var rt = gpu_render_target_create_2d_rgba8(ctx, 64, 64);
    if (rt == 0) { print_cstr("FAIL: rt\n"); return 6; }
    var samp = gpu_sampler_create(ctx, NATIVE_SAMP_FILTER_POINT, NATIVE_SAMP_ADDR_CLAMP);
    var pipe = gpu_render_pipeline_create(ctx, &vs_mod, &fs_mod, 0);
    if (samp == 0) { print_cstr("FAIL: sampler\n"); return 7; }
    if (pipe == 0) { print_cstr("FAIL: pipeline\n"); return 7; }

    var data = alloc(64 * 64 * 4);
    var raw = alloc(64 * 64 * 4);
    var dec = alloc(64 * 64 * 4);
    var rc = 0;

    # A. RGBA8 sRGB
    var i = 0;
    while (i < 4096) {
        var r = i & 0xFF;
        var g = (i * 37 + 11) & 0xFF;
        var b = (i * 101 + 200) & 0xFF;
        var a = (i * 13 + 5) & 0xFF;
        store32(data + i * 4, r | (g << 8) | (b << 16) | (a << 24));
        i = i + 1;
    }
    var e = render(ctx, rt, samp, pipe, MABDA_TEXFMT_RGBA8, data, 16384, raw);
    if (e != 0) { return e; }
    if (memeq(raw, data, 16384) == 0) { print_cstr("FAIL: A: RGBA8 UNORM does not sample as uploaded\n"); return 11; }
    e = render(ctx, rt, samp, pipe, MABDA_TEXFMT_RGBA8_SRGB, data, 16384, dec);
    if (e != 0) { return e; }
    print_cstr("A. RGBA8 sRGB\n");
    var bad = check_decode(raw, dec, "A");
    report_off1(raw, dec);
    if (bad != 0) { print_cstr("FAIL: A\n"); rc = 12; }
    if (bad == 0) { print_cstr("PASS: A\n"); }

    # B. BC1 sRGB (16x16 blocks of 8 B)
    i = 0;
    while (i < 2048) { store8(data + i, rng_byte()); i = i + 1; }
    e = render(ctx, rt, samp, pipe, MABDA_TEXFMT_BC1, data, 2048, raw);
    if (e != 0) { return e; }
    e = render(ctx, rt, samp, pipe, MABDA_TEXFMT_BC1_SRGB, data, 2048, dec);
    if (e != 0) { return e; }
    print_cstr("B. BC1 sRGB\n");
    bad = check_decode(raw, dec, "B");
    if (bad != 0) { print_cstr("FAIL: B\n"); rc = 12; }
    if (bad == 0) { print_cstr("PASS: B\n"); }

    # C. BC3 sRGB (16x16 blocks of 16 B)
    i = 0;
    while (i < 4096) { store8(data + i, rng_byte()); i = i + 1; }
    e = render(ctx, rt, samp, pipe, MABDA_TEXFMT_BC3, data, 4096, raw);
    if (e != 0) { return e; }
    e = render(ctx, rt, samp, pipe, MABDA_TEXFMT_BC3_SRGB, data, 4096, dec);
    if (e != 0) { return e; }
    print_cstr("C. BC3 sRGB\n");
    bad = check_decode(raw, dec, "C");
    if (bad != 0) { print_cstr("FAIL: C\n"); rc = 12; }
    if (bad == 0) { print_cstr("PASS: C\n"); }

    # D. BC7 sRGB: block k is mode k % 8 (m zero bits, a one, then random bits)
    var k = 0;
    while (k < 256) {
        var blk = data + k * 16;
        var j = 0;
        while (j < 16) { store8(blk + j, rng_byte()); j = j + 1; }
        var m = k % 8;
        var keep = 0xFF - ((1 << (m + 1)) - 1);
        store8(blk, (load8(blk) & keep) | (1 << m));
        k = k + 1;
    }
    e = render(ctx, rt, samp, pipe, MABDA_TEXFMT_BC7, data, 4096, raw);
    if (e != 0) { return e; }
    var cpu = alloc(64 * 64 * 4);
    var blkdec[64];
    k = 0;
    while (k < 256) {
        _bc7_decode_block(data + k * 16, &blkdec);
        var t = 0;
        while (t < 16) {
            var x = (k % 16) * 4 + (t % 4);
            var y = (k / 16) * 4 + (t / 4);
            store32(cpu + (y * 64 + x) * 4, load32(&blkdec + t * 4));
            t = t + 1;
        }
        k = k + 1;
    }
    if (memeq(raw, cpu, 16384) == 0) { print_cstr("FAIL: D: BC7 UNORM differs from the CPU decode\n"); return 11; }
    e = render(ctx, rt, samp, pipe, MABDA_TEXFMT_BC7_SRGB, data, 4096, dec);
    if (e != 0) { return e; }
    print_cstr("D. BC7 sRGB (the UNORM result equals the CPU decode)\n");
    bad = check_decode(cpu, dec, "D");
    if (bad != 0) { print_cstr("FAIL: D\n"); rc = 12; }
    if (bad == 0) { print_cstr("PASS: D\n"); }

    gpu_render_pipeline_release(ctx, pipe);
    gpu_render_target_release(ctx, rt);
    native_gem_va_unmap(fd, fs_handle, fs_va, 4096);
    native_bo_release_gtt(fd, fs_handle, fs_addr, 4096);
    native_gem_va_unmap(fd, vs_handle, vs_va, 4096);
    native_bo_release_gtt(fd, vs_handle, vs_addr, 4096);
    gpu_context_release(ctx);
    if (rc == 0) { print_cstr("OK — the Cezanne decodes every native sRGB id\n"); }
    return rc;
}

var exit_code = main();
syscall(60, exit_code);
