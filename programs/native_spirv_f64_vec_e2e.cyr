# programs/native_spirv_f64_vec_e2e.cyr — v3.2 Phase F.7f.4: compiled array<dvec2> add on Cezanne.
#
# An f64-VECTOR SPIR-V kernel — out[lid.x] = a[lid.x] + b[lid.x] over three array<dvec2> bindings —
# compiled in-tree (gfx9_compile) and dispatched (8 threads). This is the HW verification the F.7e
# review tracked: it exercises the f64 access-chain stride (std430 dvec2 = 16 bytes) + the vec
# load/store per-component offset (i*8, the F.7e i*esize fix) + the scalarized component-wise
# V_ADD_F64. Each dvec2 element is 16 bytes (two f64 lanes, x at +0, y at +8). The result is
# reproduced IN-PROCESS with f64_add per component, so the GPU must match bit-for-bit; a wrong
# stride/offset would mis-address and the comparison would catch it.
#
# Linked native (renderD128) via `make test-native-spirv-f64-vec-e2e`.
# Exit: 0 = all 8 lanes (x,y) bit-exact; 2 = compile; 3 = ctx; 5 = BO setup; 9 = dispatch; 11 = mismatch.

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}
fn print_hex64(v): i64 {
    var digits = "0123456789ABCDEF";
    var buf[18];
    store8(&buf + 0, 48);
    store8(&buf + 1, 120);
    var i = 0;
    while (i < 16) {
        var nib = (v >> ((15 - i) * 4)) & 0xF;
        store8(&buf + 2 + i, load8(digits + nib));
        i = i + 1;
    }
    syscall(1, 1, &buf, 18);
    return 0;
}

fn mono_ns(): i64 {
    var ts[16];
    syscall(228, 1, &ts);
    return load64(&ts + 0) * 1000000000 + load64(&ts + 8);
}

var N_LANES = 8;

# Seed a/b as 8 dvec2 elements (16 bytes each: .x at +0, .y at +8) of varied finite f64 values.
fn fill_inputs(a, b): i64 {
    var i = 0;
    while (i < N_LANES) {
        # .x lanes from one set, .y from another, so x and y differ (catches a swapped component).
        store64(a + i * 16 + 0, 0x3FB999999999999A);   # a.x = 0.1
        store64(a + i * 16 + 8, 0x4000000000000000);   # a.y = 2.0
        store64(b + i * 16 + 0, 0x3FD3333333333333);   # b.x = 0.3
        store64(b + i * 16 + 8, 0x4008000000000000);   # b.y = 3.0
        i = i + 1;
    }
    # vary a couple lanes so a missing per-lane stride (all lanes reading element 0) is caught.
    store64(a + 1 * 16 + 0, 0x4010000000000000);       # lane1 a.x = 4.0
    store64(a + 2 * 16 + 8, 0xC00C000000000000);       # lane2 a.y = -3.5
    return 0;
}

# The array<dvec2> add SPIR-V (spirv-as spv1.3, spirv-val-clean; 162 words / 648 bytes; id-bound 27).
# out[lid.x] = a[lid.x] + b[lid.x]; 3 StorageBuffer bindings of struct{ dvec2 v[]; }.
fn build_f64_vec_kernel(buf): i64 {
    store32(buf + 0, 0x07230203);
    store32(buf + 4, 0x00010300);
    store32(buf + 8, 0x00070000);
    store32(buf + 12, 0x0000001B);
    store32(buf + 16, 0x00000000);
    store32(buf + 20, 0x00020011);
    store32(buf + 24, 0x00000001);
    store32(buf + 28, 0x00020011);
    store32(buf + 32, 0x0000000A);
    store32(buf + 36, 0x0003000E);
    store32(buf + 40, 0x00000000);
    store32(buf + 44, 0x00000001);
    store32(buf + 48, 0x0006000F);
    store32(buf + 52, 0x00000005);
    store32(buf + 56, 0x00000001);
    store32(buf + 60, 0x6E69616D);
    store32(buf + 64, 0x00000000);
    store32(buf + 68, 0x00000002);
    store32(buf + 72, 0x00060010);
    store32(buf + 76, 0x00000001);
    store32(buf + 80, 0x00000011);
    store32(buf + 84, 0x00000008);
    store32(buf + 88, 0x00000001);
    store32(buf + 92, 0x00000001);
    store32(buf + 96, 0x00040047);
    store32(buf + 100, 0x00000002);
    store32(buf + 104, 0x0000000B);
    store32(buf + 108, 0x0000001B);
    store32(buf + 112, 0x00040047);
    store32(buf + 116, 0x00000003);
    store32(buf + 120, 0x00000021);
    store32(buf + 124, 0x00000000);
    store32(buf + 128, 0x00040047);
    store32(buf + 132, 0x00000003);
    store32(buf + 136, 0x00000022);
    store32(buf + 140, 0x00000000);
    store32(buf + 144, 0x00040047);
    store32(buf + 148, 0x00000004);
    store32(buf + 152, 0x00000021);
    store32(buf + 156, 0x00000001);
    store32(buf + 160, 0x00040047);
    store32(buf + 164, 0x00000004);
    store32(buf + 168, 0x00000022);
    store32(buf + 172, 0x00000000);
    store32(buf + 176, 0x00040047);
    store32(buf + 180, 0x00000005);
    store32(buf + 184, 0x00000021);
    store32(buf + 188, 0x00000002);
    store32(buf + 192, 0x00040047);
    store32(buf + 196, 0x00000005);
    store32(buf + 200, 0x00000022);
    store32(buf + 204, 0x00000000);
    store32(buf + 208, 0x00020013);
    store32(buf + 212, 0x00000006);
    store32(buf + 216, 0x00030021);
    store32(buf + 220, 0x00000007);
    store32(buf + 224, 0x00000006);
    store32(buf + 228, 0x00040015);
    store32(buf + 232, 0x00000008);
    store32(buf + 236, 0x00000020);
    store32(buf + 240, 0x00000000);
    store32(buf + 244, 0x00040017);
    store32(buf + 248, 0x00000009);
    store32(buf + 252, 0x00000008);
    store32(buf + 256, 0x00000003);
    store32(buf + 260, 0x00040020);
    store32(buf + 264, 0x0000000A);
    store32(buf + 268, 0x00000001);
    store32(buf + 272, 0x00000009);
    store32(buf + 276, 0x00030016);
    store32(buf + 280, 0x0000000B);
    store32(buf + 284, 0x00000040);
    store32(buf + 288, 0x00040017);
    store32(buf + 292, 0x0000000C);
    store32(buf + 296, 0x0000000B);
    store32(buf + 300, 0x00000002);
    store32(buf + 304, 0x0003001D);
    store32(buf + 308, 0x0000000D);
    store32(buf + 312, 0x0000000C);
    store32(buf + 316, 0x0003001E);
    store32(buf + 320, 0x0000000E);
    store32(buf + 324, 0x0000000D);
    store32(buf + 328, 0x00040020);
    store32(buf + 332, 0x0000000F);
    store32(buf + 336, 0x0000000C);
    store32(buf + 340, 0x0000000E);
    store32(buf + 344, 0x00040020);
    store32(buf + 348, 0x00000010);
    store32(buf + 352, 0x0000000C);
    store32(buf + 356, 0x0000000C);
    store32(buf + 360, 0x0004002B);
    store32(buf + 364, 0x00000008);
    store32(buf + 368, 0x00000011);
    store32(buf + 372, 0x00000000);
    store32(buf + 376, 0x0004003B);
    store32(buf + 380, 0x0000000A);
    store32(buf + 384, 0x00000002);
    store32(buf + 388, 0x00000001);
    store32(buf + 392, 0x0004003B);
    store32(buf + 396, 0x0000000F);
    store32(buf + 400, 0x00000003);
    store32(buf + 404, 0x0000000C);
    store32(buf + 408, 0x0004003B);
    store32(buf + 412, 0x0000000F);
    store32(buf + 416, 0x00000004);
    store32(buf + 420, 0x0000000C);
    store32(buf + 424, 0x0004003B);
    store32(buf + 428, 0x0000000F);
    store32(buf + 432, 0x00000005);
    store32(buf + 436, 0x0000000C);
    store32(buf + 440, 0x00050036);
    store32(buf + 444, 0x00000006);
    store32(buf + 448, 0x00000001);
    store32(buf + 452, 0x00000000);
    store32(buf + 456, 0x00000007);
    store32(buf + 460, 0x000200F8);
    store32(buf + 464, 0x00000012);
    store32(buf + 468, 0x0004003D);
    store32(buf + 472, 0x00000009);
    store32(buf + 476, 0x00000013);
    store32(buf + 480, 0x00000002);
    store32(buf + 484, 0x00050051);
    store32(buf + 488, 0x00000008);
    store32(buf + 492, 0x00000014);
    store32(buf + 496, 0x00000013);
    store32(buf + 500, 0x00000000);
    store32(buf + 504, 0x00060041);
    store32(buf + 508, 0x00000010);
    store32(buf + 512, 0x00000015);
    store32(buf + 516, 0x00000003);
    store32(buf + 520, 0x00000011);
    store32(buf + 524, 0x00000014);
    store32(buf + 528, 0x0004003D);
    store32(buf + 532, 0x0000000C);
    store32(buf + 536, 0x00000016);
    store32(buf + 540, 0x00000015);
    store32(buf + 544, 0x00060041);
    store32(buf + 548, 0x00000010);
    store32(buf + 552, 0x00000017);
    store32(buf + 556, 0x00000004);
    store32(buf + 560, 0x00000011);
    store32(buf + 564, 0x00000014);
    store32(buf + 568, 0x0004003D);
    store32(buf + 572, 0x0000000C);
    store32(buf + 576, 0x00000018);
    store32(buf + 580, 0x00000017);
    store32(buf + 584, 0x00050081);
    store32(buf + 588, 0x0000000C);
    store32(buf + 592, 0x00000019);
    store32(buf + 596, 0x00000016);
    store32(buf + 600, 0x00000018);
    store32(buf + 604, 0x00060041);
    store32(buf + 608, 0x00000010);
    store32(buf + 612, 0x0000001A);
    store32(buf + 616, 0x00000005);
    store32(buf + 620, 0x00000011);
    store32(buf + 624, 0x00000014);
    store32(buf + 628, 0x0003003E);
    store32(buf + 632, 0x0000001A);
    store32(buf + 636, 0x00000019);
    store32(buf + 640, 0x000100FD);
    store32(buf + 644, 0x00010038);
    return 648;
}

fn main(): i64 {
    alloc_init();
    print_cstr("mabda native COMPILED array<dvec2> add e2e (v3.2 F.7f.4) — f64 vectors on Cezanne\n");
    print_cstr("---------------------------------------------------------------------------\n");
    print_cstr("kernel: out[i] = a[i] + b[i]  (dvec2; verifies the F.7e f64 stride + i*8 offset)\n\n");

    var spv[800];
    var n = build_f64_vec_kernel(&spv);

    # cap_ids=64: dvec2 scalarizes to ~2x the MIR values/instrs of a scalar kernel — size the
    # id-indexed buffers accordingly (vals 64*40, alloc 64*16, instrs 64*24) or the memsets corrupt.
    var types[1024];
    var consts[768];
    var deco[768];
    var outbi[512];
    var m[80];
    var vals[2560];
    var instrs[1536];
    var ptrs[384];
    var blocks[64];
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 64, 24, 27, 64);
    var isel[2048];
    var isel2[2048];
    var alloc[1024];
    var hw[16];
    var abi[64];
    var cc[88];
    store64(&cc + CC_TYPES, &types);
    store64(&cc + CC_CONSTS, &consts);
    store64(&cc + CC_DECO, &deco);
    store64(&cc + CC_M, &m);
    store64(&cc + CC_OUTBI, &outbi);
    store64(&cc + CC_ISEL, &isel);
    store64(&cc + CC_ISEL2, &isel2);
    store64(&cc + CC_ALLOC, &alloc);
    store64(&cc + CC_HW, &hw);
    store64(&cc + CC_ABI, &abi);
    store64(&cc + CC_CAP_IDS, 32);
    var isa[1024];
    memset(&isa, 0, 1024);
    var desc[64];
    var crc = gfx9_compile(&cc, &spv, n, &isa, &desc);
    if (crc != 0) { print_cstr("FAIL: gfx9_compile rc="); print_i64(crc); print_cstr("\n"); return 2; }
    var isa_len = load64(&desc + DESC_ISA_LEN);
    var rsrc1 = load64(&desc + DESC_RSRC1);
    var rsrc2 = load64(&desc + DESC_RSRC2);
    print_cstr("compiled: isa_len="); print_i64(isa_len);
    print_cstr(" bindings="); print_i64(load64(&desc + DESC_NUM_BINDINGS)); print_cstr("\n\n");

    var av[256];
    var bv[256];
    fill_inputs(&av, &bv);

    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) { print_cstr("FAIL: gpu_context_new_native\n"); return 3; }
    var ctx = payload(ctx_res);
    var fd = native_ctx_fd(ctx);

    var shader_bo[16];
    if (native_bo_create_gtt(fd, 4096, &shader_bo) != 0) { return 5; }
    var shader_handle = load64(&shader_bo + 0);
    var shader_map    = load64(&shader_bo + 8);
    memset(shader_map, 0, 4096);
    var w = 0;
    while (w < isa_len) { store32(shader_map + w, load32(&isa + w)); w = w + 4; }
    var shader_va = 0xFFFF800100000000;
    if (native_gem_va_map(fd, shader_handle, shader_va, 4096, _NATIVE_PERM_SHADER) != 0) { return 5; }

    var abo[16]; var bbo[16]; var obo[16];
    if (native_bo_create_gtt(fd, 4096, &abo) != 0) { return 5; }
    if (native_bo_create_gtt(fd, 4096, &bbo) != 0) { return 5; }
    if (native_bo_create_gtt(fd, 4096, &obo) != 0) { return 5; }
    var a_handle = load64(&abo + 0); var a_map = load64(&abo + 8);
    var b_handle = load64(&bbo + 0); var b_map = load64(&bbo + 8);
    var o_handle = load64(&obo + 0); var o_map = load64(&obo + 8);
    # 16 bytes per dvec2 element.
    var i = 0;
    while (i < N_LANES * 2) {
        store64(a_map + i * 8, load64(&av + i * 8));
        store64(b_map + i * 8, load64(&bv + i * 8));
        i = i + 1;
    }
    i = 0;
    while (i < N_LANES * 2) { store64(o_map + i * 8, 0xBAADF00DBAADF00D); i = i + 1; }
    var a_va = 0xFFFF800100400000;
    var b_va = 0xFFFF800100402000;
    var o_va = 0xFFFF800100404000;
    if (native_gem_va_map(fd, a_handle, a_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }
    if (native_gem_va_map(fd, b_handle, b_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }
    if (native_gem_va_map(fd, o_handle, o_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }

    var bind_vas[32];
    store64(&bind_vas + 0,  a_va);
    store64(&bind_vas + 8,  b_va);
    store64(&bind_vas + 16, o_va);
    var bind_handles[32];
    store64(&bind_handles + 0,  a_handle);
    store64(&bind_handles + 8,  b_handle);
    store64(&bind_handles + 16, o_handle);

    var pm4 = native_ctx_pm4_scratch(ctx);
    if (pm4 == 0) { return 7; }
    memset(pm4, 0, 256);
    var pm4_bytes = native_pm4_build_compute_dispatch(pm4, shader_va, rsrc1, rsrc2,
      &bind_vas, 3, N_LANES, 1, 1, 1, 1, 1);

    var deadline = mono_ns() + 15000000000;
    var rc = native_compute_dispatch_cached_n(ctx, pm4, pm4_bytes, shader_handle,
      &bind_handles, 3, deadline);
    if (rc != 0) { print_cstr("FAIL: dispatch rc="); print_i64(rc); print_cstr("\n"); return 9; }

    print_cstr("  lane :  out.x (got | ref)            out.y (got | ref)\n");
    var ok = 1;
    i = 0;
    while (i < N_LANES) {
        var gx = load64(o_map + i * 16 + 0);
        var gy = load64(o_map + i * 16 + 8);
        var rx = f64_add(load64(&av + i * 16 + 0), load64(&bv + i * 16 + 0));
        var ry = f64_add(load64(&av + i * 16 + 8), load64(&bv + i * 16 + 8));
        print_cstr("  ["); print_i64(i); print_cstr("]  : ");
        print_hex64(gx); print_cstr(" "); print_hex64(rx); print_cstr("   ");
        print_hex64(gy); print_cstr(" "); print_hex64(ry);
        if (gx != rx) { print_cstr("  <-- X MISMATCH"); ok = 0; }
        if (gy != ry) { print_cstr("  <-- Y MISMATCH"); ok = 0; }
        print_cstr("\n");
        i = i + 1;
    }

    native_gem_va_unmap(fd, a_handle, a_va, 4096);
    native_gem_va_unmap(fd, b_handle, b_va, 4096);
    native_gem_va_unmap(fd, o_handle, o_va, 4096);
    native_gem_va_unmap(fd, shader_handle, shader_va, 4096);
    native_bo_release_gtt(fd, a_handle, a_map, 4096);
    native_bo_release_gtt(fd, b_handle, b_map, 4096);
    native_bo_release_gtt(fd, o_handle, o_map, 4096);
    native_bo_release_gtt(fd, shader_handle, shader_map, 4096);
    gpu_context_release(ctx);

    if (ok == 0) { print_cstr("\nFAIL: compiled array<dvec2> add not bit-exact (stride/offset?)\n"); return 11; }
    print_cstr("\nOK — all 8 lanes (x,y) BIT-EXACT: compiled array<dvec2> add on Cezanne (F.7f.4)\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
