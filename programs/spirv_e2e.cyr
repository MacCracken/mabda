# Render the triangle with `module` into `read_buf` (MAP_READ, 256x256 RGBA8).
# Returns 0 on success, 1 on any failure.
fn _render(device, queue, module, read_buf): i64 {
    var W = 256;
    var H = 256;
    var target = texture_create_render_target_rgba8(device, W, H, "spv-rt");
    if (target == 0) { return 1; }
    var view = texture_view_create_rgba8(target, "spv-view");
    if (view == 0) { return 1; }
    var rp = render_pipeline_create_simple(device, module, WGPU_TEXTURE_FORMAT_RGBA8_UNORM);
    if (rp == 0) { return 1; }
    var clear = color_new(F64_0, F64_0, F64_0, F64_1);   # black clear; triangle fills red
    var rpb = rpb_pass_new();
    rpb_pass_color(rpb, view, clear);
    var enc = wgpu_device_create_command_encoder(device, "spv-enc");
    if (enc == 0) { return 1; }
    var pass = rpb_pass_begin(enc, rpb);
    if (pass == 0) { return 1; }
    wgpu_render_pass_encoder_set_pipeline(pass, render_pipeline_handle(rp));
    wgpu_render_pass_encoder_draw(pass, 3, 1, 0, 0);
    wgpu_render_pass_encoder_end(pass);
    wgpu_render_pass_encoder_release(pass);
    var cargs = alloc(72);
    memset(cargs, 0, 72);
    store64(cargs + 0,  target);     # src_texture
    store64(cargs + 32, read_buf);   # dst_buffer
    store32(cargs + 48, 1024);       # bytes_per_row (256*4, 256-aligned)
    store32(cargs + 52, H);          # rows_per_image
    store32(cargs + 56, W);          # copy_w
    store32(cargs + 60, H);          # copy_h
    store32(cargs + 64, 1);          # copy_depth
    wgpu_command_encoder_copy_texture_to_buffer(enc, cargs);
    var cmd = wgpu_command_encoder_finish(enc, "spv-cmd");
    if (cmd == 0) { return 1; }
    wgpu_queue_submit_one(queue, cmd);
    return 0;
}

fn mabda_main(fn_table_ptr, preinit_ptr): i64 {
    color_init();
    wgpu_ffi_init_table(fn_table_ptr);
    _gpu_preinit = preinit_ptr;
    var res = gpu_context_from_preinit(_gpu_preinit);
    if (is_err_result(res) == 1) { syscall(1, 2, "SKIP: no GPU available\n", 23); return 0; }
    _gpu_ctx = payload(res);
    var device = gpu_ctx_device(_gpu_ctx);
    var queue = gpu_ctx_queue(_gpu_ctx);
    syscall(1, 1, "PASS: GPU context created\n", 26);

    # WGSL twin (fullscreen triangle + red FS) — exercises the widened slot's
    # WGSL branch. Built via str_builder to stay under the 120-char line cap.
    var _sb = str_builder_new();
    str_builder_add_cstr(_sb, "@vertex fn vs_main(@builtin(vertex_index) i: u32) -> ");
    str_builder_add_cstr(_sb, "@builtin(position) vec4<f32> { ");
    str_builder_add_cstr(_sb, "let x = f32((i << 1u) & 2u) * 2.0 - 1.0; ");
    str_builder_add_cstr(_sb, "let y = f32(i & 2u) * 2.0 - 1.0; ");
    str_builder_add_cstr(_sb, "return vec4<f32>(x, y, 0.0, 1.0); } ");
    str_builder_add_cstr(_sb, "@fragment fn fs_main() -> @location(0) vec4<f32> { ");
    str_builder_add_cstr(_sb, "return vec4<f32>(1.0, 0.0, 0.0, 1.0); }");
    var wgsl = str_cstr(str_builder_build(_sb));
    var wmod = gpu_shader_module_create(_gpu_ctx, wgsl, strlen(wgsl));
    if (wmod == 0) { return _fail("FAIL: WGSL module create\n", 25); }
    syscall(1, 1, "PASS: WGSL shader module\n", 25);

    # SPIR-V module (gpu_shader_module_create_spirv, S.2; needs the S.4 feature).
    var sbuf = alloc(1356);
    _spirv_blob(sbuf);
    var smod = gpu_shader_module_create_spirv(_gpu_ctx, sbuf, 1356);
    if (smod == 0) { return _fail("FAIL: SPIR-V module create (instance feature / validation?)\n", 60); }
    syscall(1, 1, "PASS: SPIR-V shader module\n", 27);

    var BUF = 262144;
    var usage = WGPU_BUFFER_USAGE_MAP_READ | WGPU_BUFFER_USAGE_COPY_DST;
    var rb_w = wgpu_device_create_buffer(device, wgpu_buffer_descriptor("rb-w", usage, BUF, 0));
    var rb_s = wgpu_device_create_buffer(device, wgpu_buffer_descriptor("rb-s", usage, BUF, 0));
    if (rb_w == 0) { return _fail("FAIL: readback buffer (wgsl)\n", 29); }
    if (rb_s == 0) { return _fail("FAIL: readback buffer (spirv)\n", 30); }
    if (_render(device, queue, wmod, rb_w) != 0) { return _fail("FAIL: WGSL render\n", 18); }
    if (_render(device, queue, smod, rb_s) != 0) { return _fail("FAIL: SPIR-V render\n", 20); }
    syscall(1, 1, "PASS: rendered WGSL + SPIR-V passes\n", 35);

    var mst_w = wgpu_buffer_map_sync(device, rb_w, WGPU_MAP_MODE_READ, 0, BUF);
    if (mst_w != WGPU_BUFFER_MAP_ASYNC_STATUS_SUCCESS) { return _fail("FAIL: map wgsl\n", 15); }
    var mst_s = wgpu_buffer_map_sync(device, rb_s, WGPU_MAP_MODE_READ, 0, BUF);
    if (mst_s != WGPU_BUFFER_MAP_ASYNC_STATUS_SUCCESS) { return _fail("FAIL: map spirv\n", 16); }
    var mw = wgpu_buffer_get_const_mapped_range(rb_w, 0, BUF);
    var ms = wgpu_buffer_get_const_mapped_range(rb_s, 0, BUF);
    if (mw == 0) { return _fail("FAIL: mapped range wgsl\n", 24); }
    if (ms == 0) { return _fail("FAIL: mapped range spirv\n", 25); }

    # Center pixel must be red (the triangle filled the RT).
    var ctr = (128 * 256 + 128) * 4;
    var red_ok = 0;
    if (load8(mw + ctr) == 0xFF) { if (load8(mw + ctr + 1) == 0) {
            if (load8(mw + ctr + 2) == 0) { if (load8(mw + ctr + 3) == 0xFF) { red_ok = 1; } } } }

    # Cross-source identity: every byte of the two readbacks equal.
    var diff = 0;
    var i = 0;
    while (i < BUF) {
        if (load8(mw + i) != load8(ms + i)) { diff = diff + 1; i = BUF; }
        i = i + 1;
    }
    wgpu_buffer_unmap(rb_w);
    wgpu_buffer_unmap(rb_s);

    if (red_ok == 0) { return _fail("FAIL: center pixel not red (shader did not fill)\n", 49); }
    if (diff != 0)   { return _fail("FAIL: SPIR-V output != WGSL output\n", 35); }
    syscall(1, 1, "PASS: SPIR-V render == WGSL render (cross-source identity)\n", 58);
    syscall(1, 1, "\nOK - wgpu SPIR-V shader ingestion live\n", 40);
    return 0;
}
