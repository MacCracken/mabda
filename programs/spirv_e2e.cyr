# programs/spirv_e2e.cyr — v3.2 S.5: wgpu SPIR-V shader ingestion HW e2e
#
# Proves the Phase S SPIR-V path end-to-end on a wgpu-native box: create a
# shader module from a SPIR-V binary (gpu_shader_module_create_spirv, S.2) on an
# instance built with the ShaderSourceSPIRV feature (deps/wgpu_main.c, S.4), use
# it in a render pipeline, draw, and read back — then assert the result is
# byte-identical to the SAME shader expressed as WGSL (cross-source identity).
#
# Shaders: a fullscreen triangle VS + solid-red FS, in one module with entry
# points vs_main + fs_main (what render_pipeline_create_simple expects). The
# SPIR-V was glslang-compiled (-e vs_main / -e fs_main) + spirv-link'd into one
# module + spirv-val-clean; embedded below as its 339 u32 words. The triangle
# covers the WHOLE 256x256 RT, so both renders are entirely red -> the identity
# holds regardless of the WGSL-vs-Vulkan Y convention.
#
# Linked with deps/wgpu_main.c via `make test-spirv-e2e`. Render path only —
# wgpu compute is a v3.0 stub. SKIPs cleanly if no GPU.

include "src/lib.cyr"

var _gpu_preinit = 0;
var _gpu_ctx = 0;

fn _fail(msg, len): i64 { syscall(1, 2, msg, len); return 1; }

