# programs/smoke.cyr — compile-time proof that src/lib.cyr links clean.
#
# mabda is a library — there is no CLI binary. This program exists so
# `cyrius build programs/smoke.cyr build/mabda_smoke` can verify the
# full include chain parses and links without error. The emitted
# binary writes a one-line banner and exits 0.
#
# GPU round-trip validation lives in programs/phase0.cyr and is built
# via the Makefile's C-launcher path (deps/wgpu_main.c + wgpu-native).

include "src/lib.cyr"

fn main(): i64 {
    alloc_init();
    var banner = "mabda smoke: lib.cyr linked clean\n";
    syscall(1, 1, banner, strlen(banner));
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
