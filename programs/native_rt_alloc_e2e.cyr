# programs/native_rt_alloc_e2e.cyr — v3.4.2 render-target allocator HW e2e
#
# Regression for the two v3.4.2 render-target fixes (found integrating mabda
# into the `puka` Wayland terminal). Both reproduce on real Cezanne silicon
# and are invisible to the in-tree 256x256 render e2e:
#
#   Fix #1 — 64 KiB va_map alignment. `gpu_render_target_create_2d_rgba8`
#            used to hand the raw width*height*4 BO size to GEM_VA, which
#            EINVALs (-22) for any size that is not 64 KiB-aligned — i.e.
#            most real window sizes. 1260x682 (3360 KiB, rem 29408 B) is the
#            reported failure; 256x256 / 1024x1024 happened to be aligned and
#            masked it. The fix rounds the BO + map span up to 64 KiB.
#
#   Fix #2 — per-context RT VA bump. The RT VA was hardcoded at a single
#            _NATIVE_RT_VA_BASE, so creating a 2nd render target before
#            releasing the 1st mapped the SAME VA -> GEM_VA EINVAL. The fix
#            bumps a per-context cursor (ctx+168) so concurrent live RTs get
#            distinct VAs (mirrors the texture VA allocator).
#
# Flow (all through the public gpu_render_target_* API):
#   1. gpu_context_new_native()
#   2. RT #1 at 1260x682 (odd-window, NOT 64 KiB-aligned) -> exercises Fix #1.
#      Pre-fix this returned 0 (EINVAL squashed to GPU_ERR_OTHER).
#   3. RT #2 at 256x256 WITHOUT releasing RT #1 -> exercises Fix #2. Pre-fix
#      this returned 0 (VA in use).
#   4. Assert distinct VAs, RT #2 VA == RT #1 VA + rounded(1260x682), RT #1's
#      stored size is 64 KiB-rounded (3473408), and both BOs are GTT-mapped.
#   5. Prove the RT #1 mapping is live: CPU write+read a sentinel through the
#      GTT-visible BO addr (the map actually backs memory, not just a struct).
#   6. Teardown both RTs + ctx.
#
# Exit codes:
#   0 — both fixes verified on HW
#   1 — gpu_context_new_native failed
#   2 — RT #1 (1260x682) create returned 0  (Fix #1 regression: va_map EINVAL)
#   3 — RT #2 (2nd live RT) create returned 0 (Fix #2 regression: VA collision)
#   4 — RT VAs not distinct / not at the expected bump offset
#   5 — RT #1 stored size not 64 KiB-rounded, or BO addr null
#   6 — GTT sentinel write/read mismatch (mapping not backing memory)
#
# Linked via the Makefile target `test-native-rt-alloc-e2e`. No C launcher
# (no wgpu-native dependency on the native path). Runs on this box (Cezanne
# render node present); native dispatch is not master-gated.

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}

fn main(): i64 {
    alloc_init();
    color_init();

    print_cstr("mabda native RT allocator e2e (v3.4.2)\n");
    print_cstr("--------------------------------------\n");

    # ---- 1. Native GpuContext ----
    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) {
        print_cstr("FAIL: gpu_context_new_native\n");
        return 1;
    }
    var ctx = payload(ctx_res);
    print_cstr("PASS: native ctx (fd="); print_i64(native_ctx_fd(ctx));
    print_cstr(")\n");

    # ---- 2. RT #1 at 1260x682 (Fix #1: non-64KiB-aligned window) ----
    var rt1 = gpu_render_target_create_2d_rgba8(ctx, 1260, 682);
    if (rt1 == 0) {
        print_cstr("FAIL: RT #1 1260x682 create returned 0 (Fix #1 regression)\n");
        gpu_context_release(ctx); return 2;
    }
    var va1   = load64(rt1 + NATIVE_RT_FIELD_VA);
    var addr1 = load64(rt1 + NATIVE_RT_FIELD_ADDR);
    var size1 = load64(rt1 + NATIVE_RT_FIELD_SIZE);
    print_cstr("PASS: RT #1 1260x682 (va="); print_i64(va1);
    print_cstr(" size="); print_i64(size1); print_cstr(")\n");

    # ---- 3. RT #2 at 256x256 WITHOUT releasing RT #1 (Fix #2) ----
    var rt2 = gpu_render_target_create_2d_rgba8(ctx, 256, 256);
    if (rt2 == 0) {
        print_cstr("FAIL: RT #2 (2nd live RT) create returned 0 (Fix #2 regression)\n");
        gpu_render_target_release(ctx, rt1);
        gpu_context_release(ctx); return 3;
    }
    var va2 = load64(rt2 + NATIVE_RT_FIELD_VA);
    print_cstr("PASS: RT #2 256x256 live alongside #1 (va="); print_i64(va2);
    print_cstr(")\n");

    # ---- 4. Distinct VAs at the expected bump offset ----
    # rounded(1260*682*4 = 3437280) up to 64 KiB = 3473408 (0x350000).
    var expect_step = 3473408;
    if (va1 == va2) {
        print_cstr("FAIL: RT #1 and #2 share a VA\n");
        gpu_render_target_release(ctx, rt2);
        gpu_render_target_release(ctx, rt1);
        gpu_context_release(ctx); return 4;
    }
    if (va2 != va1 + expect_step) {
        print_cstr("FAIL: RT #2 VA != #1 + 0x350000 (delta=");
        print_i64(va2 - va1); print_cstr(")\n");
        gpu_render_target_release(ctx, rt2);
        gpu_render_target_release(ctx, rt1);
        gpu_context_release(ctx); return 4;
    }
    print_cstr("PASS: distinct VAs, RT #2 = RT #1 + 0x350000\n");

    # ---- 5. RT #1 size 64 KiB-rounded + BO mapped ----
    if (size1 != expect_step) {
        print_cstr("FAIL: RT #1 stored size not 64KiB-rounded (got ");
        print_i64(size1); print_cstr(")\n");
        gpu_render_target_release(ctx, rt2);
        gpu_render_target_release(ctx, rt1);
        gpu_context_release(ctx); return 5;
    }
    if (addr1 == 0) {
        print_cstr("FAIL: RT #1 BO addr is null (not mapped)\n");
        gpu_render_target_release(ctx, rt2);
        gpu_render_target_release(ctx, rt1);
        gpu_context_release(ctx); return 5;
    }
    print_cstr("PASS: RT #1 size 64KiB-rounded + BO GTT-mapped\n");

    # ---- 6. Prove the GTT mapping backs real memory ----
    store32(addr1, 0xCAFEF00D);
    store32(addr1 + (size1 - 4), 0xBADC0DE5);
    var got_lo = load32(addr1);
    var got_hi = load32(addr1 + (size1 - 4));
    if (got_lo != 0xCAFEF00D) {
        print_cstr("FAIL: GTT sentinel lo mismatch\n");
        gpu_render_target_release(ctx, rt2);
        gpu_render_target_release(ctx, rt1);
        gpu_context_release(ctx); return 6;
    }
    if (got_hi != 0xBADC0DE5) {
        print_cstr("FAIL: GTT sentinel hi mismatch (last-page map short)\n");
        gpu_render_target_release(ctx, rt2);
        gpu_render_target_release(ctx, rt1);
        gpu_context_release(ctx); return 6;
    }
    print_cstr("PASS: GTT sentinel write/read across the full span\n");

    # ---- 7. Teardown ----
    gpu_render_target_release(ctx, rt2);
    gpu_render_target_release(ctx, rt1);
    gpu_context_release(ctx);
    print_cstr("--------------------------------------\n");
    print_cstr("ALL PASS: v3.4.2 RT allocator fixes verified on HW\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
