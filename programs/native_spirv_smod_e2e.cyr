# programs/native_spirv_smod_e2e.cyr — N.9d: signed OpSMod compiled in-tree (truncated
# remainder + a floored fixup) and dispatched on Cezanne, verified over a signed matrix.
#
# Kernel: `out[gid.x] = a[gid.x] %smod b[gid.x];` (i32; floored modulo — the result follows
# the DIVISOR's sign, GLSL `mod` semantics). SMod = SRem, then when the remainder is nonzero
# AND the operand signs differ, add the divisor. Verified vs an independent CPU reference
# (unsigned ops only).
#
# Exit: 0 = correct; 2 = compile; 3/5 = setup; 9 = dispatch; 11 = mismatch.

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}
fn print_hex(n): i64 {
    var buf[16];
    var d = 0;
    while (d < 8) {
        var nib = (n >> ((7 - d) * 4)) & 0xF;
        var ch = 48 + nib;
        if (nib > 9) { ch = 87 + nib; }
        store8(&buf + d, ch);
        d = d + 1;
    }
    syscall(1, 1, &buf, 8);
    return 0;
}

fn uabs32(x): i64 {
    if ((x & 0x80000000) != 0) { return (0x100000000 - x) & 0xFFFFFFFF; }
    return x;
}
# Independent reference: signed remainder, sign of the dividend (no signed `%`).
fn exp_srem(a, b): i64 {
    var r = uabs32(a) % uabs32(b);
    var sa = (a >> 31) & 1;
    if (sa == 1) { return (0x100000000 - r) & 0xFFFFFFFF; }
    return r & 0xFFFFFFFF;
}
# Floored modulo: SRem, then add the divisor when the remainder is nonzero and the signs
# differ (the result follows the DIVISOR's sign).
fn exp_smod(a, b): i64 {
    var sr = exp_srem(a, b);
    if (sr == 0) { return 0; }
    var sa = (a >> 31) & 1;
    var sb = (b >> 31) & 1;
    if (sa != sb) { return (sr + b) & 0xFFFFFFFF; }
    return sr;
}

# SPIR-V (id-bound 25, 612 bytes). Identical to the srem kernel except %23 is OpSMod (139).
fn build_smod_kernel(buf): i64 {
    store32(buf + 0, 0x07230203);
    store32(buf + 4, 0x00010300);
    store32(buf + 8, 0);
    store32(buf + 12, 25);
    store32(buf + 16, 0);
    store32(buf + 20, (2 << 16) | 17);
    store32(buf + 24, 1);
    store32(buf + 28, (3 << 16) | 14);
    store32(buf + 32, 0);
    store32(buf + 36, 1);
    store32(buf + 40, (6 << 16) | 15);
    store32(buf + 44, 5);
    store32(buf + 48, 15);
    store32(buf + 52, 0x6E69616D);
    store32(buf + 56, 0);
    store32(buf + 60, 11);
    store32(buf + 64, (6 << 16) | 16);
    store32(buf + 68, 15);
    store32(buf + 72, 17);
    store32(buf + 76, 8);
    store32(buf + 80, 1);
    store32(buf + 84, 1);
    store32(buf + 88, (4 << 16) | 71);
    store32(buf + 92, 11);
    store32(buf + 96, 11);
    store32(buf + 100, 28);
    store32(buf + 104, (4 << 16) | 71);
    store32(buf + 108, 12);
    store32(buf + 112, 33);
    store32(buf + 116, 0);
    store32(buf + 120, (4 << 16) | 71);
    store32(buf + 124, 12);
    store32(buf + 128, 34);
    store32(buf + 132, 0);
    store32(buf + 136, (4 << 16) | 71);
    store32(buf + 140, 13);
    store32(buf + 144, 33);
    store32(buf + 148, 1);
    store32(buf + 152, (4 << 16) | 71);
    store32(buf + 156, 13);
    store32(buf + 160, 34);
    store32(buf + 164, 0);
    store32(buf + 168, (4 << 16) | 71);
    store32(buf + 172, 14);
    store32(buf + 176, 33);
    store32(buf + 180, 2);
    store32(buf + 184, (4 << 16) | 71);
    store32(buf + 188, 14);
    store32(buf + 192, 34);
    store32(buf + 196, 0);
    store32(buf + 200, (2 << 16) | 19);
    store32(buf + 204, 1);
    store32(buf + 208, (3 << 16) | 33);
    store32(buf + 212, 2);
    store32(buf + 216, 1);
    store32(buf + 220, (4 << 16) | 21);
    store32(buf + 224, 3);
    store32(buf + 228, 32);
    store32(buf + 232, 0);
    store32(buf + 236, (4 << 16) | 23);
    store32(buf + 240, 4);
    store32(buf + 244, 3);
    store32(buf + 248, 3);
    store32(buf + 252, (4 << 16) | 32);
    store32(buf + 256, 5);
    store32(buf + 260, 1);
    store32(buf + 264, 4);
    store32(buf + 268, (3 << 16) | 29);
    store32(buf + 272, 6);
    store32(buf + 276, 3);
    store32(buf + 280, (3 << 16) | 30);
    store32(buf + 284, 7);
    store32(buf + 288, 6);
    store32(buf + 292, (4 << 16) | 32);
    store32(buf + 296, 8);
    store32(buf + 300, 12);
    store32(buf + 304, 7);
    store32(buf + 308, (4 << 16) | 32);
    store32(buf + 312, 9);
    store32(buf + 316, 12);
    store32(buf + 320, 3);
    store32(buf + 324, (4 << 16) | 43);
    store32(buf + 328, 3);
    store32(buf + 332, 10);
    store32(buf + 336, 0);
    store32(buf + 340, (4 << 16) | 59);
    store32(buf + 344, 5);
    store32(buf + 348, 11);
    store32(buf + 352, 1);
    store32(buf + 356, (4 << 16) | 59);
    store32(buf + 360, 8);
    store32(buf + 364, 12);
    store32(buf + 368, 12);
    store32(buf + 372, (4 << 16) | 59);
    store32(buf + 376, 8);
    store32(buf + 380, 13);
    store32(buf + 384, 12);
    store32(buf + 388, (4 << 16) | 59);
    store32(buf + 392, 8);
    store32(buf + 396, 14);
    store32(buf + 400, 12);
    store32(buf + 404, (5 << 16) | 54);
    store32(buf + 408, 1);
    store32(buf + 412, 15);
    store32(buf + 416, 0);
    store32(buf + 420, 2);
    store32(buf + 424, (2 << 16) | 248);
    store32(buf + 428, 16);
    store32(buf + 432, (4 << 16) | 61);
    store32(buf + 436, 4);
    store32(buf + 440, 17);
    store32(buf + 444, 11);
    store32(buf + 448, (5 << 16) | 81);
    store32(buf + 452, 3);
    store32(buf + 456, 18);
    store32(buf + 460, 17);
    store32(buf + 464, 0);
    store32(buf + 468, (6 << 16) | 65);
    store32(buf + 472, 9);
    store32(buf + 476, 19);
    store32(buf + 480, 12);
    store32(buf + 484, 10);
    store32(buf + 488, 18);
    store32(buf + 492, (4 << 16) | 61);
    store32(buf + 496, 3);
    store32(buf + 500, 20);
    store32(buf + 504, 19);
    store32(buf + 508, (6 << 16) | 65);
    store32(buf + 512, 9);
    store32(buf + 516, 21);
    store32(buf + 520, 13);
    store32(buf + 524, 10);
    store32(buf + 528, 18);
    store32(buf + 532, (4 << 16) | 61);
    store32(buf + 536, 3);
    store32(buf + 540, 22);
    store32(buf + 544, 21);
    store32(buf + 548, (5 << 16) | 139); # OpSMod %23 = a %smod b (divisor sign, floored)
    store32(buf + 552, 3);
    store32(buf + 556, 23);
    store32(buf + 560, 20);
    store32(buf + 564, 22);
    store32(buf + 568, (6 << 16) | 65);
    store32(buf + 572, 9);
    store32(buf + 576, 24);
    store32(buf + 580, 14);
    store32(buf + 584, 10);
    store32(buf + 588, 18);
    store32(buf + 592, (3 << 16) | 62);
    store32(buf + 596, 24);
    store32(buf + 600, 23);
    store32(buf + 604, (1 << 16) | 253);
    store32(buf + 608, (1 << 16) | 56);
    return 612;
}

fn main(): i64 {
    alloc_init();
    print_cstr("mabda native SPIR-V i32 OpSMod e2e (N.9d) on Cezanne\n");
    print_cstr("----------------------------------------------------\n");

    var spv[1024];
    var n = build_smod_kernel(&spv);

    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) { return 3; }
    var ctx = payload(ctx_res);
    var fd = native_ctx_fd(ctx);

    var shmod = gpu_shader_module_create_spirv(ctx, &spv, n);
    if (shmod == 0) { print_cstr("FAIL: shader_module_create_spirv -> 0\n"); return 2; }

    var av[32];
    var bv[32];
    store32(&av + 0, 7);          store32(&bv + 0, 2);            #  7 smod  2 =  1
    store32(&av + 4, 0xFFFFFFF9); store32(&bv + 4, 2);            # -7 smod  2 =  1
    store32(&av + 8, 7);          store32(&bv + 8, 0xFFFFFFFE);   #  7 smod -2 = -1
    store32(&av + 12, 0xFFFFFFF9); store32(&bv + 12, 0xFFFFFFFE); # -7 smod -2 = -1
    store32(&av + 16, 0xFFFFFFF8); store32(&bv + 16, 4);          # -8 smod  4 =  0
    store32(&av + 20, 5);         store32(&bv + 20, 0xFFFFFFFD);  #  5 smod -3 = -1
    store32(&av + 24, 0);         store32(&bv + 24, 0xFFFFFFFB);  #  0 smod -5 =  0
    store32(&av + 28, 0x80000000); store32(&bv + 28, 2);          # INT_MIN smod 2 = 0

    var ab[16];
    var bb[16];
    var ob[16];
    if (native_bo_create_gtt(fd, 4096, &ab) != 0) { return 5; }
    if (native_bo_create_gtt(fd, 4096, &bb) != 0) { return 5; }
    if (native_bo_create_gtt(fd, 4096, &ob) != 0) { return 5; }
    var a_handle = load64(&ab + 0); var a_map = load64(&ab + 8);
    var b_handle = load64(&bb + 0); var b_map = load64(&bb + 8);
    var o_handle = load64(&ob + 0); var o_map = load64(&ob + 8);
    var i = 0;
    while (i < 8) {
        store32(a_map + i * 4, load32(&av + i * 4));
        store32(b_map + i * 4, load32(&bv + i * 4));
        store32(o_map + i * 4, 0xBAADF00D);
        i = i + 1;
    }
    var a_va = 0xFFFF800100400000;
    var b_va = 0xFFFF800100401000;
    var o_va = 0xFFFF800100402000;
    if (native_gem_va_map(fd, a_handle, a_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }
    if (native_gem_va_map(fd, b_handle, b_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }
    if (native_gem_va_map(fd, o_handle, o_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }

    var bp[56];
    store64(&bp + 0, 3);
    store64(&bp + 8, a_handle);  store64(&bp + 16, a_va);
    store64(&bp + 24, b_handle); store64(&bp + 32, b_va);
    store64(&bp + 40, o_handle); store64(&bp + 48, o_va);

    var rc = gpu_compute_dispatch(ctx, shmod, 1, 1, 1, &bp);
    if (rc != 0) { print_cstr("FAIL: gpu_compute_dispatch rc="); print_i64(rc); print_cstr("\n"); return 9; }

    var ok = 1;
    i = 0;
    while (i < 8) {
        var a = load32(&av + i * 4);
        var b = load32(&bv + i * 4);
        var got = load32(o_map + i * 4);
        var want = exp_smod(a, b);
        print_cstr("  0x"); print_hex(a); print_cstr(" smod 0x"); print_hex(b);
        print_cstr(" = 0x"); print_hex(got);
        if (got != want) { print_cstr("  MISMATCH want=0x"); print_hex(want); ok = 0; }
        print_cstr("\n");
        i = i + 1;
    }

    gpu_shader_module_release(ctx, shmod);
    native_gem_va_unmap(fd, a_handle, a_va, 4096);
    native_gem_va_unmap(fd, b_handle, b_va, 4096);
    native_gem_va_unmap(fd, o_handle, o_va, 4096);
    native_bo_release_gtt(fd, a_handle, a_map, 4096);
    native_bo_release_gtt(fd, b_handle, b_map, 4096);
    native_bo_release_gtt(fd, o_handle, o_map, 4096);
    gpu_context_release(ctx);

    if (ok == 0) { print_cstr("FAIL: smod dispatch mismatch\n"); return 11; }
    print_cstr("OK — i32 a%%b (floored modulo, divisor sign) correct on Cezanne\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
