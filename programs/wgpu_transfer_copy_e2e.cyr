# programs/wgpu_transfer_copy_e2e.cyr — v3.2 X.7 (wgpu transfer-copy)
#
# The wgpu serialized counterpart to native_transfer_copy_e2e: drives the
# PUBLIC buffer-copy API on a real wgpu device and verifies the same
# observable result. On wgpu the logical TRANSFER queue aliases the single
# device queue, so the copy is just a copy_buffer_to_buffer on that queue
# (no real concurrency) — same bytes out.
#
# Also proves the X.6 MED-3 fix: gpu_buffer_create OR's COPY_SRC|COPY_DST
# into every buffer's usage, so a plain STORAGE buffer is a valid copy
# operand here (without it, copy_buffer_to_buffer would fail wgpu validation).
#
#   gpu_buffer_create x2 -> gpu_buffer_write(src, pattern) ->
#   gpu_buffer_copy(src -> dst) -> gpu_buffer_read(dst) -> byte-exact verify;
#   then assert a 67-byte copy is rejected (alignment guard).
#
# Linked with deps/wgpu_main.c via the Makefile target. Skips cleanly if no
# GPU is available.

include "src/lib.cyr"

var _gpu_preinit = 0;
var _gpu_ctx = 0;

# Output helpers. Every line's byte count comes from strlen, never a hand-counted literal:
# miscounts wrote the NUL terminator into the log or dropped the newline and glued two PASS
# lines (4.1.3 verification). The summary counts the PASS lines actually printed, so it cannot
# disagree with them; every FAIL returns non-zero at once, so "0 failed" holds by construction.
var _e2e_passes = 0;

# Write tag + msg + "\n" to fd as ONE write (a line never interleaves with wgpu's own stderr).
fn _e2e_line(fd, tag, msg): i64 {
    var line[256];
    var tl = strlen(tag);
    var ml = strlen(msg);
    if (tl > 64) { tl = 64; }
    if (tl + ml > 255) { ml = 255 - tl; }
    memcpy(&line, tag, tl);
    memcpy(&line + tl, msg, ml);
    store8(&line + tl + ml, 10);
    syscall(1, fd, &line, tl + ml + 1);
    return 0;
}
fn _pass(msg): i64 { _e2e_line(1, "PASS: ", msg); _e2e_passes = _e2e_passes + 1; return 0; }
fn _fail(msg): i64 { _e2e_line(2, "FAIL: ", msg); return 1; }

# "\n<N> passed, 0 failed\n" with N = the PASS lines printed above.
fn _e2e_summary(): i64 {
    var nb[32];
    memset(&nb, 0, 32);
    store8(&nb, 10);
    fmt_int_buf(_e2e_passes, &nb + 1);
    _e2e_line(1, &nb, " passed, 0 failed");
    return 0;
}

fn mabda_main(fn_table_ptr, preinit_ptr): i64 {
    color_init();
    wgpu_ffi_init_table(fn_table_ptr);
    _gpu_preinit = preinit_ptr;

    var res_tag, res = gpu_context_from_preinit(_gpu_preinit);
    if (is_err_result(res_tag) == 1) {
        _e2e_line(2, "SKIP: ", "no GPU available");
        return 0;
    }
    _gpu_ctx = res;
    _pass("GPU context created");

    var N = 4096;
    var usage = WGPU_BUFFER_USAGE_STORAGE;   # COPY_SRC/DST added by the backend

    var src = gpu_buffer_create(_gpu_ctx, N, usage);
    if (src == 0) { return _fail("src create"); }
    var dst = gpu_buffer_create(_gpu_ctx, N, usage);
    if (dst == 0) { return _fail("dst create"); }
    _pass("buffers created");

    var pat = alloc(N);
    var i = 0;
    while (i < N / 4) { store32(pat + i * 4, 0xA5A50000 + i); i = i + 1; }
    if (gpu_buffer_write(_gpu_ctx, src, 0, pat, N) != 0) {
        return _fail("src write"); }

    if (gpu_buffer_copy(_gpu_ctx, src, dst, N) != 0) {
        return _fail("gpu_buffer_copy"); }
    _pass("gpu_buffer_copy submitted");

    var out = alloc(N);
    memset(out, 0, N);
    if (gpu_buffer_read(_gpu_ctx, dst, 0, out, N) != 0) {
        return _fail("dst read"); }

    var bad = 0;
    var j = 0;
    while (j < N / 4) {
        if (load32(out + j * 4) != 0xA5A50000 + j) { bad = 1; }
        j = j + 1;
    }
    if (bad != 0) { return _fail("copy did not round-trip"); }
    _pass("4096B copy round-trips byte-exact");

    # Alignment guard: a non-4-byte-multiple size must be rejected.
    if (gpu_buffer_copy(_gpu_ctx, src, dst, 67) == 0) {
        return _fail("67-byte copy was NOT rejected"); }
    _pass("67-byte copy rejected (alignment guard)");

    gpu_buffer_release(_gpu_ctx, src);
    gpu_buffer_release(_gpu_ctx, dst);
    _e2e_summary();
    return 0;
}
