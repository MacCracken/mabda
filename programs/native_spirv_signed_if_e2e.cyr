# programs/native_spirv_signed_if_e2e.cyr — N.8b-4: a SIGNED compare compiled in-tree
# and dispatched on Cezanne, proving v_cmp_lt_i32 (signed) vs the unsigned form.
#
# Kernel: `if (int(gid.x) - 4 < 0) { out[gid.x] = 100; }`. LocalSize 8, one workgroup.
# gid.x - 4 is -4..3 for gid 0..7; as SIGNED it is < 0 for gid 0..3 (true), >= 0 for 4..7.
# An UNSIGNED compare would see gid-4 (for gid<4) as a huge value (>= 0) → all false, so
# this output distinguishes the signed path (v_cmp_lt_i32 → flipped v_cmp_gt_i32 vcc,0,x).
#
# Seed out[0..7] = 0xBAADF00D. Verify out[0..3] = gid.x (0,1,2,3), out[4..7] = sentinel.
# Exit: 0 = correct; 2 = compile; 3/5 = setup; 9 = dispatch; 11 = mismatch.

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}

# SPIR-V (id-bound 25, 548 bytes). %14 GlobalInvocationId; %15 out (binding 0).
fn build_signed_if_kernel(buf): i64 {
    store32(buf + 0, 0x07230203);
    store32(buf + 4, 0x00010300);
    store32(buf + 8, 0);
    store32(buf + 12, 25);
    store32(buf + 16, 0);
    store32(buf + 20, (2 << 16) | 17);   # OpCapability Shader
    store32(buf + 24, 1);
    store32(buf + 28, (3 << 16) | 14);   # OpMemoryModel Logical GLSL450
    store32(buf + 32, 0);
    store32(buf + 36, 1);
    store32(buf + 40, (6 << 16) | 15);   # OpEntryPoint GLCompute %16 "main" %14
    store32(buf + 44, 5);
    store32(buf + 48, 16);
    store32(buf + 52, 0x6E69616D);
    store32(buf + 56, 0);
    store32(buf + 60, 14);
    store32(buf + 64, (6 << 16) | 16);   # OpExecutionMode %16 LocalSize 8 1 1
    store32(buf + 68, 16);
    store32(buf + 72, 17);
    store32(buf + 76, 8);
    store32(buf + 80, 1);
    store32(buf + 84, 1);
    store32(buf + 88, (4 << 16) | 71);   # OpDecorate %14 BuiltIn GlobalInvocationId
    store32(buf + 92, 14);
    store32(buf + 96, 11);
    store32(buf + 100, 28);
    store32(buf + 104, (4 << 16) | 71);  # OpDecorate %15 Binding 0
    store32(buf + 108, 15);
    store32(buf + 112, 33);
    store32(buf + 116, 0);
    store32(buf + 120, (4 << 16) | 71);  # OpDecorate %15 DescriptorSet 0
    store32(buf + 124, 15);
    store32(buf + 128, 34);
    store32(buf + 132, 0);
    store32(buf + 136, (2 << 16) | 19);  # %1 void
    store32(buf + 140, 1);
    store32(buf + 144, (3 << 16) | 33);  # %2 fn
    store32(buf + 148, 2);
    store32(buf + 152, 1);
    store32(buf + 156, (4 << 16) | 21);  # %3 uint
    store32(buf + 160, 3);
    store32(buf + 164, 32);
    store32(buf + 168, 0);
    store32(buf + 172, (4 << 16) | 23);  # %4 v3uint
    store32(buf + 176, 4);
    store32(buf + 180, 3);
    store32(buf + 184, 3);
    store32(buf + 188, (4 << 16) | 32);  # %5 ptr Input v3uint
    store32(buf + 192, 5);
    store32(buf + 196, 1);
    store32(buf + 200, 4);
    store32(buf + 204, (2 << 16) | 20);  # %6 bool
    store32(buf + 208, 6);
    store32(buf + 212, (3 << 16) | 29);  # %7 runtime array uint
    store32(buf + 216, 7);
    store32(buf + 220, 3);
    store32(buf + 224, (3 << 16) | 30);  # %8 struct { %7 }
    store32(buf + 228, 8);
    store32(buf + 232, 7);
    store32(buf + 236, (4 << 16) | 32);  # %9 ptr StorageBuffer struct
    store32(buf + 240, 9);
    store32(buf + 244, 12);
    store32(buf + 248, 8);
    store32(buf + 252, (4 << 16) | 32);  # %10 ptr StorageBuffer uint
    store32(buf + 256, 10);
    store32(buf + 260, 12);
    store32(buf + 264, 3);
    store32(buf + 268, (4 << 16) | 43);  # %11 const 0
    store32(buf + 272, 3);
    store32(buf + 276, 11);
    store32(buf + 280, 0);
    store32(buf + 284, (4 << 16) | 43);  # %12 const 4
    store32(buf + 288, 3);
    store32(buf + 292, 12);
    store32(buf + 296, 4);
    store32(buf + 300, (4 << 16) | 43);  # %13 const 100
    store32(buf + 304, 3);
    store32(buf + 308, 13);
    store32(buf + 312, 100);
    store32(buf + 316, (4 << 16) | 59);  # %14 gid var (Input)
    store32(buf + 320, 5);
    store32(buf + 324, 14);
    store32(buf + 328, 1);
    store32(buf + 332, (4 << 16) | 59);  # %15 out var (StorageBuffer)
    store32(buf + 336, 9);
    store32(buf + 340, 15);
    store32(buf + 344, 12);
    store32(buf + 348, (5 << 16) | 54);  # OpFunction %16
    store32(buf + 352, 1);
    store32(buf + 356, 16);
    store32(buf + 360, 0);
    store32(buf + 364, 2);
    store32(buf + 368, (2 << 16) | 248); # OpLabel %17 (entry)
    store32(buf + 372, 17);
    store32(buf + 376, (4 << 16) | 61);  # OpLoad %18 = gid
    store32(buf + 380, 4);
    store32(buf + 384, 18);
    store32(buf + 388, 14);
    store32(buf + 392, (5 << 16) | 81);  # OpCompositeExtract %19 = gid.x
    store32(buf + 396, 3);
    store32(buf + 400, 19);
    store32(buf + 404, 18);
    store32(buf + 408, 0);
    store32(buf + 412, (5 << 16) | 130); # OpISub %20 = gid.x - 4
    store32(buf + 416, 3);
    store32(buf + 420, 20);
    store32(buf + 424, 19);
    store32(buf + 428, 12);
    store32(buf + 432, (5 << 16) | 177); # OpSLessThan %21 = (gid.x - 4 < 0)
    store32(buf + 436, 6);
    store32(buf + 440, 21);
    store32(buf + 444, 20);
    store32(buf + 448, 11);
    store32(buf + 452, (3 << 16) | 247); # OpSelectionMerge %24 None
    store32(buf + 456, 24);
    store32(buf + 460, 0);
    store32(buf + 464, (4 << 16) | 250); # OpBranchConditional %21 %22 %24
    store32(buf + 468, 21);
    store32(buf + 472, 22);
    store32(buf + 476, 24);
    store32(buf + 480, (2 << 16) | 248); # OpLabel %22 (then)
    store32(buf + 484, 22);
    store32(buf + 488, (6 << 16) | 65);  # OpAccessChain %23 = &out[gid.x]
    store32(buf + 492, 10);
    store32(buf + 496, 23);
    store32(buf + 500, 15);
    store32(buf + 504, 11);
    store32(buf + 508, 19);
    store32(buf + 512, (3 << 16) | 62);  # OpStore %23 %19 (= gid.x; store-const is N.8b+)
    store32(buf + 516, 23);
    store32(buf + 520, 19);
    store32(buf + 524, (2 << 16) | 249); # OpBranch %24
    store32(buf + 528, 24);
    store32(buf + 532, (2 << 16) | 248); # OpLabel %24 (merge)
    store32(buf + 536, 24);
    store32(buf + 540, (1 << 16) | 253); # OpReturn
    store32(buf + 544, (1 << 16) | 56);  # OpFunctionEnd
    return 548;
}

fn main(): i64 {
    alloc_init();
    print_cstr("mabda native SPIR-V signed-compare if e2e (N.8b-4) on Cezanne\n");
    print_cstr("-------------------------------------------------------------\n");

    var spv[768];
    var n = build_signed_if_kernel(&spv);

    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) { return 3; }
    var ctx = payload(ctx_res);
    var fd = native_ctx_fd(ctx);

    var shmod = gpu_shader_module_create_spirv(ctx, &spv, n);
    if (shmod == 0) { print_cstr("FAIL: shader_module_create_spirv -> 0\n"); return 2; }

    var ob[16];
    if (native_bo_create_gtt(fd, 4096, &ob) != 0) { return 5; }
    var out_handle = load64(&ob + 0);
    var out_map = load64(&ob + 8);
    var k = 0;
    while (k < 8) { store32(out_map + k * 4, 0xBAADF00D); k = k + 1; }
    var out_va = 0xFFFF800100400000;
    if (native_gem_va_map(fd, out_handle, out_va, 4096, _NATIVE_PERM_DATA) != 0) { return 5; }

    var bp[24];
    store64(&bp + 0, 1);
    store64(&bp + 8, out_handle);
    store64(&bp + 16, out_va);

    var rc = gpu_compute_dispatch(ctx, shmod, 1, 1, 1, &bp);
    if (rc != 0) { print_cstr("FAIL: gpu_compute_dispatch rc="); print_i64(rc); print_cstr("\n"); return 9; }

    var ok = 1;
    var i = 0;
    while (i < 8) {
        var got = load32(out_map + i * 4);
        var want = i;
        if (i >= 4) { want = 0xBAADF00D; }   # gid-4 >= 0 → branch not taken
        print_cstr("out["); print_i64(i); print_cstr("] = ");
        if (got == 0xBAADF00D) { print_cstr("<sentinel>"); } else { print_i64(got); }
        if (got != want) { print_cstr("  MISMATCH"); ok = 0; }
        print_cstr("\n");
        i = i + 1;
    }

    gpu_shader_module_release(ctx, shmod);
    native_gem_va_unmap(fd, out_handle, out_va, 4096);
    native_bo_release_gtt(fd, out_handle, out_map, 4096);
    gpu_context_release(ctx);

    if (ok == 0) { print_cstr("FAIL: signed-if dispatch mismatch\n"); return 11; }
    print_cstr("OK — signed `(gid.x-4) < 0` selected gid 0..3 on Cezanne (out[4..7] untouched)\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
