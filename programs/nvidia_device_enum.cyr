# programs/nvidia_device_enum.cyr — v4.0 Phase N1 hardware integration
#
# Opens /dev/dri/renderD128 via direct syscall(SYS_IOCTL), issues
# DRM_IOCTL_VERSION (expects driver "nouveau"), reads chipset + PCI ids
# via DRM_IOCTL_NOUVEAU_GETPARAM, and runs the N0.7(b) masterless probe
# (DRM_IOCTL_NOUVEAU_VM_INIT must be DRM_RENDER_ALLOW — no master needed).
# Pure Cyrius — no libdrm, no libvulkan, no CUDA, no wgpu-native linked.
#
# Exit codes:
#   0 — nouveau probed; chipset/PCI printed; VM_INIT masterless confirmed
#   1 — could not open /dev/dri/renderD128 (negative fd)
#   2 — DRM_IOCTL_VERSION failed
#   3 — driver is not nouveau
#   4 — DRM_IOCTL_NOUVEAU_GETPARAM failed
#   5 — VM_INIT returned a permission denial (DRM master required) —
#       would block the masterless compute path; investigate before N3
#
# Not in CI (hardware-dependent). Run via `make test-nvidia-enum`.

include "src/lib.cyr"

fn print_cstr(s): i64 {
    syscall(1, 1, s, strlen(s));
    return 0;
}

fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}

fn main(): i64 {
    alloc_init();

    print_cstr("mabda NVIDIA device enum (v4.0 Phase N1, nouveau)\n");
    print_cstr("-------------------------------------------------\n");

    var fd = native_open_render_node();
    if (fd < 0) {
        print_cstr("FAIL: could not open ");
        print_cstr(DRM_RENDER_NODE_PATH);
        print_cstr(" (errno ");
        print_i64(0 - fd);
        print_cstr(")\n");
        return 1;
    }
    print_cstr("opened ");
    print_cstr(DRM_RENDER_NODE_PATH);
    print_cstr(" fd=");
    print_i64(fd);
    print_cstr("\n");

    var ver[64];
    memset(&ver, 0, 64);
    var rc = native_drm_version(fd, &ver);
    if (rc != 0) {
        print_cstr("FAIL: DRM_IOCTL_VERSION returned ");
        print_i64(rc);
        print_cstr("\n");
        sys_close(fd);
        return 2;
    }

    var major = load32(&ver + 0);
    var minor = load32(&ver + 4);
    var patch = load32(&ver + 8);
    var name_len = load64(&ver + 16);
    var name_ptr = load64(&ver + 24);

    print_cstr("driver name:    ");
    if (name_ptr != 0) {
        syscall(1, 1, name_ptr, name_len);
    }
    print_cstr("\n");
    print_cstr("driver version: ");
    print_i64(major);
    print_cstr(".");
    print_i64(minor);
    print_cstr(".");
    print_i64(patch);
    print_cstr("  (expect nouveau 1.4.x for the VM_BIND uAPI)\n");

    if (native_nv_is_nouveau(&ver) == 0) {
        print_cstr("FAIL: driver is not nouveau\n");
        sys_close(fd);
        return 3;
    }
    print_cstr("driver is nouveau: OK\n");

    # GETPARAM chipset + PCI ids. Decimal printed (no hex formatter in the
    # pure-Cyrius print path); expected hex shown alongside.
    var chipset[8];
    memset(&chipset, 0, 8);
    rc = native_nv_getparam(fd, NOUVEAU_GETPARAM_CHIPSET_ID, &chipset);
    if (rc != 0) {
        print_cstr("FAIL: GETPARAM(CHIPSET_ID) returned ");
        print_i64(rc);
        print_cstr("\n");
        sys_close(fd);
        return 4;
    }
    var vendor[8];
    memset(&vendor, 0, 8);
    rc = native_nv_getparam(fd, NOUVEAU_GETPARAM_PCI_VENDOR, &vendor);
    if (rc != 0) {
        print_cstr("FAIL: GETPARAM(PCI_VENDOR) returned ");
        print_i64(rc);
        print_cstr("\n");
        sys_close(fd);
        return 4;
    }
    var device[8];
    memset(&device, 0, 8);
    rc = native_nv_getparam(fd, NOUVEAU_GETPARAM_PCI_DEVICE, &device);
    if (rc != 0) {
        print_cstr("FAIL: GETPARAM(PCI_DEVICE) returned ");
        print_i64(rc);
        print_cstr("\n");
        sys_close(fd);
        return 4;
    }

    print_cstr("chipset id:     ");
    print_i64(load64(&chipset));
    print_cstr("  (expect 360 = 0x168 = TU116/NV168)\n");
    print_cstr("pci vendor:     ");
    print_i64(load64(&vendor));
    print_cstr("  (expect 4318 = 0x10DE NVIDIA)\n");
    print_cstr("pci device:     ");
    print_i64(load64(&device));
    print_cstr("  (expect 8644 = 0x21C4 GTX 1660 SUPER)\n");

    # N0.7(b) masterless probe. VM_INIT is DRM_RENDER_ALLOW in mainline
    # nouveau, so on a render node it must NOT fail with EACCES/EPERM.
    rc = native_nv_vm_init(fd, NOUVEAU_VM_KERNEL_RESERVATION_START,
      NOUVEAU_VM_KERNEL_RESERVATION_SIZE);
    print_cstr("VM_INIT rc:     ");
    print_i64(rc);
    if (native_nv_rc_is_masterless(rc) == 0) {
        print_cstr("  -> FAIL: permission denied, DRM master required\n");
        sys_close(fd);
        return 5;
    }
    if (rc == 0) {
        print_cstr("  -> OK: VA space initialized masterless\n");
    } else {
        print_cstr("  -> OK: render-allowed (non-permission rc; uAPI reachable masterless)\n");
    }

    sys_close(fd);
    print_cstr("OK\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
