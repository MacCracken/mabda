# programs/native_spirv_f64_select_e2e.cyr — v3.2 Phase F.7f.8: f64 compare + OpSelect on Cezanne.
#
# out[lid.x] = (a[i] > b[i]) ? a[i] : b[i]  (= max via OpFOrdGreaterThan + OpSelect). Exercises the
# F.7f.8 path: an ordered f64 compare -> a 0/-1 MASK (v_cmp_gt_f64 -> VCC -> cndmask), then OpSelect
# blends with v_bfi_b32 (mask ? a : b) per f64 half (no VCC at select time -> order-independent).
# attn11 uses this for argmax/masking. Result BIT-EXACT vs the in-process select.
# Linked native via `make test-native-spirv-f64-select-e2e`. Exit: 0 pass; 2 compile; 9 dispatch; 11 mismatch.

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 { var b[32]; memset(&b, 0, 32); var l = fmt_int_buf(n, &b); syscall(1, 1, &b, l); return 0; }
fn print_hex64(v): i64 {
    var digits = "0123456789ABCDEF"; var b[18]; store8(&b + 0, 48); store8(&b + 1, 120);
    var i = 0; while (i < 16) { store8(&b + 2 + i, load8(digits + ((v >> ((15 - i) * 4)) & 0xF))); i = i + 1; }
    syscall(1, 1, &b, 18); return 0;
}
fn mono_ns(): i64 { var ts[16]; syscall(228, 1, &ts); return load64(&ts + 0) * 1000000000 + load64(&ts + 8); }

var N_LANES = 8;

fn fill_a(a): i64 {
    store64(a + 0 , 0x4008000000000000);   # 3
    store64(a + 8 , 0x3FF0000000000000);   # 1
    store64(a + 16, 0xC000000000000000);   # -2
    store64(a + 24, 0x4004000000000000);   # 2.5
    store64(a + 32, 0x401C000000000000);   # 7
    store64(a + 40, 0x0000000000000000);   # 0
    store64(a + 48, 0x4202A05F20000000);   # 1e+10
    store64(a + 56, 0xBFF0000000000000);   # -1
    return 0;
}
fn fill_b(b): i64 {
    store64(b + 0 , 0x3FF0000000000000);   # 1
    store64(b + 8 , 0x4008000000000000);   # 3
    store64(b + 16, 0xC014000000000000);   # -5
    store64(b + 24, 0x4004000000000000);   # 2.5
    store64(b + 32, 0xC01C000000000000);   # -7
    store64(b + 40, 0x8000000000000000);   # -0
    store64(b + 48, 0x3FF0000000000000);   # 1
    store64(b + 56, 0x3FF0000000000000);   # 1
    return 0;
}
fn fill_wants(want): i64 {
    store64(want + 0 , 0x4008000000000000);   # (3>1)?3:1
    store64(want + 8 , 0x4008000000000000);   # (1>3)?1:3
    store64(want + 16, 0xC000000000000000);   # (-2>-5)?-2:-5
    store64(want + 24, 0x4004000000000000);   # (2.5>2.5)?2.5:2.5
    store64(want + 32, 0x401C000000000000);   # (7>-7)?7:-7
    store64(want + 40, 0x8000000000000000);   # (0>-0)?0:-0
    store64(want + 48, 0x4202A05F20000000);   # (1e+10>1)?1e+10:1
    store64(want + 56, 0x3FF0000000000000);   # (-1>1)?-1:1
    return 0;
}

