# programs/native_texture_e2e.cyr — v3 Step 5.8
#
# End-to-end native 2D RGBA8 texture round-trip on real AMD hardware.
# Validates the full chain: public gpu_texture_* dispatchers (Step
# 5.7) → ctx->backend->slot via fncall (Step 5.4 layout) → native
# slot wrappers (Step 5.6) → native_texture_create_2d_rgba8 + memcpy
# primitives (Steps 5.1, 5.2).
#
# Flow:
#   1. gpu_context_new_native() — opens fd, allocates ctx + cached IB/fence/stub
#   2. gpu_texture_create_2d_rgba8(ctx, W, H) — alloc GTT BO + va_map at tex VA
#   3. gpu_texture_write(ctx, tex, src, N) — memcpy src → tex.addr
#   4. gpu_texture_read(ctx, tex, dst, N) — memcpy tex.addr → dst
#   5. byte-exact verify dst against src
#   6. gpu_texture_release(ctx, tex) — va_unmap + bo_release_gtt + zero struct
#   7. gpu_context_release(ctx) — frees ctx_id, closes fd, kernel auto-releases stub/IB/fence
#
# Exit codes:
#   0  — round-trip OK; bytes match
#   1  — gpu_context_new_native failed
#   2  — gpu_texture_create returned 0
#   3  — gpu_texture_write returned non-zero
#   4  — gpu_texture_read returned non-zero
#   5  — byte mismatch in verification

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}

fn main(): i64 {
    alloc_init();
    print_cstr("mabda native texture round-trip (v3 Step 5.8)\n");
    print_cstr("---------------------------------------------\n");

    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) {
        print_cstr("FAIL: gpu_context_new_native\n");
        return 1;
    }
    var ctx = payload(ctx_res);
    print_cstr("ctx ready (fd="); print_i64(native_ctx_fd(ctx));
    print_cstr(", ctx_id="); print_i64(native_ctx_id(ctx)); print_cstr(")\n");

    # 64x32 RGBA8 = 8192 bytes. Width 64 satisfies wgpu's
    # COPY_BUFFER_ALIGNMENT = 256 (64 * 4 = 256), so the same
    # program would work under wgpu too if MABDA_BACKEND_KIND
    # were AMD vs WGPU — left as a Step 5.9 follow-up.
    var W = 64;
    var H = 32;
    var N = W * H * 4;

    var tex = gpu_texture_create_2d_rgba8(ctx, W, H);
    if (tex == 0) {
        print_cstr("FAIL: gpu_texture_create_2d_rgba8\n");
        gpu_context_release(ctx);
        return 2;
    }
    print_cstr("texture created: "); print_i64(W); print_cstr("x");
    print_i64(H); print_cstr(" ("); print_i64(N); print_cstr(" bytes)\n");

    # Build a deterministic per-byte pattern. (i * 7 + 1) & 0xFF
    # cycles through 256 values quickly so any byte-position bug
    # shows up as a localised mismatch rather than as an entire-
    # buffer drift.
    var src = alloc(N);
    var dst = alloc(N);
    var i = 0;
    while (i < N) {
        store8(src + i, (i * 7 + 1) & 0xFF);
        i = i + 1;
    }

    var rc_w = gpu_texture_write(ctx, tex, src, N);
    if (rc_w != 0) {
        print_cstr("FAIL: gpu_texture_write rc="); print_i64(rc_w); print_cstr("\n");
        gpu_texture_release(ctx, tex);
        gpu_context_release(ctx);
        return 3;
    }
    print_cstr("write done\n");

    memset(dst, 0, N);
    var rc_r = gpu_texture_read(ctx, tex, dst, N);
    if (rc_r != 0) {
        print_cstr("FAIL: gpu_texture_read rc="); print_i64(rc_r); print_cstr("\n");
        gpu_texture_release(ctx, tex);
        gpu_context_release(ctx);
        return 4;
    }
    print_cstr("read done\n");

    # Byte-exact verify.
    var j = 0;
    var mismatches = 0;
    while (j < N) {
        var s = load8(src + j);
        var d = load8(dst + j);
        if (s != d) {
            if (mismatches < 4) {
                print_cstr("MISMATCH at offset "); print_i64(j);
                print_cstr(": src=0x"); print_i64(s);
                print_cstr(" dst=0x"); print_i64(d); print_cstr("\n");
            }
            mismatches = mismatches + 1;
        }
        j = j + 1;
    }
    if (mismatches > 0) {
        print_cstr("FAIL: "); print_i64(mismatches);
        print_cstr(" of "); print_i64(N); print_cstr(" bytes mismatched\n");
        gpu_texture_release(ctx, tex);
        gpu_context_release(ctx);
        return 5;
    }
    print_cstr("verify OK: "); print_i64(N); print_cstr(" bytes match byte-exact\n");

    gpu_texture_release(ctx, tex);
    print_cstr("texture released\n");
    gpu_context_release(ctx);
    print_cstr("OK — texture round-trip via Backend abstraction works on native\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
