# programs/native_sdma_copy_e2e.cyr — v3.1 Q.5 SDMA bring-up spike
#
# Empirically validates that an SDMA COPY_LINEAR packet submitted on the
# DMA ring (AMDGPU_HW_IP_DMA) is accepted by this kernel and actually
# copies bytes. Isolated from the queue abstraction + timeline path: it
# uses the proven 4-chunk binary-syncobj submit (native_cs_submit_4chunk)
# directly on HW_IP_DMA, so a failure here points squarely at the SDMA
# packet/ring, not at queue plumbing.
#
# If this passes, the TRANSFER queue can flip from its COMPUTE-ring
# fallback to a real SDMA ring (and the timeline transfer driver gets
# wired). If it fails/TDRs, the COMPUTE-ring fallback stays and SDMA
# submit is deferred — the packet builder still ships as foundation.
#
# Exit codes:
#   0  — buf_b == buf_a across the whole page (SDMA copy works)
#   1  — gpu_context_new_native failed
#   2  — buf_a setup failed
#   3  — buf_b setup failed
#   8  — syncobj create failed
#   9  — CS submit (HW_IP_DMA) failed
#   10 — syncobj wait failed (timeout / TDR)
#   11 — readback mismatch

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}
fn mono_ns(): i64 {
    var ts[16];
    syscall(228, 1, &ts);
    return load64(&ts + 0) * 1000000000 + load64(&ts + 8);
}

fn main(): i64 {
    alloc_init();
    print_cstr("mabda native SDMA copy spike (v3.1 Q.5)\n");
    print_cstr("---------------------------------------\n");

    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) { print_cstr("FAIL: ctx\n"); return 1; }
    var ctx = payload(ctx_res);
    var fd = native_ctx_fd(ctx);
    var ctx_id = native_ctx_id(ctx);
    var ib_handle = native_ctx_ib_handle(ctx);
    var ib_va     = native_ctx_ib_va(ctx);
    var ib_addr   = native_ctx_ib_addr(ctx);
    var fence_handle = native_ctx_fence_handle(ctx);

    var bytes = 4096;

    # ---- Source BO: filled with a per-dword pattern ----
    var src_bo[16];
    var rc = native_bo_create_gtt(fd, bytes, &src_bo);
    if (rc != 0) { print_cstr("FAIL: src bo\n"); gpu_context_release(ctx); return 2; }
    var src_handle = load64(&src_bo + 0);
    var src_map    = load64(&src_bo + 8);
    var i = 0;
    while (i < bytes / 4) { store32(src_map + i * 4, 0xC0DE0000 + i); i = i + 1; }
    var src_va = 0xFFFF800100400000;
    rc = native_gem_va_map(fd, src_handle, src_va, bytes, _NATIVE_PERM_DATA);
    if (rc != 0) { print_cstr("FAIL: src va\n"); return 2; }

    # ---- Dest BO: zeroed ----
    var dst_bo[16];
    rc = native_bo_create_gtt(fd, bytes, &dst_bo);
    if (rc != 0) { print_cstr("FAIL: dst bo\n"); return 3; }
    var dst_handle = load64(&dst_bo + 0);
    var dst_map    = load64(&dst_bo + 8);
    memset(dst_map, 0, bytes);
    var dst_va = 0xFFFF800100440000;
    rc = native_gem_va_map(fd, dst_handle, dst_va, bytes, _NATIVE_PERM_DATA);
    if (rc != 0) { print_cstr("FAIL: dst va\n"); return 3; }

    # ---- Build the SDMA COPY_LINEAR packet into the cached IB ----
    memset(ib_addr, 0, 4096);
    var sdma_bytes = native_sdma_build_copy_linear(ib_addr, src_va, dst_va, bytes);
    print_cstr("SDMA packet bytes="); print_i64(sdma_bytes); print_cstr("\n");

    # ---- Residency list: ib, fence, src, dst ----
    var entries[32];
    store32(&entries +  0, fence_handle); store32(&entries +  4, 1);
    store32(&entries +  8, ib_handle);    store32(&entries + 12, 10);
    store32(&entries + 16, src_handle);   store32(&entries + 20, 3);
    store32(&entries + 24, dst_handle);   store32(&entries + 28, 3);
    var bo_list_in[24];
    store32(&bo_list_in +  0, 0xFFFFFFFF);
    store32(&bo_list_in +  4, 0xFFFFFFFF);
    store32(&bo_list_in +  8, 4);
    store32(&bo_list_in + 12, 8);
    store64(&bo_list_in + 16, &entries);

    # ---- Submit on the DMA ring (binary syncobj, ib_flags=0) ----
    var syncobj_buf[8];
    rc = native_syncobj_create(fd, &syncobj_buf);
    if (rc != 0) { print_cstr("FAIL: syncobj create\n"); gpu_context_release(ctx); return 8; }
    var syncobj = load64(&syncobj_buf);

    var t0 = mono_ns();
    rc = native_cs_submit_4chunk(fd, ctx_id, &bo_list_in, ib_va, sdma_bytes,
    AMDGPU_HW_IP_DMA, syncobj, fence_handle, 32, 0);
    if (rc != 0) {
        print_cstr("FAIL: SDMA submit rc="); print_i64(rc); print_cstr("\n");
        native_syncobj_destroy(fd, syncobj); gpu_context_release(ctx); return 9;
    }
    var wait_rc = native_syncobj_wait(fd, syncobj, mono_ns() + 15000000000);
    var elapsed_ms = (mono_ns() - t0) / 1000000;
    print_cstr("submit-to-signal: "); print_i64(elapsed_ms); print_cstr(" ms");
    if (elapsed_ms >= 9000) { print_cstr(" (likely TDR)"); }
    print_cstr("\n");
    native_syncobj_destroy(fd, syncobj);
    if (wait_rc != 0) { print_cstr("FAIL: wait rc="); print_i64(wait_rc); print_cstr("\n");
        gpu_context_release(ctx); return 10; }

    # ---- Verify the whole page copied ----
    var bad = 0 - 1;
    var j = 0;
    while (j < bytes / 4) {
        if (load32(dst_map + j * 4) != 0xC0DE0000 + j) { bad = j; j = bytes; }
        j = j + 1;
    }
    if (bad != 0 - 1) {
        print_cstr("FAIL: mismatch at dword "); print_i64(bad);
        print_cstr(" got "); print_i64(load32(dst_map + bad * 4)); print_cstr("\n");
        gpu_context_release(ctx); return 11;
    }
    print_cstr("dst[0]="); print_i64(load32(dst_map + 0));
    print_cstr(" dst[last]="); print_i64(load32(dst_map + (bytes / 4 - 1) * 4)); print_cstr("\n");

    native_gem_va_unmap(fd, src_handle, src_va, bytes);
    native_bo_release_gtt(fd, src_handle, src_map, bytes);
    native_gem_va_unmap(fd, dst_handle, dst_va, bytes);
    native_bo_release_gtt(fd, dst_handle, dst_map, bytes);
    gpu_context_release(ctx);
    print_cstr("OK — SDMA COPY_LINEAR on the DMA ring copied 4096 bytes\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
