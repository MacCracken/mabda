# programs/nvidia_spirv_compute_e2e.cyr — N9.4/N9.5: SPIR-V compiled to SM75 SASS in-tree and run on
# the native NVIDIA backend through the PUBLIC gpu_* API (TU116 / nouveau). The N9 hardware gate
# (docs/proposals/n9-spirv-to-sass.md §7).
#
# Kernels: tests/tcyr/spirv_cf_kernels.cyr — the same ones the AMD control-flow gate runs
# (binding 0 = a[64] seeded a[i] = i, binding 1 = o[64] seeded 0xDEADBEEF, one 64-lane block).
# Each kernel's NVIDIA expectation is generated (cfk_nv_refuse / cfk_nv_want, from the
# `; nv-want:` / `; nv-refuse:` lines in tests/spirv/control_flow/): every kernel compiles and
# produces all 64 lanes exactly, except
#   - oob_label: refused by lowering with MIR_ERR_ID_OOR, as on AMD;
#   - loop_phi_f64: refused with SM75_ERR_UNSUPPORTED_OP (f64 is not selected for NVIDIA yet,
#     the design note's §7).
# Where NVIDIA differs from AMD it runs instead of refusing: refuse_return_in_loop (EXIT retires
# only the threads that run it) and if_nest9 (no saved-EXEC pairs, so no nesting limit).
#
# Exit: 0 = every expectation met; 3 = context; 5 = buffers; 11 = any kernel wrong.

include "src/lib.cyr"
include "tests/tcyr/spirv_cf_kernels.cyr"

fn out(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn outn(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}

fn main(): i64 {
    alloc_init();
    out("mabda NVIDIA SPIR-V e2e (N9) — SPIR-V -> SM75 SASS in-tree, run on the TU116\n");
    out("------------------------------------------------------------------------------\n");
    var res_tag, res = gpu_context_new_native_nvidia();
    if (is_err_result(res_tag) == 1) { out("FAIL: no NVIDIA context\n"); return 3; }
    var ctx = res;
    var a = gpu_buffer_create(ctx, 4096, 0);
    var o = gpu_buffer_create(ctx, 4096, 0);
    if (a == 0) { return 5; }
    if (o == 0) { return 5; }
    var ap = gpu_buffer_map(ctx, a);
    var op = gpu_buffer_map(ctx, o);
    if (ap == 0) { return 5; }
    if (op == 0) { return 5; }
    var bp[40];
    store64(&bp, 2);
    store64(&bp + 8, load64(a + NV_BUF_HANDLE));
    store64(&bp + 16, load64(a + NV_BUF_VA));
    store64(&bp + 24, load64(o + NV_BUF_HANDLE));
    store64(&bp + 32, load64(o + NV_BUF_VA));

    var spv[1680];       # CFK_MAX_BYTES
    var want[256];
    var ran = 0;
    var refused = 0;
    var fail = 0;
    var k = 0;
    while (k < CFK_COUNT) {
        var name = cfk_name(k);
        var n = cfk_build(k, &spv);
        out("  "); out(name); out(": ");
        var expect = cfk_nv_refuse(k);
        _gpu_set_last_shader_err(0);
        var m = gpu_shader_module_create_spirv(ctx, &spv, n);
        var got = gpu_last_shader_error();
        if (expect != 0) {
            if (m != 0) {
                out("FAIL — compiled, expected "); out(gpu_shader_error_name(expect)); out("\n");
                gpu_shader_module_release(ctx, m);
                fail = fail + 1;
            } else {
                if (got == expect) {
                    out("refused as expected — "); out(gpu_shader_error_name(got)); out("\n");
                    refused = refused + 1;
                } else {
                    out("FAIL — refused with "); out(gpu_shader_error_name(got));
                    out(", expected "); out(gpu_shader_error_name(expect)); out("\n");
                    fail = fail + 1;
                }
            }
        } else {
            if (m == 0) {
                out("FAIL — create_spirv returned 0: "); out(gpu_shader_error_name(got)); out("\n");
                fail = fail + 1;
            } else {
                var i = 0;
                while (i < 64) {
                    store32(ap + i * 4, i);
                    store32(op + i * 4, 0xDEADBEEF);
                    i = i + 1;
                }
                var rc = gpu_compute_dispatch(ctx, m, 1, 1, 1, &bp);
                if (rc != 0) {
                    out("FAIL — dispatch rc="); outn(rc); out("\n");
                    fail = fail + 1;
                } else {
                    cfk_nv_want(k, &want);
                    var bad = 0;
                    i = 0;
                    while (i < 64) {
                        var g = load32(op + i * 4);
                        var w = load32(&want + i * 4);
                        if (g != w) {
                            if (bad < 3) { out("o["); outn(i); out("]="); outn(g); out(" want "); outn(w); out(" "); }
                            bad = bad + 1;
                        }
                        i = i + 1;
                    }
                    if (bad == 0) {
                        out("64/64 lanes (regs "); outn(load64(m + NV_SHMOD_REGCOUNT));
                        out(", block "); outn(load64(m + NV_SHMOD_LOCALX)); out(")\n");
                        ran = ran + 1;
                    } else {
                        out("FAIL — "); outn(bad); out(" lanes wrong\n");
                        fail = fail + 1;
                    }
                }
                gpu_shader_module_release(ctx, m);
            }
        }
        k = k + 1;
    }
    gpu_buffer_release(ctx, a);
    gpu_buffer_release(ctx, o);
    gpu_context_release(ctx);
    out("NVIDIA SPIR-V: "); outn(ran); out(" ran exactly, "); outn(refused); out(" refused as expected, ");
    outn(fail); out(" failed (of "); outn(CFK_COUNT); out(")\n");
    if (fail != 0) { return 11; }
    out("OK — every control-flow kernel ran right on the TU116\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
