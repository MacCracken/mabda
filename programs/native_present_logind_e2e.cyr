# programs/native_present_logind_e2e.cyr — 4.4.0 seat closeout: the samvada live-bus run.
#
# The in-session present path end to end on hardware: DRM master delegated by systemd-logind
# over the system dbus, through samvada's pure-Cyrius client, instead of the kiosk path's
# SET_MASTER on a self-opened card fd.
#   1. samvada_native_init() connects to the system bus and finds this process's session;
#   2. gpu_surface_configure_native_logind takes /dev/dri/card0 (or card1) from logind with
#      TakeDevice (samvada takes session control first, lazily), and modesets;
#   3. 120 presented frames of the scrolling gradient;
#   4. gpu_surface_release hands the device back to logind (ReleaseDevice) and closes the fd;
#   5. a second configure + 30 frames: it can only take the device if step 4 returned it.
# samvada 1.1.0 deletes its libsystemd shim once this run has passed (its roadmap).
#
# `amd` (the native AMD backend) or `nvidia` (nouveau). The NVIDIA run is the check for the
# 4.4.0 fix: until then an NVIDIA surface was never marked as owning its logind fd, so release
# kept the device and phase 2 could not take it again.
#
# **Run from a text-console login** (Ctrl-Alt-F3), with the display manager stopped: the
# session must be the active one and logind must not have handed the card to another session's
# compositor. While it runs, logind mutes this VT's keyboard (session control); it is restored
# when the program exits. Built with -D MABDA_LOGIND (`make test-native-logind-present-e2e` /
# `make test-nvidia-logind-present-e2e`).
#
# Exit codes:
#   0 both phases presented, the device returned between them
#   1 usage (amd|nvidia)
#   2 samvada_native_init failed (no system bus / no logind session for this process)
#   4 gpu_context_new_native failed
#   5 phase 1: logind would not hand over the card (not the active session? another controller?)
#   6 acquire returned 0     7 present failed
#   8 phase 2: the device did not come back after release
#   9 the configured surface was not marked as owning its logind fd

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}

fn _fill_gradient(addr, w, h, pitch, frame_offset): i64 {
    var y = 0;
    while (y < h) {
        var virt_y = (y + frame_offset) % h;
        var r = (virt_y * 255) / h;
        var pixel = (r << 16) | (255 - r);
        var row = addr + y * pitch;
        var x = 0;
        while (x < w) {
            store32(row + x * 4, pixel);
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

var g_nv = 0;   # 1: the NVIDIA backend's NvSurface, else AMD's NativeSurface

fn s_w(s): i64 { if (g_nv == 1) { return load32(s + NV_SURFACE_WIDTH); } return load32(s + NATIVE_SURFACE_WIDTH); }
fn s_h(s): i64 { if (g_nv == 1) { return load32(s + NV_SURFACE_HEIGHT); } return load32(s + NATIVE_SURFACE_HEIGHT); }
fn s_pitch(s): i64 { if (g_nv == 1) { return load32(s + NV_SURFACE_PITCH); } return load32(s + NATIVE_SURFACE_PITCH); }
fn s_owned(s): i64 {
    if (g_nv == 1) { return load32(s + NV_SURFACE_MASTER_OWNED); }
    return load32(s + NATIVE_SURFACE_MASTER_OWNED);
}

# The CPU address of the frame acquire returned.
fn frame_addr(s, fb): i64 {
    if (g_nv == 1) { return load64(fb + NV_SFB_MAPPED); }
    if (fb == s + NATIVE_SURFACE_FB_B) { return load64(fb + NATIVE_KMS_FB_MAPPED_ADDR); }
    if (fb == s + NATIVE_SURFACE_SCANOUT) { return load64(fb + NATIVE_KMS_SCANOUT_MAPPED_ADDR); }
    return 0;
}

var g_mode_w = 0;
var g_mode_h = 0;

# The connector's preferred mode, read without master from the card logind will hand over: an
# AMD surface must be configured with exactly that size (NVIDIA takes it as a hint). Returns 0
# when found. AMD: card0 then card1 (gpu_surface_configure_native_logind's minors); NVIDIA: the
# nouveau card.
fn query_mode(): i64 {
    var fd = 0 - 1;
    if (g_nv == 1) {
        var which[4];
        fd = native_nv_open_card_node(&which);
    } else {
        fd = syscall(2, "/dev/dri/card0", 2, 0);
        if (fd < 0) { fd = syscall(2, "/dev/dri/card1", 2, 0); }
    }
    if (fd < 0) { return 0 - 1; }
    var wh[16];
    var r = native_kms_first_connected_mode(fd, &wh);
    sys_close(fd);
    if (r != 0) { return 0 - 1; }
    g_mode_w = load64(&wh);
    g_mode_h = load64(&wh + 8);
    return 0;
}

# Configure through logind, present `frames` frames, release. Returns 0 or an exit code
# (`fail_configure` when logind would not hand the card over).
fn run_phase(ctx, label, frames, fail_configure): i64 {
    gpu_error_clear();
    var surface = gpu_surface_configure_native_logind(ctx, g_mode_w, g_mode_h);
    if (surface == 0) {
        print_cstr("FAIL: "); print_cstr(label);
        print_cstr(": gpu_surface_configure_native_logind returned 0 (logind refused TakeDevice, or the\n");
        print_cstr("      configure failed). Run from a text-console login with the display manager stopped.\n");
        if (gpu_last_error() != 0) { print_cstr("      "); print_cstr(gpu_last_error_message()); print_cstr("\n"); }
        return fail_configure;
    }
    var w = s_w(surface);
    var h = s_h(surface);
    var pitch = s_pitch(surface);
    print_cstr(label); print_cstr(": logind handed over the card; ");
    print_i64(w); print_cstr("x"); print_i64(h); print_cstr(", master owned by mabda: ");
    print_i64(s_owned(surface)); print_cstr("\n");
    # the fd logind handed over: O_NONBLOCK (04000) is why a bare read() of the flip event failed
    var cfd = load32(surface + NATIVE_SURFACE_CARD_FD);
    if (g_nv == 1) { cfd = load32(surface + NV_SURFACE_CARD_FD); }
    var fl = syscall(72, cfd, 3, 0);
    print_cstr("  the card fd's O_NONBLOCK: ");
    if (fl < 0) { print_cstr("unknown"); } else { print_i64((fl / 0x800) % 2); }
    print_cstr(" (the present polls before reading the flip event, so either works)\n");
    if (s_owned(surface) != 1) {
        print_cstr("FAIL: the surface is not marked as owning its logind fd: release would keep the device\n");
        gpu_surface_release(ctx, surface);
        return 9;
    }
    var frame = 0;
    while (frame < frames) {
        var fb = gpu_surface_acquire(ctx, surface);
        if (fb == 0) {
            print_cstr("FAIL: acquire returned 0 at frame "); print_i64(frame); print_cstr("\n");
            gpu_surface_release(ctx, surface);
            return 6;
        }
        _fill_gradient(frame_addr(surface, fb), w, h, pitch, frame * 4);
        var rc = gpu_surface_present(ctx, surface);
        if (rc != 0) {
            print_cstr("FAIL: present returned "); print_i64(rc);
            print_cstr(" at frame "); print_i64(frame); print_cstr("\n");
            gpu_surface_release(ctx, surface);
            return 7;
        }
        frame = frame + 1;
    }
    gpu_surface_release(ctx, surface);
    print_cstr("  "); print_i64(frames); print_cstr(" frames presented; released (device back to logind)\n");
    return 0;
}

fn main(): i64 {
    alloc_init();
    args_init();
    if (argc() < 2) { print_cstr("usage: native_present_logind_e2e amd|nvidia\n"); return 1; }
    var which = 0;
    if (streq(argv(1), "amd") == 1) { which = 1; }
    if (streq(argv(1), "nvidia") == 1) { which = 2; g_nv = 1; }
    if (which == 0) { print_cstr("usage: native_present_logind_e2e amd|nvidia\n"); return 1; }
    print_cstr("mabda native present via logind (4.4.0 seat closeout: samvada live bus), on ");
    if (g_nv == 1) { print_cstr("NVIDIA (nouveau)\n"); } else { print_cstr("AMD\n"); }
    print_cstr("-----------------------------------------------------------------------\n");
    print_cstr("expect: ~2 s of a scrolling blue-red gradient, a blink, ~0.5 s more, then the console\n\n");
    var sr = samvada_native_init();
    if (sr != 0) {
        print_cstr("FAIL: samvada_native_init rc="); print_i64(sr);
        print_cstr(" (no system bus, or no logind session for this process)\n");
        return 2;
    }
    print_cstr("samvada: connected to the system bus, session found\n");
    if (query_mode() != 0) {
        print_cstr("FAIL: no card node with a connected connector to read the mode from\n");
        samvada_release();
        return 5;
    }
    print_cstr("connector mode "); print_i64(g_mode_w); print_cstr("x"); print_i64(g_mode_h); print_cstr("\n");
    var ctx = 0;
    if (g_nv == 1) {
        var nt, nv = gpu_context_new_native_nvidia();
        if (is_err_result(nt) == 1) {
            print_cstr("FAIL: gpu_context_new_native_nvidia\n");
            samvada_release();
            return 4;
        }
        ctx = nv;
    } else {
        var at, av = gpu_context_new_native();
        if (is_err_result(at) == 1) { print_cstr("FAIL: gpu_context_new_native\n"); samvada_release(); return 4; }
        ctx = av;
    }
    var rc = run_phase(ctx, "phase 1", 120, 5);
    if (rc == 0) { rc = run_phase(ctx, "phase 2 (the device came back)", 30, 8); }
    gpu_context_release(ctx);
    samvada_release();
    if (rc == 0) {
        print_cstr("OK: DRM master delegated by logind over the live system bus, presented, returned,\n");
        print_cstr("    and taken again\n");
    }
    return rc;
}

var exit_code = main();
syscall(60, exit_code);
