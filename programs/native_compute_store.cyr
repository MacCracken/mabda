# programs/native_compute_store.cyr — v3 Phase B.4 hardware integration
#
# First pure-Cyrius compute dispatch that actually writes a known
# value to GPU memory and verifies it byte-identical from the CPU
# side. The shader is `native_gfx9_shader_store_deadbeef` — a
# six-instruction GFX9 kernel that stores `0xDEADBEEF` to the VA
# pre-loaded in s[0:1], with GLC+SLC cache bypass + s_waitcnt so the
# store is CPU-visible by the time the sync-obj fires.
#
# The PM4 stream is built by the library (native_pm4_build_compute_store_deadbeef in
# src/backend_native_pm4.cyr, reached through gpu_compute_dispatch). It follows the same
# Mesa-order compute preamble as `programs/native_compute_spike.cyr`, but is not
# byte-identical to it:
#   - USER_DATA_0/1 carry the output VA; USER_DATA_2/3 carry the canonical-high stub VA
#     from gpu_context_new_native (the spike points USER_DATA_0 and USER_DATA_2/3 at a
#     user-low stub BO at 0x200000).
#   - TA_CS_BC_BASE_ADDR = 0 (the spike points it at the shader VA).
#   - Its CP-side WRITE_DATA marker (0xC0FFEE12 at stub+4) comes AFTER DISPATCH_DIRECT;
#     the spike's 0xCAFEBABE marker comes before it.
#   - 64 DW submitted with the 4-chunk FENCE shape (the spike: 256 DW, 3 chunks).
#
# How a hung dispatch shows up: the kernel's compute ring timeout completes it, and the
# syncobj then signals WITHOUT an error. The post-dispatch marker still lands (the CP has
# already moved past DISPATCH_DIRECT), so neither the wait nor the marker catches it. On
# kernel 7.1/7.2 that timeout is ~2 s (2012-2206 ms observed, 2026-08-19 and 2026-09-16);
# a clean dispatch here signals in 0-1 ms. The reset check after each dispatch
# (AMDGPU_CTX_OP_QUERY_STATE2) is the gate for it: flags = 0x1 after a hung dispatch.
#
# Exit codes:
#   0   — output buffer contains 0xDEADBEEF at [0]; sentinel intact at [1]
#   1   — open fd failed
#   2   — shader BO setup failed
#   3   — stub BO setup failed
#   4   — output BO setup failed
#   5   — IB BO setup failed
#   6   — context alloc failed
#   7   — BO list create failed
#   8   — syncobj create failed
#   9   — cs submit failed
#   10  — syncobj wait failed (timeout or error)
#   11  — readback mismatch at out[0]
#   12  — sentinel corrupted at out[1]
#   13  — re-seeding the output buffer before dispatch #2 failed
#   14  — dispatch #2 failed
#   15  — dispatch #2 post-dispatch marker stale (CP never ran past DISPATCH_DIRECT)
#   16  — dispatch #2 readback mismatch at out[0]
#   17  — dispatch #1: context state query failed, or it reported a reset
#   18  — dispatch #2: context state query failed, or it reported a reset

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}
fn print_hex32(v): i64 {
    var digits = "0123456789ABCDEF";
    var buf[10];
    store8(&buf + 0, 48);    # '0'
    store8(&buf + 1, 120);   # 'x'
    var i = 0;
    while (i < 8) {
        var nibble = (v / (1 << ((7 - i) * 4))) & 0xF;
        store8(&buf + 2 + i, load8(digits + nibble));
        i = i + 1;
    }
    syscall(1, 1, &buf, 10);
    return 0;
}

fn mono_ns(): i64 {
    var ts[16];
    syscall(228, 1, &ts);
    return load64(&ts + 0) * 1000000000 + load64(&ts + 8);
}

# Signal-latency hint. A clean dispatch signals in 0-1 ms; a hung one is completed by
# the ~2 s compute ring timeout (see the header). The hint is informational only: the
# reset check below decides pass/fail.
fn print_hang_hint(elapsed_ms): i64 {
    if (elapsed_ms >= 1500) {
        print_cstr(" (>= 1.5 s: the ~2 s compute ring-timeout signature - see the reset check)");
    }
    return 0;
}

# Returns 1 when AMDGPU_CTX_OP_QUERY_STATE2 on this context fails or reports a lost-work flag
# (native_ctx_state_lost: RESET/VRAMLOST/GUILTY/RESET_IN_PROGRESS), else 0.
# drm_amdgpu_ctx is a 16-byte union: in = {op u32, flags u32, ctx_id u32, priority i32};
# out.state = {flags u64, hangs u32, reset_status u32}. out.state.flags:
# RESET (bit 0), VRAMLOST (1), GUILTY (2), RAS_CE (3), RAS_UE (4), RESET_IN_PROGRESS (5).
# Hardware-checked 2026-09-16 (kernel 7.2.3): flags = 0x1 after a dispatch that hung and
# was ring-reset, 0x0 after a clean one. The job signal and the reset bookkeeping both
# happen in the kernel's timeout path, in an order this program does not rely on, so it
# settles 100 ms before asking (same as programs/native_compute_spike.cyr).
fn ctx_reset_seen(fd, ctx_id): i64 {
    var settle_ts[16];
    store64(&settle_ts + 0, 0);
    store64(&settle_ts + 8, 100000000);
    var slept = syscall(35, &settle_ts, 0);      # nanosleep
    if (slept != 0) { print_cstr("(settle nanosleep rc="); print_i64(slept); print_cstr(")\n"); }
    var state_req[16];
    var state_rc = native_ctx_query_state(fd, ctx_id, &state_req);
    print_cstr("ctx QUERY_STATE2: rc="); print_i64(state_rc);
    # On a failed ioctl the union still holds the request (op = 4 reads as the GUILTY
    # bit), so the flags are only read and printed after a successful call.
    var state_flags = 0;
    if (state_rc == 0) {
        state_flags = load64(&state_req + 0);
        print_cstr(" flags=0x"); fmt_hex(state_flags);
    }
    var seen = native_ctx_state_lost(state_rc, state_flags);
    if (seen == 0) { print_cstr("  OK (no reset during the dispatch)\n"); }
    if (seen != 0) { print_cstr("  FAIL (want rc=0 flags=0x0: the dispatch hung or a reset hit it)\n"); }
    return seen;
}

fn main(): i64 {
    alloc_init();

    print_cstr("mabda native compute STORE shader (v3 Phase B.4)\n");
    print_cstr("------------------------------------------------\n");

    # ---- Native GpuContext (Step 4e: gpu_context_new_native) ----
    # Opens the DRM render node, allocates the amdgpu context id,
    # creates and va-maps the Mesa-stub BO at canonical-high
    # 0xFFFF800100004000, attaches a backend_native_new() at +32.
    # All bring-up that used to live inline in this program now sits
    # behind the public API.
    var ctx_res_tag, ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res_tag) == 1) {
        print_cstr("FAIL: gpu_context_new_native\n");
        return 1;
    }
    var ctx = ctx_res;
    var fd = native_ctx_fd(ctx);
    var stub_handle = native_ctx_stub_handle(ctx);
    var stub_va = native_ctx_stub_va(ctx);
    print_cstr("fd="); print_i64(fd); print_cstr("\n");
    print_cstr("stub bo="); print_i64(stub_handle);
    print_cstr(" va=0x"); print_i64(stub_va); print_cstr("\n");

    # ---- Shader BO: 4 KiB GTT, store shader at offset 0 ----
    # Shader VA in the canonical-high aperture matches spike + Mesa.
    var shader_size = 4096;
    var shader_bo[16];
    var rc = native_bo_create_gtt(fd, shader_size, &shader_bo);
    if (rc != 0) {
        print_cstr("FAIL: shader bo create errno="); print_i64(0 - rc); print_cstr("\n");
        gpu_context_release(ctx); return 2;
    }
    var shader_handle = load64(&shader_bo + 0);
    var shader_map    = load64(&shader_bo + 8);
    memset(shader_map, 0, shader_size);
    native_gfx9_shader_store_deadbeef(shader_map, 0);
    var shader_va = 0xFFFF800100000000;
    rc = native_gem_va_map(fd, shader_handle, shader_va, shader_size,
      _NATIVE_PERM_SHADER);
    if (rc != 0) {
        print_cstr("FAIL: shader va_map errno="); print_i64(0 - rc); print_cstr("\n");
        return 2;
    }
    print_cstr("shader bo="); print_i64(shader_handle);
    print_cstr(" va=0x"); print_i64(shader_va); print_cstr("\n");

    # ---- Output BO: 4 KiB GTT, canonical-high VA, seeded with 0xBAADF00D ----
    # Keeping output in the same aperture as shader + IB matches Mesa's
    # pattern. 4 MiB above the IB (which goes to 0xFFFF800100200000) gives
    # non-overlapping VA with room to spare.
    var out_size = 4096;
    var out_bo[16];
    rc = native_bo_create_gtt(fd, out_size, &out_bo);
    if (rc != 0) {
        print_cstr("FAIL: output bo create errno="); print_i64(0 - rc); print_cstr("\n");
        return 4;
    }
    var out_handle = load64(&out_bo + 0);
    var out_map    = load64(&out_bo + 8);
    var sentinel = 0xBAADF00D;
    var si = 0;
    while (si < out_size / 4) {
        store32(out_map + si * 4, sentinel);
        si = si + 1;
    }
    var out_va = 0xFFFF800100400000;
    rc = native_gem_va_map(fd, out_handle, out_va, out_size,
      _NATIVE_PERM_DATA);
    if (rc != 0) {
        print_cstr("FAIL: output va_map errno="); print_i64(0 - rc); print_cstr("\n");
        return 4;
    }
    print_cstr("output bo="); print_i64(out_handle);
    print_cstr(" va=0x"); print_i64(out_va);
    print_cstr(" seeded with 0xBAADF00D\n");

    # ---- Dispatch through the Backend abstraction ----
    # The slot wrapper (_backend_native_compute_dispatch in
    # src/backend_native.cyr) builds the PM4 stream internally,
    # allocates per-call IB + fence + syncobj, submits via 4-chunk
    # Mesa shape, waits, and tears down ephemerals — all by routing
    # gpu_compute_dispatch() through ctx->backend->slot via fncall6.
    print_cstr("ctx_id="); print_i64(native_ctx_id(ctx)); print_cstr("\n");

    # Pack the (handle, va) pairs that the slot wrapper expects for
    # `shmod` and `bp` (private 16-byte convention).
    var shmod_pair[16];
    native_buf_pair_write(&shmod_pair, shader_handle, shader_va);
    var bp_pair[16];
    native_buf_pair_write(&bp_pair, out_handle, out_va);

    var t_submit_start = mono_ns();
    rc = gpu_compute_dispatch(ctx, &shmod_pair, 1, 1, 1, &bp_pair);
    var elapsed_ms = (mono_ns() - t_submit_start) / 1000000;
    print_cstr("submit-to-syncobj-signal: "); print_i64(elapsed_ms); print_cstr(" ms");
    print_hang_hint(elapsed_ms);
    print_cstr("\n");
    if (rc != 0) {
        print_cstr("FAIL: gpu_compute_dispatch rc="); print_i64(rc); print_cstr("\n");
        gpu_context_release(ctx);
        return 9;
    }
    var reset1 = ctx_reset_seen(fd, native_ctx_id(ctx));

    # ---- Verify output ----
    # Session 25b: the post-dispatch CP marker shows the CP ran past DISPATCH_DIRECT and
    # executed the packets after it. It does NOT show the wave finished: on 2026-09-16 a
    # dispatch that hung (~2 s ring timeout, ring reset) still left 0xC0FFEE12 here. The
    # output readback and the reset check are what show the dispatch completed.
    var marker_post = load32(native_ctx_stub_addr(ctx) + 4);
    print_cstr("post-dispatch marker = "); print_hex32(marker_post);
    if (marker_post == 0xC0FFEE12) { print_cstr(" OK (CP ran past DISPATCH_DIRECT)\n"); }
    if (marker_post != 0xC0FFEE12) { print_cstr(" STALE (CP did not return from dispatch)\n"); }
    var v0 = load32(out_map + 0);
    print_cstr("output[0] = "); print_hex32(v0); print_cstr(" (want 0xDEADBEEF)\n");
    if (v0 != 0xDEADBEEF) {
        print_cstr("FAIL: mismatch at [0]\n");
        gpu_context_release(ctx);
        return 11;
    }
    var v1 = load32(out_map + 4);
    if (v1 != sentinel) {
        print_cstr("FAIL: sentinel corrupted at [1] = "); print_hex32(v1); print_cstr("\n");
        return 12;
    }
    print_cstr("sentinel intact at [1]\n");
    if (reset1 != 0) {
        print_cstr("FAIL: dispatch #1 output looks right, but the context reports a reset\n");
        gpu_context_release(ctx);
        return 17;
    }

    # ---- Dispatch #2 (Step 5a: multi-dispatch validation) ----
    # Re-seed the output BO and dispatch the same shader through
    # the SAME ctx — exercises Step 4f.iv's cached IB + fence BOs.
    # If the cached path retained any state from dispatch #1 in a
    # way that breaks dispatch #2, this is where it surfaces.
    print_cstr("\n---- second dispatch on same ctx ----\n");
    var si2 = 0;
    while (si2 < out_size / 4) {
        store32(out_map + si2 * 4, sentinel);
        si2 = si2 + 1;
    }
    var v0_pre = load32(out_map + 0);
    if (v0_pre != sentinel) {
        print_cstr("FAIL: re-seed failed (pre-dispatch out[0] = ");
        print_hex32(v0_pre); print_cstr(")\n");
        gpu_context_release(ctx);
        return 13;
    }
    var t2 = mono_ns();
    rc = gpu_compute_dispatch(ctx, &shmod_pair, 1, 1, 1, &bp_pair);
    var elapsed2 = (mono_ns() - t2) / 1000000;
    print_cstr("dispatch #2 signal: "); print_i64(elapsed2); print_cstr(" ms");
    print_hang_hint(elapsed2);
    print_cstr("\n");
    if (rc != 0) {
        print_cstr("FAIL: dispatch #2 rc="); print_i64(rc); print_cstr("\n");
        gpu_context_release(ctx);
        return 14;
    }
    var reset2 = ctx_reset_seen(fd, native_ctx_id(ctx));
    var marker2 = load32(native_ctx_stub_addr(ctx) + 4);
    print_cstr("dispatch #2 marker = "); print_hex32(marker2);
    if (marker2 == 0xC0FFEE12) { print_cstr(" OK\n"); }
    if (marker2 != 0xC0FFEE12) {
        print_cstr(" STALE — second dispatch did not reach CP\n");
        gpu_context_release(ctx);
        return 15;
    }
    var v0_post = load32(out_map + 0);
    print_cstr("dispatch #2 output[0] = "); print_hex32(v0_post);
    if (v0_post != 0xDEADBEEF) {
        print_cstr(" FAIL: second dispatch did not write 0xDEADBEEF\n");
        gpu_context_release(ctx);
        return 16;
    }
    if (reset2 != 0) {
        print_cstr(" (value OK)\nFAIL: dispatch #2 output looks right, but the context reports a reset\n");
        gpu_context_release(ctx);
        return 18;
    }
    print_cstr(" OK — multi-dispatch on cached IB+fence path works\n");

    # ---- Teardown ----
    # Caller-owned BOs (shader / output) are released explicitly.
    # The stub BO is owned by the GpuContext now (allocated inside
    # gpu_context_new_native); kernel auto-releases it on fd close
    # via gpu_context_release → _backend_native_ctx_release.
    native_gem_va_unmap(fd, out_handle, out_va, out_size);
    native_bo_release_gtt(fd, out_handle, out_map, out_size);
    native_gem_va_unmap(fd, shader_handle, shader_va, shader_size);
    native_bo_release_gtt(fd, shader_handle, shader_map, shader_size);
    gpu_context_release(ctx);
    print_cstr("OK — GPU wrote 0xDEADBEEF via pure-Cyrius dispatch\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
