# programs/native_compute_store.cyr — v3 Phase B.4 hardware integration
#
# First pure-Cyrius compute dispatch that actually writes a known
# value to GPU memory and verifies it byte-identical from the CPU
# side. The shader is `native_gfx9_shader_store_deadbeef` — a
# six-instruction GFX9 kernel that stores `0xDEADBEEF` to the VA
# pre-loaded in s[0:1], with GLC+SLC cache bypass + s_waitcnt so the
# store is CPU-visible by the time the sync-obj fires.
#
# PM4 stream is byte-identical to `programs/native_compute_spike.cyr`
# (the working B.3.d baseline) except for:
#   - USER_DATA_0/1 carry the real output VA (spike used Mesa's
#     scratch-V# stub bytes there).
#   - USER_DATA_2/3 keep Mesa's scratch-V# stub values (the shader
#     doesn't read s2/s3, but the HW may implicitly reference them
#     during dispatch setup).
#   - BO list has 4 entries (shader + stub + output + IB).
#
# Exit codes:
#   0   — output buffer contains 0xDEADBEEF at [0]; sentinel intact at [1]
#   1   — open fd failed
#   2   — shader BO setup failed
#   3   — stub BO setup failed
#   4   — output BO setup failed
#   5   — IB BO setup failed
#   6   — context alloc failed
#   7   — BO list create failed
#   8   — syncobj create failed
#   9   — cs submit failed
#   10  — syncobj wait failed (timeout or error)
#   11  — readback mismatch at out[0]
#   12  — sentinel corrupted at out[1]

include "src/lib.cyr"

fn print_cstr(s) { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n) {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}
fn print_hex32(v) {
    var digits = "0123456789ABCDEF";
    var buf[10];
    store8(&buf + 0, 48);    # '0'
    store8(&buf + 1, 120);   # 'x'
    var i = 0;
    while (i < 8) {
        var nibble = (v / (1 << ((7 - i) * 4))) & 0xF;
        store8(&buf + 2 + i, load8(digits + nibble));
        i = i + 1;
    }
    syscall(1, 1, &buf, 10);
    return 0;
}

fn mono_ns() {
    var ts[16];
    syscall(228, 1, &ts);
    return load64(&ts + 0) * 1000000000 + load64(&ts + 8);
}

fn main() {
    alloc_init();

    print_cstr("mabda native compute STORE shader (v3 Phase B.4)\n");
    print_cstr("------------------------------------------------\n");

    var fd = native_open_render_node();
    if (fd < 0) { print_cstr("FAIL: open\n"); return 1; }
    print_cstr("fd="); print_i64(fd); print_cstr("\n");

    # ---- Shader BO: 4 KiB GTT, store shader at offset 0 ----
    # Shader VA in the canonical-high aperture matches spike + Mesa.
    var shader_size = 4096;
    var shader_bo[16];
    var rc = native_bo_create_gtt(fd, shader_size, &shader_bo);
    if (rc != 0) {
        print_cstr("FAIL: shader bo create errno="); print_i64(0 - rc); print_cstr("\n");
        sys_close(fd); return 2;
    }
    var shader_handle = load64(&shader_bo + 0);
    var shader_map    = load64(&shader_bo + 8);
    memset(shader_map, 0, shader_size);
    native_gfx9_shader_store_deadbeef(shader_map, 0);
    var shader_va = 0xFFFF800100000000;
    rc = native_gem_va_map(fd, shader_handle, shader_va, shader_size,
                           AMDGPU_VM_PAGE_READABLE | AMDGPU_VM_PAGE_WRITEABLE | AMDGPU_VM_PAGE_EXECUTABLE);
    if (rc != 0) {
        print_cstr("FAIL: shader va_map errno="); print_i64(0 - rc); print_cstr("\n");
        return 2;
    }
    print_cstr("shader bo="); print_i64(shader_handle);
    print_cstr(" va=0x"); print_i64(shader_va); print_cstr("\n");

    # ---- Stub BO at VA 0x200000 (Mesa's scratch-V# reference point) ----
    # See session 5/7 analysis in docs/issues/2026-04-21-gfx9-store-blocker.md.
    # The spike established that keeping this stub mapped is part of the
    # working baseline; we match its VA + size exactly.
    var stub_size = 4096;
    var stub_bo[16];
    rc = native_bo_create_gtt(fd, stub_size, &stub_bo);
    if (rc != 0) {
        print_cstr("FAIL: stub bo create errno="); print_i64(0 - rc); print_cstr("\n");
        return 3;
    }
    var stub_handle = load64(&stub_bo + 0);
    var stub_map    = load64(&stub_bo + 8);
    memset(stub_map, 0, stub_size);
    # Session 25b: stub at canonical-high VA. Earlier code used 0x200000
    # (user-low) on the (untested) hypothesis that compute queues accept
    # both halves. The session-25b post-dispatch WRITE_DATA marker test
    # showed user-low writes from the compute queue silently fail (marker
    # never landed in stub_map). Mirror the working C spike: HIGH VA for
    # everything.
    var stub_va = 0xFFFF800100004000;
    rc = native_gem_va_map(fd, stub_handle, stub_va, stub_size,
                           AMDGPU_VM_PAGE_READABLE | AMDGPU_VM_PAGE_WRITEABLE | AMDGPU_VM_PAGE_EXECUTABLE);
    if (rc != 0) {
        print_cstr("FAIL: stub va_map errno="); print_i64(0 - rc); print_cstr("\n");
        return 3;
    }
    print_cstr("stub bo="); print_i64(stub_handle);
    print_cstr(" va=0x"); print_i64(stub_va); print_cstr("\n");

    # ---- Output BO: 4 KiB GTT, canonical-high VA, seeded with 0xBAADF00D ----
    # Keeping output in the same aperture as shader + IB matches Mesa's
    # pattern. 4 MiB above the IB (which goes to 0xFFFF800100200000) gives
    # non-overlapping VA with room to spare.
    var out_size = 4096;
    var out_bo[16];
    rc = native_bo_create_gtt(fd, out_size, &out_bo);
    if (rc != 0) {
        print_cstr("FAIL: output bo create errno="); print_i64(0 - rc); print_cstr("\n");
        return 4;
    }
    var out_handle = load64(&out_bo + 0);
    var out_map    = load64(&out_bo + 8);
    var sentinel = 0xBAADF00D;
    var si = 0;
    while (si < out_size / 4) {
        store32(out_map + si * 4, sentinel);
        si = si + 1;
    }
    var out_va = 0xFFFF800100400000;
    rc = native_gem_va_map(fd, out_handle, out_va, out_size,
                           AMDGPU_VM_PAGE_READABLE | AMDGPU_VM_PAGE_WRITEABLE | AMDGPU_VM_PAGE_EXECUTABLE);
    if (rc != 0) {
        print_cstr("FAIL: output va_map errno="); print_i64(0 - rc); print_cstr("\n");
        return 4;
    }
    print_cstr("output bo="); print_i64(out_handle);
    print_cstr(" va=0x"); print_i64(out_va);
    print_cstr(" seeded with 0xBAADF00D\n");

    # ---- Build PM4 stream (Step 4a: extracted to backend_native.cyr) ----
    # native_pm4_build_compute_store_deadbeef() emits the full
    # Mesa-verified preamble + DISPATCH_DIRECT + post-dispatch
    # 0xC0FFEE12 marker + NOP padding. See src/backend_native.cyr
    # for the per-register sequence and Mesa-rusticl alignment.
    var pm4 = alloc(256);
    memset(pm4, 0, 256);
    var pm4_bytes = native_pm4_build_compute_store_deadbeef(pm4,
                                                            shader_va,
                                                            stub_va,
                                                            out_va,
                                                            1, 1, 1);
    print_cstr("pm4 stream bytes="); print_i64(pm4_bytes); print_cstr("\n");

    # Session 25b diagnostic — dump IB hex 8 dws/line. Diff against
    # docs/issues/session25b/spike.log to find where Cyrius vs C diverges.
    print_cstr("---- IB DUMP ----\n");
    var dw_total = pm4_bytes / 4;
    var di = 0;
    while (di < dw_total) {
        var hb[5];
        store8(&hb + 0, 48);  # '0'
        store8(&hb + 1, 120); # 'x'
        var dig = "0123456789abcdef";
        store8(&hb + 2, load8(dig + ((di / 256) & 0xF)));
        store8(&hb + 3, load8(dig + ((di /  16) & 0xF)));
        store8(&hb + 4, load8(dig + (di & 0xF)));
        syscall(1, 1, &hb, 5);
        print_cstr(":");
        var jj = 0;
        while (jj < 8) {
            if (di + jj < dw_total) {
                print_cstr(" ");
                print_hex32(load32(pm4 + (di + jj) * 4));
            }
            jj = jj + 1;
        }
        print_cstr("\n");
        di = di + 8;
    }
    print_cstr("---- IB DUMP END ----\n");

    # ---- Dispatch (Step 4b: extracted to native_compute_dispatch_simple) ----
    # Allocates IB + fence + syncobj internally, submits via 4-chunk
    # Mesa shape, waits up to 15s, releases ephemerals before return.
    var ctx_handle_block[16];
    rc = native_ctx_alloc(fd, &ctx_handle_block);
    if (rc != 0) {
        print_cstr("FAIL: ctx_alloc errno="); print_i64(0 - rc); print_cstr("\n");
        return 6;
    }
    var ctx_id = native_ctx_alloc_id(&ctx_handle_block);
    print_cstr("ctx_id="); print_i64(ctx_id); print_cstr("\n");

    var t_submit_start = mono_ns();
    rc = native_compute_dispatch_simple(fd, ctx_id, pm4, pm4_bytes,
                                        shader_handle, stub_handle, out_handle,
                                        t_submit_start + 15000000000);
    var elapsed_ms = (mono_ns() - t_submit_start) / 1000000;
    print_cstr("submit-to-syncobj-signal: "); print_i64(elapsed_ms); print_cstr(" ms");
    if (elapsed_ms >= 9000) { print_cstr(" (likely TDR — IB hung, kernel reset)"); }
    print_cstr("\n");
    if (rc != 0) {
        print_cstr("FAIL: native_compute_dispatch_simple rc="); print_i64(rc); print_cstr("\n");
        native_ctx_free(fd, ctx_id);
        sys_close(fd);
        return 9;
    }

    # ---- Verify output ----
    # Session 25b: read post-dispatch CP marker first — proves CP returned
    # from DISPATCH_DIRECT and ran further IB packets after the dispatch.
    var marker_post = load32(stub_map + 4);
    print_cstr("post-dispatch marker = "); print_hex32(marker_post);
    if (marker_post == 0xC0FFEE12) { print_cstr(" OK (CP cleared dispatch)\n"); }
    if (marker_post != 0xC0FFEE12) { print_cstr(" STALE (CP did not return from dispatch)\n"); }
    var v0 = load32(out_map + 0);
    print_cstr("output[0] = "); print_hex32(v0); print_cstr(" (want 0xDEADBEEF)\n");
    if (v0 != 0xDEADBEEF) {
        print_cstr("FAIL: mismatch at [0]\n");
        native_ctx_free(fd, ctx_id);
        sys_close(fd);
        return 11;
    }
    var v1 = load32(out_map + 4);
    if (v1 != sentinel) {
        print_cstr("FAIL: sentinel corrupted at [1] = "); print_hex32(v1); print_cstr("\n");
        return 12;
    }
    print_cstr("sentinel intact at [1]\n");

    # ---- Teardown ----
    native_ctx_free(fd, ctx_id);
    native_gem_va_unmap(fd, out_handle, out_va, out_size);
    native_bo_release_gtt(fd, out_handle, out_map, out_size);
    native_gem_va_unmap(fd, stub_handle, stub_va, stub_size);
    native_bo_release_gtt(fd, stub_handle, stub_map, stub_size);
    native_gem_va_unmap(fd, shader_handle, shader_va, shader_size);
    native_bo_release_gtt(fd, shader_handle, shader_map, shader_size);
    sys_close(fd);
    print_cstr("OK — GPU wrote 0xDEADBEEF via pure-Cyrius dispatch\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
