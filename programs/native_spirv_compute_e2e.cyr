# programs/native_spirv_compute_e2e.cyr — N.5d: first SPIR-V→GFX9 compiled
# compute kernel dispatched on real Cezanne hardware.
#
# Hand-authors the SPIR-V for `out[gl_LocalInvocationID.x] = lid.x*3 + 7`
# (LocalSize 8), runs it through the in-tree gfx9_compile compiler to GFX9 ISA +
# an RSRC descriptor, publishes the ISA to a GTT BO, dispatches one 8-thread
# workgroup via the generic compute composer (compiler RSRC1 + the proven
# deadbeef dispatch scaffold) + the cached submit path, and verifies all 8 output
# lanes from the CPU. A green run proves the compiler produced runnable, correct
# GFX9 from SPIR-V — the arithmetic (×3 +7) is per-lane, so it cannot be faked by
# a constant store.
#
# Exit: 0 = out[i] == i*3+7 for i in 0..7; 2 = compile failed; 3..9 = setup/
# dispatch failures; 11 = readback mismatch.

include "src/lib.cyr"

fn print_cstr(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n): i64 {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}
fn print_hex32(v): i64 {
    var digits = "0123456789ABCDEF";
    var buf[10];
    store8(&buf + 0, 48);
    store8(&buf + 1, 120);
    var i = 0;
    while (i < 8) {
        var nibble = (v / (1 << ((7 - i) * 4))) & 0xF;
        store8(&buf + 2 + i, load8(digits + nibble));
        i = i + 1;
    }
    syscall(1, 1, &buf, 10);
    return 0;
}

# SPIR-V (id-bound 22, 488 bytes) for out[lid.x] = lid.x*3 + 7, LocalSize 8 1 1.
fn build_idx_kernel(buf): i64 {
    store32(buf + 0, 0x07230203);
    store32(buf + 4, 0x00010300);
    store32(buf + 8, 0);
    store32(buf + 12, 22);
    store32(buf + 16, 0);
    store32(buf + 20, (2 << 16) | 17);   # OpCapability Shader
    store32(buf + 24, 1);
    store32(buf + 28, (3 << 16) | 14);   # OpMemoryModel Logical GLSL450
    store32(buf + 32, 0);
    store32(buf + 36, 1);
    store32(buf + 40, (6 << 16) | 15);   # OpEntryPoint GLCompute %15 "main" %13
    store32(buf + 44, 5);
    store32(buf + 48, 15);
    store32(buf + 52, 0x6E69616D);
    store32(buf + 56, 0);
    store32(buf + 60, 13);
    store32(buf + 64, (6 << 16) | 16);   # OpExecutionMode %15 LocalSize 8 1 1
    store32(buf + 68, 15);
    store32(buf + 72, 17);
    store32(buf + 76, 8);
    store32(buf + 80, 1);
    store32(buf + 84, 1);
    store32(buf + 88, (4 << 16) | 71);   # OpDecorate %13 BuiltIn LocalInvocationId
    store32(buf + 92, 13);
    store32(buf + 96, 11);
    store32(buf + 100, 27);
    store32(buf + 104, (4 << 16) | 71);  # OpDecorate %14 Binding 0
    store32(buf + 108, 14);
    store32(buf + 112, 33);
    store32(buf + 116, 0);
    store32(buf + 120, (4 << 16) | 71);  # OpDecorate %14 DescriptorSet 0
    store32(buf + 124, 14);
    store32(buf + 128, 34);
    store32(buf + 132, 0);
    store32(buf + 136, (2 << 16) | 19);  # OpTypeVoid %1
    store32(buf + 140, 1);
    store32(buf + 144, (3 << 16) | 33);  # OpTypeFunction %2 %1
    store32(buf + 148, 2);
    store32(buf + 152, 1);
    store32(buf + 156, (4 << 16) | 21);  # OpTypeInt %3 32 0
    store32(buf + 160, 3);
    store32(buf + 164, 32);
    store32(buf + 168, 0);
    store32(buf + 172, (4 << 16) | 23);  # OpTypeVector %4 %3 3
    store32(buf + 176, 4);
    store32(buf + 180, 3);
    store32(buf + 184, 3);
    store32(buf + 188, (4 << 16) | 32);  # OpTypePointer %5 Input %4
    store32(buf + 192, 5);
    store32(buf + 196, 1);
    store32(buf + 200, 4);
    store32(buf + 204, (3 << 16) | 29);  # OpTypeRuntimeArray %6 %3
    store32(buf + 208, 6);
    store32(buf + 212, 3);
    store32(buf + 216, (3 << 16) | 30);  # OpTypeStruct %7 %6
    store32(buf + 220, 7);
    store32(buf + 224, 6);
    store32(buf + 228, (4 << 16) | 32);  # OpTypePointer %8 StorageBuffer %7
    store32(buf + 232, 8);
    store32(buf + 236, 12);
    store32(buf + 240, 7);
    store32(buf + 244, (4 << 16) | 32);  # OpTypePointer %9 StorageBuffer %3
    store32(buf + 248, 9);
    store32(buf + 252, 12);
    store32(buf + 256, 3);
    store32(buf + 260, (4 << 16) | 43);  # OpConstant %3 %10 3
    store32(buf + 264, 3);
    store32(buf + 268, 10);
    store32(buf + 272, 3);
    store32(buf + 276, (4 << 16) | 43);  # OpConstant %3 %11 7
    store32(buf + 280, 3);
    store32(buf + 284, 11);
    store32(buf + 288, 7);
    store32(buf + 292, (4 << 16) | 43);  # OpConstant %3 %12 0
    store32(buf + 296, 3);
    store32(buf + 300, 12);
    store32(buf + 304, 0);
    store32(buf + 308, (4 << 16) | 59);  # OpVariable %5 %13 Input
    store32(buf + 312, 5);
    store32(buf + 316, 13);
    store32(buf + 320, 1);
    store32(buf + 324, (4 << 16) | 59);  # OpVariable %8 %14 StorageBuffer
    store32(buf + 328, 8);
    store32(buf + 332, 14);
    store32(buf + 336, 12);
    store32(buf + 340, (5 << 16) | 54);  # OpFunction %1 %15 None %2
    store32(buf + 344, 1);
    store32(buf + 348, 15);
    store32(buf + 352, 0);
    store32(buf + 356, 2);
    store32(buf + 360, (2 << 16) | 248); # OpLabel %16
    store32(buf + 364, 16);
    store32(buf + 368, (4 << 16) | 61);  # OpLoad %4 %17 %13
    store32(buf + 372, 4);
    store32(buf + 376, 17);
    store32(buf + 380, 13);
    store32(buf + 384, (5 << 16) | 81);  # OpCompositeExtract %3 %18 %17 0
    store32(buf + 388, 3);
    store32(buf + 392, 18);
    store32(buf + 396, 17);
    store32(buf + 400, 0);
    store32(buf + 404, (5 << 16) | 132); # OpIMul %3 %19 %18 %10
    store32(buf + 408, 3);
    store32(buf + 412, 19);
    store32(buf + 416, 18);
    store32(buf + 420, 10);
    store32(buf + 424, (5 << 16) | 128); # OpIAdd %3 %20 %19 %11
    store32(buf + 428, 3);
    store32(buf + 432, 20);
    store32(buf + 436, 19);
    store32(buf + 440, 11);
    store32(buf + 444, (6 << 16) | 65);  # OpAccessChain %9 %21 %14 %12 %18
    store32(buf + 448, 9);
    store32(buf + 452, 21);
    store32(buf + 456, 14);
    store32(buf + 460, 12);
    store32(buf + 464, 18);
    store32(buf + 468, (3 << 16) | 62);  # OpStore %21 %20
    store32(buf + 472, 21);
    store32(buf + 476, 20);
    store32(buf + 480, (1 << 16) | 253); # OpReturn
    store32(buf + 484, (1 << 16) | 56);  # OpFunctionEnd
    return 488;
}

fn main(): i64 {
    alloc_init();
    print_cstr("mabda native SPIR-V compute e2e (N.5d) — compiled kernel on Cezanne\n");
    print_cstr("------------------------------------------------------------------\n");

    var spv[512];
    var n = build_idx_kernel(&spv);

    # ---- Compile SPIR-V -> GFX9 ISA + RSRC descriptor ----
    var types[640];
    var consts[448];
    var deco[448];
    var outbi[256];
    var m[80];
    var vals[1440];
    var instrs[1024];
    var ptrs[256];
    var blocks[32];
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 32, 8, 22, 36);
    var isel[768];
    var isel2[768];
    var alloc[576];
    var hw[16];
    var abi[64];
    var cc[88];
    store64(&cc + CC_TYPES, &types);
    store64(&cc + CC_CONSTS, &consts);
    store64(&cc + CC_DECO, &deco);
    store64(&cc + CC_M, &m);
    store64(&cc + CC_OUTBI, &outbi);
    store64(&cc + CC_ISEL, &isel);
    store64(&cc + CC_ISEL2, &isel2);
    store64(&cc + CC_ALLOC, &alloc);
    store64(&cc + CC_HW, &hw);
    store64(&cc + CC_ABI, &abi);
    store64(&cc + CC_CAP_IDS, 26);  # types[640]/24 = 26 records (the min table cap)
    var isa[512];
    memset(&isa, 0, 512);
    var desc[64];
    var crc = gfx9_compile(&cc, &spv, n, &isa, &desc);
    if (crc != 0) {
        print_cstr("FAIL: gfx9_compile rc="); print_i64(crc); print_cstr("\n");
        return 2;
    }
    var isa_len = load64(&desc + DESC_ISA_LEN);
    var rsrc1 = load64(&desc + DESC_RSRC1);
    print_cstr("compiled: isa_len="); print_i64(isa_len);
    print_cstr(" rsrc1=0x"); print_hex32(rsrc1);
    print_cstr(" user_sgpr="); print_i64(load64(&desc + DESC_USER_SGPR));
    print_cstr(" bindings="); print_i64(load64(&desc + DESC_NUM_BINDINGS));
    print_cstr("\n");

    # ---- Context + BOs ----
    var ctx_res = gpu_context_new_native();
    if (is_err_result(ctx_res) == 1) { print_cstr("FAIL: ctx\n"); return 3; }
    var ctx = payload(ctx_res);
    var fd = native_ctx_fd(ctx);
    var stub_va = native_ctx_stub_va(ctx);

    var shader_size = 4096;
    var shader_bo[16];
    if (native_bo_create_gtt(fd, shader_size, &shader_bo) != 0) { return 4; }
    var shader_handle = load64(&shader_bo + 0);
    var shader_map = load64(&shader_bo + 8);
    memset(shader_map, 0, shader_size);
    # copy the compiled ISA word-by-word into the shader BO
    var w = 0;
    while (w < isa_len) {
        store32(shader_map + w, load32(&isa + w));
        w = w + 4;
    }
    var shader_va = 0xFFFF800100000000;
    if (native_gem_va_map(fd, shader_handle, shader_va, shader_size, _NATIVE_PERM_SHADER) != 0) { return 4; }

    var out_size = 4096;
    var out_bo[16];
    if (native_bo_create_gtt(fd, out_size, &out_bo) != 0) { return 5; }
    var out_handle = load64(&out_bo + 0);
    var out_map = load64(&out_bo + 8);
    var si = 0;
    while (si < out_size / 4) { store32(out_map + si * 4, 0xBAADF00D); si = si + 1; }
    var out_va = 0xFFFF800100400000;
    if (native_gem_va_map(fd, out_handle, out_va, out_size, _NATIVE_PERM_DATA) != 0) { return 5; }

    # ---- Dispatch: 1 workgroup of 8 threads, compiler RSRC1 + the proven
    # deadbeef dispatch RSRC2 (0x8 = USER_SGPR=4, scratch stub in s2:s3). The
    # kernel reads only binding-0 (s0:s1 = out VA) and is all-VGPR. ----
    var pm4 = native_ctx_pm4_scratch(ctx);
    if (pm4 == 0) { return 6; }
    memset(pm4, 0, 256);
    var pm4_bytes = native_pm4_build_compute_generic(pm4, shader_va, stub_va,
      rsrc1, 0x8, out_va, 8, 1);

    var t_now[16];
    memset(&t_now, 0, 16);
    if (syscall(228, 1, &t_now) != 0) { return 7; }
    var deadline = load64(&t_now + 0) * 1000000000 + load64(&t_now + 8) + 15000000000;
    var rc = native_compute_dispatch_cached(ctx, pm4, pm4_bytes,
      shader_handle, out_handle, deadline);
    if (rc != 0) { print_cstr("FAIL: dispatch rc="); print_i64(rc); print_cstr("\n"); return 9; }

    var marker = load32(native_ctx_stub_addr(ctx) + 4);
    print_cstr("post-dispatch marker = "); print_hex32(marker);
    if (marker == 0xC0FFEE12) { print_cstr(" OK\n"); }
    if (marker != 0xC0FFEE12) { print_cstr(" STALE\n"); }

    # ---- Verify all 8 lanes: out[i] == i*3 + 7 ----
    var ok = 1;
    var i = 0;
    while (i < 8) {
        var got = load32(out_map + i * 4);
        var want = i * 3 + 7;
        print_cstr("out["); print_i64(i); print_cstr("] = "); print_i64(got);
        print_cstr(" (want "); print_i64(want); print_cstr(")");
        if (got != want) { print_cstr("  MISMATCH"); ok = 0; }
        print_cstr("\n");
        i = i + 1;
    }

    native_gem_va_unmap(fd, out_handle, out_va, out_size);
    native_bo_release_gtt(fd, out_handle, out_map, out_size);
    native_gem_va_unmap(fd, shader_handle, shader_va, shader_size);
    native_bo_release_gtt(fd, shader_handle, shader_map, shader_size);
    gpu_context_release(ctx);

    if (ok == 0) { print_cstr("FAIL: readback mismatch\n"); return 11; }
    print_cstr("OK — compiled SPIR-V kernel ran correctly on Cezanne\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
