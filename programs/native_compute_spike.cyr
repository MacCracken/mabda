# programs/native_compute_spike.cyr — v3 Phase B.3.d hardware integration
#
# First live AMDGPU compute dispatch from pure Cyrius. Uploads a
# minimum GFX9 shader (s_endpgm), builds a PM4 command stream with
# our packet builder, submits via DRM_IOCTL_AMDGPU_CS, waits for
# completion via a DRM sync object, and exits 0 if the dispatch
# returned without kernel error.
#
# The shader does nothing (s_endpgm is a single-instruction no-op
# that just terminates the wave). This program therefore cannot
# verify any output data — that's Phase B.4. What it DOES verify:
#   - every ioctl returns 0
#   - the sync-obj becomes signaled within 5 seconds
#   - the kernel neither rejects the submission nor kernel-hangs the GPU
#
# Exit codes:
#   0  — dispatch completed (sync-obj signaled)
#   1  — open fd failed
#   2  — shader BO setup failed
#   3  — IB BO setup failed
#   4  — context alloc failed
#   5  — BO list create failed
#   6  — syncobj create failed
#   7  — CS ioctl failed
#   8  — syncobj wait failed (including timeout)

include "src/lib.cyr"

fn print_cstr(s) { syscall(1, 1, s, strlen(s)); return 0; }
fn print_i64(n) {
    var buf[32];
    memset(&buf, 0, 32);
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}

# Return the current CLOCK_MONOTONIC time in nanoseconds. syscall 228
# = clock_gettime; id 1 = CLOCK_MONOTONIC.
fn mono_ns() {
    var ts[16];
    syscall(228, 1, &ts);
    var sec = load64(&ts + 0);
    var nsec = load64(&ts + 8);
    return sec * 1000000000 + nsec;
}

fn main() {
    alloc_init();

    print_cstr("mabda native compute spike (v3 Phase B.3.d)\n");
    print_cstr("-------------------------------------------\n");

    var fd = native_open_render_node();
    if (fd < 0) { print_cstr("FAIL: open\n"); return 1; }
    print_cstr("fd="); print_i64(fd); print_cstr("\n");

    # ---- Shader BO: 4 KiB GTT, s_endpgm at offset 0, VA @ 0x200000 ----
    var shader_size = 4096;
    var shader_bo[16];
    var rc = native_bo_create_gtt(fd, shader_size, &shader_bo);
    if (rc != 0) {
        print_cstr("FAIL: shader bo create errno="); print_i64(0 - rc); print_cstr("\n");
        sys_close(fd); return 2;
    }
    var shader_handle = load64(&shader_bo + 0);
    var shader_map = load64(&shader_bo + 8);
    memset(shader_map, 0, shader_size);
    native_gfx9_shader_endpgm(shader_map, 0);
    # GFX9 shader VA lives in the canonical-high-VA "shader aperture"
    # starting at 0xFFFF_8001_0000_0000 (verified via Mesa strace).
    # PGM_HI=0x80 implies bits 47:40 of VA; bits 39:32 are an implicit
    # 0x01 in this aperture.
    var shader_va = 0xFFFF800100000000;
    rc = native_gem_va_map(fd, shader_handle, shader_va, shader_size,
                           AMDGPU_VM_PAGE_READABLE | AMDGPU_VM_PAGE_EXECUTABLE);
    if (rc != 0) {
        print_cstr("FAIL: shader va_map errno="); print_i64(0 - rc); print_cstr("\n");
        native_bo_release_gtt(fd, shader_handle, shader_map, shader_size);
        sys_close(fd); return 2;
    }
    print_cstr("shader bo=") ; print_i64(shader_handle);
    print_cstr(" va=0x"); print_i64(shader_va); print_cstr("\n");

    # ---- Stub data BO at VA 0x200000 ----
    # Per gpu-coredump analysis (docs/issues/2026-04-21-gfx9-store-blocker.md
    # Session 5): the HW dereferences s[0:3] as a scratch V# during
    # dispatch setup. With zero-valued USER_DATA → zero V# base → VA 0
    # fault. Mesa satisfies this by pointing USER_DATA_0 at a valid low
    # VA (0x00200040) and USER_DATA_2 at 0x00200000. We map a 4 KiB
    # stub BO at 0x200000 so those references resolve to valid memory.
    var stub_size = 4096;
    var stub_bo[16];
    rc = native_bo_create_gtt(fd, stub_size, &stub_bo);
    if (rc != 0) {
        print_cstr("FAIL: stub bo create errno="); print_i64(0 - rc); print_cstr("\n");
        native_gem_va_unmap(fd, shader_handle, shader_va, shader_size);
        native_bo_release_gtt(fd, shader_handle, shader_map, shader_size);
        sys_close(fd); return 2;
    }
    var stub_handle = load64(&stub_bo + 0);
    var stub_map    = load64(&stub_bo + 8);
    memset(stub_map, 0, stub_size);
    var stub_va = 0x200000;
    rc = native_gem_va_map(fd, stub_handle, stub_va, stub_size,
                           AMDGPU_VM_PAGE_READABLE | AMDGPU_VM_PAGE_WRITEABLE);
    if (rc != 0) {
        print_cstr("FAIL: stub va_map errno="); print_i64(0 - rc); print_cstr("\n");
        native_bo_release_gtt(fd, stub_handle, stub_map, stub_size);
        native_gem_va_unmap(fd, shader_handle, shader_va, shader_size);
        native_bo_release_gtt(fd, shader_handle, shader_map, shader_size);
        sys_close(fd); return 2;
    }
    print_cstr("stub bo="); print_i64(stub_handle);
    print_cstr(" va=0x"); print_i64(stub_va); print_cstr("\n");

    # ---- Build PM4 stream in a heap buffer ----
    #
    # Byte-for-byte rebuild of Mesa rusticl's compute preamble +
    # dispatch, verified via AMD_DEBUG=ib on gfx90c. Prior versions
    # of this spike had two PM4-builder bugs (ACQUIRE_MEM count
    # off-by-one; DISPATCH_DIRECT missing shader_type=2) that caused
    # CP stream desync and full GPU resets. Both are fixed in
    # backend_native.cyr now.
    #
    # Mesa's order (from the AMD_DEBUG dump):
    #   1. COMPUTE_PGM_HI
    #   2. STATIC_THREAD_MGMT_SE0 + SE1
    #   3. STATIC_THREAD_MGMT_SE2 + SE3
    #   4. CP_COHER_START_DELAY
    #   5. TA_CS_BC_BASE_ADDR + _HI
    #   6. COMPUTE_PGM_LO
    #   7. COMPUTE_PGM_RSRC1 + RSRC2
    #   8. COMPUTE_TMPRING_SIZE
    #   9. COMPUTE_USER_DATA_2 + 3
    #   10. COMPUTE_USER_DATA_0
    #   11. ACQUIRE_MEM
    #   12. COMPUTE_RESOURCE_LIMITS
    #   13. COMPUTE_NUM_THREAD_X + Y + Z
    #   14. DISPATCH_DIRECT
    var pm4 = alloc(256);
    memset(pm4, 0, 256);
    var pos = 0;
    # GFX9 encoding (Mesa-verified): PGM_LO = VA[31:0], PGM_HI = VA[47:40].
    # Bits 39:32 are an implicit 0x01 via the GFX9 shader aperture — not
    # encoded in PGM_LO/HI. For VA 0xFFFF_8001_0000_0000: PGM_LO=0, PGM_HI=0x80.
    var pgm_lo = shader_va & 0xFFFFFFFF;
    var pgm_hi = (shader_va / 0x10000000000) & 0xFF;
    # 1. PGM_HI (early — before preamble in Mesa's dump).
    pos = native_pm4_set_sh_reg_one(pm4, pos, R_COMPUTE_PGM_HI, pgm_hi);
    # 2. STATIC_THREAD_MGMT_SE0/SE1 — Mesa sets SE0 = 0xFFFFFFFF to
    # enable all CUs in SE0 (Cezanne has 1 SE), SE1 = 0 (absent).
    var thread_mgmt_01[8];
    store32(&thread_mgmt_01 + 0, 0xFFFFFFFF);
    store32(&thread_mgmt_01 + 4, 0);
    pos = native_pm4_set_sh_reg(pm4, pos, R_COMPUTE_STATIC_THREAD_MGMT_SE0, 2, &thread_mgmt_01);
    # 3. STATIC_THREAD_MGMT_SE2/SE3 = 0, 0 (absent on Cezanne).
    var thread_mgmt_23[8];
    store32(&thread_mgmt_23 + 0, 0);
    store32(&thread_mgmt_23 + 4, 0);
    pos = native_pm4_set_sh_reg(pm4, pos, R_COMPUTE_STATIC_THREAD_MGMT_SE2, 2, &thread_mgmt_23);
    # 4. CP_COHER_START_DELAY = 0.
    pos = native_pm4_set_uconfig_reg_one(pm4, pos, R_CP_COHER_START_DELAY, 0);
    # 5. TA_CS_BC_BASE_ADDR + _HI — border-color base pointer. Mesa
    # points this at its preamble scratch area; any valid shader-space
    # VA is fine since SCRATCH_EN=0 means the HW never reads it.
    var bc_va = shader_va;
    var bc_pair[8];
    store32(&bc_pair + 0, (bc_va / 256) & 0xFFFFFFFF);
    store32(&bc_pair + 4, (bc_va / 0x10000000000) & 0xFF);
    pos = native_pm4_set_uconfig_reg_pair(pm4, pos, R_TA_CS_BC_BASE_ADDR, &bc_pair);
    # 6. PGM_LO.
    pos = native_pm4_set_sh_reg_one(pm4, pos, R_COMPUTE_PGM_LO, pgm_lo);
    # 7. PGM_RSRC1 + RSRC2 as a pair.
    var rsrc[8];
    store32(&rsrc + 0, GFX9_COMPUTE_PGM_RSRC1_MIN);
    # RSRC2 = 0x8: USER_SGPR=4. HW loads s0..s3 from USER_DATA_0..3.
    store32(&rsrc + 4, 0x8);
    pos = native_pm4_set_sh_reg(pm4, pos, R_COMPUTE_PGM_RSRC1, 2, &rsrc);
    # 8. TMPRING_SIZE. Mesa writes 0x100 (WAVES=256) even for kernels
    # that don't use scratch. Zero-default may leave scratch ring
    # state uninitialized and trigger a fault during wave launch.
    pos = native_pm4_set_sh_reg_one(pm4, pos, R_COMPUTE_TMPRING_SIZE, 0x100);
    # 9. USER_DATA_2 + 3 — upper half of the scratch buffer V#.
    var user23[8];
    store32(&user23 + 0, 0x00200000);
    store32(&user23 + 4, 0);
    pos = native_pm4_set_sh_reg(pm4, pos, R_COMPUTE_USER_DATA_0 + 8, 2, &user23);
    # 10. USER_DATA_0 — low half of the scratch V# (base+size).
    pos = native_pm4_set_sh_reg_one(pm4, pos, R_COMPUTE_USER_DATA_0 + 0, 0x00200040);
    # 11. ACQUIRE_MEM flushes I/K/L2 caches before dispatch. Mandatory
    # on GFX9; without it the SQ can decode stale bytes as invalid ops.
    pos = native_pm4_acquire_mem_full_invalidate(pm4, pos);
    # 12. RESOURCE_LIMITS = 0x140 (WAVES_PER_SH=320). Zero does NOT
    # mean "unlimited" on GFX9 — it caps to zero waves and causes a
    # silent stall / eventual TDR.
    pos = native_pm4_set_sh_reg_one(pm4, pos, R_COMPUTE_RESOURCE_LIMITS, 0x140);
    # 13. NUM_THREAD_X/Y/Z as a 3-reg block.
    var nt[12];
    store32(&nt + 0, 1);
    store32(&nt + 4, 1);
    store32(&nt + 8, 1);
    pos = native_pm4_set_sh_reg(pm4, pos, R_COMPUTE_NUM_THREAD_X, 3, &nt);
    # 14. DISPATCH_DIRECT. Header now carries shader_type=2.
    pos = native_pm4_dispatch_direct(pm4, pos, 1, 1, 1, GFX9_DISPATCH_INITIATOR);
    # AMDGPU requires IBs padded to a cache-line boundary. Pad to 64
    # dwords with a single NOP packet.
    var cur_dwords = pos / 4;
    var target_dwords = 64;
    if (cur_dwords < target_dwords) {
        pos = native_pm4_nop(pm4, pos, target_dwords - cur_dwords);
    }
    var pm4_bytes = pos;
    print_cstr("pm4 stream bytes="); print_i64(pm4_bytes); print_cstr("\n");

    # ---- IB BO: 4 KiB GTT, PM4 stream at offset 0, VA @ 0x400000 ----
    var ib_size = 4096;
    var ib_bo[16];
    rc = native_bo_create_gtt(fd, ib_size, &ib_bo);
    if (rc != 0) {
        print_cstr("FAIL: ib bo create errno="); print_i64(0 - rc); print_cstr("\n");
        native_gem_va_unmap(fd, shader_handle, shader_va, shader_size);
        native_bo_release_gtt(fd, shader_handle, shader_map, shader_size);
        sys_close(fd); return 3;
    }
    var ib_handle = load64(&ib_bo + 0);
    var ib_map = load64(&ib_bo + 8);
    memset(ib_map, 0, ib_size);
    memcpy(ib_map, pm4, pm4_bytes);
    # IB in the same canonical-high aperture as the shader (Mesa pattern).
    var ib_va = 0xFFFF800100200000;
    rc = native_gem_va_map(fd, ib_handle, ib_va, ib_size,
                           AMDGPU_VM_PAGE_READABLE);
    if (rc != 0) {
        print_cstr("FAIL: ib va_map errno="); print_i64(0 - rc); print_cstr("\n");
        native_bo_release_gtt(fd, ib_handle, ib_map, ib_size);
        native_gem_va_unmap(fd, shader_handle, shader_va, shader_size);
        native_bo_release_gtt(fd, shader_handle, shader_map, shader_size);
        sys_close(fd); return 3;
    }
    print_cstr("ib bo="); print_i64(ib_handle);
    print_cstr(" va=0x"); print_i64(ib_va); print_cstr("\n");

    # ---- Context ----
    var req_ctx[16];
    rc = native_ctx_alloc(fd, &req_ctx);
    if (rc != 0) {
        print_cstr("FAIL: ctx_alloc errno="); print_i64(0 - rc); print_cstr("\n");
        return 4;
    }
    var ctx_id = native_ctx_alloc_id(&req_ctx);
    print_cstr("ctx_id="); print_i64(ctx_id); print_cstr("\n");

    # ---- BO list: shader + IB + stub ----
    var entries[24];
    store32(&entries +  0, shader_handle); store32(&entries +  4, 0);
    store32(&entries +  8, ib_handle);     store32(&entries + 12, 0);
    store32(&entries + 16, stub_handle);   store32(&entries + 20, 0);
    var req_list[24];
    rc = native_bo_list_create(fd, &entries, 3, &req_list);
    if (rc != 0) {
        print_cstr("FAIL: bo_list_create errno="); print_i64(0 - rc); print_cstr("\n");
        return 5;
    }
    var list_handle = native_bo_list_create_handle(&req_list);
    print_cstr("bo_list_handle="); print_i64(list_handle); print_cstr("\n");

    # ---- Sync-obj ----
    var syncobj_handle_ptr = alloc(8);
    rc = native_syncobj_create(fd, syncobj_handle_ptr);
    if (rc != 0) {
        print_cstr("FAIL: syncobj_create errno="); print_i64(0 - rc); print_cstr("\n");
        return 6;
    }
    var syncobj_handle = load64(syncobj_handle_ptr);
    print_cstr("syncobj="); print_i64(syncobj_handle); print_cstr("\n");

    # ---- Submit CS with IB + SYNCOBJ_OUT ----
    # Try COMPUTE ring first (the "right" ring for compute dispatches).
    # If COMPUTE is unavailable on this platform, fall back to GFX.
    rc = native_cs_submit(fd, ctx_id, list_handle, ib_va, pm4_bytes,
                          AMDGPU_HW_IP_COMPUTE, syncobj_handle);
    if (rc == 0) {
        print_cstr("submitted to COMPUTE ring\n");
    }
    if (rc != 0) {
        print_cstr("COMPUTE ring errno="); print_i64(0 - rc);
        print_cstr(", retrying on GFX ring\n");
        rc = native_cs_submit(fd, ctx_id, list_handle, ib_va, pm4_bytes,
                              AMDGPU_HW_IP_GFX, syncobj_handle);
        if (rc == 0) { print_cstr("submitted to GFX ring\n"); }
    }
    if (rc != 0) {
        print_cstr("FAIL: cs submit errno="); print_i64(0 - rc); print_cstr("\n");
        return 7;
    }
    print_cstr("cs submitted\n");

    # ---- Wait for completion, 15-second timeout ----
    # AMDGPU's default TDR is 10s — 15s gives enough headroom to see
    # a GPU reset fence (which would signal the syncobj with an error
    # rather than leaving us in ETIME land).
    var deadline = mono_ns() + 15000000000;
    rc = native_syncobj_wait(fd, syncobj_handle, deadline);
    if (rc != 0) {
        print_cstr("FAIL: syncobj_wait errno="); print_i64(0 - rc); print_cstr("\n");
        return 8;
    }
    print_cstr("dispatch completed (sync-obj signaled)\n");

    # ---- Teardown ----
    native_syncobj_destroy(fd, syncobj_handle);
    native_bo_list_destroy(fd, list_handle);
    native_ctx_free(fd, ctx_id);
    native_gem_va_unmap(fd, ib_handle, ib_va, ib_size);
    native_bo_release_gtt(fd, ib_handle, ib_map, ib_size);
    native_gem_va_unmap(fd, shader_handle, shader_va, shader_size);
    native_bo_release_gtt(fd, shader_handle, shader_map, shader_size);
    sys_close(fd);
    print_cstr("OK\n");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
