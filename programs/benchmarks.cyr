# ================================================================
# 9. depth_texture_1080p — Rust baseline 2.23 µs
# ================================================================
fn _op_depth_1080p(): i64 {
    return depth_texture_new_default(_bw_device, 1920, 1080);
}

fn _rel_depth(dt): i64 {
    wgpu_texture_view_release(depth_texture_view(dt));
    wgpu_texture_release(depth_texture_handle(dt));
    return 0;
}

fn bench_depth_texture_1080p(device): i64 {
    _bw_device = device;
    _bench_row("depth_texture_1080p", &_op_depth_1080p, &_rel_depth, 0, 200, 1);
    return 0;
}

# ================================================================
# 10. render_target_1080p — Rust baseline 3.84 µs
# ================================================================
# rtb_build only READS its builder, so one prebuilt builder serves every op (the old loop
# allocated a fresh builder per iteration outside the timer — same op, no per-iteration alloc).
fn _op_render_target(): i64 {
    return rtb_build(_bw_a, _bw_device);
}

# Both render-target rows release through render_target_release (untimed, after the window): it
# frees every handle rtb_build made, MSAA texture included (tests/tcyr/render.tcyr drives it).
fn bench_render_target_1080p(device): i64 {
    _bw_device = device;
    _bw_a = rtb_new(1920, 1080);
    _bench_row("render_target_1080p", &_op_render_target, &render_target_release, 0, 200, 1);
    return 0;
}

# ================================================================
# 11. render_target_msaa4_1080p — Rust baseline 16.32 µs
# ================================================================
# Until 4.1.3 this row's release freed only the views and the 1-sample texture: RenderTarget kept
# no MSAA texture handle, so each op leaked one ~31.6 MiB 4x texture (~102 per run, ~3.2 GiB).
# The handle now lives at RenderTarget +64 and render_target_release frees it.
fn bench_render_target_msaa4_1080p(device): i64 {
    _bw_device = device;
    _bw_a = rtb_msaa(rtb_new(1920, 1080), 4);
    _bench_row("render_target_msaa4_1080p", &_op_render_target, &render_target_release,
      0, 100, 1);
    return 0;
}

# ================================================================
# 12. render_pipeline_build — Rust baseline 97.68 µs
# ================================================================
fn _trivial_shader(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "@vertex fn vs_main(@builtin(vertex_index) i: u32) ");
    str_builder_add_cstr(sb, "-> @builtin(position) vec4<f32> { return vec4(f32(i), 0.0, 0.0, 1.0); } ");
    str_builder_add_cstr(sb, "@fragment fn fs_main() -> @location(0) vec4<f32> { return vec4(1.0); }");
    return str_cstr(str_builder_build(sb));
}

fn _op_render_pipeline(): i64 {
    return render_pipeline_create_simple(_bw_device, _bw_a, WGPU_TEXTURE_FORMAT_RGBA8_UNORM);
}

fn bench_render_pipeline_build(device): i64 {
    var wgsl = _trivial_shader();
    var src = wgpu_shader_source_wgsl(wgsl);
    var sm_desc = wgpu_shader_module_descriptor("bench_shader", src);
    var shader = wgpu_device_create_shader_module(device, sm_desc);
    if (shader == 0) { return _setup_fail("render_pipeline_build", "the shader module"); }
    _bw_device = device;
    _bw_a = shader;
    _bench_row("render_pipeline_build", &_op_render_pipeline, &render_pipeline_release, 0, 50, 1);
    wgpu_shader_module_release(shader);
    return 0;
}

# ================================================================
# 13. compute_dispatch_1024 — Rust baseline 31.50 µs
# Dispatch only — buffer + pipeline + bind group are prebuilt.
# 1024 u32 elements, @workgroup_size(64), x=16 workgroups.
# ================================================================
fn _doubler_shader(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "@group(0) @binding(0) var<storage, read_write> data: array<u32>; ");
    str_builder_add_cstr(sb, "@compute @workgroup_size(64) fn main(@builtin(global_invocation_id) g: vec3<u32>) { ");
    str_builder_add_cstr(sb, "data[g.x] = data[g.x] * 2u; }");
    return str_cstr(str_builder_build(sb));
}

fn _op_compute_dispatch(): i64 {
    compute_dispatch(_bw_device, _bw_queue, _bw_a, _bw_b, _bw_c);
    return 0;
}

fn bench_compute_dispatch_1024(device, queue): i64 {
    var wgsl = _doubler_shader();
    var cp = compute_pipeline_new(device, wgsl, "main", 1);
    if (cp == 0) { return _setup_fail("compute_dispatch_1024", "the compute pipeline"); }

    # 1024 × u32 storage buffer
    var SIZE = 4096;
    var data = alloc(SIZE);
    memset(data, 0, SIZE);
    var storage_usage = WGPU_BUFFER_USAGE_STORAGE
    | WGPU_BUFFER_USAGE_COPY_DST
    | WGPU_BUFFER_USAGE_COPY_SRC;
    var storage_desc = wgpu_buffer_descriptor("bench-storage", storage_usage, SIZE, 0);
    var sbuf = wgpu_device_create_buffer(device, storage_desc);
    if (sbuf == 0) { return _setup_fail("compute_dispatch_1024", "the storage buffer"); }
    wgpu_queue_write_buffer(queue, sbuf, 0, data, SIZE);

    var bge = alloc(56);
    wgpu_bind_group_entry_buffer(bge, 0, sbuf, 0, SIZE);
    var bg_desc = wgpu_bind_group_descriptor("bench-bg", compute_pipeline_bgl(cp), bge, 1);
    var bg = wgpu_device_create_bind_group(device, bg_desc);
    if (bg == 0) { return _setup_fail("compute_dispatch_1024", "the bind group"); }

    # Dispatch: 16 workgroups × 64 lanes = 1024 elements
    var dims = alloc(12);
    store32(dims, 16);
    store32(dims + 4, 1);
    store32(dims + 8, 1);

    _bw_device = device;
    _bw_queue = queue;
    _bw_a = cp;
    _bw_b = bg;
    _bw_c = dims;
    _bench_row("compute_dispatch_1024", &_op_compute_dispatch, 0, 0, 100, 1);
    wgpu_bind_group_release(bg);
    wgpu_buffer_release(sbuf);
    compute_pipeline_release(cp);
    return 0;
}

fn mabda_main(fn_table_ptr, preinit_ptr): i64 {
    color_init();
    wgpu_ffi_init_table(fn_table_ptr);
    _gpu_preinit = preinit_ptr;

    var res_tag, res = gpu_context_from_preinit(_gpu_preinit);
    if (is_err_result(res_tag) == 1) {
        _err("SKIP: no GPU available\n");
        return 0;
    }
    _gpu_ctx = res;
    var device = gpu_ctx_device(_gpu_ctx);
    var queue = gpu_ctx_queue(_gpu_ctx);

    _out("=== mabda GPU benchmarks ===\n");
    _bench_clock_warm();

    bench_create_storage_buffer_4k(device, queue);
    bench_create_uniform_buffer_64(device, queue);
    bench_uniform_buffer_write(device, queue);
    bench_shader_cache_hit(device);
    bench_shader_cache_miss(device);
    bench_bind_group_cache_hit();
    bench_texture_1x1_solid(device, queue);
    bench_texture_256x256_rgba(device, queue);
    bench_depth_texture_1080p(device);
    bench_render_target_1080p(device);
    bench_render_target_msaa4_1080p(device);
    bench_render_pipeline_build(device);
    bench_compute_dispatch_1024(device, queue);

    if (_bench_invalid != 0) {
        _err("FAIL: invalid benchmark row(s): see the FAIL: lines on stdout (exit-status notes in the header)\n");
        return 1;
    }
    return 0;
}
