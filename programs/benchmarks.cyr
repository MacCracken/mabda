# programs/benchmarks.cyr — GPU-backed benchmark parity with Rust v1.0
#
# Ports the 13 Rust-v1 GPU benchmarks (benches/benchmarks.rs, commit
# f113c93) into a single Cyrius program that drives a real wgpu-native
# device. Pairs with the 7 CPU-only benchmarks in tests/bcyr/mabda.bcyr.
#
# Each benchmark records a min-per-op time across its timed windows (fairest
# comparison to Criterion's `estimate`). Output is human-readable to
# stdout plus one `CSV:name,ns` line per benchmark that scripts can grep
# into bench-history.csv (matches the schema of
# docs/rust-v1-bench-history.csv).
#
# Exit status: 0 when all 13 rows ran and are valid. 1 when ANY row is invalid:
#   - it measured 0 ns (the timed window held no measurable work),
#   - its op ran out of prebuilt inputs (shader_cache_miss),
#   - its untimed queue flush could not create an encoder (uniform_buffer_write), or
#   - its setup handle came back 0, so it never ran (a `FAIL:` line stands in for its CSV line).
# A measured-but-invalid row still prints its CSV line, then a `FAIL:` line on stdout; the run
# ends with a FAIL summary on stderr. With no GPU it prints `SKIP: no GPU available` to stderr
# and exits 0.
#
# Reference numbers (Rust v1.0, RADV RENOIR equivalent):
#   create_storage_buffer_4k       4.02 µs
#   create_uniform_buffer_64       2.81 µs
#   uniform_buffer_write         929.87 ns
#   shader_cache_hit              36.52 ns
#   shader_cache_miss              3.65 µs
#   bind_group_cache_hit          13.20 ns
#   texture_1x1_solid              6.92 µs
#   texture_256x256_rgba           1.06 ms
#   depth_texture_1080p            2.23 µs
#   render_target_1080p            3.84 µs
#   render_target_msaa4_1080p     16.32 µs
#   render_pipeline_build         97.68 µs
#   compute_dispatch_1024         31.50 µs

# Full library via src/lib.cyr (canonical chain; the former selective
# include list rotted as native deps grew — v3.2 T.8).
include "src/lib.cyr"
include "lib/bench.cyr"

var _gpu_preinit = 0;
var _gpu_ctx = 0;

# ================================================================
# Output — every byte count from strlen, never a hand-counted literal
# ================================================================
fn _out(s): i64 {
    syscall(1, 1, s, strlen(s));
    return 0;
}
fn _err(s): i64 {
    syscall(1, 2, s, strlen(s));
    return 0;
}

# CSV-friendly report — one line per benchmark, easy to grep
fn _csv_row(name, ns): i64 {
    _out("CSV:");
    _out(name);
    _out(",");
    fmt_int(ns);
    _out("\n");
    return 0;
}

# Rows whose measurement is not a measurement (see the exit-status notes in the header).
var _bench_invalid = 0;

# A row whose setup failed never runs: count it invalid and say so where its CSV line would be.
fn _setup_fail(row, what): i64 {
    _bench_invalid = _bench_invalid + 1;
    _out("  FAIL: ");
    _out(row);
    _out(" not run: ");
    _out(what);
    _out(" came back 0\n");
    return 0;
}

# The report line, then the row's clock error bound, then the CSV row. The bound line has no
# ": ... avg", so bench-history-style `*": "*" avg"*` matchers skip it. `jit` (see
# _clock_jitter_ns) is how far a single window can under-read; with k ops per window the
# recorded per-op min can under-read by at most jit / k.
fn _report(b, k, jit): i64 {
    bench_report(b);
    var mn = bench_min_ns(b);
    var bound = jit / k;
    _out("  [");
    fmt_int(k);
    _out(" op(s) per timed window; clock jitter ");
    fmt_int(jit);
    _out(" ns -> per-op min may under-read by <= ");
    fmt_int(bound);
    _out(" ns");
    if (mn > 0) {
        _out(" (");
        fmt_int((bound * 100) / mn);
        _out(" % of min)");
    }
    _out("]\n");
    _csv_row(load64(b), mn);
    if (mn <= 0) {
        _bench_invalid = _bench_invalid + 1;
        _out("  FAIL: ");
        _out(load64(b));
        _out(" measured 0 ns: the timed window held no measurable work\n");
    }
    return 0;
}

# ================================================================
# Timed windows sized from the MEASURED clock (4.1.3 verification)
# ================================================================
# uniform_buffer_write reported min=0 ns on the Cezanne box. bench_batch_stop subtracts
# bench_clock_overhead_ns() — the calibrated MEAN cost of one clock read — from every window,
# which is right for a mean. A row's recorded number, though, is the MIN over windows, and a
# single window's clock cost can sit far below that mean, so min(op + clock) - floor is biased
# low by (floor - fastest window) and clamps to 0 once the op is smaller than that gap. Two
# measured ways to get a large gap (CPU-only probes, no GPU):
#   - hpet clocksource (Cezanne): floor 1.21 us, empty windows as fast as 489 ns (~45 % under the
#     floor). A ~270 ns getpid timed one-op-per-window read min=0; with 128 ops per window, 269 ns.
#   - an inflated calibration (chew, tsc): a process that calibrates on a cold CPU got a 3.86 us
#     floor while its subsequent empty windows ran 727 ns — every sub-3 us single-op window clamped.
#     On a warm tsc run the gap is ~6 ns and single-op windows are exact (getpid 712 ns single,
#     713 ns batched).
# So measure the gap itself, per row, right before the row: jitter = floor - the fastest of 16384
# EMPTY windows, and print the resulting bound on every row. mabda_main also warms the CPU
# before the floor is first calibrated.
#
# uniform_buffer_write (the row that read 0) leaves nothing live behind, so it puts K ops in one
# clock window, K the smallest count that makes jitter <= 1 % of the window (sized from a pilot,
# cap 256); where the clock is tight K == 1. The resource-creating rows stay at ONE op per window
# (cap 1) on every host: holding K results live changes the op being measured. Forcing K to the
# cap on NVK moved create_storage_buffer_4k 4.4 -> 6.1 us, texture_1x1_solid 23 -> 32 us,
# depth_texture_1080p 71 -> 568 us and compute_dispatch_1024 18 -> 63 us per op. Their residual
# clock bias is bounded and printed instead, and a row that reads 0 fails the run.

var _bw_device = 0;
var _bw_queue  = 0;
var _bw_a      = 0;
var _bw_b      = 0;
var _bw_c      = 0;
var _bw_n      = 0;   # running op index for rows that consume a unique input per op
var _bw_count  = 0;   # inputs available to such a row
var _bw_starved = 0;  # ops of such a row that found no input left (the row is then invalid)
var _bw_flush_failed = 0;   # untimed flushes that could not create their encoder

# floor - fastest of 16384 empty windows (never negative): how far below the subtracted floor a
# single window's clock cost reaches right now.
fn _clock_jitter_ns(): i64 {
    var fl = bench_clock_overhead_ns();
    var fastest = 0x7FFFFFFFFFFFFFFF;
    var i = 0;
    while (i < 16384) {
        var t = now_ns();
        var e = now_ns() - t;
        if (e < fastest) { fastest = e; }
        i = i + 1;
    }
    var jit = fl - fastest;
    if (jit < 0) { jit = 0; }
    return jit;
}

# Untimed: spin the clock so the CPU leaves its idle state, then calibrate the floor.
fn _bench_clock_warm(): i64 {
    var i = 0;
    while (i < 65536) {
        now_ns();
        i = i + 1;
    }
    return bench_clock_overhead_ns();
}

# Smallest K with K * per_op >= 100 * jit, clamped to [1, cap]. A pilot that clamped to 0
# (per_op <= 0) is exactly the sub-jitter case, so it gets the cap.
fn _ops_per_window(per_op, cap, jit): i64 {
    var k = cap;
    if (per_op > 0) { k = (jit * 100 + per_op - 1) / per_op; }
    if (k < 1) { k = 1; }
    if (k > cap) { k = cap; }
    return k;
}

# One timed window of k ops: handles are kept inside the window and released after it, so the
# window times the op alone. flush_fp (untimed) runs after the releases.
#
# ⚠ The op call is its own statement, NOT an argument: cycc evaluates a call in a non-first
# argument slot with the earlier argument still pushed, so the callee runs on an rsp 8 bytes off
# 16-byte alignment. Cyrius code does not care; the driver does. `store64(slot, fncall0(op))`
# faulted on NVK (movdqa on a misaligned frame inside libvulkan_nouveau create_buffer).
fn _time_window(b, op_fp, rel_fp, flush_fp, handles, k): i64 {
    bench_batch_start(b);
    var i = 0;
    while (i < k) {
        var h = fncall0(op_fp);
        store64(handles + i * 8, h);
        i = i + 1;
    }
    bench_batch_stop(b, k);
    if (rel_fp != 0) {
        i = 0;
        while (i < k) {
            var hr = load64(handles + i * 8);
            if (hr != 0) { fncall1(rel_fp, hr); }
            i = i + 1;
        }
    }
    if (flush_fp != 0) { fncall0(flush_fp); }
    return 0;
}

# Pilot two windows (also the warm-up; discarded), size K, then run the measured windows.
# `base` is the single-op iteration count the row always used: kept exactly when K == 1,
# otherwise ceil(base / K) windows, but never fewer than min(base, 50) windows for the min.
fn _bench_row(name, op_fp, rel_fp, flush_fp, base, cap): i64 {
    var handles = alloc(cap * 8);
    var pk = cap;
    if (pk > 16) { pk = 16; }
    var pilot = bench_new("pilot");
    _time_window(pilot, op_fp, rel_fp, flush_fp, handles, pk);
    _time_window(pilot, op_fp, rel_fp, flush_fp, handles, pk);
    var jit = _clock_jitter_ns();
    var k = _ops_per_window(bench_min_ns(pilot), cap, jit);
    var windows = base;
    if (k > 1) {
        windows = (base + k - 1) / k;
        var min_windows = 50;
        if (base < min_windows) { min_windows = base; }
        if (windows < min_windows) { windows = min_windows; }
    }
    var b = bench_new(name);
    var w = 0;
    while (w < windows) {
        _time_window(b, op_fp, rel_fp, flush_fp, handles, k);
        w = w + 1;
    }
    _report(b, k, jit);
    return 0;
}

# Untimed, after a window: once 256+ queued writes have accumulated, submit an empty command buffer
# so they flush, then wait. Bounds the staging backlog without a submit after every single write.
fn _flush_queue_writes(): i64 {
    if (_bw_n < 256) { return 0; }
    _bw_n = 0;
    var enc = wgpu_device_create_command_encoder(_bw_device, "bench-flush-enc");
    if (enc == 0) {
        _bw_flush_failed = _bw_flush_failed + 1;
        return 0;
    }
    var cmd = wgpu_command_encoder_finish(enc, "bench-flush-cmd");
    if (cmd != 0) { wgpu_queue_submit_one(_bw_queue, cmd); }
    wgpu_command_encoder_release(enc);
    wgpu_device_poll(_bw_device, 1);
    return 0;
}

# ================================================================
# 1. create_storage_buffer_4k — Rust baseline 4.02 µs
# ================================================================
fn _op_storage_4k(): i64 {
    return create_storage_buffer(_bw_device, _bw_queue, _bw_a, 4096, "bench");
}

fn bench_create_storage_buffer_4k(device, queue): i64 {
    # Pre-fill 4 KiB of source data once; benchmark the create+write.
    var data = alloc(4096);
    memset(data, 0xAB, 4096);
    _bw_device = device;
    _bw_queue = queue;
    _bw_a = data;
    _bench_row("create_storage_buffer_4k", &_op_storage_4k, &wgpu_buffer_release, 0, 200, 1);
    return 0;
}

# ================================================================
# 2. create_uniform_buffer_64 — Rust baseline 2.81 µs
# ================================================================
fn _op_uniform_64(): i64 {
    return create_uniform_buffer(_bw_device, _bw_queue, _bw_a, 64, "bench");
}

fn bench_create_uniform_buffer_64(device, queue): i64 {
    var data = alloc(64);
    memset(data, 0x33, 64);
    _bw_device = device;
    _bw_queue = queue;
    _bw_a = data;
    _bench_row("create_uniform_buffer_64", &_op_uniform_64, &wgpu_buffer_release, 0, 500, 1);
    return 0;
}

# ================================================================
# 3. uniform_buffer_write — Rust baseline 929.87 ns
# The row that read min=0: an op inside the clock's jitter band, so it is batched (see above).
# Queued writes are flushed (untimed) every 256 writes so they never pile up unsubmitted.
# ================================================================
fn _op_uniform_write(): i64 {
    wgpu_queue_write_buffer(_bw_queue, _bw_b, 0, _bw_a, 64);
    _bw_n = _bw_n + 1;
    return 0;
}

fn bench_uniform_buffer_write(device, queue): i64 {
    var data = alloc(64);
    memset(data, 0x77, 64);
    var ub = create_uniform_buffer(device, queue, data, 64, "write-target");
    if (ub == 0) { return _setup_fail("uniform_buffer_write", "the target uniform buffer"); }
    _bw_device = device;
    _bw_queue = queue;
    _bw_a = data;
    _bw_b = ub;
    _bw_n = 0;
    _bw_flush_failed = 0;
    _bench_row("uniform_buffer_write", &_op_uniform_write, 0, &_flush_queue_writes, 1000, 256);
    if (_bw_flush_failed != 0) {
        _bench_invalid = _bench_invalid + 1;
        _out("  FAIL: uniform_buffer_write could not flush its queued writes (encoder came back 0)\n");
    }
    wgpu_buffer_release(ub);
    return 0;
}

# ================================================================
# 4. shader_cache_hit — Rust baseline 36.52 ns
# v2.4.5: the cache now backs on the u64-keyed hashmap added in cyrius
# v5.5.20, so hits are pure int-hash + slot-compare with zero per-lookup
# allocation. Iteration counts restored to a comparable range with Rust's
# Criterion default. Already 10000 ops per timed window.
# ================================================================
fn bench_shader_cache_hit(device): i64 {
    var b = bench_new("shader_cache_hit");
    var cache = shader_cache_new();
    # Prime the cache
    var src = "@vertex fn vs_main() -> @builtin(position) vec4<f32> { return vec4(0.0); }";
    var primed = shader_cache_get_or_compile(cache, device, src, "prime");
    if (primed == 0) { return _setup_fail("shader_cache_hit", "the primed shader module"); }

    # Jitter right before the row's timed loop, as _bench_row does (see the timed-window notes).
    var jit = _clock_jitter_ns();
    var ri = 0;
    while (ri < 100) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < 10000) {
            shader_cache_get_or_compile(cache, device, src, "hit");
            bi = bi + 1;
        }
        bench_batch_stop(b, 10000);
        ri = ri + 1;
    }
    _report(b, 10000, jit);
    # The cache is private to this row and dropped here; release the one module it holds.
    wgpu_shader_module_release(primed);
    return 0;
}

# ================================================================
# 5. shader_cache_miss — Rust baseline 3.65 µs
# Each op uses a unique source string so the cache always misses
# (forces a real wgpu shader module create). We vary the body text so
# the FNV hash is different and forces a real compile each time.
#
# Kept small (30 shaders + 2 warm-up). ShaderCache has no release API, so the op hands each new
# module back to _time_window, which releases it after the window (untimed). That leaves a stale
# entry in the row's private cache, which is safe here: every source is unique, so no entry is
# ever looked up again, and the cache is dropped after the row. Unreleased, each miss would hold
# a shader module on the wgpu device for the rest of the run.
# ================================================================
fn _op_shader_miss(): i64 {
    if (_bw_n >= _bw_count) {
        _bw_starved = _bw_starved + 1;
        return 0;
    }
    var src = load64(_bw_a + _bw_n * 8);
    _bw_n = _bw_n + 1;
    return shader_cache_get_or_compile(_bw_b, _bw_device, src, "miss");
}

fn bench_shader_cache_miss(device): i64 {
    var cap = 1;
    var base = 30;
    var count = (2 + base) * cap;
    var sources = alloc(count * 8);
    var gi = 0;
    while (gi < count) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb,
          "@vertex fn vs_main() -> @builtin(position) vec4<f32> { return vec4<f32>(");
        str_builder_add_int(sb, gi);
        str_builder_add_cstr(sb, ".0, 0.0, 0.0, 1.0); }");
        store64(sources + gi * 8, str_cstr(str_builder_build(sb)));
        gi = gi + 1;
    }
    _bw_device = device;
    _bw_a = sources;
    _bw_b = shader_cache_new();
    _bw_n = 0;
    _bw_count = count;
    _bw_starved = 0;
    _bench_row("shader_cache_miss", &_op_shader_miss, &wgpu_shader_module_release, 0, base, cap);
    if (_bw_starved != 0) {
        _bench_invalid = _bench_invalid + 1;
        _out("  FAIL: shader_cache_miss ran out of prebuilt inputs (");
        fmt_int(_bw_starved);
        _out(" op(s) timed no compile)\n");
    }
    return 0;
}

# ================================================================
# 6. bind_group_cache_hit — Rust baseline 13.20 ns
# v2.4.5: zero-alloc hit path via u64-keyed hashmap (cyrius v5.5.20).
# Already 10000 ops per timed window.
# ================================================================
fn bench_bind_group_cache_hit(): i64 {
    var b = bench_new("bind_group_cache_hit");
    var cache = bind_group_cache_new();
    bind_group_cache_set(cache, 0xBEEFCAFE, 0x12345678);

    # Jitter right before the row's timed loop, as _bench_row does (see the timed-window notes).
    var jit = _clock_jitter_ns();
    var ri = 0;
    while (ri < 100) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < 10000) {
            bind_group_cache_get(cache, 0xBEEFCAFE);
            bi = bi + 1;
        }
        bench_batch_stop(b, 10000);
        ri = ri + 1;
    }
    _report(b, 10000, jit);
    return 0;
}

