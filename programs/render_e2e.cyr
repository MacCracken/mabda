# programs/render_e2e.cyr — Render pipeline end-to-end GPU test
#
# Exercises the last open v1.0 criterion: "Render pipeline end-to-end
# draw + readback". The render-pass flow is the simplest that covers
# the new FFI slots (58-64):
#
#   1. Create 256×256 RGBA8_UNORM render target (RENDER_ATTACHMENT|COPY_SRC)
#   2. Create a default 2D view on the texture
#   3. Build a RenderPassBuilder with a CLEAR color attachment using
#      that view — clearColor = (1.0, 0.0, 0.0, 1.0) (opaque red)
#   4. Create a command encoder, open the render pass via rpb_pass_begin,
#      immediately end it (clearing is enough — no draw calls needed)
#   5. CopyTextureToBuffer into a MAP_READ buffer
#   6. Finish + submit, map the readback buffer, verify pixel(0,0) is
#      0xFF, 0x00, 0x00, 0xFF (exact — RGBA8_UNORM is a linear, 1:1
#      mapping from f64 integer values)
#
# 256 × 4 = 1024 bytes per row (aligned to wgpu's 256-byte bytesPerRow
# requirement), so the readback buffer is 256 × 1024 = 262144 bytes.
#
# Linked with deps/wgpu_main.c via the Makefile target `test-render-e2e`.
# Selective includes mirror programs/compute_e2e.cyr (no src/lib.cyr —
# keeps the object small).

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/syscalls.cyr"
include "lib/fnptr.cyr"
include "lib/hashmap.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/tagged.cyr"
include "lib/sakshi.cyr"
include "lib/mmap.cyr"

include "src/error.cyr"
include "src/color.cyr"
include "src/wgpu_types.cyr"
include "src/wgpu_descriptors.cyr"
include "src/wgpu_ffi.cyr"
include "src/backend.cyr"
include "src/render_target.cyr"
include "src/render_pipeline.cyr"
include "src/render_pass.cyr"
include "src/backend_wgpu.cyr"
include "src/backend_native.cyr"
include "src/context.cyr"
include "src/buffer.cyr"
include "src/texture.cyr"

var _gpu_preinit = 0;
var _gpu_ctx = 0;

fn _fail(msg, len) { syscall(1, 2, msg, len); return 1; }

fn mabda_main(fn_table_ptr, preinit_ptr) {
    color_init();
    wgpu_ffi_init_table(fn_table_ptr);
    _gpu_preinit = preinit_ptr;

    var res = gpu_context_from_preinit(_gpu_preinit);
    if (is_err_result(res) == 1) {
        syscall(1, 2, "SKIP: no GPU available\n", 23);
        return 0;
    }
    _gpu_ctx = payload(res);
    var device = gpu_ctx_device(_gpu_ctx);
    var queue = gpu_ctx_queue(_gpu_ctx);
    syscall(1, 1, "PASS: GPU context created\n", 26);

    # --- 1. Render target (RGBA8_UNORM, 256x256) ---
    var W = 256;
    var H = 256;
    var target = texture_create_render_target_rgba8(device, W, H, "render-target");
    if (target == 0) { return _fail("FAIL: render target create\n", 27); }
    var view = texture_view_create_rgba8(target, "render-target-view");
    if (view == 0) { return _fail("FAIL: render target view\n", 25); }
    syscall(1, 1, "PASS: render target + view\n", 27);

    # --- 2. RenderPassBuilder with a single CLEAR color attachment ---
    # clearColor = opaque red (1.0, 0.0, 0.0, 1.0) — round-trips cleanly
    # to 0xFF, 0x00, 0x00, 0xFF under RGBA8_UNORM.
    var clear = color_new(F64_1, F64_0, F64_0, F64_1);
    var rpb = rpb_pass_new();
    rpb_pass_label(rpb, "render-e2e-pass");
    rpb_pass_color(rpb, view, clear);
    syscall(1, 1, "PASS: render pass builder populated\n", 36);

    # --- 3. Encoder, open pass, end pass (clear-only, no draws) ---
    var enc = wgpu_device_create_command_encoder(device, "render-e2e-enc");
    if (enc == 0) { return _fail("FAIL: encoder\n", 14); }
    var pass = rpb_pass_begin(enc, rpb);
    if (pass == 0) { return _fail("FAIL: rpb_pass_begin\n", 21); }
    wgpu_render_pass_encoder_end(pass);
    wgpu_render_pass_encoder_release(pass);
    syscall(1, 1, "PASS: render pass clear encoded\n", 32);

    # --- 4. Copy texture → MAP_READ buffer ---
    # bytesPerRow = 256 * 4 = 1024 (already a multiple of wgpu's 256-byte
    # alignment requirement; no padding needed).
    var BYTES_PER_ROW = 1024;
    var BUF_SIZE = 262144;  # 256 * 1024
    var read_usage = WGPU_BUFFER_USAGE_MAP_READ | WGPU_BUFFER_USAGE_COPY_DST;
    var read_desc = wgpu_buffer_descriptor("render-readback", read_usage, BUF_SIZE, 0);
    var read_buf = wgpu_device_create_buffer(device, read_desc);
    if (read_buf == 0) { return _fail("FAIL: readback buffer\n", 22); }

    # Pack CopyTexToBufArgs (72 bytes — matches WgpuCopyTexToBufArgs in
    # deps/wgpu_main.c). See the shim header for the layout.
    var cargs = alloc(72);
    memset(cargs, 0, 72);
    store64(cargs + 0,  target);           # src_texture
    store32(cargs + 8,  0);                # src_mip_level
    store32(cargs + 12, 0);                # src_origin_x
    store32(cargs + 16, 0);                # src_origin_y
    store32(cargs + 20, 0);                # src_origin_z
    store32(cargs + 24, 0);                # aspect = All
    store64(cargs + 32, read_buf);         # dst_buffer
    store64(cargs + 40, 0);                # dst_offset
    store32(cargs + 48, BYTES_PER_ROW);    # dst_bytes_per_row
    store32(cargs + 52, H);                # dst_rows_per_image
    store32(cargs + 56, W);                # copy_w
    store32(cargs + 60, H);                # copy_h
    store32(cargs + 64, 1);                # copy_depth
    wgpu_command_encoder_copy_texture_to_buffer(enc, cargs);
    syscall(1, 1, "PASS: copy texture->buffer encoded\n", 35);

    # --- 5. Finish + submit ---
    var cmd = wgpu_command_encoder_finish(enc, "render-e2e-cmd");
    if (cmd == 0) { return _fail("FAIL: cmd finish\n", 17); }
    wgpu_queue_submit_one(queue, cmd);

    # --- 6. Map and verify pixel(0,0) ---
    var status = wgpu_buffer_map_sync(device, read_buf, WGPU_MAP_MODE_READ, 0, BUF_SIZE);
    if (status != WGPU_BUFFER_MAP_ASYNC_STATUS_SUCCESS) {
        return _fail("FAIL: map readback\n", 19);
    }
    var mapped = wgpu_buffer_get_const_mapped_range(read_buf, 0, BUF_SIZE);
    if (mapped == 0) { return _fail("FAIL: get mapped range\n", 23); }

    var r = load8(mapped + 0);
    var g = load8(mapped + 1);
    var b = load8(mapped + 2);
    var a = load8(mapped + 3);
    if (r != 0xFF) { wgpu_buffer_unmap(read_buf); return _fail("FAIL: red != 0xFF\n", 18); }
    if (g != 0x00) { wgpu_buffer_unmap(read_buf); return _fail("FAIL: green != 0x00\n", 20); }
    if (b != 0x00) { wgpu_buffer_unmap(read_buf); return _fail("FAIL: blue != 0x00\n", 19); }
    if (a != 0xFF) { wgpu_buffer_unmap(read_buf); return _fail("FAIL: alpha != 0xFF\n", 20); }
    wgpu_buffer_unmap(read_buf);
    syscall(1, 1, "PASS: pixel(0,0) = (0xFF, 0x00, 0x00, 0xFF)\n", 44);

    syscall(1, 1, "\n8 passed, 0 failed\n", 20);
    return 0;
}
