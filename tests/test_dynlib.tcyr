# test_dynlib.tcyr — tests for dynlib.cyr (pure Cyrius .so loader)
# Tests against libm.so which is available on all Linux systems

include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/fmt.cyr"
include "lib/syscalls.cyr"
include "lib/mmap.cyr"
include "lib/fnptr.cyr"
include "lib/assert.cyr"
include "lib/dynlib.cyr"

# ================================================================
# Test: open a known shared library
# ================================================================

fn test_dynlib_open() {
    # Try common libc paths
    var handle = dynlib_open("/usr/lib/libm.so.6");
    if (handle == 0) { handle = dynlib_open("/lib/x86_64-linux-gnu/libm.so.6"); }
    if (handle == 0) { handle = dynlib_open("/lib64/libm.so.6"); }
    if (handle == 0) {
        # Skip test if no libm found
        syscall(1, 2, "SKIP: libm.so.6 not found\n", 27);
        return 0;
    }
    assert(handle != 0, "dynlib_open returns non-null handle");
    dynlib_close(handle);
    return 0;
}

# ================================================================
# Test: open nonexistent file returns 0
# ================================================================

fn test_dynlib_open_fail() {
    var handle = dynlib_open("/nonexistent/library.so");
    assert_eq(handle, 0, "dynlib_open returns 0 for missing file");
    return 0;
}

# ================================================================
# Test: resolve a known symbol from libm
# ================================================================

fn test_dynlib_sym() {
    var handle = dynlib_open("/usr/lib/libm.so.6");
    if (handle == 0) { handle = dynlib_open("/lib/x86_64-linux-gnu/libm.so.6"); }
    if (handle == 0) { handle = dynlib_open("/lib64/libm.so.6"); }
    if (handle == 0) {
        syscall(1, 2, "SKIP: libm.so.6 not found\n", 27);
        return 0;
    }

    # Look up "ceil" — a standard math function
    var ceil_ptr = dynlib_sym(handle, "ceil");
    assert(ceil_ptr != 0, "dynlib_sym finds ceil in libm");

    # Look up "floor"
    var floor_ptr = dynlib_sym(handle, "floor");
    assert(floor_ptr != 0, "dynlib_sym finds floor in libm");

    # Look up nonexistent symbol
    var bad = dynlib_sym(handle, "this_does_not_exist_at_all");
    assert_eq(bad, 0, "dynlib_sym returns 0 for unknown symbol");

    dynlib_close(handle);
    return 0;
}

# ================================================================
# Test: resolve and call a function via fncall
# ================================================================

fn test_dynlib_call() {
    var handle = dynlib_open("/usr/lib/libm.so.6");
    if (handle == 0) { handle = dynlib_open("/lib/x86_64-linux-gnu/libm.so.6"); }
    if (handle == 0) { handle = dynlib_open("/lib64/libm.so.6"); }
    if (handle == 0) {
        syscall(1, 2, "SKIP: libm.so.6 not found\n", 27);
        return 0;
    }

    # Look up "abs" from libc (actually in libm on some systems)
    # Use ceil instead — it takes a double and returns a double
    # ceil(2.3) = 3.0
    #
    # f64 2.3 bit pattern: 0x4002666666666666
    # f64 3.0 bit pattern: 0x4008000000000000

    var ceil_ptr = dynlib_sym(handle, "ceil");
    if (ceil_ptr == 0) {
        syscall(1, 2, "SKIP: ceil not found\n", 21);
        dynlib_close(handle);
        return 0;
    }

    # Call ceil(2.3) — argument is f64 passed in xmm0 via System V ABI
    # NOTE: fncall1 passes args in integer registers (rdi), not xmm0
    # For float args, we would need a float-aware fncall
    # For now, just verify the symbol resolves to a nonzero address
    assert(ceil_ptr != 0, "ceil function pointer is valid");

    dynlib_close(handle);
    return 0;
}

# ================================================================
# Test: close then sym returns 0
# ================================================================

fn test_dynlib_close() {
    var handle = dynlib_open("/usr/lib/libm.so.6");
    if (handle == 0) { handle = dynlib_open("/lib/x86_64-linux-gnu/libm.so.6"); }
    if (handle == 0) { handle = dynlib_open("/lib64/libm.so.6"); }
    if (handle == 0) {
        syscall(1, 2, "SKIP: libm.so.6 not found\n", 27);
        return 0;
    }

    dynlib_close(handle);
    # After close, the mapping is gone — don't try to use handle
    # Just verify close doesn't crash
    assert(1 == 1, "dynlib_close does not crash");
    return 0;
}

# ================================================================
# Main
# ================================================================

fn main() {
    alloc_init();
    test_dynlib_open();
    test_dynlib_open_fail();
    test_dynlib_sym();
    test_dynlib_call();
    test_dynlib_close();
    return assert_summary();
}
var exit_code = main();
syscall(60, exit_code);
