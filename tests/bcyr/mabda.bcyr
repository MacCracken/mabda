# tests/bcyr/mabda.bcyr — CPU-only benchmark harness for mabda
# Mirrors the 7 CPU-only benchmarks from the Rust v1.0.0 benches/benchmarks.rs
# (see git tag 1.0.0). GPU-backed benchmarks deferred (see docs/development/roadmap.md)
# to a later release; they live in a separate file.
#
# Usage: cyrius bench tests/bcyr/mabda.bcyr
#
# Rust reference numbers (docs/rust-v1-bench-history.csv, commit f113c93):
#   color_lerp              257.40 ps
#   color_from_hex          259.40 ps
#   color_luminance         258.80 ps
#   workgroups_1d           258.00 ps
#   workgroups_2d           258.30 ps
#   profiler_frame_cycle     65.56 ns
#   capabilities_report     287.61 ns
#
# Cyrius operations below the ~250 ns `clock_gettime` floor need batched
# timing (see lib/bench.cyr header). We batch the color/workgroup ops at
# 10 000 iterations × 100 rounds and report per-op min across rounds.

include "src/lib.cyr"
include "lib/bench.cyr"
# buffer.cyr contains workgroups_1d and workgroups_2d but also pulls in
# wgpu_ffi; we use capability-level workgroups helpers to stay standalone.
# Replicate the math here to avoid the FFI dep:
fn _wg1(total, wg_size) { return (total + wg_size - 1) / wg_size; }
fn _wg2(dst, w, h, wg_x, wg_y) {
    store64(dst, (w + wg_x - 1) / wg_x);
    store64(dst + 8, (h + wg_y - 1) / wg_y);
    return 0;
}

# Emit a CSV row matching the schema in bench-history.csv. bench_report
# already prints the human-readable form; this is in addition, so scripts
# can grep for the `CSV:` prefix and feed straight into the history file.
fn _csv_row(b) {
    var name = load64(b);
    syscall(1, 1, "CSV:", 4);
    syscall(1, 1, name, strlen(name));
    syscall(1, 1, ",", 1);
    fmt_int(bench_min_ns(b));
    syscall(1, 1, "\n", 1);
    return 0;
}

# ================================================================
# Batch tuning
# ================================================================
var BATCH_SIZE = 10000;
var ROUNDS = 100;

# ================================================================
# Benchmark 1: color_lerp
# Rust baseline: 257.40 ps
# ================================================================
fn bench_color_lerp() {
    var b = bench_new("color_lerp");
    var a = COLOR_BLACK();
    var w = COLOR_WHITE();
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < BATCH_SIZE) {
            color_lerp(a, w, F64_HALF);
            bi = bi + 1;
        }
        bench_batch_stop(b, BATCH_SIZE);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# ================================================================
# Benchmark 2: color_from_hex
# Rust baseline: 259.40 ps
# ================================================================
fn bench_color_from_hex() {
    var b = bench_new("color_from_hex");
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < BATCH_SIZE) {
            color_from_hex(0xFF8040FF);
            bi = bi + 1;
        }
        bench_batch_stop(b, BATCH_SIZE);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# ================================================================
# Benchmark 3: color_luminance
# Rust baseline: 258.80 ps
# ================================================================
fn bench_color_luminance() {
    var b = bench_new("color_luminance");
    var c = color_rgb(F64_HALF, F64_HALF, F64_HALF);
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < BATCH_SIZE) {
            color_luminance(c);
            bi = bi + 1;
        }
        bench_batch_stop(b, BATCH_SIZE);
        ri = ri + 1;
