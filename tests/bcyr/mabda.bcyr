# ================================================================
# Benchmark 4: workgroups_1d — pure integer math
# Rust baseline: 258.00 ps
# ================================================================
fn bench_workgroups_1d() {
    var b = bench_new("workgroups_1d");
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < BATCH_SIZE) {
            _wg1(1000000, 256);
            bi = bi + 1;
        }
        bench_batch_stop(b, BATCH_SIZE);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# ================================================================
# Benchmark 5: workgroups_2d — writes two i64s to a stack slot
# Rust baseline: 258.30 ps
# ================================================================
fn bench_workgroups_2d() {
    var b = bench_new("workgroups_2d");
    var dst[16];
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < BATCH_SIZE) {
            _wg2(&dst, 1920, 1080, 16, 16);
            bi = bi + 1;
        }
        bench_batch_stop(b, BATCH_SIZE);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# ================================================================
# Benchmark 6: profiler_frame_cycle — begin/end round-trip
# Rust baseline: 65.56 ns
# ================================================================
fn bench_profiler_frame_cycle() {
    var b = bench_new("profiler_frame_cycle");
    var p = profiler_new();
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < BATCH_SIZE) {
            profile_begin(p);
            profile_end(p);
            bi = bi + 1;
        }
        bench_batch_stop(b, BATCH_SIZE);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# ================================================================
# Benchmark 7: capabilities_report — format the caps report
# Rust baseline: 287.61 ns
# ================================================================
fn _build_full_caps() {
    var c = gpu_caps_new();
    gpu_caps_set_adapter_name(c, "Test GPU");
    gpu_caps_set_backend(c, "Vulkan");
    gpu_caps_set_timestamp_query(c, 1);
    gpu_caps_set_max_texture_2d(c, 16384);
    gpu_caps_set_max_uniform(c, 65536);
    gpu_caps_set_max_storage(c, 134217728);
    gpu_caps_set_max_buffer(c, 268435456);
    gpu_caps_set_max_bind_groups(c, 4);
    gpu_caps_set_max_vertex_buf(c, 8);
    gpu_caps_set_compute_wg(c, 256, 256, 64);
    gpu_caps_set_compute_wgs_dim(c, 65535);
    gpu_caps_set_multi_draw(c, 0);
    return c;
}

# Simulate the Rust `report()` format by reading every accessor — the Rust
# function calls `writeln!` repeatedly, which is dominated by the same
# accessor + format cost.
fn _caps_touch_all(c) {
    var sum = 0;
    sum = sum + gpu_caps_timestamp_query(c);
    sum = sum + gpu_caps_compute_shaders(c);
    sum = sum + gpu_caps_max_texture_2d(c);
    sum = sum + gpu_caps_max_uniform_buffer(c);
    sum = sum + gpu_caps_max_storage_buffer(c);
    sum = sum + gpu_caps_max_buffer_size(c);
    sum = sum + gpu_caps_max_bind_groups(c);
    sum = sum + gpu_caps_max_vertex_buffers(c);
    sum = sum + gpu_caps_max_compute_wg_x(c);
    sum = sum + gpu_caps_max_compute_wg_y(c);
    sum = sum + gpu_caps_max_compute_wg_z(c);
    sum = sum + gpu_caps_max_compute_wgs_dim(c);
    sum = sum + gpu_caps_multi_draw_indirect(c);
    return sum;
}

fn bench_capabilities_report() {
    var b = bench_new("capabilities_report");
    var c = _build_full_caps();
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < BATCH_SIZE) {
            _caps_touch_all(c);
            bi = bi + 1;
        }
        bench_batch_stop(b, BATCH_SIZE);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# ================================================================
# Benchmark 8/9: rg_plan_aliasing_stats — v3 Phase A baselines
#
# Two baselines at different graph sizes. Real consumer workloads
# (soorat, rasa, aethersafta) will land in Phase D; until then these
# are synthetic placeholders that establish the scaling curve, not
# compete with any published GPU-library number.
#
# Planner complexity is O(n²) in transient count (selection sort +
# interval-coloring inner loop). Fine at tens of transients; if Phase D
# consumer workloads exceed ~100, revisit — interval-tree drops it to
# O(n log n).
#
# Allocator churn per call: 4 vec_new() calls. On the small bench that's
# a large fraction of the measured time. Scaled bench amortizes it.
# ================================================================
var PLAN_BATCH = 100;
var PLAN_ROUNDS = 100;

# Build an N-node linear chain with N-1 transients in staggered pattern.
# Each node i writes transient i and node i+1 reads it.
fn _build_plan_bench_chain(n_nodes) {
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    var n_trans = n_nodes - 1;
    var bufs = alloc(n_trans * 8);
    var i = 0;
    while (i < n_trans) {
        store64(bufs + i * 8, rg_add_transient_buffer(g, 256, 0, "b"));
        i = i + 1;
    }
    var nodes = alloc(n_nodes * 8);
    i = 0;
    while (i < n_nodes) {
        store64(nodes + i * 8, rg_add_compute(g, 0, 0, &dims, "n"));
        i = i + 1;
    }
    i = 0;
    while (i < n_trans) {
        rg_node_writes(g, load64(nodes + i * 8), load64(bufs + i * 8));
        rg_node_reads(g, load64(nodes + (i + 1) * 8), load64(bufs + i * 8));
        i = i + 1;
    }
    rg_build(g, 0);
    return g;
}

# Small chain: 6 nodes, 5 transients. Mostly allocator overhead; useful
# as a floor number only.
fn bench_rg_plan_small() {
    var b = bench_new("rg_plan_aliasing_stats_5");
    var g = _build_plan_bench_chain(6);
    var stats[24];
    var ri = 0;
    while (ri < PLAN_ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < PLAN_BATCH) {
            rg_plan_aliasing_stats(g, &stats);
            bi = bi + 1;
        }
        bench_batch_stop(b, PLAN_BATCH);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# Scaled synthetic: 31 nodes, 30 transients — intended as a placeholder
# for realistic per-frame graph complexity until Phase D consumers land.
# Not claiming parity with any shipped engine; just gives a scaling
# signal vs the 5-transient floor.
fn bench_rg_plan_scaled() {
    var b = bench_new("rg_plan_aliasing_stats_30");
    var g = _build_plan_bench_chain(31);
    var stats[24];
    var ri = 0;
    while (ri < PLAN_ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < PLAN_BATCH) {
            rg_plan_aliasing_stats(g, &stats);
            bi = bi + 1;
        }
        bench_batch_stop(b, PLAN_BATCH);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

fn main() {
    alloc_init();
    color_init();
    println("=== mabda CPU benchmarks ===");
    bench_color_lerp();
    bench_color_from_hex();
    bench_color_luminance();
    bench_workgroups_1d();
    bench_workgroups_2d();
    bench_profiler_frame_cycle();
    bench_capabilities_report();
    bench_rg_plan_small();
    bench_rg_plan_scaled();
    return 0;
}
var exit_code = main();
syscall(60, exit_code);
