}

# ================================================================
# Benchmark 3: color_luminance
# Rust baseline: 258.80 ps
# ================================================================
fn bench_color_luminance() {
    var b = bench_new("color_luminance");
    var c = color_rgb(MABDA_F64_HALF, MABDA_F64_HALF, MABDA_F64_HALF);
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < BENCH_BATCH) {
            color_luminance(c);
            bi = bi + 1;
        }
        bench_batch_stop(b, BENCH_BATCH);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# ================================================================
# Benchmark 4: workgroups_1d — pure integer math
# Rust baseline: 258.00 ps
# ================================================================
fn bench_workgroups_1d() {
    var b = bench_new("workgroups_1d");
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < BENCH_BATCH) {
            _wg1(1000000, 256);
            bi = bi + 1;
        }
        bench_batch_stop(b, BENCH_BATCH);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# ================================================================
# Benchmark 5: workgroups_2d — writes two i64s to a stack slot
# Rust baseline: 258.30 ps
# ================================================================
fn bench_workgroups_2d() {
    var b = bench_new("workgroups_2d");
    var dst[16];
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < BENCH_BATCH) {
            _wg2(&dst, 1920, 1080, 16, 16);
            bi = bi + 1;
        }
        bench_batch_stop(b, BENCH_BATCH);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# ================================================================
# Benchmark 6: profiler_frame_cycle — begin/end round-trip
# Rust baseline: 65.56 ns
# ================================================================
fn bench_profiler_frame_cycle() {
    var b = bench_new("profiler_frame_cycle");
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < BENCH_BATCH) {
            # profile_begin() takes no args and returns a start timestamp;
            # profile_end(start_ns) consumes it. Threading the real handle
            # through is what makes this the round-trip the name claims.
            var start = profile_begin();
            profile_end(start);
            bi = bi + 1;
        }
        bench_batch_stop(b, BENCH_BATCH);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# ================================================================
# Benchmark 7: capabilities_report — format the caps report
# Rust baseline: 287.61 ns
# ================================================================
fn _build_full_caps() {
    var c = gpu_caps_new();
    gpu_caps_set_adapter_name(c, "Test GPU");
    gpu_caps_set_backend(c, "Vulkan");
    gpu_caps_set_timestamp_query(c, 1);
    gpu_caps_set_max_texture_2d(c, 16384);
    gpu_caps_set_max_uniform(c, 65536);
    gpu_caps_set_max_storage(c, 134217728);
    gpu_caps_set_max_buffer(c, 268435456);
    gpu_caps_set_max_bind_groups(c, 4);
    gpu_caps_set_max_vertex_buf(c, 8);
    gpu_caps_set_compute_wg(c, 256, 256, 64);
    gpu_caps_set_compute_wgs_dim(c, 65535);
    gpu_caps_set_multi_draw(c, 0);
    return c;
}

# Simulate the Rust `report()` format by reading every accessor — the Rust
# function calls `writeln!` repeatedly, which is dominated by the same
# accessor + format cost.
fn _caps_touch_all(c) {
    var sum = 0;
    sum = sum + gpu_caps_timestamp_query(c);
    sum = sum + gpu_caps_compute_shaders(c);
    sum = sum + gpu_caps_max_texture_2d(c);
    sum = sum + gpu_caps_max_uniform_buffer(c);
    sum = sum + gpu_caps_max_storage_buffer(c);
    sum = sum + gpu_caps_max_buffer_size(c);
    sum = sum + gpu_caps_max_bind_groups(c);
    sum = sum + gpu_caps_max_vertex_buffers(c);
    sum = sum + gpu_caps_max_compute_wg_x(c);
    sum = sum + gpu_caps_max_compute_wg_y(c);
    sum = sum + gpu_caps_max_compute_wg_z(c);
    sum = sum + gpu_caps_max_compute_wgs_dim(c);
    sum = sum + gpu_caps_multi_draw_indirect(c);
    return sum;
}

fn bench_capabilities_report() {
    var b = bench_new("capabilities_report");
    var c = _build_full_caps();
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < BENCH_BATCH) {
            _caps_touch_all(c);
            bi = bi + 1;
        }
        bench_batch_stop(b, BENCH_BATCH);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# ================================================================
# Benchmark 8/9: rg_plan_aliasing_stats — v3 Phase A baselines
#
# Two baselines at different graph sizes. Real consumer workloads
# (soorat, rasa, aethersafta) will land in Phase D; until then these
# are synthetic placeholders that establish the scaling curve, not
# compete with any published GPU-library number.
#
# Planner complexity is O(n²) in transient count (selection sort +
# interval-coloring inner loop). Fine at tens of transients; if Phase D
# consumer workloads exceed ~100, revisit — interval-tree drops it to
# O(n log n).
#
# Allocator churn per call: 4 vec_new() calls. On the small bench that's
# a large fraction of the measured time. Scaled bench amortizes it.
# ================================================================
var PLAN_BATCH = 100;
var PLAN_ROUNDS = 100;

# Build an N-node linear chain with N-1 transients in staggered pattern.
# Each node i writes transient i and node i+1 reads it.
fn _build_plan_bench_chain(n_nodes) {
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    var n_trans = n_nodes - 1;
    var bufs = alloc(n_trans * 8);
    var i = 0;
    while (i < n_trans) {
        store64(bufs + i * 8, rg_add_transient_buffer(g, 256, 0, "b"));
        i = i + 1;
    }
    var nodes = alloc(n_nodes * 8);
    i = 0;
    while (i < n_nodes) {
        store64(nodes + i * 8, rg_add_compute(g, 0, 0, &dims, "n"));
        i = i + 1;
    }
    i = 0;
    while (i < n_trans) {
        rg_node_writes(g, load64(nodes + i * 8), load64(bufs + i * 8));
        rg_node_reads(g, load64(nodes + (i + 1) * 8), load64(bufs + i * 8));
        i = i + 1;
    }
    rg_build(g, 0);
    return g;
}

# Small chain: 6 nodes, 5 transients. Mostly allocator overhead; useful
# as a floor number only.
fn bench_rg_plan_small() {
    var b = bench_new("rg_plan_aliasing_stats_5");
    var g = _build_plan_bench_chain(6);
    var stats[24];
    var ri = 0;
    while (ri < PLAN_ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < PLAN_BATCH) {
            rg_plan_aliasing_stats(g, &stats);
            bi = bi + 1;
        }
        bench_batch_stop(b, PLAN_BATCH);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# Scaled synthetic: 31 nodes, 30 transients — intended as a placeholder
# for realistic per-frame graph complexity until Phase D consumers land.
# Not claiming parity with any shipped engine; just gives a scaling
# signal vs the 5-transient floor.
fn bench_rg_plan_scaled() {
    var b = bench_new("rg_plan_aliasing_stats_30");
    var g = _build_plan_bench_chain(31);
    var stats[24];
    var ri = 0;
    while (ri < PLAN_ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < PLAN_BATCH) {
            rg_plan_aliasing_stats(g, &stats);
            bi = bi + 1;
        }
        bench_batch_stop(b, PLAN_BATCH);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# ================================================================
# v4.3.0 — the render tier + the repairs (no Rust baseline: new in 4.3.0)
# Every buffer is allocated ONCE outside the timed loops (bump allocator).
# ================================================================

# gpu_copy_bytes vs the stdlib memcpy (issue 2026-11-02 byte-loop copies).
var _bc_src = 0;
var _bc_dst = 0;
var _BC_FRAME = 8294400;    # 1920 x 1080 x 4

fn _bench_copy(name, n, use_fast, rounds): i64 {
    var b = bench_new(name);
    var ri = 0;
    while (ri < rounds) {
        bench_batch_start(b);
        if (use_fast == 1) { gpu_copy_bytes(_bc_dst, _bc_src, n); }
        else { memcpy(_bc_dst, _bc_src, n); }
        bench_batch_stop(b, 1);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

fn bench_copies(): i64 {
    _bc_src = alloc(_BC_FRAME);
    _bc_dst = alloc(_BC_FRAME);
    memset(_bc_src, 0x5A, _BC_FRAME);
    _bench_copy("memcpy_128k (stdlib)", 131072, 0, 50);
    _bench_copy("gpu_copy_bytes_128k", 131072, 1, 50);
    _bench_copy("memcpy_1080p_frame (stdlib)", _BC_FRAME, 0, 5);
    _bench_copy("gpu_copy_bytes_1080p_frame", _BC_FRAME, 1, 5);
    return 0;
}

# Fill a pbr-style pipeline descriptor (Vertex3D preset, cull, target + blend,
# depth, 4 groups). The descriptor is reused: zeroed and refilled per op.
fn bench_pipeline_desc_fill(): i64 {
    var d = gpu_pipeline_desc_new(0x10, "vs_main");
    var b = bench_new("pipeline_desc_fill_3d");
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < 1000) {
            memset(d, 0, GPU_PIPELINE_DESC_SIZE);
            store64(d, 0x10);
            store64(d + 8, "vs_main");
            store64(d + 144, 1);
            gpu_pipeline_desc_fragment(d, 0x10, "fs_main");
            gpu_pipeline_desc_vertex_preset(d, GPU_VERTEX_LAYOUT_3D);
            gpu_pipeline_desc_primitive(d, GPU_TOPOLOGY_TRIANGLE_LIST, GPU_CULL_BACK, GPU_FRONT_CCW);
            gpu_pipeline_desc_target(d, MABDA_TEXFMT_RGBA8, GPU_BLEND_ALPHA, GPU_WRITE_ALL);
            gpu_pipeline_desc_depth(d, MABDA_TEXFMT_DEPTH32F, 1, GPU_COMPARE_LESS);
            gpu_pipeline_desc_bind_group_layout(d, 0, 0xA0);
            gpu_pipeline_desc_bind_group_layout(d, 1, 0xA1);
            gpu_pipeline_desc_bind_group_layout(d, 2, 0xA2);
            gpu_pipeline_desc_bind_group_layout(d, 3, 0xA3);
            gpu_pipeline_desc_validate(d);
            bi = bi + 1;
        }
        bench_batch_stop(b, 1000);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# Fill pbr's IBL group layout (6 entries) in a reused builder.
fn bench_bgl_fill(): i64 {
    var l = gpu_bind_group_layout_new();
    var b = bench_new("bgl_fill_pbr_ibl_6");
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < 1000) {
            store64(l, 0);
            gpu_bgl_texture(l, 0, 2, GPU_SAMPLE_FLOAT, GPU_VIEW_CUBE, 0);
            gpu_bgl_sampler(l, 1, 2, GPU_SAMPLER_FILTERING);
            gpu_bgl_texture(l, 2, 2, GPU_SAMPLE_FLOAT, GPU_VIEW_CUBE, 0);
            gpu_bgl_sampler(l, 3, 2, GPU_SAMPLER_FILTERING);
            gpu_bgl_texture(l, 4, 2, GPU_SAMPLE_FLOAT, GPU_VIEW_2D, 0);
            gpu_bgl_sampler(l, 5, 2, GPU_SAMPLER_FILTERING);
            bi = bi + 1;
        }
        bench_batch_stop(b, 1000);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# One profiled frame with 8 passes (L24): steady state allocates nothing.
fn bench_profiler_passes(): i64 {
    var p = profiler_new();
    var b = bench_new("profiler_frame_8_passes");
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < 1000) {
            profiler_begin_frame(p);
            var k = 0;
            while (k < 8) { profiler_record_pass(p, "pass", 4, F64_1); k = k + 1; }
            profiler_total_pass_time_ms(p);
            profiler_end_frame(p);
            bi = bi + 1;
        }
        bench_batch_stop(b, 1000);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# The CPU cost of a public draw-time call: validation + backend dispatch into a
# no-op slot (what mabda adds on top of the wgpu call itself).
fn _bd_noop(ctx, pass, a, b, c, d, e): i64 { return 0; }

fn bench_draw_dispatch(): i64 {
    var ctx = alloc(GPU_CONTEXT_SIZE);
    memset(ctx, 0, GPU_CONTEXT_SIZE);
    var be = backend_new();
    backend_set_slot(be, BACKEND_SLOT_PASS_DRAW_INDEXED, &_bd_noop);
    backend_set_slot(be, BACKEND_SLOT_PASS_SET_BIND_GROUP, &_bd_noop);
    store64(ctx + 32, be);
    var pass = alloc(48);
    var offs = alloc(8);
    store32(offs, 256);
    var b = bench_new("draw_indexed_plus_dynamic_group_dispatch");
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < 1000) {
            gpu_render_pass_set_bind_group(ctx, pass, 1, 0x77, 1, offs);
            gpu_render_pass_draw_indexed(ctx, pass, 36, 1, 0, 0, 0);
            bi = bi + 1;
        }
        bench_batch_stop(b, 1000);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# ================================================================
# v4.3.1 — the render tier's MB2-MB4 (no Rust baseline: new in 4.3.1)
# ================================================================

# Refill a G-buffer pass descriptor (3 colour targets + depth, the clear
# changed) in place: what a frame does to its reused descriptor.
fn bench_pass_desc_fill(): i64 {
    var pd = gpu_pass_desc_new();
    var c = color_new(F64_0, F64_0, F64_0, F64_1);
    var b = bench_new("pass_desc_fill_3_colour_depth");
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < 1000) {
            gpu_pass_desc_reset(pd);
            gpu_pass_desc_color(pd, 0xA0, GPU_LOAD_CLEAR, c);
            gpu_pass_desc_color(pd, 0xA1, GPU_LOAD_CLEAR, c);
            gpu_pass_desc_color(pd, 0xA2, GPU_LOAD_LOAD, 0);
            gpu_pass_desc_depth(pd, 0xA3, GPU_LOAD_CLEAR, F64_1);
            gpu_pass_desc_color_clear(pd, 0, c);
            bi = bi + 1;
        }
        bench_batch_stop(b, 1000);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

# The CPU cost of the public compute calls: validation + dispatch into no-op
# slots (set a dynamic-offset group, dispatch).
fn _bcp_noop(ctx, cp, a, b, c, d): i64 { return 0; }

fn bench_compute_dispatch_calls(): i64 {
    var ctx = alloc(GPU_CONTEXT_SIZE);
    memset(ctx, 0, GPU_CONTEXT_SIZE);
    var be = backend_new();
    backend_set_slot(be, BACKEND_SLOT_COMPUTE_PASS_SET_BIND_GROUP, &_bcp_noop);
    backend_set_slot(be, BACKEND_SLOT_COMPUTE_PASS_DISPATCH, &_bcp_noop);
    store64(ctx + 32, be);
    var cp = alloc(32);
    var offs = alloc(8);
    store32(offs, 256);
    var b = bench_new("compute_group_plus_dispatch_calls");
    var ri = 0;
    while (ri < ROUNDS) {
        bench_batch_start(b);
        var bi = 0;
        while (bi < 1000) {
            gpu_compute_pass_set_bind_group(ctx, cp, 0, 0x77, 1, offs);
            gpu_compute_pass_dispatch(ctx, cp, 64, 1, 1);
            bi = bi + 1;
        }
        bench_batch_stop(b, 1000);
        ri = ri + 1;
    }
    bench_report(b); _csv_row(b);
    return 0;
}

fn main() {
    alloc_init();
    color_init();
    println("=== mabda CPU benchmarks ===");
    bench_color_lerp();
    bench_color_from_hex();
    bench_color_luminance();
    bench_workgroups_1d();
    bench_workgroups_2d();
    bench_profiler_frame_cycle();
    bench_capabilities_report();
    bench_rg_plan_small();
    bench_rg_plan_scaled();
    bench_copies();
    bench_pipeline_desc_fill();
    bench_bgl_fill();
    bench_profiler_passes();
    bench_draw_dispatch();
    bench_pass_desc_fill();
    bench_compute_dispatch_calls();
    return 0;
}
var exit_code = main();
syscall(60, exit_code);
