; programs/native_rg_alias_e2e.cyr's slow kernel: o[gid] = a[gid] + 1, with a[gid] loaded after a 32768-step
; loop (so a concurrent writer to a's bytes would win the race without a wait). LocalSize 64.
; Rebuild as add.spvasm; the words go into build_slow_kernel.
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint GLCompute %main "main" %gid
               OpExecutionMode %main LocalSize 64 1 1
               OpDecorate %gid BuiltIn GlobalInvocationId
               OpDecorate %arr ArrayStride 4
               OpMemberDecorate %S 0 Offset 0
               OpDecorate %S Block
               OpDecorate %a DescriptorSet 0
               OpDecorate %a Binding 0
               OpDecorate %o DescriptorSet 0
               OpDecorate %o Binding 1
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
       %uint = OpTypeInt 32 0
        %v3u = OpTypeVector %uint 3
        %pin = OpTypePointer Input %v3u
       %bool = OpTypeBool
        %arr = OpTypeRuntimeArray %uint
          %S = OpTypeStruct %arr
         %pS = OpTypePointer StorageBuffer %S
         %pU = OpTypePointer StorageBuffer %uint
         %c0 = OpConstant %uint 0
         %c1 = OpConstant %uint 1
         %c5 = OpConstant %uint 5
         %c7 = OpConstant %uint 7
      %cdly = OpConstant %uint 32768
        %gid = OpVariable %pin Input
          %a = OpVariable %pS StorageBuffer
          %o = OpVariable %pS StorageBuffer
       %main = OpFunction %void None %fn
      %entry = OpLabel
         %gv = OpLoad %v3u %gid
          %x = OpCompositeExtract %uint %gv 0
               OpBranch %hdr
        %hdr = OpLabel
          %j = OpPhi %uint %c0 %entry %jn %body
        %acc = OpPhi %uint %x %entry %a2 %body
         %lc = OpULessThan %bool %j %cdly
               OpLoopMerge %exit %body None
               OpBranchConditional %lc %body %exit
       %body = OpLabel
         %m1 = OpIMul %uint %acc %c5
         %a1 = OpIAdd %uint %m1 %c7
         %m2 = OpIMul %uint %a1 %c5
         %a2 = OpIAdd %uint %m2 %c7
         %jn = OpIAdd %uint %j %c1
               OpBranch %hdr
       %exit = OpLabel
         %pa = OpAccessChain %pU %a %c0 %x
         %av = OpLoad %uint %pa
         %z = OpISub %uint %acc %acc
         %r0 = OpIAdd %uint %av %c1
         %r = OpIAdd %uint %r0 %z
         %po = OpAccessChain %pU %o %c0 %x
               OpStore %po %r
               OpReturn
               OpFunctionEnd
