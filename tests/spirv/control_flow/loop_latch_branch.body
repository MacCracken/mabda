; loop_latch_same_targets with an OpBranch latch: the code that kernel must compile to.
; want: i + 21
               OpBranch %hdr
        %hdr = OpLabel
          %j = OpPhi %uint %c0 %entry %jn %body
        %acc = OpPhi %uint %av %entry %an %body
         %lc = OpULessThan %bool %j %c7
               OpLoopMerge %exit %body None
               OpBranchConditional %lc %body %exit
       %body = OpLabel
         %an = OpIAdd %uint %acc %c3
         %jn = OpIAdd %uint %j %c1
         %cb = OpULessThan %bool %jn %c64
               OpBranch %hdr
       %exit = OpLabel
               OpStore %po %acc
               OpReturn
               OpFunctionEnd
