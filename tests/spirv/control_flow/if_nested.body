; A divergent if inside another. 4.3.1: GISEL_ERR_NESTED_SELECTION.
; want: 111 if i < 16 else (222 if i < 32 else D)
          %c = OpULessThan %bool %av %c32
               OpSelectionMerge %m None
               OpBranchConditional %c %t %m
          %t = OpLabel
               OpStore %po %c222
         %cc2 = OpULessThan %bool %av %c16
               OpSelectionMerge %m2 None
               OpBranchConditional %cc2 %t2 %m2
         %t2 = OpLabel
               OpStore %po %c111
               OpBranch %m2
         %m2 = OpLabel
               OpBranch %m
          %m = OpLabel
               OpReturn
               OpFunctionEnd
