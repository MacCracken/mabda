; 4.4.0 audit HIGH-1: a second load %y, used only after a uniform if the wave skips. The
; then-block uses %av, so the linear waitcnt pass waited there and forgot %y was in flight; on
; the path that skips the block, %y was read before it arrived. Now every branch waits first.
; want: 63 - i + 1000
         %t0 = OpISub %uint %c64 %x
         %ix = OpISub %uint %t0 %c1
         %pb = OpAccessChain %pU %a %c0 %ix
          %y = OpLoad %uint %pb
         %cc = OpUGreaterThanEqual %bool %w %c1
               OpSelectionMerge %m None
               OpBranchConditional %cc %t %m
          %t = OpLabel
               OpStore %po %av
               OpBranch %m
          %m = OpLabel
          %r = OpIAdd %uint %y %c1000
               OpStore %po %r
               OpReturn
               OpFunctionEnd
