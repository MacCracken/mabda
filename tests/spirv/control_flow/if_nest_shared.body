; Nested divergent if/elses with shared code after each merge, so both get reconvergence regions
; (4.4.0: B0 around the outer if, B1 around the inner) and the inner BSYNC runs inside the
; outer region. Phis at both merges.
; want: (((i * 3 if i & 1 else i + 5) * 7 + 1) if i & 2 else i) * 2 + 9
         %b2 = OpBitwiseAnd %uint %av %c2
         %o2 = OpINotEqual %bool %b2 %c0
               OpSelectionMerge %om None
               OpBranchConditional %o2 %ot %oe
         %ot = OpLabel
         %b1 = OpBitwiseAnd %uint %av %c1
         %o1 = OpINotEqual %bool %b1 %c0
               OpSelectionMerge %im None
               OpBranchConditional %o1 %it %ie
         %it = OpLabel
         %s1 = OpIMul %uint %av %c3
               OpBranch %im
         %ie = OpLabel
         %s2 = OpIAdd %uint %av %c5
               OpBranch %im
         %im = OpLabel
          %s = OpPhi %uint %s1 %it %s2 %ie
          %t = OpIMul %uint %s %c7
         %t1 = OpIAdd %uint %t %c1
               OpBranch %om
         %oe = OpLabel
          %u = OpIAdd %uint %av %c0
               OpBranch %om
         %om = OpLabel
          %r = OpPhi %uint %t1 %im %u %oe
         %r2 = OpIMul %uint %r %c2
         %r3 = OpIAdd %uint %r2 %c9
               OpStore %po %r3
               OpReturn
               OpFunctionEnd
