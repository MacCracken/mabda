; An OpIAdd between the compare and the OpSelect: isel re-emits the compare.
; want: i + 1 if i < 32 else 222
          %c = OpULessThan %bool %av %c32
          %t = OpIAdd %uint %av %c1
          %r = OpSelect %uint %c %t %c222
               OpStore %po %r
               OpReturn
               OpFunctionEnd
