; An s_add (writes SCC) between a TRUE uniform compare and its branch. 4.3.1: skipped.
; want: i + 4
         %cc = OpULessThan %bool %w %c1
          %u = OpIAdd %uint %w %c4
          %v = OpIAdd %uint %av %u
               OpSelectionMerge %m None
               OpBranchConditional %cc %t %m
          %t = OpLabel
               OpStore %po %v
               OpBranch %m
          %m = OpLabel
               OpReturn
               OpFunctionEnd
