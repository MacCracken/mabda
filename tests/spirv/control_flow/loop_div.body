; Loop with a divergent trip count. 4.3.1: lanes leaving early lost the code after the loop.
; want: i & 4
          %n = OpBitwiseAnd %uint %av %c4
               OpBranch %hdr
        %hdr = OpLabel
          %j = OpPhi %uint %c0 %entry %jn %body
         %lc = OpULessThan %bool %j %n
               OpLoopMerge %exit %body None
               OpBranchConditional %lc %body %exit
       %body = OpLabel
         %jn = OpIAdd %uint %j %c1
               OpBranch %hdr
       %exit = OpLabel
               OpStore %po %j
               OpReturn
               OpFunctionEnd
