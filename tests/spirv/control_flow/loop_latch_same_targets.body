; 4.4.0 audit MEDIUM-1: a loop latch `OpBranchConditional %cb %hdr %hdr`, both targets the
; header (legal before SPIR-V 1.6). GFX9 isel made an s_branch of it and selected the back-edge
; phi copies after it, where they never ran: %j never advanced (a GPU hang). It is lowered as
; OpBranch is now, so it compiles to exactly loop_latch_branch's code (compiler_compile.tcyr
; checks the bytes before any hardware runs it).
; want: i + 21
               OpBranch %hdr
        %hdr = OpLabel
          %j = OpPhi %uint %c0 %entry %jn %body
        %acc = OpPhi %uint %av %entry %an %body
         %lc = OpULessThan %bool %j %c7
               OpLoopMerge %exit %body None
               OpBranchConditional %lc %body %exit
       %body = OpLabel
         %an = OpIAdd %uint %acc %c3
         %jn = OpIAdd %uint %j %c1
         %cb = OpULessThan %bool %jn %c64
               OpBranchConditional %cb %hdr %hdr
       %exit = OpLabel
               OpStore %po %acc
               OpReturn
               OpFunctionEnd
