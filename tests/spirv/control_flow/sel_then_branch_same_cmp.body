; One compare feeds an OpSelect and then an if/else branch.
; want: 1000 if i < 32 else 2001
          %c = OpULessThan %bool %av %c32
          %r = OpSelect %uint %c %c1000 %c2000
               OpSelectionMerge %m None
               OpBranchConditional %c %t %e
          %t = OpLabel
               OpStore %po %r
               OpBranch %m
          %e = OpLabel
          %r1 = OpIAdd %uint %r %c1
               OpStore %po %r1
               OpBranch %m
          %m = OpLabel
               OpReturn
               OpFunctionEnd
