; head: f64
; An f64 loop accumulator: its phi copies a VGPR PAIR. 4.3.1 moved one dword (got 0).
; want: 12
; nv-refuse: SM75_ERR_UNSUPPORTED_OP
               OpBranch %hdr
        %hdr = OpLabel
          %j = OpPhi %uint %c0 %entry %jn %latch
        %acc = OpPhi %f64 %d0 %entry %acc2 %latch
         %lc = OpULessThan %bool %j %c4
               OpLoopMerge %exit %latch None
               OpBranchConditional %lc %body %exit
       %body = OpLabel
       %acc2 = OpFAdd %f64 %acc %d15
               OpBranch %latch
      %latch = OpLabel
         %jn = OpIAdd %uint %j %c1
               OpBranch %hdr
       %exit = OpLabel
         %dd = OpFMul %f64 %acc %d2
         %uu = OpConvertFToS %uint %dd
               OpStore %po %uu
               OpReturn
               OpFunctionEnd
