; The same with a FALSE uniform compare.
; want: D
         %cc = OpUGreaterThanEqual %bool %w %c1
          %u = OpIAdd %uint %w %c4
          %v = OpIAdd %uint %av %u
               OpSelectionMerge %m None
               OpBranchConditional %cc %t %m
          %t = OpLabel
               OpStore %po %v
               OpBranch %m
          %m = OpLabel
               OpReturn
               OpFunctionEnd
