; Uniform condition and uniform values: s_cselect_b32; consumed per-lane.
; want: i + 4
          %c = OpULessThan %bool %w %c1
         %u1 = OpIAdd %uint %w %c4
         %u2 = OpIAdd %uint %w %c8
          %r = OpSelect %uint %c %u1 %u2
          %v = OpIAdd %uint %av %r
               OpStore %po %v
               OpReturn
               OpFunctionEnd
