; Divergent loop with a divergent if (and an if-merge phi) in the body.
; want: (i & 12) // 2
          %n = OpBitwiseAnd %uint %av %c8
         %n2 = OpBitwiseAnd %uint %av %c4
         %nn = OpBitwiseOr %uint %n %n2
               OpBranch %hdr
        %hdr = OpLabel
          %j = OpPhi %uint %c0 %entry %jn %latch
        %acc = OpPhi %uint %c0 %entry %acc2 %latch
         %lc = OpULessThan %bool %j %nn
               OpLoopMerge %exit %latch None
               OpBranchConditional %lc %body %exit
       %body = OpLabel
         %jb = OpBitwiseAnd %uint %j %c1
         %od = OpIEqual %bool %jb %c1
               OpSelectionMerge %im None
               OpBranchConditional %od %ithen %im
      %ithen = OpLabel
       %acc1 = OpIAdd %uint %acc %c1
               OpBranch %im
         %im = OpLabel
       %acc2 = OpPhi %uint %acc1 %ithen %acc %body
               OpBranch %latch
      %latch = OpLabel
         %jn = OpIAdd %uint %j %c1
               OpBranch %hdr
       %exit = OpLabel
               OpStore %po %acc
               OpReturn
               OpFunctionEnd
