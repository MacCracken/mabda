; A divergent break out of the middle of the loop body.
; want: i & 15
          %n = OpBitwiseAnd %uint %av %c8
         %n2 = OpBitwiseAnd %uint %av %c4
         %n3 = OpBitwiseAnd %uint %av %c2
         %n4 = OpBitwiseAnd %uint %av %c1
         %t1 = OpBitwiseOr %uint %n %n2
         %t2 = OpBitwiseOr %uint %t1 %n3
         %nn = OpBitwiseOr %uint %t2 %n4
               OpBranch %hdr
        %hdr = OpLabel
          %j = OpPhi %uint %c0 %entry %jn %latch
         %lc = OpULessThan %bool %j %c16
               OpLoopMerge %exit %latch None
               OpBranchConditional %lc %body %exit
       %body = OpLabel
         %hit = OpIEqual %bool %j %nn
               OpBranchConditional %hit %exit %latch
      %latch = OpLabel
         %jn = OpIAdd %uint %j %c1
               OpBranch %hdr
       %exit = OpLabel
               OpStore %po %j
               OpReturn
               OpFunctionEnd
