; Two loop phis that swap every iteration: a parallel copy. 4.3.1 copied in sequence -> (2, 2).
; (a[x] is loaded and never read here, which also pins the dead-load register rule.)
; want: 33
               OpBranch %hdr
        %hdr = OpLabel
          %j = OpPhi %uint %c0 %entry %jn %latch
         %qa = OpPhi %uint %c1 %entry %qb %latch
         %qb = OpPhi %uint %c2 %entry %qa %latch
         %lc = OpULessThan %bool %j %c3
               OpLoopMerge %exit %latch None
               OpBranchConditional %lc %body %exit
       %body = OpLabel
               OpBranch %latch
      %latch = OpLabel
         %jn = OpIAdd %uint %j %c1
               OpBranch %hdr
       %exit = OpLabel
         %hi = OpIMul %uint %qa %c16
          %r = OpIAdd %uint %hi %qb
               OpStore %po %r
               OpReturn
               OpFunctionEnd
