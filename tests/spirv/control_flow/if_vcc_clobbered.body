; An OpUDiv (writes VCC) between the compare and the divergent branch. 4.3.1: lane 0 only.
; want: 111 if i < 32 else D
         %cc = OpULessThan %bool %av %c32
         %dq = OpUDiv %uint %c222 %av
               OpSelectionMerge %m None
               OpBranchConditional %cc %t %m
          %t = OpLabel
               OpStore %po %c111
               OpBranch %m
          %m = OpLabel
               OpReturn
               OpFunctionEnd
