; 4.4.0 audit HIGH-1, the register half: %y's only use is in a uniform if the wave skips, so
; regalloc freed its VGPR after that block while the load was still in flight. %z, computed
; after the merge, could take that VGPR, and %y landing late overwrote it. The wait for %q
; makes that land before %z is read. Now the branch waits for %y first.
; want: i * 3 + 7 + i
         %t0 = OpISub %uint %c64 %x
         %ix = OpISub %uint %t0 %c1
         %pb = OpAccessChain %pU %a %c0 %ix
          %y = OpLoad %uint %pb
         %cc = OpUGreaterThanEqual %bool %w %c1
               OpSelectionMerge %m None
               OpBranchConditional %cc %t %m
          %t = OpLabel
               OpStore %po %y
               OpBranch %m
          %m = OpLabel
          %z = OpIMul %uint %x %c3
         %z2 = OpIAdd %uint %z %c7
         %pq = OpAccessChain %pU %a %c0 %x
          %q = OpLoad %uint %pq
          %r = OpIAdd %uint %z2 %q
               OpStore %po %r
               OpReturn
               OpFunctionEnd
