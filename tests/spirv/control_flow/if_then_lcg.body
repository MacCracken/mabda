; A divergent if/else that seeds two different chains, then the shared 4096-iteration LCG loop
; (four acc * 5 + 7 steps per iteration). The merge is followed by real work, so the if gets a
; reconvergence region (4.4.0: BSSY / BSYNC): without it the two halves of each warp would run
; the whole loop separately. bench-nvidia-compute times it against loop_lcg.
; want: lcg(i * 3 if i & 1 else i + 5, 4 * 4096)
         %b1 = OpBitwiseAnd %uint %av %c1
         %od = OpINotEqual %bool %b1 %c0
               OpSelectionMerge %mrg None
               OpBranchConditional %od %then %else
       %then = OpLabel
         %s1 = OpIMul %uint %av %c3
               OpBranch %mrg
       %else = OpLabel
         %s2 = OpIAdd %uint %av %c5
               OpBranch %mrg
        %mrg = OpLabel
         %s0 = OpPhi %uint %s1 %then %s2 %else
          %n = OpIMul %uint %c64 %c64
               OpBranch %hdr
        %hdr = OpLabel
          %j = OpPhi %uint %c0 %mrg %jn %body
        %acc = OpPhi %uint %s0 %mrg %a4 %body
         %lc = OpULessThan %bool %j %n
               OpLoopMerge %exit %body None
               OpBranchConditional %lc %body %exit
       %body = OpLabel
         %m1 = OpIMul %uint %acc %c5
         %a1 = OpIAdd %uint %m1 %c7
         %m2 = OpIMul %uint %a1 %c5
         %a2 = OpIAdd %uint %m2 %c7
         %m3 = OpIMul %uint %a2 %c5
         %a3 = OpIAdd %uint %m3 %c7
         %m4 = OpIMul %uint %a3 %c5
         %a4 = OpIAdd %uint %m4 %c7
         %jn = OpIAdd %uint %j %c1
               OpBranch %hdr
       %exit = OpLabel
               OpStore %po %acc
               OpReturn
               OpFunctionEnd
