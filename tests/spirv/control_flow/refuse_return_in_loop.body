; An OpReturn inside a divergent loop body would end the wave.
; refuse: GISEL_ERR_RETURN_IN_SELECTION
; NVIDIA: EXIT retires only the threads that run it, so lanes returning at j == 2 just stop.
; nv-want: i if i <= 2 else D
               OpBranch %hdr
        %hdr = OpLabel
          %j = OpPhi %uint %c0 %entry %jn %latch
         %lc = OpULessThan %bool %j %av
               OpLoopMerge %exit %latch None
               OpBranchConditional %lc %body %exit
       %body = OpLabel
         %rc = OpIEqual %bool %j %c2
               OpSelectionMerge %sm None
               OpBranchConditional %rc %ret %sm
        %ret = OpLabel
               OpReturn
         %sm = OpLabel
               OpBranch %latch
      %latch = OpLabel
         %jn = OpIAdd %uint %j %c1
               OpBranch %hdr
       %exit = OpLabel
               OpStore %po %j
               OpReturn
               OpFunctionEnd
