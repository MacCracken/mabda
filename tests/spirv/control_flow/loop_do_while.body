; Do-while: the exit test is the conditional back-edge, with a phi copy on it. 4.3.1: hung.
; want: max(1, i & 3)
          %n = OpBitwiseAnd %uint %av %c3
               OpBranch %hdr
        %hdr = OpLabel
          %j = OpPhi %uint %c0 %entry %jn %hdr2
               OpLoopMerge %exit %hdr2 None
               OpBranch %body
       %body = OpLabel
         %jn = OpIAdd %uint %j %c1
               OpBranch %hdr2
       %hdr2 = OpLabel
         %lc = OpULessThan %bool %jn %n
               OpBranchConditional %lc %hdr %exit
       %exit = OpLabel
               OpStore %po %jn
               OpReturn
               OpFunctionEnd
