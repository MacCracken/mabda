; A continue from inside a divergent if: an if/else that merges at the latch.
; want: 4
               OpBranch %hdr
        %hdr = OpLabel
          %j = OpPhi %uint %c0 %entry %jn %latch
         %lc = OpULessThan %bool %j %c4
               OpLoopMerge %exit %latch None
               OpBranchConditional %lc %body %exit
       %body = OpLabel
         %od = OpULessThan %bool %av %c32
               OpSelectionMerge %im None
               OpBranchConditional %od %ithen %im
      %ithen = OpLabel
               OpBranch %latch
         %im = OpLabel
               OpBranch %latch
      %latch = OpLabel
         %jn = OpIAdd %uint %j %c1
               OpBranch %hdr
       %exit = OpLabel
               OpStore %po %j
               OpReturn
               OpFunctionEnd
