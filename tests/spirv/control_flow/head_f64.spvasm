; The f64 variant of head.spvasm (Float64 + three f64 constants), for kernels marked
; `; head: f64`. Shared header for the v4.4.0 control-flow kernels (scripts/gen-spirv-cf-fixtures.py appends
; each *.body to it). Binding 0 = a[64], seeded a[i] = i by the tests; binding 1 = o[64], seeded
; 0xDEADBEEF; LocalSize 64, one workgroup, so %w (WorkgroupId.x) is 0 and uniform.
; %x = LocalInvocationId.x, %av = a[x] (= x, divergent), %po = &o[x].
               OpCapability Shader
               OpCapability Float64
               OpMemoryModel Logical GLSL450
               OpEntryPoint GLCompute %main "main" %lid %wg
               OpExecutionMode %main LocalSize 64 1 1
               OpDecorate %lid BuiltIn LocalInvocationId
               OpDecorate %wg BuiltIn WorkgroupId
               OpDecorate %arr ArrayStride 4
               OpMemberDecorate %S 0 Offset 0
               OpDecorate %S Block
               OpDecorate %a DescriptorSet 0
               OpDecorate %a Binding 0
               OpDecorate %o DescriptorSet 0
               OpDecorate %o Binding 1
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
       %uint = OpTypeInt 32 0
        %v3u = OpTypeVector %uint 3
        %pin = OpTypePointer Input %v3u
       %bool = OpTypeBool
        %f64 = OpTypeFloat 64
         %d0 = OpConstant %f64 0
        %d15 = OpConstant %f64 1.5
         %d2 = OpConstant %f64 2
        %arr = OpTypeRuntimeArray %uint
          %S = OpTypeStruct %arr
         %pS = OpTypePointer StorageBuffer %S
         %pU = OpTypePointer StorageBuffer %uint
         %c0 = OpConstant %uint 0
         %c1 = OpConstant %uint 1
         %c2 = OpConstant %uint 2
         %c4 = OpConstant %uint 4
         %c8 = OpConstant %uint 8
        %c16 = OpConstant %uint 16
        %c32 = OpConstant %uint 32
        %c48 = OpConstant %uint 48
       %c111 = OpConstant %uint 111
       %c222 = OpConstant %uint 222
       %c333 = OpConstant %uint 333
       %c444 = OpConstant %uint 444
      %c1000 = OpConstant %uint 1000
      %c2000 = OpConstant %uint 2000
         %c3 = OpConstant %uint 3
         %c5 = OpConstant %uint 5
         %c6 = OpConstant %uint 6
         %c7 = OpConstant %uint 7
         %c9 = OpConstant %uint 9
        %c64 = OpConstant %uint 64
        %lid = OpVariable %pin Input
         %wg = OpVariable %pin Input
          %a = OpVariable %pS StorageBuffer
          %o = OpVariable %pS StorageBuffer
       %main = OpFunction %void None %fn
      %entry = OpLabel
         %lv = OpLoad %v3u %lid
          %x = OpCompositeExtract %uint %lv 0
         %wv = OpLoad %v3u %wg
         %w = OpCompositeExtract %uint %wv 0
         %pa = OpAccessChain %pU %a %c0 %x
         %av = OpLoad %uint %pa
         %po = OpAccessChain %pU %o %c0 %x
