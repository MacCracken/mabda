; A long dependent integer chain: 4096 iterations (64 * 64, computed) of four acc = acc * 5 + 7
; steps (a full-period LCG mod 2^32) seeded with the lane's a[i], with two phis carried around
; the loop. Arithmetic-bound by design: bench-nvidia-compute times it (the v2 scheduling
; measurement), and every gate checks its lanes.
; want: lcg(i, 4 * 4096)
          %n = OpIMul %uint %c64 %c64
               OpBranch %hdr
        %hdr = OpLabel
          %j = OpPhi %uint %c0 %entry %jn %body
        %acc = OpPhi %uint %av %entry %a4 %body
         %lc = OpULessThan %bool %j %n
               OpLoopMerge %exit %body None
               OpBranchConditional %lc %body %exit
       %body = OpLabel
         %m1 = OpIMul %uint %acc %c5
         %a1 = OpIAdd %uint %m1 %c7
         %m2 = OpIMul %uint %a1 %c5
         %a2 = OpIAdd %uint %m2 %c7
         %m3 = OpIMul %uint %a2 %c5
         %a3 = OpIAdd %uint %m3 %c7
         %m4 = OpIMul %uint %a3 %c5
         %a4 = OpIAdd %uint %m4 %c7
         %jn = OpIAdd %uint %j %c1
               OpBranch %hdr
       %exit = OpLabel
               OpStore %po %acc
               OpReturn
               OpFunctionEnd
