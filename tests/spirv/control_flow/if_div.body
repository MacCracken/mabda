; Divergent if, compare adjacent to the branch.
; want: 111 if i < 32 else D
          %c = OpULessThan %bool %av %c32
               OpSelectionMerge %m None
               OpBranchConditional %c %t %m
          %t = OpLabel
               OpStore %po %c111
               OpBranch %m
          %m = OpLabel
               OpReturn
               OpFunctionEnd
