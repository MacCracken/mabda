; A divergent loop inside a divergent if.
; want: (i & 3) if i < 32 else D
          %n = OpBitwiseAnd %uint %av %c3
          %c = OpULessThan %bool %av %c32
               OpSelectionMerge %m None
               OpBranchConditional %c %t %m
          %t = OpLabel
               OpBranch %hdr
        %hdr = OpLabel
          %j = OpPhi %uint %c0 %t %jn %body
         %lc = OpULessThan %bool %j %n
               OpLoopMerge %exit %body None
               OpBranchConditional %lc %body %exit
       %body = OpLabel
         %jn = OpIAdd %uint %j %c1
               OpBranch %hdr
       %exit = OpLabel
               OpStore %po %j
               OpBranch %m
          %m = OpLabel
               OpReturn
               OpFunctionEnd
