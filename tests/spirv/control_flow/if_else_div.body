; Divergent if/else. 4.3.1: the else block never ran.
; want: 111 if i < 32 else 222
          %c = OpULessThan %bool %av %c32
               OpSelectionMerge %m None
               OpBranchConditional %c %t %e
          %t = OpLabel
               OpStore %po %c111
               OpBranch %m
          %e = OpLabel
               OpStore %po %c222
               OpBranch %m
          %m = OpLabel
               OpReturn
               OpFunctionEnd
