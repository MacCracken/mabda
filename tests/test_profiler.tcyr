# test_profiler.tcyr — tests for profiler.cyr

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/syscalls.cyr"
include "lib/assert.cyr"

include "src/color.cyr"
include "src/profiler.cyr"

fn test_profiler_new() {
    var p = profiler_new();
    assert(p != 0, "profiler allocated");
    assert_eq(profiler_frame_count(p), 0, "initial frame_count=0");
    return 0;
}

fn test_profiler_frame() {
    var p = profiler_new();
    profiler_begin_frame(p);
    # Small busy wait
    var sum = 0;
    for (var i = 0; i < 10000; i = i + 1) { sum = sum + i; }
    var elapsed = profiler_end_frame(p);

    assert_eq(profiler_frame_count(p), 1, "frame_count=1 after one frame");
    # elapsed should be > 0
    assert(f64_gt(elapsed, F64_0) == 1, "elapsed > 0");
    # cpu_frame_ms should match elapsed
    assert(profiler_cpu_frame_ms(p) == elapsed, "cpu_frame_ms matches");
    return 0;
}

fn test_profiler_ema() {
    var p = profiler_new();
    # Run 10 frames
    for (var i = 0; i < 10; i = i + 1) {
        profiler_begin_frame(p);
        var sum = 0;
        for (var j = 0; j < 1000; j = j + 1) { sum = sum + j; }
        profiler_end_frame(p);
    }
    assert_eq(profiler_frame_count(p), 10, "10 frames counted");
    # avg_frame_ms should be > 0
    assert(f64_gt(profiler_avg_frame_ms(p), F64_0) == 1, "avg > 0");
    # fps should be > 0
    assert(f64_gt(profiler_fps(p), F64_0) == 1, "fps > 0");
    return 0;
}

fn test_profiler_history() {
    var p = profiler_with_alpha_and_history(
        f64_div(f64_from(5), f64_from(100)),
        5  # small history for testing
    );
    # Run 8 frames — should keep only last 5
    for (var i = 0; i < 8; i = i + 1) {
        profiler_begin_frame(p);
        profiler_end_frame(p);
    }
    var history = load64(p + 56);
    assert_eq(vec_len(history), 5, "history capped at 5");
    return 0;
}

fn test_profiler_worst_best() {
    var p = profiler_new();
    # Run some frames
    for (var i = 0; i < 5; i = i + 1) {
        profiler_begin_frame(p);
        var sum = 0;
        for (var j = 0; j < 1000; j = j + 1) { sum = sum + j; }
        profiler_end_frame(p);
    }
    var worst = profiler_worst_frame_ms(p);
    var best = profiler_best_frame_ms(p);
    # worst >= best
    assert(f64_gt(worst, F64_0) == 1, "worst > 0");
    assert(f64_gt(best, F64_0) == 1, "best > 0");
    # worst >= best (or equal if all frames identical)
    var ge = f64_gt(worst, best);
    if (ge != 1) { ge = (worst == best); }
    assert(ge == 1, "worst >= best");
    return 0;
}

fn test_profiler_reset() {
    var p = profiler_new();
    profiler_begin_frame(p);
    profiler_end_frame(p);
    assert_eq(profiler_frame_count(p), 1, "count=1 before reset");
    profiler_reset(p);
    assert_eq(profiler_frame_count(p), 0, "count=0 after reset");
    return 0;
}

fn test_profile_scope() {
    var start = profile_begin();
    var sum = 0;
    for (var i = 0; i < 10000; i = i + 1) { sum = sum + i; }
    var dur = profile_end(start);
    assert(f64_gt(dur, F64_0) == 1, "profile scope duration > 0");
    return 0;
}

fn main() {
    alloc_init();
    color_init();
    test_profiler_new();
    test_profiler_frame();
    test_profiler_ema();
    test_profiler_history();
    test_profiler_worst_best();
    test_profiler_reset();
    test_profile_scope();
    return assert_summary();
}
var exit_code = main();
syscall(60, exit_code);
