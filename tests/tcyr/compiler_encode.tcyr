# tests/tcyr/compiler_encode.tcyr — Phase N SPIR-V->GFX9 compiler:
# gfx9_encode oracle (N.0) + spirv_parse front end (N.1).
# Fixtures + include chain live in compiler_common.cyr (shared across the compiler_*.tcyr).
include "tests/tcyr/compiler_common.cyr"

# ================================================================
# Operand-encoding helpers
# ================================================================
fn test_gfx9_operand_helpers() {
    assert_eq(gfx9_vgpr(0), 256, "VGPR0 = 256");
    assert_eq(gfx9_vgpr(4), 260, "VGPR4 = 260");
    assert_eq(gfx9_vgpr(11), 267, "VGPR11 = 267");
    assert_eq(gfx9_sgpr(0), 0, "SGPR0 = 0");
    assert_eq(gfx9_sgpr(12), 12, "SGPR12 = 12");
    # inline-constant table: 0->128, 1..64->129..192, -1..-16->193..208
    assert_eq(gfx9_inline_int(0), 128, "inline 0 = 128");
    assert_eq(gfx9_inline_int(1), 129, "inline 1 = 129");
    assert_eq(gfx9_inline_int(2), 130, "inline 2 = 130");
    assert_eq(gfx9_inline_int(4), 132, "inline 4 = 132");
    assert_eq(gfx9_inline_int(8), 136, "inline 8 = 136");
    assert_eq(gfx9_inline_int(16), 144, "inline 16 = 144");
    assert_eq(gfx9_inline_int(24), 152, "inline 24 = 152");
    assert_eq(gfx9_inline_int(64), 192, "inline 64 = 192");
    assert_eq(gfx9_inline_int(0 - 1), 193, "inline -1 = 193");
    assert_eq(gfx9_inline_int(0 - 16), 208, "inline -16 = 208");
    # out of inline range -> literal sentinel 255
    assert_eq(gfx9_inline_int(65), 255, "inline 65 OOR -> literal");
    assert_eq(gfx9_inline_int(0 - 17), 255, "inline -17 OOR -> literal");
    return 0;
}

# ================================================================
# VOP1 — every hand-authored v_mov / v_cvt dword
# ================================================================
fn test_gfx9_enc_vop1() {
    # store_deadbeef: v_mov_b32 v{0,1} from s{0,1}, v2 from literal
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 0, gfx9_sgpr(0)), 0x7E000200, "v_mov v0,s0");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 1, gfx9_sgpr(1)), 0x7E020201, "v_mov v1,s1");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 2, GFX9_SRC_LITERAL), 0x7E0402FF, "v_mov v2,lit");
    # downsample: v_mov from the address SGPRs
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 0, gfx9_sgpr(12)), 0x7E00020C, "v_mov v0,s12");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 1, gfx9_sgpr(13)), 0x7E02020D, "v_mov v1,s13");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 2, gfx9_sgpr(14)), 0x7E04020E, "v_mov v2,s14");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 3, gfx9_sgpr(15)), 0x7E06020F, "v_mov v3,s15");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 0, gfx9_sgpr(18)), 0x7E000212, "v_mov v0,s18");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 1, gfx9_sgpr(19)), 0x7E020213, "v_mov v1,s19");
    # solid_red FS / VS tail: v_mov from inline f32 0.0 / 1.0
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 0, GFX9_INLINE_F32_1_0), 0x7E0002F2, "v_mov v0,1.0");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 1, GFX9_INLINE_F32_0_0), 0x7E020280, "v_mov v1,0.0");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 2, GFX9_INLINE_F32_0_0), 0x7E040280, "v_mov v2,0.0");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 3, GFX9_INLINE_F32_1_0), 0x7E0602F2, "v_mov v3,1.0");
    # VS: v_cvt_f32_i32 from VGPRs
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_F32_I32, 0, gfx9_vgpr(0)), 0x7E000B00, "v_cvt_f32_i32 v0,v0");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_F32_I32, 1, gfx9_vgpr(2)), 0x7E020B02, "v_cvt_f32_i32 v1,v2");
    # textured FS: v_cvt_i32_f32 from VGPRs
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_I32_F32, 4, gfx9_vgpr(2)), 0x7E081102, "v_cvt_i32_f32 v4,v2");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_I32_F32, 5, gfx9_vgpr(3)), 0x7E0A1103, "v_cvt_i32_f32 v5,v3");
    return 0;
}

# ================================================================
# VOP2 — every hand-authored two-source vector-ALU dword
# ================================================================
fn test_gfx9_enc_vop2() {
    # VS: lshlrev / and / add_u32 with inline constants
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHLREV_B32, 2, gfx9_inline_int(1), 0), 0x24040081, "v_lshlrev v2,1,v0");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHLREV_B32, 0, gfx9_inline_int(2), 0), 0x24000082, "v_lshlrev v0,2,v0");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_AND_B32, 0, gfx9_inline_int(4), 0), 0x26000084, "v_and v0,4,v0");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_AND_B32, 2, gfx9_inline_int(4), 2), 0x26040484, "v_and v2,4,v2");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_ADD_U32, 0, gfx9_inline_int(0 - 1), 0), 0x680000C1, "v_add_u32 v0,-1,v0");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_ADD_U32, 2, gfx9_inline_int(0 - 1), 2), 0x680404C1, "v_add_u32 v2,-1,v2");
    # downsample: and with a 0xff literal, lshrrev/lshlrev, add_u32 across VGPRs
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_AND_B32, 8, GFX9_SRC_LITERAL, 4), 0x261008FF, "v_and v8,lit,v4");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_AND_B32, 9, GFX9_SRC_LITERAL, 5), 0x26120AFF, "v_and v9,lit,v5");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_AND_B32, 10, GFX9_SRC_LITERAL, 6), 0x26140CFF, "v_and v10,lit,v6");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_AND_B32, 11, GFX9_SRC_LITERAL, 7), 0x26160EFF, "v_and v11,lit,v7");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_ADD_U32, 8, gfx9_vgpr(8), 11), 0x68101708, "v_add_u32 v8,v8,v11");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 8, gfx9_inline_int(2), 8), 0x20101082, "v_lshrrev v8,2,v8");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_ADD_U32, 9, gfx9_vgpr(9), 12), 0x68121909, "v_add_u32 v9,v9,v12");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 9, gfx9_inline_int(2), 9), 0x20121282, "v_lshrrev v9,2,v9");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHLREV_B32, 9, gfx9_inline_int(8), 9), 0x24121288, "v_lshlrev v9,8,v9");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_ADD_U32, 10, gfx9_vgpr(10), 13), 0x68141B0A, "v_add_u32 v10,v10,v13");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 10, gfx9_inline_int(2), 10), 0x20141482, "v_lshrrev v10,2,v10");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHLREV_B32, 10, gfx9_inline_int(16), 10), 0x24141490, "v_lshlrev v10,16,v10");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 11, gfx9_inline_int(24), 4), 0x20160898, "v_lshrrev v11,24,v4");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 12, gfx9_inline_int(24), 5), 0x20180A98, "v_lshrrev v12,24,v5");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 13, gfx9_inline_int(24), 6), 0x201A0C98, "v_lshrrev v13,24,v6");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 14, gfx9_inline_int(24), 7), 0x201C0E98, "v_lshrrev v14,24,v7");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_ADD_U32, 11, gfx9_vgpr(11), 14), 0x68161D0B, "v_add_u32 v11,v11,v14");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 11, gfx9_inline_int(2), 11), 0x20161682, "v_lshrrev v11,2,v11");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHLREV_B32, 11, gfx9_inline_int(24), 11), 0x24161698, "v_lshlrev v11,24,v11");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_OR_B32, 8, gfx9_vgpr(8), 11), 0x28101708, "v_or_b32 v8,v8,v11");
    # textured FS: v_mul_f32 with a scalar src0 (the per-draw scale SGPR)
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_MUL_F32, 2, gfx9_sgpr(12), 2), 0x0A04040C, "v_mul_f32 v2,s12,v2");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_MUL_F32, 3, gfx9_sgpr(13), 3), 0x0A06060D, "v_mul_f32 v3,s13,v3");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_MUL_F32, 4, gfx9_sgpr(12), 2), 0x0A08040C, "v_mul_f32 v4,s12,v2");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_MUL_F32, 5, gfx9_sgpr(13), 3), 0x0A0A060D, "v_mul_f32 v5,s13,v3");
    return 0;
}

# ================================================================
# VOP3a — every hand-authored three-source dword (two dwords each)
# ================================================================
fn test_gfx9_enc_vop3a() {
    var add3 = GFX9_VOP3_V_ADD3_U32;
    var bfe = GFX9_VOP3_V_BFE_U32;
    var i8 = gfx9_inline_int(8);
    var i16 = gfx9_inline_int(16);
    # v_add3_u32 chain (downsample averages)
    assert_eq(gfx9_enc_vop3a_lo(add3, 8), 0xD1FF0008, "v_add3 v8 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(8), gfx9_vgpr(9), gfx9_vgpr(10)), 0x042A1308, "v_add3 v8 hi");
    assert_eq(gfx9_enc_vop3a_lo(add3, 9), 0xD1FF0009, "v_add3 v9 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(9), gfx9_vgpr(10), gfx9_vgpr(11)), 0x042E1509, "v_add3 v9 hi");
    assert_eq(gfx9_enc_vop3a_lo(add3, 10), 0xD1FF000A, "v_add3 v10 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(10), gfx9_vgpr(11), gfx9_vgpr(12)), 0x0432170A, "v_add3 v10 hi");
    assert_eq(gfx9_enc_vop3a_lo(add3, 11), 0xD1FF000B, "v_add3 v11 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(11), gfx9_vgpr(12), gfx9_vgpr(13)), 0x0436190B, "v_add3 v11 hi");
    # v_bfe_u32 (byte extraction): offset 8 / width 8 (green channel)
    assert_eq(gfx9_enc_vop3a_lo(bfe, 9), 0xD1C80009, "v_bfe v9 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(4), i8, i8), 0x02211104, "v_bfe v9,v4,8,8 hi");
    assert_eq(gfx9_enc_vop3a_lo(bfe, 10), 0xD1C8000A, "v_bfe v10 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(5), i8, i8), 0x02211105, "v_bfe v10,v5,8,8 hi");
    assert_eq(gfx9_enc_vop3a_lo(bfe, 11), 0xD1C8000B, "v_bfe v11 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(6), i8, i8), 0x02211106, "v_bfe v11,v6,8,8 hi");
    assert_eq(gfx9_enc_vop3a_lo(bfe, 12), 0xD1C8000C, "v_bfe v12 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(7), i8, i8), 0x02211107, "v_bfe v12,v7,8,8 hi");
    # v_bfe_u32: offset 16 / width 8 (blue channel)
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(4), i16, i8), 0x02212104, "v_bfe v?,v4,16,8 hi");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(5), i16, i8), 0x02212105, "v_bfe v?,v5,16,8 hi");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(6), i16, i8), 0x02212106, "v_bfe v?,v6,16,8 hi");
    assert_eq(gfx9_enc_vop3a_lo(bfe, 13), 0xD1C8000D, "v_bfe v13 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(7), i16, i8), 0x02212107, "v_bfe v13,v7,16,8 hi");
    # v_or3_b32 (pack RGBA)
    assert_eq(gfx9_enc_vop3a_lo(GFX9_VOP3_V_OR3_B32, 8), 0xD2020008, "v_or3 v8 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(8), gfx9_vgpr(9), gfx9_vgpr(10)), 0x042A1308, "v_or3 v8 hi");
    return 0;
}

# ================================================================
# SOP2 — every hand-authored scalar two-source dword (downsample addr math)
# ================================================================
fn test_gfx9_enc_sop2() {
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_MUL_I32, 8, gfx9_sgpr(7), gfx9_sgpr(4)), 0x92080407, "s_mul_i32 s8,s7,s4");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_LSHL_B32, 9, gfx9_sgpr(8), gfx9_inline_int(4)), 0x8E098408, "s_lshl s9,s8,4");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_LSHL_B32, 10, gfx9_sgpr(6), gfx9_inline_int(3)), 0x8E0A8306, "s_lshl s10,s6,3");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADD_I32, 9, gfx9_sgpr(9), gfx9_sgpr(10)), 0x81090A09, "s_add_i32 s9,s9,s10");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADD_U32, 12, gfx9_sgpr(0), gfx9_sgpr(9)), 0x800C0900, "s_add_u32 s12,s0,s9");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADDC_U32, 13, gfx9_sgpr(1), gfx9_inline_int(0)), 0x820D8001, "s_addc s13,s1,0");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_LSHL_B32, 11, gfx9_sgpr(4), gfx9_inline_int(3)), 0x8E0B8304, "s_lshl s11,s4,3");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADD_U32, 14, gfx9_sgpr(12), gfx9_sgpr(11)), 0x800E0B0C, "s_add s14,s12,s11");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADDC_U32, 15, gfx9_sgpr(13), gfx9_inline_int(0)), 0x820F800D, "s_addc s15,s13");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_LSHL_B32, 16, gfx9_sgpr(8), gfx9_inline_int(2)), 0x8E108208, "s_lshl s16,s8,2");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_LSHL_B32, 17, gfx9_sgpr(6), gfx9_inline_int(2)), 0x8E118206, "s_lshl s17,s6,2");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADD_I32, 16, gfx9_sgpr(16), gfx9_sgpr(17)), 0x81101110, "s_add_i32 s16,s16");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADD_U32, 18, gfx9_sgpr(2), gfx9_sgpr(16)), 0x80121002, "s_add_u32 s18,s2,s16");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADDC_U32, 19, gfx9_sgpr(3), gfx9_inline_int(0)), 0x82138003, "s_addc s19,s3,0");
    return 0;
}

# ================================================================
# SOPP — s_endpgm / s_nop / s_waitcnt (all variants the shaders use)
# ================================================================
fn test_gfx9_enc_sopp() {
    assert_eq(gfx9_enc_sopp(GFX9_SOPP_S_ENDPGM, 0), 0xBF810000, "s_endpgm");
    assert_eq(gfx9_enc_sopp(GFX9_SOPP_S_NOP, 0), 0xBF800000, "s_nop 0");
    assert_eq(gfx9_enc_sopp(GFX9_SOPP_S_WAITCNT, 0x0070), 0xBF8C0070, "s_waitcnt vm(0) lgkm(0)");
    assert_eq(gfx9_enc_sopp(GFX9_SOPP_S_WAITCNT, 0x0F70), 0xBF8C0F70, "s_waitcnt vmcnt(0)");
    assert_eq(gfx9_enc_sopp(GFX9_SOPP_S_WAITCNT, 0xC07F), 0xBF8CC07F, "s_waitcnt lgkmcnt(0)");
    return 0;
}

# N.7 — control-flow encoders (SOPP branches + SOPC compares + EXEC-mask ops). All
# bytes are llvm-mc gfx900-verified (-show-encoding). SCC-predicated s_cbranch is the
# uniform path; the EXEC ops are the divergent path.
fn test_gfx9_enc_control_flow() {
    # SOPP branches (simm16 = 5, a PC-relative dword offset).
    assert_eq(gfx9_enc_sopp(GFX9_SOPP_S_BRANCH, 5), 0xBF820005, "s_branch 5");
    assert_eq(gfx9_enc_sopp(GFX9_SOPP_S_CBRANCH_SCC0, 5), 0xBF840005, "s_cbranch_scc0 5");
    assert_eq(gfx9_enc_sopp(GFX9_SOPP_S_CBRANCH_SCC1, 5), 0xBF850005, "s_cbranch_scc1 5");
    assert_eq(gfx9_enc_sopp(GFX9_SOPP_S_CBRANCH_EXECZ, 5), 0xBF880005, "s_cbranch_execz 5");
    assert_eq(gfx9_enc_sopp(GFX9_SOPP_S_CBRANCH_EXECNZ, 5), 0xBF890005, "s_cbranch_execnz 5");
    # SOPC scalar compares (s2, s3) → SCC.
    assert_eq(gfx9_enc_sopc(GFX9_SOPC_S_CMP_EQ_U32, 2, 3), 0xBF060302, "s_cmp_eq_u32 s2,s3");
    assert_eq(gfx9_enc_sopc(GFX9_SOPC_S_CMP_LG_U32, 2, 3), 0xBF070302, "s_cmp_lg_u32 s2,s3");
    assert_eq(gfx9_enc_sopc(GFX9_SOPC_S_CMP_GT_U32, 2, 3), 0xBF080302, "s_cmp_gt_u32 s2,s3");
    assert_eq(gfx9_enc_sopc(GFX9_SOPC_S_CMP_LT_U32, 2, 3), 0xBF0A0302, "s_cmp_lt_u32 s2,s3");
    # s2 vs inline constant 0 (operand code 128).
    assert_eq(gfx9_enc_sopc(GFX9_SOPC_S_CMP_EQ_U32, 2, 128), 0xBF068002, "s_cmp_eq_u32 s2,0");
    # EXEC-mask ops (divergent): save/and/restore.
    var ex = GFX9_REG_EXEC_LO;
    assert_eq(gfx9_enc_sop1(GFX9_SOP1_S_AND_SAVEEXEC_B64, 4, 6), 0xBE842006, "s_and_saveexec_b64");
    assert_eq(gfx9_enc_sop1(GFX9_SOP1_S_MOV_B64, 4, ex), 0xBE84017E, "s_mov_b64 s[4:5],exec");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ANDN2_B64, ex, ex, 4), 0x89FE047E, "s_andn2_b64 exec,exec,s4");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_OR_B64, ex, ex, 4), 0x87FE047E, "s_or_b64 exec,exec,s4");
    return 0;
}

# N.7c — VOPC v_cmp encoders → VCC (the divergent-branch predicate). src0 = v1
# (9-bit code 256+1), vsrc1 = v2 (raw index 2); the inline-const form puts 8 in src0
# (code 136). All bytes llvm-mc gfx900-verified.
fn test_gfx9_enc_vopc() {
    var v1 = gfx9_vgpr(1);
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_LT_U32, v1, 2), 0x7D920501, "v_cmp_lt_u32 vcc,v1,v2");
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_EQ_U32, v1, 2), 0x7D940501, "v_cmp_eq_u32 vcc,v1,v2");
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_LE_U32, v1, 2), 0x7D960501, "v_cmp_le_u32 vcc,v1,v2");
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_GT_U32, v1, 2), 0x7D980501, "v_cmp_gt_u32 vcc,v1,v2");
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_NE_U32, v1, 2), 0x7D9A0501, "v_cmp_ne_u32 vcc,v1,v2");
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_GE_U32, v1, 2), 0x7D9C0501, "v_cmp_ge_u32 vcc,v1,v2");
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_LT_U32, gfx9_inline_int(8), 2), 0x7D920488, "v_cmp_lt_u32 vcc,8,v2");
    return 0;
}

# N.8b-3 — the f32 inline-operand codes (no literal dword): ±0.5/1/2/4 → 240..247.
# Anything else (0.25, 3.7, ...) resolves to a literal.
fn test_gfx9_inline_float() {
    assert_eq(gfx9_inline_float(0x3F000000), 240, "0.5");
    assert_eq(gfx9_inline_float(0xBF000000), 241, "-0.5");
    assert_eq(gfx9_inline_float(0x3F800000), 242, "1.0");
    assert_eq(gfx9_inline_float(0xBF800000), 243, "-1.0");
    assert_eq(gfx9_inline_float(0x40000000), 244, "2.0");
    assert_eq(gfx9_inline_float(0xC0000000), 245, "-2.0");
    assert_eq(gfx9_inline_float(0x40800000), 246, "4.0");
    assert_eq(gfx9_inline_float(0xC0800000), 247, "-4.0");
    assert_eq(gfx9_inline_float(0x3E800000), GFX9_SRC_LITERAL, "0.25 → literal (not inline)");
    assert_eq(gfx9_inline_float(0x40490FDB), GFX9_SRC_LITERAL, "pi → literal");
    return 0;
}

# N.8b-4 — signed i32 compare encoders (VOPC → VCC, SOPC → SCC) + v_med3_f32 (FClamp).
# All bytes llvm-mc gfx900-verified.
fn test_gfx9_enc_signed_cmp() {
    var v1 = gfx9_vgpr(1);
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_LT_I32, v1, 2), 0x7D820501, "v_cmp_lt_i32 vcc,v1,v2");
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_LE_I32, v1, 2), 0x7D860501, "v_cmp_le_i32 vcc,v1,v2");
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_GT_I32, v1, 2), 0x7D880501, "v_cmp_gt_i32 vcc,v1,v2");
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_GE_I32, v1, 2), 0x7D8C0501, "v_cmp_ge_i32 vcc,v1,v2");
    assert_eq(gfx9_enc_sopc(GFX9_SOPC_S_CMP_LT_I32, 2, 3), 0xBF040302, "s_cmp_lt_i32 s2,s3");
    assert_eq(gfx9_enc_sopc(GFX9_SOPC_S_CMP_GT_I32, 2, 3), 0xBF020302, "s_cmp_gt_i32 s2,s3");
    assert_eq(gfx9_enc_sopc(GFX9_SOPC_S_CMP_LE_I32, 2, 3), 0xBF050302, "s_cmp_le_i32 s2,s3");
    assert_eq(gfx9_enc_sopc(GFX9_SOPC_S_CMP_GE_I32, 2, 3), 0xBF030302, "s_cmp_ge_i32 s2,s3");
    assert_eq(gfx9_enc_vop3a_lo(GFX9_VOP3_V_MED3_F32, 5), 0xD1D60005, "v_med3_f32 v5 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(1), gfx9_vgpr(2), gfx9_vgpr(3)), 0x040E0501, "v_med3 hi v1,v2,v3");
    return 0;
}

# N.9a — the integer-division primitives (the float-reciprocal udiv macro): conversions,
# the iflag reciprocal, mul-hi, cndmask (VCC implicit), and the magic-constant v_mul_f32
# (src0 = literal 0x4F7FFFFE). All bytes llvm-mc gfx900-verified.
fn test_gfx9_enc_div_primitives() {
    var v1 = gfx9_vgpr(1);
    var v3 = gfx9_vgpr(3);
    var v4 = gfx9_vgpr(4);
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_F32_U32, 3, v1), 0x7E060D01, "v_cvt_f32_u32 v3, v1");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_U32_F32, 3, v3), 0x7E060F03, "v_cvt_u32_f32 v3, v3");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_RCP_IFLAG_F32, 3, v3), 0x7E064703, "v_rcp_iflag_f32 v3, v3");
    assert_eq(gfx9_enc_vop3a_lo(GFX9_VOP3_V_MUL_HI_U32, 4), 0xD2860004, "v_mul_hi_u32 v4 lo");
    assert_eq(gfx9_enc_vop3a_hi(v3, v4, 0), 0x00020903, "v_mul_hi_u32 hi (v3, v4)");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_CNDMASK_B32, 3, v3, 5), 0x00060B03, "v_cndmask_b32 v3, v3, v5, vcc");
    # the magic-constant reciprocal scale: v_mul_f32 v3, 0x4F7FFFFE, v3 (literal src0).
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_MUL_F32, 3, GFX9_SRC_LITERAL, 3), 0x0A0606FF, "v_mul_f32 v3, lit, v3");
    return 0;
}

# ================================================================
# SMEM — s_load_dwordx{2,4,8} (textured FS descriptor loads, two dwords)
# ================================================================
fn test_gfx9_enc_smem() {
    # s_load_dwordx8 s[0:7], s[0:1], 0x0
    assert_eq(gfx9_enc_smem_lo(GFX9_SMEM_S_LOAD_DWORDX8, 0, 0, 0), 0xC00E0000, "s_load_dwordx8 lo");
    # s_load_dwordx2 s[12:13], s[0:1], 0x30
    assert_eq(gfx9_enc_smem_lo(GFX9_SMEM_S_LOAD_DWORDX2, 12, 0, 0), 0xC0060300, "s_load_dwordx2 lo");
    # s_load_dwordx4 s[8:11], s[0:1], 0x20
    assert_eq(gfx9_enc_smem_lo(GFX9_SMEM_S_LOAD_DWORDX4, 8, 0, 0), 0xC00A0200, "s_load_dwordx4 lo");
    return 0;
}

# ================================================================
# FLAT (global) — global_load_dwordx2 / global_store_dword (two dwords)
# ================================================================
fn test_gfx9_enc_flat() {
    var st = GFX9_FLAT_GLOBAL_STORE_DWORD;
    var ld2 = GFX9_FLAT_GLOBAL_LOAD_DWORDX2;
    var g = GFX9_FLAT_SEG_GLOBAL;
    var off = GFX9_SADDR_OFF;
    # global_store_dword v[0:1], v2, off glc slc  (store_deadbeef: cache-bypassing)
    assert_eq(gfx9_enc_flat_lo(st, g, 0, 1, 1), 0xDC738000, "global_store glc slc lo");
    assert_eq(gfx9_enc_flat_hi(0, off, 2, 0), 0x007F0200, "global_store v2 hi");
    # global_load_dwordx2 v[4:5], v[0:1], off  (downsample: no glc/slc)
    assert_eq(gfx9_enc_flat_lo(ld2, g, 0, 0, 0), 0xDC548000, "global_load_dwordx2 lo");
    assert_eq(gfx9_enc_flat_hi(4, off, 0, 0), 0x047F0000, "global_load v[4:5] hi");
    assert_eq(gfx9_enc_flat_hi(6, off, 0, 2), 0x067F0002, "global_load v[6:7] from v[2:3] hi");
    # global_store_dword v[0:1], v8, off  (downsample: plain store)
    assert_eq(gfx9_enc_flat_lo(st, g, 0, 0, 0), 0xDC708000, "global_store (plain) lo");
    assert_eq(gfx9_enc_flat_hi(0, off, 8, 0), 0x007F0800, "global_store v8 hi");
    return 0;
}

# ================================================================
# Capstone: rebuild store_deadbeef wholly through the encoders and
# memcmp against the HW-verified hand-authored builder, byte-for-byte.
# Proves the encoders COMPOSE into a real shader's exact byte stream
# (not just per-dword). The full downsample-stream rebuild lands with
# the N.5 encode driver, where stream sequencing is the deliverable.
# ================================================================
fn test_gfx9_rebuild_store_deadbeef_byte_identical() {
    var truth[128];
    var built[128];
    var truth_end = native_gfx9_shader_store_deadbeef(&truth, 0);
    assert_eq(truth_end, 96, "deadbeef is 96 bytes");

    # Rebuild the identical stream from the encoders + raw literal/pad dwords.
    store32(&built +  0, gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 0, gfx9_sgpr(0)));
    store32(&built +  4, gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 1, gfx9_sgpr(1)));
    store32(&built +  8, gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 2, GFX9_SRC_LITERAL));
    store32(&built + 12, 0xDEADBEEF);
    store32(&built + 16, gfx9_enc_flat_lo(GFX9_FLAT_GLOBAL_STORE_DWORD, GFX9_FLAT_SEG_GLOBAL, 0, 1, 1));
    store32(&built + 20, gfx9_enc_flat_hi(0, GFX9_SADDR_OFF, 2, 0));
    store32(&built + 24, gfx9_enc_sopp(GFX9_SOPP_S_WAITCNT, 0x0070));
    store32(&built + 28, gfx9_enc_sopp(GFX9_SOPP_S_ENDPGM, 0));
    var i = 0;
    while (i < 16) {
        store32(&built + 32 + i * 4, gfx9_enc_sopp(GFX9_SOPP_S_NOP, 0));
        i = i + 1;
    }
    assert_eq(memeq(&built, &truth, 96), 1, "rebuilt deadbeef == hand-authored bytes");
    return 0;
}

fn test_spirv_header_accessors() {
    var buf[128];
    var n = _spv_build_min_compute(&buf);
    assert_eq(n, 84, "min compute module is 84 bytes");
    assert_eq(spirv_hdr_magic(&buf), 0x07230203, "magic");
    assert_eq(spirv_hdr_version(&buf), 0x00010300, "version 1.3");
    assert_eq(spirv_hdr_id_bound(&buf), 20, "id bound");
    assert_eq(spirv_hdr_schema(&buf), 0, "schema 0");
    return 0;
}

fn test_spirv_op_decode() {
    # word0 = (wordcount << 16) | opcode
    assert_eq(spirv_op((5 << 16) | 15), 15, "opcode = low 16 bits");
    assert_eq(spirv_op_wordcount((5 << 16) | 15), 5, "wordcount = high 16 bits");
    assert_eq(spirv_op_wordcount((6 << 16) | 16), 6, "wordcount 6");
    assert_eq(spirv_op(0xFFFF0011), 17, "opcode masks to 16 bits");
    return 0;
}

fn test_spirv_validate_stream_valid() {
    var buf[128];
    var n = _spv_build_min_compute(&buf);
    assert_eq(spirv_validate_stream(&buf, n), SPIRV_PARSE_OK, "valid stream accepted");
    return 0;
}

fn test_spirv_validate_stream_rejects() {
    var buf[128];
    var n = _spv_build_min_compute(&buf);
    # bad magic -> _spirv_validate code 3
    store32(&buf + 0, 0xDEADBEEF);
    assert_eq(spirv_validate_stream(&buf, n), 3, "bad magic rejected");
    # too short -> code 1
    _spv_build_min_compute(&buf);
    assert_eq(spirv_validate_stream(&buf, 12), 1, "truncated header rejected");
    # id-bound 0 -> code 5
    _spv_build_min_compute(&buf);
    store32(&buf + 12, 0);
    assert_eq(spirv_validate_stream(&buf, n), 5, "zero id-bound rejected");
    # zero word count -> would loop forever; must be rejected (code 10)
    _spv_build_min_compute(&buf);
    store32(&buf + 20, 17);   # opcode 17, wordcount field = 0
    assert_eq(spirv_validate_stream(&buf, n), SPIRV_PARSE_ERR_ZERO_WC, "zero wordcount rejected");
    # instruction word count overruns the stream -> code 11
    _spv_build_min_compute(&buf);
    store32(&buf + 60, (100 << 16) | 16);   # claims 100 words at the tail
    assert_eq(spirv_validate_stream(&buf, n), SPIRV_PARSE_ERR_TRUNC, "overrun rejected");
    return 0;
}

fn test_spirv_count_instructions() {
    var buf[128];
    var n = _spv_build_min_compute(&buf);
    # cap + memorymodel + entrypoint + executionmode
    assert_eq(spirv_count_instructions(&buf, n), 4, "4 instructions");
    # malformed -> -1
    store32(&buf + 0, 0xDEADBEEF);
    assert_eq(spirv_count_instructions(&buf, n), 0 - 1, "malformed -> -1");
    return 0;
}

fn test_spirv_find_entry_point() {
    var buf[128];
    var n = _spv_build_min_compute(&buf);
    assert_eq(spirv_find_entry_point(&buf, n), 4, "GLCompute entry id = 4");
    # change the execution model away from GLCompute -> not found
    _spv_build_min_compute(&buf);
    store32(&buf + 44, 0);   # Vertex
    assert_eq(spirv_find_entry_point(&buf, n), 0 - 1, "non-GLCompute -> -1");
    return 0;
}

fn test_spirv_find_local_size() {
    var buf[128];
    var n = _spv_build_min_compute(&buf);
    var xyz[24];
    var found = spirv_find_local_size(&buf, n, 4, &xyz);
    assert_eq(found, 1, "LocalSize found");
    assert_eq(load64(&xyz + 0), 64, "local_size_x = 64");
    assert_eq(load64(&xyz + 8), 1, "local_size_y = 1");
    assert_eq(load64(&xyz + 16), 1, "local_size_z = 1");
    # wrong entry id -> not found
    assert_eq(spirv_find_local_size(&buf, n, 99, &xyz), 0, "wrong entry id -> not found");
    return 0;
}

fn test_spirv_type_table() {
    var buf[256];
    var n = _spv_build_typed_module(&buf);
    assert_eq(spirv_validate_stream(&buf, n), 0, "typed module valid");
    var ib = spirv_hdr_id_bound(&buf);
    var types[480];
    assert_eq(spirv_build_type_table(&buf, n, ib, ib, &types), 0, "type table built");
    assert_eq(spirv_type_kind(&types, 6), SPIRV_TYK_INT, "id6 int");
    assert_eq(spirv_type_p0(&types, 6), 32, "int width 32");
    assert_eq(spirv_type_p1(&types, 6), 1, "int signed");
    assert_eq(spirv_type_kind(&types, 7), SPIRV_TYK_FLOAT, "id7 float");
    assert_eq(spirv_type_p0(&types, 7), 32, "float width 32");
    assert_eq(spirv_type_kind(&types, 8), SPIRV_TYK_VECTOR, "id8 vector");
    assert_eq(spirv_type_p0(&types, 8), 7, "vec component = id7");
    assert_eq(spirv_type_p1(&types, 8), 4, "vec count 4");
    assert_eq(spirv_type_kind(&types, 9), SPIRV_TYK_RUNTIME_ARRAY, "id9 runtime array");
    assert_eq(spirv_type_p0(&types, 9), 7, "rtarray element = id7");
    assert_eq(spirv_type_kind(&types, 10), SPIRV_TYK_STRUCT, "id10 struct");
    assert_eq(spirv_type_p0(&types, 10), 1, "struct member count 1");
    assert_eq(spirv_type_p1(&types, 10), 9, "struct member0 = id9");
    assert_eq(spirv_type_kind(&types, 11), SPIRV_TYK_POINTER, "id11 pointer");
    assert_eq(spirv_type_p0(&types, 11), 12, "ptr storage = StorageBuffer");
    assert_eq(spirv_type_p1(&types, 11), 10, "ptr pointee = id10");
    assert_eq(spirv_type_kind(&types, 5), SPIRV_TYK_NONE, "id5 not a type");
    return 0;
}

fn test_spirv_const_table() {
    var buf[256];
    var n = _spv_build_typed_module(&buf);
    var ib = spirv_hdr_id_bound(&buf);
    var consts[320];
    assert_eq(spirv_build_const_table(&buf, n, ib, ib, &consts), 0, "const table built");
    assert_eq(spirv_const_type(&consts, 13), 6, "const13 type = id6");
    assert_eq(spirv_const_value(&consts, 13), 42, "const13 value 42");
    assert_eq(spirv_const_type(&consts, 5), 0, "id5 not a constant");
    return 0;
}

fn test_spirv_decoration_table() {
    var buf[256];
    var n = _spv_build_typed_module(&buf);
    var ib = spirv_hdr_id_bound(&buf);
    var deco[320];
    assert_eq(spirv_build_decoration_table(&buf, n, ib, ib, &deco), 0, "deco table built");
    assert_eq(spirv_deco_binding(&deco, 12), 0, "var12 binding 0");
    assert_eq(spirv_deco_set(&deco, 12), 0, "var12 descriptor set 0");
    assert_eq(spirv_deco_binding(&deco, 7), 0 - 1, "id7 has no binding (-1)");
    return 0;
}

# v3.2 F.3 — the f64 shader gate keys on `OpCapability Float64` (cap 10). spirv_uses_f64
# detects it (and is bounded / zero-wordcount-safe on untrusted bytes).
fn test_spirv_uses_f64() {
    var buf[64];
    store32(&buf + 0, 0x07230203);   # magic
    store32(&buf + 12, 8);           # id bound
    # OpCapability Shader (1) at word 5, OpCapability Float64 (10) at word 7 — byte_len 36
    store32(&buf + 20, (2 << 16) | 17); store32(&buf + 24, 1);
    store32(&buf + 28, (2 << 16) | 17); store32(&buf + 32, 10);
    assert_eq(spirv_uses_f64(&buf, 36), 1, "OpCapability Float64 detected");
    store32(&buf + 32, 1);   # second capability -> Shader, no Float64
    assert_eq(spirv_uses_f64(&buf, 36), 0, "no Float64 capability -> 0");
    # a header-only / too-small module has no capabilities -> 0 (and does not loop)
    assert_eq(spirv_uses_f64(&buf, 20), 0, "header-only module -> 0");
    # review F.3: a truncated OpCapability at the stream end (header fits, operand word does not)
    # must return 0 WITHOUT an out-of-bounds operand read (this runs on untrusted bytes).
    var b2[64];
    store32(&b2 + 0, 0x07230203); store32(&b2 + 12, 8);
    store32(&b2 + 20, (2 << 16) | 17);   # OpCapability (wc 2) at word 5; stream ends at word 6
    assert_eq(spirv_uses_f64(&b2, 24), 0, "truncated OpCapability at end -> 0 (no OOB read)");
    # a non-multiple-of-4 byte_len is bounded (no read past total*4 = byte_len floor)
    assert_eq(spirv_uses_f64(&b2, 23), 0, "odd byte_len -> 0 (bounded)");
    return 0;
}

# v3.2 F.4 — the f64 GFX9 ISA encode oracle (llvm-mc gfx900-verified bytes the hand-authored
# native_gfx9_shader_fma_f64 emits through the existing encoders): v_fma_f64 + the dwordx2 FLAT.
fn test_gfx9_enc_f64() {
    # v_fma_f64 v[8:9], v[2:3], v[4:5], v[6:7]  ->  D1CC0008 041A0902
    assert_eq(gfx9_enc_vop3a_lo(GFX9_VOP3_V_FMA_F64, 8), 0xD1CC0008, "v_fma_f64 v[8:9] lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(2), gfx9_vgpr(4), gfx9_vgpr(6)), 0x041A0902,
    "v_fma_f64 v[2:3],v[4:5],v[6:7] hi");
    # global_load_dwordx2 / global_store_dwordx2 (saddr form) lo dwords
    assert_eq(gfx9_enc_flat_lo(GFX9_FLAT_GLOBAL_LOAD_DWORDX2, GFX9_FLAT_SEG_GLOBAL, 0, 0, 0),
    0xDC548000, "global_load_dwordx2 lo");
    assert_eq(gfx9_enc_flat_lo(GFX9_FLAT_GLOBAL_STORE_DWORDX2, GFX9_FLAT_SEG_GLOBAL, 0, 0, 0),
    0xDC748000, "global_store_dwordx2 lo");
    return 0;
}

# v3.2 F.7b — f64 ALU encoders byte-oracle. Each expected dword is the llvm-mc gfx900 encoding
# (e.g. `v_add_f64 v[0:1], v[2:3], v[4:5]` -> D2800000 00020902). f64 operands name the EVEN
# reg of the pair: gfx9_vgpr(2) = v[2:3], gfx9_vgpr(4) = v[4:5].
fn test_gfx9_enc_f64_alu() {
    # VOP3 2-src arith: lo = D0000000|(op<<16)|vdst ; hi = src1<<9 | src0 (no src2)
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(2), gfx9_vgpr(4), 0), 0x00020902, "v[2:3],v[4:5] 2-src hi");
    assert_eq(gfx9_enc_vop3a_lo(GFX9_VOP3_V_ADD_F64, 0), 0xD2800000, "v_add_f64 v[0:1] lo");
    assert_eq(gfx9_enc_vop3a_lo(GFX9_VOP3_V_MUL_F64, 0), 0xD2810000, "v_mul_f64 v[0:1] lo");
    assert_eq(gfx9_enc_vop3a_lo(GFX9_VOP3_V_MIN_F64, 0), 0xD2820000, "v_min_f64 v[0:1] lo");
    assert_eq(gfx9_enc_vop3a_lo(GFX9_VOP3_V_MAX_F64, 0), 0xD2830000, "v_max_f64 v[0:1] lo");
    # VOP1 conversions: 7E000000 | (vdst<<17) | (op<<9) | src0 ; src0 = v[2:3]/v2 = gfx9_vgpr(2)
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_F64_F32, 0, gfx9_vgpr(2)), 0x7E002102, "v_cvt_f64_f32 v[0:1],v2");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_F32_F64, 0, gfx9_vgpr(2)), 0x7E001F02, "v_cvt_f32_f64 v0,v[2:3]");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_F64_I32, 0, gfx9_vgpr(2)), 0x7E000902, "v_cvt_f64_i32 v[0:1],v2");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_I32_F64, 0, gfx9_vgpr(2)), 0x7E000702, "v_cvt_i32_f64 v0,v[2:3]");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_F64_U32, 0, gfx9_vgpr(2)), 0x7E002D02, "v_cvt_f64_u32 v[0:1],v2");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_U32_F64, 0, gfx9_vgpr(2)), 0x7E002B02, "v_cvt_u32_f64 v0,v[2:3]");
    # v3.2 F.7f.3 — source-modifier bits (llvm-mc-verified). FSub = v_add_f64 with NEG src1 (hi bit
    # 30): `v_add_f64 v[0:1], v[2:3], -v[4:5]` -> D2800000 40020902. FAbs = v_max_f64 with ABS src0+
    # src1 (lo bits 8,9), operands x,x: `v_max_f64 v[0:1], |v[2:3]|, |v[2:3]|` -> D2830300 00020502.
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(2), gfx9_vgpr(4), 0) | 0x40000000, 0x40020902, "v_add_f64 -src1 (fsub) hi");
    assert_eq(gfx9_enc_vop3a_lo(GFX9_VOP3_V_MAX_F64, 0) | 0x300, 0xD2830300, "v_max_f64 |abs| (fabs) lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(2), gfx9_vgpr(2), 0), 0x00020502, "v_max_f64 x,x (fabs) hi");
    return 0;
}

# v3.2 F.7f.6 — f64 division macro encoders byte-oracle. The dwords are the llvm-mc gfx900
# encoding of the LLVM fdiv expansion: v_div_scale_f64 is VOP3B (a second SGPR-pair output
# s[4:5] in lo[14:8]); v_rcp_f64 is the VOP1 reciprocal seed; v_div_fmas/_fixup are plain VOP3.
fn test_gfx9_enc_f64_div() {
    # v_rcp_f64_e32 v[6:7], v[4:5]  ->  7E0C4B04 (VOP1 seed)
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_RCP_F64, 6, gfx9_vgpr(4)), 0x7E0C4B04, "v_rcp_f64 v[6:7],v[4:5]");
    # v_div_scale_f64 v[4:5], s[4:5], v[2:3], v[2:3], v[0:1]  ->  D1E10404 04020502 (VOP3B, sdst=4)
    assert_eq(gfx9_enc_vop3b_lo(GFX9_VOP3_V_DIV_SCALE_F64, 4, 4), 0xD1E10404, "v_div_scale_f64 lo (vop3b sdst)");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(2), gfx9_vgpr(2), gfx9_vgpr(0)), 0x04020502, "v_div_scale_f64 hi");
    # v_div_fmas_f64 v[4:5], v[4:5], v[6:7], v[10:11]  ->  D1E30004 042A0D04 (reads VCC)
    assert_eq(gfx9_enc_vop3a_lo(GFX9_VOP3_V_DIV_FMAS_F64, 4), 0xD1E30004, "v_div_fmas_f64 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(4), gfx9_vgpr(6), gfx9_vgpr(10)), 0x042A0D04, "v_div_fmas_f64 hi");
    # v_div_fixup_f64 v[0:1], v[4:5], v[2:3], v[0:1]  ->  D1DF0000 04020504 (rounding fixup)
    assert_eq(gfx9_enc_vop3a_lo(GFX9_VOP3_V_DIV_FIXUP_F64, 0), 0xD1DF0000, "v_div_fixup_f64 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(4), gfx9_vgpr(2), gfx9_vgpr(0)), 0x04020504, "v_div_fixup_f64 hi");
    return 0;
}

# v3.2 F.7f.7 — f64 sqrt macro primitive encoders byte-oracle. The dwords are the llvm-mc gfx900
# encoding of the LLVM sqrt expansion: v_rsq_f64 seed (VOP1), v_ldexp_f64 scale (VOP3 2-src f64,i32),
# and the two VCC-writing VOPC compares (v_cmp_gt_f64 subnormal gate, v_cmp_class_f64 special-case).
fn test_gfx9_enc_f64_sqrt() {
    # v_rsq_f64_e32 v[2:3], v[0:1]  ->  7E044D00 (VOP1 0x26 seed)
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_RSQ_F64, 2, gfx9_vgpr(0)), 0x7E044D00, "v_rsq_f64 v[2:3],v[0:1]");
    # v_ldexp_f64 v[0:1], v[0:1], v2  ->  D2840000 00020500 (VOP3 f64,i32)
    assert_eq(gfx9_enc_vop3a_lo(GFX9_VOP3_V_LDEXP_F64, 0), 0xD2840000, "v_ldexp_f64 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(0), gfx9_vgpr(2), 0), 0x00020500, "v_ldexp_f64 hi (f64 src0, i32 src1)");
    # v_cmp_gt_f64_e32 vcc, s[4:5], v[0:1]  ->  7CC80004 (VOPC 0x64; src0=s4, vsrc1=v0)
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_GT_F64, 4, 0), 0x7CC80004, "v_cmp_gt_f64 vcc,s[4:5],v[0:1]");
    # v_cmp_class_f64_e32 vcc, v[0:1], v5  ->  7C240B00 (VOPC 0x12; src0=v[0:1], vsrc1=v5)
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_CLASS_F64, gfx9_vgpr(0), 5), 0x7C240B00, "v_cmp_class_f64 vcc,v[0:1],v5");
    return 0;
}

# v3.2 F.7f.8 — the ordered f64 VOPC compares (→ VCC) + v_bfi_b32 (the OpSelect blend) byte-oracle,
# llvm-mc gfx900-matched. Compares reuse the VOPC encoder; bfi is VOP3 3-src.
fn test_gfx9_enc_f64_cmp() {
    # v_cmp_lt_f64_e32 vcc, v[0:1], v[2:3]  ->  7CC20500 (VOPC 0x61; src0=v[0:1], vsrc1=v2)
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_LT_F64, gfx9_vgpr(0), 2), 0x7CC20500, "v_cmp_lt_f64");
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_EQ_F64, gfx9_vgpr(0), 2), 0x7CC40500, "v_cmp_eq_f64 (0x62)");
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_LE_F64, gfx9_vgpr(0), 2), 0x7CC60500, "v_cmp_le_f64 (0x63)");
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_LG_F64, gfx9_vgpr(0), 2), 0x7CCA0500, "v_cmp_lg_f64 (0x65)");
    assert_eq(gfx9_enc_vopc(GFX9_VOPC_V_CMP_GE_F64, gfx9_vgpr(0), 2), 0x7CCC0500, "v_cmp_ge_f64 (0x66)");
    # v_bfi_b32 v0, v1, v2, v3  ->  D1CA0000 040E0501 (VOP3 0x1CA)
    assert_eq(gfx9_enc_vop3a_lo(GFX9_VOP3_V_BFI_B32, 0), 0xD1CA0000, "v_bfi_b32 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(1), gfx9_vgpr(2), gfx9_vgpr(3)), 0x040E0501, "v_bfi_b32 hi");
    return 0;
}

fn main(): i64 {
    test_gfx9_operand_helpers();
    test_gfx9_enc_f64_cmp();
    test_gfx9_enc_vop1();
    test_gfx9_enc_vop2();
    test_gfx9_enc_vop3a();
    test_gfx9_enc_sop2();
    test_gfx9_enc_sopp();
    test_gfx9_enc_control_flow();
    test_gfx9_enc_vopc();
    test_gfx9_inline_float();
    test_gfx9_enc_signed_cmp();
    test_gfx9_enc_div_primitives();
    test_gfx9_enc_smem();
    test_gfx9_enc_flat();
    test_gfx9_rebuild_store_deadbeef_byte_identical();
    test_spirv_header_accessors();
    test_spirv_op_decode();
    test_spirv_uses_f64();
    test_gfx9_enc_f64();
    test_gfx9_enc_f64_alu();
    test_gfx9_enc_f64_div();
    test_gfx9_enc_f64_sqrt();
    test_spirv_validate_stream_valid();
    test_spirv_validate_stream_rejects();
    test_spirv_count_instructions();
    test_spirv_find_entry_point();
    test_spirv_find_local_size();
    test_spirv_type_table();
    test_spirv_const_table();
    test_spirv_decoration_table();
    return assert_summary();
}
