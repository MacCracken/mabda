    if (n > 1) { store32(b + i * 4 + 4, w1); }
    if (n > 2) { store32(b + i * 4 + 8, w2); }
    if (n > 3) { store32(b + i * 4 + 12, w3); }
    return 0;
}

fn ktx2sc_payload_byte(seed, level, i): i64 {
    if (((i >> 6) & 1) == 0) { return (i * 7 + level * 31 + seed) & 0xFF; }
