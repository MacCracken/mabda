fn ktx2sc_build(k, b): i64 {
    if (k == 0) { return _ktx2sc_zstd_rgba8_mips(b); }
    if (k == 1) { return _ktx2sc_zlib_rgba8_mips(b); }
    if (k == 2) { return _ktx2sc_zstd_bc7(b); }
    if (k == 3) { return _ktx2sc_zstd_array4(b); }
    if (k == 4) { return _ktx2sc_zlib_cube(b); }
    if (k == 5) { return _ktx2sc_zstd_short(b); }
    if (k == 6) { return _ktx2sc_zlib_long(b); }
    if (k == 7) { return _ktx2sc_zstd_truncated(b); }
    if (k == 8) { return _ktx2sc_zlib_truncated(b); }
    if (k == 9) { return _ktx2sc_zstd_ulen(b); }
    if (k == 10) { return _ktx2sc_basislz(b); }
    return 0;
}

fn ktx2sc_name(k): i64 {
    if (k == 0) { return "zstd_rgba8_mips"; }
    if (k == 1) { return "zlib_rgba8_mips"; }
    if (k == 2) { return "zstd_bc7"; }
    if (k == 3) { return "zstd_array4"; }
    if (k == 4) { return "zlib_cube"; }
    if (k == 5) { return "zstd_short"; }
    if (k == 6) { return "zlib_long"; }
    if (k == 7) { return "zstd_truncated"; }
    if (k == 8) { return "zlib_truncated"; }
    if (k == 9) { return "zstd_ulen"; }
    if (k == 10) { return "basislz"; }
    return 0;
}

fn ktx2sc_seed(k): i64 {
    if (k == 0) { return 11; }
    if (k == 1) { return 12; }
    if (k == 2) { return 13; }
    if (k == 3) { return 14; }
    if (k == 4) { return 15; }
    if (k == 5) { return 16; }
    if (k == 6) { return 17; }
    if (k == 7) { return 18; }
    if (k == 8) { return 19; }
    if (k == 9) { return 20; }
    if (k == 10) { return 21; }
    return 0;
}

# 0 when case k must load, else the GPU_ERR_* the load must fail with.
fn ktx2sc_expect(k): i64 {
    if (k == 0) { return 0; }
    if (k == 1) { return 0; }
    if (k == 2) { return 0; }
    if (k == 3) { return 0; }
    if (k == 4) { return 0; }
    if (k == 5) { return GPU_ERR_CONTAINER_PARSE; }
    if (k == 6) { return GPU_ERR_CONTAINER_PARSE; }
    if (k == 7) { return GPU_ERR_CONTAINER_PARSE; }
    if (k == 8) { return GPU_ERR_CONTAINER_PARSE; }
    if (k == 9) { return GPU_ERR_CONTAINER_PARSE; }
    if (k == 10) { return GPU_ERR_FORMAT_UNSUPPORTED; }
    return 0;
}
