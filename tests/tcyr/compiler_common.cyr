# v3.2 F.7f.2 — f32<->f64 CVT round-trip: out[lid.x] = double(float(a[lid.x])); LocalSize 8.
# OpFConvert f64->f32 (narrow, rounds) then f32->f64 (widen, exact). 2 f64 StorageBuffers.
# spirv-as spv1.3, spirv-val-clean, 142 words / 568 bytes (id-bound 25).
fn _spv_build_f64_cvt(buf): i64 {
    store32(buf + 0, 0x07230203);
    store32(buf + 4, 0x00010300);
    store32(buf + 8, 0x00070000);
    store32(buf + 12, 0x00000019);
    store32(buf + 16, 0x00000000);
