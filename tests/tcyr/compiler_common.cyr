# tests/tcyr/compiler_common.cyr — shared SPIR-V/MIR fixtures + builders for the
# Phase N compiler test suites (compiler_encode/lower/backend/compile). NOT a .tcyr, so
# `make test` does not run it directly; each compiler_*.tcyr includes it for the include
# chain (src/lib.cyr + lib/assert.cyr) and the _spv_build_* fixtures shared across phases.
include "src/lib.cyr"
include "lib/assert.cyr"

# ================================================================
# Phase N.1a — SPIR-V parser (spirv_parse.cyr)
# ================================================================
# A minimal valid GLCompute SPIR-V module (21 words / 84 bytes): header +
# OpCapability Shader + OpMemoryModel + OpEntryPoint GLCompute %4 "main" +
# OpExecutionMode %4 LocalSize 64 1 1. `buf` is a pointer param (the caller
# passes &buf), so writes use `buf + off` directly. Returns the byte length.
fn _spv_build_min_compute(buf): i64 {
    store32(buf +  0, 0x07230203);   # magic
    store32(buf +  4, 0x00010300);   # version 1.3
    store32(buf +  8, 0x00000000);   # generator
    store32(buf + 12, 20);           # id-bound
    store32(buf + 16, 0);            # schema
    store32(buf + 20, (2 << 16) | 17);   # OpCapability (wc 2)
    store32(buf + 24, 1);                # Shader
    store32(buf + 28, (3 << 16) | 14);   # OpMemoryModel (wc 3)
    store32(buf + 32, 0);                # Logical
    store32(buf + 36, 1);                # GLSL450
    store32(buf + 40, (5 << 16) | 15);   # OpEntryPoint (wc 5)
    store32(buf + 44, 5);                # GLCompute
    store32(buf + 48, 4);                # entry <id> = 4
    store32(buf + 52, 0x6E69616D);       # "main"
    store32(buf + 56, 0x00000000);       # name null term
    store32(buf + 60, (6 << 16) | 16);   # OpExecutionMode (wc 6)
    store32(buf + 64, 4);                # entry <id>
    store32(buf + 68, 17);               # LocalSize
    store32(buf + 72, 64);               # x
    store32(buf + 76, 1);                # y
    store32(buf + 80, 1);                # z
    return 84;
}

# ================================================================
# Phase N.1b — type / constant / decoration tables
# ================================================================
# A richer fixture (id-bound 20, max id 13, 168 bytes) exercising the tables:
#   OpDecorate %12 Binding 0   ;   OpDecorate %12 DescriptorSet 0
#   OpTypeInt %6 32 1   ;   OpTypeFloat %7 32   ;   OpTypeVector %8 %7 4
#   OpTypeRuntimeArray %9 %7   ;   OpTypeStruct %10 %9
#   OpTypePointer %11 StorageBuffer(12) %10   ;   OpConstant %6 %13 42
#   OpVariable %11 %12 StorageBuffer(12)
fn _spv_build_typed_module(buf): i64 {
    store32(buf +   0, 0x07230203);   # magic
    store32(buf +   4, 0x00010300);   # version 1.3
    store32(buf +   8, 0);            # generator
    store32(buf +  12, 20);           # id-bound
    store32(buf +  16, 0);            # schema
    store32(buf +  20, (4 << 16) | 71);   # OpDecorate
    store32(buf +  24, 12);               # target %12
    store32(buf +  28, 33);               # Binding
    store32(buf +  32, 0);                # binding 0
    store32(buf +  36, (4 << 16) | 71);   # OpDecorate
    store32(buf +  40, 12);               # target %12
    store32(buf +  44, 34);               # DescriptorSet
    store32(buf +  48, 0);                # set 0
    store32(buf +  52, (4 << 16) | 21);   # OpTypeInt
    store32(buf +  56, 6);                # result %6
    store32(buf +  60, 32);               # width
    store32(buf +  64, 1);                # signed
    store32(buf +  68, (3 << 16) | 22);   # OpTypeFloat
    store32(buf +  72, 7);                # result %7
    store32(buf +  76, 32);               # width
    store32(buf +  80, (4 << 16) | 23);   # OpTypeVector
    store32(buf +  84, 8);                # result %8
    store32(buf +  88, 7);                # component %7
    store32(buf +  92, 4);                # count 4
    store32(buf +  96, (3 << 16) | 29);   # OpTypeRuntimeArray
    store32(buf + 100, 9);                # result %9
    store32(buf + 104, 7);                # element %7
    store32(buf + 108, (3 << 16) | 30);   # OpTypeStruct
    store32(buf + 112, 10);               # result %10
    store32(buf + 116, 9);                # member0 %9
    store32(buf + 120, (4 << 16) | 32);   # OpTypePointer
    store32(buf + 124, 11);               # result %11
    store32(buf + 128, 12);               # StorageBuffer
    store32(buf + 132, 10);               # pointee %10
    store32(buf + 136, (4 << 16) | 43);   # OpConstant
    store32(buf + 140, 6);                # result type %6
    store32(buf + 144, 13);               # result %13
    store32(buf + 148, 42);               # value
    store32(buf + 152, (4 << 16) | 59);   # OpVariable
    store32(buf + 156, 11);               # result type %11
    store32(buf + 160, 12);               # result %12
    store32(buf + 164, 12);               # StorageBuffer
    return 168;
}

# ================================================================
# Phase N.2a — MIR data model + uniformity pass (mir.cyr)
# ================================================================
# Type-distill fixture: int(signed/unsigned), float(32/64), vec4(f32/f64/count5).
fn _spv_build_distill_types(buf): i64 {
    store32(buf +   0, 0x07230203);
    store32(buf +   4, 0x00010300);
    store32(buf +   8, 0);
    store32(buf +  12, 16);            # id-bound
    store32(buf +  16, 0);
    store32(buf +  20, (4 << 16) | 21);   # OpTypeInt %2 32 1 (signed -> I32)
    store32(buf +  24, 2);
    store32(buf +  28, 32);
    store32(buf +  32, 1);
    store32(buf +  36, (4 << 16) | 21);   # OpTypeInt %3 32 0 (unsigned -> U32)
    store32(buf +  40, 3);
    store32(buf +  44, 32);
    store32(buf +  48, 0);
    store32(buf +  52, (3 << 16) | 22);   # OpTypeFloat %4 32 (-> F32)
    store32(buf +  56, 4);
    store32(buf +  60, 32);
    store32(buf +  64, (3 << 16) | 22);   # OpTypeFloat %5 64 (-> UNSUPPORTED)
    store32(buf +  68, 5);
    store32(buf +  72, 64);
    store32(buf +  76, (4 << 16) | 23);   # OpTypeVector %6 %4 4 (vec4 f32)
    store32(buf +  80, 6);
    store32(buf +  84, 4);
    store32(buf +  88, 4);
    store32(buf +  92, (4 << 16) | 23);   # OpTypeVector %7 %5 4 (vec4 f64 -> UNSUPPORTED)
    store32(buf +  96, 7);
    store32(buf + 100, 5);
    store32(buf + 104, 4);
    store32(buf + 108, (4 << 16) | 23);   # OpTypeVector %8 %4 5 (count 5 -> UNSUPPORTED)
    store32(buf + 112, 8);
    store32(buf + 116, 4);
    store32(buf + 120, 5);
    return 124;
}

# Pathological-vector fixture for the type-distill audit (review N.2a #3/#4):
# vec4 f32 (valid), vector-of-vector (component is a vector), and a
# self-referential vector (component == own id).
fn _spv_build_bad_vectors(buf): i64 {
    store32(buf +  0, 0x07230203);
    store32(buf +  4, 0x00010300);
    store32(buf +  8, 0);
    store32(buf + 12, 16);
    store32(buf + 16, 0);
    store32(buf + 20, (3 << 16) | 22);   # OpTypeFloat %4 32
    store32(buf + 24, 4);
    store32(buf + 28, 32);
    store32(buf + 32, (4 << 16) | 23);   # OpTypeVector %6 %4 4 (valid vec4 f32)
    store32(buf + 36, 6);
    store32(buf + 40, 4);
    store32(buf + 44, 4);
    store32(buf + 48, (4 << 16) | 23);   # OpTypeVector %7 %6 2 (component is a vector)
    store32(buf + 52, 7);
    store32(buf + 56, 6);
    store32(buf + 60, 2);
    store32(buf + 64, (4 << 16) | 23);   # OpTypeVector %8 %8 4 (self-referential)
    store32(buf + 68, 8);
    store32(buf + 72, 8);
    store32(buf + 76, 4);
    return 80;
}

# ================================================================
# Phase N.2b-1 — SPIR-V → MIR lowering (spirv_lower.cyr)
# ================================================================
# A memory-free GLCompute kernel (id-bound 16, 352 bytes): loads
# LocalInvocationId, extracts .x, does int arithmetic on it + two constants.
# (Indexed by LocalInvocationId, NOT GlobalInvocationId, so the index lowers to a
# single OpCompositeExtract — these pipeline-shape tests assert that straight-line
# form. The GlobalInvocationId EXPANSION, gid = wgid*size + lid, is exercised by
# the _gid e2e/lowering tests, which would add the wgid/lid/mul/add prelude here.)
# Exercises builtin-resolve, the seed, the builtin OpLoad alias,
# OpCompositeExtract, the ALU dispatch, OpReturn, and the uniformity sweep —
# end-to-end, no buffer access (that is N.2b-2).
#   %1 void  %2 fn()  %3 uint  %4 uvec3  %5 ptr Input uvec3  %6 main  %7 gid var
#   %8 const 1  %9 const 2  %10 label  %11 load gid  %12 gid.x
#   %13 x+1  %14 (x+1)*2  %15 1<<2 (both const -> uniform)
fn _spv_build_gid_kernel(buf): i64 {
    store32(buf +   0, 0x07230203);
    store32(buf +   4, 0x00010300);
    store32(buf +   8, 0);
    store32(buf +  12, 16);
    store32(buf +  16, 0);
    store32(buf +  20, (2 << 16) | 17);   # OpCapability Shader
    store32(buf +  24, 1);
    store32(buf +  28, (3 << 16) | 14);   # OpMemoryModel Logical GLSL450
    store32(buf +  32, 0);
    store32(buf +  36, 1);
    store32(buf +  40, (6 << 16) | 15);   # OpEntryPoint GLCompute %6 "main" %7
    store32(buf +  44, 5);
    store32(buf +  48, 6);
    store32(buf +  52, 0x6E69616D);
    store32(buf +  56, 0);
    store32(buf +  60, 7);
    store32(buf +  64, (6 << 16) | 16);   # OpExecutionMode %6 LocalSize 64 1 1
    store32(buf +  68, 6);
    store32(buf +  72, 17);
    store32(buf +  76, 64);
    store32(buf +  80, 1);
    store32(buf +  84, 1);
    store32(buf +  88, (4 << 16) | 71);   # OpDecorate %7 BuiltIn LocalInvocationId
    store32(buf +  92, 7);
    store32(buf +  96, 11);
    store32(buf + 100, 27);
    store32(buf + 104, (2 << 16) | 19);   # OpTypeVoid %1
    store32(buf + 108, 1);
    store32(buf + 112, (3 << 16) | 33);   # OpTypeFunction %2 %1
    store32(buf + 116, 2);
    store32(buf + 120, 1);
    store32(buf + 124, (4 << 16) | 21);   # OpTypeInt %3 32 0
    store32(buf + 128, 3);
    store32(buf + 132, 32);
    store32(buf + 136, 0);
    store32(buf + 140, (4 << 16) | 23);   # OpTypeVector %4 %3 3
    store32(buf + 144, 4);
    store32(buf + 148, 3);
    store32(buf + 152, 3);
    store32(buf + 156, (4 << 16) | 32);   # OpTypePointer %5 Input %4
    store32(buf + 160, 5);
    store32(buf + 164, 1);
    store32(buf + 168, 4);
    store32(buf + 172, (4 << 16) | 43);   # OpConstant %3 %8 1
    store32(buf + 176, 3);
    store32(buf + 180, 8);
    store32(buf + 184, 1);
    store32(buf + 188, (4 << 16) | 43);   # OpConstant %3 %9 2
    store32(buf + 192, 3);
    store32(buf + 196, 9);
    store32(buf + 200, 2);
    store32(buf + 204, (4 << 16) | 59);   # OpVariable %5 %7 Input
    store32(buf + 208, 5);
    store32(buf + 212, 7);
    store32(buf + 216, 1);
    store32(buf + 220, (5 << 16) | 54);   # OpFunction %1 %6 None %2
    store32(buf + 224, 1);
    store32(buf + 228, 6);
    store32(buf + 232, 0);
    store32(buf + 236, 2);
    store32(buf + 240, (2 << 16) | 248);  # OpLabel %10
    store32(buf + 244, 10);
    store32(buf + 248, (4 << 16) | 61);   # OpLoad %4 %11 %7
    store32(buf + 252, 4);
    store32(buf + 256, 11);
    store32(buf + 260, 7);
    store32(buf + 264, (5 << 16) | 81);   # OpCompositeExtract %3 %12 %11 0
    store32(buf + 268, 3);
    store32(buf + 272, 12);
    store32(buf + 276, 11);
    store32(buf + 280, 0);
    store32(buf + 284, (5 << 16) | 128);  # OpIAdd %3 %13 %12 %8
    store32(buf + 288, 3);
    store32(buf + 292, 13);
    store32(buf + 296, 12);
    store32(buf + 300, 8);
    store32(buf + 304, (5 << 16) | 132);  # OpIMul %3 %14 %13 %9
    store32(buf + 308, 3);
    store32(buf + 312, 14);
    store32(buf + 316, 13);
    store32(buf + 320, 9);
    store32(buf + 324, (5 << 16) | 196);  # OpShiftLeftLogical %3 %15 %8 %9
    store32(buf + 328, 3);
    store32(buf + 332, 15);
    store32(buf + 336, 8);
    store32(buf + 340, 9);
    store32(buf + 344, (1 << 16) | 253);  # OpReturn
    store32(buf + 348, (1 << 16) | 56);   # OpFunctionEnd
    return 352;
}

# ================================================================
# Phase N.2b-2 — buffer memory path (OpAccessChain + Load/Store)
# ================================================================
# A SAXPY-shape GLCompute kernel (id-bound 26, 588 bytes): two StorageBuffer
# bindings X(b0) Y(b1) of struct{ runtimearray<float> }, a float constant a, and
# indexed by LocalInvocationId (so the index is a single OpCompositeExtract — the
# pipeline-shape tests assert that). `_spv_build_saxpy_gid` re-indexes it by
# GlobalInvocationId to exercise the gid = wgid*size + lid expansion (N.5c-2b).
# y[gid.x] = a * x[gid.x] + y[gid.x]. Exercises the full memory path:
# OpAccessChain (dynamic index -> synth IMUL offset), buffer OpLoad/OpStore, and
# the uniformity of indexed loads.
#   %1 void %2 fn %3 float %4 uint %5 uvec3 %6 ptr-In-uvec3
#   %7 rtarray<f32> %8 struct{%7} %9 ptr-SB-struct %10 ptr-SB-float
#   %11 main %12 gid %13 xbuf %14 ybuf %15 const a(2.0) %16 const 0
#   %17 label %18 load-gid %19 gid.x %20 px %21 xv %22 py %23 yv %24 a*xv %25 +yv
fn _spv_build_saxpy(buf): i64 {
    store32(buf +   0, 0x07230203);
    store32(buf +   4, 0x00010300);
    store32(buf +   8, 0);
    store32(buf +  12, 26);
    store32(buf +  16, 0);
    store32(buf +  20, (2 << 16) | 17);   # OpCapability Shader
    store32(buf +  24, 1);
    store32(buf +  28, (3 << 16) | 14);   # OpMemoryModel Logical GLSL450
    store32(buf +  32, 0);
    store32(buf +  36, 1);
    store32(buf +  40, (6 << 16) | 15);   # OpEntryPoint GLCompute %11 "main" %12
    store32(buf +  44, 5);
    store32(buf +  48, 11);
    store32(buf +  52, 0x6E69616D);
    store32(buf +  56, 0);
    store32(buf +  60, 12);
    store32(buf +  64, (6 << 16) | 16);   # OpExecutionMode %11 LocalSize 64 1 1
    store32(buf +  68, 11);
    store32(buf +  72, 17);
    store32(buf +  76, 64);
    store32(buf +  80, 1);
    store32(buf +  84, 1);
    store32(buf +  88, (4 << 16) | 71);   # OpDecorate %12 BuiltIn LocalInvocationId
    store32(buf +  92, 12);
    store32(buf +  96, 11);
    store32(buf + 100, 27);
    store32(buf + 104, (4 << 16) | 71);   # OpDecorate %13 Binding 0
    store32(buf + 108, 13);
    store32(buf + 112, 33);
    store32(buf + 116, 0);
    store32(buf + 120, (4 << 16) | 71);   # OpDecorate %13 DescriptorSet 0
    store32(buf + 124, 13);
    store32(buf + 128, 34);
    store32(buf + 132, 0);
    store32(buf + 136, (4 << 16) | 71);   # OpDecorate %14 Binding 1
    store32(buf + 140, 14);
    store32(buf + 144, 33);
    store32(buf + 148, 1);
    store32(buf + 152, (4 << 16) | 71);   # OpDecorate %14 DescriptorSet 0
    store32(buf + 156, 14);
    store32(buf + 160, 34);
    store32(buf + 164, 0);
    store32(buf + 168, (2 << 16) | 19);   # OpTypeVoid %1
    store32(buf + 172, 1);
    store32(buf + 176, (3 << 16) | 33);   # OpTypeFunction %2 %1
    store32(buf + 180, 2);
    store32(buf + 184, 1);
    store32(buf + 188, (3 << 16) | 22);   # OpTypeFloat %3 32
    store32(buf + 192, 3);
    store32(buf + 196, 32);
    store32(buf + 200, (4 << 16) | 21);   # OpTypeInt %4 32 0
    store32(buf + 204, 4);
    store32(buf + 208, 32);
    store32(buf + 212, 0);
    store32(buf + 216, (4 << 16) | 23);   # OpTypeVector %5 %4 3
    store32(buf + 220, 5);
    store32(buf + 224, 4);
    store32(buf + 228, 3);
    store32(buf + 232, (4 << 16) | 32);   # OpTypePointer %6 Input %5
    store32(buf + 236, 6);
    store32(buf + 240, 1);
    store32(buf + 244, 5);
    store32(buf + 248, (3 << 16) | 29);   # OpTypeRuntimeArray %7 %3
    store32(buf + 252, 7);
    store32(buf + 256, 3);
    store32(buf + 260, (3 << 16) | 30);   # OpTypeStruct %8 %7
    store32(buf + 264, 8);
    store32(buf + 268, 7);
    store32(buf + 272, (4 << 16) | 32);   # OpTypePointer %9 StorageBuffer %8
    store32(buf + 276, 9);
    store32(buf + 280, 12);
    store32(buf + 284, 8);
    store32(buf + 288, (4 << 16) | 32);   # OpTypePointer %10 StorageBuffer %3
    store32(buf + 292, 10);
    store32(buf + 296, 12);
    store32(buf + 300, 3);
    store32(buf + 304, (4 << 16) | 43);   # OpConstant %3 %15 2.0
    store32(buf + 308, 3);
    store32(buf + 312, 15);
    store32(buf + 316, 0x40000000);
    store32(buf + 320, (4 << 16) | 43);   # OpConstant %4 %16 0
    store32(buf + 324, 4);
    store32(buf + 328, 16);
    store32(buf + 332, 0);
    store32(buf + 336, (4 << 16) | 59);   # OpVariable %6 %12 Input
    store32(buf + 340, 6);
    store32(buf + 344, 12);
    store32(buf + 348, 1);
    store32(buf + 352, (4 << 16) | 59);   # OpVariable %9 %13 StorageBuffer
    store32(buf + 356, 9);
    store32(buf + 360, 13);
    store32(buf + 364, 12);
    store32(buf + 368, (4 << 16) | 59);   # OpVariable %9 %14 StorageBuffer
    store32(buf + 372, 9);
    store32(buf + 376, 14);
    store32(buf + 380, 12);
    store32(buf + 384, (5 << 16) | 54);   # OpFunction %1 %11 None %2
    store32(buf + 388, 1);
    store32(buf + 392, 11);
    store32(buf + 396, 0);
    store32(buf + 400, 2);
    store32(buf + 404, (2 << 16) | 248);  # OpLabel %17
    store32(buf + 408, 17);
    store32(buf + 412, (4 << 16) | 61);   # OpLoad %5 %18 %12
    store32(buf + 416, 5);
    store32(buf + 420, 18);
    store32(buf + 424, 12);
    store32(buf + 428, (5 << 16) | 81);   # OpCompositeExtract %4 %19 %18 0
    store32(buf + 432, 4);
    store32(buf + 436, 19);
    store32(buf + 440, 18);
    store32(buf + 444, 0);
    store32(buf + 448, (6 << 16) | 65);   # OpAccessChain %10 %20 %13 %16 %19
    store32(buf + 452, 10);
    store32(buf + 456, 20);
    store32(buf + 460, 13);
    store32(buf + 464, 16);
    store32(buf + 468, 19);
    store32(buf + 472, (4 << 16) | 61);   # OpLoad %3 %21 %20
    store32(buf + 476, 3);
    store32(buf + 480, 21);
    store32(buf + 484, 20);
    store32(buf + 488, (6 << 16) | 65);   # OpAccessChain %10 %22 %14 %16 %19
    store32(buf + 492, 10);
    store32(buf + 496, 22);
    store32(buf + 500, 14);
    store32(buf + 504, 16);
    store32(buf + 508, 19);
    store32(buf + 512, (4 << 16) | 61);   # OpLoad %3 %23 %22
    store32(buf + 516, 3);
    store32(buf + 520, 23);
    store32(buf + 524, 22);
    store32(buf + 528, (5 << 16) | 133);  # OpFMul %3 %24 %15 %21
    store32(buf + 532, 3);
    store32(buf + 536, 24);
    store32(buf + 540, 15);
    store32(buf + 544, 21);
    store32(buf + 548, (5 << 16) | 129);  # OpFAdd %3 %25 %24 %23
    store32(buf + 552, 3);
    store32(buf + 556, 25);
    store32(buf + 560, 24);
    store32(buf + 564, 23);
    store32(buf + 568, (3 << 16) | 62);   # OpStore %22 %25
    store32(buf + 572, 22);
    store32(buf + 576, 25);
    store32(buf + 580, (1 << 16) | 253);  # OpReturn
    store32(buf + 584, (1 << 16) | 56);   # OpFunctionEnd
    return 588;
}

fn _spv_saxpy_lower(buf, n, m, vals, instrs, ptrs, blocks): i64 {
    var types[640];
    var consts[448];
    var deco[448];
    var outbi[256];
    spirv_build_type_table(buf, n, 26, 26, &types);
    spirv_build_const_table(buf, n, 26, 26, &consts);
    spirv_build_decoration_table(buf, n, 26, 26, &deco);
    mir_mod_init(m, vals, instrs, ptrs, blocks, 32, 8, 26, 30);
    return spirv_lower_module(buf, n, &types, &consts, &deco, m, &outbi);
}

# ================================================================
# Phase N.4b — s_waitcnt insertion (gfx9_waitcnt.cyr)
# ================================================================
# The by-construction proof: walk the waitcnt'd list and confirm NO instruction
# ever reads the result of a still-outstanding load. Returns 1 if the invariant
# holds, 0 on the first violation. Both emitted simms wait vmcnt(0), so either
# s_waitcnt clears the outstanding set.
fn _wc_check_invariant(out, n): i64 {
    var outstanding[2048];
    memset(&outstanding, 0, 2048);
    var i = 0;
    while (i < n) {
        var op = gisel_op(out, i);
        if (_wc_uses_outstanding(out, i, &outstanding) == 1) { return 0; }
        if (op == GISEL_S_WAITCNT) { memset(&outstanding, 0, 2048); }
        if (op == GISEL_GLOBAL_LOAD) { store64(&outstanding + gisel_dst(out, i) * 8, 1); }
        i = i + 1;
    }
    return 1;
}

# The SAXPY fixture re-indexed by LocalInvocationId (BuiltIn 27) instead of
# GlobalInvocationId (28) — so the index IS v0 (EXTRACT(LID)→v_mov, no wgid*size+lid
# expansion). The first-oracle end-to-end target until GID expansion lands (N.5c-2).
fn _spv_build_saxpy_lid(buf): i64 {
    var n = _spv_build_saxpy(buf);
    store32(buf + 100, 27);   # OpDecorate %12 BuiltIn LocalInvocationId (the base is already LID)
    return n;
}

# The SAXPY fixture re-indexed by GlobalInvocationId (BuiltIn 28) — the index then
# lowers to gid.x = wgid.x*local_size_x + lid.x (the N.5c-2b expansion).
fn _spv_build_saxpy_gid(buf): i64 {
    var n = _spv_build_saxpy(buf);
    store32(buf + 100, 28);   # OpDecorate %12 BuiltIn GlobalInvocationId
    return n;
}

# N.7b — a uniform `if (wgid.x == 0) {}` structured-CF module (id-bound 16):
# entry %10 [extract wgid.x, ICMP_EQ, cond-branch to then/merge] / then %14 [branch
# merge] / merge %15 [return]. Exercises OpLabel/OpSelectionMerge/OpBranchConditional/
# OpBranch/OpIEqual lowering.
fn _spv_build_uniform_if(buf): i64 {
    store32(buf + 0, 0x07230203);
    store32(buf + 4, 0x00010300);
    store32(buf + 8, 0);
    store32(buf + 12, 16);
    store32(buf + 16, 0);
    store32(buf + 20, (2 << 16) | 17);   # OpCapability Shader
    store32(buf + 24, 1);
    store32(buf + 28, (3 << 16) | 14);   # OpMemoryModel
    store32(buf + 32, 0);
    store32(buf + 36, 1);
    store32(buf + 40, (6 << 16) | 15);   # OpEntryPoint %9 "main" %8
    store32(buf + 44, 5);
    store32(buf + 48, 9);
    store32(buf + 52, 0x6E69616D);
    store32(buf + 56, 0);
    store32(buf + 60, 8);
    store32(buf + 64, (6 << 16) | 16);   # OpExecutionMode LocalSize 8 1 1
    store32(buf + 68, 9);
    store32(buf + 72, 17);
    store32(buf + 76, 8);
    store32(buf + 80, 1);
    store32(buf + 84, 1);
    store32(buf + 88, (4 << 16) | 71);   # OpDecorate %8 BuiltIn WorkgroupId
    store32(buf + 92, 8);
    store32(buf + 96, 11);
    store32(buf + 100, 26);
    store32(buf + 104, (2 << 16) | 19);  # %1 void
    store32(buf + 108, 1);
    store32(buf + 112, (3 << 16) | 33);  # %2 fn
    store32(buf + 116, 2);
    store32(buf + 120, 1);
    store32(buf + 124, (4 << 16) | 21);  # %3 uint
    store32(buf + 128, 3);
    store32(buf + 132, 32);
    store32(buf + 136, 0);
    store32(buf + 140, (4 << 16) | 23);  # %4 v3uint
    store32(buf + 144, 4);
    store32(buf + 148, 3);
    store32(buf + 152, 3);
    store32(buf + 156, (4 << 16) | 32);  # %5 ptr Input
    store32(buf + 160, 5);
    store32(buf + 164, 1);
    store32(buf + 168, 4);
    store32(buf + 172, (2 << 16) | 20);  # %6 bool
    store32(buf + 176, 6);
    store32(buf + 180, (4 << 16) | 43);  # %7 const 0
    store32(buf + 184, 3);
    store32(buf + 188, 7);
    store32(buf + 192, 0);
    store32(buf + 196, (4 << 16) | 59);  # %8 wgid var
    store32(buf + 200, 5);
    store32(buf + 204, 8);
    store32(buf + 208, 1);
    store32(buf + 212, (5 << 16) | 54);  # OpFunction %9
    store32(buf + 216, 1);
    store32(buf + 220, 9);
    store32(buf + 224, 0);
    store32(buf + 228, 2);
    store32(buf + 232, (2 << 16) | 248); # OpLabel %10 (entry)
    store32(buf + 236, 10);
    store32(buf + 240, (4 << 16) | 61);  # OpLoad %11
    store32(buf + 244, 4);
    store32(buf + 248, 11);
    store32(buf + 252, 8);
    store32(buf + 256, (5 << 16) | 81);  # OpCompositeExtract wgid.x %12
    store32(buf + 260, 3);
    store32(buf + 264, 12);
    store32(buf + 268, 11);
    store32(buf + 272, 0);
    store32(buf + 276, (5 << 16) | 170); # OpIEqual %13
    store32(buf + 280, 6);
    store32(buf + 284, 13);
    store32(buf + 288, 12);
    store32(buf + 292, 7);
    store32(buf + 296, (3 << 16) | 247); # OpSelectionMerge %15
    store32(buf + 300, 15);
    store32(buf + 304, 0);
    store32(buf + 308, (4 << 16) | 250); # OpBranchConditional %13 %14 %15
    store32(buf + 312, 13);
    store32(buf + 316, 14);
    store32(buf + 320, 15);
    store32(buf + 324, (2 << 16) | 248); # OpLabel %14 (then)
    store32(buf + 328, 14);
    store32(buf + 332, (2 << 16) | 249); # OpBranch %15
    store32(buf + 336, 15);
    store32(buf + 340, (2 << 16) | 248); # OpLabel %15 (merge)
    store32(buf + 344, 15);
    store32(buf + 348, (1 << 16) | 253); # OpReturn
    store32(buf + 352, (1 << 16) | 56);  # OpFunctionEnd
    return 356;
}

