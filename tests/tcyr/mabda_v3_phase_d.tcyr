    test_native_drm_master_fd_guard();
    test_kms_summary_print_u32_buf_holds_max_i64();
    test_native_buffer_stubs_return_not_implemented();
    test_gpu_err_not_implemented_constant_and_name();

    # v3 audit 2026-04-30 → rc.2 fixes (MED-2)
    test_kms_validate_fb_dims_caps();
    test_native_kms_alloc_fb_rejects_oversized_dims();

    # v3 audit 2026-04-30 → rc.2 fixes (MED-7)
    test_native_ctx_pm4_scratch_is_stable();

    return assert_summary();
}

# v3 Step 7.7 — public surface API

fn test_gpu_context_size_extended_to_120() {
    # The GpuContext layout: 112 → 120 at v3 rc.2 audit MED-7 to
    # cache the per-dispatch PM4 scratch buffer alongside the IB +
    # fence + surface-stash slots. Pin the size + the new field
    # offset so a future refactor can't silently shrink the struct.
    assert_eq(GPU_CONTEXT_SIZE, 120, "extended ctx = 120");
    # PM4 scratch buffer size kept in sync — the slot fns memset 256
    # (compute) or 1024 (render) of this buffer; bumping above 1024
    # requires updating both slots.
    assert_eq(_NATIVE_PM4_SCRATCH_BYTES, 1024, "scratch = 1024 bytes");
    return 0;
}

# Audit MED-7: stability contract — once `gpu_context_new_native`
# stashes the PM4 scratch ptr at +112, every dispatch reads the same
# value through `native_ctx_pm4_scratch`. The accessor never re-allocs
# under us; if it does, this assertion catches the regression.
fn test_native_ctx_pm4_scratch_is_stable() {
    var ctx[120];
    memset(&ctx, 0, 120);
    # Sentinel ptr stashed once; two consecutive accessor calls
    # return the same address (no per-call alloc).
    store64(&ctx + 112, 0xCAFEBABE);
    var p1 = native_ctx_pm4_scratch(&ctx);
    var p2 = native_ctx_pm4_scratch(&ctx);
    assert_eq(p1, 0xCAFEBABE, "scratch read");
    assert_eq(p2, 0xCAFEBABE, "scratch stable across calls");
    assert_eq(p1, p2, "two reads identical");
    # wgpu-side ctx leaves +112 as 0 — accessor returns 0, slot
    # short-circuits with GPU_ERR_OTHER (already covered by the
    # dispatch fns' explicit `if (pm4 == 0)` guards).
    memset(&ctx, 0, 120);
    assert_eq(native_ctx_pm4_scratch(&ctx), 0, "wgpu/zero ctx → 0");
    return 0;
}

fn test_gpu_ctx_wgpu_surface_handle_round_trip() {
    # Stack-local — heap-alloc tests at this point in the file
    # exhaust the bump allocator. Fixed-size array gives the same
    # observable shape with zero heap pressure.
    var ctx[112];
    memset(&ctx, 0, 112);
    assert_eq(gpu_ctx_wgpu_surface_handle(&ctx), 0, "starts zero");
    gpu_ctx_set_wgpu_surface_handle(&ctx, 0xDEADBEEF);
    assert_eq(gpu_ctx_wgpu_surface_handle(&ctx), 0xDEADBEEF, "round-trip");
    assert_eq(gpu_ctx_set_wgpu_surface_handle(0, 1), -1, "null ctx → -1");
    return 0;
}

fn test_gpu_ctx_native_card_fd_round_trip() {
    var ctx[112];
    memset(&ctx, 0, 112);
    assert_eq(gpu_ctx_native_card_fd(&ctx), 0, "starts zero");
    gpu_ctx_set_native_card_fd(&ctx, 42);
    assert_eq(gpu_ctx_native_card_fd(&ctx), 42, "round-trip");
    assert_eq(gpu_ctx_set_native_card_fd(0, 7), -1, "null ctx → -1");
    return 0;
}

fn test_native_surface_struct_field_offsets() {
    assert_eq(NATIVE_SURFACE_CARD_FD,    0,   "card_fd");
    assert_eq(NATIVE_SURFACE_RENDER_FD,  4,   "render_fd");
    assert_eq(NATIVE_SURFACE_STATE,      8,   "state");
    assert_eq(NATIVE_SURFACE_SCANOUT,    16,  "scanout");
    assert_eq(NATIVE_SURFACE_FB_B,       56,  "fb_b");
    assert_eq(NATIVE_SURFACE_FRONT_IS_B, 88,  "front_is_b");
    assert_eq(NATIVE_SURFACE_WIDTH,      96,  "width");
    assert_eq(NATIVE_SURFACE_HEIGHT,     100, "height");
    assert_eq(NATIVE_SURFACE_PITCH,      104, "pitch");
    assert_eq(NATIVE_SURFACE_SIZE,       120, "size");
    # Sanity: scanout + 40-byte size = fb_b offset; fb_b + 32 = front_is_b.
    assert_eq(NATIVE_SURFACE_SCANOUT + NATIVE_KMS_SCANOUT_SIZE,
    NATIVE_SURFACE_FB_B,
    "scanout-end aligns with fb_b-start");
    assert_eq(NATIVE_SURFACE_FB_B + NATIVE_KMS_FB_SIZE,
    NATIVE_SURFACE_FRONT_IS_B,
    "fb_b-end aligns with front_is_b");
    return 0;
}

fn test_gpu_surface_configure_wgpu_null_safe() {
    var ctx[112];
    memset(&ctx, 0, 112);
    assert_eq(gpu_surface_configure_wgpu(0,    0xCAFE, 256, 256), 0, "null ctx");
    assert_eq(gpu_surface_configure_wgpu(&ctx, 0,      256, 256), 0, "null surface");
    assert_eq(gpu_surface_configure_wgpu(&ctx, 0xCAFE, 0,   256), 0, "zero w");
    assert_eq(gpu_surface_configure_wgpu(&ctx, 0xCAFE, 256,   0), 0, "zero h");
    # No backend = no slot = 0.
    assert_eq(gpu_surface_configure_wgpu(&ctx, 0xCAFE, 256, 256), 0, "no backend");
    return 0;
}

fn test_gpu_surface_configure_native_kiosk_null_safe() {
    var ctx[112];
    memset(&ctx, 0, 112);
    assert_eq(gpu_surface_configure_native_kiosk(0,     7, 256, 256), 0, "null ctx");
    assert_eq(gpu_surface_configure_native_kiosk(&ctx,  0, 256, 256), 0, "card_fd=0");
    assert_eq(gpu_surface_configure_native_kiosk(&ctx, -1, 256, 256), 0, "card_fd<0");
    assert_eq(gpu_surface_configure_native_kiosk(&ctx,  7,   0, 256), 0, "zero w");
    assert_eq(gpu_surface_configure_native_kiosk(&ctx,  7, 256,   0), 0, "zero h");
    return 0;
}

fn test_gpu_surface_configure_native_logind_uninit_samvada() {
    # samvada is the gating dependency. In CPU tests, no C-shim
    # has been linked, so samvada's static fn-table is null
    # (`_samvada_table == 0`) → samvada_session_take_device
    # returns -22 (EINVAL) → this dispatcher falls through to 0.
    # The "logind works" path is HW-gated through the consumer
    # program, not exercised here.
    var ctx[112];
    memset(&ctx, 0, 112);
    assert_eq(gpu_surface_configure_native_logind(&ctx, 256, 256), 0,
    "uninit samvada → 0");
    assert_eq(gpu_surface_configure_native_logind(0, 256, 256), 0,
    "null ctx still 0");
    assert_eq(gpu_surface_configure_native_logind(&ctx, 0, 256), 0,
    "zero w");
    assert_eq(gpu_surface_configure_native_logind(&ctx, 256, 0), 0,
    "zero h");
    return 0;
}

fn test_gpu_surface_per_frame_ops_null_safe() {
    var ctx[112];
    memset(&ctx, 0, 112);
    assert_eq(gpu_surface_acquire(0,    0xC0FFEE), 0, "acquire null ctx");
    assert_eq(gpu_surface_acquire(&ctx, 0),        0, "acquire null surface");
    assert_eq(gpu_surface_acquire(&ctx, 0xC0FFEE), 0, "acquire no backend");
    assert_eq(gpu_surface_present(0,    0xC0FFEE), GPU_ERR_OTHER, "present null ctx");
    assert_eq(gpu_surface_present(&ctx, 0),        GPU_ERR_OTHER, "present null surface");
    assert_eq(gpu_surface_release(0,    0xC0FFEE), 0, "release null ctx");
    assert_eq(gpu_surface_release(&ctx, 0),        0, "release null surface");
    return 0;
}

# v3 audit 2026-04-30 — MED-3: native_rt_create_2d_rgba8 must reject
# odd width/height because native_pm4_build_render_pass_target's
# viewport math uses integer (rt_width / 2). Rejection happens in the
# allocator BEFORE any ioctl, so a fake fd is fine — the dim guard
# fires first.
fn test_native_rt_create_rejects_odd_dims() {
    var out[40];
    memset(&out, 0, 40);
    var fake_fd = 999;
    assert_eq(native_rt_create_2d_rgba8(fake_fd, 3,  4, &out),
    GPU_ERR_TEXTURE_DIMENSION, "odd width rejected");
    assert_eq(native_rt_create_2d_rgba8(fake_fd, 4,  5, &out),
    GPU_ERR_TEXTURE_DIMENSION, "odd height rejected");
    assert_eq(native_rt_create_2d_rgba8(fake_fd, 1,  2, &out),
    GPU_ERR_TEXTURE_DIMENSION, "1x2 width is odd");
    assert_eq(native_rt_create_2d_rgba8(fake_fd, 2,  1, &out),
    GPU_ERR_TEXTURE_DIMENSION, "2x1 height is odd");
    assert_eq(native_rt_create_2d_rgba8(fake_fd, 7, 13, &out),
    GPU_ERR_TEXTURE_DIMENSION, "both odd rejected");
    return 0;
}

fn test_native_rt_create_rejects_nonpositive_dims() {
    var out[40];
    memset(&out, 0, 40);
    var fake_fd = 999;
    assert_eq(native_rt_create_2d_rgba8(fake_fd,  0,  4, &out),
    GPU_ERR_TEXTURE_DIMENSION, "zero width");
    assert_eq(native_rt_create_2d_rgba8(fake_fd,  4,  0, &out),
    GPU_ERR_TEXTURE_DIMENSION, "zero height");
    assert_eq(native_rt_create_2d_rgba8(fake_fd, -2,  4, &out),
    GPU_ERR_TEXTURE_DIMENSION, "negative width");
    assert_eq(native_rt_create_2d_rgba8(fake_fd,  4, -2, &out),
    GPU_ERR_TEXTURE_DIMENSION, "negative height");
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
