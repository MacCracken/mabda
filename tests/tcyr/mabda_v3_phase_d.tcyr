fn test_native_kms_fb_struct_field_offsets() {
    assert_eq(NATIVE_KMS_FB_FB_ID,        0,  "fb_id");
    assert_eq(NATIVE_KMS_FB_CARD_HANDLE,  4,  "card_handle");
    assert_eq(NATIVE_KMS_FB_RENDER_HANDLE, 8, "render_handle");
    assert_eq(NATIVE_KMS_FB_PITCH,        12, "pitch");
    assert_eq(NATIVE_KMS_FB_MAPPED_ADDR,  16, "mapped_addr");
    assert_eq(NATIVE_KMS_FB_BO_SIZE,      24, "bo_size");
    assert_eq(NATIVE_KMS_FB_WIDTH,        28, "width");
    assert_eq(NATIVE_KMS_FB_SIZE,         32, "size");
    return 0;
}

fn test_native_kms_alloc_fb_null_safe() {
    var out[32];
    assert_eq(native_kms_alloc_fb(0, 7, 256, 256, &out), -1, "card_fd=0");
    assert_eq(native_kms_alloc_fb(7, 0, 256, 256, &out), -1, "render_fd=0");
    assert_eq(native_kms_alloc_fb(7, 7,   0, 256, &out), -1, "w=0");
    assert_eq(native_kms_alloc_fb(7, 7, 256,   0, &out), -1, "h=0");
    assert_eq(native_kms_alloc_fb(7, 7, 256, 256, 0),    -1, "out=0");
    return 0;
}

fn test_native_kms_release_fb_idempotent_on_zero() {
    var fb[32];
    memset(&fb, 0, 32);
    assert_eq(native_kms_release_fb(7, 7, &fb), 0, "zero fb safe");
    assert_eq(load32(&fb + NATIVE_KMS_FB_FB_ID), 0, "fb_id stays 0");
    return 0;
}

fn test_native_kms_present_null_safe() {
    var scan[40];
    var seq[4];
    memset(&scan, 0, 40);
    # Zero-crtc scanout — should fail validation.
    assert_eq(native_kms_present(7, &scan, 1, &seq), -1, "scanout has no crtc");
    # Args validation.
    assert_eq(native_kms_present(0, &scan, 1, &seq), -1, "fd=0");
    assert_eq(native_kms_present(7, 0,     1, &seq), -1, "scanout=0");
    assert_eq(native_kms_present(7, &scan, 0, &seq), -1, "new_fb=0");
    return 0;
}

fn test_native_kms_mode_refresh_hz_computation() {
    # 1920x1080@60 typical CTA timing: clock=148500 kHz,
    # htotal=2200, vtotal=1125 → 148500*1000 / (2200*1125)
    # = 148,500,000 / 2,475,000 = 60 exactly.
    var modes[68];
    memset(&modes, 0, 68);
    store32(&modes + DRM_MODE_MODEINFO_CLOCK,  148500);
    store16(&modes + DRM_MODE_MODEINFO_HTOTAL, 2200);
    store16(&modes + DRM_MODE_MODEINFO_VTOTAL, 1125);
    assert_eq(native_kms_mode_refresh_hz(&modes, 0), 60, "1080p60");
    # Null + zero-divisor safety.
    assert_eq(native_kms_mode_refresh_hz(0, 0), 0, "null modes");
    var bad[68];
    memset(&bad, 0, 68);
    store32(&bad + DRM_MODE_MODEINFO_CLOCK,  100000);
    store16(&bad + DRM_MODE_MODEINFO_HTOTAL, 0);
    store16(&bad + DRM_MODE_MODEINFO_VTOTAL, 1125);
    assert_eq(native_kms_mode_refresh_hz(&bad, 0), 0, "htotal=0 safe");
    return 0;
}

# ================================================================
# v3 audit 2026-04-30 → rc.2 fixes
# ================================================================

# Audit LOW-1: native_drm_set_master / _drop_master need an fd > 0
# guard, matching every other ioctl wrapper in backend_native_kms.cyr.
# Before this fix, native_drm_set_master(0) would issue a real
# syscall and depend on the kernel returning -EBADF.
fn test_native_drm_master_fd_guard() {
    assert_eq(native_drm_set_master(0),   -1, "set_master fd=0");
    assert_eq(native_drm_set_master(0-1), -1, "set_master fd=-1");
    assert_eq(native_drm_drop_master(0),   -1, "drop_master fd=0");
    assert_eq(native_drm_drop_master(0-1), -1, "drop_master fd=-1");
    return 0;
}

# Audit LOW-2: _kms_summary_print_u32 used a 16-byte stack buffer,
# too small for a 19-digit max-i64. fmt_int_buf is i64-typed, so a
# max-magnitude input would have overflowed. Verify the underlying
# property — fmt_int_buf width fits in the bumped buf[24].
fn test_kms_summary_print_u32_buf_holds_max_i64() {
    var buf[24];
    memset(&buf, 0, 24);
    var n = fmt_int_buf(9223372036854775807, &buf);
    assert_eq(n, 19, "max signed i64 fmt width");
    return 0;
}

# Audit LOW-3: native gpu_buffer_* / gpu_shader_module_* slots are
# diagnostic stubs in v3.0. Buffer write/read return
# GPU_ERR_NOT_IMPLEMENTED so callers can distinguish "native
# backend doesn't support this yet" from generic failures.
fn test_native_buffer_stubs_return_not_implemented() {
    assert_eq(_backend_native_buffer_write(0, 0, 0, 0, 0),
    GPU_ERR_NOT_IMPLEMENTED, "buffer_write");
    assert_eq(_backend_native_buffer_read(0, 0, 0, 0, 0),
    GPU_ERR_NOT_IMPLEMENTED, "buffer_read");
    # create returns 0-as-no-handle; release is no-op success.
    assert_eq(_backend_native_buffer_create(0, 0, 0),  0, "buffer_create no handle");
    assert_eq(_backend_native_buffer_release(0, 0),    0, "buffer_release no-op");
    assert_eq(_backend_native_shader_module_create(0, 0, 0), 0, "shmod_create no handle");
    assert_eq(_backend_native_shader_module_release(0, 0),   0, "shmod_release no-op");
    return 0;
}

fn test_gpu_err_not_implemented_constant_and_name() {
    assert_eq(GPU_ERR_NOT_IMPLEMENTED, 18, "code value");
    var name = gpu_err_name(GPU_ERR_NOT_IMPLEMENTED);
    # Non-empty name — distinct from "unknown error" sentinel.
    assert_eq(strlen(name) > 0, 1, "name non-empty");
    return 0;
}

# Audit MED-2: caller-supplied dimension overflow guards. Validate
# the shared math helper at the boundaries: max-dims pass; just-
# over-cap rejects; non-positive rejects; null out-ptrs reject.
fn test_kms_validate_fb_dims_caps() {
    var pitch[8];
    var bo[8];
    # 1080p — pitch is already 256-aligned (1920 * 4 = 7680), bo
    # = 7680 * 1080 = 8294400.
    assert_eq(_kms_validate_fb_dims(1920, 1080, &pitch, &bo), 0, "1080p ok");
    assert_eq(load64(&pitch), 7680,    "1080p pitch");
    assert_eq(load64(&bo),    8294400, "1080p bo_size");
    # Width 1921: pitch_raw = 7684, aligned to 7936.
    assert_eq(_kms_validate_fb_dims(1921, 1080, &pitch, &bo), 0, "1921 ok");
    assert_eq(load64(&pitch), 7936, "1921 pitch aligned");
    # Cap reached — 16384x16384 must validate, 1 GiB bo_size.
    assert_eq(_kms_validate_fb_dims(MABDA_KMS_MAX_FB_DIM,
    MABDA_KMS_MAX_FB_DIM,
    &pitch, &bo), 0,           "16384^2 ok");
    assert_eq(load64(&bo),    1073741824,                       "16384^2 = 1 GiB");
    # Just-over-cap rejected — neither dim allowed past 16384.
    assert_eq(_kms_validate_fb_dims(16385, 16384, &pitch, &bo), -1, "w 16385 reject");
    assert_eq(_kms_validate_fb_dims(16384, 16385, &pitch, &bo), -1, "h 16385 reject");
    # Non-positive rejected.
    assert_eq(_kms_validate_fb_dims(0,    1080,  &pitch, &bo), -1, "w=0 reject");
    assert_eq(_kms_validate_fb_dims(0-1,  1080,  &pitch, &bo), -1, "w=-1 reject");
    assert_eq(_kms_validate_fb_dims(1920, 0,     &pitch, &bo), -1, "h=0 reject");
    # Out-pointer null guards.
    assert_eq(_kms_validate_fb_dims(1920, 1080, 0,      &bo),  -1, "pitch_out=0 reject");
    assert_eq(_kms_validate_fb_dims(1920, 1080, &pitch, 0),    -1, "bo_out=0 reject");
    return 0;
}

# Audit MED-2: native_kms_alloc_fb forwards the same validation,
# rejecting at the public boundary BEFORE any BO alloc / ioctl.
# Sentinel fds (7) are never reached — rejection is in the
# validator, observable as -1 return.
fn test_native_kms_alloc_fb_rejects_oversized_dims() {
    var fb[32];
    assert_eq(native_kms_alloc_fb(7, 7, 16385, 1080,  &fb), -1, "w 16385 reject");
    assert_eq(native_kms_alloc_fb(7, 7, 1920,  65537, &fb), -1, "h 65537 reject");
    assert_eq(native_kms_alloc_fb(7, 7, 0-1,   1080,  &fb), -1, "w=-1 reject");
    assert_eq(native_kms_alloc_fb(7, 7, 1920,  0,     &fb), -1, "h=0 reject");
    return 0;
}

