fn test_drm_mode_get_encoder_field_offsets() {
    assert_eq(DRM_MODE_GET_ENCODER_ID,         0,  "+0");
    assert_eq(DRM_MODE_GET_ENCODER_TYPE,       4,  "+4");
    assert_eq(DRM_MODE_GET_ENCODER_CRTC_ID,    8,  "+8");
    assert_eq(DRM_MODE_GET_ENCODER_POSS_CRTCS, 12, "+12");
    assert_eq(DRM_MODE_GET_ENCODER_POSS_CLONES, 16, "+16");
    assert_eq(DRM_MODE_GET_ENCODER_SIZE,       20, "size");
    return 0;
}

fn test_drm_mode_encoder_type_constants() {
    assert_eq(DRM_MODE_ENCODER_NONE,    0, "None");
    assert_eq(DRM_MODE_ENCODER_DAC,     1, "DAC");
    assert_eq(DRM_MODE_ENCODER_TMDS,    2, "TMDS");
    assert_eq(DRM_MODE_ENCODER_LVDS,    3, "LVDS");
    assert_eq(DRM_MODE_ENCODER_TVDAC,   4, "TVDAC");
    assert_eq(DRM_MODE_ENCODER_VIRTUAL, 5, "Virtual");
    assert_eq(DRM_MODE_ENCODER_DSI,     6, "DSI");
    assert_eq(DRM_MODE_ENCODER_DPMST,   7, "DP-MST");
    assert_eq(DRM_MODE_ENCODER_DPI,     8, "DPI");
    return 0;
}

fn test_native_drm_connector_type_name_lookup() {
    # streq isn't in scope — compare by first byte (cheap proxy
    # that catches a "wrong table entry" regression without pulling
    # the full string compare in).
    assert_eq(load8(native_drm_connector_type_name(DRM_MODE_CONNECTOR_VGA)),         86, "VGA -> V");
    assert_eq(load8(native_drm_connector_type_name(DRM_MODE_CONNECTOR_DisplayPort)), 68, "DP -> D");
    assert_eq(load8(native_drm_connector_type_name(DRM_MODE_CONNECTOR_HDMIA)),       72, "HDMI-A -> H");
    assert_eq(load8(native_drm_connector_type_name(DRM_MODE_CONNECTOR_eDP)),         101, "eDP -> e");
    assert_eq(load8(native_drm_connector_type_name(99)),                              63, "unknown -> ?");
    return 0;
}

fn test_native_drm_encoder_type_name_lookup() {
    assert_eq(load8(native_drm_encoder_type_name(DRM_MODE_ENCODER_TMDS)),    84,  "TMDS -> T");
    assert_eq(load8(native_drm_encoder_type_name(DRM_MODE_ENCODER_DAC)),     68,  "DAC -> D");
    assert_eq(load8(native_drm_encoder_type_name(DRM_MODE_ENCODER_LVDS)),    76,  "LVDS -> L");
    assert_eq(load8(native_drm_encoder_type_name(DRM_MODE_ENCODER_VIRTUAL)), 86,  "Virtual -> V");
    assert_eq(load8(native_drm_encoder_type_name(99)),                       63,  "unknown -> ?");
    return 0;
}

fn test_native_drm_connection_status_name_lookup() {
    assert_eq(load8(native_drm_connection_status_name(DRM_MODE_CONNECTED)),         99,  "connected -> c");
    assert_eq(load8(native_drm_connection_status_name(DRM_MODE_DISCONNECTED)),      100, "disconnected -> d");
    assert_eq(load8(native_drm_connection_status_name(DRM_MODE_UNKNOWNCONNECTION)), 117, "unknown -> u");
    assert_eq(load8(native_drm_connection_status_name(99)),                         63,  "fallback -> ?");
    return 0;
}

fn test_native_kms_summary_null_safe() {
    # Null state returns -1 immediately (no syscalls).
    assert_eq(native_kms_summary(0), -1, "null state");
    # Non-null state with fd=0 also returns -1 (no syscalls).
    var s[96];
    memset(&s, 0, 96);
    store64(&s + KMS_STATE_FIELD_FD, 0);
    assert_eq(native_kms_summary(&s), -1, "fd=0 state");
    return 0;
}

# v3 Step 7.2(a) — per-connector mode enum + preferred picker

fn test_drm_mode_type_constants() {
    assert_eq(DRM_MODE_TYPE_BUILTIN,   0x01, "BUILTIN");
    assert_eq(DRM_MODE_TYPE_PREFERRED, 0x08, "PREFERRED");
    assert_eq(DRM_MODE_TYPE_USERDEF,   0x20, "USERDEF");
    assert_eq(DRM_MODE_TYPE_DRIVER,    0x40, "DRIVER");
    return 0;
}

fn test_native_kms_get_connector_modes_null_safe() {
    var c[4];
    assert_eq(native_kms_get_connector_modes(0, 1, &c),  0, "fd=0");
    assert_eq(native_kms_get_connector_modes(7, 0, &c),  0, "conn_id=0");
    assert_eq(native_kms_get_connector_modes(7, 1, 0),   0, "count_out=0");
    return 0;
}

fn test_native_kms_pick_preferred_null_or_empty() {
    assert_eq(native_kms_pick_preferred_mode(0, 5), 0,  "null modes");
    var modes[68];
    memset(&modes, 0, 68);
    assert_eq(native_kms_pick_preferred_mode(&modes, 0), 0, "count=0");
    return 0;
}

fn test_native_kms_pick_preferred_finds_first_preferred() {
    # Synthetic modes array: 3 entries.
    # mode[0].type = DRIVER only (0x40)        — not preferred
    # mode[1].type = DRIVER | PREFERRED (0x48) — picked
    # mode[2].type = DRIVER | PREFERRED (0x48) — also preferred but later
    var modes[204];   # 3 × 68
    memset(&modes, 0, 204);
    store32(&modes + 0 * 68 + DRM_MODE_MODEINFO_TYPE, DRM_MODE_TYPE_DRIVER);
    store32(&modes + 1 * 68 + DRM_MODE_MODEINFO_TYPE,
    DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED);
    store32(&modes + 2 * 68 + DRM_MODE_MODEINFO_TYPE,
    DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED);
    assert_eq(native_kms_pick_preferred_mode(&modes, 3), 1,
    "picks first PREFERRED entry");
    return 0;
}

fn test_native_kms_pick_preferred_falls_back_to_zero() {
    # No PREFERRED bit set anywhere — fallback returns index 0.
    var modes[136];   # 2 × 68
    memset(&modes, 0, 136);
    store32(&modes + 0 * 68 + DRM_MODE_MODEINFO_TYPE, DRM_MODE_TYPE_DRIVER);
    store32(&modes + 1 * 68 + DRM_MODE_MODEINFO_TYPE, DRM_MODE_TYPE_DRIVER);
    assert_eq(native_kms_pick_preferred_mode(&modes, 2), 0,
    "no PREFERRED → 0");
    return 0;
}

fn test_native_kms_mode_dim_accessors() {
    # Fill a synthetic single-mode array with 1920×1080@60.
    var modes[68];
    memset(&modes, 0, 68);
    store16(&modes + DRM_MODE_MODEINFO_HDISPLAY, 1920);
    store16(&modes + DRM_MODE_MODEINFO_VDISPLAY, 1080);
    store32(&modes + DRM_MODE_MODEINFO_VREFRESH, 60000);
    store32(&modes + DRM_MODE_MODEINFO_TYPE,
    DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED);
    assert_eq(native_kms_mode_hdisplay(&modes, 0), 1920, "hdisplay");
    assert_eq(native_kms_mode_vdisplay(&modes, 0), 1080, "vdisplay");
    assert_eq(native_kms_mode_vrefresh(&modes, 0), 60000, "vrefresh");
    assert_eq(native_kms_mode_type(&modes, 0),
    DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED, "type");
    # Null-safety on accessors.
    assert_eq(native_kms_mode_hdisplay(0, 0), 0, "null hdisplay");
    assert_eq(native_kms_mode_vdisplay(0, 0), 0, "null vdisplay");
    assert_eq(native_kms_mode_vrefresh(0, 0), 0, "null vrefresh");
    assert_eq(native_kms_mode_type(0, 0),     0, "null type");
    return 0;
}

# v3 Step 7.3 — KMS framebuffer (ADDFB2 + RMFB)

fn test_drm_mode_fb_ioctl_numbers() {
    # Re-derive each ioctl from first principles.
    assert_eq(DRM_IOCTL_MODE_ADDFB2,
    (3 << 30) | (100 << 16) | (0x64 << 8) | 0xB8, "ADDFB2 derived");
    assert_eq(DRM_IOCTL_MODE_ADDFB2, 0xC06464B8, "ADDFB2 literal");
    assert_eq(DRM_IOCTL_MODE_RMFB,
    (3 << 30) | (4 << 16) | (0x64 << 8) | 0xAF, "RMFB derived");
    assert_eq(DRM_IOCTL_MODE_RMFB, 0xC00464AF, "RMFB literal");
    return 0;
}

fn test_drm_mode_fb_cmd2_field_offsets() {
    assert_eq(DRM_MODE_FB_CMD2_FB_ID,     0,  "+0");
    assert_eq(DRM_MODE_FB_CMD2_WIDTH,     4,  "+4");
    assert_eq(DRM_MODE_FB_CMD2_HEIGHT,    8,  "+8");
    assert_eq(DRM_MODE_FB_CMD2_FORMAT,    12, "+12");
    assert_eq(DRM_MODE_FB_CMD2_FLAGS,     16, "+16");
    assert_eq(DRM_MODE_FB_CMD2_HANDLES,   20, "+20");
    assert_eq(DRM_MODE_FB_CMD2_PITCHES,   36, "+36");
    assert_eq(DRM_MODE_FB_CMD2_OFFSETS,   52, "+52");
    assert_eq(DRM_MODE_FB_CMD2_MODIFIERS, 68, "+68");
    assert_eq(DRM_MODE_FB_CMD2_SIZE,      100, "size");
    # Sanity: 4×u32 plane arrays land at correct offsets.
    assert_eq(DRM_MODE_FB_CMD2_HANDLES + 16, DRM_MODE_FB_CMD2_PITCHES,
    "handles[4] ends where pitches starts");
    assert_eq(DRM_MODE_FB_CMD2_PITCHES + 16, DRM_MODE_FB_CMD2_OFFSETS,
    "pitches[4] ends where offsets starts");
    assert_eq(DRM_MODE_FB_CMD2_OFFSETS + 16, DRM_MODE_FB_CMD2_MODIFIERS,
    "offsets[4] ends where modifiers starts");
    assert_eq(DRM_MODE_FB_CMD2_MODIFIERS + 32, DRM_MODE_FB_CMD2_SIZE,
    "modifier[4] u64s end at struct size");
    return 0;
}

fn test_drm_format_fourcc_constants() {
    # Each fourcc is the 4-byte ASCII tag stored little-endian.
    # 'X'=88, 'A'=65, 'R'=82, 'B'=66, '2'=50, '4'=52.
    # XRGB8888 = 'X' | 'R'<<8 | '2'<<16 | '4'<<24
    assert_eq(DRM_FORMAT_XRGB8888, 88 | (82 << 8) | (50 << 16) | (52 << 24),
    "XRGB derived");
    assert_eq(DRM_FORMAT_XRGB8888, 0x34325258, "XRGB literal");
    assert_eq(DRM_FORMAT_ARGB8888, 65 | (82 << 8) | (50 << 16) | (52 << 24),
    "ARGB derived");
    assert_eq(DRM_FORMAT_ARGB8888, 0x34325241, "ARGB literal");
    assert_eq(DRM_FORMAT_XBGR8888, 88 | (66 << 8) | (50 << 16) | (52 << 24),
    "XBGR derived");
    assert_eq(DRM_FORMAT_XBGR8888, 0x34324258, "XBGR literal");
    assert_eq(DRM_FORMAT_ABGR8888, 65 | (66 << 8) | (50 << 16) | (52 << 24),
    "ABGR derived");
    assert_eq(DRM_FORMAT_ABGR8888, 0x34324241, "ABGR literal");
    assert_eq(DRM_FORMAT_MOD_LINEAR, 0, "linear modifier = 0");
    return 0;
}

fn test_native_kms_add_fb_xrgb8888_null_safe() {
    assert_eq(native_kms_add_fb_xrgb8888(0, 1, 256, 256, 1024), 0, "fd=0");
    assert_eq(native_kms_add_fb_xrgb8888(7, 0, 256, 256, 1024), 0, "handle=0");
    assert_eq(native_kms_add_fb_xrgb8888(7, 1,   0, 256, 1024), 0, "w=0");
    assert_eq(native_kms_add_fb_xrgb8888(7, 1, 256,   0, 1024), 0, "h=0");
    assert_eq(native_kms_add_fb_xrgb8888(7, 1, 256, 256,    0), 0, "pitch=0");
    return 0;
}

fn test_native_kms_rm_fb_null_safe() {
    assert_eq(native_kms_rm_fb(0, 1), 0, "fd=0 no-op");
    assert_eq(native_kms_rm_fb(7, 0), 0, "fb_id=0 no-op");
    return 0;
}

# v3 Step 7.2(b) — SETCRTC primitive

fn test_drm_mode_set_crtc_ioctl_number() {
    assert_eq(DRM_IOCTL_MODE_SETCRTC,
    (3 << 30) | (104 << 16) | (0x64 << 8) | 0xA2,
    "SETCRTC derived");
    assert_eq(DRM_IOCTL_MODE_SETCRTC, 0xC06864A2, "SETCRTC literal");
    return 0;
}

fn test_drm_mode_crtc_field_offsets() {
    assert_eq(DRM_MODE_CRTC_CONN_PTR,    0,   "+0");
    assert_eq(DRM_MODE_CRTC_COUNT_CONN,  8,   "+8");
    assert_eq(DRM_MODE_CRTC_CRTC_ID,     12,  "+12");
    assert_eq(DRM_MODE_CRTC_FB_ID,       16,  "+16");
    assert_eq(DRM_MODE_CRTC_X,           20,  "+20");
    assert_eq(DRM_MODE_CRTC_Y,           24,  "+24");
    assert_eq(DRM_MODE_CRTC_GAMMA_SIZE,  28,  "+28");
    assert_eq(DRM_MODE_CRTC_MODE_VALID,  32,  "+32");
    assert_eq(DRM_MODE_CRTC_MODE,        36,  "+36");
    assert_eq(DRM_MODE_CRTC_SIZE,        104, "size");
    # Sanity: the embedded modeinfo at +36 fills the rest of the
    # struct exactly (36 + 68 == 104).
    assert_eq(DRM_MODE_CRTC_MODE + DRM_MODE_MODEINFO_SIZE,
    DRM_MODE_CRTC_SIZE,
    "embedded modeinfo fills to size");
    return 0;
}

fn test_native_kms_set_crtc_null_safe() {
    var conn_ids[4];
    store32(&conn_ids, 99);
    var mode[68];
    memset(&mode, 0, 68);
    assert_eq(native_kms_set_crtc(0, 1, 1, &conn_ids, 1, &mode), -1, "fd=0");
    assert_eq(native_kms_set_crtc(7, 0, 1, &conn_ids, 1, &mode), -1, "crtc=0");
    assert_eq(native_kms_set_crtc(7, 1, 0, &conn_ids, 1, &mode), -1, "fb=0");
    assert_eq(native_kms_set_crtc(7, 1, 1, 0,         1, &mode), -1, "conn_ptr=0");
    assert_eq(native_kms_set_crtc(7, 1, 1, &conn_ids, 0, &mode), -1, "conn_cnt=0");
    assert_eq(native_kms_set_crtc(7, 1, 1, &conn_ids, 1, 0),     -1, "mode=0");
    return 0;
}

fn test_native_kms_disable_crtc_null_safe() {
    assert_eq(native_kms_disable_crtc(0, 1), -1, "fd=0");
    assert_eq(native_kms_disable_crtc(7, 0), -1, "crtc=0");
    return 0;
}

# v3 Step 7.2(c) — PRIME cross-fd BO bridge

fn test_drm_prime_ioctl_numbers() {
    assert_eq(DRM_IOCTL_PRIME_HANDLE_TO_FD,
    (3 << 30) | (12 << 16) | (0x64 << 8) | 0x2D,
    "HANDLE_TO_FD derived");
    assert_eq(DRM_IOCTL_PRIME_HANDLE_TO_FD, 0xC00C642D, "HANDLE_TO_FD literal");
    assert_eq(DRM_IOCTL_PRIME_FD_TO_HANDLE,
    (3 << 30) | (12 << 16) | (0x64 << 8) | 0x2E,
    "FD_TO_HANDLE derived");
    assert_eq(DRM_IOCTL_PRIME_FD_TO_HANDLE, 0xC00C642E, "FD_TO_HANDLE literal");
    return 0;
}

fn test_drm_prime_handle_field_offsets() {
    assert_eq(DRM_PRIME_HANDLE_HANDLE, 0, "+0");
    assert_eq(DRM_PRIME_HANDLE_FLAGS,  4, "+4");
    assert_eq(DRM_PRIME_HANDLE_FD,     8, "+8");
    assert_eq(DRM_PRIME_HANDLE_SIZE,   12, "size");
    return 0;
}

fn test_drm_prime_flag_constants() {
    # DRM_CLOEXEC mirrors O_CLOEXEC (0o2000000 = 0x80000); DRM_RDWR
    # mirrors O_RDWR (0x2). Both pinned so a future "match a different
    # ABI" edit doesn't silently break PRIME export semantics.
    assert_eq(DRM_CLOEXEC, 0x80000, "CLOEXEC");
    assert_eq(DRM_RDWR,    0x2,     "RDWR");
    return 0;
}

fn test_native_kms_import_bo_null_safe() {
    assert_eq(native_kms_import_bo(0, 1, 1), 0, "card_fd=0");
    assert_eq(native_kms_import_bo(1, 0, 1), 0, "render_fd=0");
    assert_eq(native_kms_import_bo(1, 1, 0), 0, "render_handle=0");
    return 0;
}

# v3 Step 7.2(d) — end-to-end modeset driver

fn test_native_kms_lowest_set_bit() {
    assert_eq(native_kms_lowest_set_bit(0x1),  0,  "bit 0");
    assert_eq(native_kms_lowest_set_bit(0x2),  1,  "bit 1");
    assert_eq(native_kms_lowest_set_bit(0xF),  0,  "0xF -> bit 0");
    assert_eq(native_kms_lowest_set_bit(0x8),  3,  "0x8 -> bit 3");
    assert_eq(native_kms_lowest_set_bit(0x80000000), 31, "high bit");
    assert_eq(native_kms_lowest_set_bit(0x0),  -1, "no bits set");
    return 0;
}

fn test_native_kms_scanout_struct_field_offsets() {
    assert_eq(NATIVE_KMS_SCANOUT_CONN_ID,        0,  "conn_id");
    assert_eq(NATIVE_KMS_SCANOUT_CRTC_ID,        4,  "crtc_id");
    assert_eq(NATIVE_KMS_SCANOUT_FB_ID,          8,  "fb_id");
    assert_eq(NATIVE_KMS_SCANOUT_CARD_HANDLE,    12, "card_handle");
    assert_eq(NATIVE_KMS_SCANOUT_RENDER_HANDLE,  16, "render_handle");
    assert_eq(NATIVE_KMS_SCANOUT_WIDTH,          20, "width");
    assert_eq(NATIVE_KMS_SCANOUT_MAPPED_ADDR,    24, "mapped_addr");
    assert_eq(NATIVE_KMS_SCANOUT_HEIGHT,         32, "height");
    assert_eq(NATIVE_KMS_SCANOUT_BO_SIZE,        36, "bo_size");
    assert_eq(NATIVE_KMS_SCANOUT_SIZE,           40, "size");
    return 0;
}

fn test_native_kms_modeset_first_connected_null_safe() {
    var scan[40];
    var dummy[96];
    memset(&dummy, 0, 96);
    assert_eq(native_kms_modeset_first_connected(0, 7, &dummy, &scan), -1, "card_fd=0");
    assert_eq(native_kms_modeset_first_connected(7, 0, &dummy, &scan), -1, "render_fd=0");
    assert_eq(native_kms_modeset_first_connected(7, 7, 0,      &scan), -1, "state=0");
    assert_eq(native_kms_modeset_first_connected(7, 7, &dummy, 0),     -1, "out=0");
    return 0;
}

fn test_drm_master_ioctl_numbers() {
    # Both ioctls have no payload — dir=0, size=0.
    assert_eq(DRM_IOCTL_SET_MASTER,
    (0 << 30) | (0 << 16) | (0x64 << 8) | 0x1E,
    "SET_MASTER derived");
    assert_eq(DRM_IOCTL_SET_MASTER,  0x641E, "SET_MASTER literal");
    assert_eq(DRM_IOCTL_DROP_MASTER, 0x641F, "DROP_MASTER literal");
    return 0;
}

fn test_native_kms_release_scanout_idempotent_on_zero() {
    var scan[40];
    memset(&scan, 0, 40);
    # All fields zero — every conditional inside release skips, no
    # actual ioctl issued. Returns 0.
    assert_eq(native_kms_release_scanout(7, 7, &scan), 0, "zero scanout safe");
    # And it remains zero (no garbage written).
    assert_eq(load32(&scan + NATIVE_KMS_SCANOUT_CRTC_ID), 0, "crtc_id stays 0");
    return 0;
}

# v3 Step 7.4 — page-flip + event read

fn test_drm_mode_page_flip_ioctl_number() {
    assert_eq(DRM_IOCTL_MODE_PAGE_FLIP,
    (3 << 30) | (24 << 16) | (0x64 << 8) | 0xB0,
    "PAGE_FLIP derived");
    assert_eq(DRM_IOCTL_MODE_PAGE_FLIP, 0xC01864B0, "PAGE_FLIP literal");
    return 0;
}

fn test_drm_mode_page_flip_struct_field_offsets() {
    assert_eq(DRM_MODE_PAGE_FLIP_CRTC_ID,   0,  "+0");
    assert_eq(DRM_MODE_PAGE_FLIP_FB_ID,     4,  "+4");
    assert_eq(DRM_MODE_PAGE_FLIP_FLAGS,     8,  "+8");
    assert_eq(DRM_MODE_PAGE_FLIP_RESERVED,  12, "+12");
    assert_eq(DRM_MODE_PAGE_FLIP_USER_DATA, 16, "+16");
    assert_eq(DRM_MODE_PAGE_FLIP_SIZE,      24, "size");
    return 0;
}

fn test_drm_mode_page_flip_flag_constants() {
    assert_eq(DRM_MODE_PAGE_FLIP_EVENT, 0x01, "EVENT");
    assert_eq(DRM_MODE_PAGE_FLIP_ASYNC, 0x02, "ASYNC");
    return 0;
}

fn test_native_kms_page_flip_null_safe() {
    assert_eq(native_kms_page_flip(0, 1, 1, 0, 0), -1, "fd=0");
    assert_eq(native_kms_page_flip(7, 0, 1, 0, 0), -1, "crtc=0");
    assert_eq(native_kms_page_flip(7, 1, 0, 0, 0), -1, "fb=0");
    return 0;
}

fn test_drm_event_struct_constants() {
    # Event type enum.
    assert_eq(DRM_EVENT_VBLANK,        0x01, "VBLANK");
    assert_eq(DRM_EVENT_FLIP_COMPLETE, 0x02, "FLIP_COMPLETE");
    # Event header.
    assert_eq(DRM_EVENT_HEADER_TYPE,   0, "header type +0");
    assert_eq(DRM_EVENT_HEADER_LENGTH, 4, "header length +4");
    assert_eq(DRM_EVENT_HEADER_SIZE,   8, "header size");
    # vblank payload offsets (relative to event start, including header).
    assert_eq(DRM_EVENT_VBLANK_USER_DATA, 8,  "user_data +8");
    assert_eq(DRM_EVENT_VBLANK_TV_SEC,    16, "tv_sec +16");
    assert_eq(DRM_EVENT_VBLANK_TV_USEC,   20, "tv_usec +20");
    assert_eq(DRM_EVENT_VBLANK_SEQUENCE,  24, "sequence +24");
    assert_eq(DRM_EVENT_VBLANK_CRTC_ID,   28, "crtc_id +28");
    assert_eq(DRM_EVENT_VBLANK_SIZE,      32, "vblank size");
    return 0;
}

fn test_drm_event_accessors_round_trip() {
    var buf[32];
    memset(&buf, 0, 32);
    store32(&buf + DRM_EVENT_HEADER_TYPE,         DRM_EVENT_FLIP_COMPLETE);
    store32(&buf + DRM_EVENT_HEADER_LENGTH,       32);
    store64(&buf + DRM_EVENT_VBLANK_USER_DATA,    0xCAFE);
    store32(&buf + DRM_EVENT_VBLANK_SEQUENCE,     42);
    store32(&buf + DRM_EVENT_VBLANK_CRTC_ID,      87);
    assert_eq(drm_event_type(&buf),               DRM_EVENT_FLIP_COMPLETE, "type");
    assert_eq(drm_event_length(&buf),             32,     "length");
    assert_eq(drm_event_vblank_user_data(&buf),   0xCAFE, "user_data");
    assert_eq(drm_event_vblank_sequence(&buf),    42,     "sequence");
    assert_eq(drm_event_vblank_crtc_id(&buf),     87,     "crtc_id");
    return 0;
}

fn test_native_drm_read_event_null_safe() {
    var buf[32];
    assert_eq(native_drm_read_event(0, &buf, 32), -1, "fd=0");
    assert_eq(native_drm_read_event(7, 0,    32), -1, "buf=0");
    assert_eq(native_drm_read_event(7, &buf,  0), -1, "n=0");
    return 0;
}

