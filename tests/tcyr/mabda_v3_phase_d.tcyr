# tests/tcyr/mabda_v3_phase_d.tcyr — v3 Phase D (DRM/KMS surface) tests
#
# Split from mabda_v3.tcyr 2026-04-30 to keep that file under
# cyrius lint's 128 KiB read-buffer cap (see
# `feedback_cyrlint_128k_buffer_cap` memory + the CHANGELOG entry
# under "Step 7.1(a) Fixed"). The boundary is clean: every test
# here exercises `src/backend_native_kms.cyr` exclusively, which
# is the home for all DRM/KMS modesetting state. As 7.x grows
# (per-connector + per-encoder enumeration in 7.1(b/c), modeset
# in 7.2, framebuffer in 7.3, page-flip in 7.4, present in 7.5,
# release in 7.6, public API in 7.7) the new tests land here.

include "src/lib.cyr"
include "lib/assert.cyr"

# ================================================================
# v3 Step 7.1(a) — DRM/KMS GetResources foundation
# ================================================================

fn test_drm_mode_ioctl_numbers() {
    # Re-derive each ioctl from first principles to catch transcription drift.
    assert_eq(DRM_IOCTL_MODE_GETRESOURCES,
              (3 << 30) | (64 << 16) | (0x64 << 8) | 0xA0, "GETRES derived");
    assert_eq(DRM_IOCTL_MODE_GETRESOURCES, 0xC04064A0, "GETRES literal");
    assert_eq(DRM_IOCTL_MODE_GETCONNECTOR,
              (3 << 30) | (80 << 16) | (0x64 << 8) | 0xA7, "GETCONN derived");
    assert_eq(DRM_IOCTL_MODE_GETCONNECTOR, 0xC05064A7, "GETCONN literal");
    assert_eq(DRM_IOCTL_MODE_GETENCODER,
              (3 << 30) | (20 << 16) | (0x64 << 8) | 0xA6, "GETENC derived");
    assert_eq(DRM_IOCTL_MODE_GETENCODER, 0xC01464A6, "GETENC literal");
    return 0;
}

fn test_drm_mode_card_res_field_offsets() {
    assert_eq(DRM_MODE_CARD_RES_FB_PTR,      0,  "+0");
    assert_eq(DRM_MODE_CARD_RES_CRTC_PTR,    8,  "+8");
    assert_eq(DRM_MODE_CARD_RES_CONN_PTR,    16, "+16");
    assert_eq(DRM_MODE_CARD_RES_ENC_PTR,     24, "+24");
    assert_eq(DRM_MODE_CARD_RES_COUNT_FBS,   32, "+32");
    assert_eq(DRM_MODE_CARD_RES_COUNT_CRTCS, 36, "+36");
    assert_eq(DRM_MODE_CARD_RES_COUNT_CONN,  40, "+40");
    assert_eq(DRM_MODE_CARD_RES_COUNT_ENC,   44, "+44");
    assert_eq(DRM_MODE_CARD_RES_MIN_WIDTH,   48, "+48");
    assert_eq(DRM_MODE_CARD_RES_MAX_WIDTH,   52, "+52");
    assert_eq(DRM_MODE_CARD_RES_MIN_HEIGHT,  56, "+56");
    assert_eq(DRM_MODE_CARD_RES_MAX_HEIGHT,  60, "+60");
    assert_eq(DRM_MODE_CARD_RES_SIZE,        64, "size");
    return 0;
}

fn test_kms_state_field_offsets() {
    assert_eq(KMS_STATE_FIELD_FD,             0,  "fd");
    assert_eq(KMS_STATE_FIELD_COUNT_FBS,      8,  "fbs");
    assert_eq(KMS_STATE_FIELD_COUNT_CRTCS,    12, "crtcs");
    assert_eq(KMS_STATE_FIELD_COUNT_CONN,     16, "conn");
    assert_eq(KMS_STATE_FIELD_COUNT_ENCODERS, 20, "enc");
    assert_eq(KMS_STATE_FIELD_FB_IDS,         24, "fb_ids");
    assert_eq(KMS_STATE_FIELD_CRTC_IDS,       32, "crtc_ids");
    assert_eq(KMS_STATE_FIELD_CONN_IDS,       40, "conn_ids");
    assert_eq(KMS_STATE_FIELD_ENC_IDS,        48, "enc_ids");
    assert_eq(KMS_STATE_FIELD_MIN_WIDTH,      56, "min_w");
    assert_eq(KMS_STATE_FIELD_MAX_WIDTH,      60, "max_w");
    assert_eq(KMS_STATE_FIELD_MIN_HEIGHT,     64, "min_h");
    assert_eq(KMS_STATE_FIELD_MAX_HEIGHT,     68, "max_h");
    assert_eq(KMS_STATE_STRUCT_SIZE,          96, "size");
    return 0;
}

fn test_kms_state_accessors_round_trip() {
    var s[96];
    memset(&s, 0, 96);
    store64(&s + KMS_STATE_FIELD_FD,             42);
    store32(&s + KMS_STATE_FIELD_COUNT_FBS,      3);
    store32(&s + KMS_STATE_FIELD_COUNT_CRTCS,    4);
    store32(&s + KMS_STATE_FIELD_COUNT_CONN,     5);
    store32(&s + KMS_STATE_FIELD_COUNT_ENCODERS, 6);
    store64(&s + KMS_STATE_FIELD_FB_IDS,         0xFB);
    store64(&s + KMS_STATE_FIELD_CRTC_IDS,       0xC1);
    store64(&s + KMS_STATE_FIELD_CONN_IDS,       0xC2);
    store64(&s + KMS_STATE_FIELD_ENC_IDS,        0xE1);
    store32(&s + KMS_STATE_FIELD_MIN_WIDTH,      320);
    store32(&s + KMS_STATE_FIELD_MAX_WIDTH,      7680);
    store32(&s + KMS_STATE_FIELD_MIN_HEIGHT,     200);
    store32(&s + KMS_STATE_FIELD_MAX_HEIGHT,     4320);
    assert_eq(kms_state_fd(&s),          42,   "fd");
    assert_eq(kms_state_count_fbs(&s),   3,    "fbs");
    assert_eq(kms_state_count_crtcs(&s), 4,    "crtcs");
    assert_eq(kms_state_count_conn(&s),  5,    "conn");
    assert_eq(kms_state_count_enc(&s),   6,    "enc");
    assert_eq(kms_state_fb_ids(&s),      0xFB, "fb_ids");
    assert_eq(kms_state_crtc_ids(&s),    0xC1, "crtc_ids");
    assert_eq(kms_state_conn_ids(&s),    0xC2, "conn_ids");
    assert_eq(kms_state_enc_ids(&s),     0xE1, "enc_ids");
    assert_eq(kms_state_min_width(&s),   320,  "min_w");
    assert_eq(kms_state_max_width(&s),   7680, "max_w");
    assert_eq(kms_state_min_height(&s),  200,  "min_h");
    assert_eq(kms_state_max_height(&s),  4320, "max_h");
    return 0;
}

fn test_native_kms_release_safe() {
    assert_eq(native_kms_release(0), 0, "null safe");
    var s[96];
    memset(&s, 0xFF, 96);
    native_kms_release(&s);
    assert_eq(load64(&s + KMS_STATE_FIELD_FD),         0, "fd 0");
    assert_eq(load32(&s + KMS_STATE_FIELD_COUNT_CONN), 0, "conn 0");
    assert_eq(load64(&s + KMS_STATE_FIELD_CONN_IDS),   0, "conn_ids 0");
    assert_eq(load32(&s + KMS_STATE_FIELD_MAX_WIDTH),  0, "max_w 0");
    return 0;
}

# ================================================================
# v3 Step 7.1(b) — DRM connector ioctl + struct shapes
# ================================================================

fn test_drm_mode_get_connector_field_offsets() {
    assert_eq(DRM_MODE_GET_CONNECTOR_ENCODERS_PTR,  0,  "+0");
    assert_eq(DRM_MODE_GET_CONNECTOR_MODES_PTR,     8,  "+8");
    assert_eq(DRM_MODE_GET_CONNECTOR_PROPS_PTR,     16, "+16");
    assert_eq(DRM_MODE_GET_CONNECTOR_PROP_VALS_PTR, 24, "+24");
    assert_eq(DRM_MODE_GET_CONNECTOR_COUNT_MODES,   32, "+32");
    assert_eq(DRM_MODE_GET_CONNECTOR_COUNT_PROPS,   36, "+36");
    assert_eq(DRM_MODE_GET_CONNECTOR_COUNT_ENC,     40, "+40");
    assert_eq(DRM_MODE_GET_CONNECTOR_ENCODER_ID,    44, "+44");
    assert_eq(DRM_MODE_GET_CONNECTOR_CONN_ID,       48, "+48");
    assert_eq(DRM_MODE_GET_CONNECTOR_CONN_TYPE,     52, "+52");
    assert_eq(DRM_MODE_GET_CONNECTOR_CONN_TYPE_ID,  56, "+56");
    assert_eq(DRM_MODE_GET_CONNECTOR_CONNECTION,    60, "+60");
    assert_eq(DRM_MODE_GET_CONNECTOR_MM_WIDTH,      64, "+64");
    assert_eq(DRM_MODE_GET_CONNECTOR_MM_HEIGHT,     68, "+68");
    assert_eq(DRM_MODE_GET_CONNECTOR_SUBPIXEL,      72, "+72");
    assert_eq(DRM_MODE_GET_CONNECTOR_SIZE,          80, "size");
    return 0;
}

fn test_drm_mode_modeinfo_field_offsets() {
    # Full per-field pin: 13 numeric fields + name field at +36..+68.
    assert_eq(DRM_MODE_MODEINFO_CLOCK,       0,  "+0");
    assert_eq(DRM_MODE_MODEINFO_HDISPLAY,    4,  "+4");
    assert_eq(DRM_MODE_MODEINFO_HSYNC_START, 6,  "+6");
    assert_eq(DRM_MODE_MODEINFO_HSYNC_END,   8,  "+8");
    assert_eq(DRM_MODE_MODEINFO_HTOTAL,      10, "+10");
    assert_eq(DRM_MODE_MODEINFO_HSKEW,       12, "+12");
    assert_eq(DRM_MODE_MODEINFO_VDISPLAY,    14, "+14");
    assert_eq(DRM_MODE_MODEINFO_VSYNC_START, 16, "+16");
    assert_eq(DRM_MODE_MODEINFO_VSYNC_END,   18, "+18");
    assert_eq(DRM_MODE_MODEINFO_VTOTAL,      20, "+20");
    assert_eq(DRM_MODE_MODEINFO_VSCAN,       22, "+22");
    assert_eq(DRM_MODE_MODEINFO_VREFRESH,    24, "+24");
    assert_eq(DRM_MODE_MODEINFO_FLAGS,       28, "+28");
    assert_eq(DRM_MODE_MODEINFO_TYPE,        32, "+32");
    assert_eq(DRM_MODE_MODEINFO_NAME,        36, "+36");
    assert_eq(DRM_MODE_MODEINFO_NAME_LEN,    32, "name len");
    assert_eq(DRM_MODE_MODEINFO_SIZE,        68, "size");
    assert_eq(DRM_MODE_MODEINFO_NAME + DRM_MODE_MODEINFO_NAME_LEN,
              DRM_MODE_MODEINFO_SIZE, "name fills to size");
    return 0;
}

fn test_drm_mode_connection_status_constants() {
    assert_eq(DRM_MODE_CONNECTED,         1, "connected = 1");
    assert_eq(DRM_MODE_DISCONNECTED,      2, "disconnected = 2");
    assert_eq(DRM_MODE_UNKNOWNCONNECTION, 3, "unknown = 3");
    return 0;
}

fn test_drm_mode_connector_type_constants() {
    # Pin the kernel's connector-type enum. Drift would silently
    # misclassify connectors at runtime.
    assert_eq(DRM_MODE_CONNECTOR_Unknown,     0,  "Unknown");
    assert_eq(DRM_MODE_CONNECTOR_VGA,         1,  "VGA");
    assert_eq(DRM_MODE_CONNECTOR_DVII,        2,  "DVI-I");
    assert_eq(DRM_MODE_CONNECTOR_DVID,        3,  "DVI-D");
    assert_eq(DRM_MODE_CONNECTOR_DVIA,        4,  "DVI-A");
    assert_eq(DRM_MODE_CONNECTOR_DisplayPort, 10, "DP");
    assert_eq(DRM_MODE_CONNECTOR_HDMIA,       11, "HDMI-A");
    assert_eq(DRM_MODE_CONNECTOR_HDMIB,       12, "HDMI-B");
    assert_eq(DRM_MODE_CONNECTOR_eDP,         14, "eDP");
    assert_eq(DRM_MODE_CONNECTOR_VIRTUAL,     15, "Virtual");
    assert_eq(DRM_MODE_CONNECTOR_DSI,         16, "DSI");
    assert_eq(DRM_MODE_CONNECTOR_USB,         20, "USB-C");
    return 0;
}

# ================================================================
# v3 Step 7.1(c) — Encoder ioctl + topology summary
# ================================================================

fn test_drm_mode_get_encoder_field_offsets() {
    assert_eq(DRM_MODE_GET_ENCODER_ID,         0,  "+0");
    assert_eq(DRM_MODE_GET_ENCODER_TYPE,       4,  "+4");
    assert_eq(DRM_MODE_GET_ENCODER_CRTC_ID,    8,  "+8");
    assert_eq(DRM_MODE_GET_ENCODER_POSS_CRTCS, 12, "+12");
    assert_eq(DRM_MODE_GET_ENCODER_POSS_CLONES, 16, "+16");
    assert_eq(DRM_MODE_GET_ENCODER_SIZE,       20, "size");
    return 0;
}

fn test_drm_mode_encoder_type_constants() {
    assert_eq(DRM_MODE_ENCODER_NONE,    0, "None");
    assert_eq(DRM_MODE_ENCODER_DAC,     1, "DAC");
    assert_eq(DRM_MODE_ENCODER_TMDS,    2, "TMDS");
    assert_eq(DRM_MODE_ENCODER_LVDS,    3, "LVDS");
    assert_eq(DRM_MODE_ENCODER_TVDAC,   4, "TVDAC");
    assert_eq(DRM_MODE_ENCODER_VIRTUAL, 5, "Virtual");
    assert_eq(DRM_MODE_ENCODER_DSI,     6, "DSI");
    assert_eq(DRM_MODE_ENCODER_DPMST,   7, "DP-MST");
    assert_eq(DRM_MODE_ENCODER_DPI,     8, "DPI");
    return 0;
}

fn test_native_drm_connector_type_name_lookup() {
    # streq isn't in scope — compare by first byte (cheap proxy
    # that catches a "wrong table entry" regression without pulling
    # the full string compare in).
    assert_eq(load8(native_drm_connector_type_name(DRM_MODE_CONNECTOR_VGA)),         86, "VGA -> V");
    assert_eq(load8(native_drm_connector_type_name(DRM_MODE_CONNECTOR_DisplayPort)), 68, "DP -> D");
    assert_eq(load8(native_drm_connector_type_name(DRM_MODE_CONNECTOR_HDMIA)),       72, "HDMI-A -> H");
    assert_eq(load8(native_drm_connector_type_name(DRM_MODE_CONNECTOR_eDP)),         101, "eDP -> e");
    assert_eq(load8(native_drm_connector_type_name(99)),                              63, "unknown -> ?");
    return 0;
}

fn test_native_drm_encoder_type_name_lookup() {
    assert_eq(load8(native_drm_encoder_type_name(DRM_MODE_ENCODER_TMDS)),    84,  "TMDS -> T");
    assert_eq(load8(native_drm_encoder_type_name(DRM_MODE_ENCODER_DAC)),     68,  "DAC -> D");
    assert_eq(load8(native_drm_encoder_type_name(DRM_MODE_ENCODER_LVDS)),    76,  "LVDS -> L");
    assert_eq(load8(native_drm_encoder_type_name(DRM_MODE_ENCODER_VIRTUAL)), 86,  "Virtual -> V");
    assert_eq(load8(native_drm_encoder_type_name(99)),                       63,  "unknown -> ?");
    return 0;
}

fn test_native_drm_connection_status_name_lookup() {
    assert_eq(load8(native_drm_connection_status_name(DRM_MODE_CONNECTED)),         99,  "connected -> c");
    assert_eq(load8(native_drm_connection_status_name(DRM_MODE_DISCONNECTED)),      100, "disconnected -> d");
    assert_eq(load8(native_drm_connection_status_name(DRM_MODE_UNKNOWNCONNECTION)), 117, "unknown -> u");
    assert_eq(load8(native_drm_connection_status_name(99)),                         63,  "fallback -> ?");
    return 0;
}

fn test_native_kms_summary_null_safe() {
    # Null state returns -1 immediately (no syscalls).
    assert_eq(native_kms_summary(0), -1, "null state");
    # Non-null state with fd=0 also returns -1 (no syscalls).
    var s[96];
    memset(&s, 0, 96);
    store64(&s + KMS_STATE_FIELD_FD, 0);
    assert_eq(native_kms_summary(&s), -1, "fd=0 state");
    return 0;
}

fn main() {
    # v3 Step 7.1(a) — DRM/KMS GetResources foundation (5)
    test_drm_mode_ioctl_numbers();
    test_drm_mode_card_res_field_offsets();
    test_kms_state_field_offsets();
    test_kms_state_accessors_round_trip();
    test_native_kms_release_safe();

    # v3 Step 7.1(b) — DRM connector ioctl + struct shapes (4)
    test_drm_mode_get_connector_field_offsets();
    test_drm_mode_modeinfo_field_offsets();
    test_drm_mode_connection_status_constants();
    test_drm_mode_connector_type_constants();

    # v3 Step 7.1(c) — Encoder ioctl + topology summary (6)
    test_drm_mode_get_encoder_field_offsets();
    test_drm_mode_encoder_type_constants();
    test_native_drm_connector_type_name_lookup();
    test_native_drm_encoder_type_name_lookup();
    test_native_drm_connection_status_name_lookup();
    test_native_kms_summary_null_safe();

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
