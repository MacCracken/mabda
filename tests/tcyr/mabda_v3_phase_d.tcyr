# tests/tcyr/mabda_v3_phase_d.tcyr — v3 Phase D (DRM/KMS surface) tests
#
# Split from mabda_v3.tcyr 2026-04-30 to keep that file under
# cyrius lint's 128 KiB read-buffer cap (see
# `feedback_cyrlint_128k_buffer_cap` memory + the CHANGELOG entry
# under "Step 7.1(a) Fixed"). The boundary is clean: every test
# here exercises `src/backend_native_kms.cyr` exclusively, which
# is the home for all DRM/KMS modesetting state. As 7.x grows
# (per-connector + per-encoder enumeration in 7.1(b/c), modeset
# in 7.2, framebuffer in 7.3, page-flip in 7.4, present in 7.5,
# release in 7.6, public API in 7.7) the new tests land here.

include "src/lib.cyr"
include "lib/assert.cyr"

# ================================================================
# v3 Step 7.1(a) — DRM/KMS GetResources foundation
# ================================================================

fn test_drm_mode_ioctl_numbers() {
    # Re-derive each ioctl from first principles to catch transcription drift.
    assert_eq(DRM_IOCTL_MODE_GETRESOURCES,
    (3 << 30) | (64 << 16) | (0x64 << 8) | 0xA0, "GETRES derived");
    assert_eq(DRM_IOCTL_MODE_GETRESOURCES, 0xC04064A0, "GETRES literal");
    assert_eq(DRM_IOCTL_MODE_GETCONNECTOR,
    (3 << 30) | (80 << 16) | (0x64 << 8) | 0xA7, "GETCONN derived");
    assert_eq(DRM_IOCTL_MODE_GETCONNECTOR, 0xC05064A7, "GETCONN literal");
    assert_eq(DRM_IOCTL_MODE_GETENCODER,
    (3 << 30) | (20 << 16) | (0x64 << 8) | 0xA6, "GETENC derived");
    assert_eq(DRM_IOCTL_MODE_GETENCODER, 0xC01464A6, "GETENC literal");
    return 0;
}

fn test_drm_mode_card_res_field_offsets() {
    assert_eq(DRM_MODE_CARD_RES_FB_PTR,      0,  "+0");
    assert_eq(DRM_MODE_CARD_RES_CRTC_PTR,    8,  "+8");
    assert_eq(DRM_MODE_CARD_RES_CONN_PTR,    16, "+16");
    assert_eq(DRM_MODE_CARD_RES_ENC_PTR,     24, "+24");
    assert_eq(DRM_MODE_CARD_RES_COUNT_FBS,   32, "+32");
    assert_eq(DRM_MODE_CARD_RES_COUNT_CRTCS, 36, "+36");
    assert_eq(DRM_MODE_CARD_RES_COUNT_CONN,  40, "+40");
    assert_eq(DRM_MODE_CARD_RES_COUNT_ENC,   44, "+44");
    assert_eq(DRM_MODE_CARD_RES_MIN_WIDTH,   48, "+48");
    assert_eq(DRM_MODE_CARD_RES_MAX_WIDTH,   52, "+52");
    assert_eq(DRM_MODE_CARD_RES_MIN_HEIGHT,  56, "+56");
    assert_eq(DRM_MODE_CARD_RES_MAX_HEIGHT,  60, "+60");
    assert_eq(DRM_MODE_CARD_RES_SIZE,        64, "size");
    return 0;
}

fn test_kms_state_field_offsets() {
    assert_eq(KMS_STATE_FIELD_FD,             0,  "fd");
    assert_eq(KMS_STATE_FIELD_COUNT_FBS,      8,  "fbs");
    assert_eq(KMS_STATE_FIELD_COUNT_CRTCS,    12, "crtcs");
    assert_eq(KMS_STATE_FIELD_COUNT_CONN,     16, "conn");
    assert_eq(KMS_STATE_FIELD_COUNT_ENCODERS, 20, "enc");
    assert_eq(KMS_STATE_FIELD_FB_IDS,         24, "fb_ids");
    assert_eq(KMS_STATE_FIELD_CRTC_IDS,       32, "crtc_ids");
    assert_eq(KMS_STATE_FIELD_CONN_IDS,       40, "conn_ids");
    assert_eq(KMS_STATE_FIELD_ENC_IDS,        48, "enc_ids");
    assert_eq(KMS_STATE_FIELD_MIN_WIDTH,      56, "min_w");
    assert_eq(KMS_STATE_FIELD_MAX_WIDTH,      60, "max_w");
    assert_eq(KMS_STATE_FIELD_MIN_HEIGHT,     64, "min_h");
    assert_eq(KMS_STATE_FIELD_MAX_HEIGHT,     68, "max_h");
    assert_eq(KMS_STATE_STRUCT_SIZE,          96, "size");
    return 0;
}

fn test_kms_state_accessors_round_trip() {
    var s[96];
    memset(&s, 0, 96);
    store64(&s + KMS_STATE_FIELD_FD,             42);
    store32(&s + KMS_STATE_FIELD_COUNT_FBS,      3);
    store32(&s + KMS_STATE_FIELD_COUNT_CRTCS,    4);
    store32(&s + KMS_STATE_FIELD_COUNT_CONN,     5);
    store32(&s + KMS_STATE_FIELD_COUNT_ENCODERS, 6);
    store64(&s + KMS_STATE_FIELD_FB_IDS,         0xFB);
    store64(&s + KMS_STATE_FIELD_CRTC_IDS,       0xC1);
    store64(&s + KMS_STATE_FIELD_CONN_IDS,       0xC2);
    store64(&s + KMS_STATE_FIELD_ENC_IDS,        0xE1);
    store32(&s + KMS_STATE_FIELD_MIN_WIDTH,      320);
    store32(&s + KMS_STATE_FIELD_MAX_WIDTH,      7680);
    store32(&s + KMS_STATE_FIELD_MIN_HEIGHT,     200);
    store32(&s + KMS_STATE_FIELD_MAX_HEIGHT,     4320);
    assert_eq(kms_state_fd(&s),          42,   "fd");
    assert_eq(kms_state_count_fbs(&s),   3,    "fbs");
    assert_eq(kms_state_count_crtcs(&s), 4,    "crtcs");
    assert_eq(kms_state_count_conn(&s),  5,    "conn");
    assert_eq(kms_state_count_enc(&s),   6,    "enc");
    assert_eq(kms_state_fb_ids(&s),      0xFB, "fb_ids");
    assert_eq(kms_state_crtc_ids(&s),    0xC1, "crtc_ids");
    assert_eq(kms_state_conn_ids(&s),    0xC2, "conn_ids");
    assert_eq(kms_state_enc_ids(&s),     0xE1, "enc_ids");
    assert_eq(kms_state_min_width(&s),   320,  "min_w");
    assert_eq(kms_state_max_width(&s),   7680, "max_w");
    assert_eq(kms_state_min_height(&s),  200,  "min_h");
    assert_eq(kms_state_max_height(&s),  4320, "max_h");
    return 0;
}

fn test_native_kms_release_safe() {
    assert_eq(native_kms_release(0), 0, "null safe");
    var s[96];
    memset(&s, 0xFF, 96);
    native_kms_release(&s);
    assert_eq(load64(&s + KMS_STATE_FIELD_FD),         0, "fd 0");
    assert_eq(load32(&s + KMS_STATE_FIELD_COUNT_CONN), 0, "conn 0");
    assert_eq(load64(&s + KMS_STATE_FIELD_CONN_IDS),   0, "conn_ids 0");
    assert_eq(load32(&s + KMS_STATE_FIELD_MAX_WIDTH),  0, "max_w 0");
    return 0;
}

