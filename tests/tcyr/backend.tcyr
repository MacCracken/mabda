# ================================================================
# v3 Step 3f — gpu_device_wait_idle dispatch
# ================================================================
# Single-arg dispatcher; validates fncall1 on a third distinct
# slot (ctx_release in 3b, smoke test in 1, this slot now).

var _step3f_wait_count = 0;

var _step3f_wait_ctx = 0;

fn _step3f_wait_capture(ctx) {
    _step3f_wait_count = _step3f_wait_count + 1;
    _step3f_wait_ctx = ctx;
    return 0;
}

# ================================================================
# v3 Step 3g — gpu_compute_dispatch dispatch (fncall6)
# ================================================================
# Highest-arity slot. First Cyrius-to-Cyrius fncall6 through a
# struct slot in mabda. Distinct sentinels chosen for each arg so
# any swap/rotation surfaces as a specific assertion failure.

var _step3g_dispatch_count = 0;

var _step3g_dispatch_ctx = 0;

var _step3g_dispatch_shmod = 0;

var _step3g_dispatch_x = 0;

var _step3g_dispatch_y = 0;

var _step3g_dispatch_z = 0;

var _step3g_dispatch_bp = 0;

fn _step3g_dispatch_capture(ctx, shmod, x, y, z, bp) {
    _step3g_dispatch_count = _step3g_dispatch_count + 1;
    _step3g_dispatch_ctx = ctx;
    _step3g_dispatch_shmod = shmod;
    _step3g_dispatch_x = x;
    _step3g_dispatch_y = y;
    _step3g_dispatch_z = z;
    _step3g_dispatch_bp = bp;
    return 0xD15A;
}

# ================================================================
# v3 Step 4f.iii — Resource tracker ctx-aware integration
# ================================================================
# FrameResources grew from 16 → 24 bytes; +0 holds an optional
# GpuContext*. frame_resources_release_buffers routes through
# gpu_buffer_release(ctx, h), which dispatches through
# ctx->backend->buffer_release. Mock-backend tests below verify
# dispatch semantics; counter increments per call confirm the
# tracker calls the slot exactly once per tracked handle.

var _step4f3_release_count = 0;

var _step4f3_release_handles[64];

fn _step4f3_release_capture(ctx, buf) {
    var idx = _step4f3_release_count;
    if (idx < 8) {
        store64(&_step4f3_release_handles + idx * 8, buf);
    }
    _step4f3_release_count = _step4f3_release_count + 1;
    return 0;
}

