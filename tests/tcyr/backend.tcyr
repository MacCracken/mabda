fn test_gpu_shader_module_create_dispatches_through_backend() {
    _step3e_create_count = 0;
    var b = backend_new();
    backend_set_kind(b, BACKEND_KIND_WGPU);
    backend_set_slot(b, BACKEND_SLOT_SHADER_MODULE_CREATE, &_step3e_shmod_create_capture);
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx + 32, b);
    var got = gpu_shader_module_create(ctx, 0xCAFE, 256);
    assert_eq(got, 0xBA5, "slot return propagates");
    assert_eq(_step3e_create_count, 1, "slot dispatched once");
    assert_eq(_step3e_create_ctx, ctx, "arg 1 = ctx");
    assert_eq(_step3e_create_bytes, 0xCAFE, "arg 2 = bytes");
    assert_eq(_step3e_create_n, 256, "arg 3 = n");
    # v3.2 Phase S — wgpu backend forwards SHADER_SRC_WGSL by default.
    assert_eq(_step3e_create_kind, SHADER_SRC_WGSL, "arg 4 = kind WGSL (wgpu default)");
    # A native (AMD) backend forwards SHADER_SRC_GFX9.
    backend_set_kind(b, BACKEND_KIND_AMD);
    gpu_shader_module_create(ctx, 0xCAFE, 256);
    assert_eq(_step3e_create_kind, SHADER_SRC_GFX9, "native default kind = GFX9");
    # gpu_shader_module_create_spirv forwards SHADER_SRC_SPIRV regardless of backend.
    gpu_shader_module_create_spirv(ctx, 0xBEEF, 20);
    assert_eq(_step3e_create_kind, SHADER_SRC_SPIRV, "create_spirv forwards SPIRV");
    assert_eq(_step3e_create_bytes, 0xBEEF, "spirv words_ptr forwarded");
    assert_eq(_step3e_create_n, 20, "spirv byte_len forwarded");
    return 0;
}

