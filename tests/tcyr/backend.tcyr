    memset(ctx, 0, 112);
    store64(ctx + 32, b);
    var rc = gpu_render_pass_draw(ctx, 0xBEEF07, 0xBEEF08, 3, 1);
    assert_eq(rc, 0, "slot return value propagates");
    assert_eq(_step69_pass_draw_count, 1, "slot dispatched once");
    assert_eq(_step69_pass_draw_ctx, ctx, "arg 1 = ctx");
    assert_eq(_step69_pass_draw_pass, 0xBEEF07, "arg 2 = pass");
    assert_eq(_step69_pass_draw_pipe, 0xBEEF08, "arg 3 = pipe");
    assert_eq(_step69_pass_draw_vc, 3, "arg 4 = vertex_count");
    assert_eq(_step69_pass_draw_ic, 1, "arg 5 = instance_count");
    return 0;
}

fn test_gpu_render_pass_end_dispatches_through_backend() {
    _step69_pass_end_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_RENDER_PASS_END,
    &_step69_pass_end_capture);
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx + 32, b);
    gpu_render_pass_end(ctx, 0xBEEF09);
    assert_eq(_step69_pass_end_count, 1, "slot dispatched once");
    return 0;
}

# v3 Step 7.7 — public surface API

fn test_gpu_context_size_extended_to_168() {
    # The GpuContext layout: 112 → 120 at v3 rc.2 audit MED-7 (PM4
    # scratch at +112); 120 → 128 at v3.1 M.1(c) (texture VA bump cursor
    # at +120); 128 → 160 at v3.1 Q.1 (queue table at +128..+152); 160 →
    # 168 at v3.2.14 R.5 (IB-slot cursor at +160). Pin the size + the new
    # field offsets so a future refactor can't silently shrink the struct.
    assert_eq(GPU_CONTEXT_SIZE, 168, "extended ctx = 168");
    # PM4 scratch buffer size kept in sync — the slot fns memset 256
    # (compute) or 1024 (render) of this buffer; bumping above 1024
    # requires updating both slots.
    assert_eq(_NATIVE_PM4_SCRATCH_BYTES, 2048, "scratch = 2048 bytes (v3.2 TS.5)");
    return 0;
}

# v3.2 X.5 — buffer-copy dispatch through BACKEND_SLOT_BUFFER_COPY.
# Capture mock pins that gpu_queue_transfer_copy carries all five args
# (ctx, queue, src, dst, bytes) through fncall5 in order.
var _x5_copy_count = 0;
var _x5_copy_ctx   = 0;
var _x5_copy_queue = 0;
var _x5_copy_src   = 0;
var _x5_copy_dst   = 0;
var _x5_copy_bytes = 0;

fn _x5_copy_capture(ctx, queue, src, dst, bytes): i64 {
    _x5_copy_count = _x5_copy_count + 1;
    _x5_copy_ctx   = ctx;
    _x5_copy_queue = queue;
    _x5_copy_src   = src;
    _x5_copy_dst   = dst;
    _x5_copy_bytes = bytes;
    return 0xC0FFEE;
}

fn test_gpu_queue_transfer_copy_dispatches_through_backend() {
    _x5_copy_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_BUFFER_COPY, &_x5_copy_capture);
    var ctx = alloc(GPU_CONTEXT_SIZE);
    memset(ctx, 0, GPU_CONTEXT_SIZE);
    store64(ctx + 32, b);
    var rc = gpu_queue_transfer_copy(ctx, 0xAA, 0xBB, 0xCC, 128);
    assert_eq(rc, 0xC0FFEE, "slot return value propagated");
    assert_eq(_x5_copy_count, 1, "slot dispatched exactly once");
    assert_eq(_x5_copy_ctx,   ctx,  "arg 1 = ctx");
    assert_eq(_x5_copy_queue, 0xAA, "arg 2 = queue");
    assert_eq(_x5_copy_src,   0xBB, "arg 3 = src_buf");
    assert_eq(_x5_copy_dst,   0xCC, "arg 4 = dst_buf");
    assert_eq(_x5_copy_bytes, 128,  "arg 5 = bytes");
    # Null-slot backend -> GPU_ERR_NOT_IMPLEMENTED (X.5/X.6 gap; see docs/archive/punchlists/3-2-punchlist.md).
    var b2 = backend_new();
    var ctx2 = alloc(GPU_CONTEXT_SIZE);
    memset(ctx2, 0, GPU_CONTEXT_SIZE);
    store64(ctx2 + 32, b2);
    assert_eq(gpu_queue_transfer_copy(ctx2, 0xAA, 0xBB, 0xCC, 128),
    GPU_ERR_NOT_IMPLEMENTED, "null buffer_copy slot -> NOT_IMPLEMENTED");   #skip-lint
    assert_eq(gpu_queue_transfer_copy(0, 0xAA, 0xBB, 0xCC, 128),
    GPU_ERR_OTHER, "null ctx -> GPU_ERR_OTHER");
    assert_eq(gpu_queue_transfer_copy(ctx2, 0, 0xBB, 0xCC, 128),
    GPU_ERR_OTHER, "null queue -> GPU_ERR_OTHER");
    # Audit HIGH-1: a non-4-byte-multiple size is rejected uniformly
    # BEFORE dispatch, so the slot never sees it (count stays at 1).
    _x5_copy_count = 0;
    assert_eq(gpu_queue_transfer_copy(ctx, 0xAA, 0xBB, 0xCC, 67),
    GPU_ERR_BUFFER, "non-4B-multiple size -> GPU_ERR_BUFFER");
    assert_eq(_x5_copy_count, 0, "sub-DWORD copy not dispatched to slot");
    return 0;
}

# v3.2 X.6 (audit) — gpu_buffer_copy positive path: resolves the implicit
# transfer queue via the queue_get slot, then dispatches to buffer_copy
# with that queue. Plus the alignment guard fires before queue resolution.
var _x6bc_qget_q = 0;
fn _x6bc_qget_stub(ctx, kind): i64 { return _x6bc_qget_q; }

fn test_gpu_buffer_copy_positive_path() {
    _x5_copy_count = 0;
    _x6bc_qget_q = 0x5151;   # sentinel "queue" the stub hands back
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_QUEUE_GET, &_x6bc_qget_stub);
    backend_set_slot(b, BACKEND_SLOT_BUFFER_COPY, &_x5_copy_capture);
    var ctx = alloc(GPU_CONTEXT_SIZE);
    memset(ctx, 0, GPU_CONTEXT_SIZE);
    store64(ctx + 32, b);
    var rc = gpu_buffer_copy(ctx, 0xBB, 0xCC, 256);
    assert_eq(rc, 0xC0FFEE, "slot return propagated");
    assert_eq(_x5_copy_count, 1, "dispatched once");
    assert_eq(_x5_copy_queue, 0x5151, "queue = the resolved transfer queue");
    assert_eq(_x5_copy_src,   0xBB, "src forwarded");
    assert_eq(_x5_copy_dst,   0xCC, "dst forwarded");
    assert_eq(_x5_copy_bytes, 256,  "bytes forwarded");
    return 0;
}

fn test_gpu_buffer_copy_guards() {
    # null ctx -> GPU_ERR_BUFFER (before any slot/queue touch).
    assert_eq(gpu_buffer_copy(0, 0xBB, 0xCC, 64),
    GPU_ERR_BUFFER, "null ctx -> GPU_ERR_BUFFER");
    # Audit HIGH-1: alignment guard fires before queue resolution.
    var b = backend_new();
    var ctx = alloc(GPU_CONTEXT_SIZE);
    memset(ctx, 0, GPU_CONTEXT_SIZE);
    store64(ctx + 32, b);
    assert_eq(gpu_buffer_copy(ctx, 0xBB, 0xCC, 67),
    GPU_ERR_BUFFER, "non-4B-multiple size -> GPU_ERR_BUFFER (pre-queue)");
    # Empty backend: gpu_queue_get's slot is null, so the implicit
    # transfer queue can't be resolved -> GPU_ERR_OTHER (before the
    # buffer_copy slot is consulted).
    assert_eq(gpu_buffer_copy(ctx, 0xBB, 0xCC, 64),
    GPU_ERR_OTHER, "unresolvable transfer queue -> GPU_ERR_OTHER");
    return 0;
}

# v3.2 X.6 (audit tests-gaps) — CPU guard coverage for the wgpu copy
# filler. Only the early guards are CPU-safe (the size-bound checks call
# wgpu FFI); these all return before any wgpu call.
fn test_wgpu_buffer_copy_guards() {
    var ctx = alloc(GPU_CONTEXT_SIZE);
    memset(ctx, 0, GPU_CONTEXT_SIZE);
    assert_eq(_backend_wgpu_buffer_copy(0, 0x7, 0xBB, 0xCC, 64),
    GPU_ERR_OTHER, "null ctx -> GPU_ERR_OTHER");
    assert_eq(_backend_wgpu_buffer_copy(ctx, 0, 0xBB, 0xCC, 64),
    GPU_ERR_OTHER, "null queue -> GPU_ERR_OTHER");
    assert_eq(_backend_wgpu_buffer_copy(ctx, 0x7, 0, 0xCC, 64),
    GPU_ERR_BUFFER, "null src -> GPU_ERR_BUFFER");
    assert_eq(_backend_wgpu_buffer_copy(ctx, 0x7, 0xBB, 0, 64),
    GPU_ERR_BUFFER, "null dst -> GPU_ERR_BUFFER");
    assert_eq(_backend_wgpu_buffer_copy(ctx, 0x7, 0xBB, 0xCC, 0),
    GPU_ERR_BUFFER, "zero bytes -> GPU_ERR_BUFFER");
    return 0;
}

# v3.2 TS.3 — sampleable-texture scaffolding: sampler intent + the two new
# public dispatchers routing through the (TS.5-filled) backend slots.
var _ts3_cs_count = 0;
var _ts3_cs_ctx = 0;
var _ts3_cs_w = 0;
var _ts3_cs_h = 0;
var _ts3_cs_fmt = 0;
fn _ts3_cs_capture(ctx, w, h, fmt): i64 {
    _ts3_cs_count = _ts3_cs_count + 1;
    _ts3_cs_ctx = ctx; _ts3_cs_w = w; _ts3_cs_h = h; _ts3_cs_fmt = fmt;
    return 0xC5A;
}
var _ts3_bind_count = 0;
var _ts3_bind_ctx = 0;
var _ts3_bind_pass = 0;
var _ts3_bind_tex = 0;
var _ts3_bind_samp = 0;
fn _ts3_bind_capture(ctx, pass, tex, samp): i64 {
    _ts3_bind_count = _ts3_bind_count + 1;
    _ts3_bind_ctx = ctx; _ts3_bind_pass = pass; _ts3_bind_tex = tex; _ts3_bind_samp = samp;
    return 0;
}

fn test_gpu_sampler_create() {
    var ctx[168];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    var s = gpu_sampler_create(&ctx, NATIVE_SAMP_FILTER_POINT, NATIVE_SAMP_ADDR_CLAMP);
    assert(s != 0, "point+clamp -> non-zero handle (tag avoids 0)");
    assert_eq(gpu_sampler_is_valid(s), 1, "tagged valid");
    assert_eq(gpu_sampler_filter(s), NATIVE_SAMP_FILTER_POINT, "filter unpacks POINT");
    assert_eq(gpu_sampler_addr(s), NATIVE_SAMP_ADDR_CLAMP, "addr unpacks CLAMP");
    var s2 = gpu_sampler_create(&ctx, NATIVE_SAMP_FILTER_BILINEAR, NATIVE_SAMP_ADDR_WRAP);
    assert_eq(gpu_sampler_filter(s2), NATIVE_SAMP_FILTER_BILINEAR, "filter unpacks BILINEAR");
    assert_eq(gpu_sampler_addr(s2), NATIVE_SAMP_ADDR_WRAP, "addr unpacks WRAP");
    assert_eq(gpu_sampler_create(0, 0, 0), 0, "null ctx -> 0");
    assert_eq(gpu_sampler_create(&ctx, 99, 0), 0, "bad filter -> 0");
    assert_eq(gpu_sampler_create(&ctx, 0, 99), 0, "bad addr -> 0");
    assert_eq(gpu_sampler_is_valid(0), 0, "0 is not a valid handle");
    return 0;
}

fn test_gpu_texture_create_2d_sampleable_dispatch() {
    _ts3_cs_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_CREATE_2D_SAMPLEABLE, &_ts3_cs_capture);
    var ctx = alloc(GPU_CONTEXT_SIZE);
    memset(ctx, 0, GPU_CONTEXT_SIZE);
    store64(ctx + 32, b);
    var r = gpu_texture_create_2d_sampleable(ctx, 64, 64, MABDA_TEXFMT_RGBA8);
    assert_eq(r, 0xC5A, "slot return propagated");
    assert_eq(_ts3_cs_count, 1, "dispatched once");
    assert_eq(_ts3_cs_ctx, ctx, "arg1 ctx");
    assert_eq(_ts3_cs_w, 64, "arg2 width");
    assert_eq(_ts3_cs_h, 64, "arg3 height");
    assert_eq(_ts3_cs_fmt, MABDA_TEXFMT_RGBA8, "arg4 fmt");
    # null slot (the TS.3/TS.5 gap) -> 0; guards return before the slot.
    var b2 = backend_new();
    var ctx2 = alloc(GPU_CONTEXT_SIZE);
    memset(ctx2, 0, GPU_CONTEXT_SIZE);
    store64(ctx2 + 32, b2);
    assert_eq(gpu_texture_create_2d_sampleable(ctx2, 64, 64, MABDA_TEXFMT_RGBA8),
    0, "null slot -> 0");
    assert_eq(gpu_texture_create_2d_sampleable(0, 64, 64, 0), 0, "null ctx -> 0");
    assert_eq(gpu_texture_create_2d_sampleable(ctx, 0, 64, 0), 0, "w<=0 -> 0");
    assert_eq(gpu_texture_create_2d_sampleable(ctx, 64, 64, 99), 0, "bad fmt -> 0");
    return 0;
}

# v3.3 AL.1 — gpu_texture_write_level routes (ctx,tex,level,src,n) through
# BACKEND_SLOT_TEXTURE_WRITE_LEVEL via fncall5; guards reject before the slot.
var _al1_count = 0;
var _al1_ctx = 0;
var _al1_tex = 0;
var _al1_level = 0;
var _al1_src = 0;
var _al1_n = 0;
fn _al1_capture(ctx, tex, level, src, n) {
    _al1_count = _al1_count + 1;
    _al1_ctx = ctx;
    _al1_tex = tex;
    _al1_level = level;
    _al1_src = src;
    _al1_n = n;
    return 0xABC;
}

fn test_gpu_texture_write_level_dispatch() {
    _al1_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_WRITE_LEVEL, &_al1_capture);
    var ctx = alloc(GPU_CONTEXT_SIZE);
    memset(ctx, 0, GPU_CONTEXT_SIZE);
    store64(ctx + 32, b);
    var rc = gpu_texture_write_level(ctx, 0x111, 2, 0x222, 64);
    assert_eq(rc, 0xABC, "slot return propagated");
    assert_eq(_al1_count, 1, "dispatched once");
    assert_eq(_al1_ctx, ctx, "arg1 ctx");
    assert_eq(_al1_tex, 0x111, "arg2 tex");
    assert_eq(_al1_level, 2, "arg3 level");
    assert_eq(_al1_src, 0x222, "arg4 src");
    assert_eq(_al1_n, 64, "arg5 n");
    # Guards return before the slot.
    _al1_count = 0;
    assert_eq(gpu_texture_write_level(0, 0x111, 0, 0x222, 64), GPU_ERR_OTHER, "null ctx -> OTHER");
    assert_eq(gpu_texture_write_level(ctx, 0x111, 0 - 1, 0x222, 64), GPU_ERR_TEXTURE, "neg level -> TEXTURE");
    assert_eq(_al1_count, 0, "guards reject before dispatch");
    return 0;
}

# v3.3 AL.2 — gpu_texture_create_2d_fmt_mipped routes (ctx,w,h,fmt,mc) through
# BACKEND_SLOT_TEXTURE_CREATE_2D_FMT_MIPPED via fncall5; mip_count 0 -> full
# chain; bad fmt / dims / over-chain / null ctx reject before the slot.
var _al2_count = 0;
var _al2_w = 0;
var _al2_h = 0;
var _al2_fmt = 0;
var _al2_mc = 0;
fn _al2_capture(ctx, w, h, fmt, mc) {
    _al2_count = _al2_count + 1;
    _al2_w = w;
    _al2_h = h;
    _al2_fmt = fmt;
    _al2_mc = mc;
    return 0xD2;
}

fn test_gpu_texture_create_2d_fmt_mipped_dispatch() {
    _al2_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_CREATE_2D_FMT_MIPPED, &_al2_capture);
    var ctx = alloc(GPU_CONTEXT_SIZE);
    memset(ctx, 0, GPU_CONTEXT_SIZE);
    store64(ctx + 32, b);
    var r = gpu_texture_create_2d_fmt_mipped(ctx, 64, 64, MABDA_TEXFMT_BC1, 3);
    assert_eq(r, 0xD2, "slot return propagated");
    assert_eq(_al2_count, 1, "dispatched once");
    assert_eq(_al2_w, 64, "arg2 width");
    assert_eq(_al2_h, 64, "arg3 height");
    assert_eq(_al2_fmt, MABDA_TEXFMT_BC1, "arg4 fmt");
    assert_eq(_al2_mc, 3, "arg5 mip_count");
    # mip_count 0 -> full chain resolved before the slot.
    gpu_texture_create_2d_fmt_mipped(ctx, 64, 64, MABDA_TEXFMT_RGBA8, 0);
    assert_eq(_al2_mc, mip_level_count(64, 64), "mip_count 0 -> full chain");
    # Guards reject before the slot.
    _al2_count = 0;
    assert_eq(gpu_texture_create_2d_fmt_mipped(ctx, 64, 64, 99, 1), 0, "bad fmt -> 0");
    assert_eq(gpu_texture_create_2d_fmt_mipped(ctx, 0, 64, MABDA_TEXFMT_RGBA8, 1), 0, "w<=0 -> 0");
    assert_eq(gpu_texture_create_2d_fmt_mipped(ctx, 64, 64, MABDA_TEXFMT_RGBA8, 999), 0, "mip>full -> 0");
    assert_eq(gpu_texture_create_2d_fmt_mipped(0, 64, 64, MABDA_TEXFMT_RGBA8, 1), 0, "null ctx -> 0");
    assert_eq(_al2_count, 0, "guards reject before dispatch");
    return 0;
}

fn test_gpu_render_pass_bind_texture_dispatch() {
    _ts3_bind_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_BIND_FOR_SAMPLE, &_ts3_bind_capture);
    var ctx = alloc(GPU_CONTEXT_SIZE);
    memset(ctx, 0, GPU_CONTEXT_SIZE);
    store64(ctx + 32, b);
    var rc = gpu_render_pass_bind_texture(ctx, 0xAA, 0xBB, 0xCC);
    assert_eq(rc, 0, "slot return propagated");
    assert_eq(_ts3_bind_count, 1, "dispatched once");
    assert_eq(_ts3_bind_ctx, ctx, "arg1 ctx");
    assert_eq(_ts3_bind_pass, 0xAA, "arg2 pass");
    assert_eq(_ts3_bind_tex, 0xBB, "arg3 tex");
    assert_eq(_ts3_bind_samp, 0xCC, "arg4 sampler");
    # null slot -> NOT_IMPLEMENTED; guards return before the slot.   #skip-lint
    var b2 = backend_new();
    var ctx2 = alloc(GPU_CONTEXT_SIZE);
    memset(ctx2, 0, GPU_CONTEXT_SIZE);
    store64(ctx2 + 32, b2);
    assert_eq(gpu_render_pass_bind_texture(ctx2, 0xAA, 0xBB, 0xCC),
    GPU_ERR_NOT_IMPLEMENTED, "null slot -> NOT_IMPLEMENTED");   #skip-lint
    assert_eq(gpu_render_pass_bind_texture(0, 0xAA, 0xBB, 0xCC),
    GPU_ERR_OTHER, "null ctx -> GPU_ERR_OTHER");
    assert_eq(gpu_render_pass_bind_texture(ctx, 0, 0xBB, 0xCC),
    GPU_ERR_OTHER, "null pass -> GPU_ERR_OTHER");
    assert_eq(gpu_render_pass_bind_texture(ctx, 0xAA, 0, 0xCC),
    GPU_ERR_TEXTURE, "null tex -> GPU_ERR_TEXTURE");
    return 0;
}

# v3.2 TS.5 (wgpu sample path) — bind-group descriptor builder byte layout
# (webgpu.h v29 WGPUBindGroupEntry/Descriptor).
fn test_wgpu_texture_bind_group_descriptor() {
    var d = wgpu_texture_bind_group_descriptor(0xB6, 0x71E, 0x5A);
    assert_eq(load64(d + 24), 0xB6, "descriptor layout");
    assert_eq(load64(d + 32), 2, "entryCount = 2");
    var entries = load64(d + 40);
    assert_eq(load32(entries + 8),  0,     "entry0 binding = 0");
    assert_eq(load64(entries + 48), 0x71E, "entry0 textureView");
    assert_eq(load64(entries + 40), 0,     "entry0 sampler null");
    assert_eq(load32(entries + 56 + 8),  1,    "entry1 binding = 1");
    assert_eq(load64(entries + 56 + 40), 0x5A, "entry1 sampler");
    assert_eq(load64(entries + 56 + 48), 0,    "entry1 textureView null");
    return 0;
}

# v3.2 TS.5 (wgpu sample path) — sampler-descriptor-from-intent mapping.
fn test_wgpu_sampler_descriptor_from_intent() {
    var d = wgpu_sampler_descriptor_from_intent(NATIVE_SAMP_FILTER_POINT,
    NATIVE_SAMP_ADDR_CLAMP);
    assert_eq(load32(d + 24), WGPU_ADDRESS_MODE_CLAMP_TO_EDGE, "addrU = clamp");
    assert_eq(load32(d + 28), WGPU_ADDRESS_MODE_CLAMP_TO_EDGE, "addrV = clamp");
    assert_eq(load32(d + 36), WGPU_FILTER_MODE_NEAREST, "magFilter = nearest");
    assert_eq(load32(d + 40), WGPU_FILTER_MODE_NEAREST, "minFilter = nearest");
    var d2 = wgpu_sampler_descriptor_from_intent(NATIVE_SAMP_FILTER_BILINEAR,
    NATIVE_SAMP_ADDR_WRAP);
    assert_eq(load32(d2 + 24), WGPU_ADDRESS_MODE_REPEAT, "addrU = repeat");
    assert_eq(load32(d2 + 36), WGPU_FILTER_MODE_LINEAR, "magFilter = linear");
    assert_eq(load32(d2 + 40), WGPU_FILTER_MODE_LINEAR, "minFilter = linear");
    assert_eq(load32(d2 + 60) & 0xFFFF, 1, "maxAnisotropy = 1");
    return 0;
}

# v3.2 F.8b — the f64 SPIR-V probe module is well-formed by mabda's own parser AND scans
# as f64-using (it declares OpCapability Float64). 55 words / 220 bytes.
fn test_wgpu_f64_probe_spirv_structure() {
    var buf[224];
    var n = _wgpu_f64_probe_spirv(&buf);
    assert_eq(n, 220, "probe is 55 words (220 bytes)");
    assert_eq(load32(&buf + 0), 0x07230203, "probe SPIR-V magic");
    assert_eq(load32(&buf + 4), 0x00010000, "probe targets SPIR-V 1.0");
    assert_eq(spirv_validate_stream(&buf, n), SPIRV_PARSE_OK, "probe validates clean");
    assert_eq(spirv_uses_f64(&buf, n), 1, "probe declares Float64");
    return 0;
}

# v3.2 F.8b — the honest wgpu f64 gate: 0 today (wgpu compute dispatch is a v3.0 stub —
# M.6b posture). The MABDA_WGPU_COMPUTE==0 short-circuit returns 0 BEFORE any FFI, so a
# non-null fake device is safe to probe here without hardware. The authoritative device bit
# (gpu_wgpu_shader_f64_supported, WGPUNativeFeature_ShaderF64) is null-safe too.
fn test_gpu_caps_wgpu_shader_f64_gated() {
    assert_eq(gpu_caps_wgpu_shader_f64(0), 0, "null device -> 0");
    assert_eq(gpu_caps_wgpu_shader_f64(0x1234), 0, "compute-stub gate -> 0 (no end-to-end f64)");
    assert_eq(gpu_wgpu_shader_f64_supported(0), 0, "ShaderF64 supported: null device -> 0");
    return 0;
}

