    assert_eq(_step3e_release_handle, 0x5EED, "arg 2 = handle");
    return 0;
}

fn test_gpu_device_wait_idle_dispatches_through_backend() {
    _step3f_wait_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_DEVICE_WAIT_IDLE, &_step3f_wait_capture);
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx + 32, b);
    var rc = gpu_device_wait_idle(ctx);
    assert_eq(rc, 0, "slot return propagates");
    assert_eq(_step3f_wait_count, 1, "slot dispatched once");
    assert_eq(_step3f_wait_ctx, ctx, "arg 1 = ctx");
    return 0;
}

