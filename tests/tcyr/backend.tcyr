# Audit 2026-06-14 [HIGH-3]/[MED-4]: WGSL shader source must not be
# truncated at the 4 KiB label cap. wgpu_shader_source_wgsl_len writes the
# exact caller-supplied length; the cstr path scans up to the (1 MiB)
# shader-source cap, not WGPU_LABEL_MAX_BYTES.
fn test_wgsl_source_explicit_length() {
    var src = wgpu_shader_source_wgsl_len(0xCAFE, 9000);
    # WGPUShaderSourceWGSL.code StringView at +16: data @ +16, length @ +24.
    assert_eq(load64(src + 16), 0xCAFE, "source data ptr stored");
    assert_eq(load64(src + 24), 9000, "explicit length stored uncapped");
    return 0;
}

fn test_wgsl_source_cstr_not_truncated_at_4k() {
    var n = 5000;
    var buf = alloc(n + 1);
    memset(buf, 65, n);        # 'A' filler — no embedded NUL
    store8(buf + n, 0);        # NUL terminator at byte 5000
    var src = wgpu_shader_source_wgsl(buf);
    assert_eq(load64(src + 24), 5000, "5000-byte WGSL source not capped at 4096");
    return 0;
}

# v3.2 S.1 — WGPUShaderSourceSPIRV (32 B): chain@0 (sType@8), codeSize@16 in
# WORDS, code ptr@24. The words-vs-bytes codeSize is the #1 SPIRV bug; pin it.
fn test_spirv_source_builder() {
    var src = wgpu_shader_source_spirv(0xBEEF, 5);   # 5 words
    assert_eq(load64(src + 0), 0, "chain.next = NULL");
    assert_eq(load32(src + 8), WGPU_STYPE_SHADER_SOURCE_SPIRV, "sType = SPIRV(1)");
    assert_eq(load32(src + 16), 5, "codeSize = 5 WORDS (not bytes)");
    assert_eq(load64(src + 24), 0xBEEF, "code ptr stored at +24");
    assert_eq(WGPU_STYPE_SHADER_SOURCE_SPIRV, 1, "SPIRV sType constant = 0x1");
    return 0;
}

# v3.2 S.1 — _spirv_validate structural checks (magic/align/bound + cap), each
# returning its distinct code. Builds a minimal valid 5-word SPIR-V header.
fn test_spirv_validate() {
    var buf[20];
    store32(&buf +  0, MABDA_SPIRV_MAGIC);   # word0 magic
    store32(&buf +  4, 0x00010300);          # word1 version
    store32(&buf +  8, 0);                    # word2 generator
    store32(&buf + 12, 1);                    # word3 id-bound = 1
    store32(&buf + 16, 0);                    # word4 schema
    assert_eq(_spirv_validate(&buf, 20), 0, "valid 5-word header -> 0");
    assert_eq(_spirv_validate(&buf, 16), 1, "too short (16B) -> 1");
    assert_eq(_spirv_validate(&buf, 21), 2, "not u32-aligned (21B) -> 2");
    # bad magic.
    store32(&buf + 0, 0xDEADBEEF);
    assert_eq(_spirv_validate(&buf, 20), 3, "bad magic -> 3");
    # byte-swapped (big-endian) magic.
    store32(&buf + 0, MABDA_SPIRV_MAGIC_SWAPPED);
    assert_eq(_spirv_validate(&buf, 20), 4, "byte-swapped magic -> 4");
    # restore magic; bound malformed.
    store32(&buf + 0, MABDA_SPIRV_MAGIC);
    store32(&buf + 12, 0);
    assert_eq(_spirv_validate(&buf, 20), 5, "id-bound 0 -> 5");
    store32(&buf + 12, 0x40000000);
    assert_eq(_spirv_validate(&buf, 20), 5, "id-bound too large -> 5");
    # restore bound; runaway word-count cap (small buffer, huge byte_len param —
    # validate only reads word0 + word3, both in-bounds).
    store32(&buf + 12, 1);
    assert_eq(_spirv_validate(&buf, (MABDA_MAX_SPIRV_WORDS + 1) * 4), 6,
    "word count over cap -> 6");
    return 0;
}

# v3.1 [M.3(wgpu)]: per-level view descriptor sets baseMipLevel; the rest
# matches the base view builder (mipLevelCount=1, single layer).
fn test_wgpu_texture_view_descriptor_level() {
    var d = wgpu_texture_view_descriptor_level("mip", WGPU_TEXTURE_FORMAT_RGBA8_UNORM,
    WGPU_TEXTURE_VIEW_DIMENSION_2D, 3);
    assert_eq(load32(d + 24), WGPU_TEXTURE_FORMAT_RGBA8_UNORM, "format @24");
    assert_eq(load32(d + 28), WGPU_TEXTURE_VIEW_DIMENSION_2D,  "dimension @28");
    assert_eq(load32(d + 32), 3, "baseMipLevel @32 = requested level");
    assert_eq(load32(d + 36), 1, "mipLevelCount @36 = 1 (single level)");
    assert_eq(load32(d + 44), 1, "arrayLayerCount @44 = 1");
    return 0;
}

# v3.1 [M.3(wgpu)]: sampled + storage BGL entries (sub-struct offsets
# cross-checked against webgpu.h v29).
fn test_wgpu_bgl_entry_texture() {
    var e[120];
    wgpu_bgl_entry_texture(&e, 0, WGPU_SHADER_STAGE_COMPUTE,
    WGPU_TEXTURE_SAMPLE_TYPE_FLOAT, WGPU_TEXTURE_VIEW_DIMENSION_2D, 0);
    assert_eq(load32(&e + 8),  0, "binding @8");
    assert_eq(load64(&e + 16), WGPU_SHADER_STAGE_COMPUTE, "visibility @16");
    assert_eq(load32(&e + 80), WGPU_TEXTURE_SAMPLE_TYPE_FLOAT, "sampleType @80");
    assert_eq(load32(&e + 84), WGPU_TEXTURE_VIEW_DIMENSION_2D, "viewDimension @84");
    assert_eq(load32(&e + 88), 0, "multisampled @88 = false");
    # other binding-layout sub-structs left zero (BindingNotUsed)
    assert_eq(load32(&e + 40), 0, "buffer.type @40 = 0");
    assert_eq(load32(&e + 104), 0, "storageTexture.access @104 = 0");
    return 0;
}

fn test_wgpu_bgl_entry_storage_texture() {
    var e[120];
    wgpu_bgl_entry_storage_texture(&e, 1, WGPU_SHADER_STAGE_COMPUTE,
    WGPU_STORAGE_TEXTURE_ACCESS_WRITE_ONLY, WGPU_TEXTURE_FORMAT_RGBA8_UNORM,
    WGPU_TEXTURE_VIEW_DIMENSION_2D);
    assert_eq(load32(&e + 8),   1, "binding @8");
    assert_eq(load64(&e + 16),  WGPU_SHADER_STAGE_COMPUTE, "visibility @16");
    assert_eq(load32(&e + 104), WGPU_STORAGE_TEXTURE_ACCESS_WRITE_ONLY, "access @104");
    assert_eq(load32(&e + 108), WGPU_TEXTURE_FORMAT_RGBA8_UNORM, "format @108");
    assert_eq(load32(&e + 112), WGPU_TEXTURE_VIEW_DIMENSION_2D, "viewDimension @112");
    assert_eq(load32(&e + 80),  0, "texture.sampleType @80 = 0");
    return 0;
}

# v3.1 [M.4(wgpu)]: the WGSL downsample shader source — smoke checks
# (full validation is on wgpu HW in M.7, like the native shader).
fn test_wgsl_downsample_source() {
    var buf[640];
    memset(&buf, 0, 640);
    var len = mabda_wgsl_downsample_2x2(&buf);
    assert(len > 200, "WGSL source is non-trivial length");
    assert(len < 640, "WGSL fits the documented 640-byte buffer");
    assert_eq(load8(&buf), 0x40, "starts with '@' (@group)");
    assert_eq(load8(&buf + len), 0, "NUL-terminated at returned length");
    # the builder length matches an independent NUL scan
    assert_eq(_wgpu_strnlen(&buf, 4096), len, "strnlen agrees with builder length");
    return 0;
}

