    var ctx = alloc(112);
    memset(ctx, 0, 112);
    assert_eq(_backend_wgpu_texture_create_2d_rgba8(ctx, 0, 16),  0, "w=0 → 0");
    assert_eq(_backend_wgpu_texture_create_2d_rgba8(ctx, 16, 0),  0, "h=0 → 0");
    assert_eq(_backend_wgpu_texture_create_2d_rgba8(ctx, 0, 0),   0, "0x0 → 0");
    return 0;
}

fn test_backend_wgpu_texture_write_null_args_err() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    var tex[32];
    memset(&tex, 0, 32);
    store32(&tex + 24, 16);
    store32(&tex + 28, 16);
    var src[64];
    memset(&src, 0, 64);
    assert_eq(_backend_wgpu_texture_write(0, &tex, &src, 1024),  GPU_ERR_OTHER,  "null ctx");
    assert_eq(_backend_wgpu_texture_write(ctx, 0, &src, 1024),   GPU_ERR_OTHER,  "null tex");
    assert_eq(_backend_wgpu_texture_write(ctx, &tex, 0, 1024),   GPU_ERR_BUFFER, "null src");
    assert_eq(_backend_wgpu_texture_write(ctx, &tex, &src, 0),   GPU_ERR_BUFFER, "n=0");
    return 0;
}

fn test_backend_wgpu_texture_write_size_mismatch_err() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    var tex[32];
    memset(&tex, 0, 32);
    store32(&tex + 24, 16);
    store32(&tex + 28, 16);
    var src[64];
    memset(&src, 0, 64);
    # 16x16 RGBA8 = 1024 bytes (fmt id 0 at tex+16); passing 100 mismatches.
    assert_eq(_backend_wgpu_texture_write(ctx, &tex, &src, 100), GPU_ERR_BUFFER, "n != w*h*4");
    return 0;
}

# v3.2 T.6 — the unified write slot validates n against the BLOCK size
# (data_size) for the format stashed at tex+16. The n-mismatch reject
# happens before the wgpu FFI, so it's CPU-testable; the n==expected path
# is HW-gated (queue.writeTexture) and exercised by the T.8 e2e.
fn test_backend_wgpu_texture_write_compressed_block_size() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    var tex[32];
    memset(&tex, 0, 32);
    var src[64];
    memset(&src, 0, 64);
    # BC1 8x8 = 2*2 blocks * 8 B = 32; 31/33 mismatch -> reject pre-FFI.
    store64(&tex + 16, MABDA_TEXFMT_BC1);
    store32(&tex + 24, 8);
    store32(&tex + 28, 8);
    assert_eq(_backend_wgpu_texture_write(ctx, &tex, &src, 31), GPU_ERR_BUFFER, "BC1 8x8 n=31 reject");
    assert_eq(_backend_wgpu_texture_write(ctx, &tex, &src, 33), GPU_ERR_BUFFER, "BC1 8x8 n=33 reject");
    # ASTC_6x6 7x7 = ceil(7/6)^2 * 16 = 2*2*16 = 64; 63 mismatch.
    store64(&tex + 16, MABDA_TEXFMT_ASTC_6X6);
    store32(&tex + 24, 7);
    store32(&tex + 28, 7);
    assert_eq(_backend_wgpu_texture_write(ctx, &tex, &src, 63), GPU_ERR_BUFFER, "ASTC6x6 7x7 n=63 reject");
    return 0;
}

# v3.2 T.9 (audit fix): wgpu compressed READBACK via gpu_texture_read needs
# 256-padded block-row handling not implemented this minor — it must fail
# loud (NOT_IMPLEMENTED), not mis-validate. Returns before any FFI.   #skip-lint
fn test_backend_wgpu_texture_read_compressed_fail_loud() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    var tex[32];
    memset(&tex, 0, 32);
    store64(&tex + 16, MABDA_TEXFMT_BC1);   # compressed fmt at +16
    store32(&tex + 24, 8);
    store32(&tex + 28, 8);
    var dst[64];
    memset(&dst, 0, 64);
    assert_eq(_backend_wgpu_texture_read(ctx, &tex, &dst, 32),
    GPU_ERR_NOT_IMPLEMENTED, "wgpu compressed read -> NOT_IMPLEMENTED (fail-loud)");   #skip-lint
    # An uncompressed (RGBA8, fmt 0) tex still takes the normal path: a
    # size mismatch is rejected with GPU_ERR_BUFFER (not NOT_IMPLEMENTED).   #skip-lint
    store64(&tex + 16, MABDA_TEXFMT_RGBA8);
    assert_eq(_backend_wgpu_texture_read(ctx, &tex, &dst, 999),
    GPU_ERR_BUFFER, "RGBA8 read size mismatch -> BUFFER");
    return 0;
}

fn test_backend_wgpu_texture_read_null_args_err() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
