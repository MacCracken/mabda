    assert_eq(_step57_read_ctx, ctx, "arg 1 = ctx");
    assert_eq(_step57_read_tex, 0xBEEF, "arg 2 = tex");
    assert_eq(_step57_read_dst, 0xDEED, "arg 3 = dst");
    assert_eq(_step57_read_n, 2048, "arg 4 = n");
    return 0;
}

var _step57_release_count = 0;
var _step57_release_ctx = 0;
var _step57_release_tex = 0;

fn _step57_release_capture(ctx, tex) {
    _step57_release_count = _step57_release_count + 1;
    _step57_release_ctx = ctx;
    _step57_release_tex = tex;
    return 0;
}

fn test_gpu_texture_release_dispatches_through_backend() {
    _step57_release_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_RELEASE, &_step57_release_capture);
