var _step69_pass_begin_count = 0;
var _step69_pass_begin_ctx = 0;
var _step69_pass_begin_rt = 0;
var _step69_pass_begin_color = 0;
fn _step69_pass_begin_capture(ctx, rt, color) {
    _step69_pass_begin_count = _step69_pass_begin_count + 1;
    _step69_pass_begin_ctx = ctx;
    _step69_pass_begin_rt = rt;
    _step69_pass_begin_color = color;
    return 0xCAFE05;
}
fn test_gpu_render_pass_begin_dispatches_through_backend() {
    _step69_pass_begin_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_RENDER_PASS_BEGIN,
                     &_step69_pass_begin_capture);
    var ctx = alloc(96);
    memset(ctx, 0, 96);
    store64(ctx + 32, b);
    var color[32];
    memset(&color, 0, 32);
    var got = gpu_render_pass_begin(ctx, 0xBEEF06, &color);
    assert_eq(got, 0xCAFE05, "slot return value propagates");
    assert_eq(_step69_pass_begin_count, 1, "slot dispatched once");
    assert_eq(_step69_pass_begin_ctx, ctx, "arg 1 = ctx");
    assert_eq(_step69_pass_begin_rt, 0xBEEF06, "arg 2 = rt");
    assert_eq(_step69_pass_begin_color, &color, "arg 3 = color_ptr");
    return 0;
}

