# ================================================================
# v3 Step 6.9 — public render-* dispatchers route through Backend
# ================================================================
# 7 mock-backend dispatch tests proving each public gpu_render_*
# fn correctly threads ctx + args through ctx->backend->slot via
# the right fncallN. Wgpu wires up the real bodies (Step 6.8b);
# native gets bodies in Step 6.8c.

var _step69_rt_create_count = 0;
var _step69_rt_create_ctx = 0;
var _step69_rt_create_w = 0;
var _step69_rt_create_h = 0;
fn _step69_rt_create_capture(ctx, w, h) {
    _step69_rt_create_count = _step69_rt_create_count + 1;
    _step69_rt_create_ctx = ctx;
    _step69_rt_create_w = w;
    _step69_rt_create_h = h;
    return 0xCAFE01;
}
fn test_gpu_render_target_create_dispatches_through_backend() {
    _step69_rt_create_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_RENDER_TARGET_CREATE_2D_RGBA8,
    &_step69_rt_create_capture);
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx + 32, b);
    var got = gpu_render_target_create_2d_rgba8(ctx, 256, 128);
    assert_eq(got, 0xCAFE01, "slot return value propagates");
    assert_eq(_step69_rt_create_count, 1, "slot dispatched once");
    assert_eq(_step69_rt_create_ctx, ctx, "arg 1 = ctx");
    assert_eq(_step69_rt_create_w, 256, "arg 2 = width");
    assert_eq(_step69_rt_create_h, 128, "arg 3 = height");
    return 0;
}

