    test_native_pm4_event_write_packs_event_index();
    test_native_pm4_event_write_cache_flush_and_inv();
    test_native_pm4_event_write_advances_pos();

    # v3 Step 6.9 — public render-* dispatchers (8)
    test_gpu_render_target_create_dispatches_through_backend();
    test_gpu_render_target_release_dispatches_through_backend();
    test_gpu_render_pipeline_create_dispatches_through_backend();
    test_gpu_render_pipeline_release_dispatches_through_backend();
    test_gpu_render_pass_begin_dispatches_through_backend();
    test_gpu_render_pass_draw_dispatches_through_backend();
    test_gpu_render_pass_end_dispatches_through_backend();
    test_gpu_render_dispatchers_null_ctx_safe();

    # v3 Phase D (Step 7.x) tests run in tests/tcyr/mabda_v3_phase_d.tcyr.

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
