fn test_gpu_render_dispatchers_null_ctx_safe() {
    # All seven render dispatchers must short-circuit on null ctx
    # without dispatching. No mock backend needed.
    assert_eq(gpu_render_target_create_2d_rgba8(0, 64, 64), 0, "rt_create null ctx -> 0");
    assert_eq(gpu_render_target_release(0, 0xDEAD), 0, "rt_release null ctx -> 0");
    assert_eq(gpu_render_pipeline_create(0, 1, 2, 28), 0, "pipe_create null ctx -> 0");
    assert_eq(gpu_render_pipeline_release(0, 0xDEAD), 0, "pipe_release null ctx -> 0");
    var color[32];
    memset(&color, 0, 32);
    assert_eq(gpu_render_pass_begin(0, 0xDEAD, &color), 0, "pass_begin null ctx -> 0");
    assert_eq(gpu_render_pass_draw(0, 1, 2, 3, 1), GPU_ERR_OTHER, "pass_draw null ctx -> ERR");
    assert_eq(gpu_render_pass_end(0, 0xDEAD), 0, "pass_end null ctx -> 0");
    return 0;
}

