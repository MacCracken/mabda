fn test_gpu_texture_dispatchers_null_ctx_safe() {
    _step57_create_count = 0;
    _step57_write_count = 0;
    _step57_read_count = 0;
    _step57_release_count = 0;
    assert_eq(gpu_texture_create_2d_rgba8(0, 16, 16), 0, "create null ctx = 0");
    assert_eq(gpu_texture_write(0, 0, 0, 0), GPU_ERR_OTHER, "write null ctx = err");
    assert_eq(gpu_texture_read(0, 0, 0, 0), GPU_ERR_OTHER, "read null ctx = err");
    assert_eq(gpu_texture_release(0, 0), 0, "release null ctx = 0");
    assert_eq(_step57_create_count, 0, "create did not dispatch");
    assert_eq(_step57_write_count, 0, "write did not dispatch");
    assert_eq(_step57_read_count, 0, "read did not dispatch");
    assert_eq(_step57_release_count, 0, "release did not dispatch");
    return 0;
}

# ================================================================
# v3 Step 6.3 — native render target primitives (Phase C render)
# ================================================================
# CPU-only tests for the RT allocator + release pair. End-to-end
# hardware validation lands in Step 6.9 (programs/native_render_e2e).

fn test_native_rt_size_formula() {
    assert_eq(native_rt_size_2d_rgba8(1, 1),     4,        "1x1 = 4 bytes");
    assert_eq(native_rt_size_2d_rgba8(64, 32),   8192,     "64x32");
    assert_eq(native_rt_size_2d_rgba8(256, 256), 262144,   "256x256");
    assert_eq(native_rt_size_2d_rgba8(0, 0),     0,        "0x0 degenerate");
    return 0;
}

fn test_native_rt_struct_field_offsets() {
    assert_eq(NATIVE_RT_FIELD_HANDLE, 0,  "handle at +0");
    assert_eq(NATIVE_RT_FIELD_VA,     8,  "va at +8");
    assert_eq(NATIVE_RT_FIELD_ADDR,   16, "addr at +16");
    assert_eq(NATIVE_RT_FIELD_SIZE,   24, "size at +24");
    assert_eq(NATIVE_RT_FIELD_WIDTH,  32, "width at +32");
    assert_eq(NATIVE_RT_FIELD_HEIGHT, 36, "height at +36");
    assert_eq(NATIVE_RT_STRUCT_SIZE,  40, "total = 40");
    return 0;
}

fn test_native_rt_va_distinct_from_other_pools() {
    # RT VA must not collide with shader / stub / IB / fence /
    # output / texture VAs. Catches the "moved a VA constant"
    # mistake before runtime.
    assert(_NATIVE_RT_VA_BASE != _NATIVE_STUB_VA,            "rt != stub");
    assert(_NATIVE_RT_VA_BASE != _NATIVE_IB_VA,              "rt != IB");
    assert(_NATIVE_RT_VA_BASE != _NATIVE_FENCE_VA,           "rt != fence");
    assert(_NATIVE_RT_VA_BASE != _NATIVE_TEXTURE_VA_BASE,    "rt != texture");
    assert(_NATIVE_RT_VA_BASE != 0xFFFF800100000000,         "rt != shader VA");
    assert(_NATIVE_RT_VA_BASE != 0xFFFF800100400000,         "rt != output VA");
    return 0;
}

fn test_native_rt_struct_round_trip() {
    var rt[40];
    memset(&rt, 0, 40);
    store64(&rt + NATIVE_RT_FIELD_HANDLE, 0xCAFE);
    store64(&rt + NATIVE_RT_FIELD_VA,     _NATIVE_RT_VA_BASE);
    store64(&rt + NATIVE_RT_FIELD_ADDR,   0xBEEF);
    store64(&rt + NATIVE_RT_FIELD_SIZE,   8192);
    store32(&rt + NATIVE_RT_FIELD_WIDTH,  64);
    store32(&rt + NATIVE_RT_FIELD_HEIGHT, 32);
    assert_eq(load64(&rt + NATIVE_RT_FIELD_HANDLE), 0xCAFE,            "handle round-trips");
    assert_eq(load64(&rt + NATIVE_RT_FIELD_VA),     _NATIVE_RT_VA_BASE, "va round-trips");
    assert_eq(load64(&rt + NATIVE_RT_FIELD_ADDR),   0xBEEF,            "addr round-trips");
    assert_eq(load64(&rt + NATIVE_RT_FIELD_SIZE),   8192,              "size round-trips");
    assert_eq(load32(&rt + NATIVE_RT_FIELD_WIDTH),  64,                "width round-trips");
    assert_eq(load32(&rt + NATIVE_RT_FIELD_HEIGHT), 32,                "height round-trips");
    return 0;
}

fn test_native_rt_release_safe_zero() {
    var rt[40];
    memset(&rt, 0, 40);
    assert_eq(native_rt_release_2d_rgba8(7, 0),    0, "null rt is safe");
    assert_eq(native_rt_release_2d_rgba8(7, &rt),  0, "zero-handle rt is safe");
    return 0;
}

# ================================================================
# v3 Step 6.4 — SET_CONTEXT_REG + DRAW_INDEX_AUTO PM4 builders
# ================================================================
# Byte-exact tests for the new graphics-side PM4 emitters. The
# wire format mirrors SET_SH_REG / SET_UCONFIG_REG; differences
# are the opcode and the dword-offset base. Step 6.5 will validate
# these byte sequences against radv's output for a full clear-
# triangle dispatch (the existing Phase B.4 protocol).

fn test_native_pm4_opcodes_extended() {
    assert_eq(IT_SET_CONTEXT_REG, 0x69, "SET_CONTEXT_REG opcode");
    assert_eq(IT_DRAW_INDEX_AUTO, 0x2D, "DRAW_INDEX_AUTO opcode");
    assert_eq(PM4_CONTEXT_REG_BASE, 0xA000, "context-reg base byte address");
    return 0;
}

fn test_native_context_reg_offset_encoding() {
    # Synthetic 4-aligned context-register addresses. Specific R_*
    # register values land in Step 6.5 against radv's IB dump.
    assert_eq(native_context_reg_offset(0xA000), 0,    "base address → 0");
    assert_eq(native_context_reg_offset(0xA00C), 3,    "+12 bytes → dw offset 3");
    assert_eq(native_context_reg_offset(0xA238), 0x8E, "+0x238 bytes → dw 0x8E");
    assert_eq(native_context_reg_offset(0xA318), 0xC6, "+0x318 bytes → dw 0xC6");
    assert_eq(native_context_reg_offset(0xA31C), 0xC7, "+0x31C bytes → dw 0xC7");
    return 0;
}

fn test_native_pm4_set_context_reg_one_layout() {
    var buf[16];
    memset(&buf, 0xFF, 16);
    # Use 0xA238 (synthetic; happens to match radv's CB_TARGET_MASK)
    var pos = native_pm4_set_context_reg_one(&buf, 0, 0xA238, 0xF);
    assert_eq(pos, 12, "single-reg context-set = 3 dwords");
    # Header: PKT3(IT_SET_CONTEXT_REG, count=2, 0) → count_minus_1=1
    # → (3<<30) | (1<<16) | (0x69<<8) = 0xC0016900.
    assert_eq(load32(&buf + 0), 0xC0016900, "header bytes");
    assert_eq(load32(&buf + 4), 0x8E,       "reg_offset dword (0x238/4)");
    assert_eq(load32(&buf + 8), 0xF,        "value");
    return 0;
}

fn test_native_pm4_set_context_reg_pair_layout() {
    var buf[20];
    memset(&buf, 0xFF, 20);
    var values[8];
    store32(&values + 0, 0xAAAAAAAA);
    store32(&values + 4, 0xBBBBBBBB);
    # Use 0xA00C (synthetic; happens to match a scissor TL register)
    var pos = native_pm4_set_context_reg_pair(&buf, 0, 0xA00C, &values);
    assert_eq(pos, 16, "pair context-set = 4 dwords");
    # Header: PKT3(IT_SET_CONTEXT_REG, count=3, 0) → count_minus_1=2
    # → 0xC0026900.
    assert_eq(load32(&buf + 0),  0xC0026900, "header bytes");
    assert_eq(load32(&buf + 4),  3,           "reg_offset dw (0xC/4)");
    assert_eq(load32(&buf + 8),  0xAAAAAAAA, "value 0");
    assert_eq(load32(&buf + 12), 0xBBBBBBBB, "value 1");
    return 0;
}

fn test_native_pm4_set_context_reg_multi_layout() {
    # 4-register write — common for CB_COLOR0_PITCH/_SLICE/_VIEW/_INFO
    # in a single packet.
    var buf[28];
    memset(&buf, 0xFF, 28);
    var values[16];
    store32(&values +  0, 0x11);
    store32(&values +  4, 0x22);
    store32(&values +  8, 0x33);
    store32(&values + 12, 0x44);
    # Use 0xA31C (synthetic; matches CB_COLOR0_PITCH per Mesa sid.h)
    var pos = native_pm4_set_context_reg(&buf, 0, 0xA31C, 4, &values);
    assert_eq(pos, 24, "multi(4) context-set = 6 dwords");
    # Header: PKT3(IT_SET_CONTEXT_REG, count=5, 0) → count_minus_1=4
    # → 0xC0046900.
    assert_eq(load32(&buf + 0), 0xC0046900, "header bytes");
    assert_eq(load32(&buf + 4), 0xC7,       "reg_offset dw (0x31C/4)");
    assert_eq(load32(&buf + 8),  0x11, "value 0");
    assert_eq(load32(&buf + 12), 0x22, "value 1");
    assert_eq(load32(&buf + 16), 0x33, "value 2");
    assert_eq(load32(&buf + 20), 0x44, "value 3");
    return 0;
}

fn test_native_pm4_draw_index_auto_layout() {
    var buf[16];
    memset(&buf, 0xFF, 16);
    var pos = native_pm4_draw_index_auto(&buf, 0, 3, DI_SRC_SEL_AUTO_INDEX);
    assert_eq(pos, 12, "DRAW_INDEX_AUTO = 3 dwords");
    # Header: PKT3(IT_DRAW_INDEX_AUTO, count=2, 0) → count_minus_1=1
    # → (3<<30) | (1<<16) | (0x2D<<8) = 0xC0012D00.
    assert_eq(load32(&buf + 0), 0xC0012D00, "header bytes");
    assert_eq(load32(&buf + 4), 3,          "vertex_count");
    assert_eq(load32(&buf + 8), 0x02,       "draw_initiator (auto-index)");
    return 0;
}

fn test_native_pm4_di_src_sel_constant() {
    # DI_SRC_SEL_AUTO_INDEX is the source-select bits for an auto-
    # index draw. Standard value per Mesa's V_0287F0_DI_SRC_SEL_AUTO_INDEX = 2.
    assert_eq(DI_SRC_SEL_AUTO_INDEX, 0x02, "auto-index source select");
    return 0;
}

# ================================================================
# v3 Step 6.2(a) — graphics-pipeline register addresses + minimums
# ================================================================
# Value-asserts for the spec-anchored constants in
# src/backend_native.cyr Step 6.2(a) section. Pattern follows the
# 4f.ii lesson — every computed/spec-derived constant that the PM4
# stream will eventually emit gets a CPU value-assert so a typo
# surfaces at test time, not at hardware-debug time.

fn test_gfx9_vs_sh_register_addresses() {
    # VS shader-program registers (Mesa: R_00B12{0,4,8,C}_SPI_SHADER_*_VS).
    assert_eq(R_SPI_SHADER_PGM_LO_VS,    0xB120, "VS PGM_LO byte addr");
    assert_eq(R_SPI_SHADER_PGM_HI_VS,    0xB124, "VS PGM_HI byte addr");
    assert_eq(R_SPI_SHADER_PGM_RSRC1_VS, 0xB128, "VS PGM_RSRC1 byte addr");
    assert_eq(R_SPI_SHADER_PGM_RSRC2_VS, 0xB12C, "VS PGM_RSRC2 byte addr");
    # Wire-form: (addr - 0xB000) / 4. 0xB120 → 0x48, sequential by 1.
    assert_eq(native_sh_reg_offset(R_SPI_SHADER_PGM_LO_VS),    0x48, "VS PGM_LO wire");
    assert_eq(native_sh_reg_offset(R_SPI_SHADER_PGM_RSRC2_VS), 0x4B, "VS PGM_RSRC2 wire");
    return 0;
}

fn test_gfx9_ps_sh_register_addresses() {
    # PS shader-program registers (Mesa: R_00B02{0,4,8,C}_SPI_SHADER_*_PS).
    assert_eq(R_SPI_SHADER_PGM_LO_PS,    0xB020, "PS PGM_LO byte addr");
    assert_eq(R_SPI_SHADER_PGM_HI_PS,    0xB024, "PS PGM_HI byte addr");
    assert_eq(R_SPI_SHADER_PGM_RSRC1_PS, 0xB028, "PS PGM_RSRC1 byte addr");
    assert_eq(R_SPI_SHADER_PGM_RSRC2_PS, 0xB02C, "PS PGM_RSRC2 byte addr");
    assert_eq(native_sh_reg_offset(R_SPI_SHADER_PGM_LO_PS),    0x08, "PS PGM_LO wire");
    assert_eq(native_sh_reg_offset(R_SPI_SHADER_PGM_RSRC2_PS), 0x0B, "PS PGM_RSRC2 wire");
    return 0;
}

fn test_gfx9_spi_format_register_addresses() {
    # SPI shader output format context regs (Mesa gfx9.json:
    # POS_FORMAT=0x02870C, Z_FORMAT=0x028710, COL_FORMAT=0x028714).
    # Mabda 0xA-shorthand (synthetic 0xA000 base) produces identical wire form.
    assert_eq(R_SPI_SHADER_POS_FORMAT, 0xA70C, "SPI_SHADER_POS_FORMAT byte addr");
    assert_eq(R_SPI_SHADER_Z_FORMAT,   0xA710, "SPI_SHADER_Z_FORMAT byte addr");
    assert_eq(R_SPI_SHADER_COL_FORMAT, 0xA714, "SPI_SHADER_COL_FORMAT byte addr");
    # Wire-form: (addr - 0xA000) / 4. 0xA70C → 0x1C3, etc.
    assert_eq(native_context_reg_offset(R_SPI_SHADER_POS_FORMAT), 0x1C3, "POS_FORMAT wire");
    assert_eq(native_context_reg_offset(R_SPI_SHADER_Z_FORMAT),   0x1C4, "Z_FORMAT wire");
    assert_eq(native_context_reg_offset(R_SPI_SHADER_COL_FORMAT), 0x1C5, "COL_FORMAT wire");
    return 0;
}

fn test_gfx9_cb_target_mask_address() {
    # Pipeline-static color-buffer write mask (Mesa R_028238_CB_TARGET_MASK).
    # Wire form 0x8E was already exercised by test_native_pm4_set_context_reg_one_layout
    # using the synthetic literal 0xA238; this assert pins the named constant.
    assert_eq(R_CB_TARGET_MASK, 0xA238, "CB_TARGET_MASK byte addr");
    assert_eq(native_context_reg_offset(R_CB_TARGET_MASK), 0x8E, "CB_TARGET_MASK wire");
    return 0;
}

fn test_gfx9_pgm_rsrc_minimums() {
    # RSRC1: VS+PS share the compute minimum (FLOAT_MODE 0xC0, SGPRS=1, DX10_CLAMP, IEEE).
    assert_eq(GFX9_GFX_PGM_RSRC1_MIN, 0x2C0040, "GFX RSRC1 minimum value");
    assert_eq(GFX9_GFX_PGM_RSRC1_MIN, GFX9_COMPUTE_PGM_RSRC1_MIN, "GFX RSRC1 mirrors compute");
    # RSRC2: zero for trivial shape (no USER_SGPR, no scratch, no LDS).
    # Hazard: PS may need TRAP_PRESENT (bit 6) on GFX9 if the FS does memory ops;
    # the trivial solid-color FS does not, so 0 is the spec minimum.
    assert_eq(GFX9_VS_PGM_RSRC2_MIN, 0x0, "VS RSRC2 minimum");
    assert_eq(GFX9_PS_PGM_RSRC2_MIN, 0x0, "PS RSRC2 minimum");
    return 0;
}

fn test_gfx9_spi_format_field_values() {
    # POS_FORMAT = FLOAT_4 — VS exports four f32 lanes.
    assert_eq(SPI_SHADER_POS_FORMAT_4, 0x4, "POS_FORMAT FLOAT_4");
    # Z_FORMAT = INVALID — FS does not export depth.
    assert_eq(SPI_SHADER_Z_FORMAT_INVALID, 0x0, "Z_FORMAT INVALID");
    # COL_FORMAT candidates for RGBA8 RT — Step 6.5 picks one and verifies
    # by CPU-readback. Default is FP32_ABGR (FS writes f32; export quantizes).
    assert_eq(SPI_SHADER_COL_FORMAT_FP16_ABGR,    0x9, "COL_FORMAT FP16_ABGR");
    assert_eq(SPI_SHADER_COL_FORMAT_UNORM16_ABGR, 0xA, "COL_FORMAT UNORM16_ABGR");
    assert_eq(SPI_SHADER_COL_FORMAT_FP32_ABGR,    0xE, "COL_FORMAT FP32_ABGR");
    return 0;
}

fn test_gfx9_fullscreen_triangle_vertex_count() {
    # Full-screen triangle: 3 vertices generated from vertex_id 0/1/2
    # via switch in the VS body (no VBO).
    assert_eq(GFX9_FULLSCREEN_TRI_VCOUNT, 3, "full-screen triangle vertex count");
    return 0;
}

# ================================================================
# v3 Step 6.2(b) — fragment shader bytes (solid red FS)
# ================================================================
# Pin every dword the FS encoder emits, plus the total byte count.
# Per the 4f.ii lesson, value-asserting every spec-derived constant
# at CPU test time means a typo in an instruction encoding (top
# byte 0x7E for VOP1, 0xF8 for EXP, 0xBF for SOPP) surfaces here
# rather than as a TDR on hardware. Header citations live in
# src/backend_native.cyr Step 6.2(b) section.

fn test_gfx9_fs_solid_red_byte_pattern() {
    var buf[96];
    memset(&buf, 0xCC, 96);
    var pos = native_gfx9_shader_solid_red(&buf, 0);
    assert_eq(pos, GFX9_FS_SOLID_RED_SIZE, "FS shader writes 92 bytes");
    assert_eq(GFX9_FS_SOLID_RED_SIZE, 92, "FS size constant");

    # Four v_mov_b32_e32 instructions setting v0..v3 to (1.0, 0.0, 0.0, 1.0).
    # VOP1 top byte = 0x7E. Inline constants 242 = 1.0, 128 = 0.0.
    assert_eq(load32(&buf +  0), 0x7E0002F2, "v_mov v0, 1.0");
    assert_eq(load32(&buf +  4), 0x7E020280, "v_mov v1, 0.0");
    assert_eq(load32(&buf +  8), 0x7E040280, "v_mov v2, 0.0");
    assert_eq(load32(&buf + 12), 0x7E0602F2, "v_mov v3, 1.0");

    # EXP instruction (8 bytes, 2 dwords). Top byte 0xF8 (encoding
    # 0x3E in bits 26-31). Word 0 carries en/tgt/done/vm flags;
    # word 1 carries vsrc0..3.
    assert_eq(load32(&buf + 16), 0xF800180F, "exp mrt0 done vm word 0");
    assert_eq(load32(&buf + 20), 0x03020100, "exp mrt0 vsrc0..3 = v0..v3");

    # s_endpgm (SOPP, 0xBF810000) — same byte pattern as compute.
    assert_eq(load32(&buf + 24), 0xBF810000, "s_endpgm");

    # 16 NOP-padding dwords (s_nop 0 = 0xBF800000) — AMDGPU prefetch
    # requirement; matches the compute shader's tail.
    var i = 0;
    while (i < 16) {
        assert_eq(load32(&buf + 28 + i * 4), 0xBF800000, "s_nop padding");
        i = i + 1;
    }
    return 0;
}

fn test_gfx9_fs_solid_red_alignment() {
    # The FS payload must be 4-byte aligned (every store is 32-bit)
    # and the total size must be a multiple of 4 — confirming PM4
    # set_sh_reg can point PGM_LO/HI at any 256-byte-aligned BO offset
    # without unaligned-instruction hazards. The 92-byte size leaves
    # 164 bytes of slack within a 256-byte-aligned shader BO slot;
    # the BO allocator at Step 6.5 sizes accordingly.
    assert_eq(GFX9_FS_SOLID_RED_SIZE % 4, 0, "FS size is dword-aligned");
    return 0;
}

fn test_gfx9_vs_fullscreen_triangle_byte_pattern() {
    # VS bytes cross-checked against `clang -target amdgcn--amdhsa
    # -mcpu=gfx90c -O2` of the equivalent CL kernel. The arithmetic
    # VOP2 opcodes (v_lshlrev_b32 = 0x12, v_and_b32 = 0x13, v_add_u32
    # = 0x34) are ABI-independent, so the compute-ABI disassembly
    # gives authoritative encodings for the graphics-ABI shader.
    var buf[128];
    memset(&buf, 0xCC, 128);
    var pos = native_gfx9_shader_fullscreen_triangle_vs(&buf, 0);
    assert_eq(pos, GFX9_VS_FULLSCREEN_TRIANGLE_SIZE, "VS shader writes 116 bytes");
    assert_eq(GFX9_VS_FULLSCREEN_TRIANGLE_SIZE, 116, "VS size constant");

    # VOP2 arithmetic: shift, mask, subtract — all top byte 0x24/0x26/0x68
    # (opcodes 0x12, 0x13, 0x34 in bits 30-25).
    assert_eq(load32(&buf +  0), 0x24040081, "v_lshlrev_b32 v2, 1, v0");
    assert_eq(load32(&buf +  4), 0x24000082, "v_lshlrev_b32 v0, 2, v0");
    assert_eq(load32(&buf +  8), 0x26000084, "v_and_b32 v0, 4, v0");
    assert_eq(load32(&buf + 12), 0x26040484, "v_and_b32 v2, 4, v2");
    assert_eq(load32(&buf + 16), 0x680000C1, "v_add_u32 v0, -1, v0");
    assert_eq(load32(&buf + 20), 0x680404C1, "v_add_u32 v2, -1, v2");

    # VOP1 cvt + mov — top byte 0x7E. cvt opcode 5, mov opcode 1.
    # VGPR src in 9-bit src0 starts at 256 (v0=0x100, v1=0x101, v2=0x102).
    assert_eq(load32(&buf + 24), 0x7E000B00, "v_cvt_f32_i32 v0, v0");
    assert_eq(load32(&buf + 28), 0x7E020B02, "v_cvt_f32_i32 v1, v2");
    assert_eq(load32(&buf + 32), 0x7E040280, "v_mov v2, 0.0");
    assert_eq(load32(&buf + 36), 0x7E0602F2, "v_mov v3, 1.0");

    # EXP pos0 done — top byte 0xF8. tgt=12 (pos0) in bits 4-9.
    # exp pos0 done en=0xF: 0xF8000000 | (1<<11) | (12<<4) | 0xF = 0xF80008CF.
    assert_eq(load32(&buf + 40), 0xF80008CF, "exp pos0 done word 0");
    assert_eq(load32(&buf + 44), 0x03020100, "exp pos0 vsrc0..3 = v0..v3");

    # s_endpgm — same as compute and FS.
    assert_eq(load32(&buf + 48), 0xBF810000, "s_endpgm");

    # 16 NOP padding dwords.
    var i = 0;
    while (i < 16) {
        assert_eq(load32(&buf + 52 + i * 4), 0xBF800000, "s_nop padding");
        i = i + 1;
    }
    return 0;
}

fn test_gfx9_vs_fullscreen_triangle_alignment() {
    # Dword-aligned, fits within a 256-byte-aligned shader BO slot
    # with 140 bytes of slack. Step 6.5 sizes the VS BO accordingly.
    assert_eq(GFX9_VS_FULLSCREEN_TRIANGLE_SIZE % 4, 0, "VS size is dword-aligned");
    return 0;
}

# ================================================================
# v3 Step 6.5(a) — clear-triangle PM4 register addresses + values
# ================================================================
# Pin every constant added for the Step 6.5(b) PM4 stream composer.
# Values extracted from the authoritative Mesa
# src/amd/registers/gfx9.json (fetched 2026-04-30); pinning here
# means a typo in transcription surfaces at CPU test time. Group
# follows the 3-block PM4 split in
# docs/proposals/v3-backend-interface.md v2.1.

fn test_gfx9_pipeline_ctx_register_addresses() {
    # Color/blend mode.
    assert_eq(R_CB_SHADER_MASK,    0xA23C, "CB_SHADER_MASK byte addr");
    assert_eq(R_CB_COLOR_CONTROL,  0xA808, "CB_COLOR_CONTROL byte addr");
    assert_eq(R_CB_BLEND0_CONTROL, 0xA780, "CB_BLEND0_CONTROL byte addr");
    # Rasterizer / clip mode.
    assert_eq(R_PA_SU_SC_MODE_CNTL, 0xA814, "PA_SU_SC_MODE_CNTL byte addr");
    assert_eq(R_PA_CL_CLIP_CNTL,    0xA810, "PA_CL_CLIP_CNTL byte addr");
    # Stage enable + reuse.
    assert_eq(R_VGT_SHADER_STAGES_EN, 0xAB54, "VGT_SHADER_STAGES_EN byte addr");
    assert_eq(R_VGT_REUSE_OFF,        0xAAB4, "VGT_REUSE_OFF byte addr");
    # SPI inputs/outputs.
    assert_eq(R_SPI_PS_INPUT_ENA,  0xA6CC, "SPI_PS_INPUT_ENA byte addr");
    assert_eq(R_SPI_PS_INPUT_ADDR, 0xA6D0, "SPI_PS_INPUT_ADDR byte addr");
    assert_eq(R_SPI_PS_IN_CONTROL, 0xA6D8, "SPI_PS_IN_CONTROL byte addr");
    assert_eq(R_SPI_VS_OUT_CONFIG, 0xA6C4, "SPI_VS_OUT_CONFIG byte addr");
    # Depth/stencil.
    assert_eq(R_DB_SHADER_CONTROL,   0xA80C, "DB_SHADER_CONTROL byte addr");
    assert_eq(R_DB_HTILE_SURFACE,    0xAABC, "DB_HTILE_SURFACE byte addr");
    assert_eq(R_DB_RENDER_OVERRIDE,  0xA00C, "DB_RENDER_OVERRIDE byte addr");
    assert_eq(R_DB_RENDER_OVERRIDE2, 0xA010, "DB_RENDER_OVERRIDE2 byte addr");
    return 0;
}

fn test_gfx9_pass_target_register_addresses() {
    # Scissors.
    assert_eq(R_PA_SC_SCREEN_SCISSOR_TL,  0xA030, "SCREEN_SCISSOR_TL byte addr");
    assert_eq(R_PA_SC_SCREEN_SCISSOR_BR,  0xA034, "SCREEN_SCISSOR_BR byte addr");
    assert_eq(R_PA_SC_GENERIC_SCISSOR_TL, 0xA240, "GENERIC_SCISSOR_TL byte addr");
    assert_eq(R_PA_SC_GENERIC_SCISSOR_BR, 0xA244, "GENERIC_SCISSOR_BR byte addr");
    # Viewport (xyz scale + offset for VPORT_0).
    assert_eq(R_PA_CL_VPORT_XSCALE,  0xA43C, "VPORT_XSCALE byte addr");
    assert_eq(R_PA_CL_VPORT_XOFFSET, 0xA440, "VPORT_XOFFSET byte addr");
    assert_eq(R_PA_CL_VPORT_YSCALE,  0xA444, "VPORT_YSCALE byte addr");
    assert_eq(R_PA_CL_VPORT_YOFFSET, 0xA448, "VPORT_YOFFSET byte addr");
    assert_eq(R_PA_CL_VPORT_ZSCALE,  0xA44C, "VPORT_ZSCALE byte addr");
    assert_eq(R_PA_CL_VPORT_ZOFFSET, 0xA450, "VPORT_ZOFFSET byte addr");
    assert_eq(R_PA_SC_VPORT_ZMIN_0,  0xA2D0, "VPORT_ZMIN_0 byte addr");
    assert_eq(R_PA_SC_VPORT_ZMAX_0,  0xA2D4, "VPORT_ZMAX_0 byte addr");
    # Raster engine + AA + screen offset.
    assert_eq(R_PA_SC_RASTER_CONFIG,           0xA350, "PA_SC_RASTER_CONFIG byte addr");
    assert_eq(R_PA_SC_AA_CONFIG,               0xABE0, "PA_SC_AA_CONFIG byte addr");
    assert_eq(R_PA_SU_HARDWARE_SCREEN_OFFSET,  0xA234, "PA_SU_HARDWARE_SCREEN_OFFSET byte addr");
    # CB_COLOR0 RT bind.
    assert_eq(R_CB_COLOR0_BASE,        0xAC60, "CB_COLOR0_BASE byte addr");
    assert_eq(R_CB_COLOR0_BASE_EXT,    0xAC64, "CB_COLOR0_BASE_EXT byte addr");
    assert_eq(R_CB_COLOR0_VIEW,        0xAC6C, "CB_COLOR0_VIEW byte addr");
    assert_eq(R_CB_COLOR0_INFO,        0xAC70, "CB_COLOR0_INFO byte addr");
    assert_eq(R_CB_COLOR0_ATTRIB,      0xAC74, "CB_COLOR0_ATTRIB byte addr");
    assert_eq(R_CB_COLOR0_DCC_CONTROL, 0xAC78, "CB_COLOR0_DCC_CONTROL byte addr");
    return 0;
}

fn test_gfx9_uconfig_graphics_register_addresses() {
    # UConfig regs encode at their real MMIO byte addresses.
    assert_eq(R_VGT_PRIMITIVE_TYPE, 0x30908, "VGT_PRIMITIVE_TYPE byte addr");
    assert_eq(R_VGT_NUM_INSTANCES,  0x30934, "VGT_NUM_INSTANCES byte addr");
    return 0;
}

fn test_gfx9_pipeline_ctx_value_constants() {
    assert_eq(GFX9_CB_TARGET_MASK_RGBA,         0xF,   "CB_TARGET_MASK RGBA all");
    assert_eq(GFX9_CB_SHADER_MASK_RGBA0,        0xF,   "CB_SHADER_MASK RT0 RGBA");
    assert_eq(GFX9_CB_COLOR_CONTROL_NORMAL,     0xCC,  "CB_COLOR_CONTROL NORMAL ROP");
    assert_eq(GFX9_CB_BLEND_DISABLED,           0x0,   "CB blend disabled");
    assert_eq(GFX9_PA_SU_SC_MODE_CULL_NONE,     0x4,   "PA_SU_SC_MODE cull none");
    assert_eq(GFX9_VGT_SHADER_STAGES_VS_PS,     0x0,   "VGT stages VS+PS only");
    assert_eq(GFX9_PA_CL_CLIP_CNTL_DEFAULT,     0x90000, "PA_CL_CLIP_CNTL default");
    assert_eq(GFX9_VGT_PRIMITIVE_TYPE_TRIANGLELIST, 0x4, "VGT primitive triangle list");
    assert_eq(GFX9_VGT_NUM_INSTANCES_ONE,       0x1,   "VGT num instances 1");
    assert_eq(GFX9_SPI_PS_INPUT_HANG_QUIRK_MIN, 0x2,   "SPI_PS_INPUT min for hang quirk");
    assert_eq(GFX9_SPI_VS_OUT_CONFIG_NO_VARYING, 0x0,  "SPI_VS_OUT_CONFIG no varying");
    assert_eq(GFX9_DB_SHADER_CONTROL_DEFAULT,   0x10,  "DB_SHADER_CONTROL default");
    # Composed bit-pattern values.
    assert_eq(GFX9_CB_COLOR_CONTROL_NORMAL_COPY, 0xCC0010, "CB_COLOR_CONTROL composed");
    assert_eq(GFX9_CB_COLOR0_INFO_RGBA8_UNORM,   0x28,     "CB_COLOR0_INFO RGBA8 unorm");
    assert_eq(GFX9_CB_COLOR0_ATTRIB_2D_LINEAR_RGBA8, 0x10000000, "CB_COLOR0_ATTRIB 2D linear");
    return 0;
}

# ================================================================
# v3 Step 6.5(b) — PM4 stream composer for clear-triangle dispatch
# ================================================================
# Verifies the four PM4 blocks compose correctly and produce the
# expected wire-form dwords. CPU-asserted by-construction. Layer-2
# verification (byte-exact vs radv-IB capture) gated on Hyprland.

fn test_native_int_to_f32_bits_and_negate() {
    # 0 → 0x00000000, 1 → 0x3F800000, 128 → 0x43000000, 256 → 0x43800000.
    assert_eq(native_int_to_f32_bits(0),    0x00000000, "int 0 → f32 bits");
    assert_eq(native_int_to_f32_bits(1),    0x3F800000, "int 1 → f32 bits");
    assert_eq(native_int_to_f32_bits(128),  0x43000000, "int 128 → f32 bits");
    assert_eq(native_int_to_f32_bits(256),  0x43800000, "int 256 → f32 bits");

    # Negation flips the sign bit. -1.0 = 0xBF800000, -128.0 = 0xC3000000.
    assert_eq(native_f32_neg_bits(0x3F800000), 0xBF800000, "neg 1.0");
    assert_eq(native_f32_neg_bits(0x43000000), 0xC3000000, "neg 128.0");
    # Negating 0.0 produces -0.0 = 0x80000000 (sign-bit flip).
    assert_eq(native_f32_neg_bits(0x00000000), 0x80000000, "neg 0.0");
    return 0;
}

fn test_native_pm4_render_pipeline_sh_layout() {
    # VS at VA 0xFFFF800200000000, FS at VA 0xFFFF800200001000.
    # VS PGM_LO = (vs_va >> 8) & 0xFFFFFFFF
    #          = (0xFFFF800200000000 >> 8) & 0xFFFFFFFF
    #          = 0x02000000.
    # VS PGM_HI = (vs_va >> 40) & 0xFFFFFFFF
    #          = 0xFFFF8002 & 0xFFFFFFFF = 0xFFFF8002.
    var buf[64];
    memset(&buf, 0xCC, 64);
    var pos = native_pm4_build_render_pipeline_sh(&buf, 0,
    0xFFFF800200000000,
    0xFFFF800200001000);
    # Two SET_SH_REG packets, each 4 values: 6 dwords each = 12 dwords = 48 bytes.
    assert_eq(pos, 48, "pipeline_sh size = 48 bytes");

    # First packet header — SET_SH_REG opcode 0x76, count_minus_1 = 4
    # (n+1 = 5 data dwords, count field stores n+1-1 = 4).
    # Header: 0xC0_count_minus_1<<16_0x76<<8 = 0xC0047600.
    assert_eq(load32(&buf + 0), 0xC0047600, "VS SET_SH_REG header");
    assert_eq(load32(&buf + 4), 0x48, "VS PGM_LO wire offset (0xB120 → 0x48)");
    # vs_va = 0xFFFF800200000000.
    # PGM_LO = (va >> 8) & 0xFFFFFFFF = 0x02000000 (Cyrius >> is logical).
    # PGM_HI = (va >> 40) & 0xFF = bits [47:40] of va = 0x80.
    assert_eq(load32(&buf + 8),  0x02000000, "VS PGM_LO = (vs_va>>8) low");
    assert_eq(load32(&buf + 12), 0x80,       "VS PGM_HI = (vs_va>>40) byte");
    assert_eq(load32(&buf + 16), GFX9_GFX_PGM_RSRC1_MIN, "VS PGM_RSRC1");
    assert_eq(load32(&buf + 20), GFX9_VS_PGM_RSRC2_MIN, "VS PGM_RSRC2");

    # Second packet — PS at offset +24 in buf.
    # fs_va = 0xFFFF800200001000 → PGM_LO = 0x02000010, PGM_HI = 0x80.
    assert_eq(load32(&buf + 24), 0xC0047600, "PS SET_SH_REG header");
    assert_eq(load32(&buf + 28), 0x08, "PS PGM_LO wire offset (0xB020 → 0x08)");
    assert_eq(load32(&buf + 32), 0x02000010, "PS PGM_LO = (fs_va>>8) low");
    assert_eq(load32(&buf + 36), 0x80,       "PS PGM_HI = (fs_va>>40) byte");
    assert_eq(load32(&buf + 40), GFX9_GFX_PGM_RSRC1_MIN, "PS PGM_RSRC1");
    assert_eq(load32(&buf + 44), GFX9_PS_PGM_RSRC2_MIN, "PS PGM_RSRC2");
    return 0;
}

fn test_native_pm4_render_pipeline_ctx_size_and_anchors() {
    # 2 grouped packets (3+2 values) + 17 singletons = 5+4+17*3 = 60 dw = 240 bytes.
    var buf[256];
    memset(&buf, 0xCC, 256);
    var pos = native_pm4_build_render_pipeline_ctx(&buf, 0);
    assert_eq(pos, 240, "pipeline_ctx size = 240 bytes");

    # First packet = SPI shader formats, 3 values starting at POS_FORMAT.
    # Header: PKT3(SET_CONTEXT_REG, count_minus_1=3, 0) = 0xC0036900.
    assert_eq(load32(&buf + 0), 0xC0036900, "SPI fmts SET_CONTEXT_REG header");
    # Wire offset = (0xA70C - 0xA000) / 4 = 0x70C/4 = 0x1C3.
    assert_eq(load32(&buf + 4),  0x1C3, "POS_FORMAT wire offset");
    assert_eq(load32(&buf + 8),  SPI_SHADER_POS_FORMAT_4,     "SPI POS_FORMAT");
    assert_eq(load32(&buf + 12), SPI_SHADER_Z_FORMAT_INVALID, "SPI Z_FORMAT");
    assert_eq(load32(&buf + 16), SPI_SHADER_COL_FORMAT_FP32_ABGR, "SPI COL_FORMAT");

    # Second packet = CB target/shader masks at +20 in buf.
    assert_eq(load32(&buf + 20), 0xC0026900, "CB masks SET_CONTEXT_REG header");
    # Wire offset = (0xA238 - 0xA000) / 4 = 0x238/4 = 0x8E.
    assert_eq(load32(&buf + 24), 0x8E, "CB_TARGET_MASK wire offset");
    assert_eq(load32(&buf + 28), GFX9_CB_TARGET_MASK_RGBA,  "CB_TARGET_MASK value");
    assert_eq(load32(&buf + 32), GFX9_CB_SHADER_MASK_RGBA0, "CB_SHADER_MASK value");

    # First singleton = CB_COLOR_CONTROL at +36. Single-reg: header + offset + value = 3 dwords.
    assert_eq(load32(&buf + 36), 0xC0016900, "CB_COLOR_CONTROL header");
    # Wire offset = (0xA808 - 0xA000) / 4 = 0x808/4 = 0x202.
    assert_eq(load32(&buf + 40), 0x202, "CB_COLOR_CONTROL wire offset");
    assert_eq(load32(&buf + 44), GFX9_CB_COLOR_CONTROL_NORMAL_COPY, "CB_COLOR_CONTROL value");
    return 0;
}

fn test_native_pm4_render_pass_target_layout_256x256() {
    # RT VA 0xFFFF800101000000 (matches src/backend_native.cyr's RT pool VA).
    # 256x256 RT — viewport scale = 128, offset = 128.
    var buf[256];
    memset(&buf, 0xCC, 256);
    var pos = native_pm4_build_render_pass_target(&buf, 0,
    0xFFFF800101000000,
    256, 256);
    # Block size: 2 scissor pairs (4+4=8 dw) + 1 viewport-6 (8 dw) +
    # 1 zminmax-pair (4 dw) + 6 RT singletons (18 dw) = 38 dw = 152 bytes.
    assert_eq(pos, 152, "pass_target size = 152 bytes");

    # First packet = screen scissor pair at +0.
    assert_eq(load32(&buf + 0), 0xC0026900, "screen_scissor header");
    # Wire offset = (0xA030 - 0xA000) / 4 = 0xC.
    assert_eq(load32(&buf + 4), 0xC, "PA_SC_SCREEN_SCISSOR_TL wire offset");
    assert_eq(load32(&buf + 8),  0,         "scissor TL = (0,0)");
    # BR = (256 << 0) | (256 << 16) = 0x01000100.
    assert_eq(load32(&buf + 12), 0x01000100, "scissor BR = (256,256)");

    # Skip past second scissor + 6-value viewport packet to spot-check
    # the viewport scale/offset.
    # screen_scissor: 4 dw (16 bytes), generic_scissor: 4 dw (16 bytes),
    # viewport packet at offset 32. Header + offset + 6 values = 8 dw.
    # set_context_reg(n=6) → pkt3 count_minus_1 = 6 → header 0xC0066900.
    assert_eq(load32(&buf + 32), 0xC0066900, "viewport header (6 values)");
    # Wire offset (0xA43C - 0xA000)/4 = 0x10F.
    assert_eq(load32(&buf + 36), 0x10F, "PA_CL_VPORT_XSCALE wire offset");
    # Viewport: XSCALE = 128.0 = 0x43000000, XOFFSET = 128.0,
    # YSCALE = -128.0 = 0xC3000000, YOFFSET = 128.0,
    # ZSCALE = 1.0 = 0x3F800000, ZOFFSET = 0.
    assert_eq(load32(&buf + 40), 0x43000000, "VPORT XSCALE = 128.0");
    assert_eq(load32(&buf + 44), 0x43000000, "VPORT XOFFSET = 128.0");
    assert_eq(load32(&buf + 48), 0xC3000000, "VPORT YSCALE = -128.0");
    assert_eq(load32(&buf + 52), 0x43000000, "VPORT YOFFSET = 128.0");
    assert_eq(load32(&buf + 56), 0x3F800000, "VPORT ZSCALE = 1.0");
    assert_eq(load32(&buf + 60), 0,          "VPORT ZOFFSET = 0.0");
    return 0;
}

fn test_native_pm4_render_pass_target_rt_bind() {
    # RT VA 0xFFFF800101000000.
    # (rt_va >> 8): canonical-high arithmetic shift → 0xFFFFFF8001010000
    # & 0xFFFFFFFF → 0x01010000 (low 32 bits hold the BO offset >> 8).
    # (rt_va >> 40) & 0xFF: bits 40-47 of rt_va. The byte at that
    # position in 0xFFFF800101000000 is 0x80.
    var buf[256];
    memset(&buf, 0xCC, 256);
    var pos = native_pm4_build_render_pass_target(&buf, 0,
    0xFFFF800101000000,
    256, 256);
    # CB_COLOR0 singletons follow scissor (32) + viewport (32) + zmm (16)
    # = 80 bytes. CB_COLOR0_BASE single-reg header at offset 80.
    # set_context_reg_one → pkt3_header(0x69, 2, 0) → count_minus_1 = 1.
    assert_eq(load32(&buf + 80), 0xC0016900, "CB_COLOR0_BASE header");
    # Wire offset (0xAC60 - 0xA000)/4 = 0xC60/4 = 0x318.
    assert_eq(load32(&buf + 84), 0x318, "CB_COLOR0_BASE wire offset");
    assert_eq(load32(&buf + 88), 0x01010000, "CB_COLOR0_BASE = (rt_va>>8) low");

    # CB_COLOR0_BASE_EXT at +92 (next 3-dword packet).
    assert_eq(load32(&buf + 92), 0xC0016900, "CB_COLOR0_BASE_EXT header");
    assert_eq(load32(&buf + 96), 0x319, "CB_COLOR0_BASE_EXT wire offset");
    assert_eq(load32(&buf + 100), 0x80, "CB_COLOR0_BASE_EXT = (rt_va>>40) byte");
    return 0;
}

fn test_native_pm4_render_draw_tail() {
    var buf[16];
    memset(&buf, 0xCC, 16);
    var pos = native_pm4_build_render_draw_tail(&buf, 0);
    assert_eq(pos, 12, "draw_tail = 3 dwords");
    # DRAW_INDEX_AUTO header: count_minus_1=1, opcode=0x2D → 0xC0012D00.
    assert_eq(load32(&buf + 0), 0xC0012D00, "DRAW_INDEX_AUTO header");
    assert_eq(load32(&buf + 4), GFX9_FULLSCREEN_TRI_VCOUNT, "vertex_count = 3");
    assert_eq(load32(&buf + 8), DI_SRC_SEL_AUTO_INDEX, "auto-index draw initiator");
    return 0;
}

fn test_native_pm4_render_clear_triangle_top_level() {
    # End-to-end composer. Buffer needs ≥ 1024 bytes (256-dword pad target).
    var buf[1024];
    memset(&buf, 0xCC, 1024);
    var pos = native_pm4_build_render_clear_triangle(&buf,
    0xFFFF800200000000,   # vs_va
    0xFFFF800200001000,   # fs_va
    0xFFFF800101000000,   # rt_va
    256, 256);            # rt extent
    # Padded to 256 dwords = 1024 bytes.
    assert_eq(pos, 1024, "composer pads to 1024 bytes");

    # ACQUIRE_MEM at offset 0: 7 dwords (28 bytes), header 0xC0055802.
    assert_eq(load32(&buf + 0), 0xC0055802, "ACQUIRE_MEM header");

    # First UConfig SET_REG packet at offset 28 (post-ACQUIRE_MEM).
    # set_uconfig_reg_one passes count=2 to pkt3_header → count_minus_1=1
    # → header 0xC0017900.
    assert_eq(load32(&buf + 28), 0xC0017900, "VGT_PRIMITIVE_TYPE UConfig header");
    # VGT_PRIMITIVE_TYPE wire offset = (0x30908 - 0x30000)/4 = 0x242.
    assert_eq(load32(&buf + 32), 0x242, "VGT_PRIMITIVE_TYPE wire offset");
    assert_eq(load32(&buf + 36), GFX9_VGT_PRIMITIVE_TYPE_TRIANGLELIST, "primitive type");

    # Second UConfig at offset 40.
    assert_eq(load32(&buf + 40), 0xC0017900, "VGT_NUM_INSTANCES UConfig header");
    # VGT_NUM_INSTANCES wire offset = (0x30934 - 0x30000)/4 = 0x24D.
    assert_eq(load32(&buf + 44), 0x24D, "VGT_NUM_INSTANCES wire offset");
    assert_eq(load32(&buf + 48), GFX9_VGT_NUM_INSTANCES_ONE, "num instances 1");

    # Pipeline_sh starts at offset 52. VS PGM_LO header.
    assert_eq(load32(&buf + 52), 0xC0047600, "pipeline_sh begins (VS SET_SH_REG)");

    # CACHE_FLUSH_AND_INV EVENT_WRITE spliced after draw_tail (Step
    # 6.10 wired post-pivot). draw_tail ends at offset 504; the
    # 8-byte EVENT_WRITE packet lands at 504..512 with header
    # 0xC0004600 and body 0x00000016.
    assert_eq(load32(&buf + 504), 0xC0004600,
    "EVENT_WRITE header after draw_tail");
    assert_eq(load32(&buf + 508), 0x00000016,
    "CACHE_FLUSH_AND_INV body");
    return 0;
}

fn test_native_pm4_render_clear_triangle_block_sizes() {
    # Confirm block sizes sum to the expected pre-padding total.
    # ACQUIRE_MEM (28) + 2 UConfig (24) + sh (48) + ctx (228) +
    # pass_target (152) + draw_tail (12) = 492 bytes pre-pad.
    var buf[1024];
    memset(&buf, 0xCC, 1024);

    var p = 0;
    p = native_pm4_acquire_mem_full_invalidate(&buf, p);
    assert_eq(p, 28, "ACQUIRE_MEM = 28");
    p = native_pm4_set_uconfig_reg_one(&buf, p, R_VGT_PRIMITIVE_TYPE,
    GFX9_VGT_PRIMITIVE_TYPE_TRIANGLELIST);
    assert_eq(p, 40, "+UConfig 1");
    p = native_pm4_set_uconfig_reg_one(&buf, p, R_VGT_NUM_INSTANCES,
    GFX9_VGT_NUM_INSTANCES_ONE);
    assert_eq(p, 52, "+UConfig 2");
    p = native_pm4_build_render_pipeline_sh(&buf, p,
    0xFFFF800200000000,
    0xFFFF800200001000);
    assert_eq(p, 100, "+pipeline_sh = 48");
    p = native_pm4_build_render_pipeline_ctx(&buf, p);
    assert_eq(p, 340, "+pipeline_ctx = 240");
    p = native_pm4_build_render_pass_target(&buf, p,
    0xFFFF800101000000, 256, 256);
    assert_eq(p, 492, "+pass_target = 152");
    p = native_pm4_build_render_draw_tail(&buf, p);
    assert_eq(p, 504, "+draw_tail = 12");
    return 0;
}

# ================================================================
# v3 Step 6.6 — render-ring dispatch helpers (CPU-testable surface)
# ================================================================
# native_render_dispatch_simple itself drives real DRM_AMDGPU_CS
# syscalls (HW gate is 6.9(b)). Its CPU-testable building blocks
# are the (vs, fs, rt) handle triple writer and the 5-entry
# BO_HANDLES list packer — both pinned here.

fn test_native_render_handles_write_layout() {
    var triple[24];
    memset(&triple, 0xCC, 24);
    native_render_handles_write(&triple, 0x1111, 0x2222, 0x3333);
    assert_eq(load64(&triple +  0), 0x1111, "vs handle at +0");
    assert_eq(load64(&triple +  8), 0x2222, "fs handle at +8");
    assert_eq(load64(&triple + 16), 0x3333, "rt handle at +16");
    return 0;
}

fn test_native_render_bo_list_pack_layout() {
    # 5 entries × 8 bytes (handle u32 + priority u32) = 40 bytes.
    var entries[40];
    memset(&entries, 0xCC, 40);
    native_render_bo_list_pack(&entries,
    0xF1,    # fence_h
    0xA0,    # vs_h
    0xA1,    # fs_h
    0xB0,    # rt_h
    0xC0);   # ib_h
    # Order matters: fence / vs / fs / rt / ib. Priorities mirror
    # compute's pattern (fence=1, shaders=4, target=3, ib=10).
    assert_eq(load32(&entries +  0), 0xF1, "fence handle");
    assert_eq(load32(&entries +  4), 1,    "fence priority = 1");
    assert_eq(load32(&entries +  8), 0xA0, "vs handle");
    assert_eq(load32(&entries + 12), 4,    "vs priority = 4");
    assert_eq(load32(&entries + 16), 0xA1, "fs handle");
    assert_eq(load32(&entries + 20), 4,    "fs priority = 4");
    assert_eq(load32(&entries + 24), 0xB0, "rt handle");
    assert_eq(load32(&entries + 28), 3,    "rt priority = 3");
    assert_eq(load32(&entries + 32), 0xC0, "ib handle");
    assert_eq(load32(&entries + 36), 10,   "ib priority = 10");
    return 0;
}

fn test_native_render_bo_list_pack_distinct_from_compute() {
    # Compute's inline list is (fence, stub, out, shader, ib) at
    # priorities (1, 3, 3, 4, 10). Render's is (fence, vs, fs, rt, ib)
    # at (1, 4, 4, 3, 10). Slot-by-slot they differ — guard against
    # an accidental "same shape" refactor that would hand the kernel
    # the wrong residency story.
    var render_entries[40];
    memset(&render_entries, 0, 40);
    native_render_bo_list_pack(&render_entries, 1, 2, 3, 4, 5);
    # Slot 1 (post-fence): render=vs prio 4; compute=stub prio 3.
    assert_eq(load32(&render_entries + 12), 4, "render slot1 prio = 4 (vs)");
    # Slot 3: render=rt prio 3; compute=shader prio 4. Different.
    assert_eq(load32(&render_entries + 28), 3, "render slot3 prio = 3 (rt)");
    return 0;
}

# ================================================================
# v3 Step 6.8(c) — NativeRenderPipeline + NativePass layouts
# ================================================================
# v2.1's 4-block PM4 split lives in two structs: NativeRenderPipeline
# carries the pre-built per-pipeline blocks; NativePass carries
# per-pass refs. Layout tests pin the field offsets + sizes; the
# load-bearing byte-exact test asserts that the cached blocks are
# bit-identical to a fresh composer invocation (so pass_draw can
# memcpy them with confidence).

fn test_native_render_pipeline_struct_field_offsets() {
    assert_eq(NATIVE_PIPE_FIELD_VS_HANDLE,  0,   "vs_handle at +0");
    assert_eq(NATIVE_PIPE_FIELD_VS_VA,      8,   "vs_va at +8");
    assert_eq(NATIVE_PIPE_FIELD_FS_HANDLE,  16,  "fs_handle at +16");
    assert_eq(NATIVE_PIPE_FIELD_FS_VA,      24,  "fs_va at +24");
    assert_eq(NATIVE_PIPE_FIELD_SH_BLOCK,   32,  "sh_block at +32");
    assert_eq(NATIVE_PIPE_FIELD_CTX_BLOCK,  80,  "ctx_block at +80");
    assert_eq(NATIVE_PIPE_SH_BLOCK_SIZE,    48,  "sh_block size = 48");
    assert_eq(NATIVE_PIPE_CTX_BLOCK_SIZE,   240, "ctx_block size = 240");
    assert_eq(NATIVE_PIPE_STRUCT_SIZE,      320, "total = 320");
    # The two block sizes must match the composers' actual outputs;
    # the SH_BLOCK starts where the header ends, and the CTX_BLOCK
    # starts where the SH_BLOCK ends.
    assert_eq(NATIVE_PIPE_FIELD_SH_BLOCK + NATIVE_PIPE_SH_BLOCK_SIZE,
    NATIVE_PIPE_FIELD_CTX_BLOCK,
    "sh_block end = ctx_block start");
    assert_eq(NATIVE_PIPE_FIELD_CTX_BLOCK + NATIVE_PIPE_CTX_BLOCK_SIZE,
    NATIVE_PIPE_STRUCT_SIZE,
    "ctx_block end = struct end");
    return 0;
}

fn test_native_render_pipeline_pack_matches_composer() {
    # The cached sh_block + ctx_block in NativeRenderPipeline must be
    # byte-identical to what the standalone composer emits — that's
    # the contract pass_draw relies on when it memcpy's them into the
    # IB. If the composers ever drift (a 6.5(b) refactor that changes
    # an emit order, e.g.), this test fails immediately.
    var vs_va = 0xFFFF800200000000;
    var fs_va = 0xFFFF800200001000;

    var pipe[320];
    memset(&pipe, 0xCC, 320);
    var rc = native_render_pipeline_pack(&pipe, 0xAA, vs_va, 0xBB, fs_va);
    assert_eq(rc, 0, "pack returns 0 on success");

    # Header round-trips.
    assert_eq(load64(&pipe + NATIVE_PIPE_FIELD_VS_HANDLE), 0xAA,  "vs_handle");
    assert_eq(load64(&pipe + NATIVE_PIPE_FIELD_VS_VA),     vs_va, "vs_va");
    assert_eq(load64(&pipe + NATIVE_PIPE_FIELD_FS_HANDLE), 0xBB,  "fs_handle");
    assert_eq(load64(&pipe + NATIVE_PIPE_FIELD_FS_VA),     fs_va, "fs_va");

    # Re-build the blocks via the composers into a parallel buffer
    # and compare dword-by-dword.
    var ref_sh[48];
    memset(&ref_sh, 0xDD, 48);
    var sh_end = native_pm4_build_render_pipeline_sh(&ref_sh, 0, vs_va, fs_va);
    assert_eq(sh_end, 48, "ref sh_block ends at 48");

    var ref_ctx[240];
    memset(&ref_ctx, 0xDD, 240);
    var ctx_end = native_pm4_build_render_pipeline_ctx(&ref_ctx, 0);
    assert_eq(ctx_end, 240, "ref ctx_block ends at 240");

    var i = 0;
    while (i < 48) {
        assert_eq(load32(&pipe + NATIVE_PIPE_FIELD_SH_BLOCK + i),
        load32(&ref_sh + i),
        "sh_block dword matches composer");
        i = i + 4;
    }
    var j = 0;
    while (j < 240) {
        assert_eq(load32(&pipe + NATIVE_PIPE_FIELD_CTX_BLOCK + j),
        load32(&ref_ctx + j),
        "ctx_block dword matches composer");
        j = j + 4;
    }
    return 0;
}

fn test_native_render_pipeline_pack_null_out() {
    assert_eq(native_render_pipeline_pack(0, 1, 2, 3, 4), -1, "null out → -1");
    return 0;
}

fn test_native_render_pass_struct_field_offsets() {
    assert_eq(NATIVE_PASS_FIELD_CTX,         0,  "ctx_ref at +0");
    assert_eq(NATIVE_PASS_FIELD_RESERVED,    8,  "reserved at +8");
    assert_eq(NATIVE_PASS_FIELD_RT,          16, "rt_ptr at +16");
    assert_eq(NATIVE_PASS_FIELD_CLEAR_COLOR, 24, "clear_color at +24");
    assert_eq(NATIVE_PASS_STRUCT_SIZE,       32, "total = 32");
    return 0;
}

# ================================================================
# v3 Step 6.10 prep — EVENT_WRITE / CACHE_FLUSH_AND_INV PM4 builder
# ================================================================
# Stand-alone PM4 packet primitive. Not yet wired into the render
# composer — the splice into `native_pm4_build_render_clear_triangle`
# happens after HW confirms the e2e program's pixel readback fails
# from the missing post-draw flush. Tests pin the binary form of the
# event-write packet so it stays usable when that day comes.

fn test_gfx9_event_type_constants() {
    # Sourced from Mesa gfx9.json VGT_EVENT_TYPE enum. CACHE_FLUSH_AND_INV
    # is the canonical post-draw-pre-readback event radv emits before
    # CB readback; CACHE_FLUSH alone is for less-aggressive paths.
    assert_eq(GFX9_EVENT_TYPE_CACHE_FLUSH,         0x04, "CACHE_FLUSH = 0x04");
    assert_eq(GFX9_EVENT_TYPE_CACHE_FLUSH_AND_INV, 0x16, "CACHE_FLUSH_AND_INV = 0x16");
    assert_eq(GFX9_EVENT_INDEX_OTHER,              0x0,  "event_index OTHER = 0");
    assert_eq(GFX9_EVENT_INDEX_TS,                 0x5,  "event_index TS = 5");
    return 0;
}

fn test_native_pm4_event_write_layout() {
    var buf[16];
    memset(&buf, 0xCC, 16);
    var pos = native_pm4_event_write(&buf, 0,
    GFX9_EVENT_TYPE_CACHE_FLUSH_AND_INV,
    GFX9_EVENT_INDEX_OTHER);
    assert_eq(pos, 8, "EVENT_WRITE = 2 dwords (8 bytes)");
    # PKT3 header: count_minus_1 = 1 (count = 2 → c-1 = 1), opcode 0x46 (EVENT_WRITE),
    # type 3, predicate 0 → 0xC0004600.
    assert_eq(load32(&buf + 0), 0xC0004600, "EVENT_WRITE PKT3 header");
    # Body: event_index (0) << 8 | event_type (0x16) = 0x00000016.
    assert_eq(load32(&buf + 4), 0x00000016, "body = event_type | event_index<<8");
    # Past the packet: untouched 0xCC sentinel.
    assert_eq(load32(&buf + 8), 0xCCCCCCCC, "byte 8 still sentinel");
    return 0;
}

fn test_native_pm4_event_write_packs_event_index() {
    # If a future caller passes a non-OTHER event_index (e.g., 5 for
    # a TS-style event), the body must encode it in bits[11:8] without
    # disturbing the event_type in bits[5:0].
    var buf[8];
    memset(&buf, 0, 8);
    native_pm4_event_write(&buf, 0, 0x14, 0x5);
    # body = (5 << 8) | 0x14 = 0x514
    assert_eq(load32(&buf + 4), 0x514,
    "event_index = 5, event_type = 0x14 packs to 0x514");
    return 0;
}

fn test_native_pm4_event_write_cache_flush_and_inv() {
    # The convenience wrapper must produce byte-exact what the
    # general-purpose builder produces with the standard args.
    var buf_a[8];
    memset(&buf_a, 0, 8);
    native_pm4_event_write_cache_flush_and_inv(&buf_a, 0);

    var buf_b[8];
    memset(&buf_b, 0, 8);
    native_pm4_event_write(&buf_b, 0, 0x16, 0);

    assert_eq(load32(&buf_a + 0), load32(&buf_b + 0), "header matches");
    assert_eq(load32(&buf_a + 4), load32(&buf_b + 4), "body matches");
    # Spot-check the absolute body value (0x16 in low byte, no index).
    assert_eq(load32(&buf_a + 4), 0x00000016, "wrapper body = 0x16");
    return 0;
}

fn test_native_pm4_event_write_advances_pos() {
    # Position-tracking builders compose by passing pos through. Make
    # sure event_write doesn't accidentally rewrite from the start.
    var buf[16];
    memset(&buf, 0, 16);
    var pos = 0;
    pos = native_pm4_nop(&buf, pos, 2);  # 2 dwords (8 bytes)
    assert_eq(pos, 8, "nop landed at offset 0..7");
    pos = native_pm4_event_write_cache_flush_and_inv(&buf, pos);
    assert_eq(pos, 16, "event_write landed at offset 8..15");
    # Verify the NOP header is still at offset 0 (not overwritten).
    assert_eq(load32(&buf + 0) != 0, 1, "NOP header preserved at 0");
    # And the EVENT_WRITE header is at offset 8.
    assert_eq(load32(&buf + 8), 0xC0004600, "EVENT_WRITE header at +8");
    assert_eq(load32(&buf + 12), 0x00000016, "EVENT_WRITE body at +12");
    return 0;
}

