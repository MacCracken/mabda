fn test_gpu_render_pass_draw_dispatches_through_backend() {
    _step69_pass_draw_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_RENDER_PASS_DRAW,
                     &_step69_pass_draw_capture);
    var ctx = alloc(96);
    memset(ctx, 0, 96);
    store64(ctx + 32, b);
    var rc = gpu_render_pass_draw(ctx, 0xBEEF07, 0xBEEF08, 3, 1);
    assert_eq(rc, 0, "slot return value propagates");
    assert_eq(_step69_pass_draw_count, 1, "slot dispatched once");
    assert_eq(_step69_pass_draw_ctx, ctx, "arg 1 = ctx");
    assert_eq(_step69_pass_draw_pass, 0xBEEF07, "arg 2 = pass");
    assert_eq(_step69_pass_draw_pipe, 0xBEEF08, "arg 3 = pipe");
    assert_eq(_step69_pass_draw_vc, 3, "arg 4 = vertex_count");
    assert_eq(_step69_pass_draw_ic, 1, "arg 5 = instance_count");
    return 0;
}

var _step69_pass_end_count = 0;
fn _step69_pass_end_capture(ctx, pass) {
    _step69_pass_end_count = _step69_pass_end_count + 1;
    return 0;
}
fn test_gpu_render_pass_end_dispatches_through_backend() {
    _step69_pass_end_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_RENDER_PASS_END,
                     &_step69_pass_end_capture);
    var ctx = alloc(96);
    memset(ctx, 0, 96);
    store64(ctx + 32, b);
    gpu_render_pass_end(ctx, 0xBEEF09);
    assert_eq(_step69_pass_end_count, 1, "slot dispatched once");
    return 0;
}

fn test_gpu_render_dispatchers_null_ctx_safe() {
    # All seven render dispatchers must short-circuit on null ctx
    # without dispatching. No mock backend needed.
    assert_eq(gpu_render_target_create_2d_rgba8(0, 64, 64), 0, "rt_create null ctx -> 0");
    assert_eq(gpu_render_target_release(0, 0xDEAD), 0, "rt_release null ctx -> 0");
    assert_eq(gpu_render_pipeline_create(0, 1, 2, 28), 0, "pipe_create null ctx -> 0");
    assert_eq(gpu_render_pipeline_release(0, 0xDEAD), 0, "pipe_release null ctx -> 0");
    var color[32];
    memset(&color, 0, 32);
    assert_eq(gpu_render_pass_begin(0, 0xDEAD, &color), 0, "pass_begin null ctx -> 0");
    assert_eq(gpu_render_pass_draw(0, 1, 2, 3, 1), GPU_ERR_OTHER, "pass_draw null ctx -> ERR");
    assert_eq(gpu_render_pass_end(0, 0xDEAD), 0, "pass_end null ctx -> 0");
    return 0;
}

