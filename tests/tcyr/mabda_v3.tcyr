# explicit gpu_context_new_native() entry point regardless of the
# global default. Layout test below exercises the +40 stub_addr
# field that grew GpuContext from 40 → 48 bytes.

fn test_mabda_backend_kind_default_is_wgpu() {
    assert_eq(MABDA_BACKEND_KIND, BACKEND_KIND_WGPU, "default selector = WGPU");
    return 0;
}

fn test_native_ctx_stub_addr_accessor() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx + 40, 0xC0DE);
    assert_eq(native_ctx_stub_addr(ctx), 0xC0DE, "stub_addr at +40");
    # Other fields untouched
    assert_eq(native_ctx_fd(ctx), 0, "fd zero");
    assert_eq(native_ctx_id(ctx), 0, "ctx_id zero");
    assert_eq(native_ctx_stub_handle(ctx), 0, "stub_handle zero");
    assert_eq(native_ctx_stub_va(ctx), 0, "stub_va zero");
    assert_eq(gpu_ctx_backend(ctx), 0, "backend zero");
    return 0;
}

# ================================================================
# v3 Step 4f.i — errno → GpuErr mapping
# ================================================================
# _native_errno_to_gpu_err takes a positive errno; the helper maps
# it to the closest existing GPU_ERR_* code per the convention
# documented in src/backend_native.cyr. _native_neg_rc_to_gpu_err
# wraps the negative-rc convention used by native_* primitives
# (rc <= 0 means error, sign-flipped errno).

fn test_native_errno_to_gpu_err_classifies() {
    assert_eq(_native_errno_to_gpu_err(12),  GPU_ERR_BUFFER, "ENOMEM → BUFFER");
    assert_eq(_native_errno_to_gpu_err(1),   GPU_ERR_ADAPTER_NOT_FOUND, "EPERM → adapter");
    assert_eq(_native_errno_to_gpu_err(13),  GPU_ERR_ADAPTER_NOT_FOUND, "EACCES → adapter");
    assert_eq(_native_errno_to_gpu_err(2),   GPU_ERR_ADAPTER_NOT_FOUND, "ENOENT → adapter");
    assert_eq(_native_errno_to_gpu_err(16),  GPU_ERR_DEVICE_REQUEST, "EBUSY → device");
    assert_eq(_native_errno_to_gpu_err(110), GPU_ERR_SURFACE_TIMEOUT, "ETIMEDOUT → timeout");
    assert_eq(_native_errno_to_gpu_err(62),  GPU_ERR_SURFACE_TIMEOUT, "ETIME → timeout");
    return 0;
}

fn test_native_errno_to_gpu_err_default_other() {
    # Unknown errnos fall through to GPU_ERR_OTHER.
    assert_eq(_native_errno_to_gpu_err(22), GPU_ERR_OTHER, "EINVAL → OTHER (no specific code)");
    assert_eq(_native_errno_to_gpu_err(14), GPU_ERR_OTHER, "EFAULT → OTHER");
    assert_eq(_native_errno_to_gpu_err(38), GPU_ERR_OTHER, "ENOSYS → OTHER");
    assert_eq(_native_errno_to_gpu_err(0),  GPU_ERR_OTHER, "0 (caller bug) → OTHER");
    assert_eq(_native_errno_to_gpu_err(99), GPU_ERR_OTHER, "arbitrary → OTHER");
    return 0;
}

fn test_native_neg_rc_to_gpu_err_sign_flip() {
    # rc == 0 maps to 0 (success).
    assert_eq(_native_neg_rc_to_gpu_err(0), 0, "rc=0 → 0");
    # Negative rc: sign-flip to errno, then map.
    assert_eq(_native_neg_rc_to_gpu_err(-12),  GPU_ERR_BUFFER, "-ENOMEM");
    assert_eq(_native_neg_rc_to_gpu_err(-110), GPU_ERR_SURFACE_TIMEOUT, "-ETIMEDOUT");
    assert_eq(_native_neg_rc_to_gpu_err(-1),   GPU_ERR_ADAPTER_NOT_FOUND, "-EPERM");
    # Positive rc (defensive — some primitives might already pass abs).
    assert_eq(_native_neg_rc_to_gpu_err(12),   GPU_ERR_BUFFER, "+ENOMEM (defensive)");
    return 0;
}

# ================================================================
# v3 Step 4f.ii — BO page-perm constants
# ================================================================
# Locks in the current per-BO perm values. Narrowing the constants
# past these values will trip these tests before any hardware
# iteration burns TDR budget — re-tightening should land the
# narrowed value in src/backend_native.cyr AND the matching
# assertion here in the same change.

fn test_native_perm_constants_present() {
    var r = AMDGPU_VM_PAGE_READABLE;
    var w = AMDGPU_VM_PAGE_WRITEABLE;
    var x = AMDGPU_VM_PAGE_EXECUTABLE;
    # Locked-in per-BO minimums after the Step 4f.ii hardware
    # bisect. _NATIVE_PERM_IB needing the X bit is the surprise —
    # CP-fetched PM4 still goes through the execute-permission
    # gate on Cezanne. See module header in src/backend_native.cyr
    # for the full rationale.
    assert_eq(_NATIVE_PERM_FULL,   r | w | x, "FULL = R|W|X");
    assert_eq(_NATIVE_PERM_SHADER, r | x,     "SHADER = R|X");
    assert_eq(_NATIVE_PERM_DATA,   r | w,     "DATA = R|W");
    assert_eq(_NATIVE_PERM_IB,     r | x,     "IB = R|X (X is load-bearing)");
    return 0;
}

fn test_native_perm_bits_distinct() {
    # The three AMDGPU page-perm bits are distinct, so combining
    # them with bitwise OR is well-defined.
    assert(AMDGPU_VM_PAGE_READABLE != AMDGPU_VM_PAGE_WRITEABLE, "R != W");
    assert(AMDGPU_VM_PAGE_WRITEABLE != AMDGPU_VM_PAGE_EXECUTABLE, "W != X");
    assert(AMDGPU_VM_PAGE_READABLE != AMDGPU_VM_PAGE_EXECUTABLE, "R != X");
    return 0;
}

# ================================================================
# v3 Step 4f.iii — Resource tracker ctx-aware integration
# ================================================================
# FrameResources grew from 16 → 24 bytes; +0 holds an optional
# GpuContext*. frame_resources_release_buffers routes through
# gpu_buffer_release(ctx, h), which dispatches through
# ctx->backend->buffer_release. Mock-backend tests below verify
# dispatch semantics; counter increments per call confirm the
# tracker calls the slot exactly once per tracked handle.

var _step4f3_release_count = 0;
var _step4f3_release_handles[64];

fn _step4f3_release_capture(ctx, buf) {
    var idx = _step4f3_release_count;
    if (idx < 8) {
        store64(&_step4f3_release_handles + idx * 8, buf);
    }
    _step4f3_release_count = _step4f3_release_count + 1;
    return 0;
}

fn test_frame_resources_new_legacy_no_ctx() {
    var fr = frame_resources_new();
    assert(fr != 0, "fr non-null");
    assert_eq(frame_resources_ctx(fr), 0, "legacy ctor leaves ctx zero");
    assert_eq(frame_resources_buffer_count(fr), 0, "buffers empty");
    assert_eq(frame_resources_texture_count(fr), 0, "textures empty");
    return 0;
}

fn test_frame_resources_new_for_stores_ctx() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    var fr = frame_resources_new_for(ctx);
    assert_eq(frame_resources_ctx(fr), ctx, "ctx stored at +0");
    assert_eq(frame_resources_buffer_count(fr), 0, "buffers empty");
    assert_eq(frame_resources_texture_count(fr), 0, "textures empty");
    return 0;
}

fn test_frame_resources_track_buffers_and_textures() {
    var fr = frame_resources_new();
    frame_resources_track_buffer(fr, 0xAA01);
    frame_resources_track_buffer(fr, 0xAA02);
    frame_resources_track_buffer(fr, 0xAA03);
    frame_resources_track_texture(fr, 0xBB01);
    frame_resources_track_texture(fr, 0xBB02);
    assert_eq(frame_resources_buffer_count(fr), 3, "3 buffers");
    assert_eq(frame_resources_texture_count(fr), 2, "2 textures");
    return 0;
}

fn test_frame_resources_clear_pops_all() {
    var fr = frame_resources_new();
    frame_resources_track_buffer(fr, 0xCAFE);
    frame_resources_track_texture(fr, 0xBEEF);
    assert_eq(frame_resources_buffer_count(fr), 1, "1 buffer pre-clear");
    assert_eq(frame_resources_texture_count(fr), 1, "1 texture pre-clear");
    frame_resources_clear(fr);
    assert_eq(frame_resources_buffer_count(fr), 0, "buffers empty post-clear");
    assert_eq(frame_resources_texture_count(fr), 0, "textures empty post-clear");
    return 0;
}

fn test_frame_resources_release_buffers_dispatches_through_backend() {
    # Synth a ctx with a mock backend whose buffer_release slot
    # counts calls and captures handles.
    _step4f3_release_count = 0;
    memset(&_step4f3_release_handles, 0, 64);
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_BUFFER_RELEASE, &_step4f3_release_capture);
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx + 32, b);
    var fr = frame_resources_new_for(ctx);
    frame_resources_track_buffer(fr, 0xAA01);
    frame_resources_track_buffer(fr, 0xAA02);
    frame_resources_track_buffer(fr, 0xAA03);
    var n = frame_resources_release_buffers(fr);
    assert_eq(n, 3, "released 3 buffers");
    assert_eq(_step4f3_release_count, 3, "slot dispatched 3 times");
    assert_eq(frame_resources_buffer_count(fr), 0, "tracker drained");
    # All 3 handles passed through — order is LIFO since we vec_pop.
    var h0 = load64(&_step4f3_release_handles + 0);
    var h1 = load64(&_step4f3_release_handles + 8);
    var h2 = load64(&_step4f3_release_handles + 16);
    assert(h0 != 0, "handle 0 captured");
    assert(h1 != 0, "handle 1 captured");
    assert(h2 != 0, "handle 2 captured");
    # Sum check (any order — all 3 must have been seen)
    var total = h0 + h1 + h2;
    assert_eq(total, 0xAA01 + 0xAA02 + 0xAA03, "all 3 handles seen");
    return 0;
}

fn test_frame_resources_release_buffers_no_ctx_is_noop() {
    _step4f3_release_count = 0;
    var fr = frame_resources_new();    # legacy, no ctx
    frame_resources_track_buffer(fr, 0xDEAD);
    var n = frame_resources_release_buffers(fr);
    assert_eq(n, 0, "no-ctx fr releases 0");
    assert_eq(_step4f3_release_count, 0, "did not dispatch");
    # Buffer remains tracked — caller must clear manually.
    assert_eq(frame_resources_buffer_count(fr), 1, "buffer still tracked");
    return 0;
}

# ================================================================
# v3 Step 4f.iv — per-context IB + fence cache
# ================================================================
# GpuContext grew 48 → 96 bytes. New native-only fields at +48..+88
# hold the cached IB BO (handle/va/addr) and fence BO
# (handle/va/addr). Layout test below verifies offsets; multi-
# dispatch end-to-end validation is in programs/native_compute_store
# (would catch any regression of the cached path against real
# hardware).

fn test_native_ctx_ib_fence_accessors() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx + 48, 0x10A);   # ib_handle
    store64(ctx + 56, 0xFFFF800100200000); # ib_va
    store64(ctx + 64, 0x10C);   # ib_addr
    store64(ctx + 72, 0x10D);   # fence_handle
    store64(ctx + 80, 0xFFFF800100600000); # fence_va
    store64(ctx + 88, 0x10F);   # fence_addr
    assert_eq(native_ctx_ib_handle(ctx),    0x10A,                 "ib_handle at +48");
    assert_eq(native_ctx_ib_va(ctx),        0xFFFF800100200000,    "ib_va at +56");
    assert_eq(native_ctx_ib_addr(ctx),      0x10C,                 "ib_addr at +64");
    assert_eq(native_ctx_fence_handle(ctx), 0x10D,                 "fence_handle at +72");
    assert_eq(native_ctx_fence_va(ctx),     0xFFFF800100600000,    "fence_va at +80");
    assert_eq(native_ctx_fence_addr(ctx),   0x10F,                 "fence_addr at +88");
    return 0;
}

fn test_native_ctx_layout_isolation_step4iv() {
    # Mutating the new fields does not perturb +0..+40 ones.
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx +  0, 0xA1);
    store64(ctx +  8, 0xA2);
    store64(ctx + 16, 0xA3);
    store64(ctx + 24, 0xA4);
    store64(ctx + 32, 0xA5);
    store64(ctx + 40, 0xA6);
    # Now write the new fields:
    store64(ctx + 48, 0xB1);
    store64(ctx + 56, 0xB2);
    store64(ctx + 64, 0xB3);
    store64(ctx + 72, 0xB4);
    store64(ctx + 80, 0xB5);
    store64(ctx + 88, 0xB6);
    # All earlier fields untouched
    assert_eq(native_ctx_fd(ctx),         0xA1, "fd untouched");
    assert_eq(native_ctx_id(ctx),         0xA2, "ctx_id untouched");
    assert_eq(native_ctx_stub_handle(ctx),0xA3, "stub_handle untouched");
    assert_eq(native_ctx_stub_va(ctx),    0xA4, "stub_va untouched");
    assert_eq(gpu_ctx_backend(ctx),       0xA5, "backend untouched");
    assert_eq(native_ctx_stub_addr(ctx),  0xA6, "stub_addr untouched");
    return 0;
}

# ================================================================
# v3 Step 5.1 — native 2D RGBA8 texture primitives (Phase C)
# ================================================================
# CPU-only tests — size formula, NativeTexture struct layout, and
# VA-range isolation from the existing canonical-high allocations
# (shader / stub / IB / fence / output). Hardware tests for
# texture create + readback land in Step 5.8 (native_texture_e2e).

fn test_native_texture_size_2d_rgba8_formula() {
    assert_eq(native_texture_size_2d_rgba8(1, 1),     4,        "1x1 = 4 bytes");
    assert_eq(native_texture_size_2d_rgba8(16, 16),   1024,     "16x16 = 1 KiB");
    assert_eq(native_texture_size_2d_rgba8(256, 256), 262144,   "256x256 = 256 KiB");
    assert_eq(native_texture_size_2d_rgba8(64, 32),   8192,     "64x32 rectangular");
    assert_eq(native_texture_size_2d_rgba8(0, 0),     0,        "0x0 = 0 (degenerate)");
    return 0;
}

fn test_native_texture_struct_field_offsets() {
    assert_eq(NATIVE_TEX_FIELD_HANDLE, 0,  "handle at +0");
    assert_eq(NATIVE_TEX_FIELD_VA,     8,  "va at +8");
    assert_eq(NATIVE_TEX_FIELD_ADDR,   16, "addr at +16");
    assert_eq(NATIVE_TEX_FIELD_SIZE,   24, "size at +24");
    assert_eq(NATIVE_TEX_STRUCT_SIZE,  32, "total = 32");
    return 0;
}

fn test_native_texture_va_range_distinct() {
    # The texture VA base must not collide with the canonical-high
    # VAs already used by gpu_context_new_native + the consumer
    # programs. If a future allocation lands here, this test catches
    # the conflict before it produces a runtime VA-map failure.
    assert(_NATIVE_TEXTURE_VA_BASE != _NATIVE_STUB_VA,    "tex != stub");
    assert(_NATIVE_TEXTURE_VA_BASE != _NATIVE_IB_VA,      "tex != IB");
    assert(_NATIVE_TEXTURE_VA_BASE != _NATIVE_FENCE_VA,   "tex != fence");
    # Programs hardcode shader_va = 0xFFFF800100000000 and
    # output_va = 0xFFFF800100400000 — assert the texture base
    # doesn't alias either.
    assert(_NATIVE_TEXTURE_VA_BASE != 0xFFFF800100000000, "tex != shader VA");
    assert(_NATIVE_TEXTURE_VA_BASE != 0xFFFF800100400000, "tex != output VA");
    return 0;
}

fn test_native_texture_struct_round_trip() {
    # Hand-pack a NativeTexture struct (no fd needed) and verify the
    # field offsets thread through correctly.
    var tex[32];
    memset(&tex, 0, 32);
    store64(&tex + NATIVE_TEX_FIELD_HANDLE, 0xCAFE);
    store64(&tex + NATIVE_TEX_FIELD_VA,     _NATIVE_TEXTURE_VA_BASE);
    store64(&tex + NATIVE_TEX_FIELD_ADDR,   0xBEEF);
    store64(&tex + NATIVE_TEX_FIELD_SIZE,   1024);
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_HANDLE), 0xCAFE,                "handle round-trips");
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_VA),     _NATIVE_TEXTURE_VA_BASE, "va round-trips");
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_ADDR),   0xBEEF,                "addr round-trips");
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_SIZE),   1024,                  "size round-trips");
    return 0;
}

fn test_native_texture_release_null_tex_safe() {
    # Caller passes a null pointer — function must short-circuit
    # before reading any fields. No syscalls expected.
    var rc = native_texture_release_2d_rgba8(7, 0);
    assert_eq(rc, 0, "null tex returns 0");
    return 0;
}

fn test_native_texture_release_zero_handle_safe() {
    # Tex struct exists but handle is 0 — function must short-
    # circuit before va_unmap / bo_release_gtt (those would syscall
    # with handle=0 and produce -EINVAL). Caller may release an
    # uninitialised tex struct without panic.
    var tex[32];
    memset(&tex, 0, 32);
    var rc = native_texture_release_2d_rgba8(7, &tex);
    assert_eq(rc, 0, "zero-handle tex returns 0");
    # All fields remain zero (no spurious writes).
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_HANDLE), 0, "handle stays 0");
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_VA),     0, "va stays 0");
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_ADDR),   0, "addr stays 0");
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_SIZE),   0, "size stays 0");
    return 0;
}

# ================================================================
# v3 Step 5.5 — wgpu texture wrapper null-arg safety
# ================================================================
# The wgpu texture slot wrappers call into wgpu_device / queue
# primitives that need a real GPU. CPU-only tests cover the
# guard paths (null ctx, null tex, n mismatch, etc.) that
# short-circuit before any wgpu call. End-to-end validation
# happens in Step 5.9 via a phase0 Test 12 family.

fn test_backend_wgpu_texture_create_null_ctx_returns_zero() {
    var rc = _backend_wgpu_texture_create_2d_rgba8(0, 16, 16);
    assert_eq(rc, 0, "null ctx → 0 (no struct allocated)");
    return 0;
}

fn test_backend_wgpu_texture_create_zero_dim_returns_zero() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    assert_eq(_backend_wgpu_texture_create_2d_rgba8(ctx, 0, 16),  0, "w=0 → 0");
    assert_eq(_backend_wgpu_texture_create_2d_rgba8(ctx, 16, 0),  0, "h=0 → 0");
    assert_eq(_backend_wgpu_texture_create_2d_rgba8(ctx, 0, 0),   0, "0x0 → 0");
    return 0;
}

fn test_backend_wgpu_texture_write_null_args_err() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    var tex[32];
    memset(&tex, 0, 32);
    store32(&tex + 24, 16);
    store32(&tex + 28, 16);
    var src[64];
    memset(&src, 0, 64);
    assert_eq(_backend_wgpu_texture_write(0, &tex, &src, 1024),  GPU_ERR_OTHER,  "null ctx");
    assert_eq(_backend_wgpu_texture_write(ctx, 0, &src, 1024),   GPU_ERR_OTHER,  "null tex");
    assert_eq(_backend_wgpu_texture_write(ctx, &tex, 0, 1024),   GPU_ERR_BUFFER, "null src");
    assert_eq(_backend_wgpu_texture_write(ctx, &tex, &src, 0),   GPU_ERR_BUFFER, "n=0");
    return 0;
}

fn test_backend_wgpu_texture_write_size_mismatch_err() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    var tex[32];
    memset(&tex, 0, 32);
    store32(&tex + 24, 16);
    store32(&tex + 28, 16);
    var src[64];
    memset(&src, 0, 64);
    # 16x16 RGBA8 = 1024 bytes; passing 100 mismatches.
    assert_eq(_backend_wgpu_texture_write(ctx, &tex, &src, 100), GPU_ERR_BUFFER, "n != w*h*4");
    return 0;
}

fn test_backend_wgpu_texture_read_null_args_err() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    var tex[32];
    memset(&tex, 0, 32);
    store32(&tex + 24, 16);
    store32(&tex + 28, 16);
    var dst[64];
    memset(&dst, 0, 64);
    assert_eq(_backend_wgpu_texture_read(0, &tex, &dst, 1024),  GPU_ERR_OTHER,  "null ctx");
    assert_eq(_backend_wgpu_texture_read(ctx, 0, &dst, 1024),   GPU_ERR_OTHER,  "null tex");
    assert_eq(_backend_wgpu_texture_read(ctx, &tex, 0, 1024),   GPU_ERR_BUFFER, "null dst");
    assert_eq(_backend_wgpu_texture_read(ctx, &tex, &dst, 0),   GPU_ERR_BUFFER, "n=0");
    return 0;
}

fn test_backend_wgpu_texture_release_null_safe() {
    assert_eq(_backend_wgpu_texture_release(0, 0), 0, "null ctx is safe");
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    assert_eq(_backend_wgpu_texture_release(ctx, 0), 0, "null tex is safe");
    return 0;
}

# ================================================================
# v3 Step 5.6 — native texture wrapper safety
# ================================================================
# Native side wraps the Step 5.1+5.2 primitives. Create needs a
# real fd to syscall into amdgpu, so CPU tests cover the guard
# paths only (null ctx, zero dims, null src/dst, n mismatch).
# Hardware end-to-end is Step 5.8 (programs/native_texture_e2e).

fn test_backend_native_texture_create_null_ctx_returns_zero() {
    var rc = _backend_native_texture_create_2d_rgba8(0, 16, 16);
    assert_eq(rc, 0, "null ctx → 0 (no struct allocated)");
    return 0;
}

fn test_backend_native_texture_create_zero_dim_returns_zero() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    assert_eq(_backend_native_texture_create_2d_rgba8(ctx, 0, 16),  0, "w=0 → 0");
    assert_eq(_backend_native_texture_create_2d_rgba8(ctx, 16, 0),  0, "h=0 → 0");
    assert_eq(_backend_native_texture_create_2d_rgba8(ctx, 0, 0),   0, "0x0 → 0");
    return 0;
}

fn test_backend_native_texture_write_memcpy_round_trip() {
    # Synth a tex struct with addr pointing at a CPU buffer (no GPU
    # involvement on the native path — write is just memcpy onto
    # the mmap'd pointer). Lets us test the write+read pair from
    # CPU without the full create/release round-trip.
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    var pixels[16];
    memset(&pixels, 0, 16);
    var tex[32];
    memset(&tex, 0, 32);
    store64(&tex + NATIVE_TEX_FIELD_HANDLE, 1);  # non-zero so it doesn't look uninitialised
    store64(&tex + NATIVE_TEX_FIELD_ADDR,   &pixels);
    store64(&tex + NATIVE_TEX_FIELD_SIZE,   16);
    var src[16];
    var i = 0;
    while (i < 16) { store8(&src + i, i + 1); i = i + 1; }
    var rc_w = _backend_native_texture_write(ctx, &tex, &src, 16);
    assert_eq(rc_w, 0, "write returns 0");
    # Verify memcpy actually moved bytes.
    var j = 0;
    while (j < 16) {
        assert_eq(load8(&pixels + j), j + 1, "pixel byte matches src");
        j = j + 1;
    }
    var dst[16];
    memset(&dst, 0, 16);
    var rc_r = _backend_native_texture_read(ctx, &tex, &dst, 16);
    assert_eq(rc_r, 0, "read returns 0");
    var k = 0;
    while (k < 16) {
        assert_eq(load8(&dst + k), k + 1, "dst byte matches pixel");
        k = k + 1;
    }
    return 0;
}

fn test_backend_native_texture_write_null_args_err() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    var tex[32];
    memset(&tex, 0, 32);
    store64(&tex + NATIVE_TEX_FIELD_HANDLE, 1);
    store64(&tex + NATIVE_TEX_FIELD_SIZE,   1024);
    var src[8];
    memset(&src, 0, 8);
    assert_eq(_backend_native_texture_write(0, &tex, &src, 1024),  GPU_ERR_OTHER,  "null ctx");
    assert_eq(_backend_native_texture_write(ctx, 0, &src, 1024),   GPU_ERR_OTHER,  "null tex");
    assert_eq(_backend_native_texture_write(ctx, &tex, 0, 1024),   GPU_ERR_BUFFER, "null src");
    assert_eq(_backend_native_texture_write(ctx, &tex, &src, 0),   GPU_ERR_BUFFER, "n=0");
    # Tex with addr=0 (uninit) → err (catches the case where caller
    # forgot to call create before write).
    var tex2[32];
    memset(&tex2, 0, 32);
    store64(&tex2 + NATIVE_TEX_FIELD_SIZE, 1024);
    assert_eq(_backend_native_texture_write(ctx, &tex2, &src, 1024), GPU_ERR_BUFFER, "addr=0");
    return 0;
}

fn test_backend_native_texture_release_null_safe() {
    assert_eq(_backend_native_texture_release(0, 0), 0, "null ctx is safe");
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    assert_eq(_backend_native_texture_release(ctx, 0), 0, "null tex is safe");
    return 0;
}

# ================================================================
# v3 Step 5.7 — public gpu_texture_* dispatch through backend
# ================================================================
# Mock backend with counter+capture. Validates fncall threading on
# all 4 dispatchers. fncall4 (write/read) is the new shape this
# step exercises end-to-end.

var _step57_create_count = 0;
var _step57_create_ctx   = 0;
var _step57_create_w     = 0;
var _step57_create_h     = 0;

fn _step57_create_capture(ctx, w, h) {
    _step57_create_count = _step57_create_count + 1;
    _step57_create_ctx = ctx;
    _step57_create_w = w;
    _step57_create_h = h;
    return 0xCAFE;
}

fn test_gpu_texture_create_dispatches_through_backend() {
    _step57_create_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_CREATE_2D_RGBA8, &_step57_create_capture);
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx + 32, b);
    var got = gpu_texture_create_2d_rgba8(ctx, 64, 32);
    assert_eq(got, 0xCAFE, "slot return propagates");
    assert_eq(_step57_create_count, 1, "slot dispatched once");
    assert_eq(_step57_create_ctx, ctx, "arg 1 = ctx");
    assert_eq(_step57_create_w, 64, "arg 2 = width");
    assert_eq(_step57_create_h, 32, "arg 3 = height");
    return 0;
}

var _step57_write_count = 0;
var _step57_write_ctx = 0;
var _step57_write_tex = 0;
var _step57_write_src = 0;
var _step57_write_n   = 0;

fn _step57_write_capture(ctx, tex, src, n) {
    _step57_write_count = _step57_write_count + 1;
    _step57_write_ctx = ctx;
    _step57_write_tex = tex;
    _step57_write_src = src;
    _step57_write_n = n;
    return 0;
}

fn test_gpu_texture_write_dispatches_through_backend() {
    _step57_write_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_WRITE, &_step57_write_capture);
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx + 32, b);
    var rc = gpu_texture_write(ctx, 0xBEEF, 0xCAFE, 1024);
    assert_eq(rc, 0, "slot return propagates");
    assert_eq(_step57_write_count, 1, "slot dispatched once");
    assert_eq(_step57_write_ctx, ctx, "arg 1 = ctx");
    assert_eq(_step57_write_tex, 0xBEEF, "arg 2 = tex");
    assert_eq(_step57_write_src, 0xCAFE, "arg 3 = src");
    assert_eq(_step57_write_n, 1024, "arg 4 = n");
    return 0;
}

var _step57_read_count = 0;
var _step57_read_ctx = 0;
var _step57_read_tex = 0;
var _step57_read_dst = 0;
var _step57_read_n   = 0;

fn _step57_read_capture(ctx, tex, dst, n) {
    _step57_read_count = _step57_read_count + 1;
    _step57_read_ctx = ctx;
    _step57_read_tex = tex;
    _step57_read_dst = dst;
    _step57_read_n = n;
    return 0;
}

fn test_gpu_texture_read_dispatches_through_backend() {
    _step57_read_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_READ, &_step57_read_capture);
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx + 32, b);
    var rc = gpu_texture_read(ctx, 0xBEEF, 0xDEED, 2048);
    assert_eq(rc, 0, "slot return propagates");
