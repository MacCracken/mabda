# tests/tcyr/texture.tcyr — texture.cyr public API + mip math
# Functionality-grouped CPU suite (v3.1 test reorg 2026-06-15).
# Self-contained: the helpers/mocks each domain's tests need are inlined
# (a few small helpers are shared across domains by design).
include "src/lib.cyr"
include "lib/assert.cyr"

# --- shared test helpers / mocks ---
# ================================================================
# v3 Step 5.7 — public gpu_texture_* dispatch through backend
# ================================================================
# Mock backend with counter+capture. Validates fncall threading on
# all 4 dispatchers. fncall4 (write/read) is the new shape this
# step exercises end-to-end.

var _step57_create_count = 0;

var _step57_create_ctx   = 0;

var _step57_create_w     = 0;

var _step57_create_h     = 0;

fn _step57_create_capture(ctx, w, h) {
    _step57_create_count = _step57_create_count + 1;
    _step57_create_ctx = ctx;
    _step57_create_w = w;
    _step57_create_h = h;
    return 0xCAFE;
}

var _step57_write_count = 0;

var _step57_read_count = 0;

var _step57_release_count = 0;

fn test_vertex_blend_opaque() {
    var bs = blend_state_new(BLEND_OPAQUE);
    # color.operation = Add (1)
    assert_eq(load32(bs), WGPU_BLEND_OP_ADD, "opaque color op=Add");
    # color.srcFactor = One (2)
    assert_eq(load32(bs + 4), WGPU_BLEND_FACTOR_ONE, "opaque src=One");
    # color.dstFactor = Zero (1)
    assert_eq(load32(bs + 8), WGPU_BLEND_FACTOR_ZERO, "opaque dst=Zero");
    return 0;
}

fn test_vertex_blend_alpha() {
    var bs = blend_state_new(BLEND_ALPHA_BLEND);
    # color.srcFactor = SrcAlpha (5)
    assert_eq(load32(bs + 4), WGPU_BLEND_FACTOR_SRC_ALPHA, "alpha src=SrcAlpha");
    # color.dstFactor = OneMinusSrcAlpha (6)
    assert_eq(load32(bs + 8), WGPU_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA, "alpha dst=1-SrcAlpha");
    return 0;
}

fn test_depth_texture_accessors() {
    # Construct the DepthTexture struct directly — depth_texture_new calls
    # into the FFI layer, which isn't available in a standalone test.
    # Layout (40 bytes): handle(8) | view(8) | format(u32@16) | w(8@24) | h(8@32)
    var dt = alloc(40);
    store64(dt, 0);
    store64(dt + 8, 0);
    store32(dt + 16, DEPTH_FORMAT_DEPTH32_FLOAT);
    store64(dt + 24, 1920);
    store64(dt + 32, 1080);

    assert_eq(depth_texture_width(dt),  1920, "width stored");
    assert_eq(depth_texture_height(dt), 1080, "height stored");
    assert_eq(depth_texture_format(dt), DEPTH_FORMAT_DEPTH32_FLOAT, "format stored");
    return 0;
}

# MED-3: texture_upload_rgba8 short-circuits on zero/negative dimensions.
# We can't hit wgpu without a GPU, but calling with w=0 must return 0
# without segfaulting on the (0,0,1) extent.
fn test_audit_texture_upload_zero_dim() {
    # queue=0, texture=0 — never reached because we short-circuit first.
    assert_eq(texture_upload_rgba8(0, 0, 0, 0, 10), 0,
    "upload(0×10) short-circuits");
    assert_eq(texture_upload_rgba8(0, 0, 0, 10, 0), 0,
    "upload(10×0) short-circuits");
    assert_eq(texture_upload_rgba8(0, 0, 0, -1, 10), 0,
    "upload(-1×10) rejected");
    return 0;
}

fn test_audit_texture_create_exceeds_max_rejected() {
    assert_eq(texture_create_rgba8(0, 9000, 256, "too-wide"), 0,
    "texture_create_rgba8(width>MAX) returns 0");
    assert_eq(texture_create_rgba8(0, 256, 9000, "too-tall"), 0,
    "texture_create_rgba8(height>MAX) returns 0");
    return 0;
}

# v3.1 [M.1]: shared mip math. mip_level_count = floor(log2(max))+1;
# mip_level_dim halves per level, floors, clamps to 1.
fn test_mip_level_count() {
    assert_eq(mip_level_count(256, 256), 9, "256x256 -> 9 levels");
    assert_eq(mip_level_count(1, 1),     1, "1x1 -> 1 level");
    assert_eq(mip_level_count(256, 1),   9, "non-square uses max dim");
    assert_eq(mip_level_count(5, 5),     3, "5x5 -> 3 (5->2->1)");
    return 0;
}

fn test_mip_level_dim() {
    assert_eq(mip_level_dim(256, 0),   256, "level 0 = full");
    assert_eq(mip_level_dim(256, 1),   128, "level 1 = half");
    assert_eq(mip_level_dim(256, 8),   1,   "256 floors to 1 at level 8");
    assert_eq(mip_level_dim(256, 100), 1,   "clamps at 1 past the chain");
    assert_eq(mip_level_dim(1, 5),     1,   "1px stays 1");
    assert_eq(mip_level_dim(100, 1),   50,  "100 -> 50");
    assert_eq(mip_level_dim(100, 3),   12,  "100->50->25->12 (floor)");
    assert_eq(mip_level_dim(3, 1),     1,   "3/2 floors to 1");
    return 0;
}

fn test_frame_resources_track_buffers_and_textures() {
    var fr = frame_resources_new();
    frame_resources_track_buffer(fr, 0xAA01);
    frame_resources_track_buffer(fr, 0xAA02);
    frame_resources_track_buffer(fr, 0xAA03);
    frame_resources_track_texture(fr, 0xBB01);
    frame_resources_track_texture(fr, 0xBB02);
    assert_eq(frame_resources_buffer_count(fr), 3, "3 buffers");
    assert_eq(frame_resources_texture_count(fr), 2, "2 textures");
    return 0;
}

# Audit 2026-06-14 [HIGH-1]: the v3 gpu_texture_create_2d_rgba8 dropped
# the dimension validation its v2 sibling texture_create_rgba8 enforces.
# Restored — non-positive / oversized dims must be rejected (returning 0)
# BEFORE the slot fires, so an unvalidated width*height*4 never reaches
# the native GEM_CREATE ioctl + mmap.
fn test_gpu_texture_create_2d_rgba8_validates_dims() {
    _step57_create_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_CREATE_2D_RGBA8, &_step57_create_capture);
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx + 32, b);
    assert_eq(gpu_texture_create_2d_rgba8(ctx, 0, 16), 0, "width=0 rejected");
    assert_eq(gpu_texture_create_2d_rgba8(ctx, 16, 0 - 1), 0, "height<0 rejected");
    assert_eq(gpu_texture_create_2d_rgba8(ctx, 100000, 100000), 0, "oversized rejected (no overflow to slot)");
    assert_eq(_step57_create_count, 0, "slot never reached for invalid dims");
    var t = gpu_texture_create_2d_rgba8(ctx, 256, 256);
    assert_eq(t, 0xCAFE, "valid dims reach slot");
    assert_eq(_step57_create_count, 1, "slot fired once for valid dims");
    return 0;
}

# v3.1 [M.6]: mipped-create dispatcher — routes (w, h, mip_count) through
# the mipmap slot, expands mip_count==0 to the full chain, and rejects
# bad dims / out-of-range mip counts before the slot.
var _mip_create_count = 0;
var _mip_create_mc = 0;
fn _mip_create_capture(ctx, w, h, mc) {
    _mip_create_count = _mip_create_count + 1;
    _mip_create_mc = mc;
    return 0xABCD;
}

fn test_gpu_texture_create_mipped_dispatch() {
    _mip_create_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_CREATE_2D_RGBA8_MIPPED, &_mip_create_capture);
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx + 32, b);
    var t = gpu_texture_create_2d_rgba8_mipped(ctx, 256, 256, 4);
    assert_eq(t, 0xABCD, "valid mipped create reaches slot");
    assert_eq(_mip_create_count, 1, "slot fired once");
    assert_eq(_mip_create_mc, 4, "mip_count threaded through");
    gpu_texture_create_2d_rgba8_mipped(ctx, 256, 256, 0);
    assert_eq(_mip_create_mc, 9, "mip_count=0 expands to full chain (256 -> 9)");
    assert_eq(gpu_texture_create_2d_rgba8_mipped(ctx, 0, 16, 1), 0, "width=0 rejected");
    assert_eq(gpu_texture_create_2d_rgba8_mipped(ctx, 100000, 100000, 1), 0, "oversized rejected");
    assert_eq(gpu_texture_create_2d_rgba8_mipped(ctx, 256, 256, 99), 0, "mip>full rejected");
    assert_eq(gpu_texture_create_2d_rgba8_mipped(0, 256, 256, 4), 0, "null ctx rejected");
    assert_eq(_mip_create_count, 2, "slot only fired for the 2 valid calls");
    return 0;
}

# v3.1 [M.6b]: generate dispatcher routes (ctx, tex) through the slot;
# null args fail loud. native is the real path (HW-tested in M.7). wgpu's
# generate stays NOT_IMPLEMENTED until wgpu compute lands (see docs/archive/punchlists/3-2-punchlist.md).
var _mip_gen_count = 0;
var _mip_gen_tex = 0;
fn _mip_gen_capture(ctx, tex) {
    _mip_gen_count = _mip_gen_count + 1;
    _mip_gen_tex = tex;
    return 0;
}

fn test_gpu_texture_generate_mipmaps_dispatch() {
    _mip_gen_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_GENERATE_MIPMAPS, &_mip_gen_capture);
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx + 32, b);
    var rc = gpu_texture_generate_mipmaps(ctx, 0xDEAD);
    assert_eq(rc, 0, "generate routes to slot");
    assert_eq(_mip_gen_count, 1, "slot fired once");
    assert_eq(_mip_gen_tex, 0xDEAD, "tex threaded through");
    assert_eq(gpu_texture_generate_mipmaps(0, 0xDEAD), GPU_ERR_OTHER, "null ctx -> err");
    assert_eq(gpu_texture_generate_mipmaps(ctx, 0), GPU_ERR_OTHER, "null tex -> err");
    assert_eq(_mip_gen_count, 1, "slot not fired for null args");
    # wgpu generate is fail-loud NOT_IMPLEMENTED until wgpu compute lands (docs/archive/punchlists/3-2-punchlist.md).
    assert_eq(_backend_wgpu_texture_generate_mipmaps(0, 0), GPU_ERR_NOT_IMPLEMENTED,   #skip-lint
    "wgpu generate returns NOT_IMPLEMENTED");   #skip-lint
    return 0;
}

fn test_gpu_texture_dispatchers_null_ctx_safe() {
    _step57_create_count = 0;
    _step57_write_count = 0;
    _step57_read_count = 0;
    _step57_release_count = 0;
    assert_eq(gpu_texture_create_2d_rgba8(0, 16, 16), 0, "create null ctx = 0");
    assert_eq(gpu_texture_write(0, 0, 0, 0), GPU_ERR_OTHER, "write null ctx = err");
    assert_eq(gpu_texture_read(0, 0, 0, 0), GPU_ERR_OTHER, "read null ctx = err");
    assert_eq(gpu_texture_release(0, 0), 0, "release null ctx = 0");
    assert_eq(_step57_create_count, 0, "create did not dispatch");
    assert_eq(_step57_write_count, 0, "write did not dispatch");
    assert_eq(_step57_read_count, 0, "read did not dispatch");
    assert_eq(_step57_release_count, 0, "release did not dispatch");
    return 0;
}

# ================================================================
# v3.2 T.1 — compressed texture format table + block geometry
# ================================================================
fn test_texfmt_ids_distinct_and_bounded() {
    assert_eq(MABDA_TEXFMT_RGBA8, 0, "RGBA8 is the zero (default) id");
    assert_eq(MABDA_TEXFMT_COUNT, 12, "12 formats today");
    # Spot-check the families land at distinct, ordered ids.
    assert(MABDA_TEXFMT_BC1 < MABDA_TEXFMT_BC7, "BC1 before BC7");
    assert(MABDA_TEXFMT_BC7 < MABDA_TEXFMT_ETC2_RGB8, "BC before ETC2");
    assert(MABDA_TEXFMT_ETC2_RGBA8 < MABDA_TEXFMT_ASTC_4X4, "ETC2 before ASTC");
    assert(MABDA_TEXFMT_ASTC_8X8 < MABDA_TEXFMT_COUNT, "ASTC8x8 < COUNT");
    return 0;
}

# Assert one format's full geometry in a single helper to keep the table
# test readable.
fn _assert_texfmt(fmt, bw, bh, bytes, comp, name) {
    assert_eq(mabda_texfmt_block_width(fmt),  bw,   name);
    assert_eq(mabda_texfmt_block_height(fmt), bh,   name);
    assert_eq(mabda_texfmt_block_bytes(fmt),  bytes, name);
    assert_eq(mabda_texfmt_is_compressed(fmt), comp, name);
    return 0;
}

fn test_texfmt_block_geometry() {
    _assert_texfmt(MABDA_TEXFMT_RGBA8,       1, 1, 4,  0, "RGBA8 1x1/4B uncompressed");
    _assert_texfmt(MABDA_TEXFMT_BC1,         4, 4, 8,  1, "BC1 4x4/8B");
    _assert_texfmt(MABDA_TEXFMT_BC3,         4, 4, 16, 1, "BC3 4x4/16B");
    _assert_texfmt(MABDA_TEXFMT_BC4,         4, 4, 8,  1, "BC4 4x4/8B");
    _assert_texfmt(MABDA_TEXFMT_BC5,         4, 4, 16, 1, "BC5 4x4/16B");
    _assert_texfmt(MABDA_TEXFMT_BC6H,        4, 4, 16, 1, "BC6H 4x4/16B");
    _assert_texfmt(MABDA_TEXFMT_BC7,         4, 4, 16, 1, "BC7 4x4/16B");
    _assert_texfmt(MABDA_TEXFMT_ETC2_RGB8,   4, 4, 8,  1, "ETC2_RGB8 4x4/8B");
    _assert_texfmt(MABDA_TEXFMT_ETC2_RGBA8,  4, 4, 16, 1, "ETC2_RGBA8 4x4/16B");
    _assert_texfmt(MABDA_TEXFMT_ASTC_4X4,    4, 4, 16, 1, "ASTC_4x4 4x4/16B");
    _assert_texfmt(MABDA_TEXFMT_ASTC_6X6,    6, 6, 16, 1, "ASTC_6x6 6x6/16B");
    _assert_texfmt(MABDA_TEXFMT_ASTC_8X8,    8, 8, 16, 1, "ASTC_8x8 8x8/16B");
    return 0;
}

fn test_texfmt_invalid_returns_zero() {
    # Out-of-range / negative ids: every accessor returns 0 (block_bytes==0
    # is the caller's "invalid format" sentinel) and is_compressed is 0.
    _assert_texfmt(0 - 1,              0, 0, 0, 0, "negative id -> 0");
    _assert_texfmt(MABDA_TEXFMT_COUNT, 0, 0, 0, 0, "COUNT (one past) -> 0");
    _assert_texfmt(999,               0, 0, 0, 0, "far OOR -> 0");
    return 0;
}

# v3.2 T.2 — pin every mabda id -> v29 WGPUTextureFormat value against both
# the named constant and the literal webgpu.h hex, so a wgpu-native enum
# renumber fails the suite (not the GPU).
fn test_texfmt_to_wgpu_v29_mapping() {
    assert_eq(mabda_texfmt_to_wgpu(MABDA_TEXFMT_RGBA8),
    WGPU_TEXTURE_FORMAT_RGBA8_UNORM, "RGBA8 -> named const");
    assert_eq(mabda_texfmt_to_wgpu(MABDA_TEXFMT_RGBA8),      0x16, "RGBA8 = 0x16");
    assert_eq(mabda_texfmt_to_wgpu(MABDA_TEXFMT_BC1),        0x32, "BC1 = 0x32");
    assert_eq(mabda_texfmt_to_wgpu(MABDA_TEXFMT_BC3),        0x36, "BC3 = 0x36");
    assert_eq(mabda_texfmt_to_wgpu(MABDA_TEXFMT_BC4),        0x38, "BC4 = 0x38");
    assert_eq(mabda_texfmt_to_wgpu(MABDA_TEXFMT_BC5),        0x3A, "BC5 = 0x3A");
    assert_eq(mabda_texfmt_to_wgpu(MABDA_TEXFMT_BC6H),       0x3C, "BC6H = 0x3C (Ufloat)");
    assert_eq(mabda_texfmt_to_wgpu(MABDA_TEXFMT_BC7),        0x3E, "BC7 = 0x3E");
    assert_eq(mabda_texfmt_to_wgpu(MABDA_TEXFMT_ETC2_RGB8),  0x40, "ETC2_RGB8 = 0x40");
    assert_eq(mabda_texfmt_to_wgpu(MABDA_TEXFMT_ETC2_RGBA8), 0x44, "ETC2_RGBA8 = 0x44");
    assert_eq(mabda_texfmt_to_wgpu(MABDA_TEXFMT_ASTC_4X4),   0x4A, "ASTC_4x4 = 0x4A");
    assert_eq(mabda_texfmt_to_wgpu(MABDA_TEXFMT_ASTC_6X6),   0x52, "ASTC_6x6 = 0x52");
    assert_eq(mabda_texfmt_to_wgpu(MABDA_TEXFMT_ASTC_8X8),   0x58, "ASTC_8x8 = 0x58");
    # Unknown id -> 0 (WGPUTextureFormat_Undefined) so the wgpu path rejects.
    assert_eq(mabda_texfmt_to_wgpu(0 - 1),              0, "negative -> Undefined");
    assert_eq(mabda_texfmt_to_wgpu(MABDA_TEXFMT_COUNT), 0, "COUNT -> Undefined");
    return 0;
}

# v3.2 T.3 — block size math + overflow bound
fn test_texfmt_blocks_for_dim() {
    assert_eq(MABDA_MAX_TEXTURE_DIM_2D, 8192, "dim bound = 8192");
    # ceil(dim/b): exact + partial blocks.
    assert_eq(mabda_texfmt_blocks_for_dim(8, 4), 2, "8/4 = 2");
    assert_eq(mabda_texfmt_blocks_for_dim(7, 4), 2, "7/4 -> 2 (partial)");
    assert_eq(mabda_texfmt_blocks_for_dim(5, 4), 2, "5/4 -> 2 (partial)");
    assert_eq(mabda_texfmt_blocks_for_dim(4, 4), 1, "4/4 = 1 (exact)");
    assert_eq(mabda_texfmt_blocks_for_dim(1, 4), 1, "1/4 -> 1 (partial)");
    assert_eq(mabda_texfmt_blocks_for_dim(8192, 4), 2048, "8192/4 = 2048");
    assert_eq(mabda_texfmt_blocks_for_dim(7, 6), 2, "7/6 -> 2");
    assert_eq(mabda_texfmt_blocks_for_dim(6, 6), 1, "6/6 = 1");
    assert_eq(mabda_texfmt_blocks_for_dim(9, 8), 2, "9/8 -> 2");
    assert_eq(mabda_texfmt_blocks_for_dim(8, 8), 1, "8/8 = 1");
    # Invalid inputs.
    assert_eq(mabda_texfmt_blocks_for_dim(0, 4), 0, "0 dim -> 0");
    assert_eq(mabda_texfmt_blocks_for_dim(0 - 1, 4), 0, "neg dim -> 0");
    assert_eq(mabda_texfmt_blocks_for_dim(8, 0), 0, "0 block -> 0");
    return 0;
}

fn test_texfmt_data_size() {
    # Uncompressed: w*h*4.
    assert_eq(mabda_texfmt_data_size(MABDA_TEXFMT_RGBA8, 8, 8), 256, "RGBA8 8x8 = 256");
    # BC: block-rounded.
    assert_eq(mabda_texfmt_data_size(MABDA_TEXFMT_BC1, 8, 8), 32, "BC1 8x8 = 2*2*8");
    assert_eq(mabda_texfmt_data_size(MABDA_TEXFMT_BC1, 7, 7), 32, "BC1 7x7 -> 2*2*8 (partial)");
    assert_eq(mabda_texfmt_data_size(MABDA_TEXFMT_BC1, 4, 4), 8, "BC1 4x4 = 1*1*8");
    assert_eq(mabda_texfmt_data_size(MABDA_TEXFMT_BC3, 8, 8), 64, "BC3 8x8 = 2*2*16");
    assert_eq(mabda_texfmt_data_size(MABDA_TEXFMT_ETC2_RGB8, 4, 4), 8, "ETC2_RGB8 4x4 = 8");
    # ASTC block dims.
    assert_eq(mabda_texfmt_data_size(MABDA_TEXFMT_ASTC_6X6, 6, 6), 16, "ASTC6x6 6x6 = 16");
    assert_eq(mabda_texfmt_data_size(MABDA_TEXFMT_ASTC_6X6, 7, 7), 64, "ASTC6x6 7x7 -> 2*2*16");
    assert_eq(mabda_texfmt_data_size(MABDA_TEXFMT_ASTC_8X8, 16, 16), 64, "ASTC8x8 16x16 = 2*2*16");
    # Invalid format / dims.
    assert_eq(mabda_texfmt_data_size(MABDA_TEXFMT_COUNT, 8, 8), 0, "invalid fmt -> 0");
    assert_eq(mabda_texfmt_data_size(MABDA_TEXFMT_RGBA8, 0, 8), 0, "zero w -> 0");
    assert_eq(mabda_texfmt_data_size(MABDA_TEXFMT_RGBA8, 8, 0 - 1), 0, "neg h -> 0");
    return 0;
}

fn test_texfmt_data_size_overflow_bound() {
    # Worst case at the dim cap, re-derived (not inferred): RGBA8 8192^2*4.
    var rgba8_max = mabda_texfmt_data_size(MABDA_TEXFMT_RGBA8, 8192, 8192);
    assert_eq(rgba8_max, 268435456, "RGBA8 8192^2 = 256 MiB");
    # Compressed worst case (16 B/block) is always <= the RGBA8 bound.
    var bc7_max = mabda_texfmt_data_size(MABDA_TEXFMT_BC7, 8192, 8192);
    assert_eq(bc7_max, 67108864, "BC7 8192^2 = 2048^2*16 = 64 MiB");
    assert(bc7_max < rgba8_max, "compressed worst case < RGBA8 bound");
    # Past the dim cap -> 0 (the overflow guard), both axes.
    assert_eq(mabda_texfmt_data_size(MABDA_TEXFMT_RGBA8, 8193, 8192), 0, "w>8192 -> 0");
    assert_eq(mabda_texfmt_data_size(MABDA_TEXFMT_BC7, 8192, 8193), 0, "h>8192 -> 0");
    return 0;
}

# v3.2 T.4 — capability gating
fn test_texfmt_compression_family() {
    assert_eq(MABDA_TEXCOMP_BC,   1, "BC bit = 1");
    assert_eq(MABDA_TEXCOMP_ETC2, 2, "ETC2 bit = 2");
    assert_eq(MABDA_TEXCOMP_ASTC, 4, "ASTC bit = 4");
    assert_eq(mabda_texfmt_compression_family(MABDA_TEXFMT_RGBA8), 0, "RGBA8 -> no family");
    assert_eq(mabda_texfmt_compression_family(MABDA_TEXFMT_BC1),  MABDA_TEXCOMP_BC,  "BC1 -> BC");
    assert_eq(mabda_texfmt_compression_family(MABDA_TEXFMT_BC7),  MABDA_TEXCOMP_BC,  "BC7 -> BC");
    assert_eq(mabda_texfmt_compression_family(MABDA_TEXFMT_ETC2_RGB8),  MABDA_TEXCOMP_ETC2, "ETC2 -> ETC2");
    assert_eq(mabda_texfmt_compression_family(MABDA_TEXFMT_ASTC_8X8), MABDA_TEXCOMP_ASTC, "ASTC -> ASTC");
    assert_eq(mabda_texfmt_compression_family(MABDA_TEXFMT_COUNT), 0, "invalid -> 0");
    return 0;
}

fn test_caps_compression_bitset_round_trip() {
    var caps = gpu_caps_new();
    assert_eq(gpu_caps_texture_compression(caps), 0, "fresh caps: no compression");
    gpu_caps_set_texture_compression(caps, MABDA_TEXCOMP_BC | MABDA_TEXCOMP_ASTC);
    assert_eq(gpu_caps_texture_compression(caps),
    MABDA_TEXCOMP_BC | MABDA_TEXCOMP_ASTC, "bitset round-trips");
    # Setting the bitset doesn't perturb a neighbouring field (+112).
    assert_eq(gpu_caps_multi_draw_indirect(caps), 0, "multi_draw untouched");
    return 0;
}

fn test_caps_supports_format() {
    var caps = gpu_caps_new();
    # No compression support: only uncompressed.
    assert_eq(gpu_caps_supports_format(caps, MABDA_TEXFMT_RGBA8), 1, "RGBA8 always supported");
    assert_eq(gpu_caps_supports_format(caps, MABDA_TEXFMT_BC1), 0, "BC1 unsupported (no BC bit)");
    assert_eq(gpu_caps_supports_format(caps, MABDA_TEXFMT_ASTC_4X4), 0, "ASTC unsupported");
    # BC only.
    gpu_caps_set_texture_compression(caps, MABDA_TEXCOMP_BC);
    assert_eq(gpu_caps_supports_format(caps, MABDA_TEXFMT_BC1), 1, "BC1 supported with BC bit");
    assert_eq(gpu_caps_supports_format(caps, MABDA_TEXFMT_BC7), 1, "BC7 supported with BC bit");
    assert_eq(gpu_caps_supports_format(caps, MABDA_TEXFMT_ETC2_RGB8), 0, "ETC2 still unsupported");
    assert_eq(gpu_caps_supports_format(caps, MABDA_TEXFMT_RGBA8), 1, "RGBA8 still supported");
    # BC | ASTC.
    gpu_caps_set_texture_compression(caps, MABDA_TEXCOMP_BC | MABDA_TEXCOMP_ASTC);
    assert_eq(gpu_caps_supports_format(caps, MABDA_TEXFMT_ASTC_6X6), 1, "ASTC supported with ASTC bit");
    assert_eq(gpu_caps_supports_format(caps, MABDA_TEXFMT_ETC2_RGBA8), 0, "ETC2 unsupported");
    # Invalid format never supported.
    assert_eq(gpu_caps_supports_format(caps, MABDA_TEXFMT_COUNT), 0, "invalid fmt -> 0");
    return 0;
}

fn test_format_unsupported_error() {
    assert_eq(GPU_ERR_FORMAT_UNSUPPORTED, 19, "FORMAT_UNSUPPORTED = 19");
    assert(strlen(gpu_err_name(GPU_ERR_FORMAT_UNSUPPORTED)) > 0, "has an error string");
    return 0;
}

# v3.2 T.5 — gpu_texture_create_2d slot dispatch (mock slot)
var _t5_fmt_count = 0;

var _t5_fmt_w = 0;

var _t5_fmt_h = 0;

var _t5_fmt_fmt = 0;

fn _t5_fmt_create_stub(ctx, w, h, fmt) {
    _t5_fmt_count = _t5_fmt_count + 1;
    _t5_fmt_w = w;
    _t5_fmt_h = h;
    _t5_fmt_fmt = fmt;
    return 0xFA7;
}

fn _t5_wire(ctxbuf, bebuf) {
    memset(ctxbuf, 0, GPU_CONTEXT_SIZE);
    memset(bebuf, 0, BACKEND_SIZE);
    backend_set_slot(bebuf, BACKEND_SLOT_TEXTURE_CREATE_2D_FMT, &_t5_fmt_create_stub);
    store64(ctxbuf + 32, bebuf);
    return 0;
}

fn test_gpu_texture_create_2d_dispatch() {
    var ctx[176];
    var be[256];
    _t5_wire(&ctx, &be);
    _t5_fmt_count = 0;
    var got = gpu_texture_create_2d(&ctx, 64, 32, MABDA_TEXFMT_BC1);
    assert_eq(_t5_fmt_count, 1, "slot called once");
    assert_eq(_t5_fmt_w, 64, "width threaded");
    assert_eq(_t5_fmt_h, 32, "height threaded");
    assert_eq(_t5_fmt_fmt, MABDA_TEXFMT_BC1, "fmt threaded");
    assert_eq(got, 0xFA7, "slot return propagated");
    # RGBA8 is accepted and routes through the same slot with fmt=RGBA8.
    got = gpu_texture_create_2d(&ctx, 8, 8, MABDA_TEXFMT_RGBA8);
    assert_eq(_t5_fmt_count, 2, "slot called again for RGBA8");
    assert_eq(_t5_fmt_fmt, MABDA_TEXFMT_RGBA8, "RGBA8 routes with fmt=RGBA8");
    return 0;
}

fn test_gpu_texture_create_2d_guards() {
    var ctx[176];
    var be[256];
    _t5_wire(&ctx, &be);
    _t5_fmt_count = 0;
    assert_eq(gpu_texture_create_2d(0, 8, 8, MABDA_TEXFMT_RGBA8), 0, "null ctx -> 0");
    assert_eq(gpu_texture_create_2d(&ctx, 0, 8, MABDA_TEXFMT_RGBA8), 0, "zero w -> 0");
    assert_eq(gpu_texture_create_2d(&ctx, 8, 0 - 1, MABDA_TEXFMT_RGBA8), 0, "neg h -> 0");
    assert_eq(gpu_texture_create_2d(&ctx, 8193, 8, MABDA_TEXFMT_RGBA8), 0, "oversize -> 0");
    # Unknown format id rejected before the slot (the format-supported guard).
    assert_eq(gpu_texture_create_2d(&ctx, 8, 8, MABDA_TEXFMT_COUNT), 0, "unknown fmt -> 0");
    assert_eq(gpu_texture_create_2d(&ctx, 8, 8, 0 - 1), 0, "negative fmt -> 0");
    assert_eq(_t5_fmt_count, 0, "no slot call on any bad input");
    return 0;
}

fn main() {
    alloc_init();
    color_init();
    test_texfmt_ids_distinct_and_bounded();
    test_texfmt_block_geometry();
    test_texfmt_invalid_returns_zero();
    test_texfmt_to_wgpu_v29_mapping();
    test_texfmt_blocks_for_dim();
    test_texfmt_data_size();
    test_texfmt_data_size_overflow_bound();
    test_texfmt_compression_family();
    test_caps_compression_bitset_round_trip();
    test_caps_supports_format();
    test_format_unsupported_error();
    test_gpu_texture_create_2d_dispatch();
    test_gpu_texture_create_2d_guards();
    test_vertex_blend_opaque();
    test_vertex_blend_alpha();
    test_depth_texture_accessors();
    test_audit_texture_upload_zero_dim();
    test_audit_texture_create_exceeds_max_rejected();
    test_mip_level_count();
    test_mip_level_dim();
    test_frame_resources_track_buffers_and_textures();
    test_gpu_texture_create_2d_rgba8_validates_dims();
    test_gpu_texture_create_mipped_dispatch();
    test_gpu_texture_generate_mipmaps_dispatch();
    test_gpu_texture_dispatchers_null_ctx_safe();
    return assert_summary();
}
