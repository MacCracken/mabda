fn cfk_build(k, b): i64 {
    if (k == 0) { return _cfk_if_div(b); }
    if (k == 1) { return _cfk_if_else_div(b); }
    if (k == 2) { return _cfk_if_nest_shared(b); }
    if (k == 3) { return _cfk_if_nested(b); }
    if (k == 4) { return _cfk_if_scc_clobbered_skipped(b); }
    if (k == 5) { return _cfk_if_scc_clobbered_taken(b); }
    if (k == 6) { return _cfk_if_then_lcg(b); }
    if (k == 7) { return _cfk_if_vcc_clobbered(b); }
    if (k == 8) { return _cfk_loop_break(b); }
    if (k == 9) { return _cfk_loop_continue_from_if(b); }
    if (k == 10) { return _cfk_loop_div(b); }
    if (k == 11) { return _cfk_loop_div_if_inside(b); }
    if (k == 12) { return _cfk_loop_do_while(b); }
    if (k == 13) { return _cfk_loop_in_if(b); }
    if (k == 14) { return _cfk_loop_lcg(b); }
    if (k == 15) { return _cfk_loop_phi_f64(b); }
    if (k == 16) { return _cfk_loop_phi_swap(b); }
    if (k == 17) { return _cfk_refuse_return_in_loop(b); }
    if (k == 18) { return _cfk_sel_div_adjacent(b); }
    if (k == 19) { return _cfk_sel_div_not_adjacent(b); }
    if (k == 20) { return _cfk_sel_then_branch_same_cmp(b); }
    if (k == 21) { return _cfk_sel_uniform_cond_lane_vals(b); }
    if (k == 22) { return _cfk_sel_uniform_scalar(b); }
    if (k == 23) { return _cfk_sel_uniform_two_literals(b); }
    if (k == 24) { return _cfk_if_nest8(b); }
    if (k == 25) { return _cfk_if_nest9(b); }
    if (k == 26) { return _cfk_oob_label(b); }
    return 0;
}

fn cfk_name(k): i64 {
    if (k == 0) { return "if_div"; }
    if (k == 1) { return "if_else_div"; }
    if (k == 2) { return "if_nest_shared"; }
    if (k == 3) { return "if_nested"; }
    if (k == 4) { return "if_scc_clobbered_skipped"; }
    if (k == 5) { return "if_scc_clobbered_taken"; }
    if (k == 6) { return "if_then_lcg"; }
