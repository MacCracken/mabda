# The NVIDIA (SM75) expectations: the shared ones, except where a body says `; nv-want:` /
# `; nv-refuse:` (an OpReturn in a divergent region and deep nesting are legal there; f64 is
# not selected for NVIDIA yet).
fn cfk_nv_refuse(k): i64 {
    if (k == 15) { return 0 - SM75_ERR_UNSUPPORTED_OP; }
    if (k == 26) { return 0 - MIR_ERR_ID_OOR; }
    return 0;
}

fn cfk_nv_want(k, out): i64 {
