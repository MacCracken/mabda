    return "?";
}

fn cfk_refuse(k): i64 {
    if (k == 17) { return 0 - GISEL_ERR_RETURN_IN_SELECTION; }
    if (k == 25) { return 0 - GISEL_ERR_NESTED_SELECTION; }
    if (k == 26) { return 0 - MIR_ERR_ID_OOR; }
    return 0;
}

