fn test_slot78_79_surface() {
    var table[648];
    var caps[168];
    _ml_install(&table, 78, 81);
    _ml_ret = 0x7777;
    assert_eq(wgpu_instance_create_surface_wayland(0x10, 0x20, 0x30), 0x7777, "78 returns the surface");
    assert_eq(_ml_calls, 1, "78 reached");
    assert_eq(_ml_wrong, 0, "78 no wrong slot");
    assert_eq(_ml_a0, 0x10, "78 instance");
    assert_eq(_ml_a1, 0x20, "78 wl_display");
    assert_eq(_ml_a2, 0x30, "78 wl_surface");
    _ml_install(&table, 79, 81);
    _ml_ret = 1;
    assert_eq(wgpu_surface_get_capabilities(0x40, 0x50, &caps), 1, "79 returns the WGPUStatus");
    assert_eq(_ml_calls, 1, "79 reached");
    assert_eq(_ml_wrong, 0, "79 no wrong slot");
    assert_eq(_ml_a2, &caps, "79 output block");
    # The flat output block's offsets are consistent with its 168-byte size.
    assert_eq(WGPU_SURFACE_CAPS_FORMATS + WGPU_SURFACE_CAPS_FORMATS_MAX * 4, WGPU_SURFACE_CAPS_PRESENT_COUNT,
      "caps: formats[16] ends at present_mode_count");
    assert_eq(WGPU_SURFACE_CAPS_PRESENT_MODES + WGPU_SURFACE_CAPS_PRESENT_MAX * 4, WGPU_SURFACE_CAPS_ALPHA_COUNT,
      "caps: present_modes[8] ends at alpha_mode_count");
    assert_eq(WGPU_SURFACE_CAPS_ALPHA_MODES + WGPU_SURFACE_CAPS_ALPHA_MAX * 4, WGPU_SURFACE_CAPS_SIZE,
      "caps: alpha_modes[8] ends at the block size");
    _ml_install(&table, 78, 0);
    assert_eq(wgpu_instance_create_surface_wayland(0x10, 0x20, 0x30), 0, "78 legacy -> 0");
    store64(&caps, 0x1234);
    assert_eq(wgpu_surface_get_capabilities(0x40, 0x50, &caps), 0, "79 legacy -> 0");
    assert_eq(load64(&caps), 0, "79 legacy zeroes the output block");
    assert_eq(_ml_calls + _ml_wrong, 0, "78/79 legacy launcher: nothing called");
    _ml_uninstall();
    return 0;
}

fn test_slot80_debug_ops() {
    var table[648];
    _ml_install(&table, 80, 81);
    assert_eq(debug_push(0x99, "grp"), 0, "debug_push returns the shim's 0");
    assert_eq(_ml_a0, WGPU_DEBUG_TARGET_ENCODER, "debug_push target = encoder");
    assert_eq(_ml_a1, 0x99, "debug_push encoder");
    assert_eq(_ml_a2, WGPU_DEBUG_OP_PUSH, "debug_push op = push");
    assert_streq(_ml_a3, "grp", "debug_push label");
    debug_pop(0x99);
    assert_eq(_ml_a2, WGPU_DEBUG_OP_POP, "debug_pop op = pop");
    assert_eq(_ml_a3, 0, "debug_pop passes no label");
    debug_render_marker(0x98, "mk");
    assert_eq(_ml_a0, WGPU_DEBUG_TARGET_RENDER, "debug_render_marker target = render pass");
    assert_eq(_ml_a2, WGPU_DEBUG_OP_MARKER, "debug_render_marker op = marker");
    debug_compute_push(0x97, "cp");
    assert_eq(_ml_a0, WGPU_DEBUG_TARGET_COMPUTE, "debug_compute_push target = compute pass");
    debug_render_push(0x96, "rp");
    debug_render_pop(0x96);
    debug_marker(0x95, "m");
    debug_compute_pop(0x97);
    debug_compute_marker(0x97, "cm");
    assert_eq(_ml_calls, 9, "all nine debug ops reach slot 80");
    assert_eq(_ml_wrong, 0, "80 no wrong slot");
    assert_eq(debug_push(0, "x"), GPU_ERR_OTHER, "null encoder -> GPU_ERR_OTHER");
    assert_eq(_ml_calls, 9, "null encoder: nothing called");
    _ml_install(&table, 80, 0);
    assert_eq(debug_push(0x99, "grp"), GPU_ERR_FFI_SYMBOL, "80 legacy refused");
    assert_eq(_ml_calls + _ml_wrong, 0, "80 legacy launcher: nothing called");
    _ml_uninstall();
    return 0;
}

fn main() {
    alloc_init();
    test_launcher_slot_count_default_is_legacy();
    test_launcher_has_slot_gates();
    test_launcher_fn_count_matches_source();
    test_slot67_set_vertex_buffer();
    test_slot68_set_index_buffer();
    test_slot69_draw_indexed();
    test_slot70_set_viewport();
    test_slot71_set_scissor_rect();
    test_slot72_set_blend_constant();
    test_slot73_74_error_scope();
    test_slot75_take_uncaptured_error();
    test_slot76_command_buffer_release();
    test_slot77_copy_texture_to_texture();
    test_slot78_79_surface();
    test_slot80_debug_ops();
    return assert_summary();
}
