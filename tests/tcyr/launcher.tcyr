# tests/tcyr/launcher.tcyr — the v4.3.0 launcher revision (deps/wgpu_main.c, 67 -> 81 slots)
#
# Every new wrapper in src/wgpu_ffi.cyr (slots 67-80) is driven through a mock fn
# table: all 81 slots hold a trap that counts wrong-slot calls, and the slot under
# test holds a recorder. Each test proves the wrapper calls ITS slot, with its
# arguments in order, and that against a pre-4.3.0 (67-slot) launcher it refuses
# without calling anything. HW behaviour of the same slots is proven by
# programs/launcher_slots_e2e.cyr (make test-launcher-slots-e2e).
include "src/lib.cyr"
include "lib/assert.cyr"

var _ml_wrong = 0;      # calls that reached a slot other than the one under test
var _ml_calls = 0;      # calls that reached the recorder
var _ml_a0 = 0;
var _ml_a1 = 0;
var _ml_a2 = 0;
var _ml_a3 = 0;
var _ml_a4 = 0;
var _ml_a5 = 0;
var _ml_ret = 0;        # what the recorder returns

fn _ml_trap(a, b, c, d, e, f): i64 {
    _ml_wrong = _ml_wrong + 1;
    return 0;
}

fn _ml_rec(a, b, c, d, e, f): i64 {
    _ml_calls = _ml_calls + 1;
    _ml_a0 = a;
    _ml_a1 = b;
    _ml_a2 = c;
    _ml_a3 = d;
    _ml_a4 = e;
    _ml_a5 = f;
    return _ml_ret;
}

# A WGPU_FN_COUNT-slot table of traps with the recorder at `slot`, installed,
# with the launcher reporting `reported` slots.
fn _ml_install(table, slot, reported): i64 {
    for (var i = 0; i < WGPU_FN_COUNT; i = i + 1) {
        store64(table + i * 8, &_ml_trap);
    }
    if (slot >= 0) { store64(table + slot * 8, &_ml_rec); }
    _ml_wrong = 0;
    _ml_calls = 0;
    _ml_a0 = 0 - 1;
    _ml_a1 = 0 - 1;
    _ml_a2 = 0 - 1;
    _ml_a3 = 0 - 1;
    _ml_a4 = 0 - 1;
    _ml_a5 = 0 - 1;
    _ml_ret = 0;
    wgpu_ffi_init_table(table);
    mabda_wgpu_launcher_slots(reported);
    return 0;
}

fn _ml_uninstall(): i64 {
    wgpu_ffi_init_table(0);
    mabda_wgpu_launcher_slots(0);
    return 0;
}

# --- the handshake ---

fn test_launcher_slot_count_default_is_legacy() {
    mabda_wgpu_launcher_slots(0);
    assert_eq(wgpu_launcher_slot_count(), 67, "no handshake -> the 67-slot pre-4.3.0 table");
    mabda_wgpu_launcher_slots(0 - 5);
    assert_eq(wgpu_launcher_slot_count(), 67, "a negative report clamps to 'never said'");
    mabda_wgpu_launcher_slots(81);
    assert_eq(wgpu_launcher_slot_count(), 81, "the 4.3.0 launcher reports 81");
    mabda_wgpu_launcher_slots(0);
    return 0;
}

fn test_launcher_has_slot_gates() {
    var table[648];
    _ml_install(&table, 0 - 1, 0);
    assert_eq(_wgpu_has_slot(66), 1, "legacy: slot 66 exists");
    assert_eq(_wgpu_has_slot(67), 0, "legacy: slot 67 does not");
    assert_eq(_wgpu_has_slot(0 - 1), 0, "negative slot never exists");
    mabda_wgpu_launcher_slots(81);
    assert_eq(_wgpu_has_slot(80), 1, "81-slot launcher: slot 80 exists");
    assert_eq(_wgpu_has_slot(81), 0, "81-slot launcher: slot 81 does not");
    wgpu_ffi_init_table(0);
    assert_eq(_wgpu_has_slot(0), 0, "no table installed: nothing exists");
    _ml_uninstall();
    return 0;
}

# The constant mabda assumes must match the launcher it ships: read FN_COUNT
# straight out of deps/wgpu_main.c (tests run from the repo root).
fn test_launcher_fn_count_matches_source() {
    var lenv[8];
    store64(&lenv, 0);
    var src = file_read_whole("deps/wgpu_main.c", &lenv);
    assert_nonnull(src, "deps/wgpu_main.c readable");
    if (src == 0) { return 0; }
    var n = load64(&lenv);
    var key = "#define FN_COUNT ";
    var kl = strlen(key);
    var found = 0 - 1;
    for (var i = 0; i + kl < n; i = i + 1) {
        if (memeq(src + i, key, kl) == 1) {
            var v = 0;
            var j = i + kl;
            while (j < n) {
                var c = load8(src + j);
                if (c < 48) { break; }
                if (c > 57) { break; }
                v = v * 10 + (c - 48);
                j = j + 1;
            }
            found = v;
            break;
        }
    }
    assert_eq(found, WGPU_FN_COUNT, "deps/wgpu_main.c FN_COUNT == WGPU_FN_COUNT (81)");
    return 0;
}

# --- one test per new slot: right slot, right arguments, refused on a legacy launcher ---

fn test_slot67_set_vertex_buffer() {
    var table[648];
    _ml_install(&table, 67, 81);
    assert_eq(wgpu_render_pass_encoder_set_vertex_buffer(0x11, 2, 0x22, 64, 4096), 0, "67 returns 0");
    assert_eq(_ml_calls, 1, "67 reached");
    assert_eq(_ml_wrong, 0, "67 no wrong slot");
    assert_eq(_ml_a0, 0x11, "67 pass");
    assert_eq(_ml_a1, 2, "67 slot index");
    assert_eq(_ml_a2, 0x22, "67 buffer");
    assert_eq(_ml_a3, 64, "67 offset");
    assert_eq(_ml_a4, 4096, "67 size");
    _ml_install(&table, 67, 0);
    assert_eq(wgpu_render_pass_encoder_set_vertex_buffer(0x11, 2, 0x22, 64, 4096), GPU_ERR_FFI_SYMBOL,
      "67 legacy launcher -> GPU_ERR_FFI_SYMBOL");
    assert_eq(_ml_calls + _ml_wrong, 0, "67 legacy launcher: nothing called");
    _ml_uninstall();
    return 0;
}

fn test_slot68_set_index_buffer() {
    var table[648];
    _ml_install(&table, 68, 81);
    assert_eq(wgpu_render_pass_encoder_set_index_buffer(0x11, 0x33, 2, 8, 600), 0, "68 returns 0");
    assert_eq(_ml_calls, 1, "68 reached");
    assert_eq(_ml_wrong, 0, "68 no wrong slot");
    assert_eq(_ml_a1, 0x33, "68 buffer");
    assert_eq(_ml_a2, 2, "68 format");
    assert_eq(_ml_a3, 8, "68 offset");
    assert_eq(_ml_a4, 600, "68 size");
    _ml_install(&table, 68, 67);
    assert_eq(wgpu_render_pass_encoder_set_index_buffer(0x11, 0x33, 2, 8, 600), GPU_ERR_FFI_SYMBOL,
      "68 67-slot launcher -> GPU_ERR_FFI_SYMBOL");
    assert_eq(_ml_calls + _ml_wrong, 0, "68 legacy launcher: nothing called");
    _ml_uninstall();
    return 0;
}

fn test_slot69_draw_indexed() {
    var table[648];
    _ml_install(&table, 69, 81);
    assert_eq(wgpu_render_pass_encoder_draw_indexed(0x11, 36, 2, 6, 0 - 4, 1), 0, "69 returns 0");
    assert_eq(_ml_calls, 1, "69 reached");
    assert_eq(_ml_wrong, 0, "69 no wrong slot");
    assert_eq(_ml_a1, 36, "69 index count");
    assert_eq(_ml_a2, 2, "69 instance count");
    assert_eq(_ml_a3, 6, "69 first index");
    assert_eq(_ml_a4 & 0xFFFFFFFF, 0xFFFFFFFC, "69 base vertex -4 (low 32 bits, read as int32)");
    assert_eq(_ml_a5, 1, "69 first instance");
    _ml_install(&table, 69, 0);
    assert_eq(wgpu_render_pass_encoder_draw_indexed(0x11, 36, 2, 6, 0, 1), GPU_ERR_FFI_SYMBOL,
      "69 legacy launcher -> GPU_ERR_FFI_SYMBOL");
    assert_eq(_ml_calls + _ml_wrong, 0, "69 legacy launcher: nothing called");
    _ml_uninstall();
    return 0;
}

