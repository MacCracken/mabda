fn test_slot73_74_error_scope() {
    var table[648];
    var msg[64];
    _ml_install(&table, 73, 81);
    assert_eq(wgpu_device_push_error_scope(0x44, WGPU_ERROR_FILTER_VALIDATION), 0, "73 returns 0");
    assert_eq(_ml_calls, 1, "73 reached");
    assert_eq(_ml_wrong, 0, "73 no wrong slot");
    assert_eq(_ml_a0, 0x44, "73 device");
    assert_eq(_ml_a1, 1, "73 filter = Validation (1)");
    _ml_install(&table, 74, 81);
    _ml_ret = WGPU_ERROR_TYPE_VALIDATION;
    assert_eq(wgpu_device_pop_error_scope(0x44, &msg, 64), 2, "74 returns the callee's WGPUErrorType");
    assert_eq(_ml_calls, 1, "74 reached");
    assert_eq(_ml_wrong, 0, "74 no wrong slot");
    assert_eq(_ml_a1, &msg, "74 message buffer");
    assert_eq(_ml_a2, 64, "74 message capacity");
    _ml_install(&table, 73, 0);
    assert_eq(wgpu_device_push_error_scope(0x44, 1), GPU_ERR_FFI_SYMBOL, "73 legacy refused");
    assert_eq(wgpu_device_pop_error_scope(0x44, &msg, 64), WGPU_POP_SCOPE_NO_SLOT, "74 legacy -> NO_SLOT");
    assert_eq(_ml_calls + _ml_wrong, 0, "73/74 legacy launcher: nothing called");
    _ml_uninstall();
    return 0;
}

fn test_slot75_take_uncaptured_error() {
    var table[648];
    var msg[64];
    var cnt[8];
    _ml_install(&table, 75, 81);
    _ml_ret = WGPU_ERROR_TYPE_VALIDATION;
    assert_eq(wgpu_take_uncaptured_error(&msg, 64, &cnt), 2, "75 returns the callee's type");
    assert_eq(_ml_calls, 1, "75 reached");
    assert_eq(_ml_wrong, 0, "75 no wrong slot");
    assert_eq(_ml_a0, &msg, "75 message buffer");
    assert_eq(_ml_a1, 64, "75 capacity");
    assert_eq(_ml_a2, &cnt, "75 count out");
    _ml_install(&table, 75, 0);
    store64(&cnt, 99);
    assert_eq(wgpu_take_uncaptured_error(&msg, 64, &cnt), 0, "75 legacy -> 0 (no error known)");
    assert_eq(load64(&cnt), 0, "75 legacy zeroes the count");
    assert_eq(_ml_calls + _ml_wrong, 0, "75 legacy launcher: nothing called");
    _ml_uninstall();
    return 0;
}

