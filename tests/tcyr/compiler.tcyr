# tests/tcyr/compiler.tcyr — SPIR-V → GFX9 native compiler backend (Phase N)
# Functionality-grouped CPU suite. Mirrors the new src/ compiler modules
# (gfx9_encode.cyr at N.0; spirv_parse/mir/isel/regalloc/compile land later).
# Self-contained: own main() + assert_summary().
#
# N.0 ORACLE: every gfx9_encode.cyr encoder is asserted to reproduce, byte
# for byte, the exact dwords the hand-authored shaders in
# backend_native_shaders.cyr already pin (each llvm-mc-round-tripped on
# gfx90c). A single mis-encoded bit-field shows up here as a failed assert
# against a known-good constant — the safety net the proposal requires
# before any *generated* code reaches hardware.
include "src/lib.cyr"
include "lib/assert.cyr"

# ================================================================
# Operand-encoding helpers
# ================================================================
fn test_gfx9_operand_helpers() {
    assert_eq(gfx9_vgpr(0), 256, "VGPR0 = 256");
    assert_eq(gfx9_vgpr(4), 260, "VGPR4 = 260");
    assert_eq(gfx9_vgpr(11), 267, "VGPR11 = 267");
    assert_eq(gfx9_sgpr(0), 0, "SGPR0 = 0");
    assert_eq(gfx9_sgpr(12), 12, "SGPR12 = 12");
    # inline-constant table: 0->128, 1..64->129..192, -1..-16->193..208
    assert_eq(gfx9_inline_int(0), 128, "inline 0 = 128");
    assert_eq(gfx9_inline_int(1), 129, "inline 1 = 129");
    assert_eq(gfx9_inline_int(2), 130, "inline 2 = 130");
    assert_eq(gfx9_inline_int(4), 132, "inline 4 = 132");
    assert_eq(gfx9_inline_int(8), 136, "inline 8 = 136");
    assert_eq(gfx9_inline_int(16), 144, "inline 16 = 144");
    assert_eq(gfx9_inline_int(24), 152, "inline 24 = 152");
    assert_eq(gfx9_inline_int(64), 192, "inline 64 = 192");
    assert_eq(gfx9_inline_int(0 - 1), 193, "inline -1 = 193");
    assert_eq(gfx9_inline_int(0 - 16), 208, "inline -16 = 208");
    # out of inline range -> literal sentinel 255
    assert_eq(gfx9_inline_int(65), 255, "inline 65 OOR -> literal");
    assert_eq(gfx9_inline_int(0 - 17), 255, "inline -17 OOR -> literal");
    return 0;
}

# ================================================================
# VOP1 — every hand-authored v_mov / v_cvt dword
# ================================================================
fn test_gfx9_enc_vop1() {
    # store_deadbeef: v_mov_b32 v{0,1} from s{0,1}, v2 from literal
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 0, gfx9_sgpr(0)), 0x7E000200, "v_mov v0,s0");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 1, gfx9_sgpr(1)), 0x7E020201, "v_mov v1,s1");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 2, GFX9_SRC_LITERAL), 0x7E0402FF, "v_mov v2,lit");
    # downsample: v_mov from the address SGPRs
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 0, gfx9_sgpr(12)), 0x7E00020C, "v_mov v0,s12");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 1, gfx9_sgpr(13)), 0x7E02020D, "v_mov v1,s13");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 2, gfx9_sgpr(14)), 0x7E04020E, "v_mov v2,s14");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 3, gfx9_sgpr(15)), 0x7E06020F, "v_mov v3,s15");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 0, gfx9_sgpr(18)), 0x7E000212, "v_mov v0,s18");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 1, gfx9_sgpr(19)), 0x7E020213, "v_mov v1,s19");
    # solid_red FS / VS tail: v_mov from inline f32 0.0 / 1.0
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 0, GFX9_INLINE_F32_1_0), 0x7E0002F2, "v_mov v0,1.0");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 1, GFX9_INLINE_F32_0_0), 0x7E020280, "v_mov v1,0.0");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 2, GFX9_INLINE_F32_0_0), 0x7E040280, "v_mov v2,0.0");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 3, GFX9_INLINE_F32_1_0), 0x7E0602F2, "v_mov v3,1.0");
    # VS: v_cvt_f32_i32 from VGPRs
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_F32_I32, 0, gfx9_vgpr(0)), 0x7E000B00, "v_cvt_f32_i32 v0,v0");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_F32_I32, 1, gfx9_vgpr(2)), 0x7E020B02, "v_cvt_f32_i32 v1,v2");
    # textured FS: v_cvt_i32_f32 from VGPRs
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_I32_F32, 4, gfx9_vgpr(2)), 0x7E081102, "v_cvt_i32_f32 v4,v2");
    assert_eq(gfx9_enc_vop1(GFX9_VOP1_V_CVT_I32_F32, 5, gfx9_vgpr(3)), 0x7E0A1103, "v_cvt_i32_f32 v5,v3");
    return 0;
}

# ================================================================
# VOP2 — every hand-authored two-source vector-ALU dword
# ================================================================
fn test_gfx9_enc_vop2() {
    # VS: lshlrev / and / add_u32 with inline constants
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHLREV_B32, 2, gfx9_inline_int(1), 0), 0x24040081, "v_lshlrev v2,1,v0");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHLREV_B32, 0, gfx9_inline_int(2), 0), 0x24000082, "v_lshlrev v0,2,v0");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_AND_B32, 0, gfx9_inline_int(4), 0), 0x26000084, "v_and v0,4,v0");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_AND_B32, 2, gfx9_inline_int(4), 2), 0x26040484, "v_and v2,4,v2");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_ADD_U32, 0, gfx9_inline_int(0 - 1), 0), 0x680000C1, "v_add_u32 v0,-1,v0");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_ADD_U32, 2, gfx9_inline_int(0 - 1), 2), 0x680404C1, "v_add_u32 v2,-1,v2");
    # downsample: and with a 0xff literal, lshrrev/lshlrev, add_u32 across VGPRs
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_AND_B32, 8, GFX9_SRC_LITERAL, 4), 0x261008FF, "v_and v8,lit,v4");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_AND_B32, 9, GFX9_SRC_LITERAL, 5), 0x26120AFF, "v_and v9,lit,v5");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_AND_B32, 10, GFX9_SRC_LITERAL, 6), 0x26140CFF, "v_and v10,lit,v6");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_AND_B32, 11, GFX9_SRC_LITERAL, 7), 0x26160EFF, "v_and v11,lit,v7");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_ADD_U32, 8, gfx9_vgpr(8), 11), 0x68101708, "v_add_u32 v8,v8,v11");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 8, gfx9_inline_int(2), 8), 0x20101082, "v_lshrrev v8,2,v8");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_ADD_U32, 9, gfx9_vgpr(9), 12), 0x68121909, "v_add_u32 v9,v9,v12");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 9, gfx9_inline_int(2), 9), 0x20121282, "v_lshrrev v9,2,v9");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHLREV_B32, 9, gfx9_inline_int(8), 9), 0x24121288, "v_lshlrev v9,8,v9");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_ADD_U32, 10, gfx9_vgpr(10), 13), 0x68141B0A, "v_add_u32 v10,v10,v13");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 10, gfx9_inline_int(2), 10), 0x20141482, "v_lshrrev v10,2,v10");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHLREV_B32, 10, gfx9_inline_int(16), 10), 0x24141490, "v_lshlrev v10,16,v10");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 11, gfx9_inline_int(24), 4), 0x20160898, "v_lshrrev v11,24,v4");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 12, gfx9_inline_int(24), 5), 0x20180A98, "v_lshrrev v12,24,v5");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 13, gfx9_inline_int(24), 6), 0x201A0C98, "v_lshrrev v13,24,v6");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 14, gfx9_inline_int(24), 7), 0x201C0E98, "v_lshrrev v14,24,v7");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_ADD_U32, 11, gfx9_vgpr(11), 14), 0x68161D0B, "v_add_u32 v11,v11,v14");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHRREV_B32, 11, gfx9_inline_int(2), 11), 0x20161682, "v_lshrrev v11,2,v11");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_LSHLREV_B32, 11, gfx9_inline_int(24), 11), 0x24161698, "v_lshlrev v11,24,v11");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_OR_B32, 8, gfx9_vgpr(8), 11), 0x28101708, "v_or_b32 v8,v8,v11");
    # textured FS: v_mul_f32 with a scalar src0 (the per-draw scale SGPR)
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_MUL_F32, 2, gfx9_sgpr(12), 2), 0x0A04040C, "v_mul_f32 v2,s12,v2");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_MUL_F32, 3, gfx9_sgpr(13), 3), 0x0A06060D, "v_mul_f32 v3,s13,v3");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_MUL_F32, 4, gfx9_sgpr(12), 2), 0x0A08040C, "v_mul_f32 v4,s12,v2");
    assert_eq(gfx9_enc_vop2(GFX9_VOP2_V_MUL_F32, 5, gfx9_sgpr(13), 3), 0x0A0A060D, "v_mul_f32 v5,s13,v3");
    return 0;
}

# ================================================================
# VOP3a — every hand-authored three-source dword (two dwords each)
# ================================================================
fn test_gfx9_enc_vop3a() {
    var add3 = GFX9_VOP3_V_ADD3_U32;
    var bfe = GFX9_VOP3_V_BFE_U32;
    var i8 = gfx9_inline_int(8);
    var i16 = gfx9_inline_int(16);
    # v_add3_u32 chain (downsample averages)
    assert_eq(gfx9_enc_vop3a_lo(add3, 8), 0xD1FF0008, "v_add3 v8 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(8), gfx9_vgpr(9), gfx9_vgpr(10)), 0x042A1308, "v_add3 v8 hi");
    assert_eq(gfx9_enc_vop3a_lo(add3, 9), 0xD1FF0009, "v_add3 v9 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(9), gfx9_vgpr(10), gfx9_vgpr(11)), 0x042E1509, "v_add3 v9 hi");
    assert_eq(gfx9_enc_vop3a_lo(add3, 10), 0xD1FF000A, "v_add3 v10 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(10), gfx9_vgpr(11), gfx9_vgpr(12)), 0x0432170A, "v_add3 v10 hi");
    assert_eq(gfx9_enc_vop3a_lo(add3, 11), 0xD1FF000B, "v_add3 v11 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(11), gfx9_vgpr(12), gfx9_vgpr(13)), 0x0436190B, "v_add3 v11 hi");
    # v_bfe_u32 (byte extraction): offset 8 / width 8 (green channel)
    assert_eq(gfx9_enc_vop3a_lo(bfe, 9), 0xD1C80009, "v_bfe v9 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(4), i8, i8), 0x02211104, "v_bfe v9,v4,8,8 hi");
    assert_eq(gfx9_enc_vop3a_lo(bfe, 10), 0xD1C8000A, "v_bfe v10 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(5), i8, i8), 0x02211105, "v_bfe v10,v5,8,8 hi");
    assert_eq(gfx9_enc_vop3a_lo(bfe, 11), 0xD1C8000B, "v_bfe v11 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(6), i8, i8), 0x02211106, "v_bfe v11,v6,8,8 hi");
    assert_eq(gfx9_enc_vop3a_lo(bfe, 12), 0xD1C8000C, "v_bfe v12 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(7), i8, i8), 0x02211107, "v_bfe v12,v7,8,8 hi");
    # v_bfe_u32: offset 16 / width 8 (blue channel)
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(4), i16, i8), 0x02212104, "v_bfe v?,v4,16,8 hi");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(5), i16, i8), 0x02212105, "v_bfe v?,v5,16,8 hi");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(6), i16, i8), 0x02212106, "v_bfe v?,v6,16,8 hi");
    assert_eq(gfx9_enc_vop3a_lo(bfe, 13), 0xD1C8000D, "v_bfe v13 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(7), i16, i8), 0x02212107, "v_bfe v13,v7,16,8 hi");
    # v_or3_b32 (pack RGBA)
    assert_eq(gfx9_enc_vop3a_lo(GFX9_VOP3_V_OR3_B32, 8), 0xD2020008, "v_or3 v8 lo");
    assert_eq(gfx9_enc_vop3a_hi(gfx9_vgpr(8), gfx9_vgpr(9), gfx9_vgpr(10)), 0x042A1308, "v_or3 v8 hi");
    return 0;
}

# ================================================================
# SOP2 — every hand-authored scalar two-source dword (downsample addr math)
# ================================================================
fn test_gfx9_enc_sop2() {
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_MUL_I32, 8, gfx9_sgpr(7), gfx9_sgpr(4)), 0x92080407, "s_mul_i32 s8,s7,s4");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_LSHL_B32, 9, gfx9_sgpr(8), gfx9_inline_int(4)), 0x8E098408, "s_lshl s9,s8,4");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_LSHL_B32, 10, gfx9_sgpr(6), gfx9_inline_int(3)), 0x8E0A8306, "s_lshl s10,s6,3");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADD_I32, 9, gfx9_sgpr(9), gfx9_sgpr(10)), 0x81090A09, "s_add_i32 s9,s9,s10");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADD_U32, 12, gfx9_sgpr(0), gfx9_sgpr(9)), 0x800C0900, "s_add_u32 s12,s0,s9");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADDC_U32, 13, gfx9_sgpr(1), gfx9_inline_int(0)), 0x820D8001, "s_addc s13,s1,0");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_LSHL_B32, 11, gfx9_sgpr(4), gfx9_inline_int(3)), 0x8E0B8304, "s_lshl s11,s4,3");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADD_U32, 14, gfx9_sgpr(12), gfx9_sgpr(11)), 0x800E0B0C, "s_add s14,s12,s11");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADDC_U32, 15, gfx9_sgpr(13), gfx9_inline_int(0)), 0x820F800D, "s_addc s15,s13");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_LSHL_B32, 16, gfx9_sgpr(8), gfx9_inline_int(2)), 0x8E108208, "s_lshl s16,s8,2");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_LSHL_B32, 17, gfx9_sgpr(6), gfx9_inline_int(2)), 0x8E118206, "s_lshl s17,s6,2");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADD_I32, 16, gfx9_sgpr(16), gfx9_sgpr(17)), 0x81101110, "s_add_i32 s16,s16");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADD_U32, 18, gfx9_sgpr(2), gfx9_sgpr(16)), 0x80121002, "s_add_u32 s18,s2,s16");
    assert_eq(gfx9_enc_sop2(GFX9_SOP2_S_ADDC_U32, 19, gfx9_sgpr(3), gfx9_inline_int(0)), 0x82138003, "s_addc s19,s3,0");
    return 0;
}

# ================================================================
# SOPP — s_endpgm / s_nop / s_waitcnt (all variants the shaders use)
# ================================================================
fn test_gfx9_enc_sopp() {
    assert_eq(gfx9_enc_sopp(GFX9_SOPP_S_ENDPGM, 0), 0xBF810000, "s_endpgm");
    assert_eq(gfx9_enc_sopp(GFX9_SOPP_S_NOP, 0), 0xBF800000, "s_nop 0");
    assert_eq(gfx9_enc_sopp(GFX9_SOPP_S_WAITCNT, 0x0070), 0xBF8C0070, "s_waitcnt vm(0) lgkm(0)");
    assert_eq(gfx9_enc_sopp(GFX9_SOPP_S_WAITCNT, 0x0F70), 0xBF8C0F70, "s_waitcnt vmcnt(0)");
    assert_eq(gfx9_enc_sopp(GFX9_SOPP_S_WAITCNT, 0xC07F), 0xBF8CC07F, "s_waitcnt lgkmcnt(0)");
    return 0;
}

# ================================================================
# SMEM — s_load_dwordx{2,4,8} (textured FS descriptor loads, two dwords)
# ================================================================
fn test_gfx9_enc_smem() {
    # s_load_dwordx8 s[0:7], s[0:1], 0x0
    assert_eq(gfx9_enc_smem_lo(GFX9_SMEM_S_LOAD_DWORDX8, 0, 0, 0), 0xC00E0000, "s_load_dwordx8 lo");
    # s_load_dwordx2 s[12:13], s[0:1], 0x30
    assert_eq(gfx9_enc_smem_lo(GFX9_SMEM_S_LOAD_DWORDX2, 12, 0, 0), 0xC0060300, "s_load_dwordx2 lo");
    # s_load_dwordx4 s[8:11], s[0:1], 0x20
    assert_eq(gfx9_enc_smem_lo(GFX9_SMEM_S_LOAD_DWORDX4, 8, 0, 0), 0xC00A0200, "s_load_dwordx4 lo");
    return 0;
}

# ================================================================
# FLAT (global) — global_load_dwordx2 / global_store_dword (two dwords)
# ================================================================
fn test_gfx9_enc_flat() {
    var st = GFX9_FLAT_GLOBAL_STORE_DWORD;
    var ld2 = GFX9_FLAT_GLOBAL_LOAD_DWORDX2;
    var g = GFX9_FLAT_SEG_GLOBAL;
    var off = GFX9_SADDR_OFF;
    # global_store_dword v[0:1], v2, off glc slc  (store_deadbeef: cache-bypassing)
    assert_eq(gfx9_enc_flat_lo(st, g, 0, 1, 1), 0xDC738000, "global_store glc slc lo");
    assert_eq(gfx9_enc_flat_hi(0, off, 2, 0), 0x007F0200, "global_store v2 hi");
    # global_load_dwordx2 v[4:5], v[0:1], off  (downsample: no glc/slc)
    assert_eq(gfx9_enc_flat_lo(ld2, g, 0, 0, 0), 0xDC548000, "global_load_dwordx2 lo");
    assert_eq(gfx9_enc_flat_hi(4, off, 0, 0), 0x047F0000, "global_load v[4:5] hi");
    assert_eq(gfx9_enc_flat_hi(6, off, 0, 2), 0x067F0002, "global_load v[6:7] from v[2:3] hi");
    # global_store_dword v[0:1], v8, off  (downsample: plain store)
    assert_eq(gfx9_enc_flat_lo(st, g, 0, 0, 0), 0xDC708000, "global_store (plain) lo");
    assert_eq(gfx9_enc_flat_hi(0, off, 8, 0), 0x007F0800, "global_store v8 hi");
    return 0;
}

# ================================================================
# Capstone: rebuild store_deadbeef wholly through the encoders and
# memcmp against the HW-verified hand-authored builder, byte-for-byte.
# Proves the encoders COMPOSE into a real shader's exact byte stream
# (not just per-dword). The full downsample-stream rebuild lands with
# the N.5 encode driver, where stream sequencing is the deliverable.
# ================================================================
fn test_gfx9_rebuild_store_deadbeef_byte_identical() {
    var truth[128];
    var built[128];
    var truth_end = native_gfx9_shader_store_deadbeef(&truth, 0);
    assert_eq(truth_end, 96, "deadbeef is 96 bytes");

    # Rebuild the identical stream from the encoders + raw literal/pad dwords.
    store32(&built +  0, gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 0, gfx9_sgpr(0)));
    store32(&built +  4, gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 1, gfx9_sgpr(1)));
    store32(&built +  8, gfx9_enc_vop1(GFX9_VOP1_V_MOV_B32, 2, GFX9_SRC_LITERAL));
    store32(&built + 12, 0xDEADBEEF);
    store32(&built + 16, gfx9_enc_flat_lo(GFX9_FLAT_GLOBAL_STORE_DWORD, GFX9_FLAT_SEG_GLOBAL, 0, 1, 1));
    store32(&built + 20, gfx9_enc_flat_hi(0, GFX9_SADDR_OFF, 2, 0));
    store32(&built + 24, gfx9_enc_sopp(GFX9_SOPP_S_WAITCNT, 0x0070));
    store32(&built + 28, gfx9_enc_sopp(GFX9_SOPP_S_ENDPGM, 0));
    var i = 0;
    while (i < 16) {
        store32(&built + 32 + i * 4, gfx9_enc_sopp(GFX9_SOPP_S_NOP, 0));
        i = i + 1;
    }
    assert_eq(memeq(&built, &truth, 96), 1, "rebuilt deadbeef == hand-authored bytes");
    return 0;
}

# ================================================================
# Phase N.1a — SPIR-V parser (spirv_parse.cyr)
# ================================================================
# A minimal valid GLCompute SPIR-V module (21 words / 84 bytes): header +
# OpCapability Shader + OpMemoryModel + OpEntryPoint GLCompute %4 "main" +
# OpExecutionMode %4 LocalSize 64 1 1. `buf` is a pointer param (the caller
# passes &buf), so writes use `buf + off` directly. Returns the byte length.
fn _spv_build_min_compute(buf): i64 {
    store32(buf +  0, 0x07230203);   # magic
    store32(buf +  4, 0x00010300);   # version 1.3
    store32(buf +  8, 0x00000000);   # generator
    store32(buf + 12, 20);           # id-bound
    store32(buf + 16, 0);            # schema
    store32(buf + 20, (2 << 16) | 17);   # OpCapability (wc 2)
    store32(buf + 24, 1);                # Shader
    store32(buf + 28, (3 << 16) | 14);   # OpMemoryModel (wc 3)
    store32(buf + 32, 0);                # Logical
    store32(buf + 36, 1);                # GLSL450
    store32(buf + 40, (5 << 16) | 15);   # OpEntryPoint (wc 5)
    store32(buf + 44, 5);                # GLCompute
    store32(buf + 48, 4);                # entry <id> = 4
    store32(buf + 52, 0x6E69616D);       # "main"
    store32(buf + 56, 0x00000000);       # name null term
    store32(buf + 60, (6 << 16) | 16);   # OpExecutionMode (wc 6)
    store32(buf + 64, 4);                # entry <id>
    store32(buf + 68, 17);               # LocalSize
    store32(buf + 72, 64);               # x
    store32(buf + 76, 1);                # y
    store32(buf + 80, 1);                # z
    return 84;
}

fn test_spirv_header_accessors() {
    var buf[128];
    var n = _spv_build_min_compute(&buf);
    assert_eq(n, 84, "min compute module is 84 bytes");
    assert_eq(spirv_hdr_magic(&buf), 0x07230203, "magic");
    assert_eq(spirv_hdr_version(&buf), 0x00010300, "version 1.3");
    assert_eq(spirv_hdr_id_bound(&buf), 20, "id bound");
    assert_eq(spirv_hdr_schema(&buf), 0, "schema 0");
    return 0;
}

fn test_spirv_op_decode() {
    # word0 = (wordcount << 16) | opcode
    assert_eq(spirv_op((5 << 16) | 15), 15, "opcode = low 16 bits");
    assert_eq(spirv_op_wordcount((5 << 16) | 15), 5, "wordcount = high 16 bits");
    assert_eq(spirv_op_wordcount((6 << 16) | 16), 6, "wordcount 6");
    assert_eq(spirv_op(0xFFFF0011), 17, "opcode masks to 16 bits");
    return 0;
}

fn test_spirv_validate_stream_valid() {
    var buf[128];
    var n = _spv_build_min_compute(&buf);
    assert_eq(spirv_validate_stream(&buf, n), SPIRV_PARSE_OK, "valid stream accepted");
    return 0;
}

fn test_spirv_validate_stream_rejects() {
    var buf[128];
    var n = _spv_build_min_compute(&buf);
    # bad magic -> _spirv_validate code 3
    store32(&buf + 0, 0xDEADBEEF);
    assert_eq(spirv_validate_stream(&buf, n), 3, "bad magic rejected");
    # too short -> code 1
    _spv_build_min_compute(&buf);
    assert_eq(spirv_validate_stream(&buf, 12), 1, "truncated header rejected");
    # id-bound 0 -> code 5
    _spv_build_min_compute(&buf);
    store32(&buf + 12, 0);
    assert_eq(spirv_validate_stream(&buf, n), 5, "zero id-bound rejected");
    # zero word count -> would loop forever; must be rejected (code 10)
    _spv_build_min_compute(&buf);
    store32(&buf + 20, 17);   # opcode 17, wordcount field = 0
    assert_eq(spirv_validate_stream(&buf, n), SPIRV_PARSE_ERR_ZERO_WC, "zero wordcount rejected");
    # instruction word count overruns the stream -> code 11
    _spv_build_min_compute(&buf);
    store32(&buf + 60, (100 << 16) | 16);   # claims 100 words at the tail
    assert_eq(spirv_validate_stream(&buf, n), SPIRV_PARSE_ERR_TRUNC, "overrun rejected");
    return 0;
}

fn test_spirv_count_instructions() {
    var buf[128];
    var n = _spv_build_min_compute(&buf);
    # cap + memorymodel + entrypoint + executionmode
    assert_eq(spirv_count_instructions(&buf, n), 4, "4 instructions");
    # malformed -> -1
    store32(&buf + 0, 0xDEADBEEF);
    assert_eq(spirv_count_instructions(&buf, n), 0 - 1, "malformed -> -1");
    return 0;
}

fn test_spirv_find_entry_point() {
    var buf[128];
    var n = _spv_build_min_compute(&buf);
    assert_eq(spirv_find_entry_point(&buf, n), 4, "GLCompute entry id = 4");
    # change the execution model away from GLCompute -> not found
    _spv_build_min_compute(&buf);
    store32(&buf + 44, 0);   # Vertex
    assert_eq(spirv_find_entry_point(&buf, n), 0 - 1, "non-GLCompute -> -1");
    return 0;
}

fn test_spirv_find_local_size() {
    var buf[128];
    var n = _spv_build_min_compute(&buf);
    var xyz[24];
    var found = spirv_find_local_size(&buf, n, 4, &xyz);
    assert_eq(found, 1, "LocalSize found");
    assert_eq(load64(&xyz + 0), 64, "local_size_x = 64");
    assert_eq(load64(&xyz + 8), 1, "local_size_y = 1");
    assert_eq(load64(&xyz + 16), 1, "local_size_z = 1");
    # wrong entry id -> not found
    assert_eq(spirv_find_local_size(&buf, n, 99, &xyz), 0, "wrong entry id -> not found");
    return 0;
}

# ================================================================
# Phase N.1b — type / constant / decoration tables
# ================================================================
# A richer fixture (id-bound 20, max id 13, 168 bytes) exercising the tables:
#   OpDecorate %12 Binding 0   ;   OpDecorate %12 DescriptorSet 0
#   OpTypeInt %6 32 1   ;   OpTypeFloat %7 32   ;   OpTypeVector %8 %7 4
#   OpTypeRuntimeArray %9 %7   ;   OpTypeStruct %10 %9
#   OpTypePointer %11 StorageBuffer(12) %10   ;   OpConstant %6 %13 42
#   OpVariable %11 %12 StorageBuffer(12)
fn _spv_build_typed_module(buf): i64 {
    store32(buf +   0, 0x07230203);   # magic
    store32(buf +   4, 0x00010300);   # version 1.3
    store32(buf +   8, 0);            # generator
    store32(buf +  12, 20);           # id-bound
    store32(buf +  16, 0);            # schema
    store32(buf +  20, (4 << 16) | 71);   # OpDecorate
    store32(buf +  24, 12);               # target %12
    store32(buf +  28, 33);               # Binding
    store32(buf +  32, 0);                # binding 0
    store32(buf +  36, (4 << 16) | 71);   # OpDecorate
    store32(buf +  40, 12);               # target %12
    store32(buf +  44, 34);               # DescriptorSet
    store32(buf +  48, 0);                # set 0
    store32(buf +  52, (4 << 16) | 21);   # OpTypeInt
    store32(buf +  56, 6);                # result %6
    store32(buf +  60, 32);               # width
    store32(buf +  64, 1);                # signed
    store32(buf +  68, (3 << 16) | 22);   # OpTypeFloat
    store32(buf +  72, 7);                # result %7
    store32(buf +  76, 32);               # width
    store32(buf +  80, (4 << 16) | 23);   # OpTypeVector
    store32(buf +  84, 8);                # result %8
    store32(buf +  88, 7);                # component %7
    store32(buf +  92, 4);                # count 4
    store32(buf +  96, (3 << 16) | 29);   # OpTypeRuntimeArray
    store32(buf + 100, 9);                # result %9
    store32(buf + 104, 7);                # element %7
    store32(buf + 108, (3 << 16) | 30);   # OpTypeStruct
    store32(buf + 112, 10);               # result %10
    store32(buf + 116, 9);                # member0 %9
    store32(buf + 120, (4 << 16) | 32);   # OpTypePointer
    store32(buf + 124, 11);               # result %11
    store32(buf + 128, 12);               # StorageBuffer
    store32(buf + 132, 10);               # pointee %10
    store32(buf + 136, (4 << 16) | 43);   # OpConstant
    store32(buf + 140, 6);                # result type %6
    store32(buf + 144, 13);               # result %13
    store32(buf + 148, 42);               # value
    store32(buf + 152, (4 << 16) | 59);   # OpVariable
    store32(buf + 156, 11);               # result type %11
    store32(buf + 160, 12);               # result %12
    store32(buf + 164, 12);               # StorageBuffer
    return 168;
}

fn test_spirv_type_table() {
    var buf[256];
    var n = _spv_build_typed_module(&buf);
    assert_eq(spirv_validate_stream(&buf, n), 0, "typed module valid");
    var ib = spirv_hdr_id_bound(&buf);
    var types[480];
    assert_eq(spirv_build_type_table(&buf, n, ib, &types), 0, "type table built");
    assert_eq(spirv_type_kind(&types, 6), SPIRV_TYK_INT, "id6 int");
    assert_eq(spirv_type_p0(&types, 6), 32, "int width 32");
    assert_eq(spirv_type_p1(&types, 6), 1, "int signed");
    assert_eq(spirv_type_kind(&types, 7), SPIRV_TYK_FLOAT, "id7 float");
    assert_eq(spirv_type_p0(&types, 7), 32, "float width 32");
    assert_eq(spirv_type_kind(&types, 8), SPIRV_TYK_VECTOR, "id8 vector");
    assert_eq(spirv_type_p0(&types, 8), 7, "vec component = id7");
    assert_eq(spirv_type_p1(&types, 8), 4, "vec count 4");
    assert_eq(spirv_type_kind(&types, 9), SPIRV_TYK_RUNTIME_ARRAY, "id9 runtime array");
    assert_eq(spirv_type_p0(&types, 9), 7, "rtarray element = id7");
    assert_eq(spirv_type_kind(&types, 10), SPIRV_TYK_STRUCT, "id10 struct");
    assert_eq(spirv_type_p0(&types, 10), 1, "struct member count 1");
    assert_eq(spirv_type_p1(&types, 10), 9, "struct member0 = id9");
    assert_eq(spirv_type_kind(&types, 11), SPIRV_TYK_POINTER, "id11 pointer");
    assert_eq(spirv_type_p0(&types, 11), 12, "ptr storage = StorageBuffer");
    assert_eq(spirv_type_p1(&types, 11), 10, "ptr pointee = id10");
    assert_eq(spirv_type_kind(&types, 5), SPIRV_TYK_NONE, "id5 not a type");
    return 0;
}

fn test_spirv_const_table() {
    var buf[256];
    var n = _spv_build_typed_module(&buf);
    var ib = spirv_hdr_id_bound(&buf);
    var consts[320];
    assert_eq(spirv_build_const_table(&buf, n, ib, &consts), 0, "const table built");
    assert_eq(spirv_const_type(&consts, 13), 6, "const13 type = id6");
    assert_eq(spirv_const_value(&consts, 13), 42, "const13 value 42");
    assert_eq(spirv_const_type(&consts, 5), 0, "id5 not a constant");
    return 0;
}

fn test_spirv_decoration_table() {
    var buf[256];
    var n = _spv_build_typed_module(&buf);
    var ib = spirv_hdr_id_bound(&buf);
    var deco[320];
    assert_eq(spirv_build_decoration_table(&buf, n, ib, &deco), 0, "deco table built");
    assert_eq(spirv_deco_binding(&deco, 12), 0, "var12 binding 0");
    assert_eq(spirv_deco_set(&deco, 12), 0, "var12 descriptor set 0");
    assert_eq(spirv_deco_binding(&deco, 7), 0 - 1, "id7 has no binding (-1)");
    return 0;
}

# ================================================================
# Phase N.2a — MIR data model + uniformity pass (mir.cyr)
# ================================================================
# Type-distill fixture: int(signed/unsigned), float(32/64), vec4(f32/f64/count5).
fn _spv_build_distill_types(buf): i64 {
    store32(buf +   0, 0x07230203);
    store32(buf +   4, 0x00010300);
    store32(buf +   8, 0);
    store32(buf +  12, 16);            # id-bound
    store32(buf +  16, 0);
    store32(buf +  20, (4 << 16) | 21);   # OpTypeInt %2 32 1 (signed -> I32)
    store32(buf +  24, 2);
    store32(buf +  28, 32);
    store32(buf +  32, 1);
    store32(buf +  36, (4 << 16) | 21);   # OpTypeInt %3 32 0 (unsigned -> U32)
    store32(buf +  40, 3);
    store32(buf +  44, 32);
    store32(buf +  48, 0);
    store32(buf +  52, (3 << 16) | 22);   # OpTypeFloat %4 32 (-> F32)
    store32(buf +  56, 4);
    store32(buf +  60, 32);
    store32(buf +  64, (3 << 16) | 22);   # OpTypeFloat %5 64 (-> UNSUPPORTED)
    store32(buf +  68, 5);
    store32(buf +  72, 64);
    store32(buf +  76, (4 << 16) | 23);   # OpTypeVector %6 %4 4 (vec4 f32)
    store32(buf +  80, 6);
    store32(buf +  84, 4);
    store32(buf +  88, 4);
    store32(buf +  92, (4 << 16) | 23);   # OpTypeVector %7 %5 4 (vec4 f64 -> UNSUPPORTED)
    store32(buf +  96, 7);
    store32(buf + 100, 5);
    store32(buf + 104, 4);
    store32(buf + 108, (4 << 16) | 23);   # OpTypeVector %8 %4 5 (count 5 -> UNSUPPORTED)
    store32(buf + 112, 8);
    store32(buf + 116, 4);
    store32(buf + 120, 5);
    return 124;
}

fn test_mir_type_distill() {
    var buf[128];
    var n = _spv_build_distill_types(&buf);
    var types[384];
    spirv_build_type_table(&buf, n, 16, &types);
    assert_eq(_mir_lower_type(&types, 2, 16), MIR_T_I32, "signed int32 -> I32");
    assert_eq(_mir_lower_type(&types, 3, 16), MIR_T_U32, "unsigned int32 -> U32");
    assert_eq(_mir_lower_type(&types, 4, 16), MIR_T_F32, "float32 -> F32");
    assert_eq(_mir_lower_type(&types, 5, 16), MIR_T_UNSUPPORTED, "float64 -> UNSUPPORTED");
    assert_eq(_mir_lower_type(&types, 6, 16), MIR_T_F32 | (4 << 8), "vec4 f32 -> F32|count4");
    assert_eq(_mir_lower_type(&types, 7, 16), MIR_T_UNSUPPORTED, "vec4 f64 -> UNSUPPORTED");
    assert_eq(_mir_lower_type(&types, 8, 16), MIR_T_UNSUPPORTED, "vec count5 -> UNSUPPORTED");
    return 0;
}

fn test_mir_type_helpers() {
    assert_eq(mir_type_base(MIR_T_F32), MIR_T_F32, "scalar base");
    assert_eq(mir_type_count(MIR_T_F32), 1, "scalar count = 1");
    assert_eq(mir_type_base(MIR_T_F32 | (4 << 8)), MIR_T_F32, "vec base = f32");
    assert_eq(mir_type_count(MIR_T_F32 | (4 << 8)), 4, "vec count = 4");
    assert_eq(mir_type_count(MIR_T_I32 | (2 << 8)), 2, "vec2 count = 2");
    return 0;
}

fn test_mir_meet_truth_table() {
    assert_eq(_mir_meet(MIR_UNIFORM, MIR_UNIFORM), MIR_UNIFORM, "U,U -> U");
    assert_eq(_mir_meet(MIR_UNIFORM, MIR_DIVERGENT), MIR_DIVERGENT, "U,D -> D");
    assert_eq(_mir_meet(MIR_DIVERGENT, MIR_UNIFORM), MIR_DIVERGENT, "D,U -> D");
    assert_eq(_mir_meet(MIR_DIVERGENT, MIR_DIVERGENT), MIR_DIVERGENT, "D,D -> D");
    return 0;
}

fn test_mir_builtin_unif() {
    assert_eq(_mir_builtin_unif(MIR_BI_WORKGROUP_ID), MIR_UNIFORM, "WorkgroupId uniform");
    assert_eq(_mir_builtin_unif(MIR_BI_LOCAL_INVOC_ID), MIR_DIVERGENT, "LocalInvocId divergent");
    assert_eq(_mir_builtin_unif(MIR_BI_GLOBAL_INVOC_ID), MIR_DIVERGENT, "GlobalInvocId divergent");
    return 0;
}

fn test_mir_value_builders() {
    var m[80];
    var vals[640];
    var instrs[512];
    var ptrs[64];
    var blocks[32];
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 2, 16, 16);
    mir_set_const(&m, 1, MIR_T_U32, 42);
    assert_eq(mir_val_kind(&m, 1), MIR_VK_CONST, "const kind");
    assert_eq(mir_val_type(&m, 1), MIR_T_U32, "const type");
    assert_eq(mir_val_unif(&m, 1), MIR_UNIFORM, "const uniform");
    assert_eq(mir_val_payload(&m, 1), 42, "const payload 42");
    assert_eq(mir_val_def(&m, 1), 0 - 1, "const def -1");
    mir_set_builtin(&m, 2, MIR_T_U32, MIR_BI_GLOBAL_INVOC_ID);
    assert_eq(mir_val_kind(&m, 2), MIR_VK_BUILTIN, "builtin kind");
    assert_eq(mir_val_unif(&m, 2), MIR_DIVERGENT, "gid divergent");
    assert_eq(mir_val_payload(&m, 2), MIR_BI_GLOBAL_INVOC_ID, "builtin payload");
    mir_set_bufvar(&m, 3, 1);
    assert_eq(mir_val_kind(&m, 3), MIR_VK_BUFVAR, "bufvar kind");
    assert_eq(mir_val_unif(&m, 3), MIR_UNIFORM, "bufvar uniform");
    assert_eq(mir_val_payload(&m, 3), 1, "bufvar binding 1");
    assert_eq(mir_val_kind(&m, 10), MIR_VK_NONE, "unset id is NONE");
    return 0;
}

fn test_mir_emit_and_accessors() {
    var m[80];
    var vals[640];
    var instrs[512];
    var ptrs[64];
    var blocks[32];
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 2, 16, 16);
    var idx = mir_emit(&m, MIR_OP_IADD, 5, MIR_T_I32, 2, 3, 0, 0);
    assert_eq(idx, 0, "first instr index 0");
    assert_eq(mir_instr_op(&m, 0), MIR_OP_IADD, "op IADD");
    assert_eq(mir_instr_result(&m, 0), 5, "result 5");
    assert_eq(mir_instr_type(&m, 0), MIR_T_I32, "type I32");
    assert_eq(mir_instr_a(&m, 0), 2, "operand a = 2");
    assert_eq(mir_instr_b(&m, 0), 3, "operand b = 3");
    assert_eq(mir_instr_c(&m, 0), 0, "operand c = 0");
    assert_eq(mir_val_kind(&m, 5), MIR_VK_SSA, "result is SSA");
    assert_eq(mir_val_type(&m, 5), MIR_T_I32, "result type I32");
    assert_eq(mir_val_unif(&m, 5), MIR_UNKNOWN, "result unif UNKNOWN pre-sweep");
    assert_eq(mir_val_def(&m, 5), 0, "result def = instr 0");
    # a vec-typed FMA exercises the 3rd operand + a >8-bit type value round-trip
    var vt = MIR_T_F32 | (4 << 8);
    var idx2 = mir_emit(&m, MIR_OP_FMA, 6, vt, 7, 8, 9, MIR_FLAG_C_IMM);
    assert_eq(idx2, 1, "second instr index 1");
    assert_eq(mir_instr_type(&m, 1), vt, "vec type round-trips");
    assert_eq(mir_instr_c(&m, 1), 9, "operand c = 9");
    assert_eq(mir_instr_flags(&m, 1), MIR_FLAG_C_IMM, "flags = C_IMM");
    assert_eq(mir_n_instrs(&m), 2, "n_instrs 2");
    return 0;
}

fn test_mir_add_ptr() {
    var m[80];
    var vals[640];
    var instrs[512];
    var ptrs[64];
    var blocks[32];
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 2, 16, 16);
    var p = mir_add_ptr(&m, 5, 0, MIR_T_F32, 7, 0, 1);
    assert_eq(p, 0, "first ptr index 0");
    assert_eq(mir_ptr_binding(&m, 0), 0, "binding 0");
    assert_eq(mir_ptr_elem_type(&m, 0), MIR_T_F32, "elem f32");
    assert_eq(mir_ptr_off_id(&m, 0), 7, "off_id 7");
    assert_eq(mir_ptr_const_off(&m, 0), 0, "const_off 0");
    assert_eq(mir_ptr_dynamic(&m, 0), 1, "dynamic 1");
    assert_eq(mir_val_kind(&m, 5), MIR_VK_PTR, "val 5 is PTR");
    assert_eq(mir_val_payload(&m, 5), 0, "val 5 payload = ptr 0");
    var p2 = mir_add_ptr(&m, 6, 1, MIR_T_F32, 0, 16, 0);
    assert_eq(p2, 1, "second ptr index 1");
    assert_eq(mir_ptr_binding(&m, 1), 1, "binding 1");
    assert_eq(mir_ptr_const_off(&m, 1), 16, "const_off 16");
    assert_eq(mir_ptr_dynamic(&m, 1), 0, "dynamic 0");
    return 0;
}

# The load-bearing test: a SAXPY-shape hand-built MIR; assert every value's
# GFX9 uniformity after the forward sweep. Divergent path = indexed by
# GlobalInvocationId; uniform path = WorkgroupId / const offset.
fn test_mir_uniformity() {
    var m[80];
    var vals[640];
    var instrs[512];
    var ptrs[64];
    var blocks[32];
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 2, 16, 16);
    mir_set_const(&m, 1, MIR_T_U32, 4);                             # stride
    mir_set_builtin(&m, 2, MIR_T_U32, MIR_BI_GLOBAL_INVOC_ID);     # divergent
    mir_set_builtin(&m, 3, MIR_T_U32, MIR_BI_WORKGROUP_ID);        # uniform
    mir_set_bufvar(&m, 4, 0);                                      # uniform
    mir_emit(&m, MIR_OP_IMUL, 5, MIR_T_U32, 2, 1, 0, 0);          # gid*stride -> div
    mir_emit(&m, MIR_OP_IADD, 6, MIR_T_U32, 3, 1, 0, 0);          # wgid+stride -> unif
    mir_emit(&m, MIR_OP_LOAD, 7, MIR_T_F32, 5, 0, 0, 0);          # load off div -> div
    mir_emit(&m, MIR_OP_LOAD, 8, MIR_T_F32, 6, 0, 0, 0);          # load off unif -> unif
    mir_emit(&m, MIR_OP_LOAD, 9, MIR_T_F32, 0, 0, 0, 0);          # load const off -> unif
    mir_emit(&m, MIR_OP_FMUL, 10, MIR_T_F32, 7, 8, 0, 0);         # div*unif -> div
    mir_emit(&m, MIR_OP_IADD, 11, MIR_T_U32, 3, 2, 0, MIR_FLAG_B_IMM);  # b immediate -> skip -> unif
    mir_emit(&m, MIR_OP_STORE, 0, MIR_T_VOID, 5, 0, 10, 0);       # store (no result)
    mir_emit(&m, MIR_OP_RET, 0, MIR_T_VOID, 0, 0, 0, 0);
    mir_run_uniformity(&m);
    assert_eq(mir_val_unif(&m, 5), MIR_DIVERGENT, "gid*stride divergent");
    assert_eq(mir_val_unif(&m, 6), MIR_UNIFORM, "wgid+stride uniform");
    assert_eq(mir_val_unif(&m, 7), MIR_DIVERGENT, "divergent-offset load divergent");
    assert_eq(mir_val_unif(&m, 8), MIR_UNIFORM, "uniform-offset load uniform");
    assert_eq(mir_val_unif(&m, 9), MIR_UNIFORM, "const-offset load uniform");
    assert_eq(mir_val_unif(&m, 10), MIR_DIVERGENT, "div*unif -> divergent");
    assert_eq(mir_val_unif(&m, 11), MIR_UNIFORM, "immediate operand skipped -> uniform");
    return 0;
}

fn test_mir_blocks_and_synth() {
    var m[80];
    var vals[800];
    var instrs[512];
    var ptrs[64];
    var blocks[32];
    # id_bound 16, cap_ids 20 -> synth ids 16..19 have backing storage (vals 20*40)
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 2, 16, 20);
    mir_emit(&m, MIR_OP_RET, 0, MIR_T_VOID, 0, 0, 0, 0);
    mir_emit(&m, MIR_OP_RET, 0, MIR_T_VOID, 0, 0, 0, 0);
    mir_finalize_block0(&m);
    assert_eq(mir_block_count_total(&m), 1, "MVP single block");
    assert_eq(mir_block_first(&m, 0), 0, "block first instr 0");
    assert_eq(mir_block_count(&m, 0), 2, "block instr count 2");
    assert_eq(mir_block_term(&m, 0), MIR_TERM_RETURN, "terminator RETURN");
    var s0 = mir_alloc_synth_id(&m);
    assert_eq(s0, 16, "synth id starts at id_bound");
    assert_eq(mir_alloc_synth_id(&m), 17, "synth id increments");
    # a synth id IS usable as an SSA result (cap_ids headroom) — review N.2a #1
    assert_eq(mir_emit(&m, MIR_OP_IMUL, s0, MIR_T_U32, 0, 0, 0, 0), 2, "synth-id result emitted");
    assert_eq(mir_val_kind(&m, s0), MIR_VK_SSA, "synth id became an SSA value");
    return 0;
}

# Pathological-vector fixture for the type-distill audit (review N.2a #3/#4):
# vec4 f32 (valid), vector-of-vector (component is a vector), and a
# self-referential vector (component == own id).
fn _spv_build_bad_vectors(buf): i64 {
    store32(buf +  0, 0x07230203);
    store32(buf +  4, 0x00010300);
    store32(buf +  8, 0);
    store32(buf + 12, 16);
    store32(buf + 16, 0);
    store32(buf + 20, (3 << 16) | 22);   # OpTypeFloat %4 32
    store32(buf + 24, 4);
    store32(buf + 28, 32);
    store32(buf + 32, (4 << 16) | 23);   # OpTypeVector %6 %4 4 (valid vec4 f32)
    store32(buf + 36, 6);
    store32(buf + 40, 4);
    store32(buf + 44, 4);
    store32(buf + 48, (4 << 16) | 23);   # OpTypeVector %7 %6 2 (component is a vector)
    store32(buf + 52, 7);
    store32(buf + 56, 6);
    store32(buf + 60, 2);
    store32(buf + 64, (4 << 16) | 23);   # OpTypeVector %8 %8 4 (self-referential)
    store32(buf + 68, 8);
    store32(buf + 72, 8);
    store32(buf + 76, 4);
    return 80;
}

# Regression tests for the N.2a adversarial review (5 confirmed findings).
fn test_mir_review_n2a() {
    var m[80];
    var vals[640];
    var instrs[512];
    var ptrs[64];
    var blocks[32];
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 2, 16, 16);
    # #5: mir_set_* bound-check the value-id ceiling + the id-0 sentinel
    assert_eq(mir_set_const(&m, 5, MIR_T_U32, 1), 0, "set_const valid id ok");
    assert_eq(mir_set_const(&m, 16, MIR_T_U32, 1), 0 - MIR_ERR_ID_OOR, "set_const id == cap -> OOR");
    assert_eq(mir_set_const(&m, 0, MIR_T_U32, 1), 0 - MIR_ERR_ID_OOR, "set_const id 0 -> OOR");
    assert_eq(mir_set_bufvar(&m, 0, 0), 0 - MIR_ERR_ID_OOR, "set_bufvar id 0 -> OOR");
    # #2: mir_add_ptr rejects result_id 0 (sentinel) and the ceiling
    assert_eq(mir_add_ptr(&m, 0, 0, MIR_T_F32, 0, 0, 0), 0 - MIR_ERR_ID_OOR, "add_ptr id 0 -> OOR");
    assert_eq(mir_add_ptr(&m, 16, 0, MIR_T_F32, 0, 0, 0), 0 - MIR_ERR_ID_OOR, "add_ptr id == cap -> OOR");
    # vals[0] sentinel intact after the rejected writes
    assert_eq(mir_val_kind(&m, 0), MIR_VK_NONE, "vals[0] sentinel preserved");
    # #3/#4: type distillation rejects pathological vectors (no crash, no corruption)
    var buf[128];
    var n = _spv_build_bad_vectors(&buf);
    var types[384];
    spirv_build_type_table(&buf, n, 16, &types);
    assert_eq(_mir_lower_type(&types, 6, 16), MIR_T_F32 | (4 << 8), "valid vec4 f32 ok");
    assert_eq(_mir_lower_type(&types, 7, 16), MIR_T_UNSUPPORTED, "vector-of-vector -> UNSUPPORTED");
    assert_eq(_mir_lower_type(&types, 8, 16), MIR_T_UNSUPPORTED, "self-ref vector -> UNSUPPORTED (no crash)");
    return 0;
}

fn test_mir_emit_errors() {
    var m[80];
    var vals[640];
    var instrs[512];
    var ptrs[64];
    var blocks[32];
    # cap_instrs = 1: the second emit overflows
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 1, 2, 16, 16);
    assert_eq(mir_emit(&m, MIR_OP_RET, 0, MIR_T_VOID, 0, 0, 0, 0), 0, "first emit ok");
    assert_eq(mir_emit(&m, MIR_OP_RET, 0, MIR_T_VOID, 0, 0, 0, 0), 0 - MIR_ERR_CAP_EXCEEDED, "cap exceeded");
    # result id >= id_bound -> ID_OOR
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 2, 16, 16);
    assert_eq(mir_emit(&m, MIR_OP_IADD, 16, MIR_T_I32, 1, 1, 0, 0), 0 - MIR_ERR_ID_OOR, "result id OOR");
    return 0;
}

# ================================================================
# Phase N.2b-1 — SPIR-V → MIR lowering (spirv_lower.cyr)
# ================================================================
# A memory-free GLCompute kernel (id-bound 16, 352 bytes): loads
# GlobalInvocationId, extracts .x, does int arithmetic on it + two constants.
# Exercises builtin-resolve, the seed, the builtin OpLoad alias,
# OpCompositeExtract, the ALU dispatch, OpReturn, and the uniformity sweep —
# end-to-end, no buffer access (that is N.2b-2).
#   %1 void  %2 fn()  %3 uint  %4 uvec3  %5 ptr Input uvec3  %6 main  %7 gid var
#   %8 const 1  %9 const 2  %10 label  %11 load gid  %12 gid.x
#   %13 x+1  %14 (x+1)*2  %15 1<<2 (both const -> uniform)
fn _spv_build_gid_kernel(buf): i64 {
    store32(buf +   0, 0x07230203);
    store32(buf +   4, 0x00010300);
    store32(buf +   8, 0);
    store32(buf +  12, 16);
    store32(buf +  16, 0);
    store32(buf +  20, (2 << 16) | 17);   # OpCapability Shader
    store32(buf +  24, 1);
    store32(buf +  28, (3 << 16) | 14);   # OpMemoryModel Logical GLSL450
    store32(buf +  32, 0);
    store32(buf +  36, 1);
    store32(buf +  40, (6 << 16) | 15);   # OpEntryPoint GLCompute %6 "main" %7
    store32(buf +  44, 5);
    store32(buf +  48, 6);
    store32(buf +  52, 0x6E69616D);
    store32(buf +  56, 0);
    store32(buf +  60, 7);
    store32(buf +  64, (6 << 16) | 16);   # OpExecutionMode %6 LocalSize 64 1 1
    store32(buf +  68, 6);
    store32(buf +  72, 17);
    store32(buf +  76, 64);
    store32(buf +  80, 1);
    store32(buf +  84, 1);
    store32(buf +  88, (4 << 16) | 71);   # OpDecorate %7 BuiltIn GlobalInvocationId
    store32(buf +  92, 7);
    store32(buf +  96, 11);
    store32(buf + 100, 28);
    store32(buf + 104, (2 << 16) | 19);   # OpTypeVoid %1
    store32(buf + 108, 1);
    store32(buf + 112, (3 << 16) | 33);   # OpTypeFunction %2 %1
    store32(buf + 116, 2);
    store32(buf + 120, 1);
    store32(buf + 124, (4 << 16) | 21);   # OpTypeInt %3 32 0
    store32(buf + 128, 3);
    store32(buf + 132, 32);
    store32(buf + 136, 0);
    store32(buf + 140, (4 << 16) | 23);   # OpTypeVector %4 %3 3
    store32(buf + 144, 4);
    store32(buf + 148, 3);
    store32(buf + 152, 3);
    store32(buf + 156, (4 << 16) | 32);   # OpTypePointer %5 Input %4
    store32(buf + 160, 5);
    store32(buf + 164, 1);
    store32(buf + 168, 4);
    store32(buf + 172, (4 << 16) | 43);   # OpConstant %3 %8 1
    store32(buf + 176, 3);
    store32(buf + 180, 8);
    store32(buf + 184, 1);
    store32(buf + 188, (4 << 16) | 43);   # OpConstant %3 %9 2
    store32(buf + 192, 3);
    store32(buf + 196, 9);
    store32(buf + 200, 2);
    store32(buf + 204, (4 << 16) | 59);   # OpVariable %5 %7 Input
    store32(buf + 208, 5);
    store32(buf + 212, 7);
    store32(buf + 216, 1);
    store32(buf + 220, (5 << 16) | 54);   # OpFunction %1 %6 None %2
    store32(buf + 224, 1);
    store32(buf + 228, 6);
    store32(buf + 232, 0);
    store32(buf + 236, 2);
    store32(buf + 240, (2 << 16) | 248);  # OpLabel %10
    store32(buf + 244, 10);
    store32(buf + 248, (4 << 16) | 61);   # OpLoad %4 %11 %7
    store32(buf + 252, 4);
    store32(buf + 256, 11);
    store32(buf + 260, 7);
    store32(buf + 264, (5 << 16) | 81);   # OpCompositeExtract %3 %12 %11 0
    store32(buf + 268, 3);
    store32(buf + 272, 12);
    store32(buf + 276, 11);
    store32(buf + 280, 0);
    store32(buf + 284, (5 << 16) | 128);  # OpIAdd %3 %13 %12 %8
    store32(buf + 288, 3);
    store32(buf + 292, 13);
    store32(buf + 296, 12);
    store32(buf + 300, 8);
    store32(buf + 304, (5 << 16) | 132);  # OpIMul %3 %14 %13 %9
    store32(buf + 308, 3);
    store32(buf + 312, 14);
    store32(buf + 316, 13);
    store32(buf + 320, 9);
    store32(buf + 324, (5 << 16) | 196);  # OpShiftLeftLogical %3 %15 %8 %9
    store32(buf + 328, 3);
    store32(buf + 332, 15);
    store32(buf + 336, 8);
    store32(buf + 340, 9);
    store32(buf + 344, (1 << 16) | 253);  # OpReturn
    store32(buf + 348, (1 << 16) | 56);   # OpFunctionEnd
    return 352;
}

fn test_spirv_lower_gid_kernel() {
    var buf[384];
    var n = _spv_build_gid_kernel(&buf);
    assert_eq(spirv_validate_stream(&buf, n), 0, "gid kernel valid");
    var types[384];
    var consts[256];
    var deco[256];
    var outbi[128];
    spirv_build_type_table(&buf, n, 16, &types);
    spirv_build_const_table(&buf, n, 16, &consts);
    spirv_build_decoration_table(&buf, n, 16, &deco);
    var m[80];
    var vals[640];
    var instrs[512];
    var ptrs[64];
    var blocks[32];
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 4, 16, 16);
    assert_eq(spirv_lower_module(&buf, n, &types, &consts, &deco, &m, &outbi), 0, "lower ok");
    # builtin resolution (the gap the N.1b parser does not fill)
    assert_eq(_spirv_builtin_for_var(&outbi, 7), MIR_BI_GLOBAL_INVOC_ID, "gid var resolved");
    # seed
    assert_eq(mir_val_kind(&m, 7), MIR_VK_BUILTIN, "gid is builtin");
    assert_eq(mir_val_unif(&m, 7), MIR_DIVERGENT, "gid divergent");
    assert_eq(mir_val_kind(&m, 8), MIR_VK_CONST, "c1 const");
    assert_eq(mir_val_payload(&m, 8), 1, "c1 value 1");
    # instr stream: EXTRACT, IADD, IMUL, SHL, RET (the builtin load is an alias)
    assert_eq(mir_n_instrs(&m), 5, "5 instrs");
    assert_eq(mir_instr_op(&m, 0), MIR_OP_EXTRACT, "i0 extract");
    assert_eq(mir_instr_result(&m, 0), 12, "extract -> %12");
    assert_eq(mir_instr_flags(&m, 0), MIR_FLAG_C_IMM, "extract lane is immediate");
    assert_eq(mir_instr_op(&m, 1), MIR_OP_IADD, "i1 iadd");
    assert_eq(mir_instr_op(&m, 2), MIR_OP_IMUL, "i2 imul");
    assert_eq(mir_instr_op(&m, 3), MIR_OP_SHL, "i3 shl");
    assert_eq(mir_instr_op(&m, 4), MIR_OP_RET, "i4 ret");
    # the builtin OpLoad aliased %11 to the builtin value (no instruction)
    assert_eq(mir_val_kind(&m, 11), MIR_VK_BUILTIN, "load aliases builtin");
    assert_eq(mir_val_unif(&m, 11), MIR_DIVERGENT, "loaded gid divergent");
    # uniformity sweep
    assert_eq(mir_val_unif(&m, 12), MIR_DIVERGENT, "gid.x divergent");
    assert_eq(mir_val_unif(&m, 13), MIR_DIVERGENT, "x+1 divergent");
    assert_eq(mir_val_unif(&m, 14), MIR_DIVERGENT, "(x+1)*2 divergent");
    assert_eq(mir_val_unif(&m, 15), MIR_UNIFORM, "1<<2 uniform (both const)");
    # block
    assert_eq(mir_block_term(&m, 0), MIR_TERM_RETURN, "ret terminator");
    assert_eq(mir_block_count(&m, 0), 5, "block has 5 instrs");
    return 0;
}

# The StorageBuffer seed path (reusing the N.1b typed-module fixture): a bound
# variable seeds to a BUFVAR carrying its binding; a scalar OpConstant seeds too.
fn test_spirv_lower_seed_bufvar() {
    var buf[256];
    var n = _spv_build_typed_module(&buf);
    var types[480];
    var deco[320];
    var outbi[160];
    spirv_build_type_table(&buf, n, 20, &types);
    spirv_build_decoration_table(&buf, n, 20, &deco);
    _spirv_resolve_builtins(&buf, n, 20, &outbi);
    var m[80];
    var vals[800];
    var instrs[512];
    var ptrs[64];
    var blocks[32];
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 2, 20, 20);
    assert_eq(_spirv_lower_seed_globals(&buf, n, &types, &deco, &m, &outbi), 0, "seed ok");
    assert_eq(mir_val_kind(&m, 12), MIR_VK_BUFVAR, "var %12 is a buffer var");
    assert_eq(mir_val_payload(&m, 12), 0, "var %12 binding 0");
    assert_eq(mir_val_unif(&m, 12), MIR_UNIFORM, "buffer base uniform");
    assert_eq(mir_val_kind(&m, 13), MIR_VK_CONST, "const %13 seeded");
    assert_eq(mir_val_payload(&m, 13), 42, "const %13 value 42");
    assert_eq(mir_val_type(&m, 13), MIR_T_I32, "const %13 type I32");
    return 0;
}

fn test_spirv_lower_negatives() {
    var buf[384];
    var types[384];
    var consts[256];
    var deco[256];
    var outbi[128];
    var m[80];
    var vals[640];
    var instrs[512];
    var ptrs[64];
    var blocks[32];
    # no GLCompute entry point -> LOWER_ERR_NO_ENTRY
    var n = _spv_build_gid_kernel(&buf);
    store32(&buf + 44, 0);   # OpEntryPoint execution model GLCompute(5) -> Vertex(0)
    spirv_build_type_table(&buf, n, 16, &types);
    spirv_build_const_table(&buf, n, 16, &consts);
    spirv_build_decoration_table(&buf, n, 16, &deco);
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 4, 16, 16);
    assert_eq(spirv_lower_module(&buf, n, &types, &consts, &deco, &m, &outbi),
    0 - LOWER_ERR_NO_ENTRY, "no entry rejected");
    # a control-flow op in the body -> LOWER_ERR_CONTROL_FLOW (fail loud, N.7)
    _spv_build_gid_kernel(&buf);
    store32(&buf + 324, (5 << 16) | 249);   # OpShiftLeftLogical -> OpBranch
    spirv_build_type_table(&buf, n, 16, &types);
    spirv_build_const_table(&buf, n, 16, &consts);
    spirv_build_decoration_table(&buf, n, 16, &deco);
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 4, 16, 16);
    assert_eq(spirv_lower_module(&buf, n, &types, &consts, &deco, &m, &outbi),
    0 - LOWER_ERR_CONTROL_FLOW, "CF rejected");
    # an unmapped executable op -> MIR_ERR_UNSUPPORTED_OP
    _spv_build_gid_kernel(&buf);
    store32(&buf + 324, (5 << 16) | 136);   # OpShiftLeftLogical -> OpFDiv (unmapped)
    spirv_build_type_table(&buf, n, 16, &types);
    spirv_build_const_table(&buf, n, 16, &consts);
    spirv_build_decoration_table(&buf, n, 16, &deco);
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 4, 16, 16);
    assert_eq(spirv_lower_module(&buf, n, &types, &consts, &deco, &m, &outbi),
    0 - MIR_ERR_UNSUPPORTED_OP, "unmapped op err");
    return 0;
}

# Regression tests for the N.2b-1 adversarial review (untrusted-id OOB class +
# fail-loud gaps). Each corrupts one word of the valid gid kernel to a crafted
# out-of-range id; spirv_validate_stream still passes (structure intact), and the
# lowering must reject it (fail loud) with NO out-of-bounds access.
fn test_spirv_lower_n2b1_review() {
    var buf[384];
    var types[384];
    var consts[256];
    var deco[256];
    var outbi[128];
    var m[80];
    var vals[640];
    var instrs[512];
    var ptrs[64];
    var blocks[32];
    # #1 untrusted ALU operand id -> bounded in mir_emit (was an OOB read in the
    # uniformity sweep). IADD operand a is at buf+296.
    var n = _spv_build_gid_kernel(&buf);
    store32(&buf + 296, 0x3FFFFFFF);
    spirv_build_type_table(&buf, n, 16, &types);
    spirv_build_const_table(&buf, n, 16, &consts);
    spirv_build_decoration_table(&buf, n, 16, &deco);
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 4, 16, 16);
    assert_eq(spirv_lower_module(&buf, n, &types, &consts, &deco, &m, &outbi),
    0 - MIR_ERR_ID_OOR, "operand OOB rejected");
    # #2 untrusted result-type id -> bounded in _mir_lower_type (was OOB type read).
    _spv_build_gid_kernel(&buf);
    store32(&buf + 288, 0x3FFFFFFF);   # IADD result-type word
    spirv_build_type_table(&buf, n, 16, &types);
    spirv_build_const_table(&buf, n, 16, &consts);
    spirv_build_decoration_table(&buf, n, 16, &deco);
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 4, 16, 16);
    assert_eq(spirv_lower_module(&buf, n, &types, &consts, &deco, &m, &outbi),
    0 - MIR_ERR_UNSUPPORTED_TYPE, "type OOB");
    # #3 untrusted OpLoad source id -> bounded in _spirv_lower_load (was OOB read).
    _spv_build_gid_kernel(&buf);
    store32(&buf + 260, 0x3FFFFFFF);   # OpLoad source word
    spirv_build_type_table(&buf, n, 16, &types);
    spirv_build_const_table(&buf, n, 16, &consts);
    spirv_build_decoration_table(&buf, n, 16, &deco);
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 4, 16, 16);
    assert_eq(spirv_lower_module(&buf, n, &types, &consts, &deco, &m, &outbi),
    0 - MIR_ERR_ID_OOR, "load src OOB rejected");
    # #4 untrusted OpDecorate BuiltIn target id -> bounded in _spirv_resolve_builtins
    # (was a controlled-offset OOB WRITE). The store is skipped; the now-unresolved
    # gid var makes the body OpLoad fail loud (no crash, no corruption).
    _spv_build_gid_kernel(&buf);
    store32(&buf + 92, 0x3FFFFFFF);   # OpDecorate target word
    spirv_build_type_table(&buf, n, 16, &types);
    spirv_build_const_table(&buf, n, 16, &consts);
    spirv_build_decoration_table(&buf, n, 16, &deco);
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 4, 16, 16);
    assert_eq(spirv_lower_module(&buf, n, &types, &consts, &deco, &m, &outbi),
    0 - MIR_ERR_UNSUPPORTED_OP, "deco OOB safe");
    # #5 entry id with no matching OpFunction -> fail loud (was silent empty body).
    _spv_build_gid_kernel(&buf);
    store32(&buf + 228, 99);   # OpFunction result id 6 -> 99 (entry point still names 6)
    spirv_build_type_table(&buf, n, 16, &types);
    spirv_build_const_table(&buf, n, 16, &consts);
    spirv_build_decoration_table(&buf, n, 16, &deco);
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 4, 16, 16);
    assert_eq(spirv_lower_module(&buf, n, &types, &consts, &deco, &m, &outbi),
    0 - LOWER_ERR_NO_ENTRY, "empty body fail-loud");
    return 0;
}

# ================================================================
# Phase N.2b-2 — buffer memory path (OpAccessChain + Load/Store)
# ================================================================
# A SAXPY-shape GLCompute kernel (id-bound 26, 588 bytes): two StorageBuffer
# bindings X(b0) Y(b1) of struct{ runtimearray<float> }, a float constant a, and
# y[gid.x] = a * x[gid.x] + y[gid.x]. Exercises the full memory path:
# OpAccessChain (dynamic index -> synth IMUL offset), buffer OpLoad/OpStore, and
# the uniformity of indexed loads.
#   %1 void %2 fn %3 float %4 uint %5 uvec3 %6 ptr-In-uvec3
#   %7 rtarray<f32> %8 struct{%7} %9 ptr-SB-struct %10 ptr-SB-float
#   %11 main %12 gid %13 xbuf %14 ybuf %15 const a(2.0) %16 const 0
#   %17 label %18 load-gid %19 gid.x %20 px %21 xv %22 py %23 yv %24 a*xv %25 +yv
fn _spv_build_saxpy(buf): i64 {
    store32(buf +   0, 0x07230203);
    store32(buf +   4, 0x00010300);
    store32(buf +   8, 0);
    store32(buf +  12, 26);
    store32(buf +  16, 0);
    store32(buf +  20, (2 << 16) | 17);   # OpCapability Shader
    store32(buf +  24, 1);
    store32(buf +  28, (3 << 16) | 14);   # OpMemoryModel Logical GLSL450
    store32(buf +  32, 0);
    store32(buf +  36, 1);
    store32(buf +  40, (6 << 16) | 15);   # OpEntryPoint GLCompute %11 "main" %12
    store32(buf +  44, 5);
    store32(buf +  48, 11);
    store32(buf +  52, 0x6E69616D);
    store32(buf +  56, 0);
    store32(buf +  60, 12);
    store32(buf +  64, (6 << 16) | 16);   # OpExecutionMode %11 LocalSize 64 1 1
    store32(buf +  68, 11);
    store32(buf +  72, 17);
    store32(buf +  76, 64);
    store32(buf +  80, 1);
    store32(buf +  84, 1);
    store32(buf +  88, (4 << 16) | 71);   # OpDecorate %12 BuiltIn GlobalInvocationId
    store32(buf +  92, 12);
    store32(buf +  96, 11);
    store32(buf + 100, 28);
    store32(buf + 104, (4 << 16) | 71);   # OpDecorate %13 Binding 0
    store32(buf + 108, 13);
    store32(buf + 112, 33);
    store32(buf + 116, 0);
    store32(buf + 120, (4 << 16) | 71);   # OpDecorate %13 DescriptorSet 0
    store32(buf + 124, 13);
    store32(buf + 128, 34);
    store32(buf + 132, 0);
    store32(buf + 136, (4 << 16) | 71);   # OpDecorate %14 Binding 1
    store32(buf + 140, 14);
    store32(buf + 144, 33);
    store32(buf + 148, 1);
    store32(buf + 152, (4 << 16) | 71);   # OpDecorate %14 DescriptorSet 0
    store32(buf + 156, 14);
    store32(buf + 160, 34);
    store32(buf + 164, 0);
    store32(buf + 168, (2 << 16) | 19);   # OpTypeVoid %1
    store32(buf + 172, 1);
    store32(buf + 176, (3 << 16) | 33);   # OpTypeFunction %2 %1
    store32(buf + 180, 2);
    store32(buf + 184, 1);
    store32(buf + 188, (3 << 16) | 22);   # OpTypeFloat %3 32
    store32(buf + 192, 3);
    store32(buf + 196, 32);
    store32(buf + 200, (4 << 16) | 21);   # OpTypeInt %4 32 0
    store32(buf + 204, 4);
    store32(buf + 208, 32);
    store32(buf + 212, 0);
    store32(buf + 216, (4 << 16) | 23);   # OpTypeVector %5 %4 3
    store32(buf + 220, 5);
    store32(buf + 224, 4);
    store32(buf + 228, 3);
    store32(buf + 232, (4 << 16) | 32);   # OpTypePointer %6 Input %5
    store32(buf + 236, 6);
    store32(buf + 240, 1);
    store32(buf + 244, 5);
    store32(buf + 248, (3 << 16) | 29);   # OpTypeRuntimeArray %7 %3
    store32(buf + 252, 7);
    store32(buf + 256, 3);
    store32(buf + 260, (3 << 16) | 30);   # OpTypeStruct %8 %7
    store32(buf + 264, 8);
    store32(buf + 268, 7);
    store32(buf + 272, (4 << 16) | 32);   # OpTypePointer %9 StorageBuffer %8
    store32(buf + 276, 9);
    store32(buf + 280, 12);
    store32(buf + 284, 8);
    store32(buf + 288, (4 << 16) | 32);   # OpTypePointer %10 StorageBuffer %3
    store32(buf + 292, 10);
    store32(buf + 296, 12);
    store32(buf + 300, 3);
    store32(buf + 304, (4 << 16) | 43);   # OpConstant %3 %15 2.0
    store32(buf + 308, 3);
    store32(buf + 312, 15);
    store32(buf + 316, 0x40000000);
    store32(buf + 320, (4 << 16) | 43);   # OpConstant %4 %16 0
    store32(buf + 324, 4);
    store32(buf + 328, 16);
    store32(buf + 332, 0);
    store32(buf + 336, (4 << 16) | 59);   # OpVariable %6 %12 Input
    store32(buf + 340, 6);
    store32(buf + 344, 12);
    store32(buf + 348, 1);
    store32(buf + 352, (4 << 16) | 59);   # OpVariable %9 %13 StorageBuffer
    store32(buf + 356, 9);
    store32(buf + 360, 13);
    store32(buf + 364, 12);
    store32(buf + 368, (4 << 16) | 59);   # OpVariable %9 %14 StorageBuffer
    store32(buf + 372, 9);
    store32(buf + 376, 14);
    store32(buf + 380, 12);
    store32(buf + 384, (5 << 16) | 54);   # OpFunction %1 %11 None %2
    store32(buf + 388, 1);
    store32(buf + 392, 11);
    store32(buf + 396, 0);
    store32(buf + 400, 2);
    store32(buf + 404, (2 << 16) | 248);  # OpLabel %17
    store32(buf + 408, 17);
    store32(buf + 412, (4 << 16) | 61);   # OpLoad %5 %18 %12
    store32(buf + 416, 5);
    store32(buf + 420, 18);
    store32(buf + 424, 12);
    store32(buf + 428, (5 << 16) | 81);   # OpCompositeExtract %4 %19 %18 0
    store32(buf + 432, 4);
    store32(buf + 436, 19);
    store32(buf + 440, 18);
    store32(buf + 444, 0);
    store32(buf + 448, (6 << 16) | 65);   # OpAccessChain %10 %20 %13 %16 %19
    store32(buf + 452, 10);
    store32(buf + 456, 20);
    store32(buf + 460, 13);
    store32(buf + 464, 16);
    store32(buf + 468, 19);
    store32(buf + 472, (4 << 16) | 61);   # OpLoad %3 %21 %20
    store32(buf + 476, 3);
    store32(buf + 480, 21);
    store32(buf + 484, 20);
    store32(buf + 488, (6 << 16) | 65);   # OpAccessChain %10 %22 %14 %16 %19
    store32(buf + 492, 10);
    store32(buf + 496, 22);
    store32(buf + 500, 14);
    store32(buf + 504, 16);
    store32(buf + 508, 19);
    store32(buf + 512, (4 << 16) | 61);   # OpLoad %3 %23 %22
    store32(buf + 516, 3);
    store32(buf + 520, 23);
    store32(buf + 524, 22);
    store32(buf + 528, (5 << 16) | 133);  # OpFMul %3 %24 %15 %21
    store32(buf + 532, 3);
    store32(buf + 536, 24);
    store32(buf + 540, 15);
    store32(buf + 544, 21);
    store32(buf + 548, (5 << 16) | 129);  # OpFAdd %3 %25 %24 %23
    store32(buf + 552, 3);
    store32(buf + 556, 25);
    store32(buf + 560, 24);
    store32(buf + 564, 23);
    store32(buf + 568, (3 << 16) | 62);   # OpStore %22 %25
    store32(buf + 572, 22);
    store32(buf + 576, 25);
    store32(buf + 580, (1 << 16) | 253);  # OpReturn
    store32(buf + 584, (1 << 16) | 56);   # OpFunctionEnd
    return 588;
}

fn _spv_saxpy_lower(buf, n, m, vals, instrs, ptrs, blocks): i64 {
    var types[640];
    var consts[448];
    var deco[448];
    var outbi[256];
    spirv_build_type_table(buf, n, 26, &types);
    spirv_build_const_table(buf, n, 26, &consts);
    spirv_build_decoration_table(buf, n, 26, &deco);
    mir_mod_init(m, vals, instrs, ptrs, blocks, 32, 8, 26, 30);
    return spirv_lower_module(buf, n, &types, &consts, &deco, m, &outbi);
}

fn test_spirv_lower_saxpy() {
    var buf[640];
    var m[80];
    var vals[1216];
    var instrs[1024];
    var ptrs[128];
    var blocks[32];
    var n = _spv_build_saxpy(&buf);
    assert_eq(spirv_validate_stream(&buf, n), 0, "saxpy valid");
    assert_eq(_spv_saxpy_lower(&buf, n, &m, &vals, &instrs, &ptrs, &blocks), 0, "saxpy lower ok");
    # seed: two bound buffers + the float const + the builtin
    assert_eq(mir_val_kind(&m, 13), MIR_VK_BUFVAR, "x is bufvar");
    assert_eq(mir_val_payload(&m, 13), 0, "x binding 0");
    assert_eq(mir_val_payload(&m, 14), 1, "y binding 1");
    assert_eq(mir_val_kind(&m, 15), MIR_VK_CONST, "a is const");
    assert_eq(mir_val_type(&m, 15), MIR_T_F32, "a is f32");
    # instruction stream
    assert_eq(mir_n_instrs(&m), 9, "9 instrs");
    assert_eq(mir_instr_op(&m, 0), MIR_OP_EXTRACT, "i0 extract gid.x");
    assert_eq(mir_instr_op(&m, 1), MIR_OP_IMUL, "i1 index*stride (x)");
    assert_eq(mir_instr_op(&m, 2), MIR_OP_LOAD, "i2 load x[i]");
    assert_eq(mir_instr_op(&m, 3), MIR_OP_IMUL, "i3 index*stride (y)");
    assert_eq(mir_instr_op(&m, 4), MIR_OP_LOAD, "i4 load y[i]");
    assert_eq(mir_instr_op(&m, 5), MIR_OP_FMUL, "i5 a*x");
    assert_eq(mir_instr_op(&m, 6), MIR_OP_FADD, "i6 +y");
    assert_eq(mir_instr_op(&m, 7), MIR_OP_STORE, "i7 store y[i]");
    assert_eq(mir_instr_op(&m, 8), MIR_OP_RET, "i8 ret");
    # the synth offset IMUL: result is a synth id (>= id_bound 26), a=i(19), b=4 imm
    assert_eq(mir_instr_result(&m, 1), 26, "offset uses synth id 26");
    assert_eq(mir_instr_a(&m, 1), 19, "offset = i (gid.x) * ...");
    assert_eq(mir_instr_b(&m, 1), 4, "stride 4 bytes (f32)");
    assert_eq(mir_instr_flags(&m, 1), MIR_FLAG_B_IMM, "stride is immediate");
    # the store carries the value %25 and references the y ptr
    assert_eq(mir_instr_result(&m, 7), 0, "store has no result");
    assert_eq(mir_instr_c(&m, 7), 25, "store value = %25");
    # ptr side-table
    assert_eq(mir_n_ptrs(&m), 2, "2 access-chain ptrs");
    assert_eq(mir_ptr_binding(&m, 0), 0, "ptr0 binding 0");
    assert_eq(mir_ptr_elem_type(&m, 0), MIR_T_F32, "ptr0 elem f32");
    assert_eq(mir_ptr_dynamic(&m, 0), 1, "ptr0 dynamic");
    assert_eq(mir_ptr_binding(&m, 1), 1, "ptr1 binding 1");
    assert_eq(mir_val_kind(&m, 20), MIR_VK_PTR, "%20 is a ptr");
    assert_eq(mir_val_payload(&m, 20), 0, "%20 -> ptr 0");
    # uniformity: GID-indexed loads + the arithmetic are all divergent
    assert_eq(mir_val_unif(&m, 19), MIR_DIVERGENT, "gid.x divergent");
    assert_eq(mir_val_unif(&m, 21), MIR_DIVERGENT, "x[i] load divergent");
    assert_eq(mir_val_unif(&m, 23), MIR_DIVERGENT, "y[i] load divergent");
    assert_eq(mir_val_unif(&m, 24), MIR_DIVERGENT, "a*x divergent");
    assert_eq(mir_val_unif(&m, 25), MIR_DIVERGENT, "a*x+y divergent");
    return 0;
}

fn test_spirv_lower_access_chain_variants() {
    var buf[640];
    var m[80];
    var vals[1216];
    var instrs[1024];
    var ptrs[128];
    var blocks[32];
    # constant array index -> folds to a const byte offset (dynamic 0, no IMUL)
    var n = _spv_build_saxpy(&buf);
    store32(&buf + 468, 16);   # first access chain array index %19 -> %16 (const 0)
    assert_eq(_spv_saxpy_lower(&buf, n, &m, &vals, &instrs, &ptrs, &blocks), 0, "const-index lower ok");
    assert_eq(mir_ptr_dynamic(&m, 0), 0, "const index -> not dynamic");
    assert_eq(mir_ptr_const_off(&m, 0), 0, "const index 0 -> offset 0");
    # integer const array index whose byte offset overflows i32 -> MIR_ERR_OVERFLOW.
    # Repoint %15 to the uint type so it is an integer const of value 0x40000000.
    _spv_build_saxpy(&buf);
    store32(&buf + 308, 4);    # %15 result-type float(%3) -> uint(%4)
    store32(&buf + 468, 15);   # array index -> %15 (uint 0x40000000; *4 overflows)
    assert_eq(_spv_saxpy_lower(&buf, n, &m, &vals, &instrs, &ptrs, &blocks),
    0 - MIR_ERR_OVERFLOW, "offset overflow");
    # non-integer (float) const array index -> BAD_ACCESS_CHAIN (review N.2b-2 #2:
    # the bits must not be reinterpreted as an index).
    _spv_build_saxpy(&buf);
    store32(&buf + 468, 15);   # array index -> %15 (float const, not an integer)
    assert_eq(_spv_saxpy_lower(&buf, n, &m, &vals, &instrs, &ptrs, &blocks),
    0 - MIR_ERR_BAD_ACCESS_CHAIN, "non-int index");
    # vector-element runtime array -> BAD_ACCESS_CHAIN (review N.2b-2 #1: scalar
    # element only; vec stride is a layout rule, not count*4).
    _spv_build_saxpy(&buf);
    store32(&buf + 256, 5);    # rtarray %7 element float(%3) -> uvec3(%5)
    store32(&buf + 300, 5);    # ptr %10 pointee float(%3) -> uvec3(%5)
    assert_eq(_spv_saxpy_lower(&buf, n, &m, &vals, &instrs, &ptrs, &blocks),
    0 - MIR_ERR_BAD_ACCESS_CHAIN, "vec element");
    # non-zero struct member index -> BAD_ACCESS_CHAIN (multi-member deferred)
    _spv_build_saxpy(&buf);
    store32(&buf + 464, 15);   # member index -> %15 (value != 0)
    assert_eq(_spv_saxpy_lower(&buf, n, &m, &vals, &instrs, &ptrs, &blocks),
    0 - MIR_ERR_BAD_ACCESS_CHAIN, "bad member");
    return 0;
}

# ================================================================
# Phase N.3 — instruction selection (gfx9_isel.cyr)
# ================================================================
# The SALU-vs-VALU op-selection table: integer ops pick the S_* form when the
# result is uniform and the V_* form when divergent; float ops are always VALU.
fn test_gfx9_isel_op_selection() {
    assert_eq(_gisel_int_op(MIR_OP_IADD, 0), GISEL_S_ADD_I32, "iadd uniform -> SALU");
    assert_eq(_gisel_int_op(MIR_OP_IADD, 1), GISEL_V_ADD_U32, "iadd divergent -> VALU");
    assert_eq(_gisel_int_op(MIR_OP_ISUB, 0), GISEL_S_SUB_I32, "isub uniform");
    assert_eq(_gisel_int_op(MIR_OP_IMUL, 0), GISEL_S_MUL_I32, "imul uniform");
    assert_eq(_gisel_int_op(MIR_OP_IMUL, 1), GISEL_V_MUL_LO_U32, "imul divergent");
    assert_eq(_gisel_int_op(MIR_OP_SHL, 0), GISEL_S_LSHL_B32, "shl uniform");
    assert_eq(_gisel_int_op(MIR_OP_SHL, 1), GISEL_V_LSHLREV_B32, "shl divergent");
    assert_eq(_gisel_int_op(MIR_OP_SHR, 1), GISEL_V_LSHRREV_B32, "shr divergent");
    assert_eq(_gisel_int_op(MIR_OP_AND, 0), GISEL_S_AND_B32, "and uniform");
    assert_eq(_gisel_int_op(MIR_OP_OR, 1), GISEL_V_OR_B32, "or divergent");
    assert_eq(_gisel_int_op(MIR_OP_XOR, 0), GISEL_S_XOR_B32, "xor uniform");
    assert_eq(_gisel_int_op(MIR_OP_FADD, 0), 0, "fadd is not an int op");
    assert_eq(_gisel_float_op(MIR_OP_FADD), GISEL_V_ADD_F32, "fadd -> VALU");
    assert_eq(_gisel_float_op(MIR_OP_FSUB), GISEL_V_SUB_F32, "fsub -> VALU");
    assert_eq(_gisel_float_op(MIR_OP_FMUL), GISEL_V_MUL_F32, "fmul -> VALU");
    assert_eq(_gisel_float_op(MIR_OP_FMA), GISEL_V_FMA_F32, "fma -> VALU");
    assert_eq(_gisel_float_op(MIR_OP_IADD), 0, "iadd is not a float op");
    return 0;
}

fn test_gfx9_isel_saxpy() {
    var buf[640];
    var m[80];
    var vals[1216];
    var instrs[1024];
    var ptrs[128];
    var blocks[32];
    var n = _spv_build_saxpy(&buf);
    assert_eq(_spv_saxpy_lower(&buf, n, &m, &vals, &instrs, &ptrs, &blocks), 0, "saxpy lower ok");
    var isel[480];
    var ic = gfx9_isel(&m, &isel, 10);
    assert_eq(ic, 9, "9 selected instrs");
    assert_eq(gisel_op(&isel, 0), GISEL_EXTRACT, "0 extract gid.x");
    assert_eq(gisel_op(&isel, 1), GISEL_V_MUL_LO_U32, "1 offset = i*4 (divergent -> VALU)");
    assert_eq(gisel_op(&isel, 2), GISEL_GLOBAL_LOAD, "2 load x[i]");
    assert_eq(gisel_op(&isel, 4), GISEL_GLOBAL_LOAD, "4 load y[i]");
    assert_eq(gisel_op(&isel, 5), GISEL_V_MUL_F32, "5 a*x (VALU)");
    assert_eq(gisel_op(&isel, 6), GISEL_V_ADD_F32, "6 +y (VALU)");
    assert_eq(gisel_op(&isel, 7), GISEL_GLOBAL_STORE, "7 store y[i]");
    assert_eq(gisel_op(&isel, 8), GISEL_S_ENDPGM, "8 endpgm");
    # load/store carry the ptr index (b) + the binding (flags bits 8+)
    assert_eq(gisel_b(&isel, 2), 0, "load x -> ptr 0");
    assert_eq((gisel_flags(&isel, 2) >> 8) & 0xFF, 0, "load x binding 0");
    assert_eq((gisel_flags(&isel, 4) >> 8) & 0xFF, 1, "load y binding 1");
    assert_eq(gisel_c(&isel, 7), 25, "store value = %25");
    assert_eq((gisel_flags(&isel, 7) >> 8) & 0xFF, 1, "store binding 1");
    return 0;
}

fn test_gfx9_isel_gid_salu_valu() {
    var buf[384];
    var types[384];
    var consts[256];
    var deco[256];
    var outbi[128];
    var m[80];
    var vals[640];
    var instrs[512];
    var ptrs[64];
    var blocks[32];
    var n = _spv_build_gid_kernel(&buf);
    spirv_build_type_table(&buf, n, 16, &types);
    spirv_build_const_table(&buf, n, 16, &consts);
    spirv_build_decoration_table(&buf, n, 16, &deco);
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 4, 16, 16);
    assert_eq(spirv_lower_module(&buf, n, &types, &consts, &deco, &m, &outbi), 0, "gid lower ok");
    var isel[256];
    var ic = gfx9_isel(&m, &isel, 5);
    assert_eq(ic, 5, "5 selected instrs");
    assert_eq(gisel_op(&isel, 0), GISEL_EXTRACT, "0 extract gid.x");
    assert_eq(gisel_op(&isel, 1), GISEL_V_ADD_U32, "1 x+1 divergent -> VALU");
    assert_eq(gisel_op(&isel, 2), GISEL_V_MUL_LO_U32, "2 *2 divergent -> VALU");
    assert_eq(gisel_op(&isel, 3), GISEL_S_LSHL_B32, "3 1<<2 uniform -> SALU");
    assert_eq(gisel_op(&isel, 4), GISEL_S_ENDPGM, "4 endpgm");
    return 0;
}

fn test_gfx9_isel_errors() {
    var m[80];
    var vals[640];
    var instrs[512];
    var ptrs[64];
    var blocks[32];
    var isel[256];
    # cap exceeded: a non-empty MIR with cap 0
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 2, 16, 16);
    mir_emit(&m, MIR_OP_RET, 0, MIR_T_VOID, 0, 0, 0, 0);
    assert_eq(gfx9_isel(&m, &isel, 0), 0 - GISEL_ERR_CAP_EXCEEDED, "cap exceeded");
    # unsupported MIR op (a fabricated op code) -> fail loud
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 2, 16, 16);
    mir_emit(&m, 99, 1, MIR_T_I32, 0, 0, 0, 0);
    assert_eq(gfx9_isel(&m, &isel, 8), 0 - GISEL_ERR_UNSUPPORTED_OP, "unsupported op");
    # review N.3 #1: a result-less integer ALU op (dst 0) must fail loud, not
    # read the vals[0] sentinel and silently pick SALU.
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 2, 16, 16);
    mir_emit(&m, MIR_OP_IADD, 0, MIR_T_I32, 0, 0, 0, 0);
    assert_eq(gfx9_isel(&m, &isel, 8), 0 - GISEL_ERR_UNSUPPORTED_OP, "result-less int op");
    # review N.3 #2: an UNKNOWN-uniformity result (no mir_run_uniformity) must
    # fail loud, not silently pick SALU for a possibly-divergent value.
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 16, 2, 16, 16);
    mir_emit(&m, MIR_OP_IADD, 5, MIR_T_I32, 1, 2, 0, 0);
    assert_eq(gfx9_isel(&m, &isel, 8), 0 - GISEL_ERR_UNSUPPORTED_OP, "UNKNOWN unif");
    return 0;
}

fn main(): i64 {
    test_gfx9_operand_helpers();
    test_gfx9_enc_vop1();
    test_gfx9_enc_vop2();
    test_gfx9_enc_vop3a();
    test_gfx9_enc_sop2();
    test_gfx9_enc_sopp();
    test_gfx9_enc_smem();
    test_gfx9_enc_flat();
    test_gfx9_rebuild_store_deadbeef_byte_identical();
    test_spirv_header_accessors();
    test_spirv_op_decode();
    test_spirv_validate_stream_valid();
    test_spirv_validate_stream_rejects();
    test_spirv_count_instructions();
    test_spirv_find_entry_point();
    test_spirv_find_local_size();
    test_spirv_type_table();
    test_spirv_const_table();
    test_spirv_decoration_table();
    test_mir_type_distill();
    test_mir_type_helpers();
    test_mir_meet_truth_table();
    test_mir_builtin_unif();
    test_mir_value_builders();
    test_mir_emit_and_accessors();
    test_mir_add_ptr();
    test_mir_uniformity();
    test_mir_blocks_and_synth();
    test_mir_emit_errors();
    test_mir_review_n2a();
    test_spirv_lower_gid_kernel();
    test_spirv_lower_seed_bufvar();
    test_spirv_lower_negatives();
    test_spirv_lower_n2b1_review();
    test_spirv_lower_saxpy();
    test_spirv_lower_access_chain_variants();
    test_gfx9_isel_op_selection();
    test_gfx9_isel_saxpy();
    test_gfx9_isel_gid_salu_valu();
    test_gfx9_isel_errors();
    return assert_summary();
}
