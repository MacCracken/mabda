    var expected = native_ioc_encode(3, DRM_NOUVEAU_VM_BIND_SIZE, DRM_IOCTL_TYPE,
    DRM_COMMAND_BASE + 0x11);
    assert_eq(DRM_IOCTL_NOUVEAU_VM_BIND, expected, "VM_BIND ioctl = 0xC0286451");
    assert_eq(DRM_IOCTL_NOUVEAU_VM_BIND, 0xC0286451, "VM_BIND precomputed");
    assert_eq(DRM_NOUVEAU_VM_BIND_SIZE, 40, "vm_bind struct = 40 bytes");
