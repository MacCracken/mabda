    assert_eq(DRM_IOCTL_NOUVEAU_CHANNEL_ALLOC, 0xC0586442, "CHANNEL_ALLOC precomputed");
    assert_eq(DRM_NOUVEAU_CHANNEL_ALLOC_SIZE, 88, "channel_alloc struct = 88 bytes");
    return 0;
}

