fn test_nv_channel_engine_constants() {
    assert_eq(NOUVEAU_FIFO_ENGINE_GR, 0x01, "GR engine = 0x01 (compute)");
    assert_eq(NOUVEAU_FIFO_ENGINE_CE, 0x30, "CE engine = 0x30 (copy)");
    assert_eq(DRM_NOUVEAU_VM_BIND_OP_MAP, 0x0, "VM_BIND MAP = 0");
    assert_eq(DRM_NOUVEAU_VM_BIND_OP_UNMAP, 0x1, "VM_BIND UNMAP = 1");
    # Safe UMD VA: 64 KiB-aligned, non-null, below the 1<<39 kernel split.
    assert_eq(NOUVEAU_UMD_VA_BASE, 0x10000, "UMD VA base = 64 KiB");
    assert_eq(NOUVEAU_UMD_VA_BASE & 0xFFFF, 0, "UMD VA base is 64 KiB-aligned");
    return 0;
}

fn test_nv_channel_id_accessor() {
    # channel (chid) reads back from offset +8 of the alloc struct.
    var req[88];
    memset(&req, 0, 88);
    store32(&req + 8, 0x2A);   # simulate kernel-returned chid
    assert_eq(native_nv_channel_id(&req), 0x2A, "chid accessor reads +8");
    return 0;
}

fn test_nv_vm_bind_op_layout() {
    # Mirror native_nv_vm_bind_map's op packing; assert byte offsets.
    var op[40];
    memset(&op, 0, 40);
    store32(&op + 0, DRM_NOUVEAU_VM_BIND_OP_MAP);
    store32(&op + 8, 0x55);          # handle
    store64(&op + 16, NOUVEAU_UMD_VA_BASE);
    store64(&op + 32, 0x1000);       # range
    assert_eq(load32(&op + 0), 0, "op = MAP at +0");
    assert_eq(load32(&op + 8), 0x55, "handle at +8");
    assert_eq(load64(&op + 16), 0x10000, "addr at +16");
    assert_eq(load64(&op + 32), 0x1000, "range at +32");
    return 0;
}

fn test_nv_sync_build() {
    var buf[16];
    memset(&buf, 0, 16);
    native_nv_sync_build(&buf, 0x9);
    assert_eq(load32(&buf + 0), DRM_NOUVEAU_SYNC_SYNCOBJ, "sync flags = SYNCOBJ at +0");
    assert_eq(load32(&buf + 4), 0x9, "sync handle at +4");
    assert_eq(load64(&buf + 8), 0, "timeline_value at +8");
    assert_eq(DRM_NOUVEAU_SYNC_SIZE, 16, "drm_nouveau_sync = 16 bytes");
    return 0;
}

fn test_nv_sass_store_deadbeef() {
    # Embedded SM75 SASS (captured + nvdisasm-verified): counts, launch
    # ABI for the N4.2 QMD, and byte-exact key dwords.
    assert_eq(NV_SASS_STORE_DEADBEEF_BYTES, 128, "SASS = 128 bytes");
    assert_eq(NV_SASS_STORE_DEADBEEF_DWORDS, 16, "SASS = 16 u64 dwords");
    assert_eq(NV_SASS_STORE_DEADBEEF_REGCOUNT, 4, "regcount = 4 (N4.2 QMD)");
    assert_eq(NV_SASS_STORE_DEADBEEF_SHMEM, 0, "shared mem = 0");
    assert_eq(NV_SASS_STORE_DEADBEEF_PARAM_OFF, 0x160, "output ptr at c[0x0][0x160]");
    assert_eq(NV_SASS_STORE_DEADBEEF_PARAM_SIZE, 8, "param = one u64 ptr");

    # Materialize the program; check byte-exact at key offsets.
    var prog[128];
    memset(&prog, 0, 128);
    var n = native_nv_sass_store_deadbeef(&prog);
    assert_eq(n, 128, "writes 128 bytes");
    assert_eq(load64(&prog + 0), 0x00000a0000017a02, "first instr: MOV R1, c[0x0][0x28]");
    assert_eq(load64(&prog + 16), 0xdeadbeef00007802, "MOV R0, 0xdeadbeef dword");
    assert_eq(load64(&prog + 48), 0x00000000ff007986, "STG.E [UR4], R0 opcode dword");
    assert_eq(load64(&prog + 56), 0x000fe2000c114904, "STG control word = GPU scope (.STRONG.GPU, not .SYS)");
    assert_eq(load64(&prog + 64), 0x000000000000794d, "EXIT dword");
    return 0;
}

fn test_nv_method_header_golden() {
    # Golden vectors read directly from the NVK dispatch pushbuffer (N0.7c).
    assert_eq(native_nv_method_header(NV_OP_INCR, 1, NVC5C0_SEND_PCAS_A, 1), 0x200120AD,
    "SEND_PCAS_A header == capture [12]");
    assert_eq(native_nv_method_inline(1, NVC5C0_SEND_SIGNALING_PCAS_B, 3), 0x800320AF,
    "SEND_SIGNALING_PCAS_B inline == capture [14]");
    assert_eq(native_nv_method_header(NV_OP_INCR, 1, NVC5C0_SET_OBJECT, 1), 0x20012000,
    "SET_OBJECT header");
    return 0;
}

fn test_nv_push_dispatch() {
    var buf[64];
    memset(&buf, 0, 64);
    var n = native_nv_push_dispatch(&buf, 0x3ffdf5c800);   # the capture's qmd_va
    assert_eq(n, 44, "dispatch push = 44 bytes (11 dwords)");
    assert_eq(load32(&buf + 0), 0x20012000, "SET_OBJECT header");
    assert_eq(load32(&buf + 4), 0xC5C0, "compute class arg");
    assert_eq(load32(&buf + 8), 0x200220A8, "SHARED_MEMORY_WINDOW header (0x02a0 cnt2)");
    assert_eq(load32(&buf + 12), 0, "shared window arg0");
    assert_eq(load32(&buf + 16), 0xFE000000, "shared window base (== capture)");
    assert_eq(load32(&buf + 20), 0x200221EC, "LOCAL_MEMORY_WINDOW header (0x07b0 cnt2)");
    assert_eq(load32(&buf + 24), 0, "local window arg0");
    assert_eq(load32(&buf + 28), 0xFF000000, "local window base (== capture)");
    assert_eq(load32(&buf + 32), 0x200120AD, "SEND_PCAS_A header");
    assert_eq(load32(&buf + 36), 0x3ffdf5c8, "qmd_va>>8 (== capture arg)");
    assert_eq(load32(&buf + 40), 0x800320AF, "SEND_SIGNALING_PCAS_B inline");
    return 0;
}

fn test_nv_object_handle() {
    # NVK idiom (0xbeef+chid)<<16 | (oclass&0xff); capture chid9 -> 0xbef800c0.
    assert_eq(native_nv_object_handle(9, TURING_COMPUTE_A), 0xbef800c0, "NVIF handle chid9/0xc5c0");
    return 0;
}

fn test_nv_exec_nvif_ioctl_encoding() {
    var ex = native_ioc_encode(3, DRM_NOUVEAU_EXEC_SIZE, DRM_IOCTL_TYPE, DRM_COMMAND_BASE + 0x12);
    assert_eq(DRM_IOCTL_NOUVEAU_EXEC, ex, "EXEC ioctl = 0xC0286452");
    assert_eq(DRM_IOCTL_NOUVEAU_EXEC, 0xC0286452, "EXEC precomputed constant");
    assert_eq(DRM_NOUVEAU_EXEC_SIZE, 40, "exec struct = 40 bytes");
    # NVIF is size-dependent; a 56-byte NEW payload.
    var nvif56 = native_ioc_encode(3, 56, DRM_IOCTL_TYPE, DRM_COMMAND_BASE + 0x07);
    assert_eq(nvif56, 0xC0386447, "NVIF(56) ioctl = 0xC0386447");
    return 0;
}

fn test_nv_qmd_build() {
    # Build with the golden's VAs so the fixed fields are directly comparable
    # to the captured QMD; per-kernel fields use our ptxas regcount=4.
    var qmd[256];
    native_nv_qmd_build(&qmd, 0x3ffdf9c780, 4, 0x3ffdf5c000, 0x200);
    assert_eq(NV_QMD_SIZE, 256, "QMD = 256 bytes");
    # Golden-verified fixed config fields.
    assert_eq(load32(&qmd + 0x10), 0x40, "SM_GLOBAL_CACHING (== golden)");
    assert_eq(load32(&qmd + 0x2c), 0x04000000, "API_VISIBLE_CALL_LIMIT (== golden)");
    assert_eq(load32(&qmd + 0x30), 1, "grid X");
    assert_eq(load32(&qmd + 0x34), 1, "grid Y");
    assert_eq(load32(&qmd + 0x38), 1, "grid Z");
    assert_eq(load32(&qmd + 0x44), 0x22240000, "shared-mem config (== golden)");
    assert_eq(load32(&qmd + 0x48), 0x00010022, "ver 2.2 + blockX (== golden)");
    assert_eq(load32(&qmd + 0x4c), 0x00010001, "blockY/Z (== golden)");
    # dw20: VALID[0]=1 | REGISTER_COUNT_V=4 | TARGET_SM_CONFIG=9.
    assert_eq(load32(&qmd + 0x50), 0x00120401, "valid0|regcount_v=4|target=9");
    # CONSTANT_BUFFER[0]: addr lo/hi + SIZE_SHIFTED4 (0x200/16 = 0x20).
    assert_eq(load32(&qmd + 0x80), 0xfdf5c000, "cbuf0 addr lo");
    assert_eq(load32(&qmd + 0x84), 0x0100003f, "cbuf0 addr hi + size_sh4=0x20");
    # PROGRAM_ADDRESS unshifted lo/hi.
    assert_eq(load32(&qmd + 0xc0), 0xfdf9c780, "program addr lo");
    assert_eq(load32(&qmd + 0xc4), 0x3f, "program addr hi");
    # SASS_VERSION / legacy REGISTER_COUNT / local mem stay 0.
    assert_eq(load32(&qmd + 0x78), 0, "legacy REGISTER_COUNT + local-mem-high = 0");
    assert_eq(load32(&qmd + 0x7c), 0, "SASS_VERSION + prefetch = 0");
    return 0;
}

fn test_nv_backend_kind_reserved() {
    # Punchlist N0.8: NVIDIA kind reserved up front, no struct change.
    assert_eq(BACKEND_KIND_NVIDIA, 3, "BACKEND_KIND_NVIDIA == 3");
    # kind is a u64 value (not a fnptr) at slot offset +80.
    var b = backend_new();
    backend_set_kind(b, BACKEND_KIND_NVIDIA);
    assert_eq(load64(b + 80), BACKEND_KIND_NVIDIA, "kind stored at slot +80");
    assert_eq(backend_kind(b), BACKEND_KIND_NVIDIA, "backend_kind() reads +80");
    return 0;
}

# N4.7 — backend_nvidia_new() fills the v0 slot block (0..80) + kind, and the
# NVIDIA GpuContext / buffer / shmod field maps are pinned. backend_is_complete
# stays honest: v0-filled but texture range (88..) still zero -> reports
# incomplete (by design until N6/N7/N8). No HW — pure slot-table + layout.
fn test_nv_backend_v0_slots() {
    # SASS shader-source tag (Phase N5), distinct from GFX9.
    assert_eq(SHADER_SRC_SASS, 3, "SHADER_SRC_SASS == 3");

    var b = backend_nvidia_new();
    # Every v0 fnptr slot (0..80, step 8) must be non-zero.
    var off = 0;
    while (off < BACKEND_FNPTR_SLOTS_END) {
        assert_neq(backend_get_slot(b, off), 0, "nvidia v0 slot filled");
        off = off + 8;
    }
    # kind at +80.
    assert_eq(backend_kind(b), BACKEND_KIND_NVIDIA, "nvidia_new kind == NVIDIA");
    # Honest completeness: v0 filled, texture+ ranges still zero -> incomplete.
    assert_eq(backend_is_complete(b), 0, "nvidia backend incomplete past v0 (honest)");
    # Specific load-bearing slots resolve to the NVIDIA impls.
    assert_neq(backend_get_slot(b, BACKEND_SLOT_COMPUTE_DISPATCH), 0, "dispatch slot set");
    assert_neq(backend_get_slot(b, BACKEND_SLOT_BUFFER_CREATE), 0, "buffer_create slot set");
    assert_neq(backend_get_slot(b, BACKEND_SLOT_SHADER_MODULE_CREATE), 0, "shader_create slot set");

    # NVIDIA GpuContext field map: the Backend* MUST live at +32 (the only
    # cross-backend-fixed field, read by gpu_ctx_backend).
    assert_eq(NV_CTX_BACKEND, 32, "nvidia ctx backend at +32 (canonical)");
    assert_eq(NV_CTX_FD, 0, "nvidia ctx fd at +0");
    assert_eq(NV_CTX_CHID, 8, "nvidia ctx chid at +8");
    # The whole NVIDIA ctx field map fits the 176-byte GpuContext blob.
    assert_eq(NV_CTX_PARAM_ADDR < GPU_CONTEXT_SIZE, 1, "nvidia ctx fields fit GpuContext");

    # Buffer / shmod struct shapes — bp's VA is read at +8 by the dispatch.
    assert_eq(NV_BUF_VA, 8, "nvidia buf VA at +8 (bp output ptr)");
    assert_eq(NV_BUF_STRUCT_SIZE, 32, "nvidia buf struct = 32 bytes");
    assert_eq(NV_SHMOD_VA, 8, "nvidia shmod program VA at +8");
    assert_eq(NV_SHMOD_REGCOUNT, 24, "nvidia shmod regcount at +24");
    return 0;
}

fn main() {
    alloc_init();
    test_nv_getparam_ioctl_encoding();
    test_nv_vm_init_ioctl_encoding();
    test_nv_getparam_param_ids();
    test_nv_tu116_identity();
    test_nv_vm_init_kernel_split();
    test_nv_driver_name_check();
    test_nv_masterless_verdict();
    test_nv_gem_new_ioctl_encoding();
    test_nv_gem_info_ioctl_encoding();
    test_nv_gem_domain_flags();
    test_nv_gem_new_struct_layout();
    test_nv_gem_info_struct_layout();
    test_nv_channel_alloc_ioctl_encoding();
    test_nv_vm_bind_ioctl_encoding();
    test_nv_channel_free_ioctl_encoding();
    test_nv_channel_engine_constants();
    test_nv_channel_id_accessor();
    test_nv_vm_bind_op_layout();
    test_nv_sync_build();
    test_nv_sass_store_deadbeef();
    test_nv_method_header_golden();
    test_nv_push_dispatch();
    test_nv_object_handle();
    test_nv_exec_nvif_ioctl_encoding();
    test_nv_qmd_build();
    test_nv_backend_kind_reserved();
    test_nv_backend_v0_slots();
    return assert_summary();
}
