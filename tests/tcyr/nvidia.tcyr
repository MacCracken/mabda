fn test_nv_channel_engine_constants() {
    assert_eq(NOUVEAU_FIFO_ENGINE_GR, 0x01, "GR engine = 0x01 (compute)");
    assert_eq(NOUVEAU_FIFO_ENGINE_CE, 0x30, "CE engine = 0x30 (copy)");
    assert_eq(DRM_NOUVEAU_VM_BIND_OP_MAP, 0x0, "VM_BIND MAP = 0");
    assert_eq(DRM_NOUVEAU_VM_BIND_OP_UNMAP, 0x1, "VM_BIND UNMAP = 1");
    # Safe UMD VA: 64 KiB-aligned, non-null, below the 1<<39 kernel split.
    assert_eq(NOUVEAU_UMD_VA_BASE, 0x10000, "UMD VA base = 64 KiB");
    assert_eq(NOUVEAU_UMD_VA_BASE & 0xFFFF, 0, "UMD VA base is 64 KiB-aligned");
    return 0;
}

fn test_nv_channel_id_accessor() {
    # channel (chid) reads back from offset +8 of the alloc struct.
    var req[88];
    memset(&req, 0, 88);
    store32(&req + 8, 0x2A);   # simulate kernel-returned chid
    assert_eq(native_nv_channel_id(&req), 0x2A, "chid accessor reads +8");
    return 0;
}

fn test_nv_vm_bind_op_layout() {
    # Mirror native_nv_vm_bind_map's op packing; assert byte offsets.
    var op[40];
    memset(&op, 0, 40);
    store32(&op + 0, DRM_NOUVEAU_VM_BIND_OP_MAP);
    store32(&op + 8, 0x55);          # handle
    store64(&op + 16, NOUVEAU_UMD_VA_BASE);
    store64(&op + 32, 0x1000);       # range
    assert_eq(load32(&op + 0), 0, "op = MAP at +0");
    assert_eq(load32(&op + 8), 0x55, "handle at +8");
    assert_eq(load64(&op + 16), 0x10000, "addr at +16");
    assert_eq(load64(&op + 32), 0x1000, "range at +32");
    return 0;
}

fn test_nv_sync_build() {
    var buf[16];
    memset(&buf, 0, 16);
    native_nv_sync_build(&buf, 0x9);
    assert_eq(load32(&buf + 0), DRM_NOUVEAU_SYNC_SYNCOBJ, "sync flags = SYNCOBJ at +0");
    assert_eq(load32(&buf + 4), 0x9, "sync handle at +4");
    assert_eq(load64(&buf + 8), 0, "timeline_value at +8");
    assert_eq(DRM_NOUVEAU_SYNC_SIZE, 16, "drm_nouveau_sync = 16 bytes");
    return 0;
}

fn test_nv_sass_store_deadbeef() {
    # Embedded SM75 SASS (captured + nvdisasm-verified): counts, launch
    # ABI for the N4.2 QMD, and byte-exact key dwords.
    assert_eq(NV_SASS_STORE_DEADBEEF_BYTES, 128, "SASS = 128 bytes");
    assert_eq(NV_SASS_STORE_DEADBEEF_DWORDS, 16, "SASS = 16 u64 dwords");
    assert_eq(NV_SASS_STORE_DEADBEEF_REGCOUNT, 4, "regcount = 4 (N4.2 QMD)");
    assert_eq(NV_SASS_STORE_DEADBEEF_SHMEM, 0, "shared mem = 0");
    assert_eq(NV_SASS_STORE_DEADBEEF_PARAM_OFF, 0x160, "output ptr at c[0x0][0x160]");
    assert_eq(NV_SASS_STORE_DEADBEEF_PARAM_SIZE, 8, "param = one u64 ptr");

    # Materialize the program; check byte-exact at key offsets.
    var prog[128];
    memset(&prog, 0, 128);
    var n = native_nv_sass_store_deadbeef(&prog);
    assert_eq(n, 128, "writes 128 bytes");
    assert_eq(load64(&prog + 0), 0x00000a0000017a02, "first instr: MOV R1, c[0x0][0x28]");
    assert_eq(load64(&prog + 16), 0xdeadbeef00007802, "MOV R0, 0xdeadbeef dword");
    assert_eq(load64(&prog + 48), 0x00000000ff007986, "STG.E [UR4], R0 opcode dword");
    assert_eq(load64(&prog + 56), 0x000fe2000c114904, "STG control word = GPU scope (.STRONG.GPU, not .SYS)");
    assert_eq(load64(&prog + 64), 0x000000000000794d, "EXIT dword");
    return 0;
}

fn test_nv_method_header_golden() {
    # Golden vectors read directly from the NVK dispatch pushbuffer (N0.7c).
    assert_eq(native_nv_method_header(NV_OP_INCR, 1, NVC5C0_SEND_PCAS_A, 1), 0x200120AD,
    "SEND_PCAS_A header == capture [12]");
    assert_eq(native_nv_method_inline(1, NVC5C0_SEND_SIGNALING_PCAS_B, 3), 0x800320AF,
    "SEND_SIGNALING_PCAS_B inline == capture [14]");
    assert_eq(native_nv_method_header(NV_OP_INCR, 1, NVC5C0_SET_OBJECT, 1), 0x20012000,
    "SET_OBJECT header");
    return 0;
}

fn test_nv_push_dispatch() {
    var buf[64];
    memset(&buf, 0, 64);
    var n = native_nv_push_dispatch(&buf, 0x3ffdf5c800);   # the capture's qmd_va
    assert_eq(n, 44, "dispatch push = 44 bytes (11 dwords)");
    assert_eq(load32(&buf + 0), 0x20012000, "SET_OBJECT header");
    assert_eq(load32(&buf + 4), 0xC5C0, "compute class arg");
    assert_eq(load32(&buf + 8), 0x200220A8, "SHARED_MEMORY_WINDOW header (0x02a0 cnt2)");
    assert_eq(load32(&buf + 12), 0, "shared window arg0");
    assert_eq(load32(&buf + 16), 0xFE000000, "shared window base (== capture)");
    assert_eq(load32(&buf + 20), 0x200221EC, "LOCAL_MEMORY_WINDOW header (0x07b0 cnt2)");
    assert_eq(load32(&buf + 24), 0, "local window arg0");
    assert_eq(load32(&buf + 28), 0xFF000000, "local window base (== capture)");
    assert_eq(load32(&buf + 32), 0x200120AD, "SEND_PCAS_A header");
    assert_eq(load32(&buf + 36), 0x3ffdf5c8, "qmd_va>>8 (== capture arg)");
    assert_eq(load32(&buf + 40), 0x800320AF, "SEND_SIGNALING_PCAS_B inline");
    return 0;
}

fn test_nv_object_handle() {
    # NVK idiom (0xbeef+chid)<<16 | (oclass&0xff); capture chid9 -> 0xbef800c0.
    assert_eq(native_nv_object_handle(9, TURING_COMPUTE_A), 0xbef800c0, "NVIF handle chid9/0xc5c0");
    return 0;
}

fn test_nv_exec_nvif_ioctl_encoding() {
    var ex = native_ioc_encode(3, DRM_NOUVEAU_EXEC_SIZE, DRM_IOCTL_TYPE, DRM_COMMAND_BASE + 0x12);
    assert_eq(DRM_IOCTL_NOUVEAU_EXEC, ex, "EXEC ioctl = 0xC0286452");
    assert_eq(DRM_IOCTL_NOUVEAU_EXEC, 0xC0286452, "EXEC precomputed constant");
    assert_eq(DRM_NOUVEAU_EXEC_SIZE, 40, "exec struct = 40 bytes");
    # NVIF is size-dependent; a 56-byte NEW payload.
    var nvif56 = native_ioc_encode(3, 56, DRM_IOCTL_TYPE, DRM_COMMAND_BASE + 0x07);
    assert_eq(nvif56, 0xC0386447, "NVIF(56) ioctl = 0xC0386447");
    return 0;
}

fn test_nv_qmd_build() {
    # Build with the golden's VAs so the fixed fields are directly comparable
    # to the captured QMD; per-kernel fields use our ptxas regcount=4.
    var qmd[256];
    native_nv_qmd_build(&qmd, 0x3ffdf9c780, 4, 0x3ffdf5c000, 0x200);
    assert_eq(NV_QMD_SIZE, 256, "QMD = 256 bytes");
    # Golden-verified fixed config fields.
    assert_eq(load32(&qmd + 0x10), 0x40, "SM_GLOBAL_CACHING (== golden)");
    assert_eq(load32(&qmd + 0x2c), 0x04000000, "API_VISIBLE_CALL_LIMIT (== golden)");
    assert_eq(load32(&qmd + 0x30), 1, "grid X");
    assert_eq(load32(&qmd + 0x34), 1, "grid Y");
    assert_eq(load32(&qmd + 0x38), 1, "grid Z");
    assert_eq(load32(&qmd + 0x44), 0x22240000, "shared-mem config (== golden)");
    assert_eq(load32(&qmd + 0x48), 0x00010022, "ver 2.2 + blockX (== golden)");
    assert_eq(load32(&qmd + 0x4c), 0x00010001, "blockY/Z (== golden)");
    # dw20: VALID[0]=1 | REGISTER_COUNT_V=4 | TARGET_SM_CONFIG=9.
    assert_eq(load32(&qmd + 0x50), 0x00120401, "valid0|regcount_v=4|target=9");
    # CONSTANT_BUFFER[0]: addr lo/hi + SIZE_SHIFTED4 (0x200/16 = 0x20).
    assert_eq(load32(&qmd + 0x80), 0xfdf5c000, "cbuf0 addr lo");
    assert_eq(load32(&qmd + 0x84), 0x0100003f, "cbuf0 addr hi + size_sh4=0x20");
    # PROGRAM_ADDRESS unshifted lo/hi.
    assert_eq(load32(&qmd + 0xc0), 0xfdf9c780, "program addr lo");
    assert_eq(load32(&qmd + 0xc4), 0x3f, "program addr hi");
    # SASS_VERSION / legacy REGISTER_COUNT / local mem stay 0.
    assert_eq(load32(&qmd + 0x78), 0, "legacy REGISTER_COUNT + local-mem-high = 0");
    assert_eq(load32(&qmd + 0x7c), 0, "SASS_VERSION + prefetch = 0");
    return 0;
}

fn test_nv_backend_kind_reserved() {
    # Punchlist N0.8: NVIDIA kind reserved up front, no struct change.
    assert_eq(BACKEND_KIND_NVIDIA, 3, "BACKEND_KIND_NVIDIA == 3");
    # kind is a u64 value (not a fnptr) at slot offset +80.
    var b = backend_new();
    backend_set_kind(b, BACKEND_KIND_NVIDIA);
    assert_eq(load64(b + 80), BACKEND_KIND_NVIDIA, "kind stored at slot +80");
    assert_eq(backend_kind(b), BACKEND_KIND_NVIDIA, "backend_kind() reads +80");
    return 0;
}

# N4.7 — backend_nvidia_new() fills the v0 slot block (0..80) + kind, and the
# NVIDIA GpuContext / buffer / shmod field maps are pinned. backend_is_complete
# stays honest: v0-filled but texture range (88..) still zero -> reports
# incomplete (by design until N6/N7/N8). No HW — pure slot-table + layout.
fn test_nv_backend_v0_slots() {
    # SASS shader-source tag (Phase N5), distinct from GFX9.
    assert_eq(SHADER_SRC_SASS, 3, "SHADER_SRC_SASS == 3");

    var b = backend_nvidia_new();
    # Every v0 fnptr slot (0..80, step 8) must be non-zero.
    var off = 0;
    while (off < BACKEND_FNPTR_SLOTS_END) {
        assert_neq(backend_get_slot(b, off), 0, "nvidia v0 slot filled");
        off = off + 8;
    }
    # kind at +80.
    assert_eq(backend_kind(b), BACKEND_KIND_NVIDIA, "nvidia_new kind == NVIDIA");
    # Honest completeness: v0 filled, texture+ ranges still zero -> incomplete.
    assert_eq(backend_is_complete(b), 0, "nvidia backend incomplete past v0 (honest)");
    # Specific load-bearing slots resolve to the NVIDIA impls.
    assert_neq(backend_get_slot(b, BACKEND_SLOT_COMPUTE_DISPATCH), 0, "dispatch slot set");
    assert_neq(backend_get_slot(b, BACKEND_SLOT_BUFFER_CREATE), 0, "buffer_create slot set");
    assert_neq(backend_get_slot(b, BACKEND_SLOT_SHADER_MODULE_CREATE), 0, "shader_create slot set");

    # NVIDIA GpuContext field map: the Backend* MUST live at +32 (the only
    # cross-backend-fixed field, read by gpu_ctx_backend).
    assert_eq(NV_CTX_BACKEND, 32, "nvidia ctx backend at +32 (canonical)");
    assert_eq(NV_CTX_FD, 0, "nvidia ctx fd at +0");
    assert_eq(NV_CTX_CHID, 8, "nvidia ctx chid at +8");
    # The whole NVIDIA ctx field map fits the 176-byte GpuContext blob.
    assert_eq(NV_CTX_PARAM_ADDR < GPU_CONTEXT_SIZE, 1, "nvidia ctx fields fit GpuContext");

    # Buffer / shmod struct shapes — bp's VA is read at +8 by the dispatch.
    assert_eq(NV_BUF_VA, 8, "nvidia buf VA at +8 (bp output ptr)");
    assert_eq(NV_BUF_STRUCT_SIZE, 32, "nvidia buf struct = 32 bytes");
    assert_eq(NV_SHMOD_VA, 8, "nvidia shmod program VA at +8");
    assert_eq(NV_SHMOD_REGCOUNT, 24, "nvidia shmod regcount at +24");
    return 0;
}

# N6 — backend_nvidia_new() also fills the v1 texture slot block (88..120):
# host-visible linear RGBA8 create/write/read/release. backend_is_complete
# stays honest: v0 + texture filled but render range (120..) still zero ->
# reports incomplete. No HW — slot-table + texture field map.
fn test_nv_backend_v1_texture_slots() {
    var b = backend_nvidia_new();
    # Every v1 texture fnptr slot (88..120, step 8) must be non-zero.
    var off = BACKEND_TEXTURE_SLOTS_BEGIN;
    while (off < BACKEND_TEXTURE_SLOTS_END) {
        assert_neq(backend_get_slot(b, off), 0, "nvidia v1 texture slot filled");
        off = off + 8;
    }
    assert_neq(backend_get_slot(b, BACKEND_SLOT_TEXTURE_CREATE_2D_RGBA8), 0, "tex create slot set");
    assert_neq(backend_get_slot(b, BACKEND_SLOT_TEXTURE_WRITE), 0, "tex write slot set");
    assert_neq(backend_get_slot(b, BACKEND_SLOT_TEXTURE_READ), 0, "tex read slot set");
    assert_neq(backend_get_slot(b, BACKEND_SLOT_TEXTURE_RELEASE), 0, "tex release slot set");
    # Honest: render range (120..176) still zero -> incomplete past textures.
    assert_eq(backend_is_complete(b), 0, "nvidia incomplete past textures (honest)");

    # NV_TEX field map (the NativeTexture shape).
    assert_eq(NV_TEX_VA, 8, "nvidia tex VA at +8");
    assert_eq(NV_TEX_SIZE, 24, "nvidia tex logical size at +24");
    assert_eq(NV_TEX_WIDTH, 32, "nvidia tex width at +32");
    assert_eq(NV_TEX_HEIGHT, 36, "nvidia tex height at +36");
    assert_eq(NV_TEX_STRUCT_SIZE, 48, "nvidia tex struct = 48 bytes");
    assert_eq(MABDA_TEXFMT_RGBA8, 0, "RGBA8 fmt tag == 0");
    return 0;
}

# N7.1 — backend_nvidia_new() also fills the first two v2 render slots
# (render_target create @120 / release @128). The pipeline/pass/draw slots
# (136..168) are still zero (N7.2/3/4), so backend_is_complete stays honestly
# incomplete past the RT slots. No HW — slot-table + RT field map.
fn test_nv_backend_v2_render_slots() {
    var b = backend_nvidia_new();
    assert_neq(backend_get_slot(b, BACKEND_SLOT_RENDER_TARGET_CREATE_2D_RGBA8), 0,
    "nvidia RT create slot @120 filled");
    assert_neq(backend_get_slot(b, BACKEND_SLOT_RENDER_TARGET_RELEASE), 0,
    "nvidia RT release slot @128 filled");
    # The rest of the render range is intentionally still zero (honest).
    assert_eq(backend_get_slot(b, BACKEND_SLOT_RENDER_PIPELINE_CREATE), 0,
    "nvidia pipeline_create @136 still zero (N7.2)");
    assert_eq(backend_get_slot(b, BACKEND_SLOT_RENDER_PASS_DRAW), 0,
    "nvidia pass_draw @160 still zero (N7.4)");
    assert_eq(backend_is_complete(b), 0, "nvidia incomplete past RT slots (honest)");

    # NV_RT field map (the AMD NATIVE_RT shape — handle/va/addr/size/w/h, no fmt).
    assert_eq(NV_RT_HANDLE, 0, "nvidia RT handle at +0");
    assert_eq(NV_RT_VA, 8, "nvidia RT VA at +8");
    assert_eq(NV_RT_ADDR, 16, "nvidia RT addr at +16");
    assert_eq(NV_RT_SIZE, 24, "nvidia RT logical size at +24");
    assert_eq(NV_RT_WIDTH, 32, "nvidia RT width at +32");
    assert_eq(NV_RT_HEIGHT, 36, "nvidia RT height at +36");
    assert_eq(NV_RT_STRUCT_SIZE, 40, "nvidia RT struct = 40 bytes");
    return 0;
}

# N6.2b — Turing TIC/TSC descriptor builders, byte-diffed against the N6.2a
# NVK golden (docs/development/nvidia-n6-capture-notes.md) + the empirical
# multi-size capture. mabda emits PITCH (linear) TICs, not the golden's
# BLOCKLINEAR — so dw0/dw1/dw4/dw5/dw6 match the golden (shared, ground-truth
# validated) while dw2/dw3 carry the PITCH header + row pitch. (High-bit
# dwords masked & 0xFFFFFFFF against load32 sign-extension.)
fn test_nv_tic_tsc_build() {
    var tic[32];
    native_nv_tic_build_2d_rgba8(&tic, 0x3ffdf9c000, 1, 1);
    assert_eq(load32(&tic +  0) & 0xFFFFFFFF, 0x58D24908, "TIC dw0 format = golden");
    assert_eq(load32(&tic +  4) & 0xFFFFFFFF, 0xFDF9C000, "TIC dw1 addr_lo = golden");
    assert_eq(load32(&tic +  8) & 0xFFFFFFFF, 0x0040003F, "TIC dw2 PITCH header (golden=0x60.. blocklinear)");
    assert_eq(load32(&tic + 12) & 0xFFFFFFFF, 0x00070001, "TIC dw3 pitch=32 (golden gob=0x..00)");
    assert_eq(load32(&tic + 16) & 0xFFFFFFFF, 0xE0800000, "TIC dw4 (W-1|2D|border) = golden");
    assert_eq(load32(&tic + 20) & 0xFFFFFFFF, 0x80000000, "TIC dw5 (H-1|norm) = golden");
    assert_eq(load32(&tic + 24) & 0xFFFFFFFF, 0x03000000, "TIC dw6 = golden");
    assert_eq(load32(&tic + 28) & 0xFFFFFFFF, 0, "TIC dw7 = 0");

    # Dimension + pitch parameterize correctly (cross-checked vs the empirical
    # 8x4 / 16x16 captures: dw4 low = W-1, dw5 low = H-1, pitch = round_up(W*4,32)/32).
    var tic2[32];
    native_nv_tic_build_2d_rgba8(&tic2, 0x3ffdf9c000, 8, 4);
    assert_eq(load32(&tic2 + 16) & 0xFFFF, 7, "TIC 8x4 WIDTH_MINUS_ONE = 7");
    assert_eq(load32(&tic2 + 20) & 0xFFFF, 3, "TIC 8x4 HEIGHT_MINUS_ONE = 3");
    assert_eq(load32(&tic2 + 12) & 0xFFFFFFFF, 0x00070001, "TIC 8x4 pitch = 32/32 = 1");
    var tic3[32];
    native_nv_tic_build_2d_rgba8(&tic3, 0x3ffdf9c000, 16, 16);
    assert_eq(load32(&tic3 + 16) & 0xFFFF, 15, "TIC 16x16 WIDTH_MINUS_ONE = 15");
    assert_eq(load32(&tic3 + 12) & 0xFFFFFFFF, 0x00070002, "TIC 16x16 pitch = 64/32 = 2");

    # TSC reproduces the golden NEAREST / CLAMP_TO_EDGE descriptor exactly.
    var tsc[32];
    native_nv_tsc_build_nearest_clamp(&tsc);
    assert_eq(load32(&tsc + 0) & 0xFFFFFFFF, 0x00026092, "TSC dw0 = golden (CLAMP_TO_EDGE)");
    assert_eq(load32(&tsc + 4) & 0xFFFFFFFF, 0x00000291, "TSC dw1 = golden (NEAREST)");
    assert_eq(load32(&tsc + 8) & 0xFFFFFFFF, 0, "TSC dw2 = 0 (LOD clamps to base)");
    return 0;
}

# N6.2c-i — the bound-texture sampling SASS (ptxas-captured, STG patched to
# GPU scope). Pins the byte count, the launch ABI, and key instructions: the
# bound TEX (TIC 0 / TSC 0x58 immediates), the ULDC of the output ptr at
# c[0x0]+0x168, and the GPU-scope STG (control word patched from .SYS — .SYS
# hangs on a GART output BO, the proven store-kernel finding).
fn test_nv_sass_sample_tex() {
    var sass[256];
    var n = native_nv_sass_sample_tex(&sass);
    assert_eq(n, 256, "sample_tex SASS = 256 bytes");
    assert_eq(NV_SASS_SAMPLE_TEX_BYTES, 256, "sample_tex bytes const");
    assert_eq(NV_SASS_SAMPLE_TEX_REGCOUNT, 10, "sample_tex regcount = 10");
    assert_eq(NV_SASS_SAMPLE_TEX_PARAM_OFF, 0x168, "sample_tex out param @ 0x168");
    assert_eq(NV_SASS_SAMPLE_TEX_TIC_INDEX, 0, "sample_tex TIC index = 0");
    assert_eq(NV_SASS_SAMPLE_TEX_TSC_INDEX, 0x58, "sample_tex TSC index = 0x58");
    assert_eq(load64(&sass + 48),  0x3000580206027b60, "sample_tex TEX op (bound TIC0/TSC0x58)");
    assert_eq(load64(&sass + 64),  0x00005a0000047ab9, "sample_tex ULDC out ptr @0x168");
    assert_eq(load64(&sass + 128), 0x00000004ff007986, "sample_tex STG opcode");
    assert_eq(load64(&sass + 136), 0x000fe2000c114904, "sample_tex STG ctl = GPU scope (patched from .SYS)");
    return 0;
}

# N6.2c-ii — the UINT TIC variant the sampling dispatch binds. The sampling
# SASS reads raw integer texels (TEX -> PRMT, no denormalize), so the header
# must be RGBA8_UINT, not the UNORM the NVK normalized-float probe used. UINT
# differs from UNORM in dw0 ONLY: the four DATA_TYPE fields 2->4 (XOR 6 each =
# 0x6DB00); every other dword is type-agnostic and identical.
fn test_nv_tic_build_uint() {
    var u[32];
    var s[32];
    native_nv_tic_build_2d_rgba8_uint(&u, 0x3ffdf9c000, 1, 1);
    native_nv_tic_build_2d_rgba8(&s, 0x3ffdf9c000, 1, 1);
    assert_eq(load32(&u + 0) & 0xFFFFFFFF, 0x58D49208, "UINT TIC dw0 = RGBA8_UINT");
    assert_eq(NV_TIC_FORMAT_RGBA8_UINT, 0x58D49208, "RGBA8_UINT format const");
    assert_eq((load32(&u + 0) ^ load32(&s + 0)) & 0xFFFFFFFF, 0x0006DB00,
    "UINT^UNORM dw0 = the four DATA_TYPE fields (2->4) only");
    assert_eq(load32(&u + 4) & 0xFFFFFFFF, load32(&s + 4) & 0xFFFFFFFF, "UINT dw1 == UNORM dw1");
    assert_eq(load32(&u + 8) & 0xFFFFFFFF, load32(&s + 8) & 0xFFFFFFFF, "UINT dw2 == UNORM dw2");
    assert_eq(load32(&u + 12) & 0xFFFFFFFF, load32(&s + 12) & 0xFFFFFFFF, "UINT dw3 == UNORM dw3");
    assert_eq(load32(&u + 16) & 0xFFFFFFFF, load32(&s + 16) & 0xFFFFFFFF, "UINT dw4 == UNORM dw4");
    assert_eq(load32(&u + 20) & 0xFFFFFFFF, load32(&s + 20) & 0xFFFFFFFF, "UINT dw5 == UNORM dw5");
    assert_eq(load32(&u + 24) & 0xFFFFFFFF, load32(&s + 24) & 0xFFFFFFFF, "UINT dw6 == UNORM dw6");
    return 0;
}

# N6.2c-ii — the sampling-dispatch pushbuffer: the N4 store dispatch (SET_OBJECT
# + memory windows + SEND_PCAS) plus the TIC/TSC pool binds and their cache
# invalidates. Every method offset / header verified against clc5c0.h + NVK
# (nvk_queue.c / nvk_cmd_dispatch.c). These are the silent-hang-prone bytes, so
# pin them all. (qmd_va 0x200000, TIC pool 0x700000, TSC pool 0x800000.)
fn test_nv_push_dispatch_sample() {
    var buf[96];
    memset(&buf, 0, 96);
    var n = native_nv_push_dispatch_sample(&buf, 0x200000, 0x700000, 0x800000);
    assert_eq(n, 88, "sample dispatch push = 88 bytes (22 dwords)");
    assert_eq(load32(&buf + 0), 0x20012000, "SET_OBJECT header");
    assert_eq(load32(&buf + 4), 0xC5C0, "compute class arg");
    assert_eq(load32(&buf + 8), 0x200220A8, "SHARED_MEMORY_WINDOW header");
    assert_eq(load32(&buf + 16) & 0xFFFFFFFF, 0xFE000000, "shared window base");
    assert_eq(load32(&buf + 20), 0x200221EC, "LOCAL_MEMORY_WINDOW header");
    assert_eq(load32(&buf + 28) & 0xFFFFFFFF, 0xFF000000, "local window base");
    assert_eq(load32(&buf + 32), 0x2003255D, "SET_TEX_HEADER_POOL_A header (0x1574 cnt3)");
    assert_eq(load32(&buf + 36), 0, "TIC pool addr upper");
    assert_eq(load32(&buf + 40), 0x700000, "TIC pool addr lower");
    assert_eq(load32(&buf + 44), 0x7FF, "TIC pool MAXIMUM_INDEX");
    assert_eq(load32(&buf + 48) & 0xFFFFFFFF, 0x80002091,
    "INVALIDATE_TEXTURE_HEADER_CACHE_NO_WFI (0x0244 immd)");
    assert_eq(load32(&buf + 52), 0x20032557, "SET_TEX_SAMPLER_POOL_A header (0x155C cnt3)");
    assert_eq(load32(&buf + 56), 0, "TSC pool addr upper");
    assert_eq(load32(&buf + 60), 0x800000, "TSC pool addr lower");
    assert_eq(load32(&buf + 64), 0x7FF, "TSC pool MAXIMUM_INDEX");
    assert_eq(load32(&buf + 68) & 0xFFFFFFFF, 0x80002509,
    "INVALIDATE_SAMPLER_CACHE_NO_WFI (0x1424 immd)");
    assert_eq(load32(&buf + 72) & 0xFFFFFFFF, 0x800020A6,
    "INVALIDATE_SKED_CACHES (0x0298 immd)");
    assert_eq(load32(&buf + 76), 0x200120AD, "SEND_PCAS_A header");
    assert_eq(load32(&buf + 80), 0x2000, "qmd_va >> 8 (0x200000 >> 8)");
    assert_eq(load32(&buf + 84) & 0xFFFFFFFF, 0x800320AF, "SEND_SIGNALING_PCAS_B inline");
    return 0;
}

