fn test_gfx9_pipeline_ctx_value_constants() {
    assert_eq(GFX9_CB_TARGET_MASK_RGBA,         0xF,   "CB_TARGET_MASK RGBA all");
    assert_eq(GFX9_CB_SHADER_MASK_RGBA0,        0xF,   "CB_SHADER_MASK RT0 RGBA");
    assert_eq(GFX9_CB_COLOR_CONTROL_NORMAL,     0xCC,  "CB_COLOR_CONTROL NORMAL ROP");
    assert_eq(GFX9_CB_BLEND_DISABLED,           0x0,   "CB blend disabled");
    assert_eq(GFX9_PA_SU_SC_MODE_CULL_NONE,     0x4,   "PA_SU_SC_MODE cull none");
    # VS_EN bit lives at bit 16; 0 means VS_STAGE_OFF (VGT waits forever
    # for vertex output → 2-second TDR). Byte-exact from radv on Cezanne.
    assert_eq(GFX9_VGT_SHADER_STAGES_VS_PS,     0x00010000, "VGT stages VS+PS only");
    assert_eq(GFX9_PA_CL_CLIP_CNTL_DEFAULT,     0x90000, "PA_CL_CLIP_CNTL default");
    assert_eq(GFX9_VGT_PRIMITIVE_TYPE_TRIANGLELIST, 0x4, "VGT primitive triangle list");
    assert_eq(GFX9_VGT_NUM_INSTANCES_ONE,       0x1,   "VGT num instances 1");
    assert_eq(GFX9_SPI_PS_INPUT_HANG_QUIRK_MIN, 0x2,   "SPI_PS_INPUT min for hang quirk");
    assert_eq(GFX9_SPI_VS_OUT_CONFIG_NO_VARYING, 0x0,  "SPI_VS_OUT_CONFIG no varying");
    assert_eq(GFX9_DB_SHADER_CONTROL_DEFAULT,   0x10,  "DB_SHADER_CONTROL default");
    # Composed bit-pattern values.
    assert_eq(GFX9_CB_COLOR_CONTROL_NORMAL_COPY, 0xCC0010, "CB_COLOR_CONTROL composed");
    # Byte-exact from radv triangle reference on Cezanne (2026-05-13).
    # bits[2:0]=FORMAT_8_8_8_8 (8), bits[5:4]=NUM_TYPE_UNORM (0x20), plus
    # the COMP_SWAP/FMASK/ENDIAN/etc bits that radv emits in 0x00028028.
    assert_eq(GFX9_CB_COLOR0_INFO_RGBA8_UNORM,   0x00028028, "CB_COLOR0_INFO RGBA8 unorm");
    assert_eq(GFX9_CB_COLOR0_ATTRIB_2D_LINEAR_RGBA8, 0x10000000, "CB_COLOR0_ATTRIB 2D linear");
    return 0;
}

# ================================================================
# v3 Step 6.5(b) — PM4 stream composer for clear-triangle dispatch
# ================================================================
# Verifies the four PM4 blocks compose correctly and produce the
# expected wire-form dwords. CPU-asserted by-construction. Layer-2
# verification (byte-exact vs radv-IB capture) gated on Hyprland.

fn test_native_int_to_f32_bits_and_negate() {
    # 0 → 0x00000000, 1 → 0x3F800000, 128 → 0x43000000, 256 → 0x43800000.
    assert_eq(native_int_to_f32_bits(0),    0x00000000, "int 0 → f32 bits");
    assert_eq(native_int_to_f32_bits(1),    0x3F800000, "int 1 → f32 bits");
    assert_eq(native_int_to_f32_bits(128),  0x43000000, "int 128 → f32 bits");
    assert_eq(native_int_to_f32_bits(256),  0x43800000, "int 256 → f32 bits");

    # Negation flips the sign bit. -1.0 = 0xBF800000, -128.0 = 0xC3000000.
    assert_eq(native_f32_neg_bits(0x3F800000), 0xBF800000, "neg 1.0");
    assert_eq(native_f32_neg_bits(0x43000000), 0xC3000000, "neg 128.0");
    # Negating 0.0 produces -0.0 = 0x80000000 (sign-bit flip).
    assert_eq(native_f32_neg_bits(0x00000000), 0x80000000, "neg 0.0");
    return 0;
}

fn test_native_pm4_render_pipeline_sh_layout() {
    # VS at VA 0xFFFF800200000000, FS at VA 0xFFFF800200001000.
    # VS PGM_LO = (vs_va >> 8) & 0xFFFFFFFF
    #          = (0xFFFF800200000000 >> 8) & 0xFFFFFFFF
    #          = 0x02000000.
    # VS PGM_HI = (vs_va >> 40) & 0xFFFFFFFF
    #          = 0xFFFF8002 & 0xFFFFFFFF = 0xFFFF8002.
    var buf[64];
    memset(&buf, 0xCC, 64);
    var pos = native_pm4_build_render_pipeline_sh(&buf, 0,
    0xFFFF800200000000,
    0xFFFF800200001000);
    # VS packet spans 6 contiguous regs (RSRC3_VS, LATE_ALLOC_VS, PGM_LO,
    # PGM_HI, RSRC1, RSRC2) = 8 dwords (32 bytes). PS packet spans 4 regs
    # (PGM_LO, PGM_HI, RSRC1, RSRC2) = 6 dwords (24 bytes). Total 56 bytes.
    # Grew 48 → 56 at 2026-05-13 when RSRC3_VS + LATE_ALLOC_VS were added
    # to fix the Cezanne VS-allocation TDR (CUs disabled by default).
    assert_eq(pos, 56, "pipeline_sh size = 56 bytes");

    # First packet header — SET_SH_REG opcode 0x76, count = n+1 = 7,
    # count_minus_1 = 6. Header: 0xC0067600.
    assert_eq(load32(&buf + 0), 0xC0067600, "VS SET_SH_REG header");
    # Wire offset for the FIRST reg in the packet (RSRC3_VS at 0xB118):
    # (0xB118 - 0xB000)/4 = 0x46 = 70.
    assert_eq(load32(&buf + 4), 0x46, "VS RSRC3_VS wire offset (0xB118 → 0x46)");
    # vs_va = 0xFFFF800200000000.
    # New layout (2026-05-13): RSRC3_VS, LATE_ALLOC_VS, PGM_LO, PGM_HI,
    # RSRC1, RSRC2 — 6 contiguous regs starting at 0xB118.
    # PGM_LO = (va >> 8) & 0xFFFFFFFF = 0x02000000 (Cyrius >> is logical).
    # PGM_HI = (va >> 40) & 0xFF = bits [47:40] of va = 0x80.
    assert_eq(load32(&buf + 8),  GFX9_SPI_SHADER_PGM_RSRC3_VS_CU_EN_ALL, "VS RSRC3_VS (CU enable mask)");
    assert_eq(load32(&buf + 12), GFX9_SPI_SHADER_LATE_ALLOC_VS_CEZANNE, "VS LATE_ALLOC_VS");
    assert_eq(load32(&buf + 16), 0x02000000, "VS PGM_LO = (vs_va>>8) low");
    assert_eq(load32(&buf + 20), 0x80,       "VS PGM_HI = (vs_va>>40) byte");
    assert_eq(load32(&buf + 24), GFX9_GFX_PGM_RSRC1_MIN, "VS PGM_RSRC1");
    assert_eq(load32(&buf + 28), GFX9_VS_PGM_RSRC2_MIN,  "VS PGM_RSRC2");

    # Second packet — PS at offset +32 in buf (was +24 pre 2026-05-13).
    # fs_va = 0xFFFF800200001000 → PGM_LO = 0x02000010, PGM_HI = 0x80.
    assert_eq(load32(&buf + 32), 0xC0047600, "PS SET_SH_REG header");
    assert_eq(load32(&buf + 36), 0x08, "PS PGM_LO wire offset (0xB020 → 0x08)");
    assert_eq(load32(&buf + 40), 0x02000010, "PS PGM_LO = (fs_va>>8) low");
    assert_eq(load32(&buf + 44), 0x80,       "PS PGM_HI = (fs_va>>40) byte");
    assert_eq(load32(&buf + 48), GFX9_GFX_PGM_RSRC1_MIN, "PS PGM_RSRC1");
    assert_eq(load32(&buf + 52), GFX9_PS_PGM_RSRC2_MIN, "PS PGM_RSRC2");
    return 0;
}

fn test_native_pm4_render_pipeline_ctx_size_and_anchors() {
    # 2026-05-13: ctx block now 556 bytes after the RADV-Cezanne IB diff
    # added RSRC3/LATE_ALLOC + AA-mask handshake + walk-order + 8
    # explicit-zero handshake regs (SPI_BARYC_CNTL, VGT_GS_MODE, etc.)
    # plus the 8-reg SX_MRT0..7_BLEND_OPT block. Pre-2026-05-13 size
    # was 292; pre-rc.2 was 240.
    var buf[768];
    memset(&buf, 0xCC, 768);
    var pos = native_pm4_build_render_pipeline_ctx(&buf, 0);
    assert_eq(pos, 556, "pipeline_ctx size = 556 bytes");

    # First packet = SPI shader formats, 3 values starting at POS_FORMAT.
    # Header: PKT3(SET_CONTEXT_REG, count_minus_1=3, 0) = 0xC0036900.
    assert_eq(load32(&buf + 0), 0xC0036900, "SPI fmts SET_CONTEXT_REG header");
    # Wire offset = (0xA70C - 0xA000) / 4 = 0x70C/4 = 0x1C3.
    assert_eq(load32(&buf + 4),  0x1C3, "POS_FORMAT wire offset");
    assert_eq(load32(&buf + 8),  SPI_SHADER_POS_FORMAT_4,     "SPI POS_FORMAT");
    assert_eq(load32(&buf + 12), SPI_SHADER_Z_FORMAT_INVALID, "SPI Z_FORMAT");
    assert_eq(load32(&buf + 16), SPI_SHADER_COL_FORMAT_FP32_ABGR, "SPI COL_FORMAT");

    # Second packet = CB target/shader masks at +20 in buf.
    assert_eq(load32(&buf + 20), 0xC0026900, "CB masks SET_CONTEXT_REG header");
    # Wire offset = (0xA238 - 0xA000) / 4 = 0x238/4 = 0x8E.
    assert_eq(load32(&buf + 24), 0x8E, "CB_TARGET_MASK wire offset");
    assert_eq(load32(&buf + 28), GFX9_CB_TARGET_MASK_RGBA,  "CB_TARGET_MASK value");
    assert_eq(load32(&buf + 32), GFX9_CB_SHADER_MASK_RGBA0, "CB_SHADER_MASK value");

    # First singleton = CB_COLOR_CONTROL at +36. Single-reg: header + offset + value = 3 dwords.
    assert_eq(load32(&buf + 36), 0xC0016900, "CB_COLOR_CONTROL header");
    # Wire offset = (0xA808 - 0xA000) / 4 = 0x808/4 = 0x202.
    assert_eq(load32(&buf + 40), 0x202, "CB_COLOR_CONTROL wire offset");
    assert_eq(load32(&buf + 44), GFX9_CB_COLOR_CONTROL_NORMAL_COPY, "CB_COLOR_CONTROL value");
    return 0;
}

fn test_native_pm4_render_pass_target_layout_256x256() {
    # RT VA 0xFFFF800101000000 (matches src/backend_native.cyr's RT pool VA).
    # 256x256 RT — viewport scale = 128, offset = 128.
    var buf[256];
    memset(&buf, 0xCC, 256);
    var pos = native_pm4_build_render_pass_target(&buf, 0,
    0xFFFF800101000000,
    256, 256);
    # Block size: 3 scissor pairs (screen/generic/window, 12 dw) +
    # 1 viewport-6 (8 dw) + 1 zminmax-pair (4 dw) + many RT singletons
    # (CB_COLOR0_{BASE,BASE_EXT,ATTRIB2,VIEW,INFO,ATTRIB,DCC_CONTROL,
    # CMASK, CMASK_BASE_EXT, FMASK, FMASK_BASE_EXT, DCC_BASE,
    # DCC_BASE_EXT, MRT0_EPITCH}) = 264 bytes total. Grew 164 → 264
    # at 2026-05-13 when WINDOW_SCISSOR + CB FMASK/CMASK/DCC handshake
    # regs landed in the RADV-Cezanne IB diff round.
    assert_eq(pos, 264, "pass_target size = 264 bytes");

    # First packet = screen scissor pair at +0.
    assert_eq(load32(&buf + 0), 0xC0026900, "screen_scissor header");
    # Wire offset = (0xA030 - 0xA000) / 4 = 0xC.
    assert_eq(load32(&buf + 4), 0xC, "PA_SC_SCREEN_SCISSOR_TL wire offset");
    assert_eq(load32(&buf + 8),  0,         "scissor TL = (0,0)");
    # BR = (256 << 0) | (256 << 16) = 0x01000100.
    assert_eq(load32(&buf + 12), 0x01000100, "scissor BR = (256,256)");

    # Skip past 3 scissor packets + 6-value viewport packet to spot-check
    # the viewport scale/offset. 2026-05-13: PA_SC_WINDOW_SCISSOR was
    # inserted between generic_scissor and viewport (RADV-Cezanne diff).
    # screen_scissor: 4 dw (16 bytes), generic_scissor: 4 dw (16 bytes),
    # window_scissor: 4 dw (16 bytes), viewport packet at offset 48.
    # Header + offset + 6 values = 8 dw.
    # set_context_reg(n=6) → pkt3 count_minus_1 = 6 → header 0xC0066900.
    assert_eq(load32(&buf + 48), 0xC0066900, "viewport header (6 values)");
    # Wire offset (0xA43C - 0xA000)/4 = 0x10F.
    assert_eq(load32(&buf + 52), 0x10F, "PA_CL_VPORT_XSCALE wire offset");
    # Viewport: XSCALE = 128.0 = 0x43000000, XOFFSET = 128.0,
    # YSCALE = -128.0 = 0xC3000000, YOFFSET = 128.0,
    # ZSCALE = 1.0 = 0x3F800000, ZOFFSET = 0.
    assert_eq(load32(&buf + 56), 0x43000000, "VPORT XSCALE = 128.0");
    assert_eq(load32(&buf + 60), 0x43000000, "VPORT XOFFSET = 128.0");
    assert_eq(load32(&buf + 64), 0xC3000000, "VPORT YSCALE = -128.0");
    assert_eq(load32(&buf + 68), 0x43000000, "VPORT YOFFSET = 128.0");
    assert_eq(load32(&buf + 72), 0x3F800000, "VPORT ZSCALE = 1.0");
    assert_eq(load32(&buf + 76), 0,          "VPORT ZOFFSET = 0.0");
    return 0;
}

fn test_native_pm4_render_pass_target_rt_bind() {
    # RT VA 0xFFFF800101000000.
    # (rt_va >> 8): canonical-high arithmetic shift → 0xFFFFFF8001010000
    # & 0xFFFFFFFF → 0x01010000 (low 32 bits hold the BO offset >> 8).
    # (rt_va >> 40) & 0xFF: bits 40-47 of rt_va. The byte at that
    # position in 0xFFFF800101000000 is 0x80.
    var buf[256];
    memset(&buf, 0xCC, 256);
    var pos = native_pm4_build_render_pass_target(&buf, 0,
    0xFFFF800101000000,
    256, 256);
    # CB_COLOR0 singletons follow 3 scissor pairs (48) + viewport (32) +
    # zmm (16) = 96 bytes. CB_COLOR0_BASE single-reg header at offset 96
    # (was +80 pre-2026-05-13, before WINDOW_SCISSOR insert).
    # set_context_reg_one → pkt3_header(0x69, 2, 0) → count_minus_1 = 1.
    assert_eq(load32(&buf + 96), 0xC0016900, "CB_COLOR0_BASE header");
    # Wire offset (0xAC60 - 0xA000)/4 = 0xC60/4 = 0x318.
    assert_eq(load32(&buf + 100), 0x318, "CB_COLOR0_BASE wire offset");
    assert_eq(load32(&buf + 104), 0x01010000, "CB_COLOR0_BASE = (rt_va>>8) low");

    # CB_COLOR0_BASE_EXT at +108 (next 3-dword packet).
    assert_eq(load32(&buf + 108), 0xC0016900, "CB_COLOR0_BASE_EXT header");
    assert_eq(load32(&buf + 112), 0x319, "CB_COLOR0_BASE_EXT wire offset");
    assert_eq(load32(&buf + 116), 0x80, "CB_COLOR0_BASE_EXT = (rt_va>>40) byte");

    # CB_COLOR0_ATTRIB2 at +120 — the rc.2 0x55-sentinel bug fix.
    # Without this register the CB sees the RT as zero-extent and
    # silently drops every pixel write (draw signals fine, RT stays
    # at the test's pre-fill sentinel). For 256x256:
    #   MIP0_HEIGHT (bits 0..13)  = 255 = 0xFF
    #   MIP0_WIDTH  (bits 14..27) = 255 << 14 = 0x3FC000
    #   MAX_MIP     (bits 28..31) = 0
    # → value = 0xFF | 0x3FC000 = 0x3FC0FF.
    # Wire offset = (0xAC68 - 0xA000)/4 = 0xC68/4 = 0x31A.
    assert_eq(load32(&buf + 120), 0xC0016900, "CB_COLOR0_ATTRIB2 header");
    assert_eq(load32(&buf + 124), 0x31A, "CB_COLOR0_ATTRIB2 wire offset");
    assert_eq(load32(&buf + 128), 0x3FC0FF,
    "CB_COLOR0_ATTRIB2 = (h-1) | ((w-1)<<14) for 256x256");
    return 0;
}

fn test_native_pm4_render_draw_tail() {
    var buf[16];
    memset(&buf, 0xCC, 16);
    # Audit LOW-4: vertex_count is now an explicit param; pass the
    # fullscreen-tri value to keep this assertion's intent stable.
    var pos = native_pm4_build_render_draw_tail(&buf, 0, GFX9_FULLSCREEN_TRI_VCOUNT);
    assert_eq(pos, 12, "draw_tail = 3 dwords");
    # DRAW_INDEX_AUTO header: count_minus_1=1, opcode=0x2D → 0xC0012D00.
    assert_eq(load32(&buf + 0), 0xC0012D00, "DRAW_INDEX_AUTO header");
    assert_eq(load32(&buf + 4), GFX9_FULLSCREEN_TRI_VCOUNT, "vertex_count = 3");
    assert_eq(load32(&buf + 8), DI_SRC_SEL_AUTO_INDEX, "auto-index draw initiator");
    return 0;
}

# Audit LOW-4: caller-supplied vertex_count threads into the
# DRAW_INDEX_AUTO packet at dword[1]. Distinct call shapes (6, 36,
# 0) must produce distinct PM4 streams — verifies the param isn't
# silently ignored.
fn test_native_pm4_render_draw_tail_honours_vertex_count() {
    var buf[16];
    memset(&buf, 0, 16);
    native_pm4_build_render_draw_tail(&buf, 0, 6);
    assert_eq(load32(&buf + 4), 6, "vc=6 in DRAW_INDEX_AUTO[1]");
    memset(&buf, 0, 16);
    native_pm4_build_render_draw_tail(&buf, 0, 36);
    assert_eq(load32(&buf + 4), 36, "vc=36 in DRAW_INDEX_AUTO[1]");
    memset(&buf, 0, 16);
    native_pm4_build_render_draw_tail(&buf, 0, 0);
    assert_eq(load32(&buf + 4), 0, "vc=0 in DRAW_INDEX_AUTO[1]");
    return 0;
}

fn test_native_pm4_render_clear_triangle_top_level() {
    # End-to-end composer. Buffer needs ≥ 1024 bytes (256-dword pad target).
    var buf[1024];
    memset(&buf, 0xCC, 1024);
    var pos = native_pm4_build_render_clear_triangle(&buf,
    0xFFFF800200000000,   # vs_va
    0xFFFF800200001000,   # fs_va
    0xFFFF800101000000,   # rt_va
    256, 256);            # rt extent
    # Padded to 256 dwords = 1024 bytes.
    assert_eq(pos, 1024, "composer pads to 1024 bytes");

    # 2026-05-13 layout (RADV-Cezanne IB diff):
    # +0   PFP_SYNC_ME (8 bytes)
    # +8   ACQUIRE_MEM (28 bytes; gfx-ring variant, shader_type=0)
    # +36  EVENT_WRITE PIPELINESTAT_START (8 bytes)
    # +44  SET_UCONFIG VGT_PRIMITIVE_TYPE (12 bytes)
    # +56  SET_UCONFIG IA_MULTI_VGT_PARAM (12 bytes) [new — replaces +40 num_instances]
    # +68  pipeline_sh (56 bytes)
    # +124 pipeline_ctx (556 bytes)
    # +680 pass_target (264 bytes)
    # +944 PKT3 NUM_INSTANCES (8 bytes) [moved from preamble; opcode 0x2F]
    # +952 draw_tail (12 bytes)
    # +964 EVENT_WRITE CACHE_FLUSH_AND_INV (8 bytes)
    # +972 NOP pad to 1024
    # ACQUIRE_MEM at offset 8: header 0xC0055800 (gfx-ring shader_type=0).
    assert_eq(load32(&buf + 8), 0xC0055800, "ACQUIRE_MEM header");

    # First UConfig SET_REG packet at offset 44 (post-PIPELINESTAT_START).
    # set_uconfig_reg_one passes count=2 to pkt3_header → count_minus_1=1
    # → header 0xC0017900.
    assert_eq(load32(&buf + 44), 0xC0017900, "VGT_PRIMITIVE_TYPE UConfig header");
    # VGT_PRIMITIVE_TYPE wire offset = (0x30908 - 0x30000)/4 = 0x242.
    assert_eq(load32(&buf + 48), 0x242, "VGT_PRIMITIVE_TYPE wire offset");
    assert_eq(load32(&buf + 52), GFX9_VGT_PRIMITIVE_TYPE_TRIANGLELIST, "primitive type");

    # Second UConfig at offset 56 — IA_MULTI_VGT_PARAM (NOT VGT_NUM_INSTANCES
    # since 2026-05-13). NUM_INSTANCES is now emitted as PKT3 0x2F just
    # before DRAW_INDEX_AUTO (radv pattern). Label retained for cascade.
    assert_eq(load32(&buf + 56), 0xC0017900, "VGT_NUM_INSTANCES UConfig header");
    # IA_MULTI_VGT_PARAM wire offset = (0x30960 - 0x30000)/4 = 0x258 = 600.
    assert_eq(load32(&buf + 60), 0x258, "VGT_NUM_INSTANCES wire offset");
    assert_eq(load32(&buf + 64), 0x0070007F, "num instances 1");

    # Pipeline_sh starts at offset 68 (VS SET_SH_REG opcode 0x76, 6 regs).
    # Header: 0xC0067600 (count_minus_1 = 6 since the VS packet now spans
    # RSRC3_VS through RSRC2_VS — 6 contiguous regs at 0xB118..0xB12C).
    assert_eq(load32(&buf + 68), 0xC0067600, "pipeline_sh begins (VS SET_SH_REG)");

    # CACHE_FLUSH_AND_INV EVENT_WRITE spliced after draw_tail (Step 6.10
    # wired post-pivot). 2026-05-13 layout: composer offsets shifted
    # again with RADV-Cezanne IB diff additions; flush packet now lands
    # at +964..+972 with header 0xC0004600 and body 0x00000016.
    assert_eq(load32(&buf + 964), 0xC0004600,
    "EVENT_WRITE header after draw_tail");
    assert_eq(load32(&buf + 968), 0x00000016,
    "CACHE_FLUSH_AND_INV body");
    return 0;
}

fn test_native_pm4_render_clear_triangle_block_sizes() {
    # 2026-05-13 block sizes (RADV-Cezanne IB diff round):
    #   ACQUIRE_MEM (28) + 2 UConfig (24) + sh (56) + ctx (556) +
    #   pass_target (264) + draw_tail (12) = 940 bytes pre-pad.
    # Comments on each assert retain old "expected = X" continuity.
    var buf[1024];
    memset(&buf, 0xCC, 1024);

    var p = 0;
    p = native_pm4_acquire_mem_full_invalidate(&buf, p);
    assert_eq(p, 28, "ACQUIRE_MEM = 28");
    p = native_pm4_set_uconfig_reg_one(&buf, p, R_VGT_PRIMITIVE_TYPE,
    GFX9_VGT_PRIMITIVE_TYPE_TRIANGLELIST);
    assert_eq(p, 40, "+UConfig 1");
    p = native_pm4_set_uconfig_reg_one(&buf, p, R_VGT_NUM_INSTANCES,
    GFX9_VGT_NUM_INSTANCES_ONE);
    assert_eq(p, 52, "+UConfig 2");
    p = native_pm4_build_render_pipeline_sh(&buf, p,
    0xFFFF800200000000,
    0xFFFF800200001000);
    assert_eq(p, 108, "+pipeline_sh = 56");
    p = native_pm4_build_render_pipeline_ctx(&buf, p);
    assert_eq(p, 664, "+pipeline_ctx = 556");
    p = native_pm4_build_render_pass_target(&buf, p,
    0xFFFF800101000000, 256, 256);
    assert_eq(p, 928, "+pass_target = 264");
    p = native_pm4_build_render_draw_tail(&buf, p, GFX9_FULLSCREEN_TRI_VCOUNT);
    assert_eq(p, 940, "+draw_tail = 12");
    return 0;
}

# ================================================================
# v3 Step 6.6 — render-ring dispatch helpers (CPU-testable surface)
# ================================================================
# native_render_dispatch_simple itself drives real DRM_AMDGPU_CS
# syscalls (HW gate is 6.9(b)). Its CPU-testable building blocks
# are the (vs, fs, rt) handle triple writer and the 5-entry
# BO_HANDLES list packer — both pinned here.

fn test_native_render_handles_write_layout() {
    var triple[24];
    memset(&triple, 0xCC, 24);
    native_render_handles_write(&triple, 0x1111, 0x2222, 0x3333);
    assert_eq(load64(&triple +  0), 0x1111, "vs handle at +0");
    assert_eq(load64(&triple +  8), 0x2222, "fs handle at +8");
    assert_eq(load64(&triple + 16), 0x3333, "rt handle at +16");
    return 0;
}

fn test_native_render_bo_list_pack_layout() {
    # 5 entries × 8 bytes (handle u32 + priority u32) = 40 bytes.
    var entries[40];
    memset(&entries, 0xCC, 40);
    native_render_bo_list_pack(&entries,
    0xF1,    # fence_h
    0xA0,    # vs_h
    0xA1,    # fs_h
    0xB0,    # rt_h
    0xC0);   # ib_h
    # Order matters: fence / vs / fs / rt / ib. Priorities mirror
    # compute's pattern (fence=1, shaders=4, target=3, ib=10).
    assert_eq(load32(&entries +  0), 0xF1, "fence handle");
    assert_eq(load32(&entries +  4), 1,    "fence priority = 1");
    assert_eq(load32(&entries +  8), 0xA0, "vs handle");
    assert_eq(load32(&entries + 12), 4,    "vs priority = 4");
    assert_eq(load32(&entries + 16), 0xA1, "fs handle");
    assert_eq(load32(&entries + 20), 4,    "fs priority = 4");
    assert_eq(load32(&entries + 24), 0xB0, "rt handle");
    assert_eq(load32(&entries + 28), 3,    "rt priority = 3");
    assert_eq(load32(&entries + 32), 0xC0, "ib handle");
    assert_eq(load32(&entries + 36), 10,   "ib priority = 10");
    return 0;
}

fn test_native_render_bo_list_pack_distinct_from_compute() {
    # Compute's inline list is (fence, stub, out, shader, ib) at
    # priorities (1, 3, 3, 4, 10). Render's is (fence, vs, fs, rt, ib)
    # at (1, 4, 4, 3, 10). Slot-by-slot they differ — guard against
    # an accidental "same shape" refactor that would hand the kernel
    # the wrong residency story.
    var render_entries[40];
    memset(&render_entries, 0, 40);
    native_render_bo_list_pack(&render_entries, 1, 2, 3, 4, 5);
    # Slot 1 (post-fence): render=vs prio 4; compute=stub prio 3.
    assert_eq(load32(&render_entries + 12), 4, "render slot1 prio = 4 (vs)");
    # Slot 3: render=rt prio 3; compute=shader prio 4. Different.
    assert_eq(load32(&render_entries + 28), 3, "render slot3 prio = 3 (rt)");
    return 0;
}

# ================================================================
# v3 Step 6.8(c) — NativeRenderPipeline + NativePass layouts
# ================================================================
# v2.1's 4-block PM4 split lives in two structs: NativeRenderPipeline
# carries the pre-built per-pipeline blocks; NativePass carries
# per-pass refs. Layout tests pin the field offsets + sizes; the
# load-bearing byte-exact test asserts that the cached blocks are
# bit-identical to a fresh composer invocation (so pass_draw can
# memcpy them with confidence).

fn test_native_render_pipeline_struct_field_offsets() {
    # 2026-05-13: sh_block grew 48 → 56, ctx_block 292 → 556, struct
    # total 372 → 644. ctx_block field offset bumped 80 → 88 to follow
    # sh_block's new size.
    assert_eq(NATIVE_PIPE_FIELD_VS_HANDLE,  0,   "vs_handle at +0");
    assert_eq(NATIVE_PIPE_FIELD_VS_VA,      8,   "vs_va at +8");
    assert_eq(NATIVE_PIPE_FIELD_FS_HANDLE,  16,  "fs_handle at +16");
    assert_eq(NATIVE_PIPE_FIELD_FS_VA,      24,  "fs_va at +24");
    assert_eq(NATIVE_PIPE_FIELD_SH_BLOCK,   32,  "sh_block at +32");
    assert_eq(NATIVE_PIPE_FIELD_CTX_BLOCK,  88,  "ctx_block at +88");
    assert_eq(NATIVE_PIPE_SH_BLOCK_SIZE,    56,  "sh_block size = 56");
    assert_eq(NATIVE_PIPE_CTX_BLOCK_SIZE,   556, "ctx_block size = 556");
    assert_eq(NATIVE_PIPE_STRUCT_SIZE,      644, "total = 644");
    # The two block sizes must match the composers' actual outputs;
    # the SH_BLOCK starts where the header ends, and the CTX_BLOCK
    # starts where the SH_BLOCK ends.
    assert_eq(NATIVE_PIPE_FIELD_SH_BLOCK + NATIVE_PIPE_SH_BLOCK_SIZE,
    NATIVE_PIPE_FIELD_CTX_BLOCK,
    "sh_block end = ctx_block start");
    assert_eq(NATIVE_PIPE_FIELD_CTX_BLOCK + NATIVE_PIPE_CTX_BLOCK_SIZE,
    NATIVE_PIPE_STRUCT_SIZE,
    "ctx_block end = struct end");
    return 0;
}

fn test_native_render_pipeline_pack_matches_composer() {
    # The cached sh_block + ctx_block in NativeRenderPipeline must be
    # byte-identical to what the standalone composer emits — that's
    # the contract pass_draw relies on when it memcpy's them into the
    # IB. If the composers ever drift (a 6.5(b) refactor that changes
    # an emit order, e.g.), this test fails immediately.
    var vs_va = 0xFFFF800200000000;
    var fs_va = 0xFFFF800200001000;

    var pipe[644];
    memset(&pipe, 0xCC, 644);
    var rc = native_render_pipeline_pack(&pipe, 0xAA, vs_va, 0xBB, fs_va);
    assert_eq(rc, 0, "pack returns 0 on success");

    # Header round-trips.
    assert_eq(load64(&pipe + NATIVE_PIPE_FIELD_VS_HANDLE), 0xAA,  "vs_handle");
    assert_eq(load64(&pipe + NATIVE_PIPE_FIELD_VS_VA),     vs_va, "vs_va");
    assert_eq(load64(&pipe + NATIVE_PIPE_FIELD_FS_HANDLE), 0xBB,  "fs_handle");
    assert_eq(load64(&pipe + NATIVE_PIPE_FIELD_FS_VA),     fs_va, "fs_va");

    # Re-build the blocks via the composers into a parallel buffer
    # and compare dword-by-dword. Sizes per 2026-05-13 layout.
    var ref_sh[56];
    memset(&ref_sh, 0xDD, 56);
    var sh_end = native_pm4_build_render_pipeline_sh(&ref_sh, 0, vs_va, fs_va);
    assert_eq(sh_end, 56, "ref sh_block ends at 56");

    var ref_ctx[556];
    memset(&ref_ctx, 0xDD, 556);
    var ctx_end = native_pm4_build_render_pipeline_ctx(&ref_ctx, 0);
    assert_eq(ctx_end, 556, "ref ctx_block ends at 556");

    var i = 0;
    while (i < 56) {
        assert_eq(load32(&pipe + NATIVE_PIPE_FIELD_SH_BLOCK + i),
        load32(&ref_sh + i),
        "sh_block dword matches composer");
        i = i + 4;
    }
    var j = 0;
    while (j < 556) {
        assert_eq(load32(&pipe + NATIVE_PIPE_FIELD_CTX_BLOCK + j),
        load32(&ref_ctx + j),
        "ctx_block dword matches composer");
        j = j + 4;
    }
    return 0;
}

fn test_native_render_pipeline_pack_null_out() {
    assert_eq(native_render_pipeline_pack(0, 1, 2, 3, 4), -1, "null out → -1");
    return 0;
}

fn test_native_render_pass_struct_field_offsets() {
    assert_eq(NATIVE_PASS_FIELD_CTX,         0,  "ctx_ref at +0");
    assert_eq(NATIVE_PASS_FIELD_RESERVED,    8,  "reserved at +8");
    assert_eq(NATIVE_PASS_FIELD_RT,          16, "rt_ptr at +16");
    assert_eq(NATIVE_PASS_FIELD_CLEAR_COLOR, 24, "clear_color at +24");
    assert_eq(NATIVE_PASS_FIELD_TEX_DESC_VA, 32, "tex_desc_va at +32 (v3.2 TS.3)");
    assert_eq(NATIVE_PASS_STRUCT_SIZE,       40, "total = 40 (v3.2 TS.3)");
    return 0;
}

# ================================================================
# v3 Step 6.10 prep — EVENT_WRITE / CACHE_FLUSH_AND_INV PM4 builder
# ================================================================
# Stand-alone PM4 packet primitive. Not yet wired into the render
# composer — the splice into `native_pm4_build_render_clear_triangle`
# happens after HW confirms the e2e program's pixel readback fails
# from the missing post-draw flush. Tests pin the binary form of the
# event-write packet so it stays usable when that day comes.

fn test_gfx9_event_type_constants() {
    # Sourced from Mesa gfx9.json VGT_EVENT_TYPE enum. CACHE_FLUSH_AND_INV
    # is the canonical post-draw-pre-readback event radv emits before
    # CB readback; CACHE_FLUSH alone is for less-aggressive paths.
    assert_eq(GFX9_EVENT_TYPE_CACHE_FLUSH,         0x04, "CACHE_FLUSH = 0x04");
    assert_eq(GFX9_EVENT_TYPE_CACHE_FLUSH_AND_INV, 0x16, "CACHE_FLUSH_AND_INV = 0x16");
    assert_eq(GFX9_EVENT_INDEX_OTHER,              0x0,  "event_index OTHER = 0");
    assert_eq(GFX9_EVENT_INDEX_TS,                 0x5,  "event_index TS = 5");
    return 0;
}

fn test_native_pm4_event_write_layout() {
    var buf[16];
    memset(&buf, 0xCC, 16);
    var pos = native_pm4_event_write(&buf, 0,
    GFX9_EVENT_TYPE_CACHE_FLUSH_AND_INV,
    GFX9_EVENT_INDEX_OTHER);
    assert_eq(pos, 8, "EVENT_WRITE = 2 dwords (8 bytes)");
    # PKT3 header: count_minus_1 = 1 (count = 2 → c-1 = 1), opcode 0x46 (EVENT_WRITE),
    # type 3, predicate 0 → 0xC0004600.
    assert_eq(load32(&buf + 0), 0xC0004600, "EVENT_WRITE PKT3 header");
    # Body: event_index (0) << 8 | event_type (0x16) = 0x00000016.
    assert_eq(load32(&buf + 4), 0x00000016, "body = event_type | event_index<<8");
    # Past the packet: untouched 0xCC sentinel.
    assert_eq(load32(&buf + 8), 0xCCCCCCCC, "byte 8 still sentinel");
    return 0;
}

fn test_native_pm4_event_write_packs_event_index() {
    # If a future caller passes a non-OTHER event_index (e.g., 5 for
    # a TS-style event), the body must encode it in bits[11:8] without
    # disturbing the event_type in bits[5:0].
    var buf[8];
    memset(&buf, 0, 8);
    native_pm4_event_write(&buf, 0, 0x14, 0x5);
    # body = (5 << 8) | 0x14 = 0x514
    assert_eq(load32(&buf + 4), 0x514,
    "event_index = 5, event_type = 0x14 packs to 0x514");
    return 0;
}

fn test_native_pm4_event_write_cache_flush_and_inv() {
    # The convenience wrapper must produce byte-exact what the
    # general-purpose builder produces with the standard args.
    var buf_a[8];
    memset(&buf_a, 0, 8);
    native_pm4_event_write_cache_flush_and_inv(&buf_a, 0);

    var buf_b[8];
    memset(&buf_b, 0, 8);
    native_pm4_event_write(&buf_b, 0, 0x16, 0);

    assert_eq(load32(&buf_a + 0), load32(&buf_b + 0), "header matches");
    assert_eq(load32(&buf_a + 4), load32(&buf_b + 4), "body matches");
    # Spot-check the absolute body value (0x16 in low byte, no index).
    assert_eq(load32(&buf_a + 4), 0x00000016, "wrapper body = 0x16");
    return 0;
}

fn test_native_pm4_event_write_advances_pos() {
    # Position-tracking builders compose by passing pos through. Make
    # sure event_write doesn't accidentally rewrite from the start.
    var buf[16];
    memset(&buf, 0, 16);
    var pos = 0;
    pos = native_pm4_nop(&buf, pos, 2);  # 2 dwords (8 bytes)
    assert_eq(pos, 8, "nop landed at offset 0..7");
    pos = native_pm4_event_write_cache_flush_and_inv(&buf, pos);
    assert_eq(pos, 16, "event_write landed at offset 8..15");
    # Verify the NOP header is still at offset 0 (not overwritten).
    assert_eq(load32(&buf + 0) != 0, 1, "NOP header preserved at 0");
    # And the EVENT_WRITE header is at offset 8.
    assert_eq(load32(&buf + 8), 0xC0004600, "EVENT_WRITE header at +8");
    assert_eq(load32(&buf + 12), 0x00000016, "EVENT_WRITE body at +12");
    return 0;
}

# Audit LOW-4: native render-draw slot enforces the new contract on
# (vc, ic) before any alloc — vc <= 0 → GPU_ERR_OTHER, ic != 1 →
# GPU_ERR_NOT_IMPLEMENTED. The early returns happen before the rt /
# pipe field loads, so sentinel non-null pointers are sufficient.
fn test_native_render_pass_draw_rejects_bad_vc_ic() {
    var ctx[112];
    memset(&ctx, 0, 112);
    var pass[8];
    memset(&pass, 0, 8);
    var pipe[8];
    memset(&pipe, 0, 8);
    # vc <= 0 path.
    assert_eq(_backend_native_render_pass_draw(&ctx, &pass, &pipe, 0, 1),
    GPU_ERR_OTHER,           "vc=0 reject");
    assert_eq(_backend_native_render_pass_draw(&ctx, &pass, &pipe, 0-1, 1),
    GPU_ERR_OTHER,           "vc=-1 reject");
    # ic != 1 path — instance rendering is v3.x scope.
    assert_eq(_backend_native_render_pass_draw(&ctx, &pass, &pipe, 6, 0),
    GPU_ERR_NOT_IMPLEMENTED, "ic=0 reject");
    assert_eq(_backend_native_render_pass_draw(&ctx, &pass, &pipe, 6, 2),
    GPU_ERR_NOT_IMPLEMENTED, "ic=2 reject");
    return 0;
}

# v3.2 X.2: native gpu_buffer_* are now REAL (create/write/read/release
# tested above). The native gpu_shader_module_* slots remain diagnostic
# stubs — no native shader compiler yet (SPIR-V->GFX9 is Phase N).
fn test_native_shader_module_stubs() {
    assert_eq(_backend_native_shader_module_create(0, 0, 0), 0, "shmod_create no handle");
    assert_eq(_backend_native_shader_module_release(0, 0),   0, "shmod_release no-op");
    # Buffer create/release reject null (full behaviour in the X.1/X.2 tests).
    assert_eq(_backend_native_buffer_create(0, 0, 0), 0, "buffer_create null ctx -> 0");
    assert_eq(_backend_native_buffer_release(0, 0),   0, "buffer_release null -> 0");
    return 0;
}

# Audit MED-7: stability contract — once `gpu_context_new_native`
# stashes the PM4 scratch ptr at +112, every dispatch reads the same
# value through `native_ctx_pm4_scratch`. The accessor never re-allocs
# under us; if it does, this assertion catches the regression.
fn test_native_ctx_pm4_scratch_is_stable() {
    var ctx[120];
    memset(&ctx, 0, 120);
    # Sentinel ptr stashed once; two consecutive accessor calls
    # return the same address (no per-call alloc).
    store64(&ctx + 112, 0xCAFEBABE);
    var p1 = native_ctx_pm4_scratch(&ctx);
    var p2 = native_ctx_pm4_scratch(&ctx);
    assert_eq(p1, 0xCAFEBABE, "scratch read");
    assert_eq(p2, 0xCAFEBABE, "scratch stable across calls");
    assert_eq(p1, p2, "two reads identical");
    # wgpu-side ctx leaves +112 as 0 — accessor returns 0, slot
    # short-circuits with GPU_ERR_OTHER (already covered by the
    # dispatch fns' explicit `if (pm4 == 0)` guards).
    memset(&ctx, 0, 120);
    assert_eq(native_ctx_pm4_scratch(&ctx), 0, "wgpu/zero ctx → 0");
    return 0;
}

fn test_gpu_ctx_native_card_fd_round_trip() {
    var ctx[112];
    memset(&ctx, 0, 112);
    assert_eq(gpu_ctx_native_card_fd(&ctx), 0, "starts zero");
    gpu_ctx_set_native_card_fd(&ctx, 42);
    assert_eq(gpu_ctx_native_card_fd(&ctx), 42, "round-trip");
    assert_eq(gpu_ctx_set_native_card_fd(0, 7), -1, "null ctx → -1");
    return 0;
}

# v3 audit 2026-04-30 — MED-3: native_rt_create_2d_rgba8 must reject
# odd width/height because native_pm4_build_render_pass_target's
# viewport math uses integer (rt_width / 2). Rejection happens in the
# allocator BEFORE any ioctl, so a fake fd is fine — the dim guard
# fires first.
fn test_native_rt_create_rejects_odd_dims() {
    var out[40];
    memset(&out, 0, 40);
    var fake_fd = 999;
    assert_eq(native_rt_create_2d_rgba8(fake_fd, 3,  4, &out),
    GPU_ERR_TEXTURE_DIMENSION, "odd width rejected");
    assert_eq(native_rt_create_2d_rgba8(fake_fd, 4,  5, &out),
    GPU_ERR_TEXTURE_DIMENSION, "odd height rejected");
    assert_eq(native_rt_create_2d_rgba8(fake_fd, 1,  2, &out),
    GPU_ERR_TEXTURE_DIMENSION, "1x2 width is odd");
    assert_eq(native_rt_create_2d_rgba8(fake_fd, 2,  1, &out),
    GPU_ERR_TEXTURE_DIMENSION, "2x1 height is odd");
    assert_eq(native_rt_create_2d_rgba8(fake_fd, 7, 13, &out),
    GPU_ERR_TEXTURE_DIMENSION, "both odd rejected");
    return 0;
}

fn test_native_rt_create_rejects_nonpositive_dims() {
    var out[40];
    memset(&out, 0, 40);
    var fake_fd = 999;
    assert_eq(native_rt_create_2d_rgba8(fake_fd,  0,  4, &out),
    GPU_ERR_TEXTURE_DIMENSION, "zero width");
    assert_eq(native_rt_create_2d_rgba8(fake_fd,  4,  0, &out),
    GPU_ERR_TEXTURE_DIMENSION, "zero height");
    assert_eq(native_rt_create_2d_rgba8(fake_fd, -2,  4, &out),
    GPU_ERR_TEXTURE_DIMENSION, "negative width");
    assert_eq(native_rt_create_2d_rgba8(fake_fd,  4, -2, &out),
    GPU_ERR_TEXTURE_DIMENSION, "negative height");
    return 0;
}

