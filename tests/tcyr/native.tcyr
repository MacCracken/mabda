    assert_eq(R_PA_CL_VPORT_YOFFSET, 0xA448, "VPORT_YOFFSET byte addr");
    assert_eq(R_PA_CL_VPORT_ZSCALE,  0xA44C, "VPORT_ZSCALE byte addr");
