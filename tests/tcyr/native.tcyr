    alloc_init();
    color_init();
    test_native_ioc_encode_directions();
    test_native_ioc_encode_size_in_bits_16_to_29();
    test_native_ioc_encode_type_and_nr();
    test_native_render_node_path();
    test_native_amdgpu_ioctl_nr_offsets();
    test_native_gem_create_ioctl_encoding();
    test_native_gem_mmap_ioctl_encoding();
    test_native_gem_close_ioctl_encoding();
    test_native_amdgpu_gem_domains();
    test_native_gem_create_request_layout();
    test_native_gem_mmap_request_layout();
    test_native_phase_b3a_nr_offsets();
    test_native_ctx_ioctl_encoding();
    test_native_bo_list_ioctl_encoding();
    test_native_gem_va_ioctl_encoding();
    test_native_struct_sizes();
    test_native_ctx_opcodes();
    test_native_bo_list_opcodes();
    test_native_va_opcodes_and_flags();
    test_native_bo_list_entry_layout();
