    assert_eq(R_CB_COLOR0_INFO,        0xAC70, "CB_COLOR0_INFO byte addr");
    assert_eq(R_CB_COLOR0_ATTRIB,      0xAC74, "CB_COLOR0_ATTRIB byte addr");
