# ================================================================
# v3 Phase B.3.b — PM4 packet builder
# ================================================================

fn test_native_pm4_opcodes() {
    assert_eq(IT_NOP,             0x10, "IT_NOP opcode");
    assert_eq(IT_SET_SH_REG,      0x76, "IT_SET_SH_REG opcode");
    assert_eq(IT_DISPATCH_DIRECT, 0x15, "IT_DISPATCH_DIRECT opcode");
    assert_eq(IT_ACQUIRE_MEM,     0x58, "IT_ACQUIRE_MEM opcode");
    assert_eq(IT_RELEASE_MEM,     0x49, "IT_RELEASE_MEM opcode");
    assert_eq(IT_EVENT_WRITE,     0x46, "IT_EVENT_WRITE opcode");
    return 0;
}

fn test_native_sh_reg_byte_offsets() {
    # Offsets verified against Mesa rusticl AMD_DEBUG=ib dump on
    # gfx90c (Cezanne APU). The whole block lives at 0xB830-0xB868.
    assert_eq(R_COMPUTE_DISPATCH_INITIATOR, 0xB800, "DISPATCH_INITIATOR byte offset");
    assert_eq(R_COMPUTE_NUM_THREAD_X,       0xB81C, "NUM_THREAD_X byte offset");
    assert_eq(R_COMPUTE_NUM_THREAD_Y,       0xB820, "NUM_THREAD_Y byte offset");
    assert_eq(R_COMPUTE_NUM_THREAD_Z,       0xB824, "NUM_THREAD_Z byte offset");
    assert_eq(R_COMPUTE_PGM_LO,             0xB830, "COMPUTE_PGM_LO byte offset");
    assert_eq(R_COMPUTE_PGM_HI,             0xB834, "COMPUTE_PGM_HI byte offset");
    assert_eq(R_COMPUTE_PGM_RSRC1,          0xB848, "PGM_RSRC1 byte offset");
    assert_eq(R_COMPUTE_PGM_RSRC2,          0xB84C, "PGM_RSRC2 byte offset");
    assert_eq(R_COMPUTE_USER_DATA_0,        0xB900, "USER_DATA_0 byte offset");
    return 0;
}

fn test_native_sh_reg_offset_encoding() {
    # (byte_offset - 0xB000) / 4; values cross-checked against
    # Mesa AMD_DEBUG=ib dump.
    assert_eq(native_sh_reg_offset(R_COMPUTE_DISPATCH_INITIATOR), 0x200, "DISPATCH_INITIATOR → 0x200");
    assert_eq(native_sh_reg_offset(R_COMPUTE_NUM_THREAD_X),       0x207, "NUM_THREAD_X → 0x207");
    assert_eq(native_sh_reg_offset(R_COMPUTE_PGM_LO),             0x20C, "PGM_LO → 0x20C");
    assert_eq(native_sh_reg_offset(R_COMPUTE_PGM_HI),             0x20D, "PGM_HI → 0x20D");
    assert_eq(native_sh_reg_offset(R_COMPUTE_PGM_RSRC1),          0x212, "PGM_RSRC1 → 0x212");
    assert_eq(native_sh_reg_offset(R_COMPUTE_PGM_RSRC2),          0x213, "PGM_RSRC2 → 0x213");
    assert_eq(native_sh_reg_offset(R_COMPUTE_USER_DATA_0),        0x240, "USER_DATA_0 → 0x240");
    return 0;
}

fn test_native_pm4_pkt3_header() {
    # PKT3(IT_NOP, 1, 0): type=3, count=0, opcode=0x10, predicate=0.
    # Expected: (3<<30) | (0<<16) | (0x10<<8) | 0 = 0xC0001000
    assert_eq(native_pm4_pkt3_header(IT_NOP, 1, 0), 0xC0001000, "NOP count=1");
    # PKT3(IT_SET_SH_REG, 2, 0): count-1=1, opcode=0x76.
    # Expected: (3<<30) | (1<<16) | (0x76<<8) | 0 = 0xC0017600
    assert_eq(native_pm4_pkt3_header(IT_SET_SH_REG, 2, 0), 0xC0017600, "SET_SH_REG count=2");
    # PKT3(IT_DISPATCH_DIRECT, 4, 0): count-1=3, opcode=0x15.
    # Expected: (3<<30) | (3<<16) | (0x15<<8) | 0 = 0xC0031500
    assert_eq(native_pm4_pkt3_header(IT_DISPATCH_DIRECT, 4, 0), 0xC0031500, "DISPATCH_DIRECT count=4");
    # Predicate bit in the low byte.
    assert_eq(native_pm4_pkt3_header(IT_NOP, 1, 1), 0xC0001001, "predicate bit set");
    return 0;
}

fn test_native_pm4_set_sh_reg_one_layout() {
    # Setting one register: header + offset + value = 3 dwords.
    var buf[64];
    memset(&buf, 0, 64);
    var pos = native_pm4_set_sh_reg_one(&buf, 0, R_COMPUTE_PGM_LO, 0xDEADBEEF);
    assert_eq(pos, 12, "SET_SH_REG one = 3 dwords = 12 bytes");
    # Header: PKT3(IT_SET_SH_REG, count=2, 0) = 0xC0017600.
    assert_eq(load32(&buf + 0), 0xC0017600, "header");
    # Register offset (SH-reg form): 0x212.
    assert_eq(load32(&buf + 4), 0x20C, "SH-reg offset for PGM_LO");
    # Value we wrote.
    assert_eq(load32(&buf + 8), 0xDEADBEEF, "value");
    return 0;
}

fn test_native_pm4_set_sh_reg_multi_layout() {
    # Setting 3 contiguous regs (PGM_LO, PGM_HI, PGM_RSRC1): header +
    # offset + 3 values = 5 dwords.
    var vals[12];
    store32(&vals + 0, 0x1111);
    store32(&vals + 4, 0x2222);
    store32(&vals + 8, 0x3333);
    var buf[64];
    memset(&buf, 0, 64);
    var pos = native_pm4_set_sh_reg(&buf, 0, R_COMPUTE_PGM_LO, 3, &vals);
    assert_eq(pos, 20, "3-reg SET = 5 dwords = 20 bytes");
    # Header: PKT3(IT_SET_SH_REG, count=4, 0) — count-1 = 3 → (3<<16) | (0x76<<8) | 0xC0000000 = 0xC0037600.
    assert_eq(load32(&buf + 0),  0xC0037600, "header for 3 regs");
    assert_eq(load32(&buf + 4),  0x20C,      "SH-reg offset for PGM_LO base");
    assert_eq(load32(&buf + 8),  0x1111,     "value 1");
    assert_eq(load32(&buf + 12), 0x2222,     "value 2");
    assert_eq(load32(&buf + 16), 0x3333,     "value 3");
    return 0;
}

fn test_native_pm4_dispatch_direct_layout() {
    # DISPATCH_DIRECT: header + 4 data dwords = 5 dwords = 20 bytes.
    var buf[64];
    memset(&buf, 0, 64);
    var pos = native_pm4_dispatch_direct(&buf, 0, 8, 4, 2, COMPUTE_DISPATCH_INITIATOR_MIN);
    assert_eq(pos, 20, "DISPATCH_DIRECT = 5 dwords");
    # Header: PKT3(IT_DISPATCH_DIRECT, 4, shader_type=2) = 0xC0031502.
    # Low byte is shader_type (compute), not predicate — verified against
    # Mesa AMD_DEBUG=ib: `c0031502`.
    assert_eq(load32(&buf + 0),  0xC0031502, "header (shader_type=compute)");
    assert_eq(load32(&buf + 4),  8, "dim_x");
    assert_eq(load32(&buf + 8),  4, "dim_y");
    assert_eq(load32(&buf + 12), 2, "dim_z");
    assert_eq(load32(&buf + 16), 1, "initiator (COMPUTE_SHADER_EN)");
    return 0;
}

fn test_native_pm4_acquire_mem_layout() {
    # ACQUIRE_MEM on GFX9 (shader_type=compute): header + 6 data dwords
    # = 7 dwords = 28 bytes. Mesa emits header c0055802:
    #   type=3, count-1=5 (6 data dwords), opcode=0x58, shader_type=2.
    var buf[64];
    memset(&buf, 0, 64);
    var pos = native_pm4_acquire_mem_full_invalidate(&buf, 0);
    assert_eq(pos, 28, "ACQUIRE_MEM = 7 dwords = 28 bytes");
    # Header must exactly match Mesa's byte-for-byte or the CP
    # misreads the dword count and desynchronizes the IB stream.
    assert_eq(load32(&buf + 0),  0xC0055802, "header byte-exact Mesa match");
    # coher_cntl = 0x28C40000 — RADV-captured byte-exact. Bit 31
    # (TC_NC_ACTION_ENA) was dropped 2026-05-13 to fix the GFX-ring
    # TDR; see backend_native_pm4.cyr:_for_ring helper for the why.
    assert_eq(load32(&buf + 4),  0x28C40000, "coher_cntl");
    assert_eq(load32(&buf + 8),  0xFFFFFFFF, "coher_size_lo");
    assert_eq(load32(&buf + 12), 0x00FFFFFF, "coher_size_hi");
    assert_eq(load32(&buf + 16), 0,          "coher_base_lo");
    assert_eq(load32(&buf + 20), 0,          "coher_base_hi");
    assert_eq(load32(&buf + 24), 0x0A,       "poll_interval");
    return 0;
}

fn test_native_pm4_nop_padding() {
    # Encoding contract (Session 25b — see CHANGELOG [3.0.0-dev]):
    # pad_dwords is the TOTAL packet size in dwords (header + body).
    # Body = pad_dwords - 1 filler dwords; header encodes count_minus_1
    # = pad_dwords - 2 (because pkt3_header subtracts another 1 from
    # the count argument). Minimum useful pad_dwords = 2.
    # NOP with pad_dwords=4: header + 3 filler dwords = 4 dwords = 16 bytes.
    var buf[64];
    memset(&buf, 0xFF, 64);
    var pos = native_pm4_nop(&buf, 0, 4);
    assert_eq(pos, 16, "NOP pad=4 → 16 bytes");
    # Header: PKT3(IT_NOP, count=3, 0) → wire count_minus_1 = 2.
    # = (3<<30) | (2<<16) | (0x10<<8) = 0xC0021000.
    assert_eq(load32(&buf + 0),  0xC0021000, "NOP pad=4 header");
    # Filler dwords zeroed.
    assert_eq(load32(&buf + 4),  0, "filler 1");
    assert_eq(load32(&buf + 8),  0, "filler 2");
    assert_eq(load32(&buf + 12), 0, "filler 3");
    # NOP with pad_dwords=2 (minimum useful): header + 1 filler = 2 dwords.
    # Wire count_minus_1 = 0; header = 0xC0001000.
    memset(&buf, 0xFF, 64);
    pos = native_pm4_nop(&buf, 0, 2);
    assert_eq(pos, 8, "NOP pad=2 → 8 bytes");
    assert_eq(load32(&buf + 0), 0xC0001000, "NOP pad=2 header");
    assert_eq(load32(&buf + 4), 0,          "NOP pad=2 filler");
    # NOP with pad_dwords=1 is rejected (no body slot to claim);
    # function returns pos unchanged and writes nothing.
    memset(&buf, 0xFF, 64);
    pos = native_pm4_nop(&buf, 0, 1);
    assert_eq(pos, 0, "NOP pad=1 rejected (returns pos unchanged)");
    assert_eq(load32(&buf + 0), 0xFFFFFFFF, "NOP pad=1 wrote nothing");
    return 0;
}

fn test_native_gfx9_shader_constants() {
    # s_endpgm (SOPP format): 0xBF810000 on GFX9. Stable across GFX6-11.
    assert_eq(GFX9_S_ENDPGM, 0xBF810000, "s_endpgm encoding");
    # PGM_RSRC1: FLOAT_MODE=0xC0 | SGPRS=1 | DX10_CLAMP=1 (IEEE_MODE=0
    # per Mesa rusticl verified dump on gfx90c).
    # = (0xC0 << 12) | (1 << 6) | (1 << 21) = 0x002C0040.
    assert_eq(GFX9_COMPUTE_PGM_RSRC1_MIN, 0x2C0040, "RSRC1 = 0x002C0040 (matches Mesa rusticl)");
    assert_eq(GFX9_COMPUTE_PGM_RSRC2_MIN, 0, "RSRC2 min (no user SGPR / scratch / LDS)");
    # DISPATCH_INITIATOR: 0x45 (Mesa-verified).
    assert_eq(GFX9_DISPATCH_INITIATOR, 0x45, "DISPATCH_INITIATOR = 0x45");
    return 0;
}

fn test_native_gfx9_extended_register_offsets() {
    # Offsets from Mesa AMD_DEBUG=ib dump on gfx90c.
    assert_eq(R_COMPUTE_RESOURCE_LIMITS,        0xB854, "RESOURCE_LIMITS byte offset");
    assert_eq(R_COMPUTE_STATIC_THREAD_MGMT_SE0, 0xB858, "STATIC_THREAD_MGMT_SE0");
    assert_eq(R_COMPUTE_STATIC_THREAD_MGMT_SE1, 0xB85C, "STATIC_THREAD_MGMT_SE1");
    assert_eq(R_COMPUTE_TMPRING_SIZE,           0xB860, "TMPRING_SIZE");
    assert_eq(R_COMPUTE_STATIC_THREAD_MGMT_SE2, 0xB864, "STATIC_THREAD_MGMT_SE2");
    assert_eq(R_COMPUTE_STATIC_THREAD_MGMT_SE3, 0xB868, "STATIC_THREAD_MGMT_SE3");
    return 0;
}

fn test_native_gfx9_shader_endpgm_writes_bytes() {
    var buf[16];
    memset(&buf, 0xFF, 16);
    var pos = native_gfx9_shader_endpgm(&buf, 0);
    assert_eq(pos, 4, "endpgm wrote 4 bytes");
    assert_eq(load32(&buf + 0), 0xBF810000, "endpgm bytes");
    return 0;
}

fn test_native_gfx9_shader_store_deadbeef_writes_bytes() {
    # Byte-exact assertion against clang -target amdgcn--amdhsa
    # -mcpu=gfx90c output. If clang's encoding of any of these
    # instructions ever changes (unlikely for a stable ISA), this
    # test is the canary.
    var buf[128];
    memset(&buf, 0xFF, 128);
    var pos = native_gfx9_shader_store_deadbeef(&buf, 0);
    assert_eq(pos, 96, "store shader total = 32 B instr + 64 B NOP pad");
    assert_eq(load32(&buf +  0), 0x7E000200, "v_mov_b32_e32 v0, s0");
    assert_eq(load32(&buf +  4), 0x7E020201, "v_mov_b32_e32 v1, s1");
    assert_eq(load32(&buf +  8), 0x7E0402FF, "v_mov_b32_e32 v2, <literal>");
    assert_eq(load32(&buf + 12), 0xDEADBEEF, "literal 0xDEADBEEF");
    assert_eq(load32(&buf + 16), 0xDC738000, "global_store_dword dword 1 (FLAT + glc + slc)");
    assert_eq(load32(&buf + 20), 0x007F0200, "global_store_dword dword 2 (addr=v0 data=v2 saddr=off)");
    assert_eq(load32(&buf + 24), 0xBF8C0070, "s_waitcnt vmcnt(0) lgkmcnt(0)");
    assert_eq(load32(&buf + 28), 0xBF810000, "s_endpgm");
    assert_eq(load32(&buf + 32), 0xBF800000, "NOP pad [0]");
    assert_eq(load32(&buf + 92), 0xBF800000, "NOP pad [15]");
    return 0;
}

fn test_native_syncobj_ioctl_encodings() {
    # All three are _IOWR('d', nr, struct syncobj_*).
    var create_expected  = native_ioc_encode(3, DRM_SYNCOBJ_CREATE_SIZE,  DRM_IOCTL_TYPE, 0xBF);
    var destroy_expected = native_ioc_encode(3, DRM_SYNCOBJ_DESTROY_SIZE, DRM_IOCTL_TYPE, 0xC0);
    var wait_expected    = native_ioc_encode(3, DRM_SYNCOBJ_WAIT_SIZE,    DRM_IOCTL_TYPE, 0xC3);
    assert_eq(DRM_IOCTL_SYNCOBJ_CREATE,  create_expected,  "SYNCOBJ_CREATE ioctl");
    assert_eq(DRM_IOCTL_SYNCOBJ_DESTROY, destroy_expected, "SYNCOBJ_DESTROY ioctl");
    assert_eq(DRM_IOCTL_SYNCOBJ_WAIT,    wait_expected,    "SYNCOBJ_WAIT ioctl");
    assert_eq(DRM_IOCTL_SYNCOBJ_CREATE,  0xC00864BF, "SYNCOBJ_CREATE = 0xC00864BF");
    assert_eq(DRM_IOCTL_SYNCOBJ_DESTROY, 0xC00864C0, "SYNCOBJ_DESTROY = 0xC00864C0");
    assert_eq(DRM_IOCTL_SYNCOBJ_WAIT,    0xC02864C3, "SYNCOBJ_WAIT = 0xC02864C3 (40-byte struct)");
    return 0;
}

fn test_native_syncobj_sizes_and_flags() {
    assert_eq(DRM_SYNCOBJ_CREATE_SIZE,  8,  "syncobj_create = 8");
    assert_eq(DRM_SYNCOBJ_DESTROY_SIZE, 8,  "syncobj_destroy = 8");
    assert_eq(DRM_SYNCOBJ_WAIT_SIZE,    40, "syncobj_wait = 40");
    assert_eq(DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL,        0x1, "WAIT_ALL = 0x1");
    assert_eq(DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT, 0x2, "WAIT_FOR_SUBMIT = 0x2");
    return 0;
}

fn test_native_cs_ioctl_encoding() {
    var expected = native_ioc_encode(3, DRM_AMDGPU_CS_SIZE, DRM_IOCTL_TYPE,
    DRM_COMMAND_BASE + DRM_AMDGPU_CS);
    assert_eq(DRM_IOCTL_AMDGPU_CS, expected, "AMDGPU_CS ioctl");
    assert_eq(DRM_IOCTL_AMDGPU_CS, 0xC0186444, "precomputed constant");
    assert_eq(DRM_AMDGPU_CS, 0x04, "CS nr offset");
    return 0;
}

fn test_native_cs_struct_sizes() {
    assert_eq(DRM_AMDGPU_CS_SIZE,               24, "union drm_amdgpu_cs = 24");
    assert_eq(DRM_AMDGPU_CS_CHUNK_SIZE,         16, "drm_amdgpu_cs_chunk = 16");
    assert_eq(DRM_AMDGPU_CS_CHUNK_IB_SIZE,      32, "drm_amdgpu_cs_chunk_ib = 32");
    # _sem struct: u32 handle only, used by SYNCOBJ_OUT / SYNCOBJ_IN /
    # DEPENDENCIES / SCHEDULED_DEPENDENCIES chunks.
    assert_eq(DRM_AMDGPU_CS_CHUNK_SEM_SIZE,      4, "drm_amdgpu_cs_chunk_sem = 4");
    # _syncobj struct: 16 bytes, used by SYNCOBJ_TIMELINE_WAIT/SIGNAL only.
    assert_eq(DRM_AMDGPU_CS_CHUNK_SYNCOBJ_SIZE, 16, "drm_amdgpu_cs_chunk_syncobj = 16");
    return 0;
}

fn test_native_cs_chunk_ids_and_ip_types() {
    assert_eq(AMDGPU_CHUNK_ID_IB,          0x01, "CHUNK_ID_IB");
    assert_eq(AMDGPU_CHUNK_ID_FENCE,       0x02, "CHUNK_ID_FENCE");
    assert_eq(AMDGPU_CHUNK_ID_SYNCOBJ_OUT, 0x05, "CHUNK_ID_SYNCOBJ_OUT");
    assert_eq(AMDGPU_HW_IP_GFX,     0, "HW_IP_GFX");
    assert_eq(AMDGPU_HW_IP_COMPUTE, 1, "HW_IP_COMPUTE");
    return 0;
}

# ================================================================
# v3.1 Q.3a — timeline syncobj ABI
# ================================================================
fn test_native_timeline_ioctl_encodings() {
    # _IOWR('d', nr, struct ..) — cross-check the precomputed constants
    # against native_ioc_encode and the C-verified literals.
    var wait_expected  = native_ioc_encode(3, DRM_SYNCOBJ_TIMELINE_WAIT_SIZE,
    DRM_IOCTL_TYPE, 0xCA);
    var query_expected = native_ioc_encode(3, DRM_SYNCOBJ_TIMELINE_ARRAY_SIZE,
    DRM_IOCTL_TYPE, 0xCB);
    assert_eq(DRM_IOCTL_SYNCOBJ_TIMELINE_WAIT, wait_expected,
    "TIMELINE_WAIT ioctl via encode");
    assert_eq(DRM_IOCTL_SYNCOBJ_QUERY, query_expected,
    "SYNCOBJ_QUERY ioctl via encode");
    assert_eq(DRM_IOCTL_SYNCOBJ_TIMELINE_WAIT, 0xC03064CA,
    "TIMELINE_WAIT = 0xC03064CA (48-byte struct)");
    assert_eq(DRM_IOCTL_SYNCOBJ_QUERY, 0xC01864CB,
    "SYNCOBJ_QUERY = 0xC01864CB (24-byte struct)");
    return 0;
}

fn test_native_timeline_struct_sizes_and_chunk_ids() {
    assert_eq(DRM_SYNCOBJ_TIMELINE_WAIT_SIZE,  48,
    "drm_syncobj_timeline_wait = 48");
    assert_eq(DRM_SYNCOBJ_TIMELINE_ARRAY_SIZE, 24,
    "drm_syncobj_timeline_array = 24");
    assert_eq(AMDGPU_CHUNK_ID_SYNCOBJ_IN,            0x04, "CHUNK_ID_SYNCOBJ_IN");
    assert_eq(AMDGPU_CHUNK_ID_SYNCOBJ_TIMELINE_WAIT,   0x08, "CHUNK_ID_TIMELINE_WAIT");
    assert_eq(AMDGPU_CHUNK_ID_SYNCOBJ_TIMELINE_SIGNAL, 0x09, "CHUNK_ID_TIMELINE_SIGNAL");
    return 0;
}

fn test_native_cs_chunk_syncobj_layout() {
    # drm_amdgpu_cs_chunk_syncobj = {handle u32, flags u32, point u64}.
    var buf[16];
    memset(&buf, 0, 16);
    native_build_cs_chunk_syncobj(&buf, 0x1234, 0, 0x123456789);
    assert_eq(load32(&buf + 0), 0x1234,     "handle at +0");
    assert_eq(load32(&buf + 4), 0,          "flags at +4");
    assert_eq(load64(&buf + 8), 0x123456789, "point (u64) at +8 spans 32-bit boundary");
    # Non-zero flags + small point round-trip.
    native_build_cs_chunk_syncobj(&buf, 0xABCD, 0x2, 7);
    assert_eq(load32(&buf + 0), 0xABCD, "handle overwritten");
    assert_eq(load32(&buf + 4), 0x2,    "flags round-trip");
    assert_eq(load64(&buf + 8), 7,      "point round-trip");
    return 0;
}

fn test_native_sdma_copy_linear_layout() {
    # SDMA v4 COPY_LINEAR: 7 dwords, count = bytes-1, canonical-high VA
    # halves packed via the logical >>.
    var buf[28];
    memset(&buf, 0, 28);
    var n = native_sdma_build_copy_linear(&buf, 0xFFFF800100400000,
    0xAABB0000CCDD0000, 4096);
    assert_eq(n, 28, "SDMA copy linear = 28 bytes (7 dw)");
    assert_eq(load32(&buf + 0),  0x1,        "header: op=COPY(1) sub_op=LINEAR(0)");
    assert_eq(load32(&buf + 4),  4095,       "count = bytes - 1");
    assert_eq(load32(&buf + 8),  0,          "params = 0");
    assert_eq(load32(&buf + 12), 0x00400000, "src_lo");
    assert_eq(load32(&buf + 16), 0xFFFF8001, "src_hi (logical >>32, canonical-high)");
    assert_eq(load32(&buf + 20), 0xCCDD0000, "dst_lo");
    assert_eq(load32(&buf + 24), 0xAABB0000, "dst_hi");
    assert_eq(AMDGPU_HW_IP_DMA, 2, "DMA ring = HW_IP 2");
    return 0;
}

fn test_native_cs_submit_timeline_fence_align_guard() {
    # Unaligned fence_offset trips the DWORD-align guard (CVE-2026-46220
    # class) and returns -EINVAL before any ioctl — so the fake fd is
    # never touched.
    var rc = native_cs_submit_timeline(0 - 1, 0, 0, 0, 0, AMDGPU_HW_IP_COMPUTE,
    1, 1, 0, 0, 5, 33, 0);
    assert_eq(rc, 0 - 22, "unaligned fence_offset -> -EINVAL, no syscall");
    return 0;
}

fn test_native_queue_kind_to_ring() {
    assert_eq(_native_queue_kind_to_ring(QUEUE_KIND_GRAPHICS), AMDGPU_HW_IP_GFX,
    "GRAPHICS -> GFX ring");
    assert_eq(_native_queue_kind_to_ring(QUEUE_KIND_COMPUTE), AMDGPU_HW_IP_COMPUTE,
    "COMPUTE -> COMPUTE ring");
    assert_eq(_native_queue_kind_to_ring(QUEUE_KIND_TRANSFER), AMDGPU_HW_IP_DMA,
    "TRANSFER -> DMA ring (v3.2 X.3)");
    assert_eq(_native_queue_kind_to_ring(99), 0 - 1, "bad kind -> -1");
    return 0;
}

# v3.2 X.3 — a compute dispatch targeted at a DMA-ring (TRANSFER) queue is
# rejected with GPU_ERR_TRANSFER before any PM4/ioctl (SDMA can't run PM4).
fn test_native_compute_dispatch_on_dma_queue_rejected() {
    assert_eq(GPU_ERR_TRANSFER, 20, "GPU_ERR_TRANSFER = 20");
    assert(strlen(gpu_err_name(GPU_ERR_TRANSFER)) > 0, "has an error string");
    var ctx[160];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    var q = queue_new(QUEUE_KIND_TRANSFER);
    queue_set_ring(q, AMDGPU_HW_IP_DMA);
    gpu_ctx_set_current_queue(&ctx, q);
    var shmod[16];
    native_buf_pair_write(&shmod, 0x111, 0x222);
    var bp[16];
    native_buf_pair_write(&bp, 0x333, 0x444);
    assert_eq(_backend_native_compute_dispatch(&ctx, &shmod, 1, 1, 1, &bp),
    GPU_ERR_TRANSFER, "compute on DMA-ring queue -> GPU_ERR_TRANSFER");
    return 0;
}

# v3.2 X.4 — SDMA buffer-copy timeline driver: guard ladder + the
# point-bump / pending-wait-consume bookkeeping on the full path
# (fake fd makes the submit fail without HW).

# v3.2 TS.1 — T# image descriptor: every dword + field pinned against the
# gfx9.json SQ_IMG_RSRC_WORD0..6 bit layout + SQ_SEL/IMG_TYPE enums.
fn test_native_gfx9_image_descriptor() {
    var buf[32];
    memset(&buf, 0, 32);
    # RGBA8 2D, 256x256, LINEAR, single level, canonical-high VA.
    var end = native_gfx9_image_descriptor(&buf, 0, 0xFFFF800180000000,
    256, 256, MABDA_TEXFMT_RGBA8, GFX9_SW_MODE_LINEAR, 1);
    assert_eq(end, 32, "returns pos + 32");
    var w0 = load32(&buf + 0);
    var w1 = load32(&buf + 4);
    var w2 = load32(&buf + 8);
    var w3 = load32(&buf + 12);
    var w4 = load32(&buf + 16);
    var w5 = load32(&buf + 20);
    assert_eq(w0, 0x01800000, "W0 = va[39:8]");
    assert_eq(w1 & 0xFF, 0x80, "W1 BASE_ADDRESS_HI[0:7] = va[47:40]");
    assert_eq((w1 >> 20) & 0x3F, 10, "W1 DATA_FORMAT[20:25] = 8_8_8_8(10)");
    assert_eq((w1 >> 26) & 0xF, 0, "W1 NUM_FORMAT[26:29] = UNORM(0)");
    assert_eq(w2 & 0x3FFF, 255, "W2 WIDTH[0:13] = w-1");
    assert_eq((w2 >> 14) & 0x3FFF, 255, "W2 HEIGHT[14:27] = h-1");
    assert_eq(w3 & 0x7, 4, "W3 DST_SEL_X = SQ_SEL_X(4)");
    assert_eq((w3 >> 3) & 0x7, 5, "W3 DST_SEL_Y = SQ_SEL_Y(5)");
    assert_eq((w3 >> 6) & 0x7, 6, "W3 DST_SEL_Z = SQ_SEL_Z(6)");
    assert_eq((w3 >> 9) & 0x7, 7, "W3 DST_SEL_W = SQ_SEL_W(7)");
    assert_eq((w3 >> 16) & 0xF, 0, "W3 LAST_LEVEL = 0 (single level)");
    assert_eq((w3 >> 20) & 0x1F, 0, "W3 SW_MODE = LINEAR(0)");
    assert_eq((w3 >> 28) & 0xF, 9, "W3 TYPE = SQ_RSRC_IMG_2D(9)");
    assert_eq(w4, 0x1FE000, "W4 PITCH[13:28] = (w-1) for linear");
    assert_eq(w5, 0, "W5 MAX_MIP = 0 (single level)");
    assert_eq(load32(&buf + 24), 0, "W6 = 0 (no DCC)");
    assert_eq(load32(&buf + 28), 0, "W7 = 0 (no meta)");
    # BC1 swaps only the DATA_FORMAT field.
    memset(&buf, 0, 32);
    native_gfx9_image_descriptor(&buf, 0, 0xFFFF800180000000,
    256, 256, MABDA_TEXFMT_BC1, GFX9_SW_MODE_LINEAR, 1);
    assert_eq((load32(&buf + 4) >> 20) & 0x3F, 35, "BC1 DATA_FORMAT = 35");
    # 4-level mip: LAST_LEVEL + MAX_MIP both = 3.
    memset(&buf, 0, 32);
    native_gfx9_image_descriptor(&buf, 0, 0xFFFF800180000000,
    64, 64, MABDA_TEXFMT_RGBA8, GFX9_SW_MODE_LINEAR, 4);
    assert_eq((load32(&buf + 12) >> 16) & 0xF, 3, "4-level LAST_LEVEL = 3");
    assert_eq((load32(&buf + 20) >> 28) & 0xF, 3, "4-level MAX_MIP = 3");
    # Rejections.
    assert_eq(native_gfx9_image_descriptor(&buf, 0, 0xFFFF800180000000,
    256, 256, 99, GFX9_SW_MODE_LINEAR, 1), 0 - 1, "unsupported fmt -> -1");
    assert_eq(native_gfx9_image_descriptor(&buf, 0, 0xFFFF800180000000,
    0, 256, MABDA_TEXFMT_RGBA8, GFX9_SW_MODE_LINEAR, 1), 0 - 1, "w<=0 -> -1");
    return 0;
}

# v3.2 TS.2 — format->IMG-format table: every row pinned against the
# gfx9.json IMG_DATA_FORMAT / IMG_NUM_FORMAT enum values.
fn test_native_gfx9_texfmt_to_img_format() {
    assert_eq(native_gfx9_texfmt_to_img_format(MABDA_TEXFMT_RGBA8), 0xA00,
    "RGBA8 -> 8_8_8_8(10)/UNORM(0)");
    assert_eq(native_gfx9_texfmt_to_img_format(MABDA_TEXFMT_BC1),  0x2300, "BC1 -> 35");
    assert_eq(native_gfx9_texfmt_to_img_format(MABDA_TEXFMT_BC3),  0x2500, "BC3 -> 37");
    assert_eq(native_gfx9_texfmt_to_img_format(MABDA_TEXFMT_BC4),  0x2600, "BC4 -> 38");
    assert_eq(native_gfx9_texfmt_to_img_format(MABDA_TEXFMT_BC5),  0x2700, "BC5 -> 39");
    assert_eq(native_gfx9_texfmt_to_img_format(MABDA_TEXFMT_BC6H), 0x2807, "BC6H -> 40/FLOAT(7)");
    assert_eq(native_gfx9_texfmt_to_img_format(MABDA_TEXFMT_BC7),  0x2900, "BC7 -> 41");
    assert_eq(native_gfx9_texfmt_to_img_format(MABDA_TEXFMT_ETC2_RGB8),  0x1800, "ETC2_RGB -> 24");
    assert_eq(native_gfx9_texfmt_to_img_format(MABDA_TEXFMT_ETC2_RGBA8), 0x1900, "ETC2_RGBA -> 25");
    assert_eq(native_gfx9_texfmt_to_img_format(MABDA_TEXFMT_ASTC_4X4), 0x2E00, "ASTC_4x4 -> 46");
    assert_eq(native_gfx9_texfmt_to_img_format(MABDA_TEXFMT_ASTC_8X8), 0x2E00, "ASTC_8x8 -> 46");
    assert_eq(native_gfx9_texfmt_to_img_format(99), 0 - 1, "unsupported -> -1");
    # accessors unpack the packed (df, nf) pair.
    var p = native_gfx9_texfmt_to_img_format(MABDA_TEXFMT_BC6H);
    assert_eq(native_img_data_format(p), 40, "BC6H data_format = 40");
    assert_eq(native_img_num_format(p), 7, "BC6H num_format = FLOAT(7)");
    assert_eq(native_img_data_format(native_gfx9_texfmt_to_img_format(MABDA_TEXFMT_RGBA8)),
    10, "RGBA8 data_format = 10");
    return 0;
}

# v3.2 TS.2 — S# sampler descriptor: every dword pinned against the
# gfx9.json SQ_IMG_SAMP_WORD0..3 bit layout + SQ_TEX_* enum values.
fn test_native_gfx9_sampler_descriptor() {
    var buf[16];
    memset(&buf, 0, 16);
    var end = native_gfx9_sampler_descriptor(&buf, 0,
    NATIVE_SAMP_FILTER_POINT, NATIVE_SAMP_ADDR_CLAMP);
    assert_eq(end, 16, "returns pos + 16");
    var w0 = load32(&buf + 0);
    var w1 = load32(&buf + 4);
    var w2 = load32(&buf + 8);
    var w3 = load32(&buf + 12);
    assert_eq(w0, 0x92, "point+clamp W0 (CLAMP_X/Y/Z = LAST_TEXEL)");
    assert_eq(w0 & 0x7, 2, "CLAMP_X[0:2] = LAST_TEXEL(2)");
    assert_eq((w0 >> 3) & 0x7, 2, "CLAMP_Y[3:5] = 2");
    assert_eq((w0 >> 6) & 0x7, 2, "CLAMP_Z[6:8] = 2");
    assert_eq((w0 >> 29) & 0x3, 0, "FILTER_MODE[29:30] = BLEND(0)");
    assert_eq(w1, 0xFFF000, "W1 MIN_LOD=0 MAX_LOD[12:23]=0xFFF");
    assert_eq(w2, 0, "point: XY_MAG/MIN_FILTER = POINT(0)");
    assert_eq(w3, 0, "W3 = 0 (BORDER_COLOR_TYPE TRANS_BLACK)");
    # bilinear + wrap: CLAMP -> WRAP(0), XY filters -> BILINEAR(1).
    memset(&buf, 0, 16);
    native_gfx9_sampler_descriptor(&buf, 0,
    NATIVE_SAMP_FILTER_BILINEAR, NATIVE_SAMP_ADDR_WRAP);
    var b0 = load32(&buf + 0);
    var b2 = load32(&buf + 8);
    assert_eq(b0, 0, "wrap: CLAMP_X/Y/Z = WRAP(0)");
    assert_eq((b2 >> 20) & 0x3, 1, "XY_MAG_FILTER[20:21] = BILINEAR(1)");
    assert_eq((b2 >> 22) & 0x3, 1, "XY_MIN_FILTER[22:23] = BILINEAR(1)");
    assert_eq(b2, 0x500000, "bilinear W2");
    return 0;
}

# v3.2 X.8 — SDMA COPY_LINEAR chaining: split a copy across N <=4 MiB
# packets with per-chunk VA offsets, and reject (return 0) a chain that
# won't fit the IB. Pure byte-builder, fully CPU-checkable.
fn test_native_sdma_build_copy_chained() {
    assert_eq(_NATIVE_SDMA_COPY_MAX_BYTES, 4194304, "per-packet cap = 4 MiB");
    var buf[128];
    memset(&buf, 0, 128);
    # Single chunk: 4096 bytes -> one 28-byte packet.
    var n1 = native_sdma_build_copy_chained(&buf, 0x1000, 0x9000, 4096, 128);
    assert_eq(n1, 28, "4096B -> 1 packet");
    assert_eq(load32(&buf + 4), 4095, "packet0 count = bytes-1");
    assert_eq(load32(&buf + 12), 0x1000, "packet0 src_lo");
    assert_eq(load32(&buf + 20), 0x9000, "packet0 dst_lo");
    # Two chunks: 4 MiB + 8 -> two packets; 2nd advanced by one full chunk.
    memset(&buf, 0, 128);
    var n2 = native_sdma_build_copy_chained(&buf, 0x1000, 0x9000,
    _NATIVE_SDMA_COPY_MAX_BYTES + 8, 128);
    assert_eq(n2, 56, "4MiB+8 -> 2 packets");
    assert_eq(load32(&buf + 4), _NATIVE_SDMA_COPY_MAX_BYTES - 1, "chunk0 count = 4MiB-1");
    assert_eq(load32(&buf + 12), 0x1000, "chunk0 src_lo");
    assert_eq(load32(&buf + 32), 7, "chunk1 count = 8-1");
    assert_eq(load32(&buf + 40), 0x1000 + _NATIVE_SDMA_COPY_MAX_BYTES,
    "chunk1 src_lo advanced by one chunk");
    assert_eq(load32(&buf + 48), 0x9000 + _NATIVE_SDMA_COPY_MAX_BYTES,
    "chunk1 dst_lo advanced by one chunk");
    # buf_cap fits only one packet but two are needed -> 0 (caller rejects).
    memset(&buf, 0, 128);
    var n3 = native_sdma_build_copy_chained(&buf, 0x1000, 0x9000,
    _NATIVE_SDMA_COPY_MAX_BYTES + 8, 28);
    assert_eq(n3, 0, "chain exceeding buf_cap -> 0");
    return 0;
}

fn test_native_transfer_copy_timeline_driver() {
    var ctx[160];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    # A copy aimed at a non-DMA (compute) queue is a mis-route.
    var qc = queue_new(QUEUE_KIND_COMPUTE);
    queue_set_ring(qc, AMDGPU_HW_IP_COMPUTE);
    queue_set_syncobj(qc, 1);
    assert_eq(native_transfer_copy_timeline(&ctx, 1, 0x100, 2, 0x200, 64, qc),
    GPU_ERR_TRANSFER, "copy on non-DMA queue -> GPU_ERR_TRANSFER");
    assert_eq(native_transfer_copy_timeline(&ctx, 1, 0x100, 2, 0x200, 64, 0),
    GPU_ERR_OTHER, "null queue -> GPU_ERR_OTHER");
    # DMA queue but zero bytes -> GPU_ERR_BUFFER (before syncobj check).
    var qt = queue_new(QUEUE_KIND_TRANSFER);
    queue_set_ring(qt, AMDGPU_HW_IP_DMA);
    queue_set_syncobj(qt, 7);
    assert_eq(native_transfer_copy_timeline(&ctx, 1, 0x100, 2, 0x200, 0, qt),
    GPU_ERR_BUFFER, "zero bytes -> GPU_ERR_BUFFER");
    # DMA queue, no syncobj -> GPU_ERR_OTHER.
    var qns = queue_new(QUEUE_KIND_TRANSFER);
    queue_set_ring(qns, AMDGPU_HW_IP_DMA);
    assert_eq(native_transfer_copy_timeline(&ctx, 1, 0x100, 2, 0x200, 64, qns),
    GPU_ERR_OTHER, "DMA queue, syncobj 0 -> GPU_ERR_OTHER");
    # Full path: DMA queue + syncobj + ib backing + fake fd. The submit
    # fails (no HW) but the queue bookkeeping must still run: timeline
    # point bumped 0->1, the recorded barrier wait consumed.
    queue_set_pending_wait(qt, 0x55, 3);
    store64((&ctx) + 0, 0 - 1);          # fd = -1
    var ib_scratch[4096];
    store64((&ctx) + 64, &ib_scratch);   # ib_addr
    assert_eq(queue_point(qt), 0, "point starts 0");
    var rc = native_transfer_copy_timeline(&ctx, 1, 0x100, 2, 0x200, 64, qt);
    assert(rc != 0, "fake-fd submit fails gracefully");
    assert_eq(queue_point(qt), 1, "timeline point bumped 0->1");
    assert_eq(queue_pending_wait_syncobj(qt), 0, "pending wait consumed");
    # X.8: a > 4 MiB copy is no longer rejected — it chunks into multiple
    # COPY_LINEAR packets and proceeds to submit (fails on the fake fd, but
    # the point bumps, proving it reached submit rather than early-rejecting).
    var rc2 = native_transfer_copy_timeline(&ctx, 1, 0x100, 2, 0x200,
    _NATIVE_SDMA_COPY_MAX_BYTES + 4, qt);
    assert(rc2 != 0, "4MiB+4 chunks + submits (fake-fd fail), not rejected");
    assert_eq(queue_point(qt), 2, "point bumped 1->2 (reached submit)");
    # X.8: a copy too large for the IB packet chain (>146 packets) is
    # rejected pre-submit with GPU_ERR_BUFFER (point NOT bumped).
    var rc3 = native_transfer_copy_timeline(&ctx, 1, 0x100, 2, 0x200,
    _NATIVE_SDMA_COPY_MAX_BYTES * 147, qt);
    assert_eq(rc3, GPU_ERR_BUFFER, "oversize chain -> GPU_ERR_BUFFER");
    assert_eq(queue_point(qt), 2, "oversize rejected pre-submit (point unchanged)");
    return 0;
}

# v3.2 X.5 — _backend_native_buffer_copy slot guard ladder: null
# ctx/src/dst/queue, zero/oversized bytes (bounded by both buffers'
# logical sizes), and the non-DMA-queue mis-route propagated from the
# driver. The full HW copy path is the X.7 e2e.
fn test_native_buffer_copy_guards() {
    var ctx[160];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    var qt = queue_new(QUEUE_KIND_TRANSFER);
    queue_set_ring(qt, AMDGPU_HW_IP_DMA);
    queue_set_syncobj(qt, 5);
    var src[32];
    memset(&src, 0, NATIVE_BUF_STRUCT_SIZE);
    store64((&src) + NATIVE_BUF_FIELD_HANDLE, 1);
    store64((&src) + NATIVE_BUF_FIELD_VA, 0x100000);
    store64((&src) + NATIVE_BUF_FIELD_SIZE, 256);
    var dst[32];
    memset(&dst, 0, NATIVE_BUF_STRUCT_SIZE);
    store64((&dst) + NATIVE_BUF_FIELD_HANDLE, 2);
    store64((&dst) + NATIVE_BUF_FIELD_VA, 0x200000);
    store64((&dst) + NATIVE_BUF_FIELD_SIZE, 256);
    assert_eq(_backend_native_buffer_copy(0, qt, &src, &dst, 64),
    GPU_ERR_OTHER, "null ctx -> GPU_ERR_OTHER");
    assert_eq(_backend_native_buffer_copy(&ctx, qt, 0, &dst, 64),
    GPU_ERR_BUFFER, "null src -> GPU_ERR_BUFFER");
    assert_eq(_backend_native_buffer_copy(&ctx, qt, &src, 0, 64),
    GPU_ERR_BUFFER, "null dst -> GPU_ERR_BUFFER");
    assert_eq(_backend_native_buffer_copy(&ctx, 0, &src, &dst, 64),
    GPU_ERR_OTHER, "null queue -> GPU_ERR_OTHER");
    assert_eq(_backend_native_buffer_copy(&ctx, qt, &src, &dst, 0),
    GPU_ERR_BUFFER, "zero bytes -> GPU_ERR_BUFFER");
    assert_eq(_backend_native_buffer_copy(&ctx, qt, &src, &dst, 300),
    GPU_ERR_BUFFER, "bytes > src size -> GPU_ERR_BUFFER");
    store64((&dst) + NATIVE_BUF_FIELD_SIZE, 32);
    assert_eq(_backend_native_buffer_copy(&ctx, qt, &src, &dst, 64),
    GPU_ERR_BUFFER, "bytes > dst size -> GPU_ERR_BUFFER");
    store64((&dst) + NATIVE_BUF_FIELD_SIZE, 256);
    # A copy aimed at a non-DMA queue propagates GPU_ERR_TRANSFER from
    # native_transfer_copy_timeline (the ring check lives there).
    var qc = queue_new(QUEUE_KIND_COMPUTE);
    queue_set_ring(qc, AMDGPU_HW_IP_COMPUTE);
    queue_set_syncobj(qc, 5);
    assert_eq(_backend_native_buffer_copy(&ctx, qc, &src, &dst, 64),
    GPU_ERR_TRANSFER, "non-DMA queue -> GPU_ERR_TRANSFER");
    return 0;
}

fn test_native_queue_get_guards() {
    # ctx==0, bad-kind, and no-fd all short-circuit to 0 before any ioctl.
    assert_eq(_backend_native_queue_get(0, QUEUE_KIND_COMPUTE), 0, "null ctx -> 0");
    var ctx[160];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    assert_eq(_backend_native_queue_get(&ctx, 99), 0, "bad kind -> 0");
    assert_eq(_backend_native_queue_get(&ctx, QUEUE_KIND_COMPUTE), 0,
    "no-fd ctx -> 0, no syscall");
    return 0;
}

fn test_native_queue_wait_idle_guards() {
    var ctx[160];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    assert_eq(_backend_native_queue_wait_idle(0, 1), GPU_ERR_OTHER, "null ctx err");
    assert_eq(_backend_native_queue_wait_idle(&ctx, 0), GPU_ERR_OTHER, "null queue err");
    # A fresh queue has point 0 -> wait_idle is a no-op (no syscall).
    var q = queue_new(QUEUE_KIND_COMPUTE);
    assert_eq(_backend_native_queue_wait_idle(&ctx, q), 0,
    "point 0 queue -> 0 (nothing submitted)");
    return 0;
}

fn test_native_queue_barrier_guards() {
    var ctx[160];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    assert_eq(_backend_native_queue_barrier(0, 1, 2), GPU_ERR_OTHER, "null ctx err");
    assert_eq(_backend_native_queue_barrier(&ctx, 0, 2), GPU_ERR_OTHER, "null src err");
    assert_eq(_backend_native_queue_barrier(&ctx, 1, 0), GPU_ERR_OTHER, "null dst err");
    return 0;
}

fn test_native_compute_dispatch_queue_targeted_branch() {
    # When the current-queue stash is set, compute_dispatch routes
    # through the async timeline path: the queue's point is bumped (0->1)
    # and a submit is attempted. With a fake fd (-1) the CS ioctl fails
    # gracefully (-EBADF -> GPU_ERR_*, no crash). Set just enough ctx
    # fields for the driver: fd, a real IB mmap buffer, and the PM4
    # scratch — everything else can stay zero.
    var ctx[160];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    store64((&ctx) + 0, 0 - 1);            # fd = -1 -> CS ioctl -EBADF
    var ib_scratch[4096];
    store64((&ctx) + 64, &ib_scratch);     # ib_addr (memcpy target)
    var pm4_scratch[1024];
    store64((&ctx) + 112, &pm4_scratch);   # pm4 build buffer
    var q = queue_new(QUEUE_KIND_COMPUTE);
    queue_set_syncobj(q, 1);               # non-zero so the driver proceeds
    queue_set_ring(q, AMDGPU_HW_IP_COMPUTE);
    gpu_ctx_set_current_queue(&ctx, q);
    # Q.4: stage a pending cross-ring wait; the dispatch must consume +
    # clear it (turning it into an in-CS TIMELINE_WAIT on the submit).
    queue_set_pending_wait(q, 0x77, 3);
    var shmod[16];
    native_buf_pair_write(&shmod, 0x111, 0x222);
    var bp[16];
    native_buf_pair_write(&bp, 0x333, 0x444);
    assert_eq(queue_point(q), 0, "point starts 0");
    var rc = _backend_native_compute_dispatch(&ctx, &shmod, 1, 1, 1, &bp);
    assert(rc != 0, "fake-fd submit fails gracefully (no crash)");
    assert_eq(queue_point(q), 1, "timeline path taken: queue point bumped 0->1");
    assert_eq(queue_pending_wait_syncobj(q), 0, "pending wait consumed + cleared");
    return 0;
}

fn test_native_queue_barrier_records_pending_wait() {
    var ctx[160];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    # Producer queue has submitted up to point 5 on syncobj 0x42.
    var src = queue_new(QUEUE_KIND_COMPUTE);
    queue_set_syncobj(src, 0x42);
    queue_set_point(src, 5);
    var dst = queue_new(QUEUE_KIND_GRAPHICS);
    assert_eq(_backend_native_queue_barrier(&ctx, src, dst), 0, "barrier ok");
    assert_eq(queue_pending_wait_syncobj(dst), 0x42, "dst waits on src syncobj");
    assert_eq(queue_pending_wait_point(dst), 5, "dst waits on src point 5");
    assert_eq(queue_point(src), 5, "src point untouched (no CPU block)");
    # Barrier with an idle producer (point 0) records nothing.
    var src2 = queue_new(QUEUE_KIND_COMPUTE);
    queue_set_syncobj(src2, 0x99);
    var dst2 = queue_new(QUEUE_KIND_GRAPHICS);
    assert_eq(_backend_native_queue_barrier(&ctx, src2, dst2), 0, "idle-src barrier ok");
    assert_eq(queue_pending_wait_syncobj(dst2), 0, "no pending wait for idle producer");
    return 0;
}

# v3.2 T.7 — native format-parameterized create guards (pre-ioctl).
fn test_native_texture_create_2d_fmt_guards() {
    assert_eq(NATIVE_TEX_FIELD_FMT, 44, "fmt field at +44");
    assert_eq(NATIVE_TEX_STRUCT_SIZE, 64, "NativeTexture 64 B (v3.2 TS.3)");
    # Every guard returns before any ioctl (no HW). The real create +
    # block-sized BO + memcpy round-trip are HW-gated (T.8 e2e on Cezanne).
    assert_eq(_backend_native_texture_create_2d_fmt(0, 8, 8, MABDA_TEXFMT_BC1), 0,
    "null ctx -> 0");
    var ctx[160];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    assert_eq(_backend_native_texture_create_2d_fmt(&ctx, 0, 8, MABDA_TEXFMT_BC1), 0,
    "zero w -> 0");
    assert_eq(_backend_native_texture_create_2d_fmt(&ctx, 8, 0 - 1, MABDA_TEXFMT_BC1), 0,
    "neg h -> 0");
    assert_eq(_backend_native_texture_create_2d_fmt(&ctx, 8193, 8, MABDA_TEXFMT_BC1), 0,
    "oversize -> 0");
    assert_eq(_backend_native_texture_create_2d_fmt(&ctx, 8, 8, MABDA_TEXFMT_COUNT), 0,
    "unknown fmt -> 0");
    return 0;
}

# v3.2 X.1 — native gpu_buffer create/release guards (pre-ioctl).
fn test_native_buffer_create_release_guards() {
    assert_eq(NATIVE_BUF_FIELD_HANDLE, 0,  "handle @0");
    assert_eq(NATIVE_BUF_FIELD_VA,     8,  "va @8");
    assert_eq(NATIVE_BUF_FIELD_ADDR,   16, "addr @16");
    assert_eq(NATIVE_BUF_FIELD_SIZE,   24, "size @24");
    assert_eq(NATIVE_BUF_STRUCT_SIZE,  32, "NativeBuf = 32 B");
    # create guards return before any ioctl (real create is HW — X.7 e2e).
    assert_eq(_backend_native_buffer_create(0, 64, 0), 0, "null ctx -> 0");
    var ctx[160];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    assert_eq(_backend_native_buffer_create(&ctx, 0, 0), 0, "size 0 -> 0");
    assert_eq(_backend_native_buffer_create(&ctx, 0 - 1, 0), 0, "neg size -> 0");
    assert_eq(_backend_native_buffer_create(&ctx, _NATIVE_TEXTURE_VA_REGION + 1, 0), 0,
    "oversize (> VA region) -> 0");
    # release null-safe.
    assert_eq(_backend_native_buffer_release(0, 0), 0, "release null ctx -> 0");
    assert_eq(_backend_native_buffer_release(&ctx, 0), 0, "release null buf -> 0");
    return 0;
}

# v3.2 X.2 — native buffer write/read are pure memcpy, so fully CPU-testable
# with a stack-backed fake NativeBuf (no ioctl).
fn test_native_buffer_write_read_roundtrip() {
    var backing[64];
    memset(&backing, 0, 64);
    var buf[32];
    memset(&buf, 0, 32);
    store64((&buf) + NATIVE_BUF_FIELD_ADDR, &backing);
    store64((&buf) + NATIVE_BUF_FIELD_SIZE, 64);
    var ctx[160];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    var src[16];
    var i = 0;
    while (i < 4) { store32((&src) + i * 4, 0xB0F00000 + i); i = i + 1; }
    # Write 16 bytes at offset 8, read them back, verify + verify offset honored.
    assert_eq(_backend_native_buffer_write(&ctx, &buf, 8, &src, 16), 0, "write off=8 n=16");
    var dst[16];
    memset(&dst, 0, 16);
    assert_eq(_backend_native_buffer_read(&ctx, &buf, 8, &dst, 16), 0, "read off=8 n=16");
    var j = 0;
    while (j < 4) { assert_eq(load32((&dst) + j * 4), 0xB0F00000 + j, "dword round-trip"); j = j + 1; }
    assert_eq(load32((&backing) + 8), 0xB0F00000, "data landed at offset 8");
    assert_eq(load32((&backing) + 0), 0, "offset 0 untouched");
    return 0;
}

fn test_native_buffer_write_read_bounds() {
    var backing[64];
    memset(&backing, 0, 64);
    var buf[32];
    memset(&buf, 0, 32);
    store64((&buf) + NATIVE_BUF_FIELD_ADDR, &backing);
    store64((&buf) + NATIVE_BUF_FIELD_SIZE, 64);
    var ctx[160];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    var tmp[16];
    memset(&tmp, 0, 16);
    assert_eq(_backend_native_buffer_write(0, &buf, 0, &tmp, 4), GPU_ERR_OTHER, "null ctx");
    assert_eq(_backend_native_buffer_write(&ctx, 0, 0, &tmp, 4), GPU_ERR_OTHER, "null buf");
    assert_eq(_backend_native_buffer_write(&ctx, &buf, 0, 0, 4), GPU_ERR_BUFFER, "null ptr");
    assert_eq(_backend_native_buffer_write(&ctx, &buf, 0, &tmp, 0), GPU_ERR_BUFFER, "n=0");
    assert_eq(_backend_native_buffer_write(&ctx, &buf, 0 - 1, &tmp, 4), GPU_ERR_BUFFER, "neg off");
    # off+n past size rejected (overflow-safe); exact-end accepted.
    assert_eq(_backend_native_buffer_write(&ctx, &buf, 60, &tmp, 8), GPU_ERR_BUFFER, "off+n>size");
    assert_eq(_backend_native_buffer_write(&ctx, &buf, 64, &tmp, 1), GPU_ERR_BUFFER, "off==size,n=1");
    assert_eq(_backend_native_buffer_write(&ctx, &buf, 48, &tmp, 16), 0, "exact end (off+n==size) ok");
    assert_eq(_backend_native_buffer_read(&ctx, &buf, 60, &tmp, 8), GPU_ERR_BUFFER, "read off+n>size");
    return 0;
}

fn test_native_cs_submit_timeline_point_guards() {
    # Signalling timeline point 0 is a kernel -EINVAL trap (points are
    # strictly monotonic from 0); the guard short-circuits before any
    # ioctl. fence_offset=32 is aligned so it's the point guard, not the
    # align guard, that fires.
    var rc0 = native_cs_submit_timeline(0 - 1, 0, 0, 0, 0, AMDGPU_HW_IP_COMPUTE,
    1, 0, 0, 0, 5, 32, 0);
    assert_eq(rc0, 0 - 22, "signal_point 0 -> -EINVAL, no syscall");
    # Waiting on point 0 (with a non-zero wait syncobj) is likewise
    # rejected: signal_point=1 is valid, wait_syncobj=7 includes a wait,
    # wait_point=0 trips the wait-point guard.
    var rcw = native_cs_submit_timeline(0 - 1, 0, 0, 0, 0, AMDGPU_HW_IP_COMPUTE,
    1, 1, 7, 0, 5, 32, 0);
    assert_eq(rcw, 0 - 22, "wait_point 0 with a wait chunk -> -EINVAL, no syscall");
    return 0;
}

fn test_native_pm4_builder_composability() {
    # Chain operations: NOP(pad=2) + SET_SH_REG(one) + DISPATCH_DIRECT.
    # NOP pad=2 (minimum useful per Session 25b): 1 header + 1 filler dword.
    # Expected layout:
    #   0x00-0x03: NOP header (count_minus_1 = 0)
    #   0x04-0x07: NOP filler (zero)
    #   0x08-0x13: SET_SH_REG DISPATCH_INITIATOR = 1 (3 dwords)
    #   0x14-0x27: DISPATCH_DIRECT 1,1,1, init=1 (5 dwords)
    # Total: 10 dwords = 40 bytes.
    var buf[64];
    memset(&buf, 0, 64);
    var pos = 0;
    pos = native_pm4_nop(&buf, pos, 2);
    pos = native_pm4_set_sh_reg_one(&buf, pos, R_COMPUTE_DISPATCH_INITIATOR, 1);
    pos = native_pm4_dispatch_direct(&buf, pos, 1, 1, 1, COMPUTE_DISPATCH_INITIATOR_MIN);
    assert_eq(pos, 40, "composed stream = 40 bytes");
    # Spot check: each header at its expected offset.
    assert_eq(load32(&buf + 0),  0xC0001000, "NOP header at 0");
    assert_eq(load32(&buf + 8),  0xC0017600, "SET_SH_REG header at 8");
    assert_eq(load32(&buf + 20), 0xC0031502, "DISPATCH_DIRECT header at 20 (shader_type=compute)");
    return 0;
}

# ================================================================
# v3 Step 4c — native Backend slot wrappers + builder
# ================================================================
# Step 4c lights backend_native_new() + the compute_dispatch slot
# end-to-end. CPU tests here verify the builder shape: complete
# backend, kind = AMD, slots resolve to the expected wrappers.
# End-to-end dispatch validation happens in the GPU integration
# program (programs/native_compute_store.cyr — refactored Step 4d).
# Native ctx field accessor tests verify the dual-interpretation
# layout convention.

fn test_backend_native_new_is_complete() {
    var b = backend_native_new();
    assert(b != 0, "backend_native_new returns non-null");
    # All four ranges (v0 compute/buffer + v1 texture + v2 render +
    # v3 surface stubs) are wired as of Step 7.6.
    assert_eq(backend_is_complete(b), 1,
    "native backend complete with v3 surface range stubbed (Step 7.6)");
    assert_eq(backend_kind(b), BACKEND_KIND_AMD, "kind = AMD");
    var off = 0;
    while (off < BACKEND_FNPTR_SLOTS_END) {
        assert_eq(load64(b + off) != 0, 1, "v0 fnptr filled on native");
        off = off + 8;
    }
    var off2 = BACKEND_TEXTURE_SLOTS_BEGIN;
    while (off2 < BACKEND_TEXTURE_SLOTS_END) {
        assert_eq(load64(b + off2) != 0, 1, "v1 texture fnptr filled on native");
        off2 = off2 + 8;
    }
    var off3 = BACKEND_RENDER_SLOTS_BEGIN;
    while (off3 < BACKEND_RENDER_SLOTS_END) {
        assert_eq(load64(b + off3) != 0, 1, "v2 render fnptr filled on native");
        off3 = off3 + 8;
    }
    var off4 = BACKEND_SURFACE_SLOTS_BEGIN;
    while (off4 < BACKEND_SURFACE_SLOTS_END) {
        assert_eq(load64(b + off4) != 0, 1, "v3 surface fnptr filled on native");
        off4 = off4 + 8;
    }
    return 0;
}

fn test_backend_native_slot_identities() {
    var b = backend_native_new();
    var s_ccp = backend_get_slot(b, BACKEND_SLOT_CTX_CREATE_FROM_PREINIT);
    var s_cr = backend_get_slot(b, BACKEND_SLOT_CTX_RELEASE);
    var s_bc = backend_get_slot(b, BACKEND_SLOT_BUFFER_CREATE);
    var s_bw = backend_get_slot(b, BACKEND_SLOT_BUFFER_WRITE);
    var s_br = backend_get_slot(b, BACKEND_SLOT_BUFFER_READ);
    var s_bl = backend_get_slot(b, BACKEND_SLOT_BUFFER_RELEASE);
    var s_smc = backend_get_slot(b, BACKEND_SLOT_SHADER_MODULE_CREATE);
    var s_smr = backend_get_slot(b, BACKEND_SLOT_SHADER_MODULE_RELEASE);
    var s_cd = backend_get_slot(b, BACKEND_SLOT_COMPUTE_DISPATCH);
    var s_wi = backend_get_slot(b, BACKEND_SLOT_DEVICE_WAIT_IDLE);
    assert_eq(s_ccp, &_backend_native_ctx_create_from_preinit, "ctx_create");
    assert_eq(s_cr, &_backend_native_ctx_release, "ctx_release");
    assert_eq(s_bc, &_backend_native_buffer_create, "buffer_create");
    assert_eq(s_bw, &_backend_native_buffer_write, "buffer_write");
    assert_eq(s_br, &_backend_native_buffer_read, "buffer_read");
    assert_eq(s_bl, &_backend_native_buffer_release, "buffer_release");
    assert_eq(s_smc, &_backend_native_shader_module_create, "shader_module_create");
    assert_eq(s_smr, &_backend_native_shader_module_release, "shader_module_release");
    assert_eq(s_cd, &_backend_native_compute_dispatch, "compute_dispatch");
    assert_eq(s_wi, &_backend_native_device_wait_idle, "device_wait_idle");
    # v2 render slot identities (Step 6.8c).
    var s_rtc = backend_get_slot(b, BACKEND_SLOT_RENDER_TARGET_CREATE_2D_RGBA8);
    var s_rtr = backend_get_slot(b, BACKEND_SLOT_RENDER_TARGET_RELEASE);
    var s_rpc = backend_get_slot(b, BACKEND_SLOT_RENDER_PIPELINE_CREATE);
    var s_rpr = backend_get_slot(b, BACKEND_SLOT_RENDER_PIPELINE_RELEASE);
    var s_rpb = backend_get_slot(b, BACKEND_SLOT_RENDER_PASS_BEGIN);
    var s_rpd = backend_get_slot(b, BACKEND_SLOT_RENDER_PASS_DRAW);
    var s_rpe = backend_get_slot(b, BACKEND_SLOT_RENDER_PASS_END);
    assert_eq(s_rtc, &_backend_native_render_target_create_2d_rgba8, "rt_create");
    assert_eq(s_rtr, &_backend_native_render_target_release,         "rt_release");
    assert_eq(s_rpc, &_backend_native_render_pipeline_create,        "pipe_create");
    assert_eq(s_rpr, &_backend_native_render_pipeline_release,       "pipe_release");
    assert_eq(s_rpb, &_backend_native_render_pass_begin,             "pass_begin");
    assert_eq(s_rpd, &_backend_native_render_pass_draw,              "pass_draw");
    assert_eq(s_rpe, &_backend_native_render_pass_end,               "pass_end");
    # v3.2 X.5 buffer-copy slot identity.
    var s_bcp = backend_get_slot(b, BACKEND_SLOT_BUFFER_COPY);
    assert_eq(s_bcp, &_backend_native_buffer_copy, "buffer_copy");
    return 0;
}

fn test_backend_native_distinct_from_wgpu() {
    var w = backend_wgpu_new();
    var n = backend_native_new();
    assert(w != n, "distinct backend allocations");
    assert(backend_kind(w) != backend_kind(n), "distinct kinds");
    assert_eq(backend_kind(w), BACKEND_KIND_WGPU, "wgpu kind");
    assert_eq(backend_kind(n), BACKEND_KIND_AMD, "native kind");
    var w_cd = backend_get_slot(w, BACKEND_SLOT_COMPUTE_DISPATCH);
    var n_cd = backend_get_slot(n, BACKEND_SLOT_COMPUTE_DISPATCH);
    assert(w_cd != n_cd, "wgpu and native compute_dispatch slots differ");
    return 0;
}

fn test_native_ctx_field_accessors() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx +  0, 7);              # fd
    store64(ctx +  8, 42);             # ctx_id
    store64(ctx + 16, 0xDEAD);         # stub_handle
    store64(ctx + 24, 0xFFFF800100004000); # stub_va
    store64(ctx + 32, 0xBEEF);         # backend ptr
    assert_eq(native_ctx_fd(ctx), 7, "fd at +0");
    assert_eq(native_ctx_id(ctx), 42, "ctx_id at +8");
    assert_eq(native_ctx_stub_handle(ctx), 0xDEAD, "stub_handle at +16");
    assert_eq(native_ctx_stub_va(ctx), 0xFFFF800100004000, "stub_va at +24");
    assert_eq(gpu_ctx_backend(ctx), 0xBEEF, "backend ptr unchanged at +32");
    return 0;
}

fn test_native_buf_pair_write() {
    var pair[16];
    memset(&pair, 0, 16);
    native_buf_pair_write(&pair, 0xCAFE, 0xBABE);
    assert_eq(load64(&pair + 0), 0xCAFE, "handle at +0");
    assert_eq(load64(&pair + 8), 0xBABE, "va at +8");
    return 0;
}

fn test_backend_native_compute_dispatch_null_args_err() {
    var b = backend_native_new();
    var fp = backend_get_slot(b, BACKEND_SLOT_COMPUTE_DISPATCH);
    var rc1 = fncall6(fp, 0, 0, 0, 0, 0, 0);
    assert_eq(rc1, GPU_ERR_OTHER, "null ctx → err");
    var dummy_ctx = alloc(112);
    memset(dummy_ctx, 0, 96);
    var rc2 = fncall6(fp, dummy_ctx, 0, 0, 0, 0, 0);
    assert_eq(rc2, GPU_ERR_OTHER, "null shmod → err");
    var dummy_pair = alloc(16);
    memset(dummy_pair, 0, 16);
    var rc3 = fncall6(fp, dummy_ctx, dummy_pair, 0, 0, 0, 0);
    assert_eq(rc3, GPU_ERR_OTHER, "null bp → err");
    return 0;
}

fn test_native_ctx_stub_addr_accessor() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx + 40, 0xC0DE);
    assert_eq(native_ctx_stub_addr(ctx), 0xC0DE, "stub_addr at +40");
    # Other fields untouched
    assert_eq(native_ctx_fd(ctx), 0, "fd zero");
    assert_eq(native_ctx_id(ctx), 0, "ctx_id zero");
    assert_eq(native_ctx_stub_handle(ctx), 0, "stub_handle zero");
    assert_eq(native_ctx_stub_va(ctx), 0, "stub_va zero");
    assert_eq(gpu_ctx_backend(ctx), 0, "backend zero");
    return 0;
}

# ================================================================
# v3 Step 4f.i — errno → GpuErr mapping
# ================================================================
# _native_errno_to_gpu_err takes a positive errno; the helper maps
# it to the closest existing GPU_ERR_* code per the convention
# documented in src/backend_native.cyr. _native_neg_rc_to_gpu_err
# wraps the negative-rc convention used by native_* primitives
# (rc <= 0 means error, sign-flipped errno).

fn test_native_errno_to_gpu_err_classifies() {
    assert_eq(_native_errno_to_gpu_err(12),  GPU_ERR_BUFFER, "ENOMEM → BUFFER");
    assert_eq(_native_errno_to_gpu_err(1),   GPU_ERR_ADAPTER_NOT_FOUND, "EPERM → adapter");
    assert_eq(_native_errno_to_gpu_err(13),  GPU_ERR_ADAPTER_NOT_FOUND, "EACCES → adapter");
    assert_eq(_native_errno_to_gpu_err(2),   GPU_ERR_ADAPTER_NOT_FOUND, "ENOENT → adapter");
    assert_eq(_native_errno_to_gpu_err(16),  GPU_ERR_DEVICE_REQUEST, "EBUSY → device");
    assert_eq(_native_errno_to_gpu_err(110), GPU_ERR_SURFACE_TIMEOUT, "ETIMEDOUT → timeout");
    assert_eq(_native_errno_to_gpu_err(62),  GPU_ERR_SURFACE_TIMEOUT, "ETIME → timeout");
    return 0;
}

fn test_native_errno_to_gpu_err_default_other() {
    # Unknown errnos fall through to GPU_ERR_OTHER.
    assert_eq(_native_errno_to_gpu_err(22), GPU_ERR_OTHER, "EINVAL → OTHER (no specific code)");
    assert_eq(_native_errno_to_gpu_err(14), GPU_ERR_OTHER, "EFAULT → OTHER");
    assert_eq(_native_errno_to_gpu_err(38), GPU_ERR_OTHER, "ENOSYS → OTHER");
    assert_eq(_native_errno_to_gpu_err(0),  GPU_ERR_OTHER, "0 (caller bug) → OTHER");
    assert_eq(_native_errno_to_gpu_err(99), GPU_ERR_OTHER, "arbitrary → OTHER");
    return 0;
}

fn test_native_neg_rc_to_gpu_err_sign_flip() {
    # rc == 0 maps to 0 (success).
    assert_eq(_native_neg_rc_to_gpu_err(0), 0, "rc=0 → 0");
    # Negative rc: sign-flip to errno, then map.
    assert_eq(_native_neg_rc_to_gpu_err(-12),  GPU_ERR_BUFFER, "-ENOMEM");
    assert_eq(_native_neg_rc_to_gpu_err(-110), GPU_ERR_SURFACE_TIMEOUT, "-ETIMEDOUT");
    assert_eq(_native_neg_rc_to_gpu_err(-1),   GPU_ERR_ADAPTER_NOT_FOUND, "-EPERM");
    # Positive rc (defensive — some primitives might already pass abs).
    assert_eq(_native_neg_rc_to_gpu_err(12),   GPU_ERR_BUFFER, "+ENOMEM (defensive)");
    return 0;
}

# ================================================================
# v3 Step 4f.ii — BO page-perm constants
# ================================================================
# Locks in the current per-BO perm values. Narrowing the constants
# past these values will trip these tests before any hardware
# iteration burns TDR budget — re-tightening should land the
# narrowed value in src/backend_native.cyr AND the matching
# assertion here in the same change.

fn test_native_perm_constants_present() {
    var r = AMDGPU_VM_PAGE_READABLE;
    var w = AMDGPU_VM_PAGE_WRITEABLE;
    var x = AMDGPU_VM_PAGE_EXECUTABLE;
    # Locked-in per-BO minimums after the Step 4f.ii hardware
    # bisect. _NATIVE_PERM_IB needing the X bit is the surprise —
    # CP-fetched PM4 still goes through the execute-permission
    # gate on Cezanne. See module header in src/backend_native.cyr
    # for the full rationale.
    assert_eq(_NATIVE_PERM_FULL,   r | w | x, "FULL = R|W|X");
    assert_eq(_NATIVE_PERM_SHADER, r | x,     "SHADER = R|X");
    assert_eq(_NATIVE_PERM_DATA,   r | w,     "DATA = R|W");
    assert_eq(_NATIVE_PERM_IB,     r | x,     "IB = R|X (X is load-bearing)");
    return 0;
}

fn test_native_perm_bits_distinct() {
    # The three AMDGPU page-perm bits are distinct, so combining
    # them with bitwise OR is well-defined.
    assert(AMDGPU_VM_PAGE_READABLE != AMDGPU_VM_PAGE_WRITEABLE, "R != W");
    assert(AMDGPU_VM_PAGE_WRITEABLE != AMDGPU_VM_PAGE_EXECUTABLE, "W != X");
    assert(AMDGPU_VM_PAGE_READABLE != AMDGPU_VM_PAGE_EXECUTABLE, "R != X");
    return 0;
}

# ================================================================
# v3 Step 4f.iv — per-context IB + fence cache
# ================================================================
# GpuContext grew 48 → 96 bytes. New native-only fields at +48..+88
# hold the cached IB BO (handle/va/addr) and fence BO
# (handle/va/addr). Layout test below verifies offsets; multi-
# dispatch end-to-end validation is in programs/native_compute_store
# (would catch any regression of the cached path against real
# hardware).

fn test_native_ctx_ib_fence_accessors() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx + 48, 0x10A);   # ib_handle
    store64(ctx + 56, 0xFFFF800100200000); # ib_va
    store64(ctx + 64, 0x10C);   # ib_addr
    store64(ctx + 72, 0x10D);   # fence_handle
    store64(ctx + 80, 0xFFFF800100600000); # fence_va
    store64(ctx + 88, 0x10F);   # fence_addr
    assert_eq(native_ctx_ib_handle(ctx),    0x10A,                 "ib_handle at +48");
    assert_eq(native_ctx_ib_va(ctx),        0xFFFF800100200000,    "ib_va at +56");
    assert_eq(native_ctx_ib_addr(ctx),      0x10C,                 "ib_addr at +64");
    assert_eq(native_ctx_fence_handle(ctx), 0x10D,                 "fence_handle at +72");
    assert_eq(native_ctx_fence_va(ctx),     0xFFFF800100600000,    "fence_va at +80");
    assert_eq(native_ctx_fence_addr(ctx),   0x10F,                 "fence_addr at +88");
    return 0;
}

fn test_native_ctx_layout_isolation_step4iv() {
    # Mutating the new fields does not perturb +0..+40 ones.
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    store64(ctx +  0, 0xA1);
    store64(ctx +  8, 0xA2);
    store64(ctx + 16, 0xA3);
    store64(ctx + 24, 0xA4);
    store64(ctx + 32, 0xA5);
    store64(ctx + 40, 0xA6);
    # Now write the new fields:
    store64(ctx + 48, 0xB1);
    store64(ctx + 56, 0xB2);
    store64(ctx + 64, 0xB3);
    store64(ctx + 72, 0xB4);
    store64(ctx + 80, 0xB5);
    store64(ctx + 88, 0xB6);
    # All earlier fields untouched
    assert_eq(native_ctx_fd(ctx),         0xA1, "fd untouched");
    assert_eq(native_ctx_id(ctx),         0xA2, "ctx_id untouched");
    assert_eq(native_ctx_stub_handle(ctx),0xA3, "stub_handle untouched");
    assert_eq(native_ctx_stub_va(ctx),    0xA4, "stub_va untouched");
    assert_eq(gpu_ctx_backend(ctx),       0xA5, "backend untouched");
    assert_eq(native_ctx_stub_addr(ctx),  0xA6, "stub_addr untouched");
    return 0;
}

# ================================================================
# v3 Step 5.1 — native 2D RGBA8 texture primitives (Phase C)
# ================================================================
# CPU-only tests — size formula, NativeTexture struct layout, and
# VA-range isolation from the existing canonical-high allocations
# (shader / stub / IB / fence / output). Hardware tests for
# texture create + readback land in Step 5.8 (native_texture_e2e).

fn test_native_texture_size_2d_rgba8_formula() {
    assert_eq(native_texture_size_2d_rgba8(1, 1),     4,        "1x1 = 4 bytes");
    assert_eq(native_texture_size_2d_rgba8(16, 16),   1024,     "16x16 = 1 KiB");
    assert_eq(native_texture_size_2d_rgba8(256, 256), 262144,   "256x256 = 256 KiB");
    assert_eq(native_texture_size_2d_rgba8(64, 32),   8192,     "64x32 rectangular");
    assert_eq(native_texture_size_2d_rgba8(0, 0),     0,        "0x0 = 0 (degenerate)");
    return 0;
}

fn test_native_texture_struct_field_offsets() {
    assert_eq(NATIVE_TEX_FIELD_HANDLE,    0,  "handle at +0");
    assert_eq(NATIVE_TEX_FIELD_VA,        8,  "va at +8");
    assert_eq(NATIVE_TEX_FIELD_ADDR,      16, "addr at +16");
    assert_eq(NATIVE_TEX_FIELD_SIZE,      24, "size at +24");
    # v3.1 M.1(b): mip metadata appended; offsets 0..24 unchanged.
    assert_eq(NATIVE_TEX_FIELD_WIDTH,     32, "width at +32");
    assert_eq(NATIVE_TEX_FIELD_HEIGHT,    36, "height at +36");
    assert_eq(NATIVE_TEX_FIELD_MIP_COUNT, 40, "mip_count at +40");
    assert_eq(NATIVE_TEX_FIELD_FMT,       44, "fmt at +44 (v3.2 T.7)");
    # v3.2 TS.3: sampleable fields appended; offsets 0..44 unchanged.
    assert_eq(NATIVE_TEX_FIELD_SW_MODE,   48, "sw_mode at +48 (v3.2 TS.3)");
    assert_eq(NATIVE_TEX_FIELD_T_VA,      52, "t_va at +52 (v3.2 TS.3)");
    assert_eq(NATIVE_TEX_STRUCT_SIZE,     64, "total = 64");
    assert(NATIVE_TEX_FIELD_T_VA + 8 <= NATIVE_TEX_STRUCT_SIZE,
    "t_va fits within the struct");
    return 0;
}

# v3.2 TS.3 — NativeTexture sampleable-field accessors round-trip.
fn test_native_tex_sampleable_accessors() {
    var tex[64];
    memset(&tex, 0, 64);
    store32(&tex + NATIVE_TEX_FIELD_FMT, MABDA_TEXFMT_BC1);
    native_tex_set_sw_mode(&tex, GFX9_SW_MODE_LINEAR);
    native_tex_set_t_va(&tex, 0xFFFF800180010000);
    assert_eq(native_tex_fmt(&tex), MABDA_TEXFMT_BC1, "fmt getter");
    assert_eq(native_tex_sw_mode(&tex), GFX9_SW_MODE_LINEAR, "sw_mode round-trip");
    assert_eq(native_tex_t_va(&tex), 0xFFFF800180010000, "t_va round-trip");
    return 0;
}

fn test_native_texture_va_range_distinct() {
    # The texture VA base must not collide with the canonical-high
    # VAs already used by gpu_context_new_native + the consumer
    # programs. If a future allocation lands here, this test catches
    # the conflict before it produces a runtime VA-map failure.
    assert(_NATIVE_TEXTURE_VA_BASE != _NATIVE_STUB_VA,    "tex != stub");
    assert(_NATIVE_TEXTURE_VA_BASE != _NATIVE_IB_VA,      "tex != IB");
    assert(_NATIVE_TEXTURE_VA_BASE != _NATIVE_FENCE_VA,   "tex != fence");
    # Programs hardcode shader_va = 0xFFFF800100000000 and
    # output_va = 0xFFFF800100400000 — assert the texture base
    # doesn't alias either.
    assert(_NATIVE_TEXTURE_VA_BASE != 0xFFFF800100000000, "tex != shader VA");
    assert(_NATIVE_TEXTURE_VA_BASE != 0xFFFF800100400000, "tex != output VA");
    # v3.1 M.1(c): the texture region [base, base+region) sits ABOVE the RT
    # area and must not overlap it (textures moved up to make room for mip
    # chains). RT base is well below the texture base.
    assert(_NATIVE_TEXTURE_VA_BASE > _NATIVE_RT_VA_BASE, "tex region above RT");
    assert(_NATIVE_RT_VA_BASE < _NATIVE_TEXTURE_VA_BASE, "RT below tex region start");
    return 0;
}

# v3.1 M.1(c): per-context texture VA bump allocator. Pure math (no fd) —
# drivable with a stack ctx. First alloc lazy-inits to the base; each
# allocation is 64 KiB-aligned; over-region requests return 0.
fn test_native_texture_va_allocator() {
    var ctx[128];
    memset(&ctx, 0, 128);
    var a = native_ctx_alloc_texture_va(&ctx, 1024);
    assert_eq(a, _NATIVE_TEXTURE_VA_BASE, "first alloc returns base (lazy-init)");
    var b = native_ctx_alloc_texture_va(&ctx, 1024);
    assert_eq(b, _NATIVE_TEXTURE_VA_BASE + 0x10000, "second alloc +64KiB");
    var c = native_ctx_alloc_texture_va(&ctx, 0x10001);   # 64KiB+1 -> 128KiB step
    assert_eq(c, _NATIVE_TEXTURE_VA_BASE + 0x20000, "third alloc after two 64KiB");
    assert_eq(native_ctx_tex_va_next(&ctx), _NATIVE_TEXTURE_VA_BASE + 0x40000,
    "cursor advanced by 64KiB+64KiB+128KiB");
    assert_eq(native_ctx_alloc_texture_va(0, 16), 0, "null ctx -> 0");
    # over-region request fails (and leaves the cursor untouched).
    var ctx2[128];
    memset(&ctx2, 0, 128);
    assert_eq(native_ctx_alloc_texture_va(&ctx2, _NATIVE_TEXTURE_VA_REGION + 1), 0,
    "over-region request returns 0");
    assert_eq(native_ctx_tex_va_next(&ctx2), 0, "cursor not advanced on failure");
    return 0;
}

fn test_native_texture_struct_round_trip() {
    # Hand-pack a NativeTexture struct (no fd needed) and verify the
    # field offsets thread through correctly.
    var tex[48];
    memset(&tex, 0, 48);
    store64(&tex + NATIVE_TEX_FIELD_HANDLE, 0xCAFE);
    store64(&tex + NATIVE_TEX_FIELD_VA,     _NATIVE_TEXTURE_VA_BASE);
    store64(&tex + NATIVE_TEX_FIELD_ADDR,   0xBEEF);
    store64(&tex + NATIVE_TEX_FIELD_SIZE,   1024);
    store32(&tex + NATIVE_TEX_FIELD_WIDTH,     256);
    store32(&tex + NATIVE_TEX_FIELD_HEIGHT,    128);
    store32(&tex + NATIVE_TEX_FIELD_MIP_COUNT, 9);
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_HANDLE), 0xCAFE,                "handle round-trips");
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_VA),     _NATIVE_TEXTURE_VA_BASE, "va round-trips");
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_ADDR),   0xBEEF,                "addr round-trips");
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_SIZE),   1024,                  "size round-trips");
    assert_eq(load32(&tex + NATIVE_TEX_FIELD_WIDTH),     256, "width round-trips");
    assert_eq(load32(&tex + NATIVE_TEX_FIELD_HEIGHT),    128, "height round-trips");
    assert_eq(load32(&tex + NATIVE_TEX_FIELD_MIP_COUNT), 9,   "mip_count round-trips");
    return 0;
}

fn test_native_texture_release_null_tex_safe() {
    # Caller passes a null pointer — function must short-circuit
    # before reading any fields. No syscalls expected.
    var rc = native_texture_release_2d_rgba8(7, 0);
    assert_eq(rc, 0, "null tex returns 0");
    return 0;
}

fn test_native_texture_release_zero_handle_safe() {
    # Tex struct exists but handle is 0 — function must short-
    # circuit before va_unmap / bo_release_gtt (those would syscall
    # with handle=0 and produce -EINVAL). Caller may release an
    # uninitialised tex struct without panic.
    var tex[32];
    memset(&tex, 0, 32);
    var rc = native_texture_release_2d_rgba8(7, &tex);
    assert_eq(rc, 0, "zero-handle tex returns 0");
    # All fields remain zero (no spurious writes).
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_HANDLE), 0, "handle stays 0");
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_VA),     0, "va stays 0");
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_ADDR),   0, "addr stays 0");
    assert_eq(load64(&tex + NATIVE_TEX_FIELD_SIZE),   0, "size stays 0");
    return 0;
}

# ================================================================
# v3 Step 5.6 — native texture wrapper safety
# ================================================================
# Native side wraps the Step 5.1+5.2 primitives. Create needs a
# real fd to syscall into amdgpu, so CPU tests cover the guard
# paths only (null ctx, zero dims, null src/dst, n mismatch).
# Hardware end-to-end is Step 5.8 (programs/native_texture_e2e).

fn test_backend_native_texture_create_null_ctx_returns_zero() {
    var rc = _backend_native_texture_create_2d_rgba8(0, 16, 16);
    assert_eq(rc, 0, "null ctx → 0 (no struct allocated)");
    return 0;
}

fn test_backend_native_texture_create_zero_dim_returns_zero() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    assert_eq(_backend_native_texture_create_2d_rgba8(ctx, 0, 16),  0, "w=0 → 0");
    assert_eq(_backend_native_texture_create_2d_rgba8(ctx, 16, 0),  0, "h=0 → 0");
    assert_eq(_backend_native_texture_create_2d_rgba8(ctx, 0, 0),   0, "0x0 → 0");
    return 0;
}

fn test_backend_native_texture_write_memcpy_round_trip() {
    # Synth a tex struct with addr pointing at a CPU buffer (no GPU
    # involvement on the native path — write is just memcpy onto
    # the mmap'd pointer). Lets us test the write+read pair from
    # CPU without the full create/release round-trip.
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    var pixels[16];
    memset(&pixels, 0, 16);
    var tex[32];
    memset(&tex, 0, 32);
    store64(&tex + NATIVE_TEX_FIELD_HANDLE, 1);  # non-zero so it doesn't look uninitialised
    store64(&tex + NATIVE_TEX_FIELD_ADDR,   &pixels);
    store64(&tex + NATIVE_TEX_FIELD_SIZE,   16);
    var src[16];
    var i = 0;
    while (i < 16) { store8(&src + i, i + 1); i = i + 1; }
    var rc_w = _backend_native_texture_write(ctx, &tex, &src, 16);
    assert_eq(rc_w, 0, "write returns 0");
    # Verify memcpy actually moved bytes.
    var j = 0;
    while (j < 16) {
        assert_eq(load8(&pixels + j), j + 1, "pixel byte matches src");
        j = j + 1;
    }
    var dst[16];
    memset(&dst, 0, 16);
    var rc_r = _backend_native_texture_read(ctx, &tex, &dst, 16);
    assert_eq(rc_r, 0, "read returns 0");
    var k = 0;
    while (k < 16) {
        assert_eq(load8(&dst + k), k + 1, "dst byte matches pixel");
        k = k + 1;
    }
    return 0;
}

fn test_backend_native_texture_write_null_args_err() {
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    var tex[32];
    memset(&tex, 0, 32);
    store64(&tex + NATIVE_TEX_FIELD_HANDLE, 1);
    store64(&tex + NATIVE_TEX_FIELD_SIZE,   1024);
    var src[8];
    memset(&src, 0, 8);
    assert_eq(_backend_native_texture_write(0, &tex, &src, 1024),  GPU_ERR_OTHER,  "null ctx");
    assert_eq(_backend_native_texture_write(ctx, 0, &src, 1024),   GPU_ERR_OTHER,  "null tex");
    assert_eq(_backend_native_texture_write(ctx, &tex, 0, 1024),   GPU_ERR_BUFFER, "null src");
    assert_eq(_backend_native_texture_write(ctx, &tex, &src, 0),   GPU_ERR_BUFFER, "n=0");
    # Tex with addr=0 (uninit) → err (catches the case where caller
    # forgot to call create before write).
    var tex2[32];
    memset(&tex2, 0, 32);
    store64(&tex2 + NATIVE_TEX_FIELD_SIZE, 1024);
    assert_eq(_backend_native_texture_write(ctx, &tex2, &src, 1024), GPU_ERR_BUFFER, "addr=0");
    return 0;
}

fn test_backend_native_texture_release_null_safe() {
    assert_eq(_backend_native_texture_release(0, 0), 0, "null ctx is safe");
    var ctx = alloc(112);
    memset(ctx, 0, 112);
    assert_eq(_backend_native_texture_release(ctx, 0), 0, "null tex is safe");
    return 0;
}

# Audit 2026-06-14 (defense-in-depth, CVE-2026-46220 class):
# native_cs_submit_4chunk rejects a non-DWORD-aligned fence writeback
# offset with -EINVAL BEFORE issuing the CS ioctl, so a future caller (or
# an SDMA submit path) can't trip the kernel's BUG_ON(addr & 0x3). The
# guard returns before touching the fd — safe to drive with a dummy fd.
fn test_cs_submit_rejects_unaligned_fence_offset() {
    var bo_list_in[24];
    memset(&bo_list_in, 0, 24);
    # fence_offset is the 9th arg; 1 and 3 are non-DWORD-aligned -> -EINVAL.
    assert_eq(native_cs_submit_4chunk(0, 0, &bo_list_in, 0, 0,
    AMDGPU_HW_IP_COMPUTE, 0, 0, 1, 0), 0 - 22, "fence_offset=1 rejected (-EINVAL)");
    assert_eq(native_cs_submit_4chunk(0, 0, &bo_list_in, 0, 0,
    AMDGPU_HW_IP_COMPUTE, 0, 0, 3, 0), 0 - 22, "fence_offset=3 rejected (-EINVAL)");
    return 0;
}

# v3.1 [M.1]: native contiguous RGBA8 mip-chain byte layout. Each level
# is 256-byte aligned (V# base requirement); offsets are the running sum
# of aligned level sizes; chain_size(count) == offset(count).
fn test_native_mip_chain_layout() {
    # _native_align_up rounds up to 256.
    assert_eq(_native_align_up(0, 256),   0,   "align 0");
    assert_eq(_native_align_up(1, 256),   256, "align 1 -> 256");
    assert_eq(_native_align_up(256, 256), 256, "align 256 -> 256");
    assert_eq(_native_align_up(257, 256), 512, "align 257 -> 512");

    # 256x256: level0 = 256*256*4 = 262144 (already aligned), level1 =
    # 128*128*4 = 65536.
    assert_eq(native_mip_level_offset(256, 256, 0), 0,      "level0 offset 0");
    assert_eq(native_mip_level_offset(256, 256, 1), 262144, "level1 after level0");
    assert_eq(native_mip_level_offset(256, 256, 2), 327680, "level2 = 262144+65536");
    assert_eq(native_mip_chain_size(256, 256, 2),   327680, "2-level chain size");

    # 4x4 chain (3 levels): each level's data (64/16/4 bytes) rounds up to
    # 256, so the chain is 3*256 = 768.
    assert_eq(native_mip_level_offset(4, 4, 1), 256, "4x4 level1 (64B->256)");
    assert_eq(native_mip_level_offset(4, 4, 2), 512, "4x4 level2");
    assert_eq(native_mip_chain_size(4, 4, mip_level_count(4, 4)), 768,
    "4x4 full chain (3 levels x 256) = 768");
    return 0;
}

# v3.1 [M.3]: per-level VA = chain base + contiguous offset (linear
# layout; no descriptor table). Reads width/height from the NativeTexture.
fn test_native_texture_level_va() {
    var tex[48];
    memset(&tex, 0, 48);
    store64(&tex + NATIVE_TEX_FIELD_VA, _NATIVE_TEXTURE_VA_BASE);
    store32(&tex + NATIVE_TEX_FIELD_WIDTH,     256);
    store32(&tex + NATIVE_TEX_FIELD_HEIGHT,    256);
    store32(&tex + NATIVE_TEX_FIELD_MIP_COUNT, 9);
    assert_eq(native_texture_level_va(&tex, 0), _NATIVE_TEXTURE_VA_BASE,
    "level 0 VA = chain base");
    assert_eq(native_texture_level_va(&tex, 1), _NATIVE_TEXTURE_VA_BASE + 262144,
    "level 1 VA = base + 256*256*4");
    assert_eq(native_texture_level_va(&tex, 2), _NATIVE_TEXTURE_VA_BASE + 327680,
    "level 2 VA = base + level0 + level1");
    assert_eq(native_texture_level_va(0, 0), 0, "null tex -> 0");
    return 0;
}

# v3.1 [M.4]: the 2x2 downsample shader. The authoritative encoding check
# is `scripts/disasm-shaders.sh` (llvm-mc round-trip); this CPU test pins
# the size + a full-buffer checksum (catches any accidental dword edit to
# the builder) + spot-checks the load-bearing instructions.
fn test_native_gfx9_shader_downsample_2x2() {
    var buf[380];
    memset(&buf, 0, 380);
    var end = native_gfx9_shader_downsample_2x2(&buf, 0);
    assert_eq(GFX9_DOWNSAMPLE_2X2_SIZE, 380, "downsample size const = 380");
    assert_eq(end, 380, "builder returns pos + 380");
    # Spot-check the structurally important instructions.
    assert_eq(load32(&buf + 0),   0x92080407, "first: s_mul_i32 s8, s7, s4");
    assert_eq(load32(&buf + 72),  0xDC548000, "global_load_dwordx2 (a,b)");
    assert_eq(load32(&buf + 80),  0xDC548000, "global_load_dwordx2 (c,d)");
    assert_eq(load32(&buf + 300), 0xDC708000, "global_store_dword");
    assert_eq(load32(&buf + 312), 0xBF810000, "s_endpgm");
    assert_eq(load32(&buf + 316), 0xBF800000, "first prefetch NOP");
    assert_eq(load32(&buf + 376), 0xBF800000, "last prefetch NOP");
    # Full-buffer checksum: sum of all 95 dwords (79 instr + 16 NOP). Any
    # single-dword transcription error changes this. Value derived from the
    # llvm-mc encodings, independent of the builder.
    var sum = 0;
    var i = 0;
    while (i < 380) {
        sum = sum + load32(&buf + i);
        i = i + 4;
    }
    assert_eq(sum, 179445143226, "downsample shader dword checksum");
    return 0;
}

# v3.1 [M.5]: native_pm4_build_compute_downsample. Structural CPU test —
# builds the 64-dword PM4 stream and verifies the downsample-specific
# register values are wired (RSRC1 16VGPR/24SGPR, RSRC2 USER_SGPR=6 +
# TGID_X|Y, src/dst level VAs in user data, dispatch grid, completion
# marker). HW dispatch validation lands in M.7.
fn test_native_pm4_compute_downsample() {
    var buf[256];
    memset(&buf, 0, 256);
    # distinctive VAs so the user-data low dwords are unambiguous in a scan.
    var n = native_pm4_build_compute_downsample(&buf,
    0xFFFF800180000000, 0xFFFF800100004000,
    0x1111000000001000, 0x2222000000002000, 128, 64);
    assert_eq(n, 256, "padded to 64 dwords (256 bytes)");
    var rsrc1 = 0;
    var rsrc2 = 0;
    var src = 0;
    var dst = 0;
    var marker = 0;
    var dimx = 0;
    var dimy = 0;
    var i = 0;
    while (i < 256) {
        var d = load32(&buf + i);
        if (d == 0x2C0083)   { rsrc1 = 1; }
        if (d == 0x18C)      { rsrc2 = 1; }
        if (d == 0x00001000) { src = 1; }
        if (d == 0x00002000) { dst = 1; }
        if (d == 0xC0FFEE12) { marker = 1; }
        if (d == 128)        { dimx = 1; }
        if (d == 64)         { dimy = 1; }
        i = i + 4;
    }
    assert_eq(rsrc1, 1, "RSRC1 0x2C0083 wired (16 VGPR / 24 SGPR)");
    assert_eq(rsrc2, 1, "RSRC2 0x18C wired (USER_SGPR=6 + TGID_X|Y)");
    assert_eq(src, 1, "src level VA low dword in user data");
    assert_eq(dst, 1, "dst level VA low dword in user data");
    assert_eq(marker, 1, "WR_CONFIRM completion marker present");
    assert_eq(dimx, 1, "dst_w dispatch dim / USER_DATA_4 wired");
    assert_eq(dimy, 1, "dst_h dispatch dim wired");
    return 0;
}

# ================================================================
# v3 Step 6.3 — native render target primitives (Phase C render)
# ================================================================
# CPU-only tests for the RT allocator + release pair. End-to-end
# hardware validation lands in Step 6.9 (programs/native_render_e2e).

fn test_native_rt_size_formula() {
    assert_eq(native_rt_size_2d_rgba8(1, 1),     4,        "1x1 = 4 bytes");
    assert_eq(native_rt_size_2d_rgba8(64, 32),   8192,     "64x32");
    assert_eq(native_rt_size_2d_rgba8(256, 256), 262144,   "256x256");
    assert_eq(native_rt_size_2d_rgba8(0, 0),     0,        "0x0 degenerate");
    return 0;
}

fn test_native_rt_struct_field_offsets() {
    assert_eq(NATIVE_RT_FIELD_HANDLE, 0,  "handle at +0");
    assert_eq(NATIVE_RT_FIELD_VA,     8,  "va at +8");
    assert_eq(NATIVE_RT_FIELD_ADDR,   16, "addr at +16");
    assert_eq(NATIVE_RT_FIELD_SIZE,   24, "size at +24");
    assert_eq(NATIVE_RT_FIELD_WIDTH,  32, "width at +32");
    assert_eq(NATIVE_RT_FIELD_HEIGHT, 36, "height at +36");
    assert_eq(NATIVE_RT_STRUCT_SIZE,  40, "total = 40");
    return 0;
}

fn test_native_rt_va_distinct_from_other_pools() {
    # RT VA must not collide with shader / stub / IB / fence /
    # output / texture VAs. Catches the "moved a VA constant"
    # mistake before runtime.
    assert(_NATIVE_RT_VA_BASE != _NATIVE_STUB_VA,            "rt != stub");
    assert(_NATIVE_RT_VA_BASE != _NATIVE_IB_VA,              "rt != IB");
    assert(_NATIVE_RT_VA_BASE != _NATIVE_FENCE_VA,           "rt != fence");
    assert(_NATIVE_RT_VA_BASE != _NATIVE_TEXTURE_VA_BASE,    "rt != texture");
    assert(_NATIVE_RT_VA_BASE != 0xFFFF800100000000,         "rt != shader VA");
    assert(_NATIVE_RT_VA_BASE != 0xFFFF800100400000,         "rt != output VA");
    return 0;
}

fn test_native_rt_struct_round_trip() {
    var rt[40];
    memset(&rt, 0, 40);
    store64(&rt + NATIVE_RT_FIELD_HANDLE, 0xCAFE);
    store64(&rt + NATIVE_RT_FIELD_VA,     _NATIVE_RT_VA_BASE);
    store64(&rt + NATIVE_RT_FIELD_ADDR,   0xBEEF);
    store64(&rt + NATIVE_RT_FIELD_SIZE,   8192);
    store32(&rt + NATIVE_RT_FIELD_WIDTH,  64);
    store32(&rt + NATIVE_RT_FIELD_HEIGHT, 32);
    assert_eq(load64(&rt + NATIVE_RT_FIELD_HANDLE), 0xCAFE,            "handle round-trips");
    assert_eq(load64(&rt + NATIVE_RT_FIELD_VA),     _NATIVE_RT_VA_BASE, "va round-trips");
    assert_eq(load64(&rt + NATIVE_RT_FIELD_ADDR),   0xBEEF,            "addr round-trips");
    assert_eq(load64(&rt + NATIVE_RT_FIELD_SIZE),   8192,              "size round-trips");
    assert_eq(load32(&rt + NATIVE_RT_FIELD_WIDTH),  64,                "width round-trips");
    assert_eq(load32(&rt + NATIVE_RT_FIELD_HEIGHT), 32,                "height round-trips");
    return 0;
}

fn test_native_rt_release_safe_zero() {
    var rt[40];
    memset(&rt, 0, 40);
    assert_eq(native_rt_release_2d_rgba8(7, 0),    0, "null rt is safe");
    assert_eq(native_rt_release_2d_rgba8(7, &rt),  0, "zero-handle rt is safe");
    return 0;
}

# ================================================================
# v3 Step 6.4 — SET_CONTEXT_REG + DRAW_INDEX_AUTO PM4 builders
# ================================================================
# Byte-exact tests for the new graphics-side PM4 emitters. The
# wire format mirrors SET_SH_REG / SET_UCONFIG_REG; differences
# are the opcode and the dword-offset base. Step 6.5 will validate
# these byte sequences against radv's output for a full clear-
# triangle dispatch (the existing Phase B.4 protocol).

fn test_native_pm4_opcodes_extended() {
    assert_eq(IT_SET_CONTEXT_REG, 0x69, "SET_CONTEXT_REG opcode");
    assert_eq(IT_DRAW_INDEX_AUTO, 0x2D, "DRAW_INDEX_AUTO opcode");
    assert_eq(PM4_CONTEXT_REG_BASE, 0xA000, "context-reg base byte address");
    return 0;
}

fn test_native_context_reg_offset_encoding() {
    # Synthetic 4-aligned context-register addresses. Specific R_*
    # register values land in Step 6.5 against radv's IB dump.
    assert_eq(native_context_reg_offset(0xA000), 0,    "base address → 0");
    assert_eq(native_context_reg_offset(0xA00C), 3,    "+12 bytes → dw offset 3");
    assert_eq(native_context_reg_offset(0xA238), 0x8E, "+0x238 bytes → dw 0x8E");
    assert_eq(native_context_reg_offset(0xA318), 0xC6, "+0x318 bytes → dw 0xC6");
    assert_eq(native_context_reg_offset(0xA31C), 0xC7, "+0x31C bytes → dw 0xC7");
    return 0;
}

fn test_native_pm4_set_context_reg_one_layout() {
    var buf[16];
    memset(&buf, 0xFF, 16);
    # Use 0xA238 (synthetic; happens to match radv's CB_TARGET_MASK)
    var pos = native_pm4_set_context_reg_one(&buf, 0, 0xA238, 0xF);
    assert_eq(pos, 12, "single-reg context-set = 3 dwords");
    # Header: PKT3(IT_SET_CONTEXT_REG, count=2, 0) → count_minus_1=1
    # → (3<<30) | (1<<16) | (0x69<<8) = 0xC0016900.
    assert_eq(load32(&buf + 0), 0xC0016900, "header bytes");
    assert_eq(load32(&buf + 4), 0x8E,       "reg_offset dword (0x238/4)");
    assert_eq(load32(&buf + 8), 0xF,        "value");
    return 0;
}

fn test_native_pm4_set_context_reg_pair_layout() {
    var buf[20];
    memset(&buf, 0xFF, 20);
    var values[8];
    store32(&values + 0, 0xAAAAAAAA);
    store32(&values + 4, 0xBBBBBBBB);
    # Use 0xA00C (synthetic; happens to match a scissor TL register)
    var pos = native_pm4_set_context_reg_pair(&buf, 0, 0xA00C, &values);
    assert_eq(pos, 16, "pair context-set = 4 dwords");
    # Header: PKT3(IT_SET_CONTEXT_REG, count=3, 0) → count_minus_1=2
    # → 0xC0026900.
    assert_eq(load32(&buf + 0),  0xC0026900, "header bytes");
    assert_eq(load32(&buf + 4),  3,           "reg_offset dw (0xC/4)");
    assert_eq(load32(&buf + 8),  0xAAAAAAAA, "value 0");
    assert_eq(load32(&buf + 12), 0xBBBBBBBB, "value 1");
    return 0;
}

fn test_native_pm4_set_context_reg_multi_layout() {
    # 4-register write — common for CB_COLOR0_PITCH/_SLICE/_VIEW/_INFO
    # in a single packet.
    var buf[28];
    memset(&buf, 0xFF, 28);
    var values[16];
    store32(&values +  0, 0x11);
    store32(&values +  4, 0x22);
    store32(&values +  8, 0x33);
    store32(&values + 12, 0x44);
    # Use 0xA31C (synthetic; matches CB_COLOR0_PITCH per Mesa sid.h)
    var pos = native_pm4_set_context_reg(&buf, 0, 0xA31C, 4, &values);
    assert_eq(pos, 24, "multi(4) context-set = 6 dwords");
    # Header: PKT3(IT_SET_CONTEXT_REG, count=5, 0) → count_minus_1=4
    # → 0xC0046900.
    assert_eq(load32(&buf + 0), 0xC0046900, "header bytes");
    assert_eq(load32(&buf + 4), 0xC7,       "reg_offset dw (0x31C/4)");
    assert_eq(load32(&buf + 8),  0x11, "value 0");
    assert_eq(load32(&buf + 12), 0x22, "value 1");
    assert_eq(load32(&buf + 16), 0x33, "value 2");
    assert_eq(load32(&buf + 20), 0x44, "value 3");
    return 0;
}

fn test_native_pm4_draw_index_auto_layout() {
    var buf[16];
    memset(&buf, 0xFF, 16);
    var pos = native_pm4_draw_index_auto(&buf, 0, 3, DI_SRC_SEL_AUTO_INDEX);
    assert_eq(pos, 12, "DRAW_INDEX_AUTO = 3 dwords");
    # Header: PKT3(IT_DRAW_INDEX_AUTO, count=2, 0) → count_minus_1=1
    # → (3<<30) | (1<<16) | (0x2D<<8) = 0xC0012D00.
    assert_eq(load32(&buf + 0), 0xC0012D00, "header bytes");
    assert_eq(load32(&buf + 4), 3,          "vertex_count");
    assert_eq(load32(&buf + 8), 0x02,       "draw_initiator (auto-index)");
    return 0;
}

fn test_native_pm4_di_src_sel_constant() {
    # DI_SRC_SEL_AUTO_INDEX is the source-select bits for an auto-
    # index draw. Standard value per Mesa's V_0287F0_DI_SRC_SEL_AUTO_INDEX = 2.
    assert_eq(DI_SRC_SEL_AUTO_INDEX, 0x02, "auto-index source select");
    return 0;
}

# ================================================================
# v3 Step 6.2(a) — graphics-pipeline register addresses + minimums
# ================================================================
# Value-asserts for the spec-anchored constants in
# src/backend_native.cyr Step 6.2(a) section. Pattern follows the
# 4f.ii lesson — every computed/spec-derived constant that the PM4
# stream will eventually emit gets a CPU value-assert so a typo
# surfaces at test time, not at hardware-debug time.

fn test_gfx9_vs_sh_register_addresses() {
    # VS shader-program registers (Mesa: R_00B12{0,4,8,C}_SPI_SHADER_*_VS).
    assert_eq(R_SPI_SHADER_PGM_LO_VS,    0xB120, "VS PGM_LO byte addr");
    assert_eq(R_SPI_SHADER_PGM_HI_VS,    0xB124, "VS PGM_HI byte addr");
    assert_eq(R_SPI_SHADER_PGM_RSRC1_VS, 0xB128, "VS PGM_RSRC1 byte addr");
    assert_eq(R_SPI_SHADER_PGM_RSRC2_VS, 0xB12C, "VS PGM_RSRC2 byte addr");
    # Wire-form: (addr - 0xB000) / 4. 0xB120 → 0x48, sequential by 1.
    assert_eq(native_sh_reg_offset(R_SPI_SHADER_PGM_LO_VS),    0x48, "VS PGM_LO wire");
    assert_eq(native_sh_reg_offset(R_SPI_SHADER_PGM_RSRC2_VS), 0x4B, "VS PGM_RSRC2 wire");
    return 0;
}

fn test_gfx9_ps_sh_register_addresses() {
    # PS shader-program registers (Mesa: R_00B02{0,4,8,C}_SPI_SHADER_*_PS).
    assert_eq(R_SPI_SHADER_PGM_LO_PS,    0xB020, "PS PGM_LO byte addr");
    assert_eq(R_SPI_SHADER_PGM_HI_PS,    0xB024, "PS PGM_HI byte addr");
    assert_eq(R_SPI_SHADER_PGM_RSRC1_PS, 0xB028, "PS PGM_RSRC1 byte addr");
    assert_eq(R_SPI_SHADER_PGM_RSRC2_PS, 0xB02C, "PS PGM_RSRC2 byte addr");
    assert_eq(native_sh_reg_offset(R_SPI_SHADER_PGM_LO_PS),    0x08, "PS PGM_LO wire");
    assert_eq(native_sh_reg_offset(R_SPI_SHADER_PGM_RSRC2_PS), 0x0B, "PS PGM_RSRC2 wire");
    return 0;
}

fn test_gfx9_spi_format_register_addresses() {
    # SPI shader output format context regs (Mesa gfx9.json:
    # POS_FORMAT=0x02870C, Z_FORMAT=0x028710, COL_FORMAT=0x028714).
    # Mabda 0xA-shorthand (synthetic 0xA000 base) produces identical wire form.
    assert_eq(R_SPI_SHADER_POS_FORMAT, 0xA70C, "SPI_SHADER_POS_FORMAT byte addr");
    assert_eq(R_SPI_SHADER_Z_FORMAT,   0xA710, "SPI_SHADER_Z_FORMAT byte addr");
    assert_eq(R_SPI_SHADER_COL_FORMAT, 0xA714, "SPI_SHADER_COL_FORMAT byte addr");
    # Wire-form: (addr - 0xA000) / 4. 0xA70C → 0x1C3, etc.
    assert_eq(native_context_reg_offset(R_SPI_SHADER_POS_FORMAT), 0x1C3, "POS_FORMAT wire");
    assert_eq(native_context_reg_offset(R_SPI_SHADER_Z_FORMAT),   0x1C4, "Z_FORMAT wire");
    assert_eq(native_context_reg_offset(R_SPI_SHADER_COL_FORMAT), 0x1C5, "COL_FORMAT wire");
    return 0;
}

fn test_gfx9_cb_target_mask_address() {
    # Pipeline-static color-buffer write mask (Mesa R_028238_CB_TARGET_MASK).
    # Wire form 0x8E was already exercised by test_native_pm4_set_context_reg_one_layout
    # using the synthetic literal 0xA238; this assert pins the named constant.
    assert_eq(R_CB_TARGET_MASK, 0xA238, "CB_TARGET_MASK byte addr");
    assert_eq(native_context_reg_offset(R_CB_TARGET_MASK), 0x8E, "CB_TARGET_MASK wire");
    return 0;
}

fn test_gfx9_pgm_rsrc_minimums() {
    # RSRC1: VS+PS share the compute minimum (FLOAT_MODE 0xC0, SGPRS=1, DX10_CLAMP, IEEE).
    assert_eq(GFX9_GFX_PGM_RSRC1_MIN, 0x2C0040, "GFX RSRC1 minimum value");
    assert_eq(GFX9_GFX_PGM_RSRC1_MIN, GFX9_COMPUTE_PGM_RSRC1_MIN, "GFX RSRC1 mirrors compute");
    # RSRC2: SPI requires non-zero USER_SGPR allocation for graphics stages.
    # Byte-exact from radv triangle reference on Cezanne (2026-05-13):
    # VS USER_SGPR=3 → RSRC2_VS = 0x6, PS USER_SGPR=2 → RSRC2_PS = 0x4.
    assert_eq(GFX9_VS_PGM_RSRC2_MIN, 0x6, "VS RSRC2 minimum");
    assert_eq(GFX9_PS_PGM_RSRC2_MIN, 0x4, "PS RSRC2 minimum");
    return 0;
}

fn test_gfx9_spi_format_field_values() {
    # POS_FORMAT = FLOAT_4 — VS exports four f32 lanes.
    assert_eq(SPI_SHADER_POS_FORMAT_4, 0x4, "POS_FORMAT FLOAT_4");
    # Z_FORMAT = INVALID — FS does not export depth.
    assert_eq(SPI_SHADER_Z_FORMAT_INVALID, 0x0, "Z_FORMAT INVALID");
    # COL_FORMAT candidates for RGBA8 RT — Step 6.5 picks one and verifies
    # by CPU-readback. Default is FP32_ABGR (FS writes f32; export quantizes).
    # GFX9 4-bit SPI_SHADER_COL_FORMAT field values (gfx9.json):
    #   4=FP16_ABGR, 5=UNORM16_ABGR, 9=32_ABGR (FP32). Mabda previously
    #   shipped 0x9/0xA/0xE — those are reserved/undocumented values
    #   that the SX silently routes to SPI_SHADER_ZERO (no output).
    #   Fixed 2026-05-13 — pixel(0,0) = (0xFF,0,0,0xFF) on Cezanne.
    assert_eq(SPI_SHADER_COL_FORMAT_FP16_ABGR,    0x4, "COL_FORMAT FP16_ABGR");
    assert_eq(SPI_SHADER_COL_FORMAT_UNORM16_ABGR, 0x5, "COL_FORMAT UNORM16_ABGR");
    assert_eq(SPI_SHADER_COL_FORMAT_FP32_ABGR,    0x9, "COL_FORMAT FP32_ABGR");
    return 0;
}

fn test_gfx9_fullscreen_triangle_vertex_count() {
    # Full-screen triangle: 3 vertices generated from vertex_id 0/1/2
    # via switch in the VS body (no VBO).
    assert_eq(GFX9_FULLSCREEN_TRI_VCOUNT, 3, "full-screen triangle vertex count");
    return 0;
}

# ================================================================
# v3 Step 6.2(b) — fragment shader bytes (solid red FS)
# ================================================================
# Pin every dword the FS encoder emits, plus the total byte count.
# Per the 4f.ii lesson, value-asserting every spec-derived constant
# at CPU test time means a typo in an instruction encoding (top
# byte 0x7E for VOP1, 0xC4 for EXP, 0xBF for SOPP) surfaces here
# rather than as a TDR on hardware. Header citations live in
# src/backend_native.cyr Step 6.2(b) section.

fn test_gfx9_fs_solid_red_byte_pattern() {
    var buf[96];
    memset(&buf, 0xCC, 96);
    var pos = native_gfx9_shader_solid_red(&buf, 0);
    assert_eq(pos, GFX9_FS_SOLID_RED_SIZE, "FS shader writes 92 bytes");
    assert_eq(GFX9_FS_SOLID_RED_SIZE, 92, "FS size constant");

    # Four v_mov_b32_e32 instructions setting v0..v3 to (1.0, 0.0, 0.0, 1.0).
    # VOP1 top byte = 0x7E. Inline constants 242 = 1.0, 128 = 0.0.
    assert_eq(load32(&buf +  0), 0x7E0002F2, "v_mov v0, 1.0");
    assert_eq(load32(&buf +  4), 0x7E020280, "v_mov v1, 0.0");
    assert_eq(load32(&buf +  8), 0x7E040280, "v_mov v2, 0.0");
    assert_eq(load32(&buf + 12), 0x7E0602F2, "v_mov v3, 1.0");

    # EXP instruction (8 bytes, 2 dwords). Top byte 0xC4 (encoding
    # 0x31 in bits 26-31; the GFX9 EXP opcode, verified by llvm-mc).
    # Mabda previously used 0xF8 → "invalid encoding" → silent VS/FS
    # stall → 2-second GFX TDR. Fixed 2026-05-13.
    # Word 0 carries en/tgt/done/vm flags; word 1 carries vsrc0..3.
    assert_eq(load32(&buf + 16), 0xC400180F, "exp mrt0 done vm word 0");
    assert_eq(load32(&buf + 20), 0x03020100, "exp mrt0 vsrc0..3 = v0..v3");

    # s_endpgm (SOPP, 0xBF810000) — same byte pattern as compute.
    assert_eq(load32(&buf + 24), 0xBF810000, "s_endpgm");

    # 16 NOP-padding dwords (s_nop 0 = 0xBF800000) — AMDGPU prefetch
    # requirement; matches the compute shader's tail.
    var i = 0;
    while (i < 16) {
        assert_eq(load32(&buf + 28 + i * 4), 0xBF800000, "s_nop padding");
        i = i + 1;
    }
    return 0;
}

# v3.2 TS.4 — textured FS (image_load oracle). Bytes assembled + round-tripped
# via llvm-mc -mcpu=gfx90c; pinned here so a refactor can't silently change
# the ISA (the EXP/COL_FORMAT class of bug). HW exercise is TS.5.
fn test_gfx9_fs_textured_load_byte_pattern() {
    var buf[108];
    memset(&buf, 0xCC, 108);
    var pos = native_gfx9_shader_textured_load_fs(&buf, 0);
    assert_eq(pos, GFX9_FS_TEXTURED_LOAD_SIZE, "textured FS writes 108 bytes");
    assert_eq(GFX9_FS_TEXTURED_LOAD_SIZE, 108, "FS size constant");
    # s_load_dwordx8 s[0:7], s[0:1], 0x0 — load the T# from the descriptor BO.
    assert_eq(load32(&buf +  0), 0xC00E0000, "s_load_dwordx8 word 0");
    assert_eq(load32(&buf +  4), 0x00000000, "s_load_dwordx8 word 1");
    assert_eq(load32(&buf +  8), 0xBF8CC07F, "s_waitcnt lgkmcnt(0)");
    # screen pos (v2,v3) -> integer texel coords (v4,v5).
    assert_eq(load32(&buf + 12), 0x7E081102, "v_cvt_i32_f32 v4, v2");
    assert_eq(load32(&buf + 16), 0x7E0A1103, "v_cvt_i32_f32 v5, v3");
    # image_load v[0:3], v[4:5], s[0:7] dmask:0xf unorm (MIMG, 2 dwords).
    assert_eq(load32(&buf + 20), 0xF0001F00, "image_load word 0 (dmask 0xf unorm)");
    assert_eq(load32(&buf + 24), 0x00000004, "image_load word 1 (vaddr v4, srsrc s[0:7])");
    assert_eq(load32(&buf + 28), 0xBF8C0F70, "s_waitcnt vmcnt(0)");
    # exp mrt0 — identical EXP encoding to solid_red (the proven 0xC4 class).
    assert_eq(load32(&buf + 32), 0xC400180F, "exp mrt0 done vm word 0");
    assert_eq(load32(&buf + 36), 0x03020100, "exp mrt0 vsrc0..3 = v0..v3");
    assert_eq(load32(&buf + 40), 0xBF810000, "s_endpgm");
    var i = 0;
    while (i < 16) {
        assert_eq(load32(&buf + 44 + i * 4), 0xBF800000, "s_nop padding");
        i = i + 1;
    }
    assert_eq(GFX9_SPI_PS_INPUT_TEXTURED, 0x302,
    "SPI_PS_INPUT = PERSP_CENTER|POS_X|POS_Y");
    return 0;
}

fn test_gfx9_fs_solid_red_alignment() {
    # The FS payload must be 4-byte aligned (every store is 32-bit)
    # and the total size must be a multiple of 4 — confirming PM4
    # set_sh_reg can point PGM_LO/HI at any 256-byte-aligned BO offset
    # without unaligned-instruction hazards. The 92-byte size leaves
    # 164 bytes of slack within a 256-byte-aligned shader BO slot;
    # the BO allocator at Step 6.5 sizes accordingly.
    assert_eq(GFX9_FS_SOLID_RED_SIZE % 4, 0, "FS size is dword-aligned");
    return 0;
}

fn test_gfx9_vs_fullscreen_triangle_byte_pattern() {
    # VS bytes cross-checked against `clang -target amdgcn--amdhsa
    # -mcpu=gfx90c -O2` of the equivalent CL kernel. The arithmetic
    # VOP2 opcodes (v_lshlrev_b32 = 0x12, v_and_b32 = 0x13, v_add_u32
    # = 0x34) are ABI-independent, so the compute-ABI disassembly
    # gives authoritative encodings for the graphics-ABI shader.
    var buf[128];
    memset(&buf, 0xCC, 128);
    var pos = native_gfx9_shader_fullscreen_triangle_vs(&buf, 0);
    assert_eq(pos, GFX9_VS_FULLSCREEN_TRIANGLE_SIZE, "VS shader writes 116 bytes");
    assert_eq(GFX9_VS_FULLSCREEN_TRIANGLE_SIZE, 116, "VS size constant");

    # VOP2 arithmetic: shift, mask, subtract — all top byte 0x24/0x26/0x68
    # (opcodes 0x12, 0x13, 0x34 in bits 30-25).
    assert_eq(load32(&buf +  0), 0x24040081, "v_lshlrev_b32 v2, 1, v0");
    assert_eq(load32(&buf +  4), 0x24000082, "v_lshlrev_b32 v0, 2, v0");
    assert_eq(load32(&buf +  8), 0x26000084, "v_and_b32 v0, 4, v0");
    assert_eq(load32(&buf + 12), 0x26040484, "v_and_b32 v2, 4, v2");
    assert_eq(load32(&buf + 16), 0x680000C1, "v_add_u32 v0, -1, v0");
    assert_eq(load32(&buf + 20), 0x680404C1, "v_add_u32 v2, -1, v2");

    # VOP1 cvt + mov — top byte 0x7E. cvt opcode 5, mov opcode 1.
    # VGPR src in 9-bit src0 starts at 256 (v0=0x100, v1=0x101, v2=0x102).
    assert_eq(load32(&buf + 24), 0x7E000B00, "v_cvt_f32_i32 v0, v0");
    assert_eq(load32(&buf + 28), 0x7E020B02, "v_cvt_f32_i32 v1, v2");
    assert_eq(load32(&buf + 32), 0x7E040280, "v_mov v2, 0.0");
    assert_eq(load32(&buf + 36), 0x7E0602F2, "v_mov v3, 1.0");

    # EXP pos0 done — top byte 0xC4 (GFX9 EXP opcode 0x31, verified
    # by llvm-mc). tgt=12 (pos0) in bits 4-9. exp pos0 done en=0xF:
    # 0xC4000000 | (1<<11) | (12<<4) | 0xF = 0xC40008CF.
    # Mabda previously used 0xF8 → "invalid encoding" → silent VS/FS
    # stall → 2-second GFX TDR. Fixed 2026-05-13.
    assert_eq(load32(&buf + 40), 0xC40008CF, "exp pos0 done word 0");
    assert_eq(load32(&buf + 44), 0x03020100, "exp pos0 vsrc0..3 = v0..v3");

    # s_endpgm — same as compute and FS.
    assert_eq(load32(&buf + 48), 0xBF810000, "s_endpgm");

    # 16 NOP padding dwords.
    var i = 0;
    while (i < 16) {
        assert_eq(load32(&buf + 52 + i * 4), 0xBF800000, "s_nop padding");
        i = i + 1;
    }
    return 0;
}

fn test_gfx9_vs_fullscreen_triangle_alignment() {
    # Dword-aligned, fits within a 256-byte-aligned shader BO slot
    # with 140 bytes of slack. Step 6.5 sizes the VS BO accordingly.
    assert_eq(GFX9_VS_FULLSCREEN_TRIANGLE_SIZE % 4, 0, "VS size is dword-aligned");
    return 0;
}

# ================================================================
# v3 Step 6.5(a) — clear-triangle PM4 register addresses + values
# ================================================================
# Pin every constant added for the Step 6.5(b) PM4 stream composer.
# Values extracted from the authoritative Mesa
# src/amd/registers/gfx9.json (fetched 2026-04-30); pinning here
# means a typo in transcription surfaces at CPU test time. Group
# follows the 3-block PM4 split in
# docs/proposals/v3-backend-interface.md v2.1.

fn test_gfx9_pipeline_ctx_register_addresses() {
    # Color/blend mode.
    assert_eq(R_CB_SHADER_MASK,    0xA23C, "CB_SHADER_MASK byte addr");
    assert_eq(R_CB_COLOR_CONTROL,  0xA808, "CB_COLOR_CONTROL byte addr");
    assert_eq(R_CB_BLEND0_CONTROL, 0xA780, "CB_BLEND0_CONTROL byte addr");
    # Rasterizer / clip mode.
    assert_eq(R_PA_SU_SC_MODE_CNTL, 0xA814, "PA_SU_SC_MODE_CNTL byte addr");
    assert_eq(R_PA_CL_CLIP_CNTL,    0xA810, "PA_CL_CLIP_CNTL byte addr");
    # Stage enable + reuse.
    assert_eq(R_VGT_SHADER_STAGES_EN, 0xAB54, "VGT_SHADER_STAGES_EN byte addr");
    assert_eq(R_VGT_REUSE_OFF,        0xAAB4, "VGT_REUSE_OFF byte addr");
    # SPI inputs/outputs.
    assert_eq(R_SPI_PS_INPUT_ENA,  0xA6CC, "SPI_PS_INPUT_ENA byte addr");
    assert_eq(R_SPI_PS_INPUT_ADDR, 0xA6D0, "SPI_PS_INPUT_ADDR byte addr");
    assert_eq(R_SPI_PS_IN_CONTROL, 0xA6D8, "SPI_PS_IN_CONTROL byte addr");
    assert_eq(R_SPI_VS_OUT_CONFIG, 0xA6C4, "SPI_VS_OUT_CONFIG byte addr");
    # Depth/stencil.
    assert_eq(R_DB_SHADER_CONTROL,   0xA80C, "DB_SHADER_CONTROL byte addr");
    assert_eq(R_DB_HTILE_SURFACE,    0xAABC, "DB_HTILE_SURFACE byte addr");
    assert_eq(R_DB_RENDER_OVERRIDE,  0xA00C, "DB_RENDER_OVERRIDE byte addr");
    assert_eq(R_DB_RENDER_OVERRIDE2, 0xA010, "DB_RENDER_OVERRIDE2 byte addr");
    return 0;
}

