# tests/tcyr/native.tcyr — native AMD backend impl (amdgpu/PM4/GFX9 ISA/textures/render)
# Functionality-grouped CPU suite (v3.1 test reorg 2026-06-15).
# Self-contained: the helpers/mocks each domain's tests need are inlined
# (a few small helpers are shared across domains by design).
include "src/lib.cyr"
include "lib/assert.cyr"

fn test_native_ioc_encode_directions() {
    # dir lives in bits 30-31. Each direction swaps bit patterns there.
    assert_eq(native_ioc_encode(0, 0, 0, 0), 0x00000000, "NONE dir = 0 upper bits");
    assert_eq(native_ioc_encode(1, 0, 0, 0), 0x40000000, "WRITE dir = 0x40000000");
    assert_eq(native_ioc_encode(2, 0, 0, 0), 0x80000000, "READ dir = 0x80000000");
    assert_eq(native_ioc_encode(3, 0, 0, 0), 0xC0000000, "RW dir = 0xC0000000");
    return 0;
}

fn test_native_ioc_encode_size_in_bits_16_to_29() {
    # Size field is 14 bits wide (bits 16-29). Small size packs cleanly.
    assert_eq(native_ioc_encode(0, 1, 0, 0), 0x00010000, "size=1 at bit 16");
    assert_eq(native_ioc_encode(0, 64, 0, 0), 0x00400000, "size=64 at bit 16+6");
    assert_eq(native_ioc_encode(0, 0x3FFF, 0, 0), 0x3FFF0000, "size=max (14 bits all set)");
    # Size overflow: 0x4000 wraps to 0 (14-bit mask).
    assert_eq(native_ioc_encode(0, 0x4000, 0, 0), 0x00000000, "size overflow masks to 0");
    return 0;
}

fn test_native_ioc_encode_type_and_nr() {
    # type is bits 8-15, nr is bits 0-7. Both byte-sized.
    assert_eq(native_ioc_encode(0, 0, 0x64, 0), 0x00006400, "type=0x64 at bits 8-15");
    assert_eq(native_ioc_encode(0, 0, 0, 0xFF), 0x000000FF, "nr=0xFF at bits 0-7");
    assert_eq(native_ioc_encode(0, 0, 0xFF, 0xFF), 0x0000FFFF, "type+nr combined");
    return 0;
}

fn test_native_render_node_path() {
    # Constant must equal the canonical first-render-node path.
    var expected = "/dev/dri/renderD128";
    assert_eq(strlen(DRM_RENDER_NODE_PATH), strlen(expected), "path length matches");
    assert_eq(memeq(DRM_RENDER_NODE_PATH, expected, strlen(expected)), 1, "path contents match");
    return 0;
}

fn test_native_amdgpu_ioctl_nr_offsets() {
    assert_eq(DRM_AMDGPU_GEM_CREATE, 0x00, "GEM_CREATE nr offset");
    assert_eq(DRM_AMDGPU_GEM_MMAP,   0x01, "GEM_MMAP nr offset");
    return 0;
}

fn test_native_gem_create_ioctl_encoding() {
    # _IOWR('d', DRM_COMMAND_BASE + 0, union drm_amdgpu_gem_create) with 32-byte union.
    var expected = native_ioc_encode(3, DRM_AMDGPU_GEM_CREATE_SIZE, DRM_IOCTL_TYPE,
    DRM_COMMAND_BASE + DRM_AMDGPU_GEM_CREATE);
    assert_eq(DRM_IOCTL_AMDGPU_GEM_CREATE, expected, "GEM_CREATE ioctl = 0xC0206440");
    assert_eq(DRM_IOCTL_AMDGPU_GEM_CREATE, 0xC0206440, "precomputed constant");
    return 0;
}

fn test_native_gem_mmap_ioctl_encoding() {
    # _IOWR('d', 0x41, union drm_amdgpu_gem_mmap) with 8-byte union.
    var expected = native_ioc_encode(3, DRM_AMDGPU_GEM_MMAP_SIZE, DRM_IOCTL_TYPE,
    DRM_COMMAND_BASE + DRM_AMDGPU_GEM_MMAP);
    assert_eq(DRM_IOCTL_AMDGPU_GEM_MMAP, expected, "GEM_MMAP ioctl = 0xC0086441");
    assert_eq(DRM_IOCTL_AMDGPU_GEM_MMAP, 0xC0086441, "precomputed constant");
    return 0;
}

fn test_native_gem_close_ioctl_encoding() {
    # _IOW('d', 0x09, struct drm_gem_close) with 8-byte struct.
    var expected = native_ioc_encode(1, DRM_GEM_CLOSE_SIZE, DRM_IOCTL_TYPE, 0x09);
    assert_eq(DRM_IOCTL_GEM_CLOSE, expected, "GEM_CLOSE ioctl = 0x40086409");
    assert_eq(DRM_IOCTL_GEM_CLOSE, 0x40086409, "precomputed constant");
    return 0;
}

fn test_native_amdgpu_gem_domains() {
    # Domain bit values mirror kernel UAPI. They are disjoint single bits.
    assert_eq(AMDGPU_GEM_DOMAIN_CPU,  0x1, "CPU = 0x1");
    assert_eq(AMDGPU_GEM_DOMAIN_GTT,  0x2, "GTT = 0x2");
    assert_eq(AMDGPU_GEM_DOMAIN_VRAM, 0x4, "VRAM = 0x4");
    # Single-bit invariant: each is a power of 2, no shared bits.
    assert_eq(AMDGPU_GEM_DOMAIN_CPU & AMDGPU_GEM_DOMAIN_GTT,  0, "CPU/GTT disjoint");
    assert_eq(AMDGPU_GEM_DOMAIN_GTT & AMDGPU_GEM_DOMAIN_VRAM, 0, "GTT/VRAM disjoint");
    assert_eq(AMDGPU_GEM_DOMAIN_CPU & AMDGPU_GEM_DOMAIN_VRAM, 0, "CPU/VRAM disjoint");
    return 0;
}

fn test_native_gem_create_request_layout() {
    # drm_amdgpu_gem_create_in: {bo_size, alignment, domains, domain_flags}
    # each u64, packed — 32 bytes total.
    var req[32];
    memset(&req, 0, 32);
    store64(&req + 0,  0x1000);   # bo_size = 4096
    store64(&req + 8,  0x0100);   # alignment = 256
    store64(&req + 16, 0x2);      # domains = GTT
    store64(&req + 24, 0);        # domain_flags
    assert_eq(load64(&req + 0),  0x1000, "bo_size slot");
    assert_eq(load64(&req + 8),  0x0100, "alignment slot");
    assert_eq(load64(&req + 16), 0x2,    "domains slot");
    assert_eq(load64(&req + 24), 0,      "domain_flags slot");
    return 0;
}

fn test_native_gem_mmap_request_layout() {
    # drm_amdgpu_gem_mmap_in: {handle u32, _pad u32} = 8 bytes.
    # Out variant: {addr_ptr u64} at the same memory.
    var req[8];
    memset(&req, 0, 8);
    store32(&req + 0, 42);    # handle
    assert_eq(load32(&req + 0), 42, "handle at +0");
    # After kernel writes, the same 8 bytes become an i64 addr_ptr.
    memset(&req, 0, 8);
    store64(&req + 0, 0xDEAD00);
    assert_eq(load64(&req + 0), 0xDEAD00, "addr_ptr at +0 (union)");
    return 0;
}

