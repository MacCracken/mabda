include "src/lib.cyr"
include "lib/assert.cyr"

# Reproduce the const-index FLAT encode path end-to-end through the REAL
# gfx9_regalloc + gfx9_emit_program (not hand-set alloc). Mirrors what
# spirv_lower produces for buf[0]: MIR_OP_LOAD with a = off_id = 0.
fn main(): i64 {
    var m[80];
    var vals[1280];
    var instrs[512];
    var ptrs[512];
    var blocks[32];
    mir_mod_init(&m, &vals, &instrs, &ptrs, &blocks, 4, 4, 30, 30);
    _mir_set_val(&m, 9, MIR_VK_SSA, MIR_T_F32, MIR_DIVERGENT, 0, 0);
    _mir_set_val(&m, 12, MIR_VK_SSA, MIR_T_F32, MIR_DIVERGENT, 0, 0);
    mir_set_bufvar(&m, 13, 0);
    var abi[64];
    gfx9_abi_assign(&m, &abi);

    var isel[480];
    _gisel_emit(&isel, 0, GISEL_V_CVT_F32_I32, 9, 9, 0, 0, MIR_FLAG_A_IMM);
    # const-index load: dst=%12, OFFSET OPERAND a = 0 (off_id = 0, const-index case)
    _gisel_emit(&isel, 1, GISEL_GLOBAL_LOAD, 12, 0, 0, 0, 0);
    _gisel_emit(&isel, 2, GISEL_S_ENDPGM, 0, 0, 0, 0, 0);

    var alloc[512];
    var hw[16];
    var rc = gfx9_regalloc(&m, &isel, 3, 2, 1, 104, 256, &alloc, &hw);
    assert_eq(rc, 0, "regalloc ok");

    var built[256];
    memset(&built, 0, 256);
    var endp = gfx9_emit_program(&m, &isel, 3, &alloc, &abi, &built, 0);
    assert_eq(endp, 16, "program end");

    var lo = load32(&built + 4);
    var hi = load32(&built + 8);
    var vaddr = hi & 0xFF;
    assert_eq(lo, 0xDC508000, "flat_lo load");
    assert_eq(vaddr, 0xFF, "vaddr field == 0xFF (v255) -- the bug");
    return assert_summary();
}
