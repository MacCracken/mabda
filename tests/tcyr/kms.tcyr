fn test_native_drm_connector_type_name_lookup() {
    # streq isn't in scope — compare by first byte (cheap proxy
    # that catches a "wrong table entry" regression without pulling
    # the full string compare in).
    assert_eq(load8(native_drm_connector_type_name(DRM_MODE_CONNECTOR_VGA)),         86, "VGA -> V");
    assert_eq(load8(native_drm_connector_type_name(DRM_MODE_CONNECTOR_DisplayPort)), 68, "DP -> D");
    assert_eq(load8(native_drm_connector_type_name(DRM_MODE_CONNECTOR_HDMIA)),       72, "HDMI-A -> H");
    assert_eq(load8(native_drm_connector_type_name(DRM_MODE_CONNECTOR_eDP)),         101, "eDP -> e");
    assert_eq(load8(native_drm_connector_type_name(99)),                              63, "unknown -> ?");
    return 0;
}

fn test_native_drm_encoder_type_name_lookup() {
    assert_eq(load8(native_drm_encoder_type_name(DRM_MODE_ENCODER_TMDS)),    84,  "TMDS -> T");
    assert_eq(load8(native_drm_encoder_type_name(DRM_MODE_ENCODER_DAC)),     68,  "DAC -> D");
    assert_eq(load8(native_drm_encoder_type_name(DRM_MODE_ENCODER_LVDS)),    76,  "LVDS -> L");
    assert_eq(load8(native_drm_encoder_type_name(DRM_MODE_ENCODER_VIRTUAL)), 86,  "Virtual -> V");
    assert_eq(load8(native_drm_encoder_type_name(99)),                       63,  "unknown -> ?");
    return 0;
}

fn test_native_drm_connection_status_name_lookup() {
    assert_eq(load8(native_drm_connection_status_name(DRM_MODE_CONNECTED)),         99,  "connected -> c");
    assert_eq(load8(native_drm_connection_status_name(DRM_MODE_DISCONNECTED)),      100, "disconnected -> d");
    assert_eq(load8(native_drm_connection_status_name(DRM_MODE_UNKNOWNCONNECTION)), 117, "unknown -> u");
    assert_eq(load8(native_drm_connection_status_name(99)),                         63,  "fallback -> ?");
    return 0;
}

fn test_native_kms_summary_null_safe() {
    # Null state returns -1 immediately (no syscalls).
    assert_eq(native_kms_summary(0), -1, "null state");
    # Non-null state with fd=0 also returns -1 (no syscalls).
    var s[96];
    memset(&s, 0, 96);
    store64(&s + KMS_STATE_FIELD_FD, 0);
    assert_eq(native_kms_summary(&s), -1, "fd=0 state");
    return 0;
}

# v3 Step 7.2(a) — per-connector mode enum + preferred picker

fn test_drm_mode_type_constants() {
    assert_eq(DRM_MODE_TYPE_BUILTIN,   0x01, "BUILTIN");
    assert_eq(DRM_MODE_TYPE_PREFERRED, 0x08, "PREFERRED");
    assert_eq(DRM_MODE_TYPE_USERDEF,   0x20, "USERDEF");
    assert_eq(DRM_MODE_TYPE_DRIVER,    0x40, "DRIVER");
    return 0;
}

fn test_native_kms_get_connector_modes_null_safe() {
    var c[4];
    assert_eq(native_kms_get_connector_modes(0, 1, &c),  0, "fd=0");
    assert_eq(native_kms_get_connector_modes(7, 0, &c),  0, "conn_id=0");
    assert_eq(native_kms_get_connector_modes(7, 1, 0),   0, "count_out=0");
    return 0;
}

fn test_native_kms_pick_preferred_null_or_empty() {
    assert_eq(native_kms_pick_preferred_mode(0, 5), 0,  "null modes");
    var modes[68];
    memset(&modes, 0, 68);
    assert_eq(native_kms_pick_preferred_mode(&modes, 0), 0, "count=0");
    return 0;
}

fn test_native_kms_pick_preferred_finds_first_preferred() {
    # Synthetic modes array: 3 entries.
    # mode[0].type = DRIVER only (0x40)        — not preferred
    # mode[1].type = DRIVER | PREFERRED (0x48) — picked
    # mode[2].type = DRIVER | PREFERRED (0x48) — also preferred but later
    var modes[204];   # 3 × 68
    memset(&modes, 0, 204);
    store32(&modes + 0 * 68 + DRM_MODE_MODEINFO_TYPE, DRM_MODE_TYPE_DRIVER);
    store32(&modes + 1 * 68 + DRM_MODE_MODEINFO_TYPE,
      DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED);
    store32(&modes + 2 * 68 + DRM_MODE_MODEINFO_TYPE,
      DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED);
    assert_eq(native_kms_pick_preferred_mode(&modes, 3), 1,
      "picks first PREFERRED entry");
    return 0;
}

fn test_native_kms_pick_preferred_falls_back_to_zero() {
    # No PREFERRED bit set anywhere — fallback returns index 0.
    var modes[136];   # 2 × 68
    memset(&modes, 0, 136);
    store32(&modes + 0 * 68 + DRM_MODE_MODEINFO_TYPE, DRM_MODE_TYPE_DRIVER);
    store32(&modes + 1 * 68 + DRM_MODE_MODEINFO_TYPE, DRM_MODE_TYPE_DRIVER);
    assert_eq(native_kms_pick_preferred_mode(&modes, 2), 0,
      "no PREFERRED → 0");
    return 0;
}

fn test_native_kms_mode_dim_accessors() {
    # Fill a synthetic single-mode array with 1920×1080@60.
    var modes[68];
    memset(&modes, 0, 68);
    store16(&modes + DRM_MODE_MODEINFO_HDISPLAY, 1920);
    store16(&modes + DRM_MODE_MODEINFO_VDISPLAY, 1080);
    store32(&modes + DRM_MODE_MODEINFO_VREFRESH, 60000);
    store32(&modes + DRM_MODE_MODEINFO_TYPE,
      DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED);
    assert_eq(native_kms_mode_hdisplay(&modes, 0), 1920, "hdisplay");
    assert_eq(native_kms_mode_vdisplay(&modes, 0), 1080, "vdisplay");
    assert_eq(native_kms_mode_vrefresh(&modes, 0), 60000, "vrefresh");
    assert_eq(native_kms_mode_type(&modes, 0),
      DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED, "type");
    # Null-safety on accessors.
    assert_eq(native_kms_mode_hdisplay(0, 0), 0, "null hdisplay");
    assert_eq(native_kms_mode_vdisplay(0, 0), 0, "null vdisplay");
    assert_eq(native_kms_mode_vrefresh(0, 0), 0, "null vrefresh");
    assert_eq(native_kms_mode_type(0, 0),     0, "null type");
    return 0;
}

# 4.4.0 — the size a native surface must be configured with, read without master, and the
# AMD configure's refusal message when it is asked for another (it used to return a bare 0).
fn test_kms_first_connected_mode_and_size_msg() {
    var wh[16];
    store64(&wh, 7);
    store64(&wh + 8, 7);
    assert_eq(native_kms_first_connected_mode(0 - 1, &wh), 0 - 1, "bad fd refused");
    assert_eq(load64(&wh) | load64(&wh + 8), 0, "and the size zeroed");
    assert_eq(native_kms_first_connected_mode(3, 0), 0 - 1, "null out refused");
    var m[192];
    var n = _native_surface_size_msg(&m, 2560, 1440, 1920, 1080, 192);
    assert_eq(memeq(&m, "native surface: the connector's mode is 2560x1440, ", 51), 1, "names the mode");
    assert_eq(memeq(&m + 51, "not the 1920x1080 asked for (AMD does not scale", 47), 1, "and the size asked for");
    assert_eq(n, strlen(&m), "returns its length");
    var t[24];
    n = _native_surface_size_msg(&t, 2560, 1440, 1920, 1080, 24);
    assert_eq(n, 23, "truncated to the buffer");
    assert_eq(load8(&t + 23), 0, "and terminated");
    gpu_error_clear();
    _native_surface_fail_size(2560, 1440, 1920, 1080);
    assert_eq(gpu_last_error(), GPU_ERR_SURFACE_CONFIG, "recorded as GPU_ERR_SURFACE_CONFIG");
    assert_eq(streq(gpu_last_error_message(), &m), 1, "with the message");
    _native_surface_fail_rc("native surface: the modeset failed, stage ", 0 - 2);
    assert_eq(streq(gpu_last_error_message(), "native surface: the modeset failed, stage -2"), 1, "the stage code");
    gpu_error_clear();
    return 0;
}

# A fake drm_event_vblank (32 bytes) of `type` with `seq` into `buf`.
fn _fake_event(buf, type, seq): i64 {
    memset(buf, 0, 32);
    store32(buf + DRM_EVENT_HEADER_TYPE, type);
    store32(buf + DRM_EVENT_HEADER_LENGTH, 32);
    store32(buf + DRM_EVENT_VBLANK_SEQUENCE, seq);
    return 0;
}

# 4.4.0 — the flip-event wait on a NON-BLOCKING fd (systemd-logind hands out its devices with
# O_NONBLOCK; a bare read() returned -EAGAIN before the flip completed and failed the AMD present
# at frame 0). A non-blocking pipe stands in for the card fd.
fn test_kms_wait_event_nonblocking() {
    var p[8];
    assert_eq(syscall(293, &p, 0x800, 0), 0, "pipe2(O_NONBLOCK)");
    var rfd = load32(&p);
    var wfd = load32(&p + 4);
    var buf[256];
    assert_eq(syscall(0, rfd, &buf, 256), 0 - 11, "a bare read on the empty fd: -EAGAIN");
    assert_eq(native_drm_wait_event(rfd, &buf, 256, 20), 0 - 62, "the wait times out: -ETIME");
    var ev[64];
    _fake_event(&ev, DRM_EVENT_FLIP_COMPLETE, 77);
    syscall(1, wfd, &ev, 32);
    assert_eq(native_drm_wait_event(rfd, &buf, 256, 20), 32, "an event: read once it is there");
    assert_eq(native_drm_wait_event(0 - 1, &buf, 256, 20), 0 - 1, "bad fd");
    assert_eq(native_drm_wait_event(rfd, 0, 256, 20), 0 - 1, "null buffer");
    # the drain: a VBLANK then the FLIP_COMPLETE, in one read
    _fake_event(&ev, DRM_EVENT_VBLANK, 5);
    _fake_event(&ev + 32, DRM_EVENT_FLIP_COMPLETE, 6);
    syscall(1, wfd, &ev, 64);
    var seq[4];
    store32(&seq, 0);
    assert_eq(native_kms_wait_flip_complete(rfd, &seq), 0, "the flip-complete found past a vblank");
    assert_eq(load32(&seq), 6, "its sequence");
    # in two reads: a lone VBLANK, then the FLIP_COMPLETE
    _fake_event(&ev, DRM_EVENT_VBLANK, 8);
    syscall(1, wfd, &ev, 32);
    _fake_event(&ev, DRM_EVENT_FLIP_COMPLETE, 9);
    syscall(1, wfd, &ev, 32);
    assert_eq(native_kms_wait_flip_complete(rfd, &seq), 0, "across reads");
    assert_eq(load32(&seq), 9, "the flip's sequence");
    # a malformed header, and nothing at all
    _fake_event(&ev, DRM_EVENT_FLIP_COMPLETE, 1);
    store32(&ev + DRM_EVENT_HEADER_LENGTH, 0);
    syscall(1, wfd, &ev, 32);
    assert_eq(native_kms_wait_flip_complete(rfd, 0), 0 - 3, "a zero-length event: -3");
    syscall(3, rfd);
    syscall(3, wfd);
    return 0;
}

# 4.4.0 audit L1 — the present waits for ITS flip's event. A FLIP_COMPLETE left queued by a
# wait that timed out (or another CRTC's) is skipped, so a later present doesn't return one
# flip early. And the timeout is a deadline for the whole wait.
fn _fake_flip(buf, seq, user_data, crtc): i64 {
    _fake_event(buf, DRM_EVENT_FLIP_COMPLETE, seq);
    store64(buf + DRM_EVENT_VBLANK_USER_DATA, user_data);
    store32(buf + DRM_EVENT_VBLANK_CRTC_ID, crtc);
    return 0;
}

fn test_kms_wait_flip_for_skips_stale_events() {
    var p[8];
    assert_eq(syscall(293, &p, 0x800, 0), 0, "pipe2(O_NONBLOCK)");
    var rfd = load32(&p);
    var wfd = load32(&p + 4);
    var ev[128];
    var seq[4];
    # a stale flip (FB 40) and then this one (FB 41), in one read
    _fake_flip(&ev, 10, 40, 7);
    _fake_flip(&ev + 32, 11, 41, 7);
    syscall(1, wfd, &ev, 64);
    store32(&seq, 0);
    assert_eq(native_kms_wait_flip_for(rfd, 7, 41, &seq), 0, "this flip's event found past a stale one");
    assert_eq(load32(&seq), 11, "its sequence, not the stale event's");
    # another CRTC's flip with the same user_data is skipped; an event with no CRTC id matches
    _fake_flip(&ev, 20, 41, 9);
    _fake_flip(&ev + 32, 21, 41, 0);
    syscall(1, wfd, &ev, 64);
    assert_eq(native_kms_wait_flip_for(rfd, 7, 41, &seq), 0, "the other CRTC's skipped");
    assert_eq(load32(&seq), 21, "an event without a CRTC id is taken");
    # the any-flip drain still takes the first FLIP_COMPLETE
    _fake_flip(&ev, 30, 99, 3);
    syscall(1, wfd, &ev, 32);
    assert_eq(native_kms_wait_flip_complete(rfd, &seq), 0, "the any-flip drain");
    assert_eq(load32(&seq), 30, "takes the first");
    # only stale events: the wait gives up when nothing more arrives (-ETIME)
    _fake_flip(&ev, 40, 40, 7);
    syscall(1, wfd, &ev, 32);
    var t0 = _native_mono_ns();
    var r = native_kms_wait_flip_for(rfd, 7, 41, &seq);
    var dt_ms = (_native_mono_ns() - t0) / 1000000;
    assert_eq(r, 0 - 62, "no matching flip: -ETIME");
    assert_eq(dt_ms < 2500, 1, "within the 1 s wait (and a margin)");
    # the wait's timeout is one deadline
    t0 = _native_mono_ns();
    assert_eq(native_drm_wait_event(rfd, &ev, 128, 30), 0 - 62, "a 30 ms wait times out");
    dt_ms = (_native_mono_ns() - t0) / 1000000;
    assert_eq(dt_ms >= 29, 1, "after about 30 ms");
    assert_eq(dt_ms < 500, 1, "not much more");
    assert_eq(native_drm_wait_event(rfd, &ev, 128, 0 - 1), 0 - 1, "a negative timeout is refused");
    syscall(3, rfd);
    syscall(3, wfd);
    return 0;
}

# 4.4.0 audit L3 — the CRTC already driving the connector is kept, so the console config saved
# before the modeset is this connector's own.
fn test_kms_pick_crtc() {
    var crtcs[16];
    store32(&crtcs, 31);
    store32(&crtcs + 4, 32);
    store32(&crtcs + 8, 33);
    var enc[20];
    memset(&enc, 0, 20);
    store32(&enc + DRM_MODE_GET_ENCODER_POSS_CRTCS, 7);
    store32(&enc + DRM_MODE_GET_ENCODER_CRTC_ID, 32);
    assert_eq(native_kms_pick_crtc(&enc, &crtcs, 3), 32, "the CRTC driving it, not the lowest bit's");
    store32(&enc + DRM_MODE_GET_ENCODER_CRTC_ID, 0);
    assert_eq(native_kms_pick_crtc(&enc, &crtcs, 3), 31, "unbound: the lowest CRTC it can use");
    store32(&enc + DRM_MODE_GET_ENCODER_CRTC_ID, 77);
    store32(&enc + DRM_MODE_GET_ENCODER_POSS_CRTCS, 4);
    assert_eq(native_kms_pick_crtc(&enc, &crtcs, 3), 33, "a CRTC the card doesn't list: the mask's");
    store32(&enc + DRM_MODE_GET_ENCODER_POSS_CRTCS, 8);
    assert_eq(native_kms_pick_crtc(&enc, &crtcs, 3), 0, "a mask bit past the CRTC count: 0");
    store32(&enc + DRM_MODE_GET_ENCODER_POSS_CRTCS, 0);
    assert_eq(native_kms_pick_crtc(&enc, &crtcs, 3), 0, "an empty mask: 0");
    assert_eq(native_kms_pick_crtc(0, &crtcs, 3), 0, "no encoder: 0");
    assert_eq(native_kms_pick_crtc(&enc, 0, 3), 0, "no CRTC list: 0");
    return 0;
}

# 4.4.0 audit L2 — one mapping for both presents: the drain's -2 / -3 are a lost surface.
fn test_kms_present_rc_mapping() {
    assert_eq(_native_present_rc_to_gpu_err(0), 0, "0 stays 0");
    assert_eq(_native_present_rc_to_gpu_err(0 - 2), GPU_ERR_SURFACE_LOST, "-2: no flip-complete");
    assert_eq(_native_present_rc_to_gpu_err(0 - 3), GPU_ERR_SURFACE_LOST, "-3: a malformed event");
    assert_eq(_native_present_rc_to_gpu_err(0 - 62), _native_neg_rc_to_gpu_err(0 - 62), "-ETIME: the errno map");
    assert_eq(_native_present_rc_to_gpu_err(0 - 16), _native_neg_rc_to_gpu_err(0 - 16), "-EBUSY: the errno map");
    return 0;
}

# v3 Step 7.3 — KMS framebuffer (ADDFB2 + RMFB)

fn test_drm_mode_fb_ioctl_numbers() {
    # Re-derive each ioctl from first principles.
    # sizeof(struct drm_mode_fb_cmd2) is 104 (modifier[] u64-aligned at +72). 4.4.0: was 100.
    assert_eq(DRM_IOCTL_MODE_ADDFB2,
      (3 << 30) | (104 << 16) | (0x64 << 8) | 0xB8, "ADDFB2 derived");
    assert_eq(DRM_IOCTL_MODE_ADDFB2, 0xC06864B8, "ADDFB2 literal (the uapi header's)");
    assert_eq(DRM_IOCTL_MODE_RMFB,
      (3 << 30) | (4 << 16) | (0x64 << 8) | 0xAF, "RMFB derived");
    assert_eq(DRM_IOCTL_MODE_RMFB, 0xC00464AF, "RMFB literal");
    return 0;
}

fn test_drm_mode_fb_cmd2_field_offsets() {
    assert_eq(DRM_MODE_FB_CMD2_FB_ID,     0,  "+0");
    assert_eq(DRM_MODE_FB_CMD2_WIDTH,     4,  "+4");
    assert_eq(DRM_MODE_FB_CMD2_HEIGHT,    8,  "+8");
    assert_eq(DRM_MODE_FB_CMD2_FORMAT,    12, "+12");
    assert_eq(DRM_MODE_FB_CMD2_FLAGS,     16, "+16");
    assert_eq(DRM_MODE_FB_CMD2_HANDLES,   20, "+20");
    assert_eq(DRM_MODE_FB_CMD2_PITCHES,   36, "+36");
    assert_eq(DRM_MODE_FB_CMD2_OFFSETS,   52, "+52");
    assert_eq(DRM_MODE_FB_CMD2_MODIFIERS, 72, "+72 (u64-aligned)");
    assert_eq(DRM_MODE_FB_CMD2_SIZE,      104, "size (offsetof / sizeof from the uapi header)");
    # Sanity: 4×u32 plane arrays land at correct offsets.
    assert_eq(DRM_MODE_FB_CMD2_HANDLES + 16, DRM_MODE_FB_CMD2_PITCHES,
      "handles[4] ends where pitches starts");
    assert_eq(DRM_MODE_FB_CMD2_PITCHES + 16, DRM_MODE_FB_CMD2_OFFSETS,
      "pitches[4] ends where offsets starts");
    assert_eq(DRM_MODE_FB_CMD2_OFFSETS + 16 + 4, DRM_MODE_FB_CMD2_MODIFIERS,
      "offsets[4] ends 4 bytes of padding before modifiers");
    assert_eq(DRM_MODE_FB_CMD2_MODIFIERS % 8, 0, "modifier[] is 8-byte aligned");
    assert_eq(DRM_MODE_FB_CMD2_MODIFIERS + 32, DRM_MODE_FB_CMD2_SIZE,
      "modifier[4] u64s end at struct size");
    return 0;
}

fn test_drm_format_fourcc_constants() {
    # Each fourcc is the 4-byte ASCII tag stored little-endian.
    # 'X'=88, 'A'=65, 'R'=82, 'B'=66, '2'=50, '4'=52.
    # XRGB8888 = 'X' | 'R'<<8 | '2'<<16 | '4'<<24
    assert_eq(DRM_FORMAT_XRGB8888, 88 | (82 << 8) | (50 << 16) | (52 << 24),
      "XRGB derived");
    assert_eq(DRM_FORMAT_XRGB8888, 0x34325258, "XRGB literal");
    assert_eq(DRM_FORMAT_ARGB8888, 65 | (82 << 8) | (50 << 16) | (52 << 24),
      "ARGB derived");
    assert_eq(DRM_FORMAT_ARGB8888, 0x34325241, "ARGB literal");
    assert_eq(DRM_FORMAT_XBGR8888, 88 | (66 << 8) | (50 << 16) | (52 << 24),
      "XBGR derived");
    assert_eq(DRM_FORMAT_XBGR8888, 0x34324258, "XBGR literal");
    assert_eq(DRM_FORMAT_ABGR8888, 65 | (66 << 8) | (50 << 16) | (52 << 24),
      "ABGR derived");
    assert_eq(DRM_FORMAT_ABGR8888, 0x34324241, "ABGR literal");
    assert_eq(DRM_FORMAT_MOD_LINEAR, 0, "linear modifier = 0");
    return 0;
}

fn test_native_kms_add_fb_xrgb8888_null_safe() {
    assert_eq(native_kms_add_fb_xrgb8888(0, 1, 256, 256, 1024), 0, "fd=0");
    assert_eq(native_kms_add_fb_xrgb8888(7, 0, 256, 256, 1024), 0, "handle=0");
    assert_eq(native_kms_add_fb_xrgb8888(7, 1,   0, 256, 1024), 0, "w=0");
    assert_eq(native_kms_add_fb_xrgb8888(7, 1, 256,   0, 1024), 0, "h=0");
    assert_eq(native_kms_add_fb_xrgb8888(7, 1, 256, 256,    0), 0, "pitch=0");
    return 0;
}

fn test_native_kms_rm_fb_null_safe() {
    assert_eq(native_kms_rm_fb(0, 1), 0, "fd=0 no-op");
    assert_eq(native_kms_rm_fb(7, 0), 0, "fb_id=0 no-op");
    return 0;
}

# v3 Step 7.2(b) — SETCRTC primitive

fn test_drm_mode_set_crtc_ioctl_number() {
    assert_eq(DRM_IOCTL_MODE_SETCRTC,
      (3 << 30) | (104 << 16) | (0x64 << 8) | 0xA2,
      "SETCRTC derived");
    assert_eq(DRM_IOCTL_MODE_SETCRTC, 0xC06864A2, "SETCRTC literal");
    return 0;
}

fn test_drm_mode_crtc_field_offsets() {
    assert_eq(DRM_MODE_CRTC_CONN_PTR,    0,   "+0");
    assert_eq(DRM_MODE_CRTC_COUNT_CONN,  8,   "+8");
    assert_eq(DRM_MODE_CRTC_CRTC_ID,     12,  "+12");
    assert_eq(DRM_MODE_CRTC_FB_ID,       16,  "+16");
    assert_eq(DRM_MODE_CRTC_X,           20,  "+20");
    assert_eq(DRM_MODE_CRTC_Y,           24,  "+24");
    assert_eq(DRM_MODE_CRTC_GAMMA_SIZE,  28,  "+28");
    assert_eq(DRM_MODE_CRTC_MODE_VALID,  32,  "+32");
    assert_eq(DRM_MODE_CRTC_MODE,        36,  "+36");
    assert_eq(DRM_MODE_CRTC_SIZE,        104, "size");
    # Sanity: the embedded modeinfo at +36 fills the rest of the
    # struct exactly (36 + 68 == 104).
    assert_eq(DRM_MODE_CRTC_MODE + DRM_MODE_MODEINFO_SIZE,
      DRM_MODE_CRTC_SIZE,
      "embedded modeinfo fills to size");
    return 0;
}

fn test_native_kms_set_crtc_null_safe() {
    var conn_ids[4];
    store32(&conn_ids, 99);
    var mode[68];
    memset(&mode, 0, 68);
    assert_eq(native_kms_set_crtc(0, 1, 1, &conn_ids, 1, &mode), -1, "fd=0");
    assert_eq(native_kms_set_crtc(7, 0, 1, &conn_ids, 1, &mode), -1, "crtc=0");
    assert_eq(native_kms_set_crtc(7, 1, 0, &conn_ids, 1, &mode), -1, "fb=0");
    assert_eq(native_kms_set_crtc(7, 1, 1, 0,         1, &mode), -1, "conn_ptr=0");
    assert_eq(native_kms_set_crtc(7, 1, 1, &conn_ids, 0, &mode), -1, "conn_cnt=0");
    assert_eq(native_kms_set_crtc(7, 1, 1, &conn_ids, 1, 0),     -1, "mode=0");
    return 0;
}

fn test_native_kms_disable_crtc_null_safe() {
    assert_eq(native_kms_disable_crtc(0, 1), -1, "fd=0");
