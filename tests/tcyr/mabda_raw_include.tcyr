# tests/tcyr/mabda_raw_include.tcyr — the dist bundle compiles from a raw include
# Self-contained: includes ONLY dist/mabda.cyr (plus the test framework), never
# src/lib.cyr or a hand-listed stdlib set. Since 4.1.7 the bundle opens with the
# compile-verified "# Requires" include block cyrius 6.6.18's distlib writes (the
# leaves of dist/mabda.deps), so `include "dist/mabda.cyr"` alone resolves every
# stdlib name the bundle uses. Against the 4.1.6 bundle, which had no such block,
# this file does not compile. CHANGELOG [4.1.7].
include "dist/mabda.cyr"
include "lib/assert.cyr"

fn test_raw_include_gpu_err_round_trip() {
    var e = gpu_err_new(GPU_ERR_DEVICE_LOST, 0);
    assert_eq(gpu_err_code(e), GPU_ERR_DEVICE_LOST, "gpu_err_code round-trips");
    assert_eq(gpu_err_detail(e), 0, "no detail");
    var name = gpu_err_name(GPU_ERR_DEVICE_LOST);
    assert_eq(strlen(name) > 0, 1, "gpu_err_name non-empty");
    return 0;
}

fn main() {
    alloc_init();
    test_raw_include_gpu_err_round_trip();
    return assert_summary();
}
