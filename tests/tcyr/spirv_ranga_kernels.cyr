fn rk_build(k, b): i64 {
    if (k == 0) { return _rk_invert(b); }
    if (k == 1) { return _rk_grayscale(b); }
    if (k == 2) { return _rk_fade(b); }
    if (k == 3) { return _rk_brightness_contrast(b); }
    if (k == 4) { return _rk_saturation(b); }
    if (k == 5) { return _rk_dissolve(b); }
    if (k == 6) { return _rk_wipe(b); }
    if (k == 7) { return _rk_crop(b); }
    if (k == 8) { return _rk_flip_horizontal(b); }
    if (k == 9) { return _rk_flip_vertical(b); }
    if (k == 10) { return _rk_resize_nearest(b); }
    return 0;
}

fn rk_name(k): i64 {
    if (k == 0) { return "invert"; }
    if (k == 1) { return "grayscale"; }
    if (k == 2) { return "fade"; }
    if (k == 3) { return "brightness_contrast"; }
    if (k == 4) { return "saturation"; }
    if (k == 5) { return "dissolve"; }
    if (k == 6) { return "wipe"; }
    if (k == 7) { return "crop"; }
    if (k == 8) { return "flip_horizontal"; }
    if (k == 9) { return "flip_vertical"; }
    if (k == 10) { return "resize_nearest"; }
    return "?";
}

fn rk_shape(k): i64 {
    if (k == 0) { return 1; }
    if (k == 1) { return 1; }
    if (k == 2) { return 1; }
    if (k == 3) { return 1; }
    if (k == 4) { return 1; }
    if (k == 5) { return 2; }
    if (k == 6) { return 2; }
    if (k == 7) { return 3; }
    if (k == 8) { return 3; }
    if (k == 9) { return 3; }
    if (k == 10) { return 3; }
    return 0;
}

fn rk_out_w(k): i64 {
    if (k == 0) { return 61; }
    if (k == 1) { return 61; }
    if (k == 2) { return 61; }
    if (k == 3) { return 61; }
    if (k == 4) { return 61; }
    if (k == 5) { return 61; }
    if (k == 6) { return 61; }
    if (k == 7) { return 40; }
    if (k == 8) { return 61; }
    if (k == 9) { return 61; }
    if (k == 10) { return 97; }
    return 0;
}

fn rk_out_h(k): i64 {
    if (k == 0) { return 67; }
    if (k == 1) { return 67; }
    if (k == 2) { return 67; }
    if (k == 3) { return 67; }
    if (k == 4) { return 67; }
    if (k == 5) { return 67; }
    if (k == 6) { return 67; }
    if (k == 7) { return 30; }
    if (k == 8) { return 67; }
    if (k == 9) { return 67; }
    if (k == 10) { return 53; }
    return 0;
}

# ranga's params block for kernel k: [count, a, b, c, d, e] into p (32 bytes, zeroed).
fn rk_params(k, p): i64 {
    memset(p, 0, 32);
    store32(p, rk_out_w(k) * rk_out_h(k));
    if (k == 2) {   # fade
        store32(p + 4, 0x3EBD70A4);
    }
    if (k == 3) {   # brightness_contrast
        store32(p + 4, 0x3DCCCCCD);
        store32(p + 8, 0x3FA00000);
    }
    if (k == 4) {   # saturation
        store32(p + 4, 0x3FD9999A);
    }
    if (k == 5) {   # dissolve
        store32(p + 4, 0x3ED70A3D);
    }
    if (k == 6) {   # wipe
        store32(p + 4, 0x0000003D);
        store32(p + 8, 0x00000043);
        store32(p + 12, 0x3F19999A);
    }
    if (k == 7) {   # crop
        store32(p + 4, 0x0000003D);
        store32(p + 8, 0x00000028);
        store32(p + 12, 0x0000001E);
        store32(p + 16, 0x00000007);
        store32(p + 20, 0x0000000B);
    }
    if (k == 8) {   # flip_horizontal
        store32(p + 4, 0x0000003D);
        store32(p + 8, 0x00000043);
    }
    if (k == 9) {   # flip_vertical
        store32(p + 4, 0x0000003D);
        store32(p + 8, 0x00000043);
    }
    if (k == 10) {   # resize_nearest
        store32(p + 4, 0x0000003D);
        store32(p + 8, 0x00000043);
        store32(p + 12, 0x00000061);
        store32(p + 16, 0x00000035);
    }
    return 0;
}

fn rk_golden(k): i64 {
    if (k == 0) { return 0x8821BAB3CE0F3EE6; }
    if (k == 1) { return 0x6BFEAD07ADD34D08; }
    if (k == 2) { return 0x32F9589CFC0E3B3C; }
    if (k == 3) { return 0x7E9E2F700895F5E0; }
    if (k == 4) { return 0x6898836BA8E33568; }
    if (k == 5) { return 0xE57C3BC3D58FDE4B; }
    if (k == 6) { return 0x378C8C39D17B3990; }
    if (k == 7) { return 0xC4426C084A4788E4; }
    if (k == 8) { return 0xE30F85777B0EEEE3; }
    if (k == 9) { return 0xC6822743E1B55E77; }
    if (k == 10) { return 0x31B4E84C06DAC4CE; }
    return 0;
}
