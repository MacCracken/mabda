# tests/tcyr/predicates.tcyr — 4.5.0 (S3): every *_is_* / *_has_* predicate in src/ returns `: bool`.
#
# _pin_bool_predicates is never called: it only has to COMPILE. cycc checks a write into a bool
# in every fn, called or not, so if a predicate goes back to `: i64` this file stops building
# ("cannot initialize bool ... with a value that is not a bool"). The runtime rows check that
# a bool still reads as the integer 0 or 1, the contract every caller relies on.
include "src/lib.cyr"
include "lib/assert.cyr"

fn _pin_bool_predicates(): i64 {
    var b_mabda_vk_format_is_srgb: bool = mabda_vk_format_is_srgb(0);
    var b_mabda_dxgi_format_is_srgb: bool = mabda_dxgi_format_is_srgb(0);
    var b_backend_is_complete: bool = backend_is_complete(0);
    var b_native_tex_is_cube: bool = native_tex_is_cube(0);
    var b_native_nv_is_nouveau: bool = native_nv_is_nouveau(0);
    var b_native_nv_rc_is_masterless: bool = native_nv_rc_is_masterless(0);
    var b_mabda_observability_is_enabled: bool = mabda_observability_is_enabled();
    var b_gpu_err_is_recoverable: bool = gpu_err_is_recoverable(0);
    var b_cmp_is_vgpr: bool = _cmp_is_vgpr(0, 0, 0, 0);
    var b_cmp_operand_is_literal: bool = _cmp_operand_is_literal(0, 0, 0);
    var b_cmp_store_value_is_const: bool = _cmp_store_value_is_const(0, 0, 0);
    var b_gisel_result_is_vgpr: bool = gisel_result_is_vgpr(0, 0, 0);
    var b_gisel_is_inline_const: bool = _gisel_is_inline_const(0, 0);
    var b_cf_is_label: bool = _cf_is_label(0, 0, 0, 0);
    var b_cf_is_div_loop_entry: bool = _cf_is_div_loop_entry(0, 0, 0, 0, 0, 0);
    var b_wc_is_branch: bool = _wc_is_branch(0);
    var b_mir_op_is_icmp: bool = mir_op_is_icmp(0);
    var b_mir_is_vector: bool = mir_is_vector(0, 0);
    var b_rg_is_built: bool = rg_is_built(0);
    var b_rg_is_scheduled: bool = rg_is_scheduled(0);
    var b_gpu_sampler_is_valid: bool = gpu_sampler_is_valid(0);
    var b_s75_is_f64: bool = _s75_is_f64(0, 0);
    var b_s75_is_label: bool = _s75_is_label(0, 0, 0, 0);
    var b_gpu_surface_caps_has_format: bool = gpu_surface_caps_has_format(0, 0);
    var b_gpu_surface_caps_has_present_mode: bool = gpu_surface_caps_has_present_mode(0, 0);
    var b_mabda_texfmt_is_render_format: bool = mabda_texfmt_is_render_format(0);
    var b_texfmt_is_compressed_srgb: bool = _texfmt_is_compressed_srgb(0);
    var b_mabda_texfmt_is_srgb: bool = mabda_texfmt_is_srgb(0);
    var b_mabda_texfmt_is_depth: bool = mabda_texfmt_is_depth(0);
    var b_mabda_texfmt_is_color_target: bool = mabda_texfmt_is_color_target(0);
    var b_mabda_texfmt_is_compressed: bool = mabda_texfmt_is_compressed(0);
    var b_wgpu_has_slot: bool = _wgpu_has_slot(0);
    var b_wgpu_adapter_has_feature: bool = wgpu_adapter_has_feature(0, 0);
    var b_wgpu_device_has_feature: bool = wgpu_device_has_feature(0, 0);
    var b_native_is_view: bool = native_is_view(0);   # 4.5.0 (audit)
    return 0;
}

fn test_predicates_read_as_0_or_1() {
    assert_eq(mabda_texfmt_is_compressed(MABDA_TEXFMT_BC7), 1, "true reads as 1");
    assert_eq(mabda_texfmt_is_compressed(MABDA_TEXFMT_RGBA8), 0, "false reads as 0");
    assert_eq(mabda_texfmt_is_srgb(MABDA_TEXFMT_BC7_SRGB), 1, "a tail call through a bool helper reads as 1");
    assert_eq(mabda_texfmt_is_srgb(MABDA_TEXFMT_COUNT), 0, "invalid id: 0");
    assert_eq(mabda_texfmt_is_depth(MABDA_TEXFMT_DEPTH32F) + 1, 2, "a bool is an integer in arithmetic");
    var b: bool = mabda_texfmt_is_color_target(MABDA_TEXFMT_RGBA8);
    assert(b == true, "a bool var holds the result");
    assert_eq(mabda_vk_format_is_srgb(146), 1, "VK 146 is sRGB");
    assert_eq(mabda_dxgi_format_is_srgb(98), 0, "DXGI 98 is not");
    assert_eq(mabda_observability_is_enabled(), 0, "observability off by default");
    mabda_observability_enable();
    assert_eq(mabda_observability_is_enabled(), 1, "on after enable");
    mabda_observability_disable();
    assert_eq(mabda_observability_is_enabled(), 0, "off after disable");
    var g = rg_new();
    assert_eq(rg_is_built(g), 0, "a new graph is not built");
    rg_build(g, 0);
    assert_eq(rg_is_built(g), 1, "built after rg_build (the flag word, as a bool)");
    assert_eq(rg_is_scheduled(g), 0, "not scheduled");
    assert_eq(gpu_err_is_recoverable(GPU_ERR_SURFACE_TIMEOUT) + gpu_err_is_recoverable(GPU_ERR_OTHER) <= 1, 1,
      "recoverable reads 0 / 1");
    return 0;
}

fn main() {
    test_predicates_read_as_0_or_1();
    return assert_summary();
}
