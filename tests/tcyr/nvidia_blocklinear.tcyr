# tests/tcyr/nvidia_blocklinear.tcyr — NVIDIA block-linear scanout (4.4.0)
#
# CPU asserts for the Turing block-linear layout (backend_nvidia_tex.cyr NV_BL_*), the DRM
# format modifier, the tiled GEM_NEW / kind'd VM_BIND packing, ADDFB2 with a modifier, the
# copy-engine (TURING_DMA_COPY_A) pushbuffer, and the surface's block-linear fields. The layout
# is checked against two independent references, transcribed here rather than shared with the
# code under test:
#   - the kernel's Turing+ panic writer (dispnv50/wndw.c nv50_set_pixel_swizzle), per pixel;
#   - Mesa NVK's CopyGOBTuring2D line table (src/nouveau/nil/copy.rs), per 16-byte line.
# The hardware check is programs/nvidia_blocklinear_e2e.cyr (the copy engine un-swizzles mabda's
# CPU swizzle on the TU116).
include "src/lib.cyr"
include "lib/assert.cyr"

# The kernel's offset of pixel (x, y) (4-byte pixels) in a block-linear FB of row pitch `pitch`
# bytes and block height `blk_h` rows: nv50_get_block_off + nv50_set_pixel_swizzle, as written.
fn _kernel_px_off(x, y, pitch, blk_h): i64 {
    var blk_columns = (pitch + 63) / 64;
    var blk_x = (x * 4) / 64;
    var blk_y = y / blk_h;
    var blk_off = ((blk_y * blk_columns) + blk_x) * 64 * blk_h;
    var yy = y % blk_h;
    var swz = (x & 3) | ((yy & 3) << 2) | ((x & 4) << 2) | ((yy & 4) << 3);
    swz = swz | ((x & 8) << 3) | ((yy >> 3) << 7);
    return blk_off + swz * 4;
}

# NVK's CopyGOBTuring2D table: for line i (0..31) of a GOB, its byte offset in the GOB is
# i * 16, and it holds linear bytes x..x+15 of row y. Returns x | y << 8.
fn _nil_line(i): i64 {
    var hi = i / 16;            # the `for i in 0..2` loop: +0x100 bytes, +32 x
    var j = i % 16;
    var xs = 0;
    if ((j % 8) >= 4) { xs = 16; }
    var y = j % 4;
    if (j >= 8) { y = y + 4; }
    return (hi * 32 + xs) | (y << 8);
}

fn test_nv_bl_modifier() {
    # DRM_FORMAT_MOD_NVIDIA_BLOCK_LINEAR_2D(0, 1, 2, 0x06, h), the Turing windows' list
    assert_eq(native_nv_bl_modifier(4), 0x0300000000606014, "h=4: the 1080p modifier");
    assert_eq(native_nv_bl_modifier(0), 0x0300000000606010, "h=0");
    assert_eq(native_nv_bl_modifier(5), 0x0300000000606015, "h=5");
    var h = 0;
    while (h <= 5) {
        var want = (3 << 56) | 0x10 | h | (0x06 << 12) | (2 << 20) | (1 << 22);
        assert_eq(native_nv_bl_modifier(h), want, "c=0 s=1 g=2 k=0x06");
        h = h + 1;
    }
    assert_eq(native_nv_bl_modifier(0 - 1), 0 - 1, "h=-1 refused");
    assert_eq(native_nv_bl_modifier(6), 0 - 1, "h=6 refused");
    assert_eq(NV_TU_PTE_KIND_GENERIC, 6, "Turing generic kind");
    return 0;
}

fn test_nv_bl_layout_math() {
    # NVK's block-height heuristic
    assert_eq(native_nv_bl_block_h_log2(1080), 4, "1080 rows: 16 GOBs");
    assert_eq(native_nv_bl_block_h_log2(86), 4, "86");
    assert_eq(native_nv_bl_block_h_log2(85), 3, "85");
    assert_eq(native_nv_bl_block_h_log2(43), 3, "43");
    assert_eq(native_nv_bl_block_h_log2(42), 2, "42");
    assert_eq(native_nv_bl_block_h_log2(22), 2, "22");
    assert_eq(native_nv_bl_block_h_log2(21), 1, "21");
    assert_eq(native_nv_bl_block_h_log2(11), 1, "11");
    assert_eq(native_nv_bl_block_h_log2(10), 0, "10");
    assert_eq(native_nv_bl_block_h_log2(0), 0, "0");
    # pitch: rounded up to the 64-byte GOB width
    assert_eq(native_nv_bl_pitch(7680), 7680, "1920 px");
    assert_eq(native_nv_bl_pitch(400), 448, "100 px");
    assert_eq(native_nv_bl_pitch(1), 64, "1 byte");
    assert_eq(native_nv_bl_pitch(0), 0, "0");
    # size: blocks per row x block rows x block bytes (nouveau_check_bl_size)
    assert_eq(native_nv_bl_size(7680, 1080, 4), 120 * 9 * 16 * 512, "1920x1080, h=4");
    assert_eq(native_nv_bl_size(400, 70, 3), 7 * 2 * 8 * 512, "100x70, h=3");
    assert_eq(native_nv_bl_size(64, 8, 0), 512, "one GOB");
    assert_eq(native_nv_bl_size(0, 8, 0), 0, "zero width");
    assert_eq(native_nv_bl_size(64, 0, 0), 0, "zero height");
    assert_eq(native_nv_bl_size(64, 8, 6), 0, "h=6");
    return 0;
}

# Every pixel of a 48 x 70 surface, every block height: mabda's offset is the kernel's.
fn test_nv_bl_offset_vs_kernel() {
    var bad = 0;
    var h = 0;
    while (h <= 5) {
        var y = 0;
        while (y < 70) {
            var x = 0;
            while (x < 48) {
                var k = _kernel_px_off(x, y, 192, 8 << h);
                var b = 0;
                while (b < 4) {
                    if (native_nv_bl_offset(x * 4 + b, y, 192, h) != k + b) { bad = bad + 1; }
                    b = b + 1;
                }
                x = x + 1;
            }
            y = y + 1;
        }
        h = h + 1;
    }
    assert_eq(bad, 0, "every byte at the kernel's offset (48x70, h=0..5)");
    return 0;
}

# Each 16-byte line of a GOB where NVK's table puts it, in every GOB of a block.
fn test_nv_bl_offset_vs_nil() {
    var bad = 0;
    var g = 0;
    while (g < 4) {
        var i = 0;
        while (i < 32) {
            var xy = _nil_line(i);
            var b = 0;
            while (b < 16) {
                var off = native_nv_bl_offset((xy & 0xFF) + b, g * 8 + (xy >> 8), 64, 2);
                if (off != g * 512 + i * 16 + b) { bad = bad + 1; }
                b = b + 1;
            }
            i = i + 1;
        }
        g = g + 1;
    }
    assert_eq(bad, 0, "every line at NVK's TuringColor2D offset (4 GOBs, h=2)");
    # a bijection over one block: 512 << h distinct offsets, all inside it
    var seen[4096];
    memset(&seen, 0, 4096);
    var dup = 0;
    var y = 0;
    while (y < 64) {
        var x = 0;
        while (x < 64) {
            var o = native_nv_bl_offset(x, y, 64, 3);
            if (o >= 4096) { dup = dup + 1; }
            if (o < 4096) {
                if (load8(&seen + o) != 0) { dup = dup + 1; }
                store8(&seen + o, 1);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    assert_eq(dup, 0, "one 64x64-byte block (h=3) maps onto its 4096 bytes exactly once");
    return 0;
}

# The swizzle moves every byte where native_nv_bl_offset says, leaves rows past the image
# alone, and the unswizzle restores the image. 52 x 50 px: a partial last GOB column (208 of 256
# bytes, the padding copied too) and a partial block row (50 of 64 rows, h=3).
fn test_nv_bl_swizzle_roundtrip() {
    var lin[12800];     # 50 rows x 256-byte pitch
    var bl[16384];      # native_nv_bl_size(256, 50, 3) = 4 x 1 x 4096
    var back[12800];
    var y = 0;
    while (y < 50) {
        var x = 0;
        while (x < 64) { store32(&lin + y * 256 + x * 4, (y << 16) | x | 0x80000000); x = x + 1; }
        y = y + 1;
    }
    memset(&bl, 0xEE, 16384);
    var h = native_nv_bl_block_h_log2(50);
    assert_eq(h, 3, "50 rows: h=3");
    assert_eq(native_nv_bl_size(208, 50, h), 16384, "the surface is 16 KiB");
    assert_eq(native_nv_bl_swizzle(&bl, &lin, 256, 256, 50, h), 0, "swizzle");
    var bad = 0;
    y = 0;
    while (y < 50) {
        var x2 = 0;
        while (x2 < 64) {
            if (load32(&bl + native_nv_bl_offset(x2 * 4, y, 256, h)) != load32(&lin + y * 256 + x2 * 4)) {
                bad = bad + 1;
            }
            x2 = x2 + 1;
        }
        y = y + 1;
    }
    assert_eq(bad, 0, "every word where the offset function puts it");
    var untouched = 1;
    y = 50;
    while (y < 64) {
        var x3 = 0;
        while (x3 < 256) {
            if (load8(&bl + native_nv_bl_offset(x3, y, 256, h)) != 0xEE) { untouched = 0; }
            x3 = x3 + 1;
        }
        y = y + 1;
    }
    assert_eq(untouched, 1, "rows past the image are not written");
    memset(&back, 0, 12800);
    assert_eq(native_nv_bl_unswizzle(&back, &bl, 256, 256, 50, h), 0, "unswizzle");
    var diff = 0;
    var q = 0;
    while (q < 12800) {
        if (load64(&back + q) != load64(&lin + q)) { diff = diff + 1; }
        q = q + 8;
    }
    assert_eq(diff, 0, "and it restores the image");
    # bad arguments
    assert_eq(native_nv_bl_swizzle(&bl, &lin, 192, 256, 50, h), 0 - 1, "a linear pitch under the BL pitch");
    assert_eq(native_nv_bl_swizzle(&bl, &lin, 256, 200, 50, h), 0 - 1, "a BL pitch off the GOB width");
    assert_eq(native_nv_bl_swizzle(&bl, &lin, 256, 256, 50, 6), 0 - 1, "h=6");
    assert_eq(native_nv_bl_swizzle(0, &lin, 256, 256, 50, h), 0 - 1, "null surface");
    assert_eq(native_nv_bl_swizzle(&bl, &lin, 256, 256, 0, h), 0 - 1, "zero height");
    return 0;
}

fn test_nv_tiled_bo_packing() {
    var req[48];
    native_nv_gem_new_pack(&req, 0x20000, 4096, NOUVEAU_GEM_DOMAIN_VRAM, 4 * 16, 0x06 * 256);
    assert_eq(load32(&req + 4), NOUVEAU_GEM_DOMAIN_VRAM, "info.domain");
    assert_eq(load64(&req + 8), 0x20000, "info.size");
    assert_eq(load32(&req + 32), 0x40, "info.tile_mode = h << 4 (Fermi+)");
    assert_eq(load32(&req + 36), 0x600, "info.tile_flags = kind << 8");
    assert_eq(load32(&req + 44), 4096, "align");
    native_nv_gem_new_pack(&req, 4096, 4096, NOUVEAU_GEM_DOMAIN_HOST, 0, 0);
    assert_eq(load32(&req + 32) | load32(&req + 36), 0, "an untiled BO leaves both zero");
    var out[16];
    assert_eq(native_nv_bo_create_kind(0 - 1, 4096, NOUVEAU_GEM_DOMAIN_VRAM, 0x100, 0, &out), 0 - 22,
      "kind past 0xFF refused before the ioctl");
    assert_eq(native_nv_bo_create_kind(0 - 1, 4096, NOUVEAU_GEM_DOMAIN_VRAM, 6, 6, &out), 0 - 22, "h=6 refused");
    var op[40];
    native_nv_vm_bind_op_pack(&op, 7, 0x100000, 0x20000, 0x06);
    assert_eq(load32(&op + 0), DRM_NOUVEAU_VM_BIND_OP_MAP, "op = MAP");
    assert_eq(load32(&op + 4), 0x06, "flags 7:0 = the PTE kind");
    assert_eq(load32(&op + 8), 7, "handle");
    assert_eq(load64(&op + 16), 0x100000, "addr");
    assert_eq(load64(&op + 32), 0x20000, "range");
    native_nv_vm_bind_op_pack(&op, 7, 0x100000, 0x20000, 0x106);
    assert_eq(load32(&op + 4), 0x06, "only the kind byte (bit 8 is SPARSE)");
    return 0;
}

fn test_nv_addfb2_modifier_packing() {
    var req[104];
    native_kms_fb_cmd2_pack(&req, 5, 1920, 1080, 7680, DRM_MODE_FB_MODIFIERS, native_nv_bl_modifier(4));
    assert_eq(load32(&req + DRM_MODE_FB_CMD2_WIDTH), 1920, "width");
    assert_eq(load32(&req + DRM_MODE_FB_CMD2_HEIGHT), 1080, "height");
    assert_eq(load32(&req + DRM_MODE_FB_CMD2_FORMAT), DRM_FORMAT_XRGB8888, "XRGB8888");
    assert_eq(load32(&req + DRM_MODE_FB_CMD2_FLAGS), 2, "DRM_MODE_FB_MODIFIERS");
    assert_eq(load32(&req + DRM_MODE_FB_CMD2_HANDLES), 5, "handle");
    assert_eq(load32(&req + DRM_MODE_FB_CMD2_PITCHES), 7680, "pitch");
    assert_eq(load32(&req + 68), 0, "the alignment pad");
    assert_eq(load64(&req + 72), 0x0300000000606014, "modifier[0] at +72");
    native_kms_fb_cmd2_pack(&req, 5, 1920, 1080, 7680, 0, DRM_FORMAT_MOD_LINEAR);
    assert_eq(load32(&req + DRM_MODE_FB_CMD2_FLAGS), 0, "linear: no flag");
    assert_eq(load64(&req + 72), 0, "linear: modifier 0");
    assert_eq(native_kms_add_fb_xrgb8888_mod(0 - 1, 5, 1920, 1080, 7680, 0), 0, "bad fd: 0 (fall back)");
    assert_eq(native_kms_add_fb_xrgb8888_mod(3, 0, 1920, 1080, 7680, 0), 0, "null handle: 0");
    return 0;
}

fn test_nv_push_ce_copy_bl() {
    var p[128];
    var n = native_nv_push_ce_copy_bl(&p, 0x1234500000, 0x200000, 8192, 7680, 1080, 4, 0);
    assert_eq(n, NV_PUSH_CE_COPY_BYTES, "80 bytes");
    assert_eq(load32(&p + 0), native_nv_method_header(NV_OP_INCR, 4, 0, 1), "SET_OBJECT on subc 4");
    assert_eq(load32(&p + 4), 0xC5B5, "TURING_DMA_COPY_A");
    assert_eq(load32(&p + 8), native_nv_method_header(NV_OP_INCR, 4, 0x0728, 6), "SET_SRC_BLOCK_SIZE x6");
    assert_eq(load32(&p + 12), 0x1040, "height 16 GOBs, GOB_HEIGHT_FERMI_8");
    assert_eq(load32(&p + 16), 7680, "src width in bytes");
    assert_eq(load32(&p + 20), 1080, "src height");
    assert_eq(load32(&p + 24), 1, "depth 1");
    assert_eq(load32(&p + 36), native_nv_method_header(NV_OP_INCR, 4, 0x0400, 8), "OFFSET_IN_UPPER x8");
    assert_eq(load32(&p + 40), 0x12, "in upper (the block-linear VA)");
    assert_eq(load32(&p + 44), 0x34500000, "in lower");
    assert_eq(load32(&p + 48), 0, "out upper");
    assert_eq(load32(&p + 52), 0x200000, "out lower");
    assert_eq(load32(&p + 60), 8192, "pitch out");
    assert_eq(load32(&p + 64), 7680, "line length");
    assert_eq(load32(&p + 68), 1080, "line count");
    assert_eq(load32(&p + 72), native_nv_method_header(NV_OP_INCR, 4, 0x0300, 1), "LAUNCH_DMA");
    assert_eq(load32(&p + 76), 0x306, "non-pipelined | flush | dst pitch | multi-line");
    n = native_nv_push_ce_copy_bl(&p, 0x1234500000, 0x200000, 8192, 7680, 1080, 4, 1);
    assert_eq(load32(&p + 8), native_nv_method_header(NV_OP_INCR, 4, 0x070C, 6), "to_bl: SET_DST_BLOCK_SIZE");
    assert_eq(load32(&p + 52), 0x34500000, "to_bl: out = the block-linear VA");
    assert_eq(load32(&p + 56), 8192, "to_bl: pitch in");
    assert_eq(load32(&p + 76), 0x286, "to_bl: src pitch");
    return 0;
}

fn test_nv_surface_blocklinear_fields() {
    assert_eq(NV_SURFACE_LAYOUT, 232, "layout after the saved CRTC");
    assert_eq(NV_SURFACE_BL_H, 236, "bl_h");
    assert_eq(NV_SURFACE_BL_PITCH, 240, "bl_pitch");
    assert_eq(NV_SURFACE_STAGE, 248, "stage, 8-aligned");
    assert_eq(NV_SURFACE_STAGE + NV_SFB_STRUCT_SIZE, NV_SURFACE_MASTER_OWNED, "stage, then master_owned");
    var s[296];
    memset(&s, 0, 296);
    store32(&s + NV_SURFACE_LAYOUT, NV_SCANOUT_BLOCKLINEAR);
    assert_eq(_backend_nvidia_surface_acquire(0, &s), &s + NV_SURFACE_STAGE,
      "block-linear: acquire hands out the staging buffer, every frame");
    store32(&s + NV_SURFACE_FRONT, 1);
    assert_eq(_backend_nvidia_surface_acquire(0, &s), &s + NV_SURFACE_STAGE, "whichever FB is front");
    store32(&s + NV_SURFACE_LAYOUT, NV_SCANOUT_LINEAR);
    assert_eq(_backend_nvidia_surface_acquire(0, &s), &s + NV_SURFACE_FB0, "linear: front 1 -> back FB0");
    store32(&s + NV_SURFACE_FRONT, 0);
    assert_eq(_backend_nvidia_surface_acquire(0, &s), &s + NV_SURFACE_FB1, "linear: front 0 -> back FB1");
    native_nv_surface_force_linear(1);
    assert_eq(_nv_scanout_force_linear, 1, "force_linear on");
    native_nv_surface_force_linear(0);
    assert_eq(_nv_scanout_force_linear, 0, "and off");
    # the staging release is a no-op on a surface without one
    assert_eq(_nv_surface_free_stage(0 - 1, &s), 0, "free_stage on a linear surface");
    return 0;
}

fn main() {
    alloc_init();
    test_nv_bl_modifier();
    test_nv_bl_layout_math();
    test_nv_bl_offset_vs_kernel();
    test_nv_bl_offset_vs_nil();
    test_nv_bl_swizzle_roundtrip();
    test_nv_tiled_bo_packing();
    test_nv_addfb2_modifier_packing();
    test_nv_push_ce_copy_bl();
    test_nv_surface_blocklinear_fields();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
