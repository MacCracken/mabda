    test_obs_enable_disable_flips_flag();
    test_obs_disabled_no_sakshi_emission();
    test_obs_enabled_emits_on_err_result();
    test_obs_frame_span_balanced();

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
