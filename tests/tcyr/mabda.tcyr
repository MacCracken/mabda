    return 0;
}

fn test_native_gem_va_ioctl_encoding() {
    # GEM_VA is WRITE-only (kernel reads everything from the struct,
    # writes nothing back). dir=1, size=64.
    var expected = native_ioc_encode(1, DRM_AMDGPU_GEM_VA_SIZE, DRM_IOCTL_TYPE,
                                     DRM_COMMAND_BASE + DRM_AMDGPU_GEM_VA);
    assert_eq(DRM_IOCTL_AMDGPU_GEM_VA, expected, "GEM_VA ioctl = 0x40406448");
    assert_eq(DRM_IOCTL_AMDGPU_GEM_VA, 0x40406448, "precomputed constant");
    return 0;
}

fn test_native_struct_sizes() {
    assert_eq(DRM_AMDGPU_CTX_SIZE,           16, "drm_amdgpu_ctx union = 16");
    assert_eq(DRM_AMDGPU_BO_LIST_SIZE,       24, "drm_amdgpu_bo_list union = 24");
    assert_eq(DRM_AMDGPU_GEM_VA_SIZE,        64, "drm_amdgpu_gem_va struct = 64");
    assert_eq(DRM_AMDGPU_BO_LIST_ENTRY_SIZE,  8, "drm_amdgpu_bo_list_entry = 8");
    return 0;
}

fn test_native_ctx_opcodes() {
    assert_eq(AMDGPU_CTX_OP_ALLOC_CTX, 1, "ALLOC_CTX = 1");
    assert_eq(AMDGPU_CTX_OP_FREE_CTX,  2, "FREE_CTX = 2");
    return 0;
}

fn test_native_bo_list_opcodes() {
    assert_eq(AMDGPU_BO_LIST_OP_CREATE,  0, "BO_LIST_OP_CREATE = 0");
    assert_eq(AMDGPU_BO_LIST_OP_DESTROY, 1, "BO_LIST_OP_DESTROY = 1");
    return 0;
}

fn test_native_va_opcodes_and_flags() {
    assert_eq(AMDGPU_VA_OP_MAP,            1,   "VA_OP_MAP = 1");
    assert_eq(AMDGPU_VA_OP_UNMAP,          2,   "VA_OP_UNMAP = 2");
    assert_eq(AMDGPU_VM_PAGE_READABLE,     0x2, "PAGE_READABLE = 0x2");
    assert_eq(AMDGPU_VM_PAGE_WRITEABLE,    0x4, "PAGE_WRITEABLE = 0x4");
    assert_eq(AMDGPU_VM_PAGE_EXECUTABLE,   0x8, "PAGE_EXECUTABLE = 0x8");
    return 0;
}

fn test_native_bo_list_entry_layout() {
    # drm_amdgpu_bo_list_entry: {bo_handle u32, bo_priority u32} = 8 bytes.
    var e[8];
    memset(&e, 0, 8);
    store32(&e + 0, 7);
    store32(&e + 4, 3);
    assert_eq(load32(&e + 0), 7, "bo_handle at +0");
    assert_eq(load32(&e + 4), 3, "bo_priority at +4");
    return 0;
}

# ================================================================
# v3 Phase B.3.b — PM4 packet builder
# ================================================================

fn test_native_pm4_opcodes() {
    assert_eq(IT_NOP,             0x10, "IT_NOP opcode");
    assert_eq(IT_SET_SH_REG,      0x76, "IT_SET_SH_REG opcode");
    assert_eq(IT_DISPATCH_DIRECT, 0x15, "IT_DISPATCH_DIRECT opcode");
    assert_eq(IT_ACQUIRE_MEM,     0x58, "IT_ACQUIRE_MEM opcode");
    assert_eq(IT_RELEASE_MEM,     0x49, "IT_RELEASE_MEM opcode");
    assert_eq(IT_EVENT_WRITE,     0x46, "IT_EVENT_WRITE opcode");
    return 0;
}

fn test_native_sh_reg_byte_offsets() {
    # Offsets verified against Mesa rusticl AMD_DEBUG=ib dump on
    # gfx90c (Cezanne APU). The whole block lives at 0xB830-0xB868.
    assert_eq(R_COMPUTE_DISPATCH_INITIATOR, 0xB800, "DISPATCH_INITIATOR byte offset");
    assert_eq(R_COMPUTE_NUM_THREAD_X,       0xB81C, "NUM_THREAD_X byte offset");
    assert_eq(R_COMPUTE_NUM_THREAD_Y,       0xB820, "NUM_THREAD_Y byte offset");
    assert_eq(R_COMPUTE_NUM_THREAD_Z,       0xB824, "NUM_THREAD_Z byte offset");
    assert_eq(R_COMPUTE_PGM_LO,             0xB830, "COMPUTE_PGM_LO byte offset");
    assert_eq(R_COMPUTE_PGM_HI,             0xB834, "COMPUTE_PGM_HI byte offset");
    assert_eq(R_COMPUTE_PGM_RSRC1,          0xB848, "PGM_RSRC1 byte offset");
    assert_eq(R_COMPUTE_PGM_RSRC2,          0xB84C, "PGM_RSRC2 byte offset");
    assert_eq(R_COMPUTE_USER_DATA_0,        0xB900, "USER_DATA_0 byte offset");
    return 0;
}

fn test_native_sh_reg_offset_encoding() {
    # (byte_offset - 0xB000) / 4; values cross-checked against
    # Mesa AMD_DEBUG=ib dump.
    assert_eq(native_sh_reg_offset(R_COMPUTE_DISPATCH_INITIATOR), 0x200, "DISPATCH_INITIATOR → 0x200");
    assert_eq(native_sh_reg_offset(R_COMPUTE_NUM_THREAD_X),       0x207, "NUM_THREAD_X → 0x207");
    assert_eq(native_sh_reg_offset(R_COMPUTE_PGM_LO),             0x20C, "PGM_LO → 0x20C");
    assert_eq(native_sh_reg_offset(R_COMPUTE_PGM_HI),             0x20D, "PGM_HI → 0x20D");
    assert_eq(native_sh_reg_offset(R_COMPUTE_PGM_RSRC1),          0x212, "PGM_RSRC1 → 0x212");
    assert_eq(native_sh_reg_offset(R_COMPUTE_PGM_RSRC2),          0x213, "PGM_RSRC2 → 0x213");
    assert_eq(native_sh_reg_offset(R_COMPUTE_USER_DATA_0),        0x240, "USER_DATA_0 → 0x240");
    return 0;
}

fn test_native_pm4_pkt3_header() {
    # PKT3(IT_NOP, 1, 0): type=3, count=0, opcode=0x10, predicate=0.
    # Expected: (3<<30) | (0<<16) | (0x10<<8) | 0 = 0xC0001000
    assert_eq(native_pm4_pkt3_header(IT_NOP, 1, 0), 0xC0001000, "NOP count=1");
    # PKT3(IT_SET_SH_REG, 2, 0): count-1=1, opcode=0x76.
    # Expected: (3<<30) | (1<<16) | (0x76<<8) | 0 = 0xC0017600
    assert_eq(native_pm4_pkt3_header(IT_SET_SH_REG, 2, 0), 0xC0017600, "SET_SH_REG count=2");
    # PKT3(IT_DISPATCH_DIRECT, 4, 0): count-1=3, opcode=0x15.
    # Expected: (3<<30) | (3<<16) | (0x15<<8) | 0 = 0xC0031500
    assert_eq(native_pm4_pkt3_header(IT_DISPATCH_DIRECT, 4, 0), 0xC0031500, "DISPATCH_DIRECT count=4");
    # Predicate bit in the low byte.
    assert_eq(native_pm4_pkt3_header(IT_NOP, 1, 1), 0xC0001001, "predicate bit set");
    return 0;
}

fn test_native_pm4_set_sh_reg_one_layout() {
    # Setting one register: header + offset + value = 3 dwords.
    var buf[64];
    memset(&buf, 0, 64);
    var pos = native_pm4_set_sh_reg_one(&buf, 0, R_COMPUTE_PGM_LO, 0xDEADBEEF);
    assert_eq(pos, 12, "SET_SH_REG one = 3 dwords = 12 bytes");
    # Header: PKT3(IT_SET_SH_REG, count=2, 0) = 0xC0017600.
    assert_eq(load32(&buf + 0), 0xC0017600, "header");
    # Register offset (SH-reg form): 0x212.
    assert_eq(load32(&buf + 4), 0x20C, "SH-reg offset for PGM_LO");
    # Value we wrote.
    assert_eq(load32(&buf + 8), 0xDEADBEEF, "value");
    return 0;
}

fn test_native_pm4_set_sh_reg_multi_layout() {
    # Setting 3 contiguous regs (PGM_LO, PGM_HI, PGM_RSRC1): header +
    # offset + 3 values = 5 dwords.
    var vals[12];
    store32(&vals + 0, 0x1111);
    store32(&vals + 4, 0x2222);
    store32(&vals + 8, 0x3333);
    var buf[64];
    memset(&buf, 0, 64);
    var pos = native_pm4_set_sh_reg(&buf, 0, R_COMPUTE_PGM_LO, 3, &vals);
    assert_eq(pos, 20, "3-reg SET = 5 dwords = 20 bytes");
    # Header: PKT3(IT_SET_SH_REG, count=4, 0) — count-1 = 3 → (3<<16) | (0x76<<8) | 0xC0000000 = 0xC0037600.
    assert_eq(load32(&buf + 0),  0xC0037600, "header for 3 regs");
    assert_eq(load32(&buf + 4),  0x20C,      "SH-reg offset for PGM_LO base");
    assert_eq(load32(&buf + 8),  0x1111,     "value 1");
    assert_eq(load32(&buf + 12), 0x2222,     "value 2");
    assert_eq(load32(&buf + 16), 0x3333,     "value 3");
    return 0;
}

fn test_native_pm4_dispatch_direct_layout() {
    # DISPATCH_DIRECT: header + 4 data dwords = 5 dwords = 20 bytes.
    var buf[64];
    memset(&buf, 0, 64);
    var pos = native_pm4_dispatch_direct(&buf, 0, 8, 4, 2, COMPUTE_DISPATCH_INITIATOR_MIN);
    assert_eq(pos, 20, "DISPATCH_DIRECT = 5 dwords");
    # Header: PKT3(IT_DISPATCH_DIRECT, 4, shader_type=2) = 0xC0031502.
    # Low byte is shader_type (compute), not predicate — verified against
    # Mesa AMD_DEBUG=ib: `c0031502`.
    assert_eq(load32(&buf + 0),  0xC0031502, "header (shader_type=compute)");
    assert_eq(load32(&buf + 4),  8, "dim_x");
    assert_eq(load32(&buf + 8),  4, "dim_y");
    assert_eq(load32(&buf + 12), 2, "dim_z");
    assert_eq(load32(&buf + 16), 1, "initiator (COMPUTE_SHADER_EN)");
    return 0;
}

fn test_native_pm4_acquire_mem_layout() {
    # ACQUIRE_MEM on GFX9 (shader_type=compute): header + 6 data dwords
    # = 7 dwords = 28 bytes. Mesa emits header c0055802:
    #   type=3, count-1=5 (6 data dwords), opcode=0x58, shader_type=2.
    var buf[64];
    memset(&buf, 0, 64);
    var pos = native_pm4_acquire_mem_full_invalidate(&buf, 0);
    assert_eq(pos, 28, "ACQUIRE_MEM = 7 dwords = 28 bytes");
    # Header must exactly match Mesa's byte-for-byte or the CP
    # misreads the dword count and desynchronizes the IB stream.
    assert_eq(load32(&buf + 0),  0xC0055802, "header byte-exact Mesa match");
    assert_eq(load32(&buf + 4),  0xA8C40000, "coher_cntl");
    assert_eq(load32(&buf + 8),  0xFFFFFFFF, "coher_size_lo");
    assert_eq(load32(&buf + 12), 0x00FFFFFF, "coher_size_hi");
    assert_eq(load32(&buf + 16), 0,          "coher_base_lo");
    assert_eq(load32(&buf + 20), 0,          "coher_base_hi");
    assert_eq(load32(&buf + 24), 0x0A,       "poll_interval");
    return 0;
}

fn test_native_pm4_nop_padding() {
    # NOP with pad_dwords=4: header + 3 filler dwords = 4 dwords = 16 bytes.
    var buf[64];
    memset(&buf, 0xFF, 64);
    var pos = native_pm4_nop(&buf, 0, 4);
    assert_eq(pos, 16, "NOP pad=4 → 16 bytes");
    # Header: PKT3(IT_NOP, 4, 0) = (3<<30) | (3<<16) | (0x10<<8) = 0xC0031000.
    assert_eq(load32(&buf + 0),  0xC0031000, "NOP header");
    # Filler dwords zeroed.
    assert_eq(load32(&buf + 4),  0, "filler 1");
    assert_eq(load32(&buf + 8),  0, "filler 2");
    assert_eq(load32(&buf + 12), 0, "filler 3");
    # NOP with pad_dwords=1: just the header, no filler.
    memset(&buf, 0xFF, 64);
    pos = native_pm4_nop(&buf, 0, 1);
    assert_eq(pos, 4, "NOP pad=1 → 4 bytes");
    assert_eq(load32(&buf + 0), 0xC0001000, "single-dword NOP header");
    return 0;
}

fn test_native_gfx9_shader_constants() {
    # s_endpgm (SOPP format): 0xBF810000 on GFX9. Stable across GFX6-11.
    assert_eq(GFX9_S_ENDPGM, 0xBF810000, "s_endpgm encoding");
    # PGM_RSRC1: FLOAT_MODE=0xC0 | SGPRS=1 | DX10_CLAMP=1 (IEEE_MODE=0
    # per Mesa rusticl verified dump on gfx90c).
    # = (0xC0 << 12) | (1 << 6) | (1 << 21) = 0x002C0040.
    assert_eq(GFX9_COMPUTE_PGM_RSRC1_MIN, 0x2C0040, "RSRC1 = 0x002C0040 (matches Mesa rusticl)");
    assert_eq(GFX9_COMPUTE_PGM_RSRC2_MIN, 0, "RSRC2 min (no user SGPR / scratch / LDS)");
    # DISPATCH_INITIATOR: 0x45 (Mesa-verified).
    assert_eq(GFX9_DISPATCH_INITIATOR, 0x45, "DISPATCH_INITIATOR = 0x45");
    return 0;
}

fn test_native_gfx9_extended_register_offsets() {
    # Offsets from Mesa AMD_DEBUG=ib dump on gfx90c.
    assert_eq(R_COMPUTE_RESOURCE_LIMITS,        0xB854, "RESOURCE_LIMITS byte offset");
    assert_eq(R_COMPUTE_STATIC_THREAD_MGMT_SE0, 0xB858, "STATIC_THREAD_MGMT_SE0");
    assert_eq(R_COMPUTE_STATIC_THREAD_MGMT_SE1, 0xB85C, "STATIC_THREAD_MGMT_SE1");
    assert_eq(R_COMPUTE_TMPRING_SIZE,           0xB860, "TMPRING_SIZE");
    assert_eq(R_COMPUTE_STATIC_THREAD_MGMT_SE2, 0xB864, "STATIC_THREAD_MGMT_SE2");
    assert_eq(R_COMPUTE_STATIC_THREAD_MGMT_SE3, 0xB868, "STATIC_THREAD_MGMT_SE3");
    return 0;
}

fn test_native_gfx9_shader_endpgm_writes_bytes() {
    var buf[16];
    memset(&buf, 0xFF, 16);
    var pos = native_gfx9_shader_endpgm(&buf, 0);
    assert_eq(pos, 4, "endpgm wrote 4 bytes");
    assert_eq(load32(&buf + 0), 0xBF810000, "endpgm bytes");
    return 0;
}

fn test_native_gfx9_shader_store_deadbeef_writes_bytes() {
    # Byte-exact assertion against clang -target amdgcn--amdhsa
    # -mcpu=gfx90c output. If clang's encoding of any of these
    # instructions ever changes (unlikely for a stable ISA), this
    # test is the canary.
    var buf[128];
    memset(&buf, 0xFF, 128);
    var pos = native_gfx9_shader_store_deadbeef(&buf, 0);
    assert_eq(pos, 96, "store shader total = 32 B instr + 64 B NOP pad");
    assert_eq(load32(&buf +  0), 0x7E000200, "v_mov_b32_e32 v0, s0");
    assert_eq(load32(&buf +  4), 0x7E020201, "v_mov_b32_e32 v1, s1");
    assert_eq(load32(&buf +  8), 0x7E0402FF, "v_mov_b32_e32 v2, <literal>");
    assert_eq(load32(&buf + 12), 0xDEADBEEF, "literal 0xDEADBEEF");
    assert_eq(load32(&buf + 16), 0xDC738000, "global_store_dword dword 1 (FLAT + glc + slc)");
    assert_eq(load32(&buf + 20), 0x007F0200, "global_store_dword dword 2 (addr=v0 data=v2 saddr=off)");
    assert_eq(load32(&buf + 24), 0xBF8C0070, "s_waitcnt vmcnt(0) lgkmcnt(0)");
    assert_eq(load32(&buf + 28), 0xBF810000, "s_endpgm");
    assert_eq(load32(&buf + 32), 0xBF800000, "NOP pad [0]");
    assert_eq(load32(&buf + 92), 0xBF800000, "NOP pad [15]");
    return 0;
}

fn test_native_syncobj_ioctl_encodings() {
    # All three are _IOWR('d', nr, struct syncobj_*).
    var create_expected  = native_ioc_encode(3, DRM_SYNCOBJ_CREATE_SIZE,  DRM_IOCTL_TYPE, 0xBF);
    var destroy_expected = native_ioc_encode(3, DRM_SYNCOBJ_DESTROY_SIZE, DRM_IOCTL_TYPE, 0xC0);
    var wait_expected    = native_ioc_encode(3, DRM_SYNCOBJ_WAIT_SIZE,    DRM_IOCTL_TYPE, 0xC3);
    assert_eq(DRM_IOCTL_SYNCOBJ_CREATE,  create_expected,  "SYNCOBJ_CREATE ioctl");
    assert_eq(DRM_IOCTL_SYNCOBJ_DESTROY, destroy_expected, "SYNCOBJ_DESTROY ioctl");
    assert_eq(DRM_IOCTL_SYNCOBJ_WAIT,    wait_expected,    "SYNCOBJ_WAIT ioctl");
    assert_eq(DRM_IOCTL_SYNCOBJ_CREATE,  0xC00864BF, "SYNCOBJ_CREATE = 0xC00864BF");
    assert_eq(DRM_IOCTL_SYNCOBJ_DESTROY, 0xC00864C0, "SYNCOBJ_DESTROY = 0xC00864C0");
    assert_eq(DRM_IOCTL_SYNCOBJ_WAIT,    0xC02864C3, "SYNCOBJ_WAIT = 0xC02864C3 (40-byte struct)");
    return 0;
}

fn test_native_syncobj_sizes_and_flags() {
    assert_eq(DRM_SYNCOBJ_CREATE_SIZE,  8,  "syncobj_create = 8");
    assert_eq(DRM_SYNCOBJ_DESTROY_SIZE, 8,  "syncobj_destroy = 8");
    assert_eq(DRM_SYNCOBJ_WAIT_SIZE,    40, "syncobj_wait = 40");
    assert_eq(DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL,        0x1, "WAIT_ALL = 0x1");
    assert_eq(DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT, 0x2, "WAIT_FOR_SUBMIT = 0x2");
    return 0;
}

fn test_native_cs_ioctl_encoding() {
    var expected = native_ioc_encode(3, DRM_AMDGPU_CS_SIZE, DRM_IOCTL_TYPE,
                                     DRM_COMMAND_BASE + DRM_AMDGPU_CS);
    assert_eq(DRM_IOCTL_AMDGPU_CS, expected, "AMDGPU_CS ioctl");
    assert_eq(DRM_IOCTL_AMDGPU_CS, 0xC0186444, "precomputed constant");
    assert_eq(DRM_AMDGPU_CS, 0x04, "CS nr offset");
    return 0;
}

fn test_native_cs_struct_sizes() {
    assert_eq(DRM_AMDGPU_CS_SIZE,               24, "union drm_amdgpu_cs = 24");
    assert_eq(DRM_AMDGPU_CS_CHUNK_SIZE,         16, "drm_amdgpu_cs_chunk = 16");
    assert_eq(DRM_AMDGPU_CS_CHUNK_IB_SIZE,      32, "drm_amdgpu_cs_chunk_ib = 32");
    # _sem struct: u32 handle only, used by SYNCOBJ_OUT / SYNCOBJ_IN /
    # DEPENDENCIES / SCHEDULED_DEPENDENCIES chunks.
    assert_eq(DRM_AMDGPU_CS_CHUNK_SEM_SIZE,      4, "drm_amdgpu_cs_chunk_sem = 4");
    # _syncobj struct: 16 bytes, used by SYNCOBJ_TIMELINE_WAIT/SIGNAL only.
    assert_eq(DRM_AMDGPU_CS_CHUNK_SYNCOBJ_SIZE, 16, "drm_amdgpu_cs_chunk_syncobj = 16");
    return 0;
}

fn test_native_cs_chunk_ids_and_ip_types() {
    assert_eq(AMDGPU_CHUNK_ID_IB,          0x01, "CHUNK_ID_IB");
    assert_eq(AMDGPU_CHUNK_ID_FENCE,       0x02, "CHUNK_ID_FENCE");
    assert_eq(AMDGPU_CHUNK_ID_SYNCOBJ_OUT, 0x05, "CHUNK_ID_SYNCOBJ_OUT");
    assert_eq(AMDGPU_HW_IP_GFX,     0, "HW_IP_GFX");
    assert_eq(AMDGPU_HW_IP_COMPUTE, 1, "HW_IP_COMPUTE");
    return 0;
}

fn test_native_pm4_builder_composability() {
    # Chain operations: NOP + SET_SH_REG(one) + DISPATCH_DIRECT.
    # Expected layout:
    #   0x00-0x03: NOP header (1 dword)
    #   0x04-0x0F: SET_SH_REG DISPATCH_INITIATOR = 1 (3 dwords)
    #   0x10-0x23: DISPATCH_DIRECT 1,1,1, init=1 (5 dwords)
    # Total: 9 dwords = 36 bytes.
    var buf[64];
    memset(&buf, 0, 64);
    var pos = 0;
    pos = native_pm4_nop(&buf, pos, 1);
    pos = native_pm4_set_sh_reg_one(&buf, pos, R_COMPUTE_DISPATCH_INITIATOR, 1);
    pos = native_pm4_dispatch_direct(&buf, pos, 1, 1, 1, COMPUTE_DISPATCH_INITIATOR_MIN);
    assert_eq(pos, 36, "composed stream = 36 bytes");
    # Spot check: each header at its expected offset.
    assert_eq(load32(&buf + 0),  0xC0001000, "NOP header at 0");
    assert_eq(load32(&buf + 4),  0xC0017600, "SET_SH_REG header at 4");
    assert_eq(load32(&buf + 16), 0xC0031502, "DISPATCH_DIRECT header at 16 (shader_type=compute)");
    return 0;
}

fn test_rg_plan_reclaim_ratio_chain() {
    # 6-node linear chain with 5 transients. Each node hands off to the
    # next via a distinct transient. Classic staggered interval graph —
    # heavy aliasing opportunity.
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    var bufs[40];
    var i = 0;
    while (i < 5) {
        store64(&bufs + i * 8, rg_add_transient_buffer(g, 256, 0, "b"));
        i = i + 1;
    }
    var nodes[48];
    i = 0;
    while (i < 6) {
        store64(&nodes + i * 8, rg_add_compute(g, 0, 0, &dims, "n"));
        i = i + 1;
    }
    i = 0;
    while (i < 5) {
        rg_node_writes(g, load64(&nodes + i * 8), load64(&bufs + i * 8));
        rg_node_reads(g, load64(&nodes + (i + 1) * 8), load64(&bufs + i * 8));
        i = i + 1;
    }
    assert_eq(rg_build(g, 0), 0, "chain builds");
    var stats[24];
    assert_eq(rg_plan_aliasing_stats(g, &stats), 0, "plan ok");
    # naive = 5 * 256 = 1280. Staggered pairs: b0/b2/b4 can share one
    # slot (lifetimes [0,1], [2,3], [4,5] — disjoint); b1/b3 share
    # another ([1,2], [3,4] — disjoint). 2 slots, aliased = 512.
    assert_eq(load64(&stats + 0), 2, "2 slots");
    assert_eq(load64(&stats + 8), 1280, "naive = 5 * 256");
    assert_eq(load64(&stats + 16), 512, "aliased = 2 * 256");
    var reclaim = (load64(&stats + 8) - load64(&stats + 16)) * 100 / load64(&stats + 8);
    assert(reclaim >= 30, "reclaim >= 30%");
    return 0;
}

fn test_audit_bgl_entry_buffer_offsets() {
    # WGPUBindGroupLayoutEntry is 120 bytes. Buffer sub-struct starts at
    # +32 with its own nextInChain (8 bytes) first; type lives at +40,
    # hasDynamicOffset at +44, minBindingSize at +48. Pre-fix, mabda was
    # writing type at +32 (into the nextInChain ptr slot) which caused
    # wgpu_core to treat a non-null garbage pointer as a chained struct
    # and reject the BGL.
    var e[120];
    memset(&e, 0xAA, 120);
    wgpu_bgl_entry_buffer(&e, 7, WGPU_SHADER_STAGE_COMPUTE,
    WGPU_BUFFER_BINDING_TYPE_STORAGE, 1, 256);
    assert_eq(load64(&e), 0, "BGL entry nextInChain cleared to 0");
    assert_eq(load32(&e + 8), 7, "BGL entry binding @ +8");
    assert_eq(load64(&e + 16), WGPU_SHADER_STAGE_COMPUTE,
    "BGL entry visibility @ +16 (u64)");
    assert_eq(load64(&e + 32), 0,
    "BGL entry buffer.nextInChain @ +32 cleared");
    assert_eq(load32(&e + 40), WGPU_BUFFER_BINDING_TYPE_STORAGE,
    "BGL entry buffer.type @ +40 (NOT +32)");
    assert_eq(load32(&e + 44), 1,
    "BGL entry buffer.hasDynamicOffset @ +44 (NOT +36)");
    assert_eq(load64(&e + 48), 256,
    "BGL entry buffer.minBindingSize @ +48 (NOT +40)");
    return 0;
}

# ================================================================
# v2.4.1 — sakshi observability wiring
# ================================================================
# These assertions verify the gating contract: mabda emits sakshi
# events when explicitly enabled, and is silent otherwise. The ring
# buffer output target keeps tests from polluting stderr.

fn test_obs_disabled_by_default() {
    assert_eq(mabda_observability_is_enabled(), 0,
    "observability disabled by default");
    return 0;
}

fn test_obs_enable_disable_flips_flag() {
    mabda_observability_enable();
    assert_eq(mabda_observability_is_enabled(), 1,
    "enable() sets flag");
    mabda_observability_disable();
    assert_eq(mabda_observability_is_enabled(), 0,
    "disable() clears flag");
    return 0;
}

fn test_obs_disabled_no_sakshi_emission() {
    sakshi_output_buffer();
    sakshi_set_level(SK_TRACE);
    sakshi_ring_clear();
    mabda_observability_disable();
    var before = sakshi_ring_event_count();
    gpu_err_result(GPU_ERR_SHADER);
    assert_eq(sakshi_ring_event_count(), before,
    "no sakshi event when observability disabled");
    return 0;
}

fn test_obs_enabled_emits_on_err_result() {
    sakshi_output_buffer();
    sakshi_set_level(SK_TRACE);
    sakshi_ring_clear();
    mabda_observability_enable();
    var before = sakshi_ring_event_count();
    gpu_err_result(GPU_ERR_SHADER);
    assert_eq(sakshi_ring_event_count(), before + 1,
    "one sakshi event per gpu_err_result when observability enabled");
    mabda_observability_disable();
    return 0;
}

fn test_obs_frame_span_balanced() {
    sakshi_output_buffer();
    sakshi_set_level(SK_TRACE);
    mabda_observability_enable();
    var depth_before = sakshi_span_depth();
    var p = profiler_new();
    profiler_begin_frame(p);
    profiler_end_frame(p);
    assert_eq(sakshi_span_depth(), depth_before,
    "begin/end_frame leave sakshi span depth unchanged");
    mabda_observability_disable();
    return 0;
}

