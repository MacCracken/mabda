# tests/tcyr/mabda.tcyr — consolidated CPU-only test suite for mabda
# 9 sections + audit regressions — 286 assertions. Sections: error,
# color, capabilities, profiler, typed_buffer, vertex, state
# (blend+sampler+depth), caches, surface, plus the audit-2026-04-19
# regressions that lock in HIGH / MEDIUM fixes from the 2.3.0 pass.
# GPU integration tests (phase0, etc.) live in programs/phase0.cyr
# and compile through deps/wgpu_main.c via `make test-phase0`.

include "src/lib.cyr"
include "lib/assert.cyr"

# ================================================================
# error
# ================================================================
# test_error.tcyr — pure-data tests for error.cyr
# Ported from the Rust v1.0.0 error.rs tests — see git tag 1.0.0.
# (Excludes wgpu:: variants that
# don't have a Cyrius analogue — Send/Sync, source chain, Box<dyn Error>).

# ================================================================
# Error code constants are distinct
# ================================================================
fn test_error_codes_unique() {
    assert(GPU_ERR_NONE             != GPU_ERR_ADAPTER_NOT_FOUND, "none != adapter");
    assert(GPU_ERR_ADAPTER_NOT_FOUND != GPU_ERR_DEVICE_REQUEST,   "adapter != device");
    assert(GPU_ERR_SURFACE_CONFIG   != GPU_ERR_SURFACE_TIMEOUT,   "config != timeout");
    assert(GPU_ERR_SURFACE_OUTDATED != GPU_ERR_SURFACE_LOST,      "outdated != lost");
    assert(GPU_ERR_BUFFER           != GPU_ERR_TEXTURE,           "buffer != texture");
    assert(GPU_ERR_FFI_LOAD         != GPU_ERR_FFI_SYMBOL,        "ffi load != ffi sym");
    return 0;
}

# ================================================================
# gpu_err_result struct construction + accessors
# ================================================================
fn test_gpu_err_new() {
    var e = gpu_err_new(GPU_ERR_BUFFER, "out of memory");
    assert_eq(gpu_err_code(e), GPU_ERR_BUFFER, "code stored");
    var d = gpu_err_detail(e);
    assert(d != 0, "detail stored");
    assert_eq(strlen(d), 13, "detail string length");
    return 0;
}

fn test_gpu_err_no_detail() {
    var e = gpu_err(GPU_ERR_ADAPTER_NOT_FOUND);
    assert_eq(gpu_err_code(e), GPU_ERR_ADAPTER_NOT_FOUND, "code stored");
    assert_eq(gpu_err_detail(e), 0, "detail is null");
    return 0;
}

# ================================================================
# is_recoverable — mirror the Rust test cases exactly
# ================================================================
fn test_recoverable_surface_timeout() {
    assert_eq(gpu_err_is_recoverable(GPU_ERR_SURFACE_TIMEOUT), 1, "timeout recoverable");
    return 0;
}

fn test_recoverable_surface_outdated() {
    assert_eq(gpu_err_is_recoverable(GPU_ERR_SURFACE_OUTDATED), 1, "outdated recoverable");
    return 0;
}

fn test_recoverable_surface_config() {
    assert_eq(gpu_err_is_recoverable(GPU_ERR_SURFACE_CONFIG), 1, "config recoverable");
    return 0;
}

fn test_not_recoverable_adapter() {
    assert_eq(gpu_err_is_recoverable(GPU_ERR_ADAPTER_NOT_FOUND), 0, "adapter not recoverable");
    return 0;
}

fn test_not_recoverable_surface_lost() {
    assert_eq(gpu_err_is_recoverable(GPU_ERR_SURFACE_LOST), 0, "lost not recoverable");
    return 0;
}

fn test_not_recoverable_readback() {
    assert_eq(gpu_err_is_recoverable(GPU_ERR_READBACK_CHANNEL), 0, "readback not recoverable");
    return 0;
}

fn test_not_recoverable_shader() {
    assert_eq(gpu_err_is_recoverable(GPU_ERR_SHADER), 0, "shader not recoverable");
    return 0;
}

# ================================================================
# Name lookup coverage
# ================================================================
fn test_name_adapter_not_found() {
    var n = gpu_err_name(GPU_ERR_ADAPTER_NOT_FOUND);
    assert(n != 0, "name non-null");
    # strstr-free check: just verify length > 0 and first char
    assert(strlen(n) > 0, "name non-empty");
    return 0;
}

fn test_name_unknown_code() {
    var n = gpu_err_name(9999);
    assert(strlen(n) > 0, "unknown returns placeholder");
    return 0;
}

fn test_name_none() {
    var n = gpu_err_name(GPU_ERR_NONE);
    assert_eq(strlen(n), 4, "name('none') length 4");
    return 0;
}

# ================================================================
# Result / tagged-union helpers (gpu_ok, gpu_err_result, gpu_err_result_msg)
# ================================================================
fn test_gpu_ok_tag() {
    var r = gpu_ok(42);
    assert_eq(is_ok(r), 1, "gpu_ok → is_ok");
    assert_eq(is_err_result(r), 0, "gpu_ok → not err");
    assert_eq(payload(r), 42, "payload preserved");
    return 0;
}

fn test_gpu_err_tag() {
    var r = gpu_err_result(GPU_ERR_BUFFER);
    assert_eq(is_err_result(r), 1, "gpu_err_result → is_err");
    assert_eq(is_ok(r), 0, "gpu_err_result → not ok");
    var e = payload(r);
    assert_eq(gpu_err_code(e), GPU_ERR_BUFFER, "code preserved");
    return 0;
}

fn test_gpu_err_msg_tag() {
    var r = gpu_err_result_msg(GPU_ERR_PIPELINE, "link failed");
    assert_eq(is_err_result(r), 1, "gpu_err_result_msg → is_err");
    var e = payload(r);
    assert_eq(gpu_err_code(e), GPU_ERR_PIPELINE, "code preserved");
    assert(gpu_err_detail(e) != 0, "detail stored");
    return 0;
}

# ================================================================
# color
# ================================================================
# test_color.tcyr — tests for color.cyr
# Ported from mabda/src/color.rs tests

# ================================================================
# Tests
# ================================================================

fn test_color_constants() {
    var w = COLOR_WHITE();
    assert(color_r(w) == F64_1, "white r=1");
    assert(color_g(w) == F64_1, "white g=1");
    assert(color_b(w) == F64_1, "white b=1");
    assert(color_a(w) == F64_1, "white a=1");

    var b = COLOR_BLACK();
    assert(color_r(b) == F64_0, "black r=0");
    assert(color_g(b) == F64_0, "black g=0");
    assert(color_b(b) == F64_0, "black b=0");
    assert(color_a(b) == F64_1, "black a=1");

    var t = COLOR_TRANSPARENT();
    assert(color_a(t) == F64_0, "transparent a=0");
    assert(color_r(t) == F64_0, "transparent r=0");
    return 0;
}

fn test_color_rgb_constants() {
    var r = COLOR_RED();
    assert(color_r(r) == F64_1, "red r=1");
    assert(color_g(r) == F64_0, "red g=0");
    assert(color_b(r) == F64_0, "red b=0");

    var g = COLOR_GREEN();
    assert(color_g(g) == F64_1, "green g=1");
    assert(color_r(g) == F64_0, "green r=0");

    var bl = COLOR_BLUE();
    assert(color_b(bl) == F64_1, "blue b=1");
    assert(color_r(bl) == F64_0, "blue r=0");
    return 0;
}

fn test_color_cornflower() {
    var cb = COLOR_CORNFLOWER_BLUE();
    assert(color_r(cb) == F64_CB_R, "cornflower r");
    assert(color_g(cb) == F64_CB_G, "cornflower g");
    assert(color_b(cb) == F64_CB_B, "cornflower b");
    assert(color_a(cb) == F64_1, "cornflower a=1");
    return 0;
}

fn test_color_from_rgba8() {
    var c = color_from_rgba8(255, 0, 0, 255);
    # r should be 255/255 = 1.0
    assert(color_r(c) == F64_1, "rgba8 255 = 1.0");
    assert(color_g(c) == F64_0, "rgba8 0 = 0.0");
    assert(color_a(c) == F64_1, "rgba8 alpha 255 = 1.0");

    # All zeros = transparent
    var t = color_from_rgba8(0, 0, 0, 0);
    assert(color_eq(t, COLOR_TRANSPARENT()) == 1, "rgba8(0,0,0,0) = transparent");

    # All 255 = white
    var w = color_from_rgba8(255, 255, 255, 255);
    assert(color_eq(w, COLOR_WHITE()) == 1, "rgba8(255,255,255,255) = white");
    return 0;
}

fn test_color_from_hex() {
    # 0xFF0000FF = opaque red
    var red = color_from_hex(0xFF0000FF);
    assert(color_r(red) == F64_1, "hex red r=1");
    assert(color_g(red) == F64_0, "hex red g=0");
    assert(color_b(red) == F64_0, "hex red b=0");
    assert(color_a(red) == F64_1, "hex red a=1");

    # 0x00000000 = transparent
    var t = color_from_hex(0x00000000);
    assert(color_eq(t, COLOR_TRANSPARENT()) == 1, "hex 0 = transparent");
    return 0;
}

fn test_color_lerp() {
    var black = COLOR_BLACK();
    var white = COLOR_WHITE();
    var mid = color_lerp(black, white, F64_HALF);

    # mid.r should be ~0.5
    var mr = color_r(mid);
    var diff = f64_sub(mr, F64_HALF);
    # Check abs(diff) < 0.001
    if (f64_lt(diff, F64_0) == 1) { diff = f64_neg(diff); }
    var eps = 4547007087734592512;  # 0.001
    assert(f64_lt(diff, eps) == 1, "lerp midpoint r ~0.5");
    return 0;
}

fn test_color_lerp_clamp() {
    var black = COLOR_BLACK();
    var white = COLOR_WHITE();

    # t=0 returns first color
    var at0 = color_lerp(black, white, F64_0);
    assert(color_eq(at0, black) == 1, "lerp t=0 = first");

    # t=1 returns second color
    var at1 = color_lerp(black, white, F64_1);
    assert(color_eq(at1, white) == 1, "lerp t=1 = second");

    # t<0 clamps to first
    var neg = f64_neg(F64_1);
    var clamped = color_lerp(black, white, neg);
    assert(color_eq(clamped, black) == 1, "lerp t<0 clamps");

    # t>1 clamps to second
    var over = color_lerp(black, white, F64_TWO);
    assert(color_eq(over, white) == 1, "lerp t>1 clamps");
    return 0;
}

fn test_color_luminance() {
    # White luminance ~ 1.0
    var wl = color_luminance(COLOR_WHITE());
    var diff_w = f64_sub(wl, F64_1);
    if (f64_lt(diff_w, F64_0) == 1) { diff_w = f64_neg(diff_w); }
    var eps = 4562254508917369856;  # 0.01
    assert(f64_lt(diff_w, eps) == 1, "white luminance ~1.0");

    # Black luminance = 0.0
    var bl = color_luminance(COLOR_BLACK());
    assert(bl == F64_0, "black luminance = 0.0");

    # Red luminance < Green luminance (Rec. 709)
    var rl = color_luminance(COLOR_RED());
    var gl = color_luminance(COLOR_GREEN());
    assert(f64_lt(rl, gl) == 1, "red lum < green lum");
    return 0;
}

fn test_color_f64_to_f32() {
    # 1.0 as f64 → 1.0 as f32 (0x3F800000)
    var f32_one = f64_to_f32(F64_1);
    assert_eq(f32_one, 0x3F800000, "f64_to_f32(1.0) = 0x3F800000");

    # 0.0 as f64 → 0.0 as f32 (0x00000000)
    var f32_zero = f64_to_f32(F64_0);
    assert_eq(f32_zero, 0, "f64_to_f32(0.0) = 0");

    # Roundtrip: f64 → f32 → f64
    var rt = f32_to_f64(f64_to_f32(F64_1));
    assert(rt == F64_1, "f32 roundtrip 1.0");
    return 0;
}

fn test_color_write_f32() {
    var red = COLOR_RED();
    var buf[16];
    color_write_f32(red, &buf);
    # r = 1.0 f32 = 0x3F800000
    assert_eq(load32(&buf), 0x3F800000, "write_f32 red r");
    # g = 0.0 f32 = 0x00000000
    assert_eq(load32(&buf + 4), 0, "write_f32 red g");
    # b = 0.0
    assert_eq(load32(&buf + 8), 0, "write_f32 red b");
    # a = 1.0
    assert_eq(load32(&buf + 12), 0x3F800000, "write_f32 red a");
    return 0;
}

fn test_color_rgb() {
    var c = color_rgb(F64_HALF, F64_HALF, F64_HALF);
    assert(color_a(c) == F64_1, "rgb alpha = 1.0");
    assert(color_r(c) == F64_HALF, "rgb r = 0.5");
    return 0;
}

# ================================================================
# capabilities
# ================================================================
# test_capabilities.tcyr — pure-data tests for capabilities.cyr
# Ported from the Rust v1.0.0 capabilities.rs tests — see git tag 1.0.0.
# (Skips serde roundtrip and
# GPU from_context — no equivalents in Cyrius).

# ================================================================
# WebGPU constants
# ================================================================
fn test_webgpu_constants() {
    assert_eq(WEBGPU_MAX_BIND_GROUPS, 4, "MAX_BIND_GROUPS=4");
    assert_eq(WEBGPU_MAX_UNIFORM_BUFFER, 65536, "MAX_UNIFORM_BUFFER=65536");
    assert_eq(WEBGPU_MAX_STORAGE_BUFFER, 134217728, "MAX_STORAGE_BUFFER=128 MiB");
    assert_eq(WEBGPU_MAX_TEXTURE_2D, 8192, "MAX_TEXTURE_2D=8192");
    return 0;
}

fn test_webgpu_uniform_fits() {
    assert_eq(webgpu_uniform_fits(1024),  1, "1024 fits");
    assert_eq(webgpu_uniform_fits(65536), 1, "65536 fits (at boundary)");
    assert_eq(webgpu_uniform_fits(65537), 0, "65537 rejected (over limit)");
    return 0;
}

# ================================================================
# GpuCapabilities struct — accessors mirror stored values
# ================================================================
fn _build_test_caps() {
    var c = gpu_caps_new();
    gpu_caps_set_adapter_name(c, "Test GPU");
    gpu_caps_set_backend(c, "Vulkan");
    gpu_caps_set_timestamp_query(c, 1);
    gpu_caps_set_max_texture_2d(c, 16384);
    gpu_caps_set_max_uniform(c, 65536);
    gpu_caps_set_max_storage(c, 134217728);
    gpu_caps_set_max_buffer(c, 268435456);
    gpu_caps_set_max_bind_groups(c, 4);
    gpu_caps_set_max_vertex_buf(c, 8);
    gpu_caps_set_compute_wg(c, 256, 256, 64);
    gpu_caps_set_compute_wgs_dim(c, 65535);
    gpu_caps_set_multi_draw(c, 0);
    return c;
}

fn test_caps_accessors() {
    var c = _build_test_caps();

    var n = gpu_caps_adapter_name(c);
    assert(n != 0, "adapter_name non-null");
    assert_eq(strlen(n), 8, "adapter_name='Test GPU' (8 chars)");

    var b = gpu_caps_backend(c);
    assert(b != 0, "backend non-null");
    assert_eq(strlen(b), 6, "backend='Vulkan' (6 chars)");

    assert_eq(gpu_caps_timestamp_query(c),     1, "timestamp_query=true");
    assert_eq(gpu_caps_compute_shaders(c),     1, "compute_shaders=true (default)");
    assert_eq(gpu_caps_max_texture_2d(c),      16384, "max_texture_2d");
    assert_eq(gpu_caps_max_uniform_buffer(c),  65536, "max_uniform_buffer");
    assert_eq(gpu_caps_max_storage_buffer(c),  134217728, "max_storage_buffer");
    assert_eq(gpu_caps_max_buffer_size(c),     268435456, "max_buffer_size");
    assert_eq(gpu_caps_max_bind_groups(c),     4, "max_bind_groups");
    assert_eq(gpu_caps_max_vertex_buffers(c),  8, "max_vertex_buffers");
    assert_eq(gpu_caps_max_compute_wg_x(c),   256, "wg_x=256");
    assert_eq(gpu_caps_max_compute_wg_y(c),   256, "wg_y=256");
    assert_eq(gpu_caps_max_compute_wg_z(c),   64,  "wg_z=64");
    assert_eq(gpu_caps_max_compute_wgs_dim(c), 65535, "wgs_per_dim");
    assert_eq(gpu_caps_multi_draw_indirect(c), 0, "multi_draw=false");
    return 0;
}

# ================================================================
# Instance-level validation helpers (uniform_fits, storage_fits)
# Port of test_capabilities_uniform_storage_fits from Rust.
# ================================================================
fn test_caps_uniform_fits() {
    var c = _build_test_caps();
    assert_eq(gpu_caps_uniform_fits(c, 1024),   1, "1024 fits in 65536");
    assert_eq(gpu_caps_uniform_fits(c, 65536),  1, "boundary fits");
    assert_eq(gpu_caps_uniform_fits(c, 65537),  0, "65537 over limit");
    return 0;
}

fn test_caps_storage_fits() {
    var c = _build_test_caps();
    assert_eq(gpu_caps_storage_fits(c, 1024),       1, "1024 fits in 128 MiB");
    assert_eq(gpu_caps_storage_fits(c, 134217728),  1, "boundary fits");
    assert_eq(gpu_caps_storage_fits(c, 134217729),  0, "over 128 MiB rejected");
    return 0;
}

# ================================================================
# Newly-constructed caps has compute_shaders=1 by convention
# ================================================================
fn test_caps_defaults() {
    var c = gpu_caps_new();
    assert_eq(gpu_caps_compute_shaders(c), 1, "compute_shaders defaults to true");
    assert_eq(gpu_caps_timestamp_query(c), 0, "timestamp_query defaults to false");
    assert_eq(gpu_caps_adapter_name(c),    0, "adapter_name defaults to null");
    assert_eq(gpu_caps_max_uniform_buffer(c), 0, "max_uniform defaults to 0");
    return 0;
}

# ================================================================
# profiler
# ================================================================
# test_profiler.tcyr — tests for profiler.cyr

fn test_profiler_new() {
    var p = profiler_new();
    assert(p != 0, "profiler allocated");
    assert_eq(profiler_frame_count(p), 0, "initial frame_count=0");
    return 0;
}

fn test_profiler_frame() {
    var p = profiler_new();
    profiler_begin_frame(p);
    # Small busy wait
    var sum = 0;
    for (var i = 0; i < 10000; i = i + 1) { sum = sum + i; }
    var elapsed = profiler_end_frame(p);

    assert_eq(profiler_frame_count(p), 1, "frame_count=1 after one frame");
    # elapsed should be > 0
    assert(f64_gt(elapsed, F64_0) == 1, "elapsed > 0");
    # cpu_frame_ms should match elapsed
    assert(profiler_cpu_frame_ms(p) == elapsed, "cpu_frame_ms matches");
    return 0;
}

fn test_profiler_ema() {
    var p = profiler_new();
    # Run 10 frames
    for (var i = 0; i < 10; i = i + 1) {
        profiler_begin_frame(p);
        var sum = 0;
        for (var j = 0; j < 1000; j = j + 1) { sum = sum + j; }
        profiler_end_frame(p);
    }
    assert_eq(profiler_frame_count(p), 10, "10 frames counted");
    # avg_frame_ms should be > 0
    assert(f64_gt(profiler_avg_frame_ms(p), F64_0) == 1, "avg > 0");
    # fps should be > 0
    assert(f64_gt(profiler_fps(p), F64_0) == 1, "fps > 0");
    return 0;
}

fn test_profiler_history() {
    var p = profiler_with_alpha_and_history(
    f64_div(f64_from(5), f64_from(100)),
    5  # small history for testing
    );
    # Run 8 frames — should keep only last 5
    for (var i = 0; i < 8; i = i + 1) {
        profiler_begin_frame(p);
        profiler_end_frame(p);
    }
    var history = load64(p + 56);
    assert_eq(vec_len(history), 5, "history capped at 5");
    return 0;
}

fn test_profiler_worst_best() {
    var p = profiler_new();
    # Run some frames
    for (var i = 0; i < 5; i = i + 1) {
        profiler_begin_frame(p);
        var sum = 0;
        for (var j = 0; j < 1000; j = j + 1) { sum = sum + j; }
        profiler_end_frame(p);
    }
    var worst = profiler_worst_frame_ms(p);
    var best = profiler_best_frame_ms(p);
    # worst >= best
    assert(f64_gt(worst, F64_0) == 1, "worst > 0");
    assert(f64_gt(best, F64_0) == 1, "best > 0");
    # worst >= best (or equal if all frames identical)
    var ge = f64_gt(worst, best);
    if (ge != 1) { ge = (worst == best); }
    assert(ge == 1, "worst >= best");
    return 0;
}

fn test_profiler_reset() {
    var p = profiler_new();
    profiler_begin_frame(p);
    profiler_end_frame(p);
    assert_eq(profiler_frame_count(p), 1, "count=1 before reset");
    profiler_reset(p);
    assert_eq(profiler_frame_count(p), 0, "count=0 after reset");
    return 0;
}

fn test_profile_scope() {
    var start = profile_begin();
    var sum = 0;
    for (var i = 0; i < 10000; i = i + 1) { sum = sum + i; }
    var dur = profile_end(start);
    assert(f64_gt(dur, F64_0) == 1, "profile scope duration > 0");
    return 0;
}

# ================================================================
# typed_buffer
# ================================================================
# test_typed_buffer.tcyr — pure-data tests for typed_buffer.cyr
# Ported from typed_buffer.rs tests (the alignment_check test + layout checks).
# GPU-backed tests live in test_phase0.tcyr.

# ================================================================
# Alignment predicate — mirrors is_multiple_of(16) from Rust
# ================================================================
fn _is_multiple_of_16(size) {
    if ((size & 15) == 0) { return 1; }
    return 0;
}

fn test_alignment_predicate() {
    assert_eq(_is_multiple_of_16(16), 1, "16 aligned");
    assert_eq(_is_multiple_of_16(32), 1, "32 aligned");
    assert_eq(_is_multiple_of_16(48), 1, "48 aligned");
    assert_eq(_is_multiple_of_16(64), 1, "64 aligned");
    assert_eq(_is_multiple_of_16(128), 1, "128 aligned");
    assert_eq(_is_multiple_of_16(12), 0, "12 not aligned");
    assert_eq(_is_multiple_of_16(1),  0, "1 not aligned");
    assert_eq(_is_multiple_of_16(15), 0, "15 not aligned");
    assert_eq(_is_multiple_of_16(17), 0, "17 not aligned");
    return 0;
}

# ================================================================
# Error-path tests — uniform_buffer_new validation without touching GPU
# ================================================================
#
# We can exercise the validation branches of uniform_buffer_new by passing
# size=0 and size=12. The function only hits the GPU creation path after
# validation passes, so these return Err(...) without any device call.
# Pass device=0, queue=0, data=0 — unreachable past the early returns.

# Re-implement the validation path standalone (can't include typed_buffer.cyr
# without pulling in the wgpu FFI function table, which only exists in the
# object-mode GPU test binary).
fn _validate_uniform_size(size) {
    if (size == 0) {
        return gpu_err_result_msg(GPU_ERR_BUFFER, "uniform buffer size is zero");
    }
    if ((size & 15) != 0) {
        return gpu_err_result_msg(GPU_ERR_BUFFER, "uniform buffer size must be multiple of 16");
    }
    return gpu_ok(size);
}

fn test_uniform_size_zero_rejected() {
    var r = _validate_uniform_size(0);
    assert_eq(is_err_result(r), 1, "size=0 → Err");
    var e = payload(r);
    assert_eq(gpu_err_code(e), GPU_ERR_BUFFER, "code=GPU_ERR_BUFFER");
    return 0;
}

fn test_uniform_size_unaligned_rejected() {
    var r = _validate_uniform_size(12);
    assert_eq(is_err_result(r), 1, "size=12 → Err");
    var e = payload(r);
    assert_eq(gpu_err_code(e), GPU_ERR_BUFFER, "code=GPU_ERR_BUFFER");
    return 0;
}

fn test_uniform_size_16_accepted() {
    var r = _validate_uniform_size(16);
    assert_eq(is_ok(r), 1, "size=16 → Ok");
    assert_eq(payload(r), 16, "payload preserved");
    return 0;
}

fn test_uniform_size_32_accepted() {
    var r = _validate_uniform_size(32);
    assert_eq(is_ok(r), 1, "size=32 → Ok");
    return 0;
}

fn test_uniform_size_48_accepted() {
    var r = _validate_uniform_size(48);
    assert_eq(is_ok(r), 1, "size=48 → Ok");
    return 0;
}

fn test_uniform_size_64_accepted() {
    var r = _validate_uniform_size(64);
    assert_eq(is_ok(r), 1, "size=64 → Ok");
    return 0;
}

# ================================================================
# Storage buffer capacity math
# ================================================================
fn _capacity(count, element_size) { return count * element_size; }

fn test_storage_capacity_math() {
    assert_eq(_capacity(8, 4),    32, "8 × f32 = 32 bytes");
    assert_eq(_capacity(256, 4),  1024, "256 × f32 = 1024 bytes");
    assert_eq(_capacity(16, 16),  256, "16 × vec4 = 256 bytes");
    assert_eq(_capacity(0, 4),    0, "0 × f32 = 0 bytes");
    return 0;
}

fn test_storage_write_capacity_check() {
    # Mirrors storage_buffer_write's capacity guard
    var stored_count = 8;
    assert_eq(4 > stored_count, 0, "write 4 into 8 OK");
    assert_eq(8 > stored_count, 0, "write 8 into 8 OK (at capacity)");
    assert_eq(9 > stored_count, 1, "write 9 into 8 rejected");
    assert_eq(16 > stored_count, 1, "write 16 into 8 rejected");
    return 0;
}

# ================================================================
# vertex
# ================================================================
# test_vertex.tcyr — tests for vertex.cyr and blend.cyr

fn test_vertex2d_size() {
    assert_eq(VERTEX_2D_SIZE, 32, "Vertex2D = 32 bytes");
    assert_eq(VERTEX_3D_SIZE, 48, "Vertex3D = 48 bytes");
    assert_eq(SKINNED_3D_SIZE, 96, "SkinnedVertex3D = 96 bytes");
    return 0;
}

fn test_vertex2d_new() {
    var v = vertex2d_new(F64_1, F64_0, F64_0, F64_1, F64_1, F64_1, F64_1, F64_1);
    # position[0] should be 1.0 as f32 = 0x3F800000
    assert_eq(load32(v), 0x3F800000, "v2d position.x = 1.0");
    # position[1] should be 0.0
    assert_eq(load32(v + 4), 0, "v2d position.y = 0.0");
    # color[0] should be 1.0
    assert_eq(load32(v + 16), 0x3F800000, "v2d color.r = 1.0");
    return 0;
}

fn test_vertex2d_write() {
    var buf[32];
    vertex2d_write(&buf, F64_HALF, F64_HALF, F64_0, F64_0, F64_1, F64_0, F64_0, F64_1);
    # position[0] should be 0.5 as f32 = 0x3F000000
    assert_eq(load32(&buf), 0x3F000000, "write position.x = 0.5");
    return 0;
}

fn test_vertex2d_attributes() {
    var attrs = vertex2d_attributes();
    assert(attrs != 0, "attributes allocated");
    # First attribute: format=Float32x2 (21), offset=0, location=0
    assert_eq(load32(attrs), WGPU_VERTEX_FORMAT_FLOAT32X2, "attr0 format");
    assert_eq(load64(attrs + 8), 0, "attr0 offset=0");
    assert_eq(load32(attrs + 16), 0, "attr0 location=0");
    # Third attribute: format=Float32x4 (23), offset=16, location=2
    assert_eq(load32(attrs + 48), WGPU_VERTEX_FORMAT_FLOAT32X4, "attr2 format");
    assert_eq(load64(attrs + 56), 16, "attr2 offset=16");
    assert_eq(load32(attrs + 64), 2, "attr2 location=2");
    return 0;
}

fn test_vertex_blend_opaque() {
    var bs = blend_state_new(BLEND_OPAQUE);
    # color.operation = Add (1)
    assert_eq(load32(bs), WGPU_BLEND_OP_ADD, "opaque color op=Add");
    # color.srcFactor = One (2)
    assert_eq(load32(bs + 4), WGPU_BLEND_FACTOR_ONE, "opaque src=One");
    # color.dstFactor = Zero (1)
    assert_eq(load32(bs + 8), WGPU_BLEND_FACTOR_ZERO, "opaque dst=Zero");
    return 0;
}

fn test_vertex_blend_alpha() {
    var bs = blend_state_new(BLEND_ALPHA_BLEND);
    # color.srcFactor = SrcAlpha (5)
    assert_eq(load32(bs + 4), WGPU_BLEND_FACTOR_SRC_ALPHA, "alpha src=SrcAlpha");
    # color.dstFactor = OneMinusSrcAlpha (6)
    assert_eq(load32(bs + 8), WGPU_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA, "alpha dst=1-SrcAlpha");
    return 0;
}

# ================================================================
# state
# ================================================================
# test_state.tcyr — pure-data tests for blend, sampler, depth
# Ported from the Rust v1.0.0 {blend,sampler,depth}.rs tests — see git tag 1.0.0.
# All three modules produce byte layouts for wgpu descriptor structs, so
# the tests verify the layouts independently of any GPU device.

# NB: sampler.cyr and depth.cyr use wgpu_descriptors.cyr::wgpu_string_view

# ================================================================
# blend.cyr — preset byte layouts
#
# Layout (24 bytes): color (12) + alpha (12)
# Each component is { op (u32), srcFactor (u32), dstFactor (u32) }
# ================================================================

fn _u32_at(ptr, off) { return load32(ptr + off); }

fn test_blend_opaque() {
    var bs = blend_state_new(BLEND_OPAQUE);
    # color: op=ADD, src=ONE, dst=ZERO
    assert_eq(_u32_at(bs, 0),  WGPU_BLEND_OP_ADD,            "opaque color op");
    assert_eq(_u32_at(bs, 4),  WGPU_BLEND_FACTOR_ONE,        "opaque color src");
    assert_eq(_u32_at(bs, 8),  WGPU_BLEND_FACTOR_ZERO,       "opaque color dst");
    # alpha: op=ADD, src=ONE, dst=ZERO
    assert_eq(_u32_at(bs, 12), WGPU_BLEND_OP_ADD,            "opaque alpha op");
    assert_eq(_u32_at(bs, 16), WGPU_BLEND_FACTOR_ONE,        "opaque alpha src");
    assert_eq(_u32_at(bs, 20), WGPU_BLEND_FACTOR_ZERO,       "opaque alpha dst");
    return 0;
}

fn test_blend_alpha_blend() {
    var bs = blend_state_new(BLEND_ALPHA_BLEND);
    # color: src=SrcAlpha, dst=OneMinusSrcAlpha
    assert_eq(_u32_at(bs, 4),  WGPU_BLEND_FACTOR_SRC_ALPHA,            "alpha color src");
    assert_eq(_u32_at(bs, 8),  WGPU_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,  "alpha color dst");
    # alpha channel: src=ONE, dst=OneMinusSrcAlpha
    assert_eq(_u32_at(bs, 16), WGPU_BLEND_FACTOR_ONE,                  "alpha alpha src");
    assert_eq(_u32_at(bs, 20), WGPU_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,  "alpha alpha dst");
    return 0;
}

fn test_blend_premultiplied() {
    var bs = blend_state_new(BLEND_PREMULTIPLIED_ALPHA);
    assert_eq(_u32_at(bs, 4),  WGPU_BLEND_FACTOR_ONE,                 "pma color src");
    assert_eq(_u32_at(bs, 8),  WGPU_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA, "pma color dst");
    assert_eq(_u32_at(bs, 16), WGPU_BLEND_FACTOR_ONE,                 "pma alpha src");
    assert_eq(_u32_at(bs, 20), WGPU_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA, "pma alpha dst");
    return 0;
}

fn test_blend_additive() {
    var bs = blend_state_new(BLEND_ADDITIVE);
    assert_eq(_u32_at(bs, 4),  WGPU_BLEND_FACTOR_ONE, "additive color src");
    assert_eq(_u32_at(bs, 8),  WGPU_BLEND_FACTOR_ONE, "additive color dst");
    assert_eq(_u32_at(bs, 16), WGPU_BLEND_FACTOR_ONE, "additive alpha src");
    assert_eq(_u32_at(bs, 20), WGPU_BLEND_FACTOR_ONE, "additive alpha dst");
    return 0;
}

fn test_blend_multiply() {
    var bs = blend_state_new(BLEND_MULTIPLY);
    assert_eq(_u32_at(bs, 4),  WGPU_BLEND_FACTOR_DST,       "multiply color src");
    assert_eq(_u32_at(bs, 8),  WGPU_BLEND_FACTOR_ZERO,      "multiply color dst");
    assert_eq(_u32_at(bs, 16), WGPU_BLEND_FACTOR_DST_ALPHA, "multiply alpha src");
    assert_eq(_u32_at(bs, 20), WGPU_BLEND_FACTOR_ZERO,      "multiply alpha dst");
    return 0;
}

# ================================================================
# sampler.cyr — preset byte layouts
#
# Layout (64 bytes, rounded up from the 56-byte WGPUSamplerDescriptor):
#   +36: magFilter
#   +40: minFilter
#   +44: mipmapFilter
#   +56: compare
#   +60: maxAnisotropy (u16)
# ================================================================

fn test_sampler_nearest() {
    var d = sampler_descriptor(SAMPLER_NEAREST);
    assert_eq(_u32_at(d, 36), WGPU_FILTER_MODE_NEAREST,     "nearest mag");
    assert_eq(_u32_at(d, 40), WGPU_FILTER_MODE_NEAREST,     "nearest min");
    assert_eq(_u32_at(d, 44), WGPU_MIPMAP_FILTER_NEAREST,   "nearest mip");
    return 0;
}

fn test_sampler_linear() {
    var d = sampler_descriptor(SAMPLER_LINEAR);
    assert_eq(_u32_at(d, 36), WGPU_FILTER_MODE_LINEAR,    "linear mag");
    assert_eq(_u32_at(d, 40), WGPU_FILTER_MODE_LINEAR,    "linear min");
    assert_eq(_u32_at(d, 44), WGPU_MIPMAP_FILTER_LINEAR,  "linear mip");
    return 0;
}

fn test_sampler_anisotropic() {
    var d = sampler_descriptor(SAMPLER_ANISOTROPIC);
    assert_eq(_u32_at(d, 36), WGPU_FILTER_MODE_LINEAR,    "aniso mag");
    assert_eq(_u32_at(d, 40), WGPU_FILTER_MODE_LINEAR,    "aniso min");
    assert_eq(_u32_at(d, 44), WGPU_MIPMAP_FILTER_LINEAR,  "aniso mip");
    # maxAnisotropy is a u16 at offset 60
    assert_eq(load16(d + 60), 16, "aniso maxAnisotropy=16");
    return 0;
}

fn test_sampler_comparison() {
    var d = sampler_descriptor(SAMPLER_COMPARISON);
    assert_eq(_u32_at(d, 36), WGPU_FILTER_MODE_LINEAR,   "cmp mag");
    assert_eq(_u32_at(d, 40), WGPU_FILTER_MODE_LINEAR,   "cmp min");
    assert_eq(_u32_at(d, 44), WGPU_MIPMAP_FILTER_NEAREST, "cmp mip");
    assert_eq(_u32_at(d, 56), WGPU_COMPARE_LESS_EQUAL,   "cmp func");
    return 0;
}

fn test_sampler_address_mode_clamp() {
    var d = sampler_descriptor(SAMPLER_LINEAR);
    assert_eq(_u32_at(d, 24), WGPU_ADDRESS_MODE_CLAMP_TO_EDGE, "u mode=clamp");
    assert_eq(_u32_at(d, 28), WGPU_ADDRESS_MODE_CLAMP_TO_EDGE, "v mode=clamp");
    assert_eq(_u32_at(d, 32), WGPU_ADDRESS_MODE_CLAMP_TO_EDGE, "w mode=clamp");
    return 0;
}

# ================================================================
# depth.cyr — format constants + DepthTexture struct
# ================================================================

fn test_depth_format_constants() {
    # wgpu-native v29 format codes
    assert_eq(DEPTH_FORMAT_DEPTH32_FLOAT, 0x30, "Depth32Float format code (v29=0x30)");
    assert_eq(DEPTH_FORMAT_DEPTH24_PLUS_STENCIL8, 0x2F, "Depth24PlusStencil8 code (v29=0x2F)");
    assert_eq(DEPTH_DEFAULT_FORMAT, DEPTH_FORMAT_DEPTH32_FLOAT, "default is Depth32Float");
    return 0;
}

fn test_depth_stencil_state_layout() {
    var s[80];
    memset(&s, 0, 72);
    depth_stencil_state(&s, DEPTH_FORMAT_DEPTH32_FLOAT);
    # format at +8
    assert_eq(load32(&s + 8),  DEPTH_FORMAT_DEPTH32_FLOAT, "format stored");
    # depthWriteEnabled = OptionalBool_True = 2 at +12
    assert_eq(load32(&s + 12), 2, "depthWriteEnabled=True");
    # depthCompare = LESS at +16
    assert_eq(load32(&s + 16), WGPU_COMPARE_LESS, "depthCompare=LESS");
    # stencilReadMask = 0xFFFFFFFF at +52
    assert_eq(load32(&s + 52), 0xFFFFFFFF, "stencilReadMask");
    # stencilWriteMask = 0xFFFFFFFF at +56
    assert_eq(load32(&s + 56), 0xFFFFFFFF, "stencilWriteMask");
    return 0;
}

fn test_depth_texture_accessors() {
    # Construct the DepthTexture struct directly — depth_texture_new calls
    # into the FFI layer, which isn't available in a standalone test.
    # Layout (40 bytes): handle(8) | view(8) | format(u32@16) | w(8@24) | h(8@32)
    var dt = alloc(40);
    store64(dt, 0);
    store64(dt + 8, 0);
    store32(dt + 16, DEPTH_FORMAT_DEPTH32_FLOAT);
    store64(dt + 24, 1920);
    store64(dt + 32, 1080);

    assert_eq(depth_texture_width(dt),  1920, "width stored");
    assert_eq(depth_texture_height(dt), 1080, "height stored");
    assert_eq(depth_texture_format(dt), DEPTH_FORMAT_DEPTH32_FLOAT, "format stored");
    return 0;
}

# ================================================================
# caches
# ================================================================
# test_caches.tcyr — pure-data tests for the three cache modules
# Ported from the Rust v1.0.0 {shader,pipeline_cache,bind_group_cache}.rs
# tests — see git tag 1.0.0.
#
# All three are hashmap wrappers + (for shader) an FNV-1a hash. None of the
# cache logic touches the GPU, so these run entirely standalone. The
# shader_cache_get_or_compile path is intentionally skipped because it calls
# into wgpu_device_create_shader_module.

# shader_cache, pipeline_cache, bind_group_cache all need wgpu_ffi only for
# the shader_cache_get_or_compile path. We skip that function by including
# just enough to compile the cache modules.

# ================================================================
# FNV-1a hash is deterministic
# ================================================================
fn test_shader_hash_deterministic() {
    var a = _shader_hash("@compute @workgroup_size(1) fn main() {}");
    var b = _shader_hash("@compute @workgroup_size(1) fn main() {}");
    assert_eq(a, b, "same input → same hash");
    return 0;
}

fn test_shader_hash_distinct() {
    var a = _shader_hash("fn a() {}");
    var b = _shader_hash("fn b() {}");
    assert(a != b, "different input → different hash");
    return 0;
}

fn test_shader_hash_empty_string() {
    var h = _shader_hash("");
    # FNV-1a empty → offset basis (14695981039346656037)
    assert(h != 0, "empty string gives offset basis");
    return 0;
}

fn test_shader_hash_single_char_variance() {
    var a = _shader_hash("a");
    var b = _shader_hash("b");
    var c = _shader_hash("aa");
    assert(a != b, "a != b");
    assert(a != c, "a != aa");
    return 0;
}

# ================================================================
# shader_cache get/set round-trip (no GPU)
# ================================================================
fn test_shader_cache_miss() {
    var cache = shader_cache_new();
    var handle = shader_cache_get(cache, "not in cache");
    assert_eq(handle, 0, "miss returns 0");
    return 0;
}

fn test_shader_cache_set_and_get() {
    var cache = shader_cache_new();
    # Use a non-zero sentinel for the module handle so we can distinguish it
    # from the "miss = 0" return.
    var fake_module = 0xdeadbeef;
    shader_cache_set(cache, "@compute fn x() {}", fake_module);
    var got = shader_cache_get(cache, "@compute fn x() {}");
    assert_eq(got, fake_module, "round-trip handle");
    return 0;
}

fn test_shader_cache_distinct_keys() {
    var cache = shader_cache_new();
    shader_cache_set(cache, "shader a", 111);
    shader_cache_set(cache, "shader b", 222);
    assert_eq(shader_cache_get(cache, "shader a"), 111, "a preserved");
    assert_eq(shader_cache_get(cache, "shader b"), 222, "b preserved");
    return 0;
}

fn test_shader_cache_update_overwrites() {
    var cache = shader_cache_new();
    shader_cache_set(cache, "same key", 100);
    shader_cache_set(cache, "same key", 200);
    assert_eq(shader_cache_get(cache, "same key"), 200, "newer value wins");
    return 0;
}

# ================================================================
# pipeline_cache get/set round-trip
# ================================================================
fn test_pipeline_cache_miss() {
    var cache = pipeline_cache_new();
    assert_eq(pipeline_cache_get(cache, 42),  0, "miss returns 0");
    assert_eq(pipeline_cache_has(cache, 42),  0, "has returns 0 on miss");
    return 0;
}

fn test_pipeline_cache_set_and_get() {
    var cache = pipeline_cache_new();
    pipeline_cache_set(cache, 42, 0xabcd);
    assert_eq(pipeline_cache_get(cache, 42), 0xabcd, "round-trip");
    assert_eq(pipeline_cache_has(cache, 42), 1, "has returns 1 after set");
    return 0;
}

fn test_pipeline_cache_distinct_keys() {
    var cache = pipeline_cache_new();
    pipeline_cache_set(cache, 1, 100);
    pipeline_cache_set(cache, 2, 200);
    pipeline_cache_set(cache, 99, 9900);
    assert_eq(pipeline_cache_get(cache, 1),  100, "key 1");
    assert_eq(pipeline_cache_get(cache, 2),  200, "key 2");
    assert_eq(pipeline_cache_get(cache, 99), 9900, "key 99");
    return 0;
}

fn test_pipeline_cache_large_key() {
    var cache = pipeline_cache_new();
    # Large u64-ish key (fits in i64 signed range)
    var big = 0x7FFFFFFFFFFFFFFF;
    pipeline_cache_set(cache, big, 7);
    assert_eq(pipeline_cache_get(cache, big), 7, "max i64 key round-trip");
    return 0;
}

# ================================================================
# bind_group_cache get/set/has
# ================================================================
fn test_bind_group_cache_miss() {
    var cache = bind_group_cache_new();
    assert_eq(bind_group_cache_get(cache, 0x100), 0, "miss returns 0");
    assert_eq(bind_group_cache_has(cache, 0x100), 0, "has false on miss");
    return 0;
}

fn test_bind_group_cache_set_and_get() {
    var cache = bind_group_cache_new();
    bind_group_cache_set(cache, 0x100, 0xbeef);
    assert_eq(bind_group_cache_get(cache, 0x100), 0xbeef, "round-trip");
    assert_eq(bind_group_cache_has(cache, 0x100), 1, "has true after set");
    return 0;
}

fn test_bind_group_cache_distinct() {
    var cache = bind_group_cache_new();
    bind_group_cache_set(cache, 1, 11);
    bind_group_cache_set(cache, 2, 22);
    bind_group_cache_set(cache, 3, 33);
    assert_eq(bind_group_cache_get(cache, 1), 11, "1 → 11");
    assert_eq(bind_group_cache_get(cache, 2), 22, "2 → 22");
    assert_eq(bind_group_cache_get(cache, 3), 33, "3 → 33");
    return 0;
}

fn test_bind_group_cache_clear_returns_fresh() {
    var cache = bind_group_cache_new();
    bind_group_cache_set(cache, 42, 0xdead);
    var fresh = bind_group_cache_clear(cache);
    # Note: bind_group_cache_clear returns a *new* empty map rather than
    # mutating the existing one (hashmap.cyr has no iter-with-remove).
    assert_eq(bind_group_cache_get(fresh, 42), 0, "cleared cache is empty");
    return 0;
}

# ================================================================
# surface
# ================================================================
# test_surface.tcyr — pure-data tests for surface.cyr
# Ported from the Rust v1.0.0 surface.rs tests — see git tag 1.0.0.
# Skips any tests that need a
# real WGPUSurface handle (no windowing system in a standalone test).

# surface.cyr references wgpu_surface_configure etc. which live in
# wgpu_ffi.cyr. We can't pull wgpu_ffi in here without the function table,
# so we inline just the constants + pure helpers we want to test.

# ================================================================
# Present mode preferences — copied from surface.cyr
# ================================================================
var PRESENT_VSYNC     = 0;
var PRESENT_NO_VSYNC  = 1;
var PRESENT_IMMEDIATE = 2;
var PRESENT_MAILBOX   = 3;

# WGPUPresentMode v29 values
var WGPU_PRESENT_MODE_FIFO         = 1;
var WGPU_PRESENT_MODE_FIFO_RELAXED = 2;
var WGPU_PRESENT_MODE_IMMEDIATE    = 3;
var WGPU_PRESENT_MODE_MAILBOX      = 4;

fn present_mode_to_wgpu(pref) {
    if (pref == PRESENT_VSYNC)     { return WGPU_PRESENT_MODE_FIFO; }
    if (pref == PRESENT_NO_VSYNC)  { return WGPU_PRESENT_MODE_FIFO_RELAXED; }
    if (pref == PRESENT_IMMEDIATE) { return WGPU_PRESENT_MODE_IMMEDIATE; }
    if (pref == PRESENT_MAILBOX)   { return WGPU_PRESENT_MODE_MAILBOX; }
    return WGPU_PRESENT_MODE_FIFO;
}

# ================================================================
# Tests
# ================================================================

fn test_present_mode_constants() {
    # Verify the v29 enum values (these must match wgpu-native webgpu.h)
    assert_eq(WGPU_PRESENT_MODE_FIFO,         1, "Fifo=1");
    assert_eq(WGPU_PRESENT_MODE_FIFO_RELAXED, 2, "FifoRelaxed=2");
    assert_eq(WGPU_PRESENT_MODE_IMMEDIATE,    3, "Immediate=3");
    assert_eq(WGPU_PRESENT_MODE_MAILBOX,      4, "Mailbox=4");
    return 0;
}

fn test_present_mode_mapping() {
    assert_eq(present_mode_to_wgpu(PRESENT_VSYNC),     WGPU_PRESENT_MODE_FIFO,         "vsync → fifo");
    assert_eq(present_mode_to_wgpu(PRESENT_NO_VSYNC),  WGPU_PRESENT_MODE_FIFO_RELAXED, "no vsync → relaxed");
    assert_eq(present_mode_to_wgpu(PRESENT_IMMEDIATE), WGPU_PRESENT_MODE_IMMEDIATE,    "immediate");
    assert_eq(present_mode_to_wgpu(PRESENT_MAILBOX),   WGPU_PRESENT_MODE_MAILBOX,      "mailbox");
    # Unknown preference should default to Fifo
    assert_eq(present_mode_to_wgpu(99), WGPU_PRESENT_MODE_FIFO, "unknown → fifo");
    return 0;
}

# ================================================================
# WGPUSurfaceConfiguration descriptor layout test
# ================================================================
# Mirrors surface_state_configure's descriptor building without needing
# the FFI function table to be populated.
fn test_surface_configuration_layout() {
    var fake_device  = 0xdeadbeef;
    var usage        = WGPU_TEXTURE_USAGE_RENDER_ATTACHMENT;
    var cfg = wgpu_surface_configuration(fake_device,
    WGPU_TEXTURE_FORMAT_BGRA8_UNORM,
    1920, 1080, usage,
    WGPU_PRESENT_MODE_FIFO);
    assert_eq(load64(cfg + 8),  fake_device,                    "device stored");
    assert_eq(load32(cfg + 16), WGPU_TEXTURE_FORMAT_BGRA8_UNORM, "format stored");
    assert_eq(load64(cfg + 24), usage,                          "usage stored");
    assert_eq(load32(cfg + 32), 1920,                           "width stored");
    assert_eq(load32(cfg + 36), 1080,                           "height stored");
    assert_eq(load64(cfg + 40), 0,                              "viewFormatCount=0");
    assert_eq(load64(cfg + 48), 0,                              "viewFormats=NULL");
    assert_eq(load32(cfg + 56), 0,                              "alphaMode=Auto(0)");
    assert_eq(load32(cfg + 60), WGPU_PRESENT_MODE_FIFO,         "presentMode stored");
    return 0;
}

fn test_surface_configuration_zero_init() {
    # A second build should produce a fresh struct with no leakage.
    var cfg1 = wgpu_surface_configuration(0, WGPU_TEXTURE_FORMAT_RGBA8_UNORM, 100, 200,
    WGPU_TEXTURE_USAGE_RENDER_ATTACHMENT,
    WGPU_PRESENT_MODE_FIFO_RELAXED);
    var cfg2 = wgpu_surface_configuration(0, WGPU_TEXTURE_FORMAT_RGBA8_UNORM, 300, 400,
    WGPU_TEXTURE_USAGE_RENDER_ATTACHMENT,
    WGPU_PRESENT_MODE_IMMEDIATE);
    assert_eq(load32(cfg1 + 32), 100, "cfg1 width=100");
    assert_eq(load32(cfg1 + 36), 200, "cfg1 height=200");
    assert_eq(load32(cfg2 + 32), 300, "cfg2 width=300");
    assert_eq(load32(cfg2 + 36), 400, "cfg2 height=400");
    assert_eq(load32(cfg1 + 60), WGPU_PRESENT_MODE_FIFO_RELAXED, "cfg1 present mode");
    assert_eq(load32(cfg2 + 60), WGPU_PRESENT_MODE_IMMEDIATE,    "cfg2 present mode");
    return 0;
}

# ================================================================
# audit-2026-04-19 — regression tests for HIGH / MEDIUM findings
# ================================================================
# Each test asserts a fix from docs/audit/2026-04-19-audit.md.

# HIGH-1: the renamed present helper exists (and the accessor returns
# the configured mode, not the garbage the old shadow left behind).
fn test_audit_surface_present_accessor() {
    var ss = alloc(48);
    memset(ss, 0, 48);
    store32(ss + 40, WGPU_PRESENT_MODE_MAILBOX);
    assert_eq(surface_state_present(ss), WGPU_PRESENT_MODE_MAILBOX,
    "surface_state_present reads configured mode");
    return 0;
}

# HIGH-2: rpb_new's allocation is large enough for the label slot at +76.
# Writing then reading back the label must round-trip.
fn test_audit_rpb_label_fits() {
    var b = rpb_new(0, 0, 0);
    rpb_label(b, "audit-label");
    assert_eq(load64(b + 76), "audit-label", "rpb_label round-trips");
    return 0;
}

# MED-1: workgroups_1d returns 0 on workgroup_size == 0 (no SIGFPE).
fn test_audit_workgroups_1d_zero_divisor() {
    assert_eq(workgroups_1d(42, 0), 0, "workgroups_1d(_, 0) returns 0");
    return 0;
}

fn test_audit_workgroups_2d_zero_divisor() {
    var out[16];
    store64(&out, 999);
    store64(&out + 8, 999);
    workgroups_2d(&out, 10, 10, 0, 4);
    assert_eq(load64(&out), 0, "wg_x=0 leaves x zeroed");
    workgroups_2d(&out, 10, 10, 4, 0);
    assert_eq(load64(&out + 8), 0, "wg_y=0 leaves y zeroed");
    return 0;
}

# MED-2: growable_buffer's cap*2 guard — we can't reach the overflow
# at runtime without a real device, but the math is exercised by
# seeding a synthetic struct with a near-boundary cap and calling the
# public accessor path. If the guard compiles and links, the fix shipped.
fn test_audit_growable_buffer_accessors() {
    var gb = alloc(32);
    store64(gb,      0);
    store64(gb + 8,  0x4000000000000000);   # cap near the overflow boundary
    store64(gb + 16, 0);
    store64(gb + 24, 0);
    assert_eq(growable_buffer_capacity(gb), 0x4000000000000000,
    "growable_buffer_capacity round-trip");
    return 0;
}

# MED-4: storage_buffer_write rejects write_count * element_size overflow.
# We seed a wrapper with count = 4, element_size = i64_max/3 (overflows on *4).
fn test_audit_storage_buffer_write_overflow() {
    var sb = storage_buffer_wrap_raw(1, 64, 4, 0x7FFFFFFFFFFFFFFF / 3);
    var res = storage_buffer_write(0, sb, 0, 4);
    assert_eq(is_err_result(res), 1, "storage_buffer_write rejects overflow");
    return 0;
}

# MED-5: storage_buffer_wrap rejects inconsistent (capacity, count, element_size)
# by zeroing element_size to 1. An inconsistent wrap at (cap=64, count=16,
# elem=8) requires 128 bytes > 64 cap → elem gets clamped to 1.
fn test_audit_storage_buffer_wrap_consistency() {
    var sb = storage_buffer_wrap(1, 64, 16, 8);
    assert_eq(storage_buffer_element_size(sb), 1,
    "wrap clamps element_size on capacity violation");
    return 0;
}

# A valid wrap keeps the element_size intact.
fn test_audit_storage_buffer_wrap_valid() {
    var sb = storage_buffer_wrap(1, 64, 8, 8);
    assert_eq(storage_buffer_element_size(sb), 8,
    "wrap preserves element_size when consistent");
    return 0;
}

# MED-3: texture_upload_rgba8 short-circuits on zero/negative dimensions.
# We can't hit wgpu without a GPU, but calling with w=0 must return 0
# without segfaulting on the (0,0,1) extent.
fn test_audit_texture_upload_zero_dim() {
    # queue=0, texture=0 — never reached because we short-circuit first.
    assert_eq(texture_upload_rgba8(0, 0, 0, 0, 10), 0,
    "upload(0×10) short-circuits");
    assert_eq(texture_upload_rgba8(0, 0, 0, 10, 0), 0,
    "upload(10×0) short-circuits");
    assert_eq(texture_upload_rgba8(0, 0, 0, -1, 10), 0,
    "upload(-1×10) rejected");
    return 0;
}

# LOW-1: GpuCapabilities comment said 128 bytes but alloc was 120 — a
# reader writing a new field at +120 would clobber the next heap slab.
# Exercise the last documented field to pin the layout.
fn test_audit_gpu_caps_last_field_at_112() {
    var c = gpu_caps_new();
    gpu_caps_set_multi_draw(c, 1);
    assert_eq(gpu_caps_multi_draw_indirect(c), 1,
    "multi_draw_indirect persists at +112 within 120-byte alloc");
    return 0;
}

# LOW-2: read_buffer enforces a size cap and rejects bad sizes before
# allocating a staging buffer or host memory. A zero/negative size must
# return 0 unconditionally; a size exceeding the cap must do likewise.
fn test_audit_read_buffer_zero_size_rejected() {
    assert_eq(read_buffer_capped(0, 0, 0, 0, 1024), 0,
    "read_buffer_capped(size=0) returns 0");
    assert_eq(read_buffer_capped(0, 0, 0, -1, 1024), 0,
    "read_buffer_capped(size<0) returns 0");
    return 0;
}

fn test_audit_read_buffer_exceeds_cap_rejected() {
    assert_eq(read_buffer_capped(0, 0, 0, 2048, 1024), 0,
    "read_buffer_capped(size>cap) returns 0");
    return 0;
}

# LOW-3: compute_dispatch and texture_create_rgba8 reject inputs that
# exceed WebGPU spec-default limits before reaching wgpu-native.
# compute_dispatch takes a dims_xyz pointer (3 packed u32) to stay at 5
# parameters — see the note in src/compute.cyr.
fn test_audit_compute_dispatch_zero_dim_rejected() {
    var d0x[12]; store32(&d0x, 0); store32(&d0x + 4, 1); store32(&d0x + 8, 1);
    var d0y[12]; store32(&d0y, 1); store32(&d0y + 4, 0); store32(&d0y + 8, 1);
    var d0z[12]; store32(&d0z, 1); store32(&d0z + 4, 1); store32(&d0z + 8, 0);
    assert_eq(compute_dispatch(0, 0, 0, 0, &d0x), 0,
    "compute_dispatch(x=0) short-circuits");
    assert_eq(compute_dispatch(0, 0, 0, 0, &d0y), 0,
    "compute_dispatch(y=0) short-circuits");
    assert_eq(compute_dispatch(0, 0, 0, 0, &d0z), 0,
    "compute_dispatch(z=0) short-circuits");
    return 0;
}

fn test_audit_compute_dispatch_exceeds_max_rejected() {
    var dmax[12]; store32(&dmax, 70000); store32(&dmax + 4, 1); store32(&dmax + 8, 1);
    assert_eq(compute_dispatch(0, 0, 0, 0, &dmax), 0,
    "compute_dispatch(x>MAX) short-circuits");
    return 0;
}

fn test_audit_texture_create_exceeds_max_rejected() {
    assert_eq(texture_create_rgba8(0, 9000, 256, "too-wide"), 0,
    "texture_create_rgba8(width>MAX) returns 0");
    assert_eq(texture_create_rgba8(0, 256, 9000, "too-tall"), 0,
    "texture_create_rgba8(height>MAX) returns 0");
    return 0;
}

# LOW-4: _wgpu_strnlen caps at the supplied bound. A normal short
# string returns its actual length; a max-length probe must not
# overshoot.
fn test_audit_strnlen_short_string() {
    assert_eq(_wgpu_strnlen("hello", 4096), 5,
    "_wgpu_strnlen returns actual length when below bound");
    return 0;
}

fn test_audit_strnlen_caps_at_max() {
    # 4096 bytes of 'A' followed by a NUL — capped at 100.
    var buf[4097];
    var i = 0;
    while (i < 4096) { store8(&buf + i, 65); i = i + 1; }
    store8(&buf + 4096, 0);
    assert_eq(_wgpu_strnlen(&buf, 100), 100,
    "_wgpu_strnlen caps at the supplied bound");
    return 0;
}

# LOW-5: compute_pipeline_new rejects nonsensical storage_count without
# leaking GPU handles. Resource cleanup on mid-construction failures is
# tested indirectly: any device=0 / wgsl="" call must return 0 cleanly.
fn test_audit_compute_pipeline_zero_storage_rejected() {
    assert_eq(compute_pipeline_new(0, "", "main", 0), 0,
    "compute_pipeline_new(storage_count=0) returns 0");
    assert_eq(compute_pipeline_new(0, "", "main", -1), 0,
    "compute_pipeline_new(storage_count<0) returns 0");
    return 0;
}

# LOW-6: _clamp_unit folds out-of-range f64 components to [0.0, 1.0]
# before the u8 conversion so wrapping arithmetic can't produce a
# garbage edge pixel.
fn test_audit_clamp_unit_in_range() {
    assert_eq(_clamp_unit(F64_0), F64_0, "_clamp_unit(0.0) = 0.0");
    assert_eq(_clamp_unit(F64_1), F64_1, "_clamp_unit(1.0) = 1.0");
    return 0;
}

fn test_audit_clamp_unit_above_one() {
    assert_eq(_clamp_unit(f64_from(2)), F64_1,
    "_clamp_unit(2.0) clamps to 1.0");
    return 0;
}

fn test_audit_clamp_unit_below_zero() {
    var neg = f64_from(0);
    neg = f64_sub(F64_0, F64_1);   # -1.0
    assert_eq(_clamp_unit(neg), F64_0,
    "_clamp_unit(-1.0) clamps to 0.0");
    return 0;
}

# ================================================================
# v2.4.2 — GPU runtime validation regressions
# ================================================================
# The following assertions guard the FFI descriptor / enum drift bugs
# caught when mabda v2.4.1 first exercised a real wgpu-native GPU on a
# Mesa/Vulkan Linux box. Each assertion is written so that reintroducing
# the bug (wrong enum value, wrong struct offset) fails the CPU suite
# immediately — no GPU required. See `docs/issues/2026-04-20-*` and the
# v2.4.2 CHANGELOG entry for the full narrative.

fn test_audit_buffer_binding_type_values() {
    # v29 renumbering: BindingNotUsed=0 was inserted, shifting every
    # subsequent value up by one. Pre-fix, STORAGE was mistakenly 2
    # and the runtime treated storage bindings as uniform bindings.
    assert_eq(WGPU_BUFFER_BINDING_TYPE_BINDING_NOT_USED, 0,
    "BufferBindingType BindingNotUsed = 0 (v29)");
    assert_eq(WGPU_BUFFER_BINDING_TYPE_UNDEFINED, 1,
    "BufferBindingType Undefined = 1 (v29)");
    assert_eq(WGPU_BUFFER_BINDING_TYPE_UNIFORM, 2,
    "BufferBindingType Uniform = 2 (v29)");
    assert_eq(WGPU_BUFFER_BINDING_TYPE_STORAGE, 3,
    "BufferBindingType Storage = 3 (v29)");
    assert_eq(WGPU_BUFFER_BINDING_TYPE_READ_ONLY_STORAGE, 4,
    "BufferBindingType ReadOnlyStorage = 4 (v29)");
    return 0;
}

fn test_audit_load_op_values() {
    # Pre-fix these were swapped (CLEAR=1, LOAD=2) — render passes
    # flipped clear/load semantics silently.
    assert_eq(WGPU_LOAD_OP_UNDEFINED, 0, "LoadOp Undefined = 0 (v29)");
    assert_eq(WGPU_LOAD_OP_LOAD, 1, "LoadOp Load = 1 (v29)");
    assert_eq(WGPU_LOAD_OP_CLEAR, 2, "LoadOp Clear = 2 (v29)");
    assert_eq(WGPU_STORE_OP_UNDEFINED, 0, "StoreOp Undefined = 0 (v29)");
    assert_eq(WGPU_STORE_OP_STORE, 1, "StoreOp Store = 1 (v29)");
    assert_eq(WGPU_STORE_OP_DISCARD, 2, "StoreOp Discard = 2 (v29)");
    return 0;
}

fn test_audit_color_attachment_size_72() {
    # v29 WGPURenderPassColorAttachment is 72 bytes (nextInChain@0,
    # view@8, depthSlice@16+pad, resolveTarget@24, loadOp@32, storeOp@36,
    # clearValue@40). Pre-fix, mabda had COLOR_ATTACHMENT_SIZE = 64 and
    # was writing view@0 / loadOp@24 / storeOp@28 / clearValue@32 —
    # everything off by 8 and the total size wrong by 8 too.
    assert_eq(COLOR_ATTACHMENT_SIZE, 72,
    "COLOR_ATTACHMENT_SIZE matches v29 WGPURenderPassColorAttachment (72)");
    return 0;
}

fn test_audit_rpb_pass_color_offsets() {
    # After rpb_pass_color writes an attachment, every field must land at
    # its v29 offset so the C shim can pass the array through without
    # repacking. clearColor should be the opaque red we passed.
    var rpb = rpb_pass_new();
    var clear = color_new(F64_1, F64_0, F64_0, F64_1);  # (1.0, 0.0, 0.0, 1.0)
    rpb_pass_color(rpb, 0xDEADBEEFCAFEBABE, clear);
    assert_eq(rpb_pass_color_count(rpb), 1, "one color attachment recorded");
    var arr = rpb_pass_color_array(rpb);
    assert_neq(arr, 0, "color array allocated");
    assert_eq(load64(arr), 0, "att.nextInChain @ +0 is 0");
    assert_eq(load64(arr + 8), 0xDEADBEEFCAFEBABE, "att.view @ +8");
    assert_eq(load32(arr + 16), 0xFFFFFFFF,
    "att.depthSlice @ +16 = WGPU_DEPTH_SLICE_UNDEFINED");
    assert_eq(load64(arr + 24), 0,
    "att.resolveTarget @ +24 is 0 when no MSAA");
    assert_eq(load32(arr + 32), WGPU_LOAD_OP_CLEAR, "att.loadOp @ +32 = Clear");
    assert_eq(load32(arr + 36), WGPU_STORE_OP_STORE, "att.storeOp @ +36 = Store");
    # clearValue is 4x f64 — just check r and a matched (1.0 bit-pattern).
    assert_eq(load64(arr + 40), F64_1, "att.clearValue.r @ +40 = 1.0");
    assert_eq(load64(arr + 40 + 24), F64_1,
    "att.clearValue.a @ +64 = 1.0 (opaque)");
    return 0;
}

fn test_audit_rpb_pass_begin_null_encoder() {
    # rpb_pass_begin must refuse a null encoder — otherwise the shim
    # fncalls into wgpu-native with a NULL handle and crashes inside
    # Device::create_command_encoder (see v2.4.2 audit).
    var rpb = rpb_pass_new();
    var clear = color_new(F64_1, F64_0, F64_0, F64_1);
    rpb_pass_color(rpb, 1, clear);
    assert_eq(rpb_pass_begin(0, rpb), 0,
    "rpb_pass_begin(0, rpb) short-circuits");
    return 0;
}

fn test_audit_rpb_pass_begin_empty_short_circuits() {
    # wgpu rejects render passes with zero color attachments when no
    # depth/stencil is attached either — our dispatcher short-circuits
    # to 0 before making that trip to the GPU.
    var rpb = rpb_pass_new();
    assert_eq(rpb_pass_begin(0xDEAD, rpb), 0,
    "rpb_pass_begin with empty builder short-circuits");
    return 0;
}

fn test_audit_render_target_rgba8_rejects_invalid() {
    # Same validation envelope as texture_create_rgba8 — 0/neg/>MAX are
    # rejected before reaching wgpu-native. v2.4.3 LOW.
    assert_eq(texture_create_render_target_rgba8(0, 0, 256, "w0"), 0,
    "render_target_rgba8(w=0) rejected");
    assert_eq(texture_create_render_target_rgba8(0, 256, 0, "h0"), 0,
    "render_target_rgba8(h=0) rejected");
    assert_eq(texture_create_render_target_rgba8(0, 9000, 256, "w>max"), 0,
    "render_target_rgba8(w>MAX) rejected");
    return 0;
}

# ================================================================
# v2.5.0 — render graph
# ================================================================

fn test_rg_new_initial_state() {
    var g = rg_new();
    assert_neq(g, 0, "rg_new allocates a graph");
    assert_eq(rg_node_count(g), 0, "new graph has no nodes");
    assert_eq(rg_transient_count(g), 0, "new graph has no transients");
    assert_eq(rg_is_built(g), 0, "new graph is not built");
    return 0;
}

fn test_rg_add_compute_returns_incrementing_ids() {
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    var n0 = rg_add_compute(g, 0, 0, &dims, "a");
    var n1 = rg_add_compute(g, 0, 0, &dims, "b");
    var n2 = rg_add_compute(g, 0, 0, &dims, "c");
    assert_eq(n0, 0, "first compute node id = 0");
    assert_eq(n1, 1, "second compute node id = 1");
    assert_eq(n2, 2, "third compute node id = 2");
    assert_eq(rg_node_count(g), 3, "node count reflects adds");
    return 0;
}

fn test_rg_add_render_and_copy_nodes() {
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    var r = rg_add_render(g, 0, 0, 0, "render");
    var c = rg_add_copy_buf_buf(g, 0, 0, 0, 0, 64);
    var k = rg_add_compute(g, 0, 0, &dims, "cmp");
    assert_eq(r, 0, "render node id");
    assert_eq(c, 1, "copy node id");
    assert_eq(k, 2, "compute node id");
    assert_eq(rg_node_count(g), 3, "three mixed-kind nodes");
    return 0;
}

fn test_rg_add_transient_buffer_incrementing_ids() {
    var g = rg_new();
    var r0 = rg_add_transient_buffer(g, 4096, 0x08, "r0");
    var r1 = rg_add_transient_buffer(g, 256,  0x04, "r1");
    assert_eq(r0, 0, "first transient id = 0");
    assert_eq(r1, 1, "second transient id = 1");
    assert_eq(rg_transient_count(g), 2, "two transients recorded");
    return 0;
}

fn test_rg_add_transient_texture() {
    var g = rg_new();
    var t0 = rg_add_transient_texture(g, 1920, 1080, 18, 0x10, "rt");
    assert_eq(t0, 0, "first transient texture id = 0");
    assert_eq(rg_transient_count(g), 1, "one transient recorded");
    return 0;
}

fn test_rg_node_reads_writes_guards_out_of_range() {
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    rg_add_compute(g, 0, 0, &dims, "n0");
    assert_eq(rg_node_reads(g, 0 - 1, 0), 0,
    "reads(-1, _) short-circuits");
    assert_eq(rg_node_reads(g, 99, 0), 0,
    "reads(out-of-range, _) short-circuits");
    assert_eq(rg_node_writes(g, 0 - 1, 0), 0,
    "writes(-1, _) short-circuits");
    assert_eq(rg_node_writes(g, 99, 0), 0,
    "writes(out-of-range, _) short-circuits");
    return 0;
}

fn test_rg_build_sets_built_flag() {
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    rg_add_compute(g, 0, 0, &dims, "n0");
    assert_eq(rg_build(g, 0), 0, "rg_build succeeds on trivial graph");
    assert_eq(rg_is_built(g), 1, "built flag set after rg_build");
    return 0;
}

fn test_rg_build_empty_graph_is_fine() {
    var g = rg_new();
    assert_eq(rg_build(g, 0), 0, "rg_build on empty graph returns 0");
    assert_eq(rg_is_built(g), 1, "built flag still set for empty graph");
    return 0;
}

fn test_rg_build_is_idempotent() {
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    rg_add_compute(g, 0, 0, &dims, "n0");
    rg_build(g, 0);
    assert_eq(rg_build(g, 0), 0,
    "second rg_build short-circuits to success");
    return 0;
}

fn test_rg_build_linear_chain_preserves_order() {
    # A writes r0, B reads r0 — sort order must be A, B.
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    var r0 = rg_add_transient_buffer(g, 64, 0x08, "r0");
    var a = rg_add_compute(g, 0, 0, &dims, "A");
    rg_node_writes(g, a, r0);
    var b = rg_add_compute(g, 0, 0, &dims, "B");
    rg_node_reads(g, b, r0);
    assert_eq(rg_build(g, 0), 0, "linear chain builds");
    # After rg_build, nodes[0].sort_idx == 0, nodes[1].sort_idx == 1.
    var nodes = load64(g + 0);
    assert_eq(load64(vec_get(nodes, 0) + 48), 0,
    "A sort_idx = 0");
    assert_eq(load64(vec_get(nodes, 1) + 48), 1,
    "B sort_idx = 1");
    return 0;
}

fn test_rg_build_diamond_shape() {
    # A writes r0; B and C both read r0; D reads r0 and depends on
    # both B and C indirectly via a write to r1 and r2 respectively.
    # For v2.5.0 insertion-order semantics, A is sort 0, then B/C in
    # insertion order, then D last.
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    var r0 = rg_add_transient_buffer(g, 64, 0x08, "r0");
    var a = rg_add_compute(g, 0, 0, &dims, "A");
    rg_node_writes(g, a, r0);
    var b = rg_add_compute(g, 0, 0, &dims, "B");
    rg_node_reads(g, b, r0);
    var c = rg_add_compute(g, 0, 0, &dims, "C");
    rg_node_reads(g, c, r0);
    var d = rg_add_compute(g, 0, 0, &dims, "D");
    rg_node_reads(g, d, r0);
    assert_eq(rg_build(g, 0), 0, "diamond graph builds");
    var nodes = load64(g + 0);
    assert_eq(load64(vec_get(nodes, 0) + 48), 0, "A first");
    # B, C, D ordering among themselves: all have in-degree 1 then
    # drop to 0 together once A drains; queue processes them in
    # insertion order B, C, D. Sort idx 1, 2, 3.
    assert_eq(load64(vec_get(nodes, 1) + 48), 1, "B second");
    assert_eq(load64(vec_get(nodes, 2) + 48), 2, "C third");
    assert_eq(load64(vec_get(nodes, 3) + 48), 3, "D last");
    return 0;
}

fn test_rg_execute_unbuilt_fails_fast() {
    # rg_execute must refuse a graph that hasn't been built yet.
    var g = rg_new();
    assert_eq(rg_execute(g, 0, 0), 1,
    "rg_execute on unbuilt graph returns 1 (error)");
    return 0;
}

fn test_rg_execute_null_device_fails_fast() {
    # After build, executing against a null device should return
    # non-zero (the inner wgpu_device_create_command_encoder returns
    # 0; rg_execute propagates the failure).
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    rg_add_compute(g, 0, 0, &dims, "n");
    rg_build(g, 0);
    # Without a real device fn-table, wgpu_device_create_command_encoder
    # returns 0 and rg_execute returns 1.
    assert_eq(rg_execute(g, 0, 0), 1,
    "rg_execute with null device returns 1");
    return 0;
}

fn test_rg_transient_handle_before_build_is_label_ptr() {
    # Before rg_build, the handle slot holds the label pointer (the
    # struct layout doubles the slot up as a staging area). This is
    # a load-bearing implementation detail documented in the module
    # header — the assertion guards against accidental refactors.
    var g = rg_new();
    var r = rg_add_transient_buffer(g, 64, 0x08, "label-str");
    # Before build, handle field holds the label pointer.
    assert_neq(rg_transient_handle(g, r), 0,
    "pre-build handle slot holds label ptr, not 0");
    return 0;
}

fn test_rg_transient_handle_out_of_range() {
    var g = rg_new();
    rg_add_transient_buffer(g, 64, 0x08, "r");
    assert_eq(rg_transient_handle(g, 0 - 1), 0,
    "rg_transient_handle(-1) = 0");
    assert_eq(rg_transient_handle(g, 99), 0,
    "rg_transient_handle(out-of-range) = 0");
    assert_eq(rg_transient_view(g, 0 - 1), 0,
    "rg_transient_view(-1) = 0");
    assert_eq(rg_transient_view(g, 99), 0,
    "rg_transient_view(out-of-range) = 0");
    return 0;
}

fn test_rg_release_null_is_safe() {
    assert_eq(rg_release(0), 0, "rg_release(0) is a no-op");
    return 0;
}

fn test_rg_aliasing_flag_round_trip() {
    var g = rg_new();
    rg_aliasing(g, 1);
    assert_eq(load64(g + 24), 1, "aliasing flag set to 1");
    rg_aliasing(g, 0);
    assert_eq(load64(g + 24), 0, "aliasing flag set to 0");
    return 0;
}

# ================================================================
# v3 Phase A — transient aliasing planner
# ================================================================

fn test_rg_plan_unbuilt_returns_error() {
    var g = rg_new();
    var stats[24];
    assert_eq(rg_plan_aliasing_stats(g, &stats), 1, "plan on unbuilt graph returns 1");
    return 0;
}

fn test_rg_plan_empty_graph() {
    var g = rg_new();
    assert_eq(rg_build(g, 0), 0, "empty build ok");
    var stats[24];
    memset(&stats, 0xFF, 24);
    assert_eq(rg_plan_aliasing_stats(g, &stats), 0, "plan on empty returns 0");
    assert_eq(load64(&stats + 0), 0, "empty: 0 slots");
    assert_eq(load64(&stats + 8), 0, "empty: 0 naive");
    assert_eq(load64(&stats + 16), 0, "empty: 0 aliased");
    return 0;
}

fn test_rg_plan_unused_transient_excluded() {
    var g = rg_new();
    var orphan = rg_add_transient_buffer(g, 256, 0, "orphan");
    assert_eq(rg_build(g, 0), 0, "build ok");
    var stats[24];
    assert_eq(rg_plan_aliasing_stats(g, &stats), 0, "plan ok");
    assert_eq(load64(&stats + 0), 0, "unused transient: 0 slots");
    assert_eq(load64(&stats + 8), 0, "unused transient: 0 naive");
    assert_eq(rg_transient_first_use(g, orphan), 0 - 1, "orphan first_use stays -1");
    assert_eq(rg_transient_last_use(g, orphan), 0 - 1, "orphan last_use stays -1");
    return 0;
}

fn test_rg_plan_single_buffer_offset_zero() {
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    var r = rg_add_transient_buffer(g, 256, 0, "only");
    var n = rg_add_compute(g, 0, 0, &dims, "N");
    rg_node_reads(g, n, r);
    assert_eq(rg_build(g, 0), 0, "build ok");
    var stats[24];
    assert_eq(rg_plan_aliasing_stats(g, &stats), 0, "plan ok");
    assert_eq(rg_transient_offset(g, r), 0, "single transient at offset 0");
    assert_eq(load64(&stats + 0), 1, "1 slot");
    assert_eq(load64(&stats + 8), 256, "naive = 256");
    assert_eq(load64(&stats + 16), 256, "aliased = 256");
    return 0;
}

fn test_rg_plan_overlapping_buffers_different_offsets() {
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    # Two buffers both alive at the same node: A writes both, B reads both.
    # Lifetimes [0,1] and [0,1] — overlapping entirely.
    var r0 = rg_add_transient_buffer(g, 256, 0, "r0");
    var r1 = rg_add_transient_buffer(g, 256, 0, "r1");
    var a = rg_add_compute(g, 0, 0, &dims, "A");
    var b = rg_add_compute(g, 0, 0, &dims, "B");
    rg_node_writes(g, a, r0);
    rg_node_writes(g, a, r1);
    rg_node_reads(g, b, r0);
    rg_node_reads(g, b, r1);
    assert_eq(rg_build(g, 0), 0, "build ok");
    var stats[24];
    assert_eq(rg_plan_aliasing_stats(g, &stats), 0, "plan ok");
    var off0 = rg_transient_offset(g, r0);
    var off1 = rg_transient_offset(g, r1);
    assert(off0 != off1, "overlapping r0/r1 get different offsets");
    assert_eq(load64(&stats + 0), 2, "2 slots for overlapping pair");
    assert_eq(load64(&stats + 16), 512, "aliased = 2 * 256");
    return 0;
}

fn test_rg_plan_disjoint_buffers_share_offset() {
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    # 4-node linear chain: A→B→C→D. Three transients staggered.
    # buf0 lifetime [0,1], scratch [1,2], buf1 [2,3].
    # buf0 and buf1 are pairwise disjoint (can share). scratch overlaps both.
    var r0 = rg_add_transient_buffer(g, 256, 0, "buf0");
    var r1 = rg_add_transient_buffer(g, 256, 0, "scratch");
    var r2 = rg_add_transient_buffer(g, 256, 0, "buf1");
    var a = rg_add_compute(g, 0, 0, &dims, "A");
    var b = rg_add_compute(g, 0, 0, &dims, "B");
    var c = rg_add_compute(g, 0, 0, &dims, "C");
    var d = rg_add_compute(g, 0, 0, &dims, "D");
    rg_node_writes(g, a, r0);
    rg_node_reads(g, b, r0);
    rg_node_writes(g, b, r1);
    rg_node_reads(g, c, r1);
    rg_node_writes(g, c, r2);
    rg_node_reads(g, d, r2);
    assert_eq(rg_build(g, 0), 0, "linear chain builds");
    # Lifetimes
    assert_eq(rg_transient_first_use(g, r0), 0, "buf0 first_use=0");
    assert_eq(rg_transient_last_use(g, r0),  1, "buf0 last_use=1");
    assert_eq(rg_transient_first_use(g, r1), 1, "scratch first_use=1");
    assert_eq(rg_transient_last_use(g, r1),  2, "scratch last_use=2");
    assert_eq(rg_transient_first_use(g, r2), 2, "buf1 first_use=2");
    assert_eq(rg_transient_last_use(g, r2),  3, "buf1 last_use=3");
    # Planner should give buf0 and buf1 the same offset (slot 1),
    # scratch a separate offset (slot 2). 2 slots total.
    var stats[24];
    assert_eq(rg_plan_aliasing_stats(g, &stats), 0, "plan ok");
    assert_eq(rg_transient_offset(g, r0), 0,   "buf0 offset=0");
    assert_eq(rg_transient_offset(g, r1), 256, "scratch offset=256");
    assert_eq(rg_transient_offset(g, r2), 0,   "buf1 reuses buf0 slot");
    assert_eq(load64(&stats + 0), 2,   "2 slots");
    assert_eq(load64(&stats + 8), 768, "naive = 3 * 256");
    assert_eq(load64(&stats + 16), 512, "aliased = 2 * 256");
    return 0;
}

fn test_rg_plan_buffers_and_textures_separate() {
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    var buf = rg_add_transient_buffer(g, 256, 0, "buf");
    # 4x4 RGBA8 texture = 64 bytes → aligns up to 256.
    var tex = rg_add_transient_texture(g, 4, 4, 18, 0, "tex");
    var n = rg_add_compute(g, 0, 0, &dims, "N");
    rg_node_reads(g, n, buf);
    rg_node_reads(g, n, tex);
    assert_eq(rg_build(g, 0), 0, "build ok");
    var stats[24];
    assert_eq(rg_plan_aliasing_stats(g, &stats), 0, "plan ok");
    # Buffers placed first, textures after — kept in separate sub-ranges.
    assert_eq(rg_transient_offset(g, buf), 0,   "buffer at offset 0");
    assert_eq(rg_transient_offset(g, tex), 256, "texture after buffer range");
    assert_eq(load64(&stats + 0), 2, "2 slots across kinds");
    return 0;
}

fn test_rg_plan_alignment_256() {
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    # 100-byte buffer — must align up to 256.
    var r = rg_add_transient_buffer(g, 100, 0, "small");
    var n = rg_add_compute(g, 0, 0, &dims, "N");
    rg_node_reads(g, n, r);
    assert_eq(rg_build(g, 0), 0, "build ok");
    var stats[24];
    assert_eq(rg_plan_aliasing_stats(g, &stats), 0, "plan ok");
    assert_eq(load64(&stats + 8), 256, "naive aligned up from 100 to 256");
    assert_eq(load64(&stats + 16), 256, "aliased aligned up from 100 to 256");
    return 0;
}

fn test_rg_first_use_last_use_across_multiple_reads() {
    var g = rg_new();
    var dims[12]; store32(&dims, 1); store32(&dims + 4, 1); store32(&dims + 8, 1);
    # One writer, three readers — lifetime spans writer through last reader.
    var r = rg_add_transient_buffer(g, 256, 0, "shared");
    var w  = rg_add_compute(g, 0, 0, &dims, "W");
    var r1 = rg_add_compute(g, 0, 0, &dims, "R1");
    var r2 = rg_add_compute(g, 0, 0, &dims, "R2");
    var r3 = rg_add_compute(g, 0, 0, &dims, "R3");
    rg_node_writes(g, w, r);
    rg_node_reads(g, r1, r);
    rg_node_reads(g, r2, r);
    rg_node_reads(g, r3, r);
    assert_eq(rg_build(g, 0), 0, "build ok");
    assert_eq(rg_transient_first_use(g, r), 0, "first_use = W");
    assert_eq(rg_transient_last_use(g, r), 3, "last_use = R3");
    return 0;
}

# ================================================================
# v3 Phase B.1 — native backend: ioctl encoding + constants
# Pure-math assertions only; hardware-dependent probing lives in
# programs/native_device_enum.cyr under `make test-native-enum`.
# ================================================================

fn test_native_ioc_encode_drm_version() {
    # DRM_IOCTL_VERSION = _IOWR('d', 0x00, struct drm_version)
    # dir=3 (RW), type='d'=0x64, nr=0x00, size=64 → 0xC0406400
    assert_eq(native_ioc_encode(3, 64, 0x64, 0), 0xC0406400, "DRM_IOCTL_VERSION encodes correctly");
    assert_eq(native_ioc_encode(3, 64, 0x64, 0), DRM_IOCTL_VERSION, "constant matches encoder");
    return 0;
}

fn test_native_ioc_encode_directions() {
    # dir lives in bits 30-31. Each direction swaps bit patterns there.
    assert_eq(native_ioc_encode(0, 0, 0, 0), 0x00000000, "NONE dir = 0 upper bits");
    assert_eq(native_ioc_encode(1, 0, 0, 0), 0x40000000, "WRITE dir = 0x40000000");
    assert_eq(native_ioc_encode(2, 0, 0, 0), 0x80000000, "READ dir = 0x80000000");
    assert_eq(native_ioc_encode(3, 0, 0, 0), 0xC0000000, "RW dir = 0xC0000000");
    return 0;
}

fn test_native_ioc_encode_size_in_bits_16_to_29() {
    # Size field is 14 bits wide (bits 16-29). Small size packs cleanly.
    assert_eq(native_ioc_encode(0, 1, 0, 0), 0x00010000, "size=1 at bit 16");
    assert_eq(native_ioc_encode(0, 64, 0, 0), 0x00400000, "size=64 at bit 16+6");
    assert_eq(native_ioc_encode(0, 0x3FFF, 0, 0), 0x3FFF0000, "size=max (14 bits all set)");
    # Size overflow: 0x4000 wraps to 0 (14-bit mask).
    assert_eq(native_ioc_encode(0, 0x4000, 0, 0), 0x00000000, "size overflow masks to 0");
    return 0;
}

fn test_native_ioc_encode_type_and_nr() {
    # type is bits 8-15, nr is bits 0-7. Both byte-sized.
    assert_eq(native_ioc_encode(0, 0, 0x64, 0), 0x00006400, "type=0x64 at bits 8-15");
    assert_eq(native_ioc_encode(0, 0, 0, 0xFF), 0x000000FF, "nr=0xFF at bits 0-7");
    assert_eq(native_ioc_encode(0, 0, 0xFF, 0xFF), 0x0000FFFF, "type+nr combined");
    return 0;
}

fn test_native_drm_constants() {
    assert_eq(DRM_IOCTL_TYPE, 0x64, "DRM type is 'd'");
    assert_eq(DRM_VERSION_SIZE, 64, "drm_version is 64 bytes on x86_64");
    return 0;
}

fn test_native_drm_version_struct_layout() {
    # Verify we can round-trip values at the documented offsets.
    # If the layout drifts (e.g., mabda grows a helper that assumes
    # different offsets), these assertions catch it before the ioctl
    # hits the kernel.
    var v[64];
    memset(&v, 0, 64);
    store32(&v + 0,  1);       # version_major
    store32(&v + 4,  2);       # version_minor
    store32(&v + 8,  3);       # version_patchlevel
    store64(&v + 16, 13);      # name_len
    store64(&v + 24, 0xAAAA);  # name_ptr
    store64(&v + 32, 14);      # date_len
    store64(&v + 40, 0xBBBB);  # date_ptr
    store64(&v + 48, 15);      # desc_len
    store64(&v + 56, 0xCCCC);  # desc_ptr
    assert_eq(load32(&v + 0),  1,      "major at +0");
    assert_eq(load32(&v + 4),  2,      "minor at +4");
    assert_eq(load32(&v + 8),  3,      "patch at +8");
    assert_eq(load64(&v + 16), 13,     "name_len at +16");
    assert_eq(load64(&v + 24), 0xAAAA, "name_ptr at +24");
    assert_eq(load64(&v + 32), 14,     "date_len at +32");
    assert_eq(load64(&v + 40), 0xBBBB, "date_ptr at +40");
    assert_eq(load64(&v + 48), 15,     "desc_len at +48");
    assert_eq(load64(&v + 56), 0xCCCC, "desc_ptr at +56");
    return 0;
}

fn test_native_render_node_path() {
    # Constant must equal the canonical first-render-node path.
    var expected = "/dev/dri/renderD128";
    assert_eq(strlen(DRM_RENDER_NODE_PATH), strlen(expected), "path length matches");
    assert_eq(memeq(DRM_RENDER_NODE_PATH, expected, strlen(expected)), 1, "path contents match");
    return 0;
}

# ================================================================
# v3 Phase B.2 — GEM BO lifecycle (AMDGPU) — pure-math constants
# ================================================================

fn test_native_drm_command_base() {
    assert_eq(DRM_COMMAND_BASE, 0x40, "DRM_COMMAND_BASE = 0x40");
    return 0;
}

fn test_native_amdgpu_ioctl_nr_offsets() {
    assert_eq(DRM_AMDGPU_GEM_CREATE, 0x00, "GEM_CREATE nr offset");
    assert_eq(DRM_AMDGPU_GEM_MMAP,   0x01, "GEM_MMAP nr offset");
    return 0;
}

fn test_native_gem_create_ioctl_encoding() {
    # _IOWR('d', DRM_COMMAND_BASE + 0, union drm_amdgpu_gem_create) with 32-byte union.
    var expected = native_ioc_encode(3, DRM_AMDGPU_GEM_CREATE_SIZE, DRM_IOCTL_TYPE,
                                     DRM_COMMAND_BASE + DRM_AMDGPU_GEM_CREATE);
    assert_eq(DRM_IOCTL_AMDGPU_GEM_CREATE, expected, "GEM_CREATE ioctl = 0xC0206440");
    assert_eq(DRM_IOCTL_AMDGPU_GEM_CREATE, 0xC0206440, "precomputed constant");
    return 0;
}

fn test_native_gem_mmap_ioctl_encoding() {
    # _IOWR('d', 0x41, union drm_amdgpu_gem_mmap) with 8-byte union.
    var expected = native_ioc_encode(3, DRM_AMDGPU_GEM_MMAP_SIZE, DRM_IOCTL_TYPE,
                                     DRM_COMMAND_BASE + DRM_AMDGPU_GEM_MMAP);
    assert_eq(DRM_IOCTL_AMDGPU_GEM_MMAP, expected, "GEM_MMAP ioctl = 0xC0086441");
    assert_eq(DRM_IOCTL_AMDGPU_GEM_MMAP, 0xC0086441, "precomputed constant");
    return 0;
}

fn test_native_gem_close_ioctl_encoding() {
    # _IOW('d', 0x09, struct drm_gem_close) with 8-byte struct.
    var expected = native_ioc_encode(1, DRM_GEM_CLOSE_SIZE, DRM_IOCTL_TYPE, 0x09);
    assert_eq(DRM_IOCTL_GEM_CLOSE, expected, "GEM_CLOSE ioctl = 0x40086409");
    assert_eq(DRM_IOCTL_GEM_CLOSE, 0x40086409, "precomputed constant");
    return 0;
}

fn test_native_amdgpu_gem_domains() {
    # Domain bit values mirror kernel UAPI. They are disjoint single bits.
    assert_eq(AMDGPU_GEM_DOMAIN_CPU,  0x1, "CPU = 0x1");
    assert_eq(AMDGPU_GEM_DOMAIN_GTT,  0x2, "GTT = 0x2");
    assert_eq(AMDGPU_GEM_DOMAIN_VRAM, 0x4, "VRAM = 0x4");
    # Single-bit invariant: each is a power of 2, no shared bits.
    assert_eq(AMDGPU_GEM_DOMAIN_CPU & AMDGPU_GEM_DOMAIN_GTT,  0, "CPU/GTT disjoint");
    assert_eq(AMDGPU_GEM_DOMAIN_GTT & AMDGPU_GEM_DOMAIN_VRAM, 0, "GTT/VRAM disjoint");
    assert_eq(AMDGPU_GEM_DOMAIN_CPU & AMDGPU_GEM_DOMAIN_VRAM, 0, "CPU/VRAM disjoint");
    return 0;
}

fn test_native_gem_create_request_layout() {
    # drm_amdgpu_gem_create_in: {bo_size, alignment, domains, domain_flags}
    # each u64, packed — 32 bytes total.
    var req[32];
    memset(&req, 0, 32);
    store64(&req + 0,  0x1000);   # bo_size = 4096
    store64(&req + 8,  0x0100);   # alignment = 256
    store64(&req + 16, 0x2);      # domains = GTT
    store64(&req + 24, 0);        # domain_flags
    assert_eq(load64(&req + 0),  0x1000, "bo_size slot");
    assert_eq(load64(&req + 8),  0x0100, "alignment slot");
    assert_eq(load64(&req + 16), 0x2,    "domains slot");
    assert_eq(load64(&req + 24), 0,      "domain_flags slot");
    return 0;
}

fn test_native_gem_mmap_request_layout() {
    # drm_amdgpu_gem_mmap_in: {handle u32, _pad u32} = 8 bytes.
    # Out variant: {addr_ptr u64} at the same memory.
    var req[8];
    memset(&req, 0, 8);
    store32(&req + 0, 42);    # handle
    assert_eq(load32(&req + 0), 42, "handle at +0");
    # After kernel writes, the same 8 bytes become an i64 addr_ptr.
    memset(&req, 0, 8);
    store64(&req + 0, 0xDEAD00);
    assert_eq(load64(&req + 0), 0xDEAD00, "addr_ptr at +0 (union)");
    return 0;
}

