}

fn test_native_bo_list_ioctl_encoding() {
    var expected = native_ioc_encode(3, DRM_AMDGPU_BO_LIST_SIZE, DRM_IOCTL_TYPE,
                                     DRM_COMMAND_BASE + DRM_AMDGPU_BO_LIST);
