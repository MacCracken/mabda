fn test_native_phase_b3a_nr_offsets() {
    assert_eq(DRM_AMDGPU_CTX,     0x02, "CTX nr offset");
    assert_eq(DRM_AMDGPU_BO_LIST, 0x03, "BO_LIST nr offset");
    assert_eq(DRM_AMDGPU_GEM_VA,  0x08, "GEM_VA nr offset");
    return 0;
}

fn test_native_ctx_ioctl_encoding() {
