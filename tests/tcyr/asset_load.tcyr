# tests/tcyr/asset_load.tcyr - v3.3 asset loading (Phase AL)
# AL.0: VkFormat / DXGI_FORMAT -> MABDA_TEXFMT_* mapping tables +
# sRGB-detection queries (src/asset_format.cyr). Loader tests (AL.3+)
# append here. Self-contained suite (own main + assert_summary).
include "src/lib.cyr"
include "lib/assert.cyr"

# --- AL.0: VkFormat -> MABDA_TEXFMT (numbers pinned to vulkan_core.h) ---
fn test_vk_format_mapping() {
    assert_eq(mabda_texfmt_from_vk_format(37),  MABDA_TEXFMT_RGBA8, "VK 37 RGBA8_UNORM");
    assert_eq(mabda_texfmt_from_vk_format(43),  MABDA_TEXFMT_RGBA8, "VK 43 RGBA8_SRGB -> RGBA8");
    assert_eq(mabda_texfmt_from_vk_format(131), MABDA_TEXFMT_BC1, "VK 131 BC1_RGB_UNORM");
    assert_eq(mabda_texfmt_from_vk_format(133), MABDA_TEXFMT_BC1, "VK 133 BC1_RGBA_UNORM");
    assert_eq(mabda_texfmt_from_vk_format(134), MABDA_TEXFMT_BC1, "VK 134 BC1_RGBA_SRGB -> BC1");
    assert_eq(mabda_texfmt_from_vk_format(137), MABDA_TEXFMT_BC3, "VK 137 BC3_UNORM");
    assert_eq(mabda_texfmt_from_vk_format(138), MABDA_TEXFMT_BC3, "VK 138 BC3_SRGB -> BC3");
    assert_eq(mabda_texfmt_from_vk_format(139), MABDA_TEXFMT_BC4, "VK 139 BC4_UNORM");
    assert_eq(mabda_texfmt_from_vk_format(141), MABDA_TEXFMT_BC5, "VK 141 BC5_UNORM");
    assert_eq(mabda_texfmt_from_vk_format(143), MABDA_TEXFMT_BC6H, "VK 143 BC6H_UFLOAT");
    assert_eq(mabda_texfmt_from_vk_format(145), MABDA_TEXFMT_BC7, "VK 145 BC7_UNORM");
    assert_eq(mabda_texfmt_from_vk_format(146), MABDA_TEXFMT_BC7, "VK 146 BC7_SRGB -> BC7");
    assert_eq(mabda_texfmt_from_vk_format(147), MABDA_TEXFMT_ETC2_RGB8, "VK 147 ETC2_RGB8");
    assert_eq(mabda_texfmt_from_vk_format(151), MABDA_TEXFMT_ETC2_RGBA8, "VK 151 ETC2_RGBA8");
    assert_eq(mabda_texfmt_from_vk_format(157), MABDA_TEXFMT_ASTC_4X4, "VK 157 ASTC_4x4");
    assert_eq(mabda_texfmt_from_vk_format(165), MABDA_TEXFMT_ASTC_6X6, "VK 165 ASTC_6x6");
    assert_eq(mabda_texfmt_from_vk_format(171), MABDA_TEXFMT_ASTC_8X8, "VK 171 ASTC_8x8");
    return 0;
}

# Unrepresentable / unmapped VkFormats must return 0 (fail-loud at loader).
fn test_vk_format_unmapped() {
    assert_eq(mabda_texfmt_from_vk_format(135), 0 - 1, "VK 135 BC2 no mabda id -> -1");
    assert_eq(mabda_texfmt_from_vk_format(140), 0 - 1, "VK 140 BC4_SNORM -> -1 (no signed id)");
    assert_eq(mabda_texfmt_from_vk_format(142), 0 - 1, "VK 142 BC5_SNORM -> -1");
    assert_eq(mabda_texfmt_from_vk_format(144), 0 - 1, "VK 144 BC6H_SFLOAT -> -1");
    assert_eq(mabda_texfmt_from_vk_format(149), 0 - 1, "VK 149 ETC2_R8G8B8A1 -> -1 (no id)");
    assert_eq(mabda_texfmt_from_vk_format(0), 0 - 1, "VK 0 UNDEFINED -> -1");
    assert_eq(mabda_texfmt_from_vk_format(9999), 0 - 1, "VK 9999 unknown -> -1");
    # RGBA8 (id 0) is a VALID result, distinct from unmapped (-1).
    assert_eq(mabda_texfmt_from_vk_format(37), MABDA_TEXFMT_RGBA8, "VK 37 -> RGBA8 (0), not unmapped");
    return 0;
}

fn test_vk_format_srgb_flag() {
    assert_eq(mabda_vk_format_is_srgb(43), 1, "VK 43 RGBA8_SRGB is sRGB");
    assert_eq(mabda_vk_format_is_srgb(134), 1, "VK 134 BC1_RGBA_SRGB is sRGB");
    assert_eq(mabda_vk_format_is_srgb(146), 1, "VK 146 BC7_SRGB is sRGB");
    assert_eq(mabda_vk_format_is_srgb(172), 1, "VK 172 ASTC_8x8_SRGB is sRGB");
    assert_eq(mabda_vk_format_is_srgb(37), 0, "VK 37 RGBA8_UNORM not sRGB");
    assert_eq(mabda_vk_format_is_srgb(145), 0, "VK 145 BC7_UNORM not sRGB");
    assert_eq(mabda_vk_format_is_srgb(9999), 0, "VK unknown not sRGB");
    return 0;
}

# --- AL.0: DXGI_FORMAT -> MABDA_TEXFMT (numbers pinned to dxgiformat.h) ---
fn test_dxgi_format_mapping() {
    assert_eq(mabda_texfmt_from_dxgi_format(28), MABDA_TEXFMT_RGBA8, "DXGI 28 RGBA8_UNORM");
    assert_eq(mabda_texfmt_from_dxgi_format(29), MABDA_TEXFMT_RGBA8, "DXGI 29 RGBA8_SRGB -> RGBA8");
    assert_eq(mabda_texfmt_from_dxgi_format(71), MABDA_TEXFMT_BC1, "DXGI 71 BC1_UNORM");
    assert_eq(mabda_texfmt_from_dxgi_format(72), MABDA_TEXFMT_BC1, "DXGI 72 BC1_SRGB -> BC1");
    assert_eq(mabda_texfmt_from_dxgi_format(77), MABDA_TEXFMT_BC3, "DXGI 77 BC3_UNORM");
    assert_eq(mabda_texfmt_from_dxgi_format(78), MABDA_TEXFMT_BC3, "DXGI 78 BC3_SRGB -> BC3");
    assert_eq(mabda_texfmt_from_dxgi_format(80), MABDA_TEXFMT_BC4, "DXGI 80 BC4_UNORM");
    assert_eq(mabda_texfmt_from_dxgi_format(83), MABDA_TEXFMT_BC5, "DXGI 83 BC5_UNORM");
    assert_eq(mabda_texfmt_from_dxgi_format(95), MABDA_TEXFMT_BC6H, "DXGI 95 BC6H_UF16");
    assert_eq(mabda_texfmt_from_dxgi_format(98), MABDA_TEXFMT_BC7, "DXGI 98 BC7_UNORM");
    assert_eq(mabda_texfmt_from_dxgi_format(99), MABDA_TEXFMT_BC7, "DXGI 99 BC7_SRGB -> BC7");
    return 0;
}

# The plan mis-mapped DXGI 74 -> BC3; 74 (0x4A) is BC2 (no mabda id) -> 0.
fn test_dxgi_format_unmapped() {
    assert_eq(mabda_texfmt_from_dxgi_format(74), 0 - 1, "DXGI 74 BC2 no mabda id -> -1");
    assert_eq(mabda_texfmt_from_dxgi_format(81), 0 - 1, "DXGI 81 BC4_SNORM -> -1");
    assert_eq(mabda_texfmt_from_dxgi_format(84), 0 - 1, "DXGI 84 BC5_SNORM -> -1");
    assert_eq(mabda_texfmt_from_dxgi_format(96), 0 - 1, "DXGI 96 BC6H_SF16 -> -1");
    assert_eq(mabda_texfmt_from_dxgi_format(0), 0 - 1, "DXGI 0 UNKNOWN -> -1");
    assert_eq(mabda_texfmt_from_dxgi_format(9999), 0 - 1, "DXGI 9999 unknown -> -1");
    # RGBA8 (id 0) is a VALID result, distinct from unmapped (-1).
    assert_eq(mabda_texfmt_from_dxgi_format(28), MABDA_TEXFMT_RGBA8, "DXGI 28 -> RGBA8 (0), not unmapped");
    return 0;
}

fn test_dxgi_format_srgb_flag() {
    assert_eq(mabda_dxgi_format_is_srgb(29), 1, "DXGI 29 RGBA8_SRGB is sRGB");
    assert_eq(mabda_dxgi_format_is_srgb(72), 1, "DXGI 72 BC1_SRGB is sRGB");
    assert_eq(mabda_dxgi_format_is_srgb(78), 1, "DXGI 78 BC3_SRGB is sRGB");
    assert_eq(mabda_dxgi_format_is_srgb(99), 1, "DXGI 99 BC7_SRGB is sRGB");
    assert_eq(mabda_dxgi_format_is_srgb(28), 0, "DXGI 28 RGBA8_UNORM not sRGB");
    assert_eq(mabda_dxgi_format_is_srgb(98), 0, "DXGI 98 BC7_UNORM not sRGB");
    return 0;
}

# Every mapped non-RGBA8 result must round-trip through the existing
# compression-family classifier (sanity that the ids are the real ones).
fn test_mapping_targets_are_valid_ids() {
    assert_eq(mabda_texfmt_is_compressed(mabda_texfmt_from_vk_format(133)), 1, "VK BC1 -> compressed id");
    assert_eq(mabda_texfmt_is_compressed(mabda_texfmt_from_dxgi_format(98)), 1, "DXGI BC7 -> compressed id");
    assert_eq(mabda_texfmt_compression_family(mabda_texfmt_from_vk_format(147)),
    MABDA_TEXCOMP_ETC2, "VK ETC2_RGB8 -> ETC2 family");
    assert_eq(mabda_texfmt_compression_family(mabda_texfmt_from_vk_format(157)),
    MABDA_TEXCOMP_ASTC, "VK ASTC_4x4 -> ASTC family");
    return 0;
}

# --- AL.3: DDS header parse + caps gate + load orchestration ---

# Build a legacy-FourCC DDS header (>= 128-byte buf). Offsets per asset_load.cyr.
fn _mk_dds_fourcc(buf, w, h, mipc, fourcc) {
    memset(buf, 0, 128);
    store32(buf + 0, _DDS_MAGIC);
    store32(buf + 4, 124);            # dwSize
    store32(buf + 12, h);
    store32(buf + 16, w);
    store32(buf + 28, mipc);
    store32(buf + 80, _DDPF_FOURCC);  # ddpf.dwFlags
    store32(buf + 84, fourcc);
    return 0;
}

# Build a DX10 DDS header (>= 148-byte buf): FourCC 'DX10' + the 20-byte DXT10.
fn _mk_dds_dx10(buf, w, h, mipc, dxgi, misc, arraysize) {
    memset(buf, 0, 148);
    store32(buf + 0, _DDS_MAGIC);
    store32(buf + 4, 124);
    store32(buf + 12, h);
    store32(buf + 16, w);
    store32(buf + 28, mipc);
    store32(buf + 80, _DDPF_FOURCC);
    store32(buf + 84, _DDS_FOURCC_DX10);
    store32(buf + 128, dxgi);
    store32(buf + 136, misc);
    store32(buf + 140, arraysize);
    return 0;
}

fn test_dds_parse_fourcc() {
    var buf[148];
    var out[48];
    _mk_dds_fourcc(&buf, 64, 32, 1, _DDS_FOURCC_DXT1);
    assert_eq(_dds_parse(&buf, 148, &out), 0, "DXT1 parses");
    assert_eq(load64(&out + 0), MABDA_TEXFMT_BC1, "DXT1 -> BC1");
    assert_eq(load64(&out + 8), 64, "width 64");
    assert_eq(load64(&out + 16), 32, "height 32");
    assert_eq(load64(&out + 24), 1, "mip 1");
    assert_eq(load64(&out + 32), 128, "data offset 128 (legacy FourCC)");
    _mk_dds_fourcc(&buf, 16, 16, 3, _DDS_FOURCC_DXT5);
    assert_eq(_dds_parse(&buf, 148, &out), 0, "DXT5 parses");
    assert_eq(load64(&out + 0), MABDA_TEXFMT_BC3, "DXT5 -> BC3");
    assert_eq(load64(&out + 24), 3, "mip 3");
    return 0;
}

fn test_dds_parse_dx10() {
    var buf[148];
    var out[48];
    _mk_dds_dx10(&buf, 8, 8, 1, 98, 0, 1);   # DXGI 98 = BC7
    assert_eq(_dds_parse(&buf, 148, &out), 0, "DX10 BC7 parses");
    assert_eq(load64(&out + 0), MABDA_TEXFMT_BC7, "DXGI 98 -> BC7");
    assert_eq(load64(&out + 32), 148, "data offset 148 (DX10)");
    assert_eq(load64(&out + 40), 0, "BC7 UNORM not sRGB");
    _mk_dds_dx10(&buf, 8, 8, 1, 99, 0, 1);   # DXGI 99 = BC7 sRGB
    _dds_parse(&buf, 148, &out);
    assert_eq(load64(&out + 0), MABDA_TEXFMT_BC7, "DXGI 99 -> BC7");
    assert_eq(load64(&out + 40), 1, "DXGI 99 srgb flag set");
    # RGBA8 via DX10 (DXGI 28 -> id 0): MUST parse, not be mistaken for unmapped.
    _mk_dds_dx10(&buf, 4, 4, 1, 28, 0, 1);
    assert_eq(_dds_parse(&buf, 148, &out), 0, "DX10 RGBA8 parses (0 id != unmapped)");
    assert_eq(load64(&out + 0), MABDA_TEXFMT_RGBA8, "DXGI 28 -> RGBA8");
    return 0;
}

fn test_dds_parse_rejects() {
    var buf[148];
    var out[48];
    _mk_dds_fourcc(&buf, 64, 64, 1, _DDS_FOURCC_DXT1);
    store32(&buf + 0, 0x12345678);
    assert_eq(_dds_parse(&buf, 148, &out), GPU_ERR_CONTAINER_PARSE, "bad magic");
    _mk_dds_fourcc(&buf, 64, 64, 1, _DDS_FOURCC_DXT1);
    assert_eq(_dds_parse(&buf, 64, &out), GPU_ERR_CONTAINER_PARSE, "truncated (<128)");
    _mk_dds_fourcc(&buf, 64, 64, 1, _DDS_FOURCC_DXT3);
    assert_eq(_dds_parse(&buf, 148, &out), GPU_ERR_FORMAT_UNSUPPORTED, "DXT3/BC2 no mabda id");
    _mk_dds_fourcc(&buf, 64, 64, 1, _DDS_FOURCC_DXT1);
    store32(&buf + 112, _DDSCAPS2_CUBEMAP);
    assert_eq(_dds_parse(&buf, 148, &out), GPU_ERR_FORMAT_UNSUPPORTED, "legacy cubemap rejected");
    _mk_dds_dx10(&buf, 8, 8, 1, 98, 0, 6);
    assert_eq(_dds_parse(&buf, 148, &out), GPU_ERR_FORMAT_UNSUPPORTED, "DX10 arraySize>1 rejected");
    _mk_dds_dx10(&buf, 8, 8, 1, 98, _DDS_MISC_CUBE, 1);
    assert_eq(_dds_parse(&buf, 148, &out), GPU_ERR_FORMAT_UNSUPPORTED, "DX10 cube rejected");
    _mk_dds_fourcc(&buf, 8, 8, 1, _DDS_FOURCC_DX10);
    assert_eq(_dds_parse(&buf, 128, &out), GPU_ERR_CONTAINER_PARSE, "DX10 w/o DXT10 header");
    _mk_dds_dx10(&buf, 8, 8, 1, 999, 0, 1);
    assert_eq(_dds_parse(&buf, 148, &out), GPU_ERR_FORMAT_UNSUPPORTED, "unmapped DXGI");
    _mk_dds_fourcc(&buf, 64, 64, 1, _DDS_FOURCC_DXT1);
    store32(&buf + 80, 0);            # clear DDPF_FOURCC
    assert_eq(_dds_parse(&buf, 148, &out), GPU_ERR_CONTAINER_PARSE, "non-FourCC legacy unsupported");
    return 0;
}

fn test_gpu_ctx_supports_format_native() {
    var b = backend_new();
    backend_set_kind(b, BACKEND_KIND_AMD);
    var ctx[168];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    store64((&ctx) + 32, b);
    assert_eq(gpu_ctx_supports_format(&ctx, MABDA_TEXFMT_RGBA8), 1, "RGBA8 always supported");
    assert_eq(gpu_ctx_supports_format(&ctx, MABDA_TEXFMT_BC1), 1, "native BC supported");
    assert_eq(gpu_ctx_supports_format(&ctx, MABDA_TEXFMT_ETC2_RGB8), 0, "native ETC2 unsupported (Cezanne)");
    assert_eq(gpu_ctx_supports_format(&ctx, 99), 0, "invalid fmt -> 0");
    assert_eq(gpu_ctx_supports_format(0, MABDA_TEXFMT_RGBA8), 0, "null ctx -> 0");
    return 0;
}

# Mock backend captures for the load orchestration (create + write_level).
var _dds_cr_count = 0;
var _dds_cr_w = 0;
var _dds_cr_h = 0;
var _dds_cr_fmt = 0;
var _dds_cr_mc = 0;
var _dds_wl_count = 0;
var _dds_wl_n = 0;
fn _dds_cr_cap(ctx, w, h, fmt, mc) {
    _dds_cr_count = _dds_cr_count + 1;
    _dds_cr_w = w;
    _dds_cr_h = h;
    _dds_cr_fmt = fmt;
    _dds_cr_mc = mc;
    return 0x7E;
}
fn _dds_wl_cap(ctx, tex, level, src, n) {
    _dds_wl_count = _dds_wl_count + 1;
    _dds_wl_n = n;
    return 0;
}

fn test_gpu_texture_load_dds_orchestration() {
    _dds_cr_count = 0;
    _dds_wl_count = 0;
    var b = backend_new();
    backend_set_kind(b, BACKEND_KIND_AMD);
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_CREATE_2D_FMT_MIPPED, &_dds_cr_cap);
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_WRITE_LEVEL, &_dds_wl_cap);
    var ctx[168];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    store64((&ctx) + 32, b);
    # DXT1 8x8 1-level: 128-byte header + BC1 8x8 (32 B) = 160-byte buffer.
    var buf[160];
    _mk_dds_fourcc(&buf, 8, 8, 1, _DDS_FOURCC_DXT1);
    var tex = gpu_texture_load_dds(&ctx, &buf, 160);
    assert_eq(tex, 0x7E, "returns the created tex handle");
    assert_eq(_dds_cr_count, 1, "create called once");
    assert_eq(_dds_cr_w, 8, "create width 8");
    assert_eq(_dds_cr_fmt, MABDA_TEXFMT_BC1, "create fmt BC1");
    assert_eq(_dds_cr_mc, 1, "create mip_count 1");
    assert_eq(_dds_wl_count, 1, "write_level once (1 level)");
    assert_eq(_dds_wl_n, 32, "level 0 = BC1 8x8 = 32 B");
    # Truncated level data: header says 32 B at offset 128 but buffer is 140.
    var buf2[140];
    _mk_dds_fourcc(&buf2, 8, 8, 1, _DDS_FOURCC_DXT1);
    assert_eq(gpu_texture_load_dds(&ctx, &buf2, 140), 0, "truncated level data -> 0");
    return 0;
}

# --- AL.4: KTX2 header parse + load orchestration ---

# Build a KTX2 header (>= 80-byte buf): 12-byte identifier + header fields.
# The level index (offset 80+) is left to the caller for load tests.
fn _mk_ktx2_hdr(buf, vk, w, h, levels, scheme, layers, faces) {
    memset(buf, 0, 80);
    store32(buf + 0, _KTX2_ID0);
    store32(buf + 4, _KTX2_ID1);
    store32(buf + 8, _KTX2_ID2);
    store32(buf + 12, vk);
    store32(buf + 20, w);
    store32(buf + 24, h);
    store32(buf + 32, layers);
    store32(buf + 36, faces);
    store32(buf + 40, levels);
    store32(buf + 44, scheme);
    return 0;
}

fn test_ktx2_parse() {
    var buf[148];
    var out[48];
    _mk_ktx2_hdr(&buf, 145, 64, 32, 1, 0, 0, 1);   # vk 145 = BC7_UNORM
    assert_eq(_ktx2_parse(&buf, 148, &out), 0, "KTX2 BC7 parses");
    assert_eq(load64(&out + 0), MABDA_TEXFMT_BC7, "vk 145 -> BC7");
    assert_eq(load64(&out + 8), 64, "width 64");
    assert_eq(load64(&out + 16), 32, "height 32");
    assert_eq(load64(&out + 24), 1, "1 level");
    _mk_ktx2_hdr(&buf, 37, 8, 8, 1, 0, 1, 1);       # vk 37 = RGBA8 (id 0)
    assert_eq(_ktx2_parse(&buf, 148, &out), 0, "KTX2 RGBA8 parses");
    assert_eq(load64(&out + 0), MABDA_TEXFMT_RGBA8, "vk 37 -> RGBA8 (0), valid not unmapped");
    return 0;
}

fn test_ktx2_parse_rejects() {
    var buf[148];
    var out[48];
    _mk_ktx2_hdr(&buf, 145, 64, 64, 1, 0, 0, 1);
    store32(&buf + 0, 0x12345678);
    assert_eq(_ktx2_parse(&buf, 148, &out), GPU_ERR_CONTAINER_PARSE, "bad identifier");
    _mk_ktx2_hdr(&buf, 145, 64, 64, 1, 0, 0, 1);
    assert_eq(_ktx2_parse(&buf, 40, &out), GPU_ERR_CONTAINER_PARSE, "truncated (<80)");
    _mk_ktx2_hdr(&buf, 145, 64, 64, 1, 2, 0, 1);    # scheme 2 = Zstd
    assert_eq(_ktx2_parse(&buf, 148, &out), GPU_ERR_FORMAT_UNSUPPORTED, "supercompression gated");
    _mk_ktx2_hdr(&buf, 145, 64, 64, 1, 0, 0, 6);    # faces 6 = cubemap
    assert_eq(_ktx2_parse(&buf, 148, &out), GPU_ERR_FORMAT_UNSUPPORTED, "cubemap rejected");
    _mk_ktx2_hdr(&buf, 145, 64, 64, 1, 0, 2, 1);    # layers 2 = array
    assert_eq(_ktx2_parse(&buf, 148, &out), GPU_ERR_FORMAT_UNSUPPORTED, "array rejected");
    _mk_ktx2_hdr(&buf, 9999, 64, 64, 1, 0, 0, 1);   # unmapped vk
    assert_eq(_ktx2_parse(&buf, 148, &out), GPU_ERR_FORMAT_UNSUPPORTED, "unmapped vk rejected");
    _mk_ktx2_hdr(&buf, 145, 64, 64, 4, 0, 0, 1);    # 4 levels need 80+96=176 bytes
    assert_eq(_ktx2_parse(&buf, 100, &out), GPU_ERR_CONTAINER_PARSE, "level index doesn't fit len");
    return 0;
}

fn test_ktx2_load_orchestration() {
    _dds_cr_count = 0;
    _dds_wl_count = 0;
    var b = backend_new();
    backend_set_kind(b, BACKEND_KIND_AMD);
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_CREATE_2D_FMT_MIPPED, &_dds_cr_cap);
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_WRITE_LEVEL, &_dds_wl_cap);
    var ctx[168];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    store64((&ctx) + 32, b);
    # KTX2 BC7 8x8 1-level: header+index = 104; data @104, BC7 8x8 = 64 B; buf 168.
    var buf[168];
    _mk_ktx2_hdr(&buf, 145, 8, 8, 1, 0, 0, 1);
    store64(&buf + 80, 104);          # level 0 byteOffset
    store64(&buf + 88, 64);           # byteLength
    store64(&buf + 96, 64);           # uncompressedByteLength
    var tex = gpu_texture_load_ktx2(&ctx, &buf, 168);
    assert_eq(tex, 0x7E, "returns the created tex handle");
    assert_eq(_dds_cr_count, 1, "create called once");
    assert_eq(_dds_cr_fmt, MABDA_TEXFMT_BC7, "create fmt BC7");
    assert_eq(_dds_wl_count, 1, "write_level once");
    assert_eq(_dds_wl_n, 64, "level 0 = BC7 8x8 = 64 B");
    # ETC2 KTX2 on native (BC-only caps) -> caps gate fails loud before create.
    var buf2[168];
    _mk_ktx2_hdr(&buf2, 147, 8, 8, 1, 0, 0, 1);   # vk 147 = ETC2_RGB8
    store64(&buf2 + 80, 104);
    store64(&buf2 + 88, 32);
    store64(&buf2 + 96, 32);
    assert_eq(gpu_texture_load_ktx2(&ctx, &buf2, 168), 0, "ETC2 on native (BC-only) -> 0 (caps gate)");
    # SECURITY (audit 2026-06-19, CRITICAL): a huge byteOffset must NOT overflow
    # the bounds check (boff + blen wraps negative for boff near i64_max and
    # silently passes -> OOB read in write_level). Must reject, never reach write.
    _dds_wl_count = 0;
    var buf3[168];
    _mk_ktx2_hdr(&buf3, 145, 8, 8, 1, 0, 0, 1);    # BC7 8x8, expected level = 64
    store64(&buf3 + 80, 0x7FFFFFFFFFFFFFFF);        # boff = i64_max (overflow bait)
    store64(&buf3 + 88, 64);                         # blen = the correct level size
    store64(&buf3 + 96, 64);                         # ulen = blen
    assert_eq(gpu_texture_load_ktx2(&ctx, &buf3, 168), 0, "huge byteOffset rejected (no overflow OOB)");
    assert_eq(_dds_wl_count, 0, "write_level never reached for OOB byteOffset");
    return 0;
}

# --- AL.5: PNG load via the chitra dep (real decode + upload routing) ---

# A valid 76-byte 2x2 RGBA8 PNG (colortype 6, depth 8): row0 red,green;
# row1 blue,white(a=128). Generated offline (zlib + PNG chunks), embedded so
# chitra actually decodes it. buf must be >= 80 bytes.
fn _mk_png_2x2(buf) {
    store64(buf + 0, 0x0A1A0A0D474E5089);
    store64(buf + 8, 0x524448490D000000);
    store64(buf + 16, 0x0200000002000000);
    store64(buf + 24, 0x0DB6720000000608);
    store64(buf + 32, 0x4144491300000024);
    store64(buf + 40, 0xF0C0CFF863DA7854);
    store64(buf + 48, 0x0000340834810C1F);
    store64(buf + 56, 0x9217519C78094949);
    store64(buf + 64, 0x444E454900000000);
    store8(buf + 72, 0xAE);
    store8(buf + 73, 0x42);
    store8(buf + 74, 0x60);
    store8(buf + 75, 0x82);
    return 0;
}

var _png_cr_count = 0;
var _png_cr_w = 0;
var _png_cr_h = 0;
var _png_cr_fmt = 0;
var _png_wr_count = 0;
var _png_wr_n = 0;
fn _png_cr_cap(ctx, w, h, fmt) {
    _png_cr_count = _png_cr_count + 1;
    _png_cr_w = w;
    _png_cr_h = h;
    _png_cr_fmt = fmt;
    return 0x7E;
}
fn _png_wr_cap(ctx, tex, src, n) {
    _png_wr_count = _png_wr_count + 1;
    _png_wr_n = n;
    return 0;
}

fn test_gpu_texture_load_png_orchestration() {
    _png_cr_count = 0;
    _png_wr_count = 0;
    var b = backend_new();
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_CREATE_2D_SAMPLEABLE, &_png_cr_cap);
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_WRITE, &_png_wr_cap);
    var ctx[168];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    store64((&ctx) + 32, b);
    var buf[80];
    _mk_png_2x2(&buf);
    var tex = gpu_texture_load_png(&ctx, &buf, 76);
    assert_eq(tex, 0x7E, "load_png returns the created tex");
    assert_eq(_png_cr_count, 1, "create called once");
    assert_eq(_png_cr_w, 2, "chitra decoded width 2");
    assert_eq(_png_cr_h, 2, "chitra decoded height 2");
    assert_eq(_png_cr_fmt, MABDA_TEXFMT_RGBA8, "create RGBA8");
    assert_eq(_png_wr_count, 1, "write called once");
    assert_eq(_png_wr_n, 16, "upload 2*2*4 = 16 RGBA8 bytes");
    # Garbage bytes -> chitra decode fails -> IMAGE_DECODE -> 0.
    var bad[16];
    memset(&bad, 0, 16);
    assert_eq(gpu_texture_load_png(&ctx, &bad, 16), 0, "garbage PNG -> 0 (decode fail)");
    assert_eq(gpu_texture_load_png(0, &buf, 76), 0, "null ctx -> 0");
    return 0;
}

# AL.6: the magic-byte sniffer routes each container to the right loader.
fn test_gpu_texture_load_sniffer() {
    _png_cr_count = 0;
    _dds_cr_count = 0;
    var b = backend_new();
    backend_set_kind(b, BACKEND_KIND_AMD);
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_CREATE_2D_SAMPLEABLE, &_png_cr_cap);
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_WRITE, &_png_wr_cap);
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_CREATE_2D_FMT_MIPPED, &_dds_cr_cap);
    backend_set_slot(b, BACKEND_SLOT_TEXTURE_WRITE_LEVEL, &_dds_wl_cap);
    var ctx[168];
    memset(&ctx, 0, GPU_CONTEXT_SIZE);
    store64((&ctx) + 32, b);
    # PNG magic -> load_png (CREATE_2D_FMT, RGBA8).
    var png[80];
    _mk_png_2x2(&png);
    assert_eq(gpu_texture_load(&ctx, &png, 76), 0x7E, "PNG magic loads");
    assert_eq(_png_cr_count, 1, "PNG routed to load_png");
    assert_eq(_png_cr_fmt, MABDA_TEXFMT_RGBA8, "PNG -> RGBA8 path");
    # DDS magic -> load_dds (CREATE_2D_FMT_MIPPED, BC1).
    var dds[160];
    _mk_dds_fourcc(&dds, 8, 8, 1, _DDS_FOURCC_DXT1);
    gpu_texture_load(&ctx, &dds, 160);
    assert_eq(_dds_cr_count, 1, "DDS routed to load_dds");
    assert_eq(_dds_cr_fmt, MABDA_TEXFMT_BC1, "DDS -> BC1 path");
    # KTX2 magic -> load_ktx2 (CREATE_2D_FMT_MIPPED, BC7).
    var ktx[168];
    _mk_ktx2_hdr(&ktx, 145, 8, 8, 1, 0, 0, 1);
    store64(&ktx + 80, 104);
    store64(&ktx + 88, 64);
    store64(&ktx + 96, 64);
    gpu_texture_load(&ctx, &ktx, 168);
    assert_eq(_dds_cr_count, 2, "KTX2 routed to load_ktx2");
    assert_eq(_dds_cr_fmt, MABDA_TEXFMT_BC7, "KTX2 -> BC7 path");
    # Unknown magic / too short -> fail loud.
    var junk[16];
    memset(&junk, 0, 16);
    store32(&junk, 0x12345678);
    assert_eq(gpu_texture_load(&ctx, &junk, 16), 0, "unknown magic -> 0");
    assert_eq(gpu_texture_load(&ctx, &junk, 2), 0, "len<4 -> 0");
    assert_eq(gpu_texture_load(0, &png, 76), 0, "null ctx -> 0");
    return 0;
}

fn main() {
    test_vk_format_mapping();
    test_vk_format_unmapped();
    test_vk_format_srgb_flag();
    test_dxgi_format_mapping();
    test_dxgi_format_unmapped();
    test_dxgi_format_srgb_flag();
    test_mapping_targets_are_valid_ids();
    test_dds_parse_fourcc();
    test_dds_parse_dx10();
    test_dds_parse_rejects();
    test_gpu_ctx_supports_format_native();
    test_gpu_texture_load_dds_orchestration();
    test_ktx2_parse();
    test_ktx2_parse_rejects();
    test_ktx2_load_orchestration();
    test_gpu_texture_load_png_orchestration();
    test_gpu_texture_load_sniffer();
    assert_summary();
    return 0;
}
