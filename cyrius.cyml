[package]
name = "mabda"
version = "${file:VERSION}"
description = "mabda — GPU foundation layer for AGNOS (device lifecycle, buffers, compute, textures, profiling, capability detection)"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/mabda"
language = "cyrius"
cyrius = "6.6.4"

# mabda is a library with no CLI binary. The smoke program links the full
# include chain to prove src/lib.cyr builds clean.
[build]
entry = "programs/smoke.cyr"
output = "build/mabda_smoke"

# `cyrius distlib` concatenates these into dist/mabda.cyr in this order, which
# must match the include order in src/lib.cyr. A new src module goes in BOTH.
[lib]
modules = [
    "src/error.cyr",
    "src/color.cyr",
    "src/capabilities.cyr",
    "src/profiler.cyr",
    "src/resource.cyr",
    "src/wgpu_types.cyr",
    "src/texture_format.cyr",
    "src/asset_format.cyr",
    "src/wgpu_descriptors.cyr",
    "src/wgpu_ffi.cyr",
    "src/backend.cyr",
    "src/backend_wgpu.cyr",
    "src/context.cyr",
    "src/backend_native_amdgpu.cyr",
    "src/gfx9_encode.cyr",
    "src/spirv_parse.cyr",
    "src/mir.cyr",
    "src/spirv_lower.cyr",
    "src/gfx9_isel.cyr",
    "src/gfx9_regalloc.cyr",
    "src/gfx9_waitcnt.cyr",
    "src/gfx9_abi.cyr",
    "src/gfx9_compile.cyr",
    "src/backend_native_shaders.cyr",
    "src/backend_native_pm4.cyr",
    "src/backend_native.cyr",
    "src/backend_native_kms.cyr",
    "src/backend_nvidia_nouveau.cyr",
    "src/backend_nvidia_sass.cyr",
    "src/backend_nvidia_push.cyr",
    "src/backend_nvidia_qmd.cyr",
    "src/backend_nvidia_tex.cyr",
    "src/backend_nvidia.cyr",
    "src/buffer.cyr",
    "src/typed_buffer.cyr",
    "src/gpu_timestamps.cyr",
    "src/compute.cyr",
    "src/shader_cache.cyr",
    "src/pipeline_cache.cyr",
    "src/bind_group_cache.cyr",
    "src/vertex.cyr",
    "src/blend.cyr",
    "src/sampler.cyr",
    "src/depth.cyr",
    "src/bind_group.cyr",
    "src/texture.cyr",
    "src/asset_load.cyr",
    "src/render_target.cyr",
    "src/render_pipeline.cyr",
    "src/render_pass.cyr",
    "src/queue.cyr",
    "src/render_graph.cyr",
    "src/surface.cyr",
    "src/surface_v3.cyr",
    "src/instancing.cyr",
    "src/debug.cyr",
]

# thread + sankoch are chitra's stdlib deps; its bundle does not carry them.
[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "io",
    "args",
    "hashmap",
    "syscalls",
    "tagged",
    "fnptr",
    "mmap",
    "dynlib",
    "sakshi",
    "thread",
    "sankoch",
]

# logind DRM-master delegation for gpu_surface_configure_native_logind.
# Only called under -D MABDA_LOGIND (off by default).
[deps.samvada]
git = "https://github.com/MacCracken/samvada.git"
tag = "1.0.1"
modules = ["dist/samvada.cyr"]

# PNG / baseline-JPEG decode for src/asset_load.cyr (decoded to RGBA8).
[deps.chitra]
git = "https://github.com/MacCracken/chitra.git"
tag = "1.0.3"
modules = ["dist/chitra.cyr"]
