[package]
name = "mabda"
version = "${file:VERSION}"
description = "mabda — GPU foundation layer for AGNOS (device lifecycle, buffers, compute, textures, profiling, capability detection)"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/mabda"
language = "cyrius"
# 6.5.29 (4.0.10) — currency sweep, and it clears a REAL drift, not just a stale number.
#   (a) THE OLD PIN DESCRIBED A BUILD NOBODY RAN. `~/.cyrius/bin` is a symlink to
#       `versions/<current>/bin`, and the `cyrius` driver does not re-resolve `cycc` per manifest
#       pin — so at pin 6.5.20 with 6.5.29 installed, every `cyrius build` printed
#       `toolchain drift` and was in fact cycc 6.5.29 driving a 6.5.20-era `lib/`. Same shape as
#       the 6.5.3 → 6.5.20 repair this comment replaces. Upstream cyrius 6.5.29's own CHANGELOG
#       flags mabda's 6.5.20 pin as rot; this is the closeout sweep it asks for.
#   (b) BLAST RADIUS MEASURED, NOT ASSUMED. `cyrius.lock` is the oracle here — it hashes every
#       file `cyrius deps` actually lays down. Six resolved files changed content and three
#       appeared, 39 -> 42 locked. ⚠ Attribute them to the right cause — the two bumps in this
#       cut are easy to conflate:
#         - TOOLCHAIN (6.5.21..6.5.29): `dynlib`, `sankoch`, and three `syscalls_*` peers that
#           ride along with the `syscalls` dispatcher — `aarch64_linux`, `macos`, `windows`.
#           Of the 16 modules named in `[deps].stdlib`, only `dynlib` and `sankoch` moved.
#           ⭐ `syscalls_x86_64_linux.cyr` — the peer this repo's only build target resolves —
#           is BYTE-IDENTICAL, which is why a 9-patch jump moves zero assertions.
#         - CHITRA (0.3.0 -> 0.3.1): `chitra.cyr` itself, plus the three NEW entries
#           `assert`/`bench`/`flags`. Those are NOT new to the toolchain — they exist in the
#           6.5.20 snapshot too. They entered the lock because chitra 0.3.1 ships a `.deps`
#           SIDECAR (0.3.0's dist had only `chitra.cyr`) and that sidecar declares them.
# ⚠ NOTHING DIFFS `cyrius.lock` — not CI, not the Makefile. It is tracked but ungated, so a
# bad resolve rewrites it silently. Re-check it by hand on every pin or dep bump. (Carried
# forward from the 4.0.9 comment this block replaces; the hazard has not been fixed, only
# survived.)
# ⚠ 6.5.28 made `cyrius fmt` REWRITE IN PLACE (was stdout-only), and `--dry`/`--check` emit a
# DIAGNOSTIC, never source. Measured on 6.5.29: `cyrius fmt f > f.new` leaves f correctly
# formatted and f.new EMPTY (litter, not damage) — but `cyrius fmt f > f` DESTROYS f, because
# the shell truncates it before cyrfmt reads it, leaving `cyrfmt: cannot read file` as the
# file's entire contents. To apply, just `cyrius fmt <file>`. mabda's Makefile + CI use
# `fmt --check` only and are unaffected.
# ⚠ 6.5.24 fixed the `assigning non-pointer to typed pointer` warning's SIGN (it had been
# unreachable for its own purpose) and 6.5.29 stopped it firing on `&x`. Net: the warning can now
# fire on mabda code for the first time. Build is verified 0-warning at this pin.
# ⚠ The 6.5.4→6.5.20 span's semantic changes (the regalloc NOP-compactor corrupting switch/match
# jump tables; `break` gaining C semantics in switch/match) still cannot reach mabda: it contains
# no Cyrius `switch`/`match` and no `#derive` anywhere in src/, programs/, tests/ or fuzz/.
cyrius = "6.5.29"

# mabda is a library — no CLI binary. `cyrius build` targets a smoke
# program that links the full include chain to prove lib.cyr parses clean.
# Real consumers pull `dist/mabda.cyr` from the Cyrius stdlib (since 3.4.19)
# or via a `[deps.mabda]` entry pointing at a git tag.
[build]
entry = "programs/smoke.cyr"
output = "build/mabda_smoke"

# `[lib]` feeds `cyrius distlib` — module order matters: stdlib first
# (declared in src/lib.cyr), then domain modules in dependency order.
# Forward references between cache modules were handled by `cache_key.cyr`
# until v2.4.5 — now the u64-keyed stdlib hashmap (cyrius v5.5.20) makes
# that helper unnecessary, so the caches depend only on their own module
# order. Don't reorder without re-running `cyrius distlib` and verifying
# the concatenated bundle still compiles clean.
[lib]
modules = [
    "src/error.cyr",
    "src/color.cyr",
    "src/capabilities.cyr",
    "src/profiler.cyr",
    "src/resource.cyr",
    "src/wgpu_types.cyr",
    "src/texture_format.cyr",
    "src/asset_format.cyr",
    "src/wgpu_descriptors.cyr",
    "src/wgpu_ffi.cyr",
    "src/backend.cyr",
    "src/backend_wgpu.cyr",
    "src/context.cyr",
    "src/backend_native_amdgpu.cyr",
    "src/gfx9_encode.cyr",
    "src/spirv_parse.cyr",
    "src/mir.cyr",
    "src/spirv_lower.cyr",
    "src/gfx9_isel.cyr",
    "src/gfx9_regalloc.cyr",
    "src/gfx9_waitcnt.cyr",
    "src/gfx9_abi.cyr",
    "src/gfx9_compile.cyr",
    "src/backend_native_shaders.cyr",
    "src/backend_native_pm4.cyr",
    "src/backend_native.cyr",
    "src/backend_native_kms.cyr",
    "src/backend_nvidia_nouveau.cyr",
    "src/backend_nvidia_sass.cyr",
    "src/backend_nvidia_push.cyr",
    "src/backend_nvidia_qmd.cyr",
    "src/backend_nvidia_tex.cyr",
    "src/backend_nvidia.cyr",
    "src/buffer.cyr",
    "src/typed_buffer.cyr",
    "src/gpu_timestamps.cyr",
    "src/compute.cyr",
    "src/shader_cache.cyr",
    "src/pipeline_cache.cyr",
    "src/bind_group_cache.cyr",
    "src/vertex.cyr",
    "src/blend.cyr",
    "src/sampler.cyr",
    "src/depth.cyr",
    "src/bind_group.cyr",
    "src/texture.cyr",
    "src/asset_load.cyr",
    "src/render_target.cyr",
    "src/render_pipeline.cyr",
    "src/render_pass.cyr",
    "src/queue.cyr",
    "src/render_graph.cyr",
    "src/surface.cyr",
    "src/surface_v3.cyr",
    "src/instancing.cyr",
    "src/debug.cyr",
]

[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "io",
    "args",
    "hashmap",
    "syscalls",
    "tagged",
    "fnptr",
    "mmap",
    "dynlib",
    "sakshi",
    "thread",
    "sankoch",
]

# samvada — Cyrius dbus client (Step 7.7 logind path). 0.4.1
# carries the libsystemd C shim + logind subset
# (TakeDevice / ReleaseDevice / pump_signals). mabda wires the
# stub `_backend_native_surface_configure_logind` to call into
# samvada when this dep is present. Consumer (mabda's build)
# links libsystemd; mabda itself doesn't link it directly.
#
# v4.0.1 escape hatch: the samvada C-shim retirement (roadmap-paired with
# the AMD wgpu retirement) is DEFERRED. The pure-Cyrius replacement (a
# native dbus client: SASL EXTERNAL + SCM_RIGHTS master-fd passing) is
# upstream samvada work that isn't ready — samvada is still 0.4.1 /
# kind=LIBSYSTEMD. All mabda samvada calls sit behind `#ifdef MABDA_LOGIND`
# (off by default), so the coupling is dormant. When samvada ships the
# pure-Cyrius 1.0, the only mabda change is bumping this tag + `cyrius deps`
# (call signatures are impl-agnostic). Forward plan: evolve the samvada
# dbus project into the native pure-Cyrius dbus for AGNOS.
[deps.samvada]
git = "https://github.com/MacCracken/samvada.git"
tag = "0.4.1"
modules = ["dist/samvada.cyr"]

[deps.chitra]
git = "https://github.com/MacCracken/chitra.git"
tag = "0.3.1"
modules = ["dist/chitra.cyr"]
