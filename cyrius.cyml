[package]
name = "mabda"
version = "${file:VERSION}"
description = "mabda — GPU foundation layer for AGNOS (device lifecycle, buffers, compute, textures, profiling, capability detection)"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/mabda"
language = "cyrius"
cyrius = "6.7.18"

# mabda is a library with no CLI binary. The smoke program links the full
# include chain to prove src/lib.cyr builds clean.
[build]
entry = "programs/smoke.cyr"
output = "build/mabda_smoke"

# `cyrius distlib` concatenates these into dist/mabda.cyr in this order, which
# must match the include order in src/lib.cyr. A new src module goes in BOTH.
[lib]
modules = [
    "src/error.cyr",
    "src/color.cyr",
    "src/capabilities.cyr",
    "src/profiler.cyr",
    "src/resource.cyr",
    "src/wgpu_types.cyr",
    "src/texture_format.cyr",
    "src/gpu_types.cyr",
    "src/asset_format.cyr",
    "src/texture_bc7.cyr",
    "src/wgpu_descriptors.cyr",
    "src/wgpu_ffi.cyr",
    "src/backend.cyr",
    "src/backend_wgpu.cyr",
    "src/context.cyr",
    "src/error_scope.cyr",
    "src/backend_wgpu_rtier.cyr",
    "src/backend_wgpu_target.cyr",
    "src/backend_wgpu_ctier.cyr",
    "src/backend_wgpu_surface.cyr",
    "src/backend_native_amdgpu.cyr",
    "src/gfx9_encode.cyr",
    "src/spirv_parse.cyr",
    "src/mir.cyr",
    "src/spirv_lower.cyr",
    "src/gfx9_isel.cyr",
    "src/gfx9_regalloc.cyr",
    "src/gfx9_waitcnt.cyr",
    "src/gfx9_abi.cyr",
    "src/gfx9_compile.cyr",
    "src/backend_native_shaders.cyr",
    "src/backend_native_pm4.cyr",
    "src/backend_native.cyr",
    "src/backend_native_kms.cyr",
    "src/backend_nvidia_nouveau.cyr",
    "src/backend_nvidia_sass.cyr",
    "src/sm75_encode.cyr",
    "src/sm75_isel.cyr",
    "src/sm75_regalloc.cyr",
    "src/sm75_compile.cyr",
    "src/backend_nvidia_push.cyr",
    "src/backend_nvidia_qmd.cyr",
    "src/backend_nvidia_tex.cyr",
    "src/backend_nvidia.cyr",
    "src/backend_native_rtier.cyr",
    "src/buffer.cyr",
    "src/typed_buffer.cyr",
    "src/gpu_timestamps.cyr",
    "src/compute.cyr",
    "src/shader_cache.cyr",
    "src/pipeline_cache.cyr",
    "src/bind_group_cache.cyr",
    "src/vertex.cyr",
    "src/blend.cyr",
    "src/sampler.cyr",
    "src/depth.cyr",
    "src/bind_group.cyr",
    "src/texture.cyr",
    "src/asset_load.cyr",
    "src/render_target.cyr",
    "src/render_pipeline.cyr",
    "src/render_pass.cyr",
    "src/gpu_bind.cyr",
    "src/gpu_pipeline.cyr",
    "src/gpu_draw.cyr",
    "src/gpu_target.cyr",
    "src/gpu_compute_tier.cyr",
    "src/queue.cyr",
    "src/render_graph.cyr",
    "src/surface.cyr",
    "src/surface_v3.cyr",
    "src/instancing.cyr",
    "src/debug.cyr",
]

# sankoch is chitra's stdlib dep (its bundle does not carry it); thread was too, through
# chitra 1.0.x, and stays listed so consumer recipes that copy this list keep building.
[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "io",
    "args",
    "hashmap",
    "syscalls",
    "chrono",
    "tagged",
    "fnptr",
    "mmap",
    "dynlib",
    "sakshi",
    "thread",
    "sankoch",
]

# logind DRM-master delegation for gpu_surface_configure_native_logind.
# Only called under -D MABDA_LOGIND (off by default). Optional (4.3.0, L12): cyrius
# reads [features] from the ROOT manifest only, so a consumer resolves samvada only
# when it names it (`--features samvada` or its own feature). mabda's own
# `cyrius deps` gets it through the `default` set below.
[deps.samvada]
git = "https://github.com/MacCracken/samvada.git"
tag = "1.1.2"
modules = ["dist/samvada.cyr"]
optional = true

# PNG / baseline-JPEG decode for src/asset_load.cyr (decoded to RGBA8). Only
# called under -D MABDA_PNG / -D MABDA_JPEG. Optional, as samvada above.
[deps.chitra]
git = "https://github.com/MacCracken/chitra.git"
tag = "1.4.1"
modules = ["dist/chitra.cyr"]
optional = true

# Each feature names the optional dep its -D define compiles in. `default` keeps
# mabda's own tree (tests, programs, CI) resolving both; a consumer of mabda never
# sees this table (cyrius reads [features] from the root manifest only).
[features]
png = ["chitra"]
jpeg = ["chitra"]
logind = ["samvada"]
default = ["png", "jpeg", "logind"]
