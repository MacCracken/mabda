#version 450
// N6.2 sampling capture probe: sample texel (0,0) of a 2D RGBA8 texture via a
// combined image sampler (NEAREST/clamp), pack to RGBA8, store to a buffer.
// Exercises the full TIC + TSC + TEX path so the interposer captures a real
// (non-empty) texture-header / sampler descriptor + the sampling SASS.
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(binding = 0) uniform sampler2D tex;
layout(binding = 1, std430) buffer Out { uint v[]; };
void main() {
    // texture() at the center of a 1x1 texture with NEAREST returns texel(0,0).
    vec4 c = texture(tex, vec2(0.5, 0.5));
    v[0] = packUnorm4x8(c);
}
